// String building in a loop (`s = s + x`): milo-append-in-place appends in place in the
// dialect. Without it, every iteration copies the whole accumulator (quadratic).
fn piece(i: i64): string { return "ab".repeat(1 + i % 3) }

fn main() {
    var s: string = ""
    for i in 0..200000 { s = s + piece(i) }
    print(s.len())
}
