// Golden trap program for scripts/mlir-same.ts --programs: a substring past the end panics with
// the message and this call's line, through the per-site helper.
fn cut(s: &string, a: i64, b: i64): string { return s.substr(a, b) }

fn main() {
    let s = "abcdef"
    print(cut(s, 1, 3))
    print(cut(s, 4, 9))
}
