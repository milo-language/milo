// Differential panic program (scripts/mlir-same.ts --programs): the trap fires in a
// helper compiled through MLIR; stderr and exit status must match legacy codegen.
fn f(n: i32): i32 {
    var x: i32 = 1
    var i: i32 = 0
    while i < n {
        x = x * 3
        i += 1
    }
    return x
}

fn main() {
    print(f(40))
}
