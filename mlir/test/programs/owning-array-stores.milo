// Differential program for scripts/mlir-same.ts --programs --owned: stores of arrays of
// owning elements: an element, a field holding one, the whole array over an owned local
// (the old one dropped, as legacy's big Assign), in a Vec, an enum payload, through
// `&mut`, nested arrays, by-value results, a `?` jumping out of a half-built literal.

struct Row { cols: [string; 2], id: i64 }

enum Cell {
    Pair([string; 2]),
    Empty,
}

fn mkName(i: i64): string {
    return "a heap allocated name number ".clone() + i.toString()
}

fn mkRow(i: i64): Row {
    return Row { cols: [mkName(i), mkName(i + 1)], id: i }
}

fn fields(): i64 {
    var r = mkRow(1)
    r.cols[1] = mkName(9)
    r.cols = [mkName(3), mkName(4)]
    return r.cols[0].len() + r.cols[1].len() + r.id
}

fn inVec(): i64 {
    var v: Vec<[string; 2]> = Vec.new()
    for i in 0..3 { v.push([mkName(i), mkName(i * 2)]) }
    var t = 0
    for p in v { t = t + p[0].len() + p[1].len() }
    return t + v[1][0].len()
}

fn enums(k: i64): i64 {
    let c = if k > 0 { Cell.Pair([mkName(k), mkName(k)]) } else { Cell.Empty }
    return match c {
        Cell.Pair(a) => a[0].len() + a[1].len()
        Cell.Empty => 0
    }
}

fn setAll(a: &mut [string; 3], s: string) {
    for i in 0..3 { a[i] = s + i.toString() }
}

fn mutRef(): string {
    var a = [mkName(1), mkName(2), mkName(3)]
    setAll(&mut a, "x")
    return a[0] + a[1] + a[2]
}

fn reassign(): i64 {
    var a = [mkName(1), mkName(2)]
    for i in 0..3 {
        a = [mkName(i), a[0]]
    }
    return a[0].len() + a[1].len()
}

fn mkPair(i: i64): [string; 2] {
    return [mkName(i), mkName(i + 100)]
}

fn results(): i64 {
    let p = mkPair(5)
    var t = p[1].len()
    for s in mkPair(6) { t = t + s.len() }
    return t
}

fn vecs(): i64 {
    var a: [Vec<i64>; 2] = [Vec.new(), Vec.new()]
    a[0].push(1)
    a[1].push(2)
    a[1].push(3)
    return a[0].len() + a[1].len()
}

fn nested(): i64 {
    let g = [[mkName(1), mkName(2)], [mkName(3), mkName(4)]]
    var t = 0
    for row in g { for s in row { t = t + s.len() } }
    return t
}

fn repeat(): i64 {
    let a = [mkName(2); 3]
    return a[0].len() + a[2].len()
}

fn breaks(): i64 {
    var t = 0
    for s in [mkName(1), mkName(22), mkName(333)] {
        if s.len() > 31 { break }
        t = t + s.len()
    }
    return t
}

struct Big { a: string, b: string, pad: [i64; 16] }

fn mkBig(i: i64): Big {
    return Big { a: mkName(i), b: mkName(i + 1), pad: [0; 16] }
}

fn bigs(): i64 {
    var x = mkBig(1)
    let y = x
    x = mkBig(2)
    for i in 0..3 { x = mkBig(i) }
    return x.a.len() + y.b.len()
}

fn parse(s: string): Result<string, string> {
    if s.len() > 40 { return Err("too long".clone()) }
    return Ok(s + "?")
}

fn pending(k: i64): Result<i64, string> {
    let a = [mkName(1), parse(mkName(k))?]
    return Ok(a[0].len() + a[1].len())
}

fn main() {
    print(bigs())
    print(pending(1).unwrapOr(-1))
    print(pending(123456789012345).unwrapOr(-1))
    print(fields())
    print(inVec())
    print(enums(3))
    print(enums(0))
    print(mutRef())
    print(reassign())
    print(results())
    print(vecs())
    print(nested())
    print(repeat())
    print(breaks())
}
