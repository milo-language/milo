// Golden program for scripts/mlir-same.ts (--programs) and an ownership
// target: sret functions (lib/bigs.milo) built from struct literals, forwarding another
// sret call, called into a `let`, into a discarded temporary, and in a loop; a 128+ byte
// struct passed by value, from an sret call and moved out of a local.
from "./lib/bigs" import { Record, record, renamed, indirect, score, port }

fn main() {
    var t: i64 = 0
    for i in 0..6 {
        let r = record(i)
        let q = renamed(r, "!")
        t += score(r) + score(q)
    }
    print(t)
    let n = record(-1)
    print(score(n))
    let d = indirect(3)
    print(score(d))
    record(9)
    print(port(record(4)))
    let z = record(5)
    print(port(z))
}
