// Move closures natively: owned captures in a heap env, moved out by the body once,
// dropped by the env when the closure goes; strings, Vecs and structs.
struct Res { name: string, n: i64 }

fn run(f: move () => i64): i64 {
    return f()
}

fn take(r: Res): i64 {
    return r.n + r.name.len()
}

pub fn main(): i32 {
    let s = "abc".clone()
    let v: Vec<i64> = [1, 2, 3]
    let f = move(): i64 => s.len() + v.len()
    print(f(), " ", f())
    let r = Res { name: "res".clone(), n: 10 }
    print(run(move(): i64 => take(r)))
    let unused = Res { name: "dropped".clone(), n: 1 }
    let g = move(): i64 => unused.n
    print(g())
    var count: i64 = 0
    var i: i64 = 0
    while i < 3 {
        let t = format("t", i)
        let h = move(): i64 => t.len()
        count = count + h()
        i = i + 1
    }
    print(count)
    return 0
}
