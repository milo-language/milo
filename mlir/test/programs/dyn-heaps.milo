// Differential program for scripts/mlir-same.ts --programs --owned: `Heap<I>` of an
// interface, opaque `!milo.dyn<I>` (legacy's { data, itable } pair). Boxes built in legacy
// code are held in locals, struct fields and by-ref params, moved, called through
// (string, scalar and void results, scalar and by-ref arguments), and dropped, the
// concrete type's user Drop running through the itable.

interface Shape {
    fn area(self: &Self): i64
    fn name(self: &Self): string
    fn grow(self: &mut Self, by: i64): void
}

struct Sq { side: i64 }

struct Rect { w: i64, h: i64, tag: string }

impl Sq {
    fn area(self: &Self): i64 { return self.side * self.side }
    fn name(self: &Self): string { return "sq" }
    fn grow(self: &mut Self, by: i64): void { self.side = self.side + by }
}

impl Rect {
    fn area(self: &Self): i64 { return self.w * self.h }
    fn name(self: &Self): string { return "rect " + self.tag }
    fn grow(self: &mut Self, by: i64): void { self.w = self.w + by }
}

impl Drop for Rect {
    fn drop(self: &mut Self) { print("drop rect ", self.tag) }
}

struct Holder { label: string, shape: Heap<Shape> }

fn sq(n: i64): Heap<Shape> {
    return Heap(Sq { side: n })
}

fn rect(t: string): Heap<Shape> {
    return Heap(Rect { w: 2, h: 3, tag: t })
}

fn describe(s: &Heap<Shape>): string {
    return s.name() + $"={s.area()}"
}

fn bump(h: &mut Holder, by: i64) {
    h.shape.grow(by)
}

fn run() {
    let a = sq(4)
    var b = rect("r" + "1")
    print(describe(a), " ", describe(b))
    b.grow(10)
    print(b.area())
    var h = Holder { label: "held", shape: rect("r2") }
    bump(&mut h, 1)
    print(h.label, " ", h.shape.name(), " ", h.shape.area())
    let moved = b
    print(describe(moved))
    print("end of run")
}

fn main() {
    run()
    print("done")
}
