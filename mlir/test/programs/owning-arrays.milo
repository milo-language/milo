// Differential program for scripts/mlir-same.ts --programs --owned: fixed arrays of
// owning elements (`[string; N]`, structs holding strings) as lets, globals, indexing,
// for-in (borrowed and consumed, the binding moved out too), by-value and by-ref params.

struct P { name: string, n: i64 }

let NAMES: [string; 3] = ["alpha", "beta", "gamma"]

fn mkName(i: i64): string {
    return "a heap allocated name number ".clone() + i.toString()
}

fn lets(): i64 {
    let a = [mkName(1), mkName(2), mkName(3)]
    var total = 0
    for s in a { total = total + s.len() }
    let b = a[1]
    total = total + b.len()
    return total
}

fn vars(): string {
    var a = [mkName(1), mkName(2)]
    a[0] = mkName(7)
    a[1] = a[0] + "!"
    return a[0] + a[1]
}

fn globals(): i64 {
    var t = 0
    for n in NAMES { t = t + n.len() }
    return t + NAMES[2].len()
}

fn structs(): i64 {
    let ps = [P { name: mkName(1), n: 1 }, P { name: mkName(2), n: 2 }]
    var t = 0
    for p in ps { t = t + p.name.len() + p.n }
    return t + ps[0].name.len()
}

fn pass(a: [string; 2]): [string; 2] {
    return a
}

fn byRef(a: &[string; 2]): i64 {
    return a[0].len() + a[1].len()
}

fn moves(): i64 {
    let a = [mkName(4), mkName(5)]
    let b = pass(a)
    return byRef(b)
}

fn consumed(): i64 {
    var t = 0
    for s in [mkName(8), mkName(9)] { t = t + s.len() }
    return t
}

fn early(k: i64): i64 {
    let a = [mkName(1), mkName(2)]
    for s in a {
        if s.len() > k { return s.len() }
    }
    return 0
}

fn keep(): i64 {
    var kept: Vec<string> = Vec.new()
    for s in [mkName(1), mkName(2)] { kept.push(s) }
    let a = [mkName(3), mkName(4)]
    for s in a { kept.push(s) }
    return kept.len() + kept[3].len()
}

fn main() {
    print(keep())
    print(lets())
    print(vars())
    print(globals())
    print(structs())
    print(moves())
    print(consumed())
    print(early(3))
}
