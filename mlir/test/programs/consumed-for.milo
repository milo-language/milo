// Differential program for scripts/mlir-same.ts --programs --owned: `for x in makeVec()`,
// where the loop owns the Vec and hands each element out by value. Scalars, strings and
// a type with a user Drop (its drops print, so the order of the binding's drop against
// the elements no iteration reached is in stdout), with break, continue, a return from
// inside, an element moved out of the binding, an index, an empty Vec, and the loop
// inside another loop.

struct Noisy { id: i64 }

impl Drop for Noisy {
    fn drop(self: &mut Self) {
        print("drop ", self.id)
    }
}

fn nums(n: i64): Vec<i64> {
    var v: Vec<i64> = Vec.new()
    for i in 0..n {
        v.push(i * 3)
    }
    return v
}

fn words(): Vec<string> {
    var v: Vec<string> = Vec.new()
    v.push("alpha")
    v.push("be")
    v.push("gamma" + "!")
    v.push("delta")
    return v
}

fn noisies(n: i64): Vec<Noisy> {
    var v: Vec<Noisy> = Vec.new()
    for i in 0..n {
        v.push(Noisy { id: i })
    }
    return v
}

fn sumNums(): i64 {
    var s = 0
    for x in nums(6) {
        if x == 6 {
            continue
        }
        s = s + x
    }
    return s
}

fn keepLong(): Vec<string> {
    var out: Vec<string> = Vec.new()
    for w in words() {
        if w.len() > 2 {
            out.push(w)
        }
    }
    return out
}

fn firstShort(): string {
    for i, w in words() {
        if w.len() < 3 {
            return w + $"@{i}"
        }
    }
    return "none"
}

fn breakAt(k: i64) {
    for n in noisies(4) {
        print("see ", n.id)
        if n.id == k {
            break
        }
    }
    print("after break")
}

fn returnAt(k: i64): i64 {
    for n in noisies(4) {
        if n.id == k {
            return n.id * 10
        }
        print("pass ", n.id)
    }
    return -1
}

fn take(n: Noisy): i64 {
    return n.id + 100
}

fn moveSome(): i64 {
    var t = 0
    for n in noisies(3) {
        if n.id != 1 {
            t = t + take(n)
        }
    }
    return t
}

fn nested(): i64 {
    var t = 0
    for round in 0..3 {
        for w in words() {
            if w.len() == round + 1 {
                break
            }
            t = t + w.len()
        }
    }
    return t
}

// Place-only elements: copied out of the Vec into the binding.
struct Wide { a: i64, b: i64, c: i64, d: i64, e: i64, f: i64, g: i64, h: i64, i: i64, j: i64, k: i64, l: i64, m: i64, n: i64, o: i64, p: i64, name: string }

struct Cells { v: [i64; 4] }

fn wides(n: i64): Vec<Wide> {
    var v: Vec<Wide> = Vec.new()
    for i in 0..n {
        v.push(Wide { a: i, b: 0, c: 0, d: 0, e: 0, f: 0, g: 0, h: 0, i: 0, j: 0, k: 0, l: 0, m: 0, n: 0, o: 0, p: i * 2, name: $"w{i}" })
    }
    return v
}

fn keepWides(): i64 {
    var kept: Vec<Wide> = Vec.new()
    for w in wides(5) {
        if w.a == 3 {
            break
        }
        if w.a % 2 == 0 {
            kept.push(w)
        }
    }
    var t = 0
    for w in kept {
        t = t + w.p + w.name.len()
    }
    return t
}

fn cells(): i64 {
    var v: Vec<Cells> = Vec.new()
    v.push(Cells { v: [1, 2, 3, 4] })
    v.push(Cells { v: [5, 6, 7, 8] })
    var t = 0
    for c in v.clone() {
        t = t + c.v[3]
    }
    return t
}

fn main() {
    print(keepWides(), " ", cells())
    print(sumNums())
    let kept = keepLong()
    print(kept.len(), " ", kept[0], " ", kept[2])
    print(firstShort())
    breakAt(1)
    print(returnAt(2))
    print(moveSome())
    var empty = 0
    for x in nums(0) {
        empty = empty + x
    }
    print(empty)
    print(nested())
}
