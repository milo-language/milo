// Word frequencies over a text of N words, in a hand-written open-addressed table
// with an FNV-1a hash: the Rust open-addressing row. Keys are {start, len} spans of
// the one text buffer (Milo has no storable string view, and a span is what Rust's
// &str key is), so counting allocates nothing per word.
from "./bench" import { xsNext, xsMod }

struct Span { start: i64, len: i64 }

struct Slot { key: Span, count: i32 }

@wrapping
fn fnv(text: &string, s: Span): u64 {
    var h: u64 = 0xcbf29ce484222325
    for i in s.start..s.start + s.len {
        h = (h ^ text[i] as u64) * 0x100000001b3
    }
    return h
}

fn main(): i32 {
    let n: i64 = 500000 // BENCH_N
    let vocab = n / 10 + 16
    var r: u64 = 12345
    var dict: Vec<string> = Vec.withCapacity(vocab)
    for _ in 0..vocab {
        var w = ""
        r = xsNext(r)
        let len = 3 + xsMod(r, 12)
        for _ in 0..len {
            r = xsNext(r)
            w.push(('a' as i64 + xsMod(r, 26)) as u8)
        }
        dict.push(w)
    }
    // A text of N words drawn with a skew towards the front of the vocabulary.
    var text = ""
    for _ in 0..n {
        r = xsNext(r)
        let a = xsMod(r, vocab)
        text.pushStr(dict[(a * a) / vocab])
        text.push(' ')
    }
    let tl = text.len
    var words: Vec<Span> = Vec.new()
    var i: i64 = 0
    while i < tl {
        let start = i
        while i < tl && text[i] != ' ' {
            i += 1
        }
        words.push(Span { start: start, len: i - start })
        while i < tl && text[i] == ' ' {
            i += 1
        }
    }

    var nslots: i64 = 16
    while nslots < vocab * 4 {
        nslots *= 2
    }
    let mask = (nslots - 1) as u64
    var slots: Vec<Slot> = Vec.filled(nslots, Slot { key: Span { start: 0, len: 0 }, count: 0 })
    var distinct: i64 = 0
    for w in words {
        var idx = (fnv(text, w) & mask) as i64
        while true {
            if slots[idx].count == 0 {
                slots[idx] = Slot { key: w, count: 1 }
                distinct += 1
                break
            }
            let k = slots[idx].key
            if k.len == w.len && text[k.start..k.start + k.len] == text[w.start..w.start + w.len] {
                slots[idx].count += 1
                break
            }
            idx = (idx + 1) & (mask as i64)
        }
    }
    var total: i64 = 0
    for s in slots {
        if s.count > 0 {
            total += s.count as i64 * (s.key.len + text[s.key.start] as i64)
        }
    }
    print(words.len)
    print(distinct)
    print(total)
    return 0
}
