// Generate, parse and evaluate N small arithmetic expressions, a third of them
// malformed: the Rust arena + Result row. One Vec pool is cleared per input and
// keeps its capacity, so discarding a tree is a length reset; errors are
// Result<_, u8> propagated with `?`. Milo cannot keep references in a struct, so
// the Rust Parser's cursor and node count are a small State passed by &mut.
from "./bench" import { xsNext, xsMod }

type Idx = i32(0..2147483646)

struct NodeId { at: Idx }

let eEof: u8 = 1
let eParen: u8 = 2
let eToken: u8 = 3
let eDiv0: u8 = 4

enum Expr {
    Num(i64),
    Neg(NodeId),
    Paren(NodeId),
    Bin(u8, NodeId, NodeId),
}

struct State { pos: i64, nodes: i64 }

// --- generation ---

fn emitNum(text: &mut Vec<u8>, v: i64) {
    if v >= 10 {
        text.push(('0' as i64 + v / 10) as u8)
    }
    text.push(('0' as i64 + v % 10) as u8)
}

fn gen(text: &mut Vec<u8>, depth: i64, seed: u64): u64 {
    var r = xsNext(seed)
    let k = xsMod(r, 8)
    if depth == 0 || k == 0 {
        emitNum(&mut text, 1 + xsMod(r >> 8, 99))
        return r
    }
    if k == 1 {
        text.push('-')
        return gen(&mut text, depth - 1, r)
    }
    if k == 2 {
        text.push('(')
        r = gen(&mut text, depth - 1, r)
        text.push(')')
        return r
    }
    r = gen(&mut text, depth - 1, r)
    let op = xsMod(r >> 16, 4)
    text.push(' ')
    text.push(if op == 0 { '+' } else if op == 1 { '-' } else if op == 2 { '*' } else { '/' })
    text.push(' ')
    return gen(&mut text, depth - 1, xsNext(r))
}

// One in four inputs is damaged after generation.
fn corrupt(text: &mut Vec<u8>, seed: u64) {
    let kind = xsMod(seed, 16)
    if kind == 0 {
        var i = text.len
        while i > 0 {
            i -= 1
            if text[i] == ')' {
                text[i] = ' '
                return
            }
        }
        text[0] = '#'
        return
    }
    if kind == 1 {
        let i = xsMod(seed >> 8, text.len)
        text[i] = '#'
        return
    }
    if kind == 2 {
        text.truncate(text.len / 2)
        return
    }
    if kind == 3 {
        text.push(' ')
        text.push('/')
        text.push(' ')
        text.push('0')
    }
}

// --- parsing ---

fn skip(t: &Vec<u8>, st: &mut State) {
    while st.pos < t.len && t[st.pos] == ' ' {
        st.pos += 1
    }
}

fn isDigit(c: u8): bool {
    return c >= '0' && c <= '9'
}

fn push(pool: &mut Vec<Expr>, st: &mut State, e: Expr): NodeId {
    st.nodes += 1
    pool.push(e)
    return NodeId { at: (pool.len - 1) as Idx }
}

fn expr(t: &Vec<u8>, st: &mut State, pool: &mut Vec<Expr>): Result<NodeId, u8> {
    var lhs = term(t, &mut st, &mut pool)?
    while true {
        skip(t, &mut st)
        if st.pos >= t.len {
            break
        }
        let op = t[st.pos]
        if op != '+' && op != '-' {
            break
        }
        st.pos += 1
        let rhs = term(t, &mut st, &mut pool)?
        lhs = push(&mut pool, &mut st, Expr.Bin(op, lhs, rhs))
    }
    return Result.Ok(lhs)
}

fn term(t: &Vec<u8>, st: &mut State, pool: &mut Vec<Expr>): Result<NodeId, u8> {
    var lhs = factor(t, &mut st, &mut pool)?
    while true {
        skip(t, &mut st)
        if st.pos >= t.len {
            break
        }
        let op = t[st.pos]
        if op != '*' && op != '/' {
            break
        }
        st.pos += 1
        let rhs = factor(t, &mut st, &mut pool)?
        lhs = push(&mut pool, &mut st, Expr.Bin(op, lhs, rhs))
    }
    return Result.Ok(lhs)
}

fn factor(t: &Vec<u8>, st: &mut State, pool: &mut Vec<Expr>): Result<NodeId, u8> {
    skip(t, &mut st)
    if st.pos >= t.len {
        return Result.Err(eEof)
    }
    let c = t[st.pos]
    if isDigit(c) {
        var v: i64 = 0
        while st.pos < t.len && isDigit(t[st.pos]) {
            v = v * 10 + (t[st.pos] - '0') as i64
            st.pos += 1
        }
        return Result.Ok(push(&mut pool, &mut st, Expr.Num(v)))
    }
    if c == '-' {
        st.pos += 1
        let f = factor(t, &mut st, &mut pool)?
        return Result.Ok(push(&mut pool, &mut st, Expr.Neg(f)))
    }
    if c != '(' {
        return Result.Err(eToken)
    }
    st.pos += 1
    let e = expr(t, &mut st, &mut pool)?
    skip(t, &mut st)
    if st.pos >= t.len || t[st.pos] != ')' {
        return Result.Err(eParen)
    }
    st.pos += 1
    return Result.Ok(push(&mut pool, &mut st, Expr.Paren(e)))
}

// One input: parse it, insist the whole text was consumed, evaluate it.
fn run(t: &Vec<u8>, st: &mut State, pool: &mut Vec<Expr>): Result<u64, u8> {
    let root = expr(t, &mut st, &mut pool)?
    skip(t, &mut st)
    if st.pos != t.len {
        return Result.Err(eToken)
    }
    return eval(pool, root)
}

// --- evaluation ---
// Unsigned, so overflow wraps identically in every language.

fn eval(pool: &Vec<Expr>, id: NodeId): Result<u64, u8> {
    match pool[id.at as i64] {
        Num(v) => { return Result.Ok(v as u64) }
        Neg(o) => {
            let x = eval(pool, o)?
            return Result.Ok((0 as u64).wrappingSub(x))
        }
        Paren(o) => { return eval(pool, o) }
        Bin(op, l, r) => {
            let a = eval(pool, l)?
            let b = eval(pool, r)?
            if op == '+' {
                return Result.Ok(a.wrappingAdd(b))
            }
            if op == '-' {
                return Result.Ok(a.wrappingSub(b))
            }
            if op == '*' {
                return Result.Ok(a.wrappingMul(b))
            }
            if b == 0 {
                return Result.Err(eDiv0)
            }
            return Result.Ok(a / b)
        }
    }
}

fn main(): i32 {
    let n: i64 = 100000 // BENCH_N
    var text: Vec<u8> = Vec.new()
    var pool: Vec<Expr> = Vec.new()
    var seed: u64 = 12345
    var ok: i64 = 0
    var errs: [i64; 5] = [0; 5]
    var sum: u64 = 0
    var chars: i64 = 0
    var nodes: i64 = 0 // Every node ever built, bad inputs included.
    for _ in 0..n {
        seed = xsNext(seed)
        text.clear()
        let depth = 3 + xsMod(seed, 4)
        let s = gen(&mut text, depth, seed >> 8)
        corrupt(&mut text, s)
        chars += text.len
        pool.clear()
        var st = State { pos: 0, nodes: 0 }
        let res = run(text, &mut st, &mut pool)
        nodes += st.nodes
        match res {
            Ok(v) => {
                ok += 1
                sum = sum.wrappingMul(31).wrappingAdd(v)
            }
            Err(e) => { errs[e as i64] += 1 }
        }
    }
    print(chars)
    print(nodes)
    print(ok)
    print(errs[eEof as i64])
    print(errs[eParen as i64])
    print(errs[eToken as i64])
    print(errs[eDiv0 as i64])
    print(sum)
    return 0
}
