// Incremental adjacency build plus BFS from four sources. One-pass linked build:
// each vertex heads a chain of edges in one Vec pool, linked by Option<EdgeId>.
// EdgeId wraps a ranged i32, so None takes the niche and a link is 4 bytes.
from "./bench" import { xsNext, xsMod }

type Idx = i32(0..2147483646)

struct EdgeId { at: Idx }

struct Edge { to: i32, next: Option<EdgeId> }

fn main(): i32 {
    let nv: i64 = 100000 // BENCH_N
    let deg: i64 = 8
    let sources: i64 = 4
    let ne = nv * deg
    var r: u64 = 12345
    // head[u] is vertex u's newest edge; edges chain back to older ones.
    var head: Vec<Option<EdgeId>> = Vec.filled(nv, Option.None)
    var pool: Vec<Edge> = Vec.withCapacity(ne)
    for _ in 0..ne {
        r = xsNext(r)
        let u = xsMod(r, nv)
        let to = xsMod(r >> 24, nv) as i32
        pool.push(Edge { to: to, next: head[u] })
        head[u] = Option.Some(EdgeId { at: (pool.len - 1) as Idx })
    }

    var dist: Vec<i32> = Vec.filled(nv, -1)
    var q: Vec<i32> = Vec.withCapacity(nv)
    var total: i64 = 0
    var seed: u64 = 999
    for _ in 0..sources {
        seed = xsNext(seed)
        let src = xsMod(seed, nv)
        for i in 0..nv {
            dist[i] = -1
        }
        q.clear()
        dist[src] = 0
        q.push(src as i32)
        var qh: i64 = 0
        while qh < q.len {
            let u = q[qh] as i64
            qh += 1
            let d = dist[u]
            total += d as i64
            var c = head[u]
            while let Some(e) = c {
                let w = pool[e.at as i64].to as i64
                if dist[w] < 0 {
                    dist[w] = d + 1
                    q.push(w as i32)
                }
                c = pool[e.at as i64].next
            }
        }
    }
    print(nv + ne)
    print(total)
    return 0
}
