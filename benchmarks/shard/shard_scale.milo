// Worker scaling on a COMPUTE-bound kernel.
//
//   shard_scale <workers> [innerIters]
//
// The other two programs here transform each element once, which is bound by memory
// bandwidth: four workers cannot beat the memory bus, so they measure the absence of
// a copy rather than parallel speedup. This one does `inner` rounds of arithmetic per
// element, so the work per byte is high enough that adding cores actually shows.
from "std/shard" import {
    Shard, parallelMapWith
}
from "std/time" import {
    epochMillis
}
from "std/args" import {
    args
}
from "std/strconv" import {
    parseInt
}

// The inner-iteration count rides in as per-worker state: `parallelMapWith` is the
// closed form that lets a value travel to every worker without a capturing closure.
pub struct Knob {
    inner: i64,
}

fn grind(w: Shard<f64>, knob: &mut Knob): Shard<f64> {
    var s = w
    var i: i64 = 0
    while i < s.len() {
        var x = s.get(i)
        var k: i64 = 0
        while k < knob.inner {
            x = x * 1.0000001 + 0.5
            k = k + 1
        }
        s.set(i, x)
        i = i + 1
    }
    return s
}

pub fn main(): i32 {
    let argv = args()
    var workers: i64 = 4
    if argv.len > 1 {
        workers = parseInt(argv[1].clone()) ?? 4
    }
    var inner: i64 = 200
    if argv.len > 2 {
        inner = parseInt(argv[2].clone()) ?? 200
    }
    let n: i64 = 2000000

    var v: Vec<f64> = Vec.withCapacity(n)
    var i: i64 = 0
    while i < n {
        v.push(1.0)
        i = i + 1
    }

    let t0 = epochMillis()
    var knobs: Vec<Knob> = Vec.new()
    for _k in 0..workers {
        knobs.push(Knob {
            inner: inner
        }
        )
    }
    // One window per worker, so this measures thread scaling and not queueing.
    let out = parallelMapWith(v, workers, knobs, grind)!.data
    let t1 = epochMillis()
    print("workers=" + workers.toString() + " ms=" + (t1 - t0).toString() + " check=" + out[0].toString())
    return 0
}
