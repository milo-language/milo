// Count a needle across the file on several OS threads, without copying the string:
// parallelScanStr divides it into overlapping read-only windows and hands back the
// per-window counts in window order.
from "std/shard" import {
    StrShard, parallelScanStr
}
from "std/fs" import {
    readFile
}
from "std/time" import {
    epochMillis
}
from "std/args" import {
    args
}
from "std/strconv" import {
    parseInt
}

// Every worker gets its own copy of the needle by naming it here rather than
// capturing it: a plain fn is what parallelScanStr takes, for that reason.
fn countIn(w: &StrShard): i64 {
    let needle: string = "milo"
    var n: i64 = 0
    var i: i64 = 0
    // Only count a match that BEGINS inside this window's own range; anything that
    // begins in the overlap belongs to the next window. The window knows that range:
    // recomputing it here meant repeating the divider's arithmetic, including the
    // last window's uneven remainder, and getting that wrong loses or double-counts
    // matches silently.
    while i < w.ownLen() {
        if w.matchesAt(i, needle) {
            n = n + 1
        }
        i = i + 1
    }
    return n
}

pub fn main(): i32 {
    let argv = args()
    let path = argv[1].clone()
    var workers: i64 = 4
    if argv.len > 2 {
        workers = parseInt(argv[2].clone()) ?? 4
    }
    let content = readFile(path)!

    let t0 = epochMillis()
    // Overlap of needle.len - 1 so a match straddling a seam is seen by the window
    // it begins in.
    let scanned = parallelScanStr(content, workers, 3, countIn)
    var count: i64 = 0
    for p in scanned.results {
        count = count + p
    }
    let t1 = epochMillis()
    print("par workers=" + workers.toString() + " ms=" + (t1 - t0).toString() + " count=" + count.toString())
    return 0
}
