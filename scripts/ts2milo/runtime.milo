// Hand-written support for the output of scripts/ts2milo.ts. Not generated.
//
// A TypeScript `string` is a Milo `string` holding UTF-16LE: two bytes per code unit. That is
// the one choice that keeps `.length`, `s[i]`, `charCodeAt` and column counts identical to
// JavaScript for non-ASCII source, and `==`, `+`, `pushStr` and HashSet keys still work as
// byte operations. jsFromUtf8 / jsToUtf8 convert at the program edges.
//
// Declarations of types the transpiled files import from untranspiled TypeScript
// (src/diagnostics.ts, src/ast.ts) also live here, mirroring those interfaces.
from "std/unicode" import { decodeCodepoint }

// Node identity: every struct that TypeScript uses as a Map/Set key or compares with `===` carries a
// fresh id (scripts/ts2milo/node-identity.ts). A copy keeps the id, as a reference does in TypeScript.
var ts2miloIdCounter: i64 = 0

pub fn ts2miloNextId(): i64 {
    ts2miloIdCounter += 1
    return ts2miloIdCounter
}

pub fn jsLen(s: &string): i64 {
    return s.len / 2
}

fn unitAt(s: &string, i: i64): i64 {
    return (s[2 * i] as i64) + (s[2 * i + 1] as i64) * 256
}

fn pushUnit(out: &mut string, u: i64) {
    out.push((u % 256) as u8)
    out.push(((u / 256) % 256) as u8)
}

fn pushCp(out: &mut string, cp: i64) {
    if cp >= 65536 {
        let c = cp - 65536
        pushUnit(&mut out, 55296 + c / 1024)
        pushUnit(&mut out, 56320 + c % 1024)
    } else {
        pushUnit(&mut out, cp)
    }
}

// "" past the end where JavaScript has undefined: every comparison against a real char is
// false either way. Differs only if the undefined itself is printed.
pub fn jsAt(s: &string, i: i64): string {
    var out: string = ""
    if i >= 0 && i < jsLen(s) {
        out.push(s[2 * i])
        out.push(s[2 * i + 1])
    }
    return out
}

// -1 stands for NaN: it fails every range test the same way.
pub fn jsCharCodeAt(s: &string, i: i64): i64 {
    if i < 0 || i >= jsLen(s) {
        return -1
    }
    return unitAt(s, i)
}

pub fn jsSlice(s: &string, a: i64, b: i64): string {
    var out: string = ""
    var i = if a < 0 { 0 } else { a }
    let end = if b > jsLen(s) { jsLen(s) } else { b }
    while i < end {
        out.push(s[2 * i])
        out.push(s[2 * i + 1])
        i += 1
    }
    return out
}

pub fn jsSliceFrom(s: &string, a: i64): string {
    return jsSlice(s, a, jsLen(s))
}

pub fn jsFromCharCode(n: i64): string {
    var out: string = ""
    pushUnit(&mut out, n % 65536)
    return out
}

pub fn jsFromCodePoint(cp: i64): string {
    var out: string = ""
    pushCp(&mut out, cp)
    return out
}

pub fn jsFromUtf8(s: &string): string {
    var out: string = ""
    var i: i64 = 0
    while i < s.len {
        let d = decodeCodepoint(s, i)
        i += d.size
        pushCp(&mut out, d.value as i64)
    }
    return out
}

// Lone surrogates become U+FFFD, as a TextEncoder does.
pub fn jsToUtf8(s: &string): string {
    var out: string = ""
    let n = jsLen(s)
    var i: i64 = 0
    while i < n {
        var cp = unitAt(s, i)
        i += 1
        if cp >= 55296 && cp < 56320 && i < n && unitAt(s, i) >= 56320 && unitAt(s, i) < 57344 {
            cp = 65536 + (cp - 55296) * 1024 + (unitAt(s, i) - 56320)
            i += 1
        } else if cp >= 55296 && cp < 57344 {
            cp = 65533
        }
        if cp < 128 {
            out.push(cp as u8)
        } else if cp < 2048 {
            out.push((192 + cp / 64) as u8)
            out.push((128 + cp % 64) as u8)
        } else if cp < 65536 {
            out.push((224 + cp / 4096) as u8)
            out.push((128 + (cp / 64) % 64) as u8)
            out.push((128 + cp % 64) as u8)
        } else {
            out.push((240 + cp / 262144) as u8)
            out.push((128 + (cp / 4096) % 64) as u8)
            out.push((128 + (cp / 64) % 64) as u8)
            out.push((128 + cp % 64) as u8)
        }
    }
    return out
}

pub fn jsNum(n: i64): string {
    return jsFromUtf8(n.toString())
}

pub fn jsNumRadix(n: i64, radix: i64): string {
    if n == 0 {
        return jsFromUtf8("0")
    }
    var digits: string = ""
    var v = if n < 0 { 0 - n } else { n }
    while v > 0 {
        let d = v % radix
        digits.push((if d < 10 { 48 + d } else { 87 + d }) as u8)
        v = v / radix
    }
    var ascii: string = if n < 0 { "-" } else { "" }
    var i = digits.len - 1
    while i >= 0 {
        ascii.push(digits[i])
        i -= 1
    }
    return jsFromUtf8(ascii)
}

fn digitOf(c: i64): i64 {
    if c >= 48 && c <= 57 {
        return c - 48
    }
    if c >= 97 && c <= 122 {
        return c - 87
    }
    if c >= 65 && c <= 90 {
        return c - 55
    }
    return 99
}

// JavaScript parseInt: longest valid prefix, 0x allowed for radix 16. NaN is returned as 0,
// which every caller's range test treats the way NaN would.
pub fn jsParseInt(s: &string, radix: i64): i64 {
    let n = jsLen(s)
    var i: i64 = 0
    while i < n && (unitAt(s, i) == 32 || unitAt(s, i) == 9 || unitAt(s, i) == 10 || unitAt(s, i) == 13) {
        i += 1
    }
    var neg = false
    if i < n && (unitAt(s, i) == 45 || unitAt(s, i) == 43) {
        neg = unitAt(s, i) == 45
        i += 1
    }
    if radix == 16 && i + 1 < n && unitAt(s, i) == 48 && (unitAt(s, i + 1) == 120 || unitAt(s, i + 1) == 88) {
        i += 2
    }
    var v: i64 = 0
    while i < n && digitOf(unitAt(s, i)) < radix {
        v = v * radix + digitOf(unitAt(s, i))
        i += 1
    }
    return if neg { 0 - v } else { v }
}

// ---- String / Array library methods (single-argument forms; the transpiler refuses the rest) ----

fn unitsEqualAt(s: &string, p: &string, at: i64): bool {
    let n = jsLen(p)
    var k: i64 = 0
    while k < n {
        if unitAt(s, at + k) != unitAt(p, k) {
            return false
        }
        k += 1
    }
    return true
}

pub fn jsStartsWith(s: &string, p: &string): bool {
    return jsLen(p) <= jsLen(s) && unitsEqualAt(s, p, 0)
}

pub fn jsEndsWith(s: &string, p: &string): bool {
    return jsLen(p) <= jsLen(s) && unitsEqualAt(s, p, jsLen(s) - jsLen(p))
}

// -1 when absent; "" is found at 0, as in JavaScript.
pub fn jsIndexOf(s: &string, p: &string): i64 {
    let last = jsLen(s) - jsLen(p)
    var i: i64 = 0
    while i <= last {
        if unitsEqualAt(s, p, i) {
            return i
        }
        i += 1
    }
    return -1
}

// "" is found at s.length, as in JavaScript.
pub fn jsLastIndexOf(s: &string, p: &string): i64 {
    var i = jsLen(s) - jsLen(p)
    while i >= 0 {
        if unitsEqualAt(s, p, i) {
            return i
        }
        i -= 1
    }
    return -1
}

pub fn jsIncludes(s: &string, p: &string): bool {
    return jsIndexOf(s, p) >= 0
}

// ECMAScript WhiteSpace and LineTerminator.
fn isJsSpace(u: i64): bool {
    return (u >= 9 && u <= 13) || u == 32 || u == 160 || u == 5760 || (u >= 8192 && u <= 8202)
    || u == 8232 || u == 8233 || u == 8239 || u == 8287 || u == 12288 || u == 65279
}

pub fn jsTrim(s: &string): string {
    var a: i64 = 0
    var b = jsLen(s)
    while a < b && isJsSpace(unitAt(s, a)) {
        a += 1
    }
    while b > a && isJsSpace(unitAt(s, b - 1)) {
        b -= 1
    }
    return jsSlice(s, a, b)
}

// s.split(sep) for a string separator: "" splits into code units (so [] for an empty s), and a
// non-empty sep on an empty s gives [""].
pub fn jsSplit(s: &string, sep: &string): Vec<string> {
    var out: Vec<string> = []
    let n = jsLen(s)
    let m = jsLen(sep)
    if m == 0 {
        var j: i64 = 0
        while j < n {
            out.push(jsAt(s, j))
            j += 1
        }
        return out
    }
    var start: i64 = 0
    var i: i64 = 0
    while i + m <= n {
        if unitsEqualAt(s, sep, i) {
            out.push(jsSlice(s, start, i))
            i += m
            start = i
        } else {
            i += 1
        }
    }
    out.push(jsSlice(s, start, n))
    return out
}

pub fn jsJoin(v: &Vec<string>, sep: &string): string {
    var out: string = ""
    var i: i64 = 0
    while i < v.len() {
        if i > 0 {
            out = out + sep
        }
        out = out + v[i]
        i += 1
    }
    return out
}

// s.replace(/x/g, r) and s.replaceAll(x, r) for a non-empty literal x and an r with no `$`.
pub fn jsReplaceAll(s: &string, pat: &string, rep: &string): string {
    var out: string = ""
    let n = jsLen(s)
    let m = jsLen(pat)
    var start: i64 = 0
    var i: i64 = 0
    while i + m <= n {
        if unitsEqualAt(s, pat, i) {
            out = out + jsSlice(s, start, i) + rep
            i += m
            start = i
        } else {
            i += 1
        }
    }
    return out + jsSlice(s, start, n)
}

// ---- mirrors of src/ast.ts and src/diagnostics.ts ----

pub enum Severity { Error, Warning, Hint }

pub struct Span {
    line: i64,
    col: i64,
    file: Option<string>,
}

pub struct DiagnosticNote {
    message: string,
    span: Option<Span>,
    len: Option<i64>,
}

pub struct Diagnostic {
    severity: Severity,
    span: Option<Span>,
    len: Option<i64>,
    message: string,
    hint: Option<string>,
    code: Option<string>,
    notes: Option<Vec<DiagnosticNote>>,
}

pub struct ParseError {
    diagnostic: Diagnostic,
    source: Option<string>,
    filePath: Option<string>,
    message: string,
}

impl ParseError {
    fn new(diagnostic: Diagnostic, source: Option<string>, filePath: Option<string>): ParseError {
        var loc: string = ""
        if let Option.Some(sp) = diagnostic.span.clone() {
            loc = jsNum(sp.line) + jsFromUtf8(":") + jsNum(sp.col) + jsFromUtf8(": ")
        }
        let code = diagnostic.code.clone() ?? jsFromUtf8("parse")
        let message = jsFromUtf8("error[") + code + jsFromUtf8("]: ") + loc + diagnostic.message
        return ParseError { diagnostic: diagnostic, source: source, filePath: filePath, message: message }
    }
}

// The JavaScript Error (renamed: the prelude owns `Error`) the frontend throws for internal failures: only `message` is ever read.
pub struct JsError {
    message: string,
}

impl JsError {
    fn new(message: string): JsError {
        return JsError { message: message }
    }
}

// An absent `a?.f`. Milo cannot infer T for a bare Option.None inside a match arm, so the type
// argument is written out at every call.
pub fn optNone<T>(): Option<T> {
    return Option.None
}

// An Option<Heap<T>> field read where an Option<T> is wanted. The type argument is written out at
// every call: inference does not see T through &Option<Heap<T>>.
pub fn optUnbox<T>(o: &Option<Heap<T>>): Option<T> {
    if let Option.Some(h) = o {
        return Option.Some((*h).clone())
    }
    return Option.None
}

// --lenient: the type of a field whose TypeScript type does not translate yet. Code that reads
// the field fails to compile, which marks it; everything else in the class still translates.
pub struct TsOpaque {
}

// ---- Array methods that take a closure (the transpiler passes an arrow literal) ----
// The callback borrows each element, as `for x in v` does. JavaScript's index and array
// callback arguments are not offered: the transpiler refuses a callback that names them.

pub fn jsSome<T>(v: &Vec<T>, f: (&T) => bool): bool {
    for e in v {
        if f(e) {
            return true
        }
    }
    return false
}

pub fn jsEvery<T>(v: &Vec<T>, f: (&T) => bool): bool {
    for e in v {
        if !f(e) {
            return false
        }
    }
    return true
}

pub fn jsForEach<T>(v: &Vec<T>, f: (&T) => void) {
    for e in v {
        f(e)
    }
}

pub fn jsMap<T, U>(v: &Vec<T>, f: (&T) => U): Vec<U> {
    var out: Vec<U> = Vec.new()
    for e in v {
        out.push(f(e))
    }
    return out
}

pub fn jsFindIndex<T>(v: &Vec<T>, f: (&T) => bool): i64 {
    var i: i64 = 0
    for e in v {
        if f(e) {
            return i
        }
        i += 1
    }
    return -1
}

// filter / find / flatMap copy elements out of the borrowed vector, so they are only offered
// for element types that are plain Copy values (number, boolean, string).
pub fn jsFilter<T>(v: &Vec<T>, f: (&T) => bool): Vec<T> {
    var out: Vec<T> = Vec.new()
    for e in v {
        if f(e) {
            out.push(e.clone())
        }
    }
    return out
}

pub fn jsFind<T>(v: &Vec<T>, f: (&T) => bool): Option<T> {
    for e in v {
        if f(e) {
            return Option.Some(e.clone())
        }
    }
    return Option.None
}

pub fn jsFlatMap<T, U>(v: &Vec<T>, f: (&T) => Vec<U>): Vec<U> {
    var out: Vec<U> = Vec.new()
    for e in v {
        let part = f(e)
        for u in part {
            out.push(u.clone())
        }
    }
    return out
}

pub fn jsReduce<T, A>(v: &Vec<T>, f: (A, &T) => A, init: A): A {
    var acc = init
    for e in v {
        acc = f(acc, e)
    }
    return acc
}

// A stubbed function never writes through its `&mut` parameters, which the checker reports as an error;
// passing one on as `&mut` counts as an escape, so a stub hands each to this. It is never reached.
pub fn stubKeep<T>(x: &mut T) {
    if false {
        stubKeep(&mut x)
    }
}
