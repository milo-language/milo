// Hand-written support for the output of scripts/ts2milo.ts. Not generated.
//
// A TypeScript `string` is a Milo `string` holding UTF-16LE: two bytes per code unit. That is
// the one choice that keeps `.length`, `s[i]`, `charCodeAt` and column counts identical to
// JavaScript for non-ASCII source, and `==`, `+`, `pushStr` and HashSet keys still work as
// byte operations. jsFromUtf8 / jsToUtf8 convert at the program edges.
//
// Declarations of types the transpiled files import from untranspiled TypeScript
// (src/diagnostics.ts, src/ast.ts) also live here, mirroring those interfaces.
from "std/unicode" import { decodeCodepoint }
from "std/set" import { HashSet }

// Node identity: every struct that TypeScript uses as a Map/Set key or compares with `===` carries a
// fresh id (scripts/ts2milo/node-identity.ts). A copy keeps the id, as a reference does in TypeScript.
var ts2miloIdCounter: i64 = 0

pub fn ts2miloNextId(): i64 {
    ts2miloIdCounter += 1
    return ts2miloIdCounter
}

pub fn jsLen(s: &string): i64 {
    return s.len / 2
}

fn unitAt(s: &string, i: i64): i64 {
    return (s[2 * i] as i64) + (s[2 * i + 1] as i64) * 256
}

fn pushUnit(out: &mut string, u: i64) {
    out.push((u % 256) as u8)
    out.push(((u / 256) % 256) as u8)
}

fn pushCp(out: &mut string, cp: i64) {
    if cp >= 65536 {
        let c = cp - 65536
        pushUnit(&mut out, 55296 + c / 1024)
        pushUnit(&mut out, 56320 + c % 1024)
    } else {
        pushUnit(&mut out, cp)
    }
}

// "" past the end where JavaScript has undefined: every comparison against a real char is
// false either way. Differs only if the undefined itself is printed.
pub fn jsAt(s: &string, i: i64): string {
    var out: string = ""
    if i >= 0 && i < jsLen(s) {
        out.push(s[2 * i])
        out.push(s[2 * i + 1])
    }
    return out
}

// -1 stands for NaN: it fails every range test the same way.
pub fn jsCharCodeAt(s: &string, i: i64): i64 {
    if i < 0 || i >= jsLen(s) {
        return -1
    }
    return unitAt(s, i)
}

pub fn jsSlice(s: &string, a: i64, b: i64): string {
    var out: string = ""
    var i = if a < 0 { 0 } else { a }
    let end = if b > jsLen(s) { jsLen(s) } else { b }
    while i < end {
        out.push(s[2 * i])
        out.push(s[2 * i + 1])
        i += 1
    }
    return out
}

// src/mangle.ts display / displayQualified, written without regexes. The TypeScript matcher is
// /(?<![A-Za-z0-9])(?:key1|key2|...)/g with the keys longest first; these scan the same way.
fn isAlnumUnit(u: i64): bool {
    return (u >= 48 && u <= 57) || (u >= 65 && u <= 90) || (u >= 97 && u <= 122)
}

fn matchesAt(text: &string, i: i64, key: &string): bool {
    let n = jsLen(key)
    if i + n > jsLen(text) {
        return false
    }
    var k = 0
    while k < n {
        if unitAt(text, i + k) != unitAt(key, k) {
            return false
        }
        k += 1
    }
    return true
}

// The longest key matching `text` at unit i (keys are sorted longest first), unless a letter or digit precedes i.
fn longestKeyAt(text: &string, i: i64, keys: &Vec<string>): Option<string> {
    if i > 0 && isAlnumUnit(unitAt(text, i - 1)) {
        return Option.None
    }
    for k in keys {
        if jsLen(k) > 0 && matchesAt(text, i, k) {
            return Option.Some(k.clone())
        }
    }
    return Option.None
}

fn keysLongestFirst(map: &HashMap<string, string>): Vec<string> {
    var keys = map.keys()
    var i = 1
    while i < keys.len {
        var j = i
        while j > 0 && jsLen(keys[j - 1]) < jsLen(keys[j]) {
            let a = keys[j - 1].clone()
            keys[j - 1] = keys[j].clone()
            keys[j] = a
            j -= 1
        }
        i += 1
    }
    return keys
}

pub fn display(map: &Option<HashMap<string, string>>, text: &string): string {
    match map {
        Option.None => { return text.clone() }
        Option.Some(m) => {
            if m.len == 0 {
                return text.clone()
            }
            let keys = keysLongestFirst(m)
            var out: string = ""
            var i = 0
            let n = jsLen(text)
            while i < n {
                match longestKeyAt(text, i, keys) {
                    Option.Some(k) => {
                        out = out + (m.get(k) ?? k.clone())
                        i += jsLen(k)
                    }
                    Option.None => {
                        out.push(text[2 * i])
                        out.push(text[2 * i + 1])
                        i += 1
                    }
                }
            }
            return out
        }
    }
}

// `w` as a whole word: not preceded or followed by [A-Za-z0-9_$].
fn bareWordIn(text: &string, w: &string): bool {
    let n = jsLen(text)
    let wl = jsLen(w)
    var i = 0
    while i + wl <= n {
        if matchesAt(text, i, w) {
            let before = if i > 0 { unitAt(text, i - 1) } else { 0 }
            let after = if i + wl < n { unitAt(text, i + wl) } else { 0 }
            let bw = isAlnumUnit(before) || before == 95 || before == 36
            let aw = isAlnumUnit(after) || after == 95 || after == 36
            if !bw && !aw {
                return true
            }
        }
        i += 1
    }
    return false
}

pub fn displayQualified(map: &Option<HashMap<string, string>>, text: &string, origins: &HashMap<string, string>): string {
    match map {
        Option.None => { return text.clone() }
        Option.Some(m) => {
            if m.len == 0 {
                return text.clone()
            }
            let keys = keysLongestFirst(m)
            // Every match in order: the matched symbol, the name it is written as, and where it starts.
            var matched: Vec<string> = []
            var writtenOf: Vec<string> = []
            var at: Vec<i64> = []
            var i = 0
            let n = jsLen(text)
            while i < n {
                match longestKeyAt(text, i, keys) {
                    Option.Some(k) => {
                        matched.push(k.clone())
                        writtenOf.push(m.get(k) ?? k.clone())
                        at.push(i)
                        i += jsLen(k)
                    }
                    Option.None => { i += 1 }
                }
            }
            // A written name is ambiguous when two different symbols read as it, or a bare use sits beside a renamed one.
            var ambiguous: Vec<string> = []
            var a = 0
            while a < matched.len {
                let w = writtenOf[a].clone()
                var known = false
                for x in ambiguous {
                    if x == w {
                        known = true
                    }
                }
                if !known {
                    var differs = false
                    var b = 0
                    while b < matched.len {
                        if writtenOf[b] == w && matched[b] != matched[a] {
                            differs = true
                        }
                        b += 1
                    }
                    if differs || bareWordIn(text, w) {
                        ambiguous.push(w)
                    }
                }
                a += 1
            }
            var out: string = ""
            var pos = 0
            var q = 0
            while q < matched.len {
                out = out + jsSlice(text, pos, at[q])
                let w = writtenOf[q].clone()
                var isAmb = false
                for x in ambiguous {
                    if x == w {
                        isAmb = true
                    }
                }
                if !isAmb {
                    out = out + w
                } else {
                    match origins.get(matched[q]) {
                        Option.Some(o) => { out = out + w + jsFromUtf8(" (") + o + jsFromUtf8(")") }
                        Option.None => { out = out + w }
                    }
                }
                pos = at[q] + jsLen(matched[q])
                q += 1
            }
            return out + jsSliceFrom(text, pos)
        }
    }
}

// node:path basename (POSIX, no extension argument): the last component, trailing slashes ignored.
pub fn basename(p: &string): string {
    var end = jsLen(p)
    while end > 0 && jsCharCodeAt(p, end - 1) == 47 {
        end -= 1
    }
    var start = end
    while start > 0 && jsCharCodeAt(p, start - 1) != 47 {
        start -= 1
    }
    return jsSlice(p, start, end)
}

pub fn jsSliceFrom(s: &string, a: i64): string {
    return jsSlice(s, a, jsLen(s))
}

pub fn jsFromCharCode(n: i64): string {
    var out: string = ""
    pushUnit(&mut out, n % 65536)
    return out
}

pub fn jsFromCodePoint(cp: i64): string {
    var out: string = ""
    pushCp(&mut out, cp)
    return out
}

pub fn jsFromUtf8(s: &string): string {
    var out: string = ""
    var i: i64 = 0
    while i < s.len {
        let d = decodeCodepoint(s, i)
        i += d.size
        pushCp(&mut out, d.value as i64)
    }
    return out
}

// Lone surrogates become U+FFFD, as a TextEncoder does.
pub fn jsToUtf8(s: &string): string {
    var out: string = ""
    let n = jsLen(s)
    var i: i64 = 0
    while i < n {
        var cp = unitAt(s, i)
        i += 1
        if cp >= 55296 && cp < 56320 && i < n && unitAt(s, i) >= 56320 && unitAt(s, i) < 57344 {
            cp = 65536 + (cp - 55296) * 1024 + (unitAt(s, i) - 56320)
            i += 1
        } else if cp >= 55296 && cp < 57344 {
            cp = 65533
        }
        if cp < 128 {
            out.push(cp as u8)
        } else if cp < 2048 {
            out.push((192 + cp / 64) as u8)
            out.push((128 + cp % 64) as u8)
        } else if cp < 65536 {
            out.push((224 + cp / 4096) as u8)
            out.push((128 + (cp / 64) % 64) as u8)
            out.push((128 + cp % 64) as u8)
        } else {
            out.push((240 + cp / 262144) as u8)
            out.push((128 + (cp / 4096) % 64) as u8)
            out.push((128 + (cp / 64) % 64) as u8)
            out.push((128 + cp % 64) as u8)
        }
    }
    return out
}

// Appends s as a JSON string literal (UTF-8) to out: the generated AST encoder's string case.
pub fn jsonQuote(s: &string, out: &mut string) {
    let u = jsToUtf8(s)
    let hex = "0123456789abcdef"
    out.push(34)
    var i: i64 = 0
    while i < u.len {
        let b = u[i] as i64
        if b == 34 || b == 92 {
            out.push(92)
            out.push(b as u8)
        } else if b < 32 {
            out.pushStr("\\u00")
            out.push(hex[b / 16])
            out.push(hex[b % 16])
        } else {
            out.push(b as u8)
        }
        i += 1
    }
    out.push(34)
}

pub fn jsNum(n: i64): string {
    return jsFromUtf8(n.toString())
}

pub fn jsNumRadix(n: i64, radix: i64): string {
    if n == 0 {
        return jsFromUtf8("0")
    }
    var digits: string = ""
    var v = if n < 0 { 0 - n } else { n }
    while v > 0 {
        let d = v % radix
        digits.push((if d < 10 { 48 + d } else { 87 + d }) as u8)
        v = v / radix
    }
    var ascii: string = if n < 0 { "-" } else { "" }
    var i = digits.len - 1
    while i >= 0 {
        ascii.push(digits[i])
        i -= 1
    }
    return jsFromUtf8(ascii)
}

fn digitOf(c: i64): i64 {
    if c >= 48 && c <= 57 {
        return c - 48
    }
    if c >= 97 && c <= 122 {
        return c - 87
    }
    if c >= 65 && c <= 90 {
        return c - 55
    }
    return 99
}

// JavaScript parseInt: longest valid prefix, 0x allowed for radix 16. NaN is returned as 0,
// which every caller's range test treats the way NaN would.
pub fn jsParseInt(s: &string, radix: i64): i64 {
    let n = jsLen(s)
    var i: i64 = 0
    while i < n && (unitAt(s, i) == 32 || unitAt(s, i) == 9 || unitAt(s, i) == 10 || unitAt(s, i) == 13) {
        i += 1
    }
    var neg = false
    if i < n && (unitAt(s, i) == 45 || unitAt(s, i) == 43) {
        neg = unitAt(s, i) == 45
        i += 1
    }
    if radix == 16 && i + 1 < n && unitAt(s, i) == 48 && (unitAt(s, i + 1) == 120 || unitAt(s, i + 1) == 88) {
        i += 2
    }
    var v: i64 = 0
    while i < n && digitOf(unitAt(s, i)) < radix {
        v = v * radix + digitOf(unitAt(s, i))
        i += 1
    }
    return if neg { 0 - v } else { v }
}

// parseInt(s) with no radix: 16 when the digits (after space and sign) start with 0x, else 10.
pub fn jsParseIntAuto(s: &string): i64 {
    let n = jsLen(s)
    var i: i64 = 0
    while i < n && (unitAt(s, i) == 32 || unitAt(s, i) == 9 || unitAt(s, i) == 10 || unitAt(s, i) == 13) {
        i += 1
    }
    if i < n && (unitAt(s, i) == 45 || unitAt(s, i) == 43) {
        i += 1
    }
    if i + 1 < n && unitAt(s, i) == 48 && (unitAt(s, i + 1) == 120 || unitAt(s, i + 1) == 88) {
        return jsParseInt(s, 16)
    }
    return jsParseInt(s, 10)
}

// ---- String / Array library methods (single-argument forms; the transpiler refuses the rest) ----

fn unitsEqualAt(s: &string, p: &string, at: i64): bool {
    let n = jsLen(p)
    var k: i64 = 0
    while k < n {
        if unitAt(s, at + k) != unitAt(p, k) {
            return false
        }
        k += 1
    }
    return true
}

pub fn jsStartsWith(s: &string, p: &string): bool {
    return jsLen(p) <= jsLen(s) && unitsEqualAt(s, p, 0)
}

pub fn jsEndsWith(s: &string, p: &string): bool {
    return jsLen(p) <= jsLen(s) && unitsEqualAt(s, p, jsLen(s) - jsLen(p))
}

// -1 when absent; "" is found at 0, as in JavaScript.
pub fn jsIndexOf(s: &string, p: &string): i64 {
    let last = jsLen(s) - jsLen(p)
    var i: i64 = 0
    while i <= last {
        if unitsEqualAt(s, p, i) {
            return i
        }
        i += 1
    }
    return -1
}

// "" is found at s.length, as in JavaScript.
pub fn jsLastIndexOf(s: &string, p: &string): i64 {
    var i = jsLen(s) - jsLen(p)
    while i >= 0 {
        if unitsEqualAt(s, p, i) {
            return i
        }
        i -= 1
    }
    return -1
}

pub fn jsIncludes(s: &string, p: &string): bool {
    return jsIndexOf(s, p) >= 0
}

// ECMAScript WhiteSpace and LineTerminator.
fn isJsSpace(u: i64): bool {
    return (u >= 9 && u <= 13) || u == 32 || u == 160 || u == 5760 || (u >= 8192 && u <= 8202)
    || u == 8232 || u == 8233 || u == 8239 || u == 8287 || u == 12288 || u == 65279
}

// Math.min / Math.max of two numbers (every number is an i64, so no NaN or -0 cases).
pub fn jsMin(a: i64, b: i64): i64 {
    if a < b {
        return a
    }
    return b
}

pub fn jsMax(a: i64, b: i64): i64 {
    if a > b {
        return a
    }
    return b
}

pub fn jsTrim(s: &string): string {
    var a: i64 = 0
    var b = jsLen(s)
    while a < b && isJsSpace(unitAt(s, a)) {
        a += 1
    }
    while b > a && isJsSpace(unitAt(s, b - 1)) {
        b -= 1
    }
    return jsSlice(s, a, b)
}

// s.split(sep) for a string separator: "" splits into code units (so [] for an empty s), and a
// non-empty sep on an empty s gives [""].
pub fn jsSplit(s: &string, sep: &string): Vec<string> {
    var out: Vec<string> = []
    let n = jsLen(s)
    let m = jsLen(sep)
    if m == 0 {
        var j: i64 = 0
        while j < n {
            out.push(jsAt(s, j))
            j += 1
        }
        return out
    }
    var start: i64 = 0
    var i: i64 = 0
    while i + m <= n {
        if unitsEqualAt(s, sep, i) {
            out.push(jsSlice(s, start, i))
            i += m
            start = i
        } else {
            i += 1
        }
    }
    out.push(jsSlice(s, start, n))
    return out
}

pub fn jsJoin(v: &Vec<string>, sep: &string): string {
    var out: string = ""
    var i: i64 = 0
    while i < v.len() {
        if i > 0 {
            out = out + sep
        }
        out = out + v[i]
        i += 1
    }
    return out
}

// s.replace(/x/g, r) and s.replaceAll(x, r) for a non-empty literal x and an r with no `$`.
pub fn jsReplaceAll(s: &string, pat: &string, rep: &string): string {
    var out: string = ""
    let n = jsLen(s)
    let m = jsLen(pat)
    var start: i64 = 0
    var i: i64 = 0
    while i + m <= n {
        if unitsEqualAt(s, pat, i) {
            out = out + jsSlice(s, start, i) + rep
            i += m
            start = i
        } else {
            i += 1
        }
    }
    return out + jsSlice(s, start, n)
}

// ---- mirrors of src/ast.ts and src/diagnostics.ts ----

pub enum Severity { Error, Warning, Hint }

// A source literal's value: `bigint | number | string | boolean` in ast.ts (LiteralPattern.value). Big is the decimal text, as every bigint is.
@derive(Clone)
pub enum JsPrim { Big(string), Num(f64), Str(string), Bool(bool) }

// -BigInt(s) for the lexer's canonical decimal text: -0n is 0n.
pub fn jsBigNeg(s: &string): string {
    let zero = jsFromUtf8("0")
    if s == zero {
        return zero
    }
    return jsFromUtf8("-") + s
}

@derive(Clone)
pub struct Span {
    id: i64,
    line: i64,
    col: i64,
    file: Option<string>,
}

@derive(Clone)
pub struct DiagnosticNote {
    message: string,
    span: Option<Span>,
    len: Option<i64>,
}

@derive(Clone)
pub struct Diagnostic {
    severity: Severity,
    span: Option<Span>,
    len: Option<i64>,
    message: string,
    hint: Option<string>,
    code: Option<string>,
    notes: Option<Vec<DiagnosticNote>>,
}

// src/diagnostics.ts WarningConfig: Set fields are HashSet<string> of UTF-16 names.
pub struct WarningConfig {
    denied: HashSet<string>,
    allowed: HashSet<string>,
    expected: Option<HashSet<string>>,
    warned: Option<HashSet<string>>,
    maxStackArrayBytes: Option<i64>,
}

// src/target.ts TargetInfo; os/arch are plain strings (the literal unions are not modelled).
@derive(Clone)
pub struct TargetInfo {
    triple: string,
    os: string,
    arch: string,
    bareMetal: Option<bool>,
    mcpu: Option<string>,
    floatAbi: Option<string>,
    qemuMachine: Option<string>,
}

// src/replay-externs.ts ReplayPlan.
@derive(Clone)
pub struct ReplayPlan {
    wrapper: string,
    variadic: bool,
    fixed: i64,
    hole: Option<string>,
}

pub struct ParseError {
    diagnostic: Diagnostic,
    source: Option<string>,
    filePath: Option<string>,
    message: string,
}

impl ParseError {
    fn new(diagnostic: Diagnostic, source: Option<string>, filePath: Option<string>): ParseError {
        var loc: string = ""
        if let Option.Some(sp) = diagnostic.span.clone() {
            loc = jsNum(sp.line) + jsFromUtf8(":") + jsNum(sp.col) + jsFromUtf8(": ")
        }
        let code = diagnostic.code.clone() ?? jsFromUtf8("parse")
        let message = jsFromUtf8("error[") + code + jsFromUtf8("]: ") + loc + diagnostic.message
        return ParseError { diagnostic: diagnostic, source: source, filePath: filePath, message: message }
    }
}

// The JavaScript Error (renamed: the prelude owns `Error`) the frontend throws for internal failures: only `message` is ever read.
pub struct JsError {
    message: string,
}

impl JsError {
    fn new(message: string): JsError {
        return JsError { message: message }
    }
}

// An absent `a?.f`. Milo cannot infer T for a bare Option.None inside a match arm, so the type
// argument is written out at every call.
pub fn optNone<T>(): Option<T> {
    return Option.None
}

// An Option<Heap<T>> field read where an Option<T> is wanted. The type argument is written out at
// every call: inference does not see T through &Option<Heap<T>>.
// A one-element Vec where the element type cannot be inferred from context (a literal straight into Heap(...)).
pub fn vec1<T>(a: T): Vec<T> {
    var v: Vec<T> = Vec.new()
    v.push(a)
    return v
}

pub fn optBox<T>(o: Option<T>): Option<Heap<T>> {
    return match o {
        Option.Some(v) => Option.Some(Heap(v)),
        Option.None => Option.None,
    }
}

pub fn optUnbox<T>(o: &Option<Heap<T>>): Option<T> {
    if let Option.Some(h) = o {
        return Option.Some((*h).clone())
    }
    return Option.None
}

// --lenient: the type of a field whose TypeScript type does not translate yet. Code that reads
// the field fails to compile, which marks it; everything else in the class still translates.
pub struct TsOpaque {
}

// ---- Array methods that take a closure (the transpiler passes an arrow literal) ----
// The callback borrows each element, as `for x in v` does. JavaScript's index and array
// callback arguments are not offered: the transpiler refuses a callback that names them.

pub fn jsSome<T>(v: &Vec<T>, f: (&T) => bool): bool {
    for e in v {
        if f(e) {
            return true
        }
    }
    return false
}

pub fn jsEvery<T>(v: &Vec<T>, f: (&T) => bool): bool {
    for e in v {
        if !f(e) {
            return false
        }
    }
    return true
}

pub fn jsForEach<T>(v: &Vec<T>, f: (&T) => void) {
    for e in v {
        f(e)
    }
}

pub fn jsMap<T, U>(v: &Vec<T>, f: (&T) => U): Vec<U> {
    var out: Vec<U> = Vec.new()
    for e in v {
        out.push(f(e))
    }
    return out
}

pub fn jsFindIndex<T>(v: &Vec<T>, f: (&T) => bool): i64 {
    var i: i64 = 0
    for e in v {
        if f(e) {
            return i
        }
        i += 1
    }
    return -1
}

// filter / find / flatMap copy elements out of the borrowed vector, so they are only offered
// for element types that are plain Copy values (number, boolean, string).
pub fn jsFilter<T>(v: &Vec<T>, f: (&T) => bool): Vec<T> {
    var out: Vec<T> = Vec.new()
    for e in v {
        if f(e) {
            out.push(e.clone())
        }
    }
    return out
}

// filter over a fresh (owned) vector whose elements are not Copy: the kept ones are moved, in order.
pub fn jsFilterOwned<T>(v: Vec<T>, f: (&T) => bool): Vec<T> {
    var src = v
    var rev: Vec<T> = Vec.new()
    var more = true
    while more {
        match src.pop() {
            Option.Some(e) => {
                if f(e) {
                    rev.push(e)
                }
            }
            Option.None => {
                more = false
            }
        }
    }
    var out: Vec<T> = Vec.new()
    more = true
    while more {
        match rev.pop() {
            Option.Some(e) => {
                out.push(e)
            }
            Option.None => {
                more = false
            }
        }
    }
    return out
}

pub fn jsFind<T>(v: &Vec<T>, f: (&T) => bool): Option<T> {
    for e in v {
        if f(e) {
            return Option.Some(e.clone())
        }
    }
    return Option.None
}

pub fn jsFlatMap<T, U>(v: &Vec<T>, f: (&T) => Vec<U>): Vec<U> {
    var out: Vec<U> = Vec.new()
    for e in v {
        let part = f(e)
        for u in part {
            out.push(u.clone())
        }
    }
    return out
}

pub fn jsReduce<T, A>(v: &Vec<T>, f: (A, &T) => A, init: A): A {
    var acc = init
    for e in v {
        acc = f(acc, e)
    }
    return acc
}

// A stubbed function never writes through its `&mut` parameters, which the checker reports as an error;
// passing one on as `&mut` counts as an escape, so a stub hands each to this. It is never reached.
pub fn stubKeep<T>(x: &mut T) {
    if false {
        stubKeep(&mut x)
    }
}

// xs.pop(): the last element moved out, or None when empty.
pub fn vecPop<T>(v: &mut Vec<T>): Option<T> {
    return v.pop()
}

pub fn vecPopHeap<T>(v: &mut Vec<Heap<T>>): Option<T> {
    if let Option.Some(h) = v.pop() {
        return Option.Some(*h)
    }
    return Option.None
}

// parseFloat for the number text the lexer produces (digits, optional fraction and exponent, no underscores).
pub fn jsParseFloat(s: &string): f64 {
    let u = jsToUtf8(s)
    match u.parseF64() {
        Option.Some(v) => {
            return v
        }
        Option.None => {
            return 0.0 / 0.0
        }
    }
}

// JSON.stringify of a number, as UTF-8: Number.prototype.toString's layout over the shortest round-trip digits.
pub fn jsF64Json(x: f64): string {
    if x != x || x > 1.7976931348623157e308 || x < -1.7976931348623157e308 {
        return "null"
    }
    if x == 0.0 {
        return "0"
    }
    var v = x
    var neg = false
    if v < 0.0 {
        neg = true
        v = -v
    }
    let s = v.toString()
    var all: string = ""
    var intDigits: i64 = 0
    var seenDot = false
    var exp: i64 = 0
    var i: i64 = 0
    while i < s.len {
        let c = s[i] as i64
        if c >= 48 && c <= 57 {
            all.push(c as u8)
            if !seenDot {
                intDigits += 1
            }
        } else if c == 46 {
            seenDot = true
        } else if c == 101 {
            i += 1
            var eneg = false
            if s[i] == 45 {
                eneg = true
                i += 1
            } else if s[i] == 43 {
                i += 1
            }
            while i < s.len {
                exp = exp * 10 + (s[i] as i64) - 48
                i += 1
            }
            if eneg {
                exp = 0 - exp
            }
            break
        }
        i += 1
    }
    var lead: i64 = 0
    while lead < all.len && all[lead] == 48 {
        lead += 1
    }
    var end = all.len
    while end > lead && all[end - 1] == 48 {
        end -= 1
    }
    let k = end - lead
    let n = intDigits - lead + exp
    var out: string = ""
    if neg {
        out.pushStr("-")
    }
    if k <= n && n <= 21 {
        var j = lead
        while j < end {
            out.push(all[j])
            j += 1
        }
        var z = k
        while z < n {
            out.push(48)
            z += 1
        }
    } else if 0 < n && n <= 21 {
        var j = lead
        while j < end {
            if j - lead == n {
                out.push(46)
            }
            out.push(all[j])
            j += 1
        }
    } else if -6 < n && n <= 0 {
        out.pushStr("0.")
        var z = n
        while z < 0 {
            out.push(48)
            z += 1
        }
        var j = lead
        while j < end {
            out.push(all[j])
            j += 1
        }
    } else {
        let e = n - 1
        out.push(all[lead])
        if k > 1 {
            out.push(46)
            var j = lead + 1
            while j < end {
                out.push(all[j])
                j += 1
            }
        }
        out.push(101)
        if e < 0 {
            out.push(45)
        } else {
            out.push(43)
        }
        out.pushStr((if e < 0 { 0 - e } else { e }).toString())
    }
    return out
}
