// @runtime-error: negative length at tests/runtime-errors/vecFilledNegative.milo:10:23: -2
// Vec.filled is std/vec's vecFilled; the negative-count check rides the argument at the
// call, so the panic names this line, as the builtin's did.

pub fn neg(): i64 {
    return -2
}

pub fn main(): i32 {
    let v: Vec<i64> = Vec.filled(neg(), 1)
    print(v.len())
    return 0
}
