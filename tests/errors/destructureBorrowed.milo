// A non-Copy field of a borrowed struct cannot be moved out by a pattern either; the
// rule and the message are the field read's.
// @error: cannot move 'r.name' out of the borrowed 'r'
struct R { fd: i32, name: string }
fn g(r: &R): void {
    let { name } = r
    print(name)
}
fn main(): i32 {
    let r = R { fd: 1, name: "x" }
    g(r)
    return 0
}
