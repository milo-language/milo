// @error: 'v' may reallocate here while 'p' still points into its buffer (from 'v.ptr()' on line 11)
// A bound `*T` from `v.ptr()` is an element view: push may realloc and free the buffer it addresses.
from "std/os" import {
    strlen
}

pub fn main(): i32 {
    var v: Vec<u8> = Vec.new()
    v.push(65)
    v.push(0)
    let p = v.ptr()
    var i = 0
    while i < 100000 {
        v.push(66)
        i = i + 1
    }
    let n = strlen(p)
    print("len " + n.toString())
    return 0
}
