// @error: field 'a' of 'Pair': expected i64, got string

// A struct literal that spells its type arguments is checked against them: the fields
// do not get to pick a different instance.
struct Pair<A, B> {
    a: A,
    b: B,
}

fn main() {
    let p = Pair<i64, string> { a: "no", b: "x" }
    print(p.b)
}
