// Handing a borrowing closure to a function that KEEPS it. `wrap` stores its parameter in
// a struct it returns, so the closure outlives the frame its capture lives in — a live
// SIGKILL. The signature says so: `move` marks a parameter the callee may keep, and a
// plain one is non-escaping (only called or passed on), so passing the same closure to a
// plain parameter is still accepted (tests/fixtures/closureNonRetainingArg.milo).
// @error: cannot pass a closure that captures 'n' by reference to 'wrap', which keeps it

struct Box {
    f: (i64) => i64,
}

fn wrap(g: move (i64) => i64): Box {
    return Box { f: g }
}

fn make(): Box {
    let n = 5
    let f = (x: i64) => x + n
    return wrap(f)
}

fn main() {
    let b = make()
    print(b.f(1))
}
