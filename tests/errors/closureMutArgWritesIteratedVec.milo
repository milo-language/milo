// @error: cannot write to 'v' by calling 'clr' while a loop iterates over 'v'
// A closure that passes its capture to a user fn's `&mut` parameter writes it, as an
// assignment would. Unrecorded, `clr()` inside the loop cleared `v` and the loop then
// printed a freed string.
fn wipe(v: &mut Vec<string>): void { v.clear() }
pub fn main(): i32 {
    var v: Vec<string> = Vec.new()
    v.push("a heap string long enough to be on the heap for sure".clone())
    let clr = (): void => { wipe(&mut v) }
    for s in v {
        clr()
        print(s)
    }
    return 0
}
