// `?` boxes an error into Heap<Error> only when its type can answer message(); a bare
// struct has nothing to say and is rejected at the `?`, not at the caller's match.
// @error: '?' error type mismatch: 'Silent' cannot be boxed as 'Heap<Error>' because it does not satisfy interface 'Error' (needs message(self: &Self))
struct Silent {
    code: i32,
}
fn f(): Result<i32, Silent> {
    return Result.Err(Silent { code: 1 })
}
fn g(): Result<i32, Heap<Error>> {
    let v = f()?
    return Result.Ok(v)
}
fn main(): i32 {
    let _ = g()
    return 0
}
