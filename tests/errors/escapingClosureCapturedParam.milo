// The same hole reached through a parameter. `wrap` captures its parameter in the `move`
// closure it returns, so the parameter has to be `move` (a plain one is non-escaping:
// tests/errors/nonEscapingParamMoveCapture.milo), and a borrowing closure handed to it
// would outlive its frame: this once printed -1 for 8.
// @error: cannot pass a closure that captures 'n' by reference to 'wrap', which keeps it

fn wrap(f: move (i64) => i64): move () => i64 {
    return move (): i64 => f(3)
}

fn make(): move () => i64 {
    let n = 5
    let g = (x: i64) => x + n
    return wrap(g)
}

fn main() {
    let h = make()
    print(h())
}
