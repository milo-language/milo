// @error: 'answers' is a mutable global, and this code runs on a real OS thread
// Pins: dbPoolRun's closure runs on a pool thread, so a read-only use of a `var` global
// there is an error once main writes that global ("filled at startup, read in pool
// jobs"). The fix is a `let` global whose initializer fills it.
from "std/sqlite" import { Database }
from "std/dbpool" import { DbPool, dbPoolRun }

var answers: Vec<string> = []

fn main(): void {
    answers.push("yes")
    let pool = DbPool.open("app.db", 1)!
    let _n = dbPoolRun(pool, move(db: &Database): i64 => answers.len).await()!
}
