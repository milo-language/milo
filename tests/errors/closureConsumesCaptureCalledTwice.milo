// @error: moves a captured value out of itself when it runs
// A closure that moves a capture out owns it, `move` written or not: by reference, the
// move emptied the caller's variable behind its back, the caller then freed it again
// (an ASan double free), and a second call read the emptied slot.
fn take(s: Vec<i64>): i64 {
    return s.len
}

pub fn main(): i32 {
    let s = Vec<i64>.filled(3, 7)
    let f = (): i64 => take(s)
    print(f().toString())
    print(f().toString())
    return 0
}

// Vec<i64> stands in for `string`: strings are values now (copy on write, shared by
// count where the code reads them again), so the rule is held with a type that still moves.
