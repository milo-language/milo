// @error: 'c' used after its source 'v' was moved (from 'v.ptr()' on line 17)
// A struct carrying the pointer is a holder too: reading a field of it after the source moved is the same use after free.
from "std/os" import {
    strlen
}

struct Cfg {
    buf: *u8
}

fn take(v: Vec<u8>): i64 {
    return v.len
}

pub fn main(): i32 {
    var v: Vec<u8> = [65, 0]
    let c = Cfg { buf: v.ptr() }
    print(take(v))
    print(strlen(c.buf))
    return 0
}
