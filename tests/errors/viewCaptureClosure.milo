// a closure stores its captures and can outlive the frame that owns the Vec, so a view
// captured by one dangles — this returned garbage from freed memory before the check
fn makeGetter(): () => i64 {
    var v: Vec<i64> = Vec.new()
    v.push(111)
    let s = v[0..1]
    return move (): i64 => { return s[0] }
}
fn main(): i32 {
    let g = makeGetter()
    print(g())
    return 0
}
// @error: cannot capture 's' in a 'move' closure
