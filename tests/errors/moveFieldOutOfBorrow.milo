// @error: cannot move 'd.text' out of the borrowed 'd'
//
// Returning a non-Copy field out of a `&T` used to compile, and produced a
// String that aliased a pointee the caller was about to drop: the value printed
// as freed bytes and then double-freed. A whole `&T` binding was already
// rejected here; the field read is the same hazard one level down.

struct Doc {
    text: Text,
}

fn describe(d: &Doc): Text {
    return d.text
}

fn main() {
    let doc = Doc {
        text: Text { s: "hi" },
    }
    print(describe(doc))
}

// Text stands in for `string`: a string copied out of a borrow, a global or an element
// is shared by count now (tests/fixtures/sharedStringBorrows.milo), so the rule is held
// with a type that still moves.
struct Text { s: string }
