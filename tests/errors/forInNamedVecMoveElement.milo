// @error: cannot move the borrowed value out of 's'
// Only an owned temporary is consumed. A loop over a named Vec still binds each element
// by reference, so moving one out stays an error (the Vec still owns it).

fn main(): i32 {
    let v: Vec<string> = ["a".repeat(2), "b".repeat(2)]
    var out: Vec<string> = []
    for s in v {
        out.push(s)
    }
    print(out.len)
    return 0
}
