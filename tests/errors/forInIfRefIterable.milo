// @error: cannot move the borrowed value out of 'a'
// A fork with a borrowed container in an arm is a value the loop would own, so it
// moves each tail exactly as `let t = if c { a } else { b }` does, and a borrow cannot
// be moved out of. This used to compile into a copy of the caller's Vec that the loop
// then freed: a use-after-free in the caller. Iterate `a` by name instead.

fn pick(c: bool, a: &Vec<string>): i64 {
    let none: Vec<string> = []
    var n: i64 = 0
    for x in if c { a } else { none } {
        n = n + x.len
    }
    return n
}

fn main(): i32 {
    let a: Vec<string> = ["aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"]
    print(pick(true, a))
    print(a.len)
    return 0
}
