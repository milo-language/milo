// @error: cannot move the borrowed value out of 'msg'
//
// Same as borrowedEnumTailMove, with the match feeding a 'let' instead of a 'return'.
enum E {
    A(i64, string),
    B(string),
}

fn pick(e: &E): string {
    let s = match e {
        E.A(_n, msg) => msg
        E.B(msg) => msg
    }
    return s
}
fn main() {
    let e = E.B("a string long enough to live on the heap".clone())
    print(pick(e))
}
