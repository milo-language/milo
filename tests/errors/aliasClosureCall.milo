// Calling a closure value with by-ref parameters is checked like a plain call.
struct S { a: i64, b: i64 }

fn main(): i32 {
    var s = S { a: 1, b: 2 }
    let c = (x: &mut S, y: &S): i64 => {
        x.a = 5
        return y.a
    }
    print(c(&mut s, s))
    return 0
}
// @error: 's' is borrowed mutably and shared in the same call
