// @error: use of moved variable 's'
// `f` reads `s` through its by-reference capture, which is the caller's own slot. Moving
// `s` zeroes that slot, so the call would read an empty string: calling the closure is a
// use of `s` like any direct read.
fn consume(s: string): void { print(s.len.toString()) }
pub fn main(): i32 {
    var s = "a heap string long enough to be on the heap for sure".clone()
    let f = (): i64 => s.len
    consume(s)
    print(f().toString())
    return 0
}
