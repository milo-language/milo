// @error: non-escaping closure parameter 'f' is captured by a 'move' closure
// A plain closure-typed parameter is non-escaping: the callee may call it or pass it on
// to another plain closure parameter, nothing else (docs/language-reference.md, Closures).
// A `move` closure copies the `{fn, env}` pair, and the env may point into the caller.
fn wrap(f: () => i64): move () => i64 {
    return move (): i64 => f() + 1
}

pub fn main(): i32 {
    let g = wrap((): i64 => 3)
    print(g().toString())
    return 0
}
