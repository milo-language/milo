// A lent `move` closure captured by a `move` closure the callee returns would run after
// the caller dropped it.
// @error: non-escaping closure parameter 'f' is captured by a 'move' closure

fn keep(f: (i64) => i64): move (i64) => i64 {
    return move (x: i64) => f(x)
}

pub fn main(): i32 {
    let s = "abc"
    let h = move (x: i64) => x + s.len
    let g = keep(h)
    print(g(1))
    return 0
}
