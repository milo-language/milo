// @error: 'w' may reallocate here while 'p' still points into its buffer (from 'v.ptr()' on line 9)
// Moving the Vec keeps its buffer in place, so the pointer's obligation moves with it.
from "std/os" import {
    strlen
}

pub fn main(): i32 {
    var v: Vec<u8> = Vec.new()
    let p = v.ptr()
    var w = v
    w.push(0)
    print(strlen(p))
    return 0
}
