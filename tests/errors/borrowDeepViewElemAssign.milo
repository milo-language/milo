// A view through an element of a container (`vs[0][1..3]`) is deep: overwriting the element frees the
// buffer the view points into, so an element write is a conflict with it (a shallow view of `vs` is not).
// @error: cannot assign to 'vs[...]' because 'vs' is being iterated
fn main(): void {
    var vs: Vec<Vec<i64>> = [[1, 2, 3], [4, 5, 6]]
    let s = vs[0][1..3]
    vs[0] = [7]
    print(s.len())
}
