// @error: cannot move the borrowed value out of 'm'
//
// An if-let payload through a '&E' is a view; returning it would alias the caller's buffer.
enum E {
    A(i64, string),
    B(string),
}

fn pick(e: &E): string {
    if let E.B(m) = e { return m }
    return "none".clone()
}
fn main() {
    let e = E.B("a string long enough to live on the heap".clone())
    print(pick(e))
}
