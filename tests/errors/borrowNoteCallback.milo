// @error: cannot call 'push' on 'items' while 'items.each' borrows it
// @note: 7:5 'items.each' borrows 'items' until its callback returns
// A callback over its own receiver names the call that holds the borrow.
fn main(): void {
    var items: Vec<i64> = Vec.new()
    items.push(1)
    items.each((x: &i64) => {
        items.push(1)
    })
}
