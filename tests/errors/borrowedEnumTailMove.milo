// @error: cannot move the borrowed value out of 'msg'
//
// An arm's tail hands its payload binding out as the match's value. Through a '&E'
// the binding is a view, so returning it shallow-copied the caller's buffer and
// double-freed (exit 133). The tail is moved after the arm's scope closes, which is
// how it slipped past the rule a 'return msg' statement already hit.
enum E {
    A(i64, Text),
    B(Text),
}

fn pick(e: &E): Text {
    return match e {
        E.A(_n, msg) => msg
        E.B(_) => Text { s: "b" }
    }
}
fn main() {
    let e = E.B(Text { s: "a Text long enough to live on the heap".clone() })
    print(pick(e))
}

// Text stands in for `string`: a string copied out of a borrow, a global or an element
// is shared by count now (tests/fixtures/sharedStringBorrows.milo), so the rule is held
// with a type that still moves.
struct Text { s: string }
