// @error: non-escaping closure parameter 'f' is passed to 'push', which may keep it
// A plain closure-typed parameter is non-escaping: the callee may call it or pass it on
// to another plain closure parameter, nothing else (docs/language-reference.md, Closures).
fn keep(v: &mut Vec<() => i64>, f: () => i64) {
    v.push(f)
}

pub fn main(): i32 {
    var v: Vec<() => i64> = Vec.new()
    keep(&mut v, (): i64 => 3)
    print(v.len.toString())
    return 0
}
