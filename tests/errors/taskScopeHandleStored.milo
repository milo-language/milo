// @error: the task scope 's' can only be used as 's.spawn(...)'
// The scope handle cannot be copied out of the body: a second name for it could spawn
// after the scope has joined (docs/plans/task-scope-2026-10.md, rule 1).
from "std/runtime" import {
    Task
}

pub fn main(): i32 {
    Task.scope((s) => {
        let h = s
        h.spawn(() => print("x"))
    })
    return 0
}
