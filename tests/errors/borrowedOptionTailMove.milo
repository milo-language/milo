// @error: cannot move the borrowed value out of 's'
//
// The Option form of borrowedEnumTailMove: a 'Some' binding through a '&Option' leaving
// as the match's value.
fn pick(o: &Option<string>): string {
    return match o {
        Some(s) => s
        None => "none".clone()
    }
}

fn main() {
    let o: Option<string> = Some("a string long enough to live on the heap".clone())
    print(pick(o))
}
