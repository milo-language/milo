// @error: use of moved variable 'k'
// An array literal owns each element as it is built, so a later element cannot read one
// an earlier element moved: `[k, k.clone()]` cloned an emptied string.
fn main() {
    let k = Vec<i64>.filled(3, 7)
    let a = [k, k.clone()]
    print(a[1])
}

// Vec<i64> stands in for `string`: strings are values now (copy on write, shared by
// count where the code reads them again), so the rule is held with a type that still moves.
