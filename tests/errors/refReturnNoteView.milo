// @error: 'dangle' cannot return a reference
// @error-at: 6:14
// @note: 8:12 the returned slice points into 'local', which is freed when 'dangle' returns
// One error for one mistake: the caret is on the '&string' return type, and the return
// that hands out the slice is a note naming why it dangles (a local, dropped at the return).
fn dangle(): &string {
    let local = "hi there".clone()
    return local[0..2]
}
fn main(): void { print(dangle()) }
