// The other half: `??` also moves the payload OUT of its Option operand. The enum's
// tag survives, so `o` still matched `Option.Some` afterwards and handed out an emptied
// payload — a use-after-move that read as a legitimate value.
// @error: use of moved variable 'o'
fn main() {
    var d = "dflt"
    d.pushStr("-x")
    let o: Option<string> = Option.Some("payload-long-enough")
    let n = (o ?? d).len
    print(n.toString())
    if let Option.Some(p) = o {
        print(p)
    }
}
