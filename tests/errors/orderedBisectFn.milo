// @error: 'bisectLeft<Task>' is not allowed: 'bisectLeft' orders its elements with '<', which 'Task' does not have
// An `@ordered` generic fn is rejected at the call, on the caller's line, instead of at the
// `<` inside std/collections.
from "std/collections" import { bisectLeft }

struct Task {
    pri: i64,
}

fn main(): i32 {
    let v: Vec<Task> = []
    print(bisectLeft(v, Task { pri: 1 }))
    return 0
}
