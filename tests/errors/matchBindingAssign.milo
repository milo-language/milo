// @error: is bound by a pattern of an immutable subject
//
// Assigning to a match binding of a `&Node` subject is rejected. The hint names the two
// ways that work: match through a `&mut` subject (the payload then binds as a `&mut`
// view, tests/fixtures/matchMutPayload.milo) or rebuild the variant. It must not offer
// the generic "declare with 'var'" advice: `v` is a pattern binding and there is no
// `let` to change.
enum Node {
    Leaf(i64),
    Branch(string),
}

fn bump(n: &Node): void {
    match n {
        Node.Leaf(v) => { v = v + 1 }
        Node.Branch(s) => { print("branch ", s) }
    }
}

fn main() {
    var n = Node.Leaf(1)
    bump(n)
}
