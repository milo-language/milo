// @error: is bound by a pattern, and no spelling of the pattern makes it mutable
//
// Assigning to a match binding is rejected, which is correct. The DIAGNOSTIC was the
// problem: it offered the generic "declare with 'var' instead of 'let'" advice, and
// there is no `let` here to change. `v` is a pattern binding, no spelling of the pattern
// makes it mutable, and the reader was sent to fix something that does not exist.
//
// The hint now names the move that works, which is O(1) and clones nothing: rebuild the
// variant and assign it to the matched variable. See backlog Tier 1 #24, whose expensive
// half (binding a payload as `&mut` so it can be mutated in place) is still open.
enum Node {
    Leaf(i64),
    Branch(string),
}

fn bump(n: &mut Node): void {
    match n {
        Node.Leaf(v) => { v = v + 1 }
        Node.Branch(s) => { print("branch ", s) }
    }
}

fn main() {
    var n = Node.Leaf(1)
    bump(&mut n)
}
