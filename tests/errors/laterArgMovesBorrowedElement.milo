// @error: 'v' is borrowed by one argument and moved out by a later one (a move of 'v')
// The nested call takes `v` by value and drops it before `show` runs, so the earlier
// `&` argument into `v[0]` reads a freed string.
fn consume(v: Vec<string>): i64 { return v.len }
fn show(s: &string, n: i64): void { print(s); print(n.toString()) }
pub fn main(): i32 {
    var v: Vec<string> = Vec.new()
    v.push("a heap string long enough to be on the heap for sure".clone())
    show(v[0], consume(v))
    return 0
}
