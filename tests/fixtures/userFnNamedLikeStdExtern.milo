// @expect: -12345
// @expect: true
// A program's own `pub fn kill` shares its name with a C function std declares (kill(2),
// which std/platform's killRaw calls). In the flat namespace it used to take std's own
// call, which then failed to type-check inside std/platform; the resolver now renames
// the program's fn in its module instead. (Without that rename the C kill wins this file's
// own call; the arguments are a pid nothing has and signal 0, so it would only fail.)
from "std/platform" import { devNullPath }

pub fn kill(a: i64, b: i64): i64 {
    return a + b
}

pub fn main(): i32 {
    print(kill(-12345, 0))
    print(devNullPath().len() > 0)
    return 0
}
