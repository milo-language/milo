// @wrapping makes a whole routine's arithmetic modular (defined two's-complement wrap /
// masked shift) instead of trapping. Div-by-zero and bounds still trap; see the
// runtime-errors fixtures. Per-op .checkedAdd still opts a single op back into checking.
// @expect: -2147483648
// @expect: 2147483647
// @expect: -2147483648
// @expect: 256
// @expect: -2147483648
// @expect: 0
// @expect: 7
@wrapping
fn modular() {
    let a: i32 = 2147483647
    print(a + 1) // wrap -> INT_MIN
    let b: i32 = -2147483648
    print(b - 1) // wrap -> INT_MAX
    print(0 - b) // negate INT_MIN -> INT_MIN
    let one: i32 = 1
    let sh: i32 = 40
    print(one << sh) // shift amount masked 40&31=8 -> 256
    let min: i32 = -2147483648
    let neg1: i32 = -1
    print(min / neg1) // INT_MIN / -1 wraps -> INT_MIN
    print(min % neg1) // -> 0
    print(3 + 4) // ordinary arithmetic unaffected
}

pub fn main() {
    modular()
}
