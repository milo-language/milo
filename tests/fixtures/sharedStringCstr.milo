// cstr() after sharing: C may write through the pointer, so cstr() first makes its string
// the only handle to the buffer (sharedStringCBoundary*.milo). The two handles' pointers
// then differ, and each reads its own NUL-terminated text (the bytes, not the count header).
extern fn strlen(s: *u8): i64

fn main() {
    var a = "hello".repeat(2)
    let b = a.clone()
    unsafe {
        let pa = a.cstr() as i64
        let pb = b.cstr() as i64
        print(pa == pb)
        print(strlen(a.cstr()))
    }
    a.pushStr(" world")
    unsafe {
        let pa = a.cstr() as i64
        let pb = b.cstr() as i64
        print(pa == pb)
        print(strlen(a.cstr()))
        print(strlen(b.cstr()))
    }
    var c = b.clone()
    c.truncate(3)
    unsafe {
        print(strlen(c.cstr()))
        print(strlen(b.cstr()))
        print(strlen(b))
    }
    print(a)
    print(b)
    print(c)
}

