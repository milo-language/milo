// An if-expression bound to an Option type hands the Option to each branch tail, so
// `Option.None` in a branch infers its T. The binding used to unwrap the hint to T for
// the if as a whole (auto-wrapping plain values), leaving None with nothing to infer from.

// @expect: 0 7 8 3 8
pub fn main(): i32 {
    let c = false
    let a: Option<i64> = if c { Option.Some(5) } else { Option.None }
    var b: Option<i64> = Option.None
    b = if !c { Option.Some(7) } else { Option.None }
    let w: Option<u8> = if c { 16 } else { 8 }
    let n: Option<i64> = if c { Option.None } else { if !c { Option.Some(3) } else { Option.None } }
    let h: i64 = if c { 16 } else { 8 }
    print((a ?? 0).toString(), " ", (b ?? 0).toString(), " ", (w ?? 0).toString(), " ", (n ?? 0).toString(), " ", h.toString())
    return 0
}
