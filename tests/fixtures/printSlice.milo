// @expect: [2, 3]
// @expect: [1, 2]
// @expect: []
// @expect: ["hi", "yo"]
// @expect: [P { x: 1 }]
// @expect: [7, 8]
// @expect: [1, 2, 3, 4]
// @expect: slice=[3, 4]

// A slice shares the Vec's %Vec runtime rep, so print renders it with the same
// runtime-length walk. It used to fall through to "<unprintable>" while the Vec
// it viewed printed fine.
struct P {
    x: i64
}

pub fn show(s: &[i64]): void {
    print(s)
}

pub fn main(): i32 {
    var v: Vec<i64> = [1, 2, 3, 4]
    print(v[1..3])
    print(v.slice(0, 2))
    print(v.slice(0, 0))

    let strs: Vec<string> = ["hi", "yo"]
    print(strs[0..2])

    var ps: Vec<P> = Vec.new()
    ps.push(P {
        x: 1
    })
    print(ps[0..1])

    let arr: [i64; 3] = [7, 8, 9]
    print(arr[0..2])

    show(v)
    print($"slice={v[2..4]}")
    return 0
}
