// @skip-os: win32
// Windows readiness is sockets-only and IOCP is not built, so a pipe fd there cannot be read
// through a stream or a channel (std/event.windows.milo).
// OwnedFd: the descriptor handle with one owner. A dropped handle closes its fd (the
// next dup reuses the number), Child.takeStdout moves the pipe out of the Child, and
// processAlive probes a pid without signalling it.
from "std/process" import { Child, processAlive }
from "std/io" import { OwnedFd, Stdout, AsFd }
from "std/sysinfo" import { pid }

fn dupNumber(): i32 {
    let a = OwnedFd.dup(Stdout {})!
    // Reading the number is @unsafe: it is only meaningful while `a` lives, and the
    // point here is to see it reused once `a` has dropped.
    unsafe { return a.rawFd() }
}

fn main() {
    let first = dupNumber()
    print(first > 2 && dupNumber() == first)

    var args: Vec<string> = []
    args.push("hello")
    var c = Child.spawn("echo", args, false)!
    let out = c.takeStdout()
    unsafe { print(c.stdoutFd()) }
    print(out.isOpen())
    var acc = ""
    for chunk in out.channel() {
        acc.pushStr(chunk)
    }
    let _w = c.wait()
    print(acc.trim())

    print(processAlive(pid()))
    print(processAlive(-12345))
}
// @expect: true
// @expect: -1
// @expect: true
// @expect: hello
// @expect: true
// @expect: false
