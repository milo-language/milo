// @skip-os: win32
// Uses a /tmp path; Windows has no such directory.

// std/log — the file sink: records go to an append-opened path, and a sink that
// cannot be opened reports the reason instead of silently discarding records.

// @expect: opened
// @expect: file: WARN  to the file
// @expect: file: ERROR structured too k=v
// @expect: INFO  back on stdout
// @expect: unopenable sink reported

from "std/fs" import {
    readFile, removeFile
}
from "std/log" import {
    Log
}

pub fn main(): i32 {
    let path = "/tmp/milo-stdlog-fixture.log"
    let _ = removeFile(path)

    Log.setTimestamps(false)
    let opened = Log.setSinkPath(path)
    match opened {
        Result.Ok(_) => {
            print("opened")
        }
        Result.Err(e) => {
            print("open failed")
            return 1
        }
    }

    Log.warn("to the file")
    Log.str("k", "v").error("structured too")

    // Replacing the sink closes the descriptor this module opened.
    Log.setSinkStdout()
    let contents = readFile(path) ?? ""
    for line in contents.lines() {
        print("file: " + line)
    }
    Log.info("back on stdout")

    match Log.setSinkPath("/tmp/milo-stdlog-fixture-missing-dir/x.log") {
        Result.Ok(_) => {
            print("unexpectedly opened")
        }
        Result.Err(e) => {
            print("unopenable sink reported")
        }
    }
    let _ = removeFile(path)
    return 0
}
