// @skip-os: win32
// std/crypto has no Windows arm (it binds OpenSSL).

// @expect: accept: s3pPLMBiTxaQ9kYGzzhZRbK+xOo=
// @expect: is upgrade: true
// @expect: not upgrade: false
// @expect: key: dGhlIHNhbXBsZSBub25jZQ==
// @expect: opcode: Text 1
// @expect: pong from wire: true
// @expect: reserved opcode 3: rejected

from "std/ws" import {
    isWsUpgrade, extractWsKey, WsOpcode
}
from "std/wsframe" import {
    computeAcceptKey
}

pub fn main(): i32 {
    // RFC 6455 Section 4.2.2 example: known accept key for this test vector
    let testKey = "dGhlIHNhbXBsZSBub25jZQ=="
    let acceptKey = computeAcceptKey(testKey)
    print($"accept: {acceptKey}")

    let wsReq = "GET / HTTP/1.1\r\nHost: localhost\r\nUpgrade: websocket\r\nConnection: Upgrade\r\nSec-WebSocket-Key: dGhlIHNhbXBsZSBub25jZQ==\r\n\r\n"
    let httpReq = "GET / HTTP/1.1\r\nHost: localhost\r\n\r\n"

    print($"is upgrade: {isWsUpgrade(wsReq)}")
    print($"not upgrade: {isWsUpgrade(httpReq)}")
    print($"key: {extractWsKey(wsReq)}")

    // Opcodes are an integer-repr enum: the discriminant is the RFC 6455 wire nibble.
    print($"opcode: {WsOpcode.Text} {WsOpcode.Text as i32}")

    let Option.Some(fromWire) = WsOpcode.tryFrom(10) else {
        return 1
    }
    print($"pong from wire: {fromWire == WsOpcode.Pong}")

    // Reserved opcodes have no variant, so they can't be mistaken for a data frame.
    match WsOpcode.tryFrom(3) {
        Option.Some(_) => {
            return 2
        }
        Option.None => {
            print("reserved opcode 3: rejected")
        }
    }

    return 0
}
