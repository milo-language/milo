// Request.rawQuery keeps the query string as the client sent it, beside the decoded
// queryParams: a proxy or an access log needs the original bytes, which decoding
// loses (%22 and '"' decode alike).

from "std/http" import { Request, parseRequest }

fn parse(text: string): Request {
    var buf: [u8; 8192] = [0; 8192]
    for i in 0..text.len {
        buf[i] = text[i]
    }
    return parseRequest(buf, text.len)
}

pub fn main(): void {
    let a = parse("GET /laketahoe/hwy/us-50?cam=a%20b&input=%7B%22region%22%7D&x HTTP/1.1\r\nHost: h\r\n\r\n")
    // @expect: path=/laketahoe/hwy/us-50
    print("path=" + a.path)
    // @expect: raw=cam=a%20b&input=%7B%22region%22%7D&x
    print("raw=" + a.rawQuery)
    // @expect: cam=a b
    print("cam=" + a.queryParams[0].value)
    // @expect: input={"region"}
    print("input=" + a.queryParams[1].value)

    let b = parse("GET /plain HTTP/1.1\r\n\r\n")
    // @expect: none=[]
    print("none=[" + b.rawQuery + "]")

    // a second '?' belongs to the query
    let c = parse("GET /p?a=1?b HTTP/1.1\r\n\r\n")
    // @expect: second=a=1?b
    print("second=" + c.rawQuery)
}
