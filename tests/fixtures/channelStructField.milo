// @expect: hello from worker
// @expect: done

from "std/runtime" import {
    Promise
}
from "std/sync" import {
    Channel
}

pub struct Worker {
    ch: Channel<string>
}

pub fn main(): i32 {
    let ch = Channel<string>.new(8)!
    let chMain = ch.clone()
    let w = Worker {
        ch: ch
    }

    let t = Promise<i64>.blocking(move(): i64 => {
        w.ch.send("hello from worker")!
        return 0
    })

    let msg = chMain.recv()!
    print(msg)
    t.await()!
    print("done")
    return 0
}
