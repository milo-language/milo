// string substr is std/string.milo code: a fresh owned copy of bytes [start, end). Empty
// ranges and strings, multibyte UTF-8 (byte offsets; a cut inside a character copies its
// bytes), a literal, a shared (copy-on-write) string, a slice and a `&string` param as the
// receiver, temporaries, i32 bounds, and the copy outliving and staying apart from its
// source as both are mutated.
// @expect: [] [] []
// @expect: ell hello o
// @expect: é wö 1 195 13
// @expect: aZcdefg abcdef bcd cdef
// @expect: bcd!? bcd 5
// @expect: cd bcde f
// @expect: bc 42 ><8
// @expect: 01234 3

fn mid(s: &string, a: i64, b: i64): string {
    return s.substr(a, b)
}

fn mk(i: i64): string {
    return "<" + i.toString() + ">"
}

fn main() {
    let e = ""
    print("[", e.substr(0, 0), "] [", "abc".substr(3, 3), "] [", "abc".substr(0, 0), "]")
    print("hello".substr(1, 4), " ", "hello".substr(0, 5), " ", "hello".substr(4, 5))

    // é is the two bytes c3 a9: 0..1 is "h", 1..3 is "é", 1..2 is half of it.
    let u = "héllo wörld"
    let half = u.substr(1, 2)
    print(u.substr(1, 3), " ", u.substr(7, 10), " ", half.len, " ", half[0], " ", u.substr(0, u.len).len)

    var s = "abc" + "def"
    let t = s
    let a = s.substr(1, 4)
    s.push(103)
    s.setByte(1, 90)
    print(s, " ", t, " ", a, " ", t.substr(2, 6))

    var w = a.substr(0, 3)
    w.push(33)
    w.pushStr("?")
    print(w, " ", a, " ", w.len)

    let v = t.slice(1, 5)
    print(v.substr(1, 3), " ", mid(v, 0, 4), " ", mid(t, 5, 6))

    let lo: i32 = 1
    let hi: u8 = 3
    print(t.substr(lo, hi), " ", mk(42).substr(1, 3), " ", (mk(7) + mk(8)).substr(2, 5))

    var acc = ""
    for i in 0..5 {
        acc.pushStr(mk(i).substr(1, 2))
    }
    print(acc, " ", acc.substr(1, 4).len)
}
