// std/url decodeUriComponent answers None exactly where JavaScript's
// decodeURIComponent throws URIError, and decodes everything else byte for byte.

from "std/url" import { decodeUriComponent }

fn show(s: string): void {
    match decodeUriComponent(s) {
        Option.Some(v) => {
            print(s + " -> " + v)
        }
        Option.None => {
            print(s + " -> URIError")
        }
    }
}

pub fn main(): void {
    // @expect: %62igbear -> bigbear
    show("%62igbear")
    // @expect: a+b%20c -> a+b c
    show("a+b%20c")
    // @expect: caf%C3%A9 -> café
    show("caf%C3%A9")
    // @expect: %F0%9F%98%80 -> 😀
    show("%F0%9F%98%80")
    // @expect: raw é -> raw é
    show("raw é")
    // @expect: %zz -> URIError
    show("%zz")
    // @expect: %4 -> URIError
    show("%4")
    // @expect: % -> URIError
    show("%")
    // @expect: %E0 -> URIError
    show("%E0")
    // @expect: %80 -> URIError
    show("%80")
    // overlong '/' and a UTF-16 surrogate are not UTF-8
    // @expect: %C0%AF -> URIError
    show("%C0%AF")
    // @expect: %ED%A0%80 -> URIError
    show("%ED%A0%80")
    // @expect: %F4%90%80%80 -> URIError
    show("%F4%90%80%80")
    // a lead byte whose continuation arrives raw is still malformed
    // @expect: %C3x -> URIError
    show("%C3x")
}
