// @expect: 2
// @expect: 1

// Distinct indices into one container are a legitimate two-element `&mut` borrow —
// the runtime alias guard must NOT trip here (i != j), so the swap goes through.

fn swap2(a: &mut i64, b: &mut i64): void {
    let t = a
    a = b
    b = t
}

pub fn main(): i32 {
    var v = [1, 2, 3]
    let i = 0
    let j = 1
    swap2(&mut v[i], &mut v[j])
    print(v[0])
    print(v[1])
    return 0
}
