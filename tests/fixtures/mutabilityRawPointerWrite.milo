// A var written only through a raw pointer is still written: `.ptr()` and `arr as *T`
// hand out its storage, so var-never-reassigned must not ask for `let` here.
// @expect: 99
// @expect: 7
pub fn main(): i32 {
    var a: [i64; 4] = [1, 2, 3, 4]
    var v: Vec<i64> = [5, 6, 7]
    unsafe {
        let p = a as *i64
        p[2] = 99
        let q = v.ptr()
        q[0] = 7
    }
    print(a[2])
    print(v[0])
    return 0
}
