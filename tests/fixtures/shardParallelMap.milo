// @expect: n=16 first=3 last=3
// @expect: uneven n=10 sum=20
// @expect: one worker n=4 sum=8
// parallelMap is the whole divide/run/reassemble cycle in one call, and it is
// infallible: this function creates every window, hands out every window, awaits all
// of them and welds them itself, so no caller code can drop one or let the owner die
// first. The completeness check inside the weld is an internal assertion, not an error
// a caller can see.
from "std/shard" import {
    Shard, parallelMap
}

fn double(w: Shard<i64>): Shard<i64> {
    var s = w
    var i: i64 = 0
    while i < s.len() {
        s.set(i, s.get(i) * 2)
        i = i + 1
    }
    return s
}

fn addOne(w: Shard<f64>): Shard<f64> {
    var s = w
    var i: i64 = 0
    while i < s.len() {
        s.set(i, s.get(i) + 1.0)
        i = i + 1
    }
    return s
}

pub fn main(): i32 {
    var v: Vec<f64> = Vec.withCapacity(16)
    var i: i64 = 0
    while i < 16 {
        v.push(2.0)
        i = i + 1
    }
    let out = parallelMap(v, 4, addOne)
    print("n=" + out.len.toString() + " first=" + out[0].toString() + " last=" + out[out.len - 1].toString())

    // 10 elements over 4 workers: the last window carries the remainder, and every
    // element is still visited exactly once.
    var u: Vec<i64> = Vec.withCapacity(10)
    var k: i64 = 0
    while k < 10 {
        u.push(1)
        k = k + 1
    }
    let out2 = parallelMap(u, 4, double)
    var sum: i64 = 0
    for x in out2 {
        sum = sum + x
    }
    print("uneven n=" + out2.len.toString() + " sum=" + sum.toString())

    // One worker is the degenerate case and must still round-trip.
    var w: Vec<i64> = Vec.withCapacity(4)
    var m: i64 = 0
    while m < 4 {
        w.push(1)
        m = m + 1
    }
    let out3 = parallelMap(w, 1, double)
    var sum3: i64 = 0
    for x in out3 {
        sum3 = sum3 + x
    }
    print("one worker n=" + out3.len.toString() + " sum=" + sum3.toString())
    return 0
}
