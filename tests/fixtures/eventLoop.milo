// @skip-os: win32
// the green scheduler's event loop is kqueue/epoll readiness-based; Windows
// needs the IOCP completion port rewrite (docs/roadmap.md).

// @expect: ready
// @expect: 2
// @expect: done

from "std/platform" import {
    pipe,
    write,
    read,
    close
}
from "std/event" import {
    EventLoop, eventLoopClose, setNonblocking, eventRegisterRead, eventPoll
}

pub fn main(): i32 {
    let fds: [u8; 8] = [0; 8]
    unsafe {
        pipe(fds as *i32)
        let readFd = (fds as *i32) [0]
        let writeFd = (fds as *i32) [1]

        let el = EventLoop.new()!
        setNonblocking(readFd)
        eventRegisterRead(el, readFd)

        let msg = "hi"
        write(writeFd, msg, msg.len)

        let readyBuf: [u8; 16] = [0; 16]
        let n = eventPoll(el, readyBuf as *i32, 4, 1000)
        if n > 0 {
            print("ready")
            let buf: [u8; 64] = [0; 64]
            let bytesRead = read(readFd, buf as *u8, 64)
            print(bytesRead.toString())
        }

        eventLoopClose(el)
        close(readFd)
        close(writeFd)
    }
    print("done")
    return 0
}
