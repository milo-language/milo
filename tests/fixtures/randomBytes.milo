// Random.bytes(n) is the safe way to get key material: n bytes from the OS CSPRNG as a
// byte string, the representation std's crypto APIs take. A buffer that came back
// zeroed or repeated (the failure an ignored getentropy error produced) shows up as
// two equal draws or missing byte values over 64 KiB.
from "std/random" import { Random }
from "std/hex" import { Hex }

// @expect: 0 1 32 1000
// @expect: distinct: true
// @expect: every byte value seen: true
// @expect: fillRaw: 16

fn main(): i32 {
    print($"{Random.bytes(0).len} {Random.bytes(1).len} {Random.bytes(32).len} {Random.bytes(1000).len}")
    print($"distinct: {Random.bytes(32) != Random.bytes(32)}")
    let big = Random.bytes(65536)
    var seen: [bool; 256] = [false; 256]
    for b in big {
        seen[b as i64] = true
    }
    var all = true
    for s in seen {
        all = all && s
    }
    print($"every byte value seen: {all}")
    var key: [u8; 16] = [0; 16]
    unsafe { Random.fillRaw(key as *u8, 16) }
    var raw = ""
    for b in key {
        raw.push(b)
    }
    print($"fillRaw: {Hex.decode(Hex.encode(raw))!.len}")
    return 0
}
