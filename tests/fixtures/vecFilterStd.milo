// Vec.filter is std/vec.milo code: copies of the kept elements (the structural copy clone
// makes), in order, in a Vec with the source's length as capacity. Covers an empty Vec,
// keep-all and keep-none, a by-value predicate on a Copy element, a named fn, strings (the
// copies are independent of the source), nested Vecs, a struct element, a slice and a
// fixed array as the receiver, a temporary receiver, a chained filter then map, and a
// predicate that captures.
// @expect: 0
// @expect: [1, 2, 3, 4, 5] []
// @expect: [1, 3, 5] 5
// @expect: ["a", "bbc", "dd"] ["zz", "dd"]
// @expect: [[1], [2, 3]]
// @expect: 1 y
// @expect: [3, 4, 5] [7, 9]
// @expect: [1, 3, 5]
// @expect: [10, 20]

struct P {
    name: string,
    age: i64,
}

fn isOdd(x: i64): bool {
    return x % 2 == 1
}

fn mk(n: i64): Vec<i64> {
    var v: Vec<i64> = Vec.new()
    for i in 0..n {
        v.push(i)
    }
    return v
}

fn big(s: &[i64]): Vec<i64> {
    return s.filter((x: &i64) => x > 2)
}

fn main() {
    let e: Vec<i64> = Vec.new()
    print(e.filter((x: &i64) => true).len())
    let v: Vec<i64> = [1, 2, 3, 4, 5]
    print(v.filter((x: i64) => x > 0), " ", v.filter((x: &i64) => false))
    let odd = v.filter(isOdd)
    print(odd, " ", odd.capacity())
    var s: Vec<string> = ["a", "bb" + "c", "dd"]
    var long = s.filter((w: &string) => w.len() > 1)
    long[0] = "zz"
    print(s, " ", long)
    let nested: Vec<Vec<i64>> = [[1], [], [2, 3]]
    print(nested.filter((w: &Vec<i64>) => w.len() > 0))
    let ps: Vec<P> = [P { name: "x", age: 3 }, P { name: "y", age: 30 }]
    let adults = ps.filter((p: &P) => p.age >= 18)
    print(adults.len(), " ", adults[0].name)
    print(big(v[1..5]), " ", [7, 1, 9].filter((x: &i64) => x > 5))
    print(mk(6).filter(isOdd))
    let limit = 3
    let both = v.filter((x: &i64) => x < limit).map((x: &i64) => x * 10)
    print(both)
}
