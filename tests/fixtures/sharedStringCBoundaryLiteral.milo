// A literal held in a string has no heap buffer (cap 0): handing it to C copies it into a
// NUL-terminated block, so the literal and every handle made from it stay intact.
// memset, not bzero (the Windows CRT has no bzero), declared void so the call stays a
// safe one: its pointer result is not needed.
extern fn memset(p: *u8, c: i32, n: i64)

fn main() {
    let a = "hello world"
    let b = a.clone()
    memset(a, 0, 5)
    print(a)
    print(b)
}

// @expect: hello world
// @expect: hello world
