from "std/arena" import {
    Arena, Handle, arenaAlloc, arenaFree, arenaGet, arenaHandles, arenaLen,
    arenaNew, arenaValid, arenaWith
}

fn sumHandles(arena: &Arena<i64>, handles: &Vec<Handle<i64>>): i64 {
    var sum: i64 = 0
    for handle in handles {
        match arenaGet(arena, handle) {
            Option.Some(value) => {
                sum = sum + value
            }
            Option.None => {
            }
        }
    }
    return sum
}

pub fn main(): i32 {
    var arena = Arena<i64>.new()
    print(arenaHandles(arena).len)

    let first = arenaAlloc(&mut arena, 10)
    let stale = arenaAlloc(&mut arena, 20)
    let third = arenaAlloc(&mut arena, 30)
    let _ = arenaFree(&mut arena, stale)

    let snapshot = arenaHandles(arena)
    print(snapshot.len)
    print(sumHandles(arena, snapshot))
    print(arena.valid(stale))

    let replacement = arenaAlloc(&mut arena, 40)
    print(snapshot.len)
    print(sumHandles(arena, snapshot))

    let current = arena.handles()
    print(current.len)
    print(sumHandles(arena, current))

    // A snapshot is stable, but its handles are not roots: freeing a returned
    // handle makes that entry stale, and later allocations never join it.
    let _ = arenaFree(&mut arena, first)
    print(current.len)
    match arenaGet(arena, first) {
        Option.Some(_value) => {
            print(-1)
        }
        Option.None => {
            print(0)
        }
    }
    print(sumHandles(arena, current))
    let later = arenaAlloc(&mut arena, 50)
    print(current.len)
    print(sumHandles(arena, current))

    // The stale handle remains rejected even after its slot is reused.
    match arenaGet(arena, stale) {
        Option.Some(_value) => {
            print(-1)
        }
        Option.None => {
            print(0)
        }
    }

    for handle in current {
        let _ = arenaFree(&mut arena, handle)
    }
    let _ = arenaFree(&mut arena, later)
    print(arena.len())

    // Force the otherwise impractical generation-exhaustion boundary. Public
    // struct fields make this a fixture-only way to verify retirement behavior.
    var retirement = Arena<i64>.new()
    let initial = arenaAlloc(&mut retirement, 1)
    retirement.gens[initial.index as i64] = 2147483647
    let exhausted: Handle<i64> = Handle {
        arenaId: retirement.id,
        index: initial.index,
        generation: 2147483647,
    }
    print(arenaFree(&mut retirement, exhausted))
    match arenaGet(retirement, exhausted) {
        Option.Some(_value) => {
            print(-1)
        }
        Option.None => {
            print(0)
        }
    }
    print(retirement.handles().len)
    let fresh = arenaAlloc(&mut retirement, 2)
    print(fresh.index != exhausted.index)
    print(retirement.len())
    let _ = arenaFree(&mut retirement, fresh)
    print(retirement.len())

    // A forged handle carrying the free slot's internal negative generation is
    // still rejected by every accessor, and none of its callbacks may execute.
    var freed = Arena<i64>.new()
    let onceLive = freed.alloc(7)
    let _ = freed.free(onceLive)
    let forged: Handle<i64> = Handle {
        arenaId: freed.id,
        index: onceLive.index,
        generation: freed.gens[onceLive.index as i64],
    }
    print(freed.valid(forged))
    match freed.get(forged) {
        Option.Some(_value) => {
            print(-1)
        }
        Option.None => {
            print(0)
        }
    }
    print(freed.set(forged, 8))
    print(freed.modify(forged, (value: i64): i64 => {
        print(-1)
        return value
    }))
    match arenaWith(freed, forged, (value: &i64): i64 => {
        print(-1)
        let _ = value
        return 0
    }) {
        Option.Some(_value) => {
            print(-1)
        }
        Option.None => {
            print(0)
        }
    }
    print(freed.modifyMut(forged, (value: &mut i64): void => {
        print(-1)
        let _ = value
    }))
    print(freed.free(forged))

    // Keep names live so the fixture also validates every returned handle type.
    let _ = first == third || replacement == first
    return 0
}
