// @skip-os: win32
// the green scheduler's event loop is kqueue/epoll readiness-based; Windows
// needs the IOCP completion port rewrite (docs/roadmap.md).

// @expect: woke 300 sum 44850

// 300 tasks park reading pipes whose fds climb well past the fd waiter table's first
// capacity, so it grows (and moves) while earlier waiters are already chained in it.
// Waking them in reverse fd order then finds every one of them.
from "std/runtime" import {
    Task, schedulerRunToCompletion
}
from "std/os" import {
    readFd,
    writeFd
}
from "std/platform" import {
    pipe,
    close
}
from "std/sync" import {
    Channel
}

pub fn main(): i32 {
    let count: i64 = 300
    let done = Channel<i64>.new(count)!
    var writers: Vec<i32> = Vec.new()
    for i in 0..count {
        var fds: [i32; 2] = [-1; 2]
        unsafe {
            pipe(fds as *i32)
        }
        let r = fds[0]
        writers.push(fds[1])
        let tx = done.clone()
        Task.spawn(move(): void => {
            var buf: [u8; 1] = [0; 1]
            unsafe {
                readFd(r, buf, 1)
                close(r)
            }
            tx.send(i)!
        })
    }

    // Spawned last, so every reader has parked first.
    Task.spawn(move(): void => {
        var k = writers.len()
        while k > 0 {
            k -= 1
            unsafe {
                writeFd(writers[k], "w", 1)
                close(writers[k])
            }
        }
        var sum: i64 = 0
        for _ in 0..count {
            sum += done.recv()!
        }
        print("woke ", count, " sum ", sum)
    })

    schedulerRunToCompletion()
    return 0
}
