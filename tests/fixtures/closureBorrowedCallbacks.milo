// @expect: 1320
// @expect: 11
// @expect: 5
// @expect: 8
// @expect: 10
// @expect: 3 3
// Callbacks that borrow: a sort comparator reading a borrowed key table, closures over a
// `&string` and a `&[T]` parameter, one nested in another, a local written through a
// by-reference capture, and a read-only capture that leaves the local usable after the
// call (it was moved into the closure before, so the last line was "use of moved
// variable 'v'"). Every capture here is a reference or must stay one.
fn get(f: () => i64): i64 {
    return f()
}

fn repeat(k: i64, f: () => void) {
    var i: i64 = 0
    while i < k {
        f()
        i = i + 1
    }
}

fn order(keys: &Vec<i64>): Vec<i64> {
    var idx: Vec<i64> = [0, 1, 2, 3]
    idx.sortBy((a: i64, b: i64): i32 => if keys[a] < keys[b] {
        -1
    } else if keys[a] > keys[b] {
        1
    } else {
        0
    })
    return idx
}

fn strLen(s: &string): i64 {
    return get((): i64 => s.len)
}

fn sliceSum(xs: &[i64]): i64 {
    return get((): i64 => {
        var t: i64 = 0
        for x in xs {
            t = t + x
        }
        return t
    })
}

struct P {
    n: i64,
}

fn nested(p: &P): i64 {
    return get((): i64 => get((): i64 => p.n * 2))
}

pub fn main(): i32 {
    let keys: Vec<i64> = [40, 10, 30, 20]
    let o = order(keys)
    print(o[0].toString() + o[1].toString() + o[2].toString() + o[3].toString())
    let s = "hello world".clone()
    print(strLen(s).toString())
    let v: Vec<i64> = [1, 2, 3, 4]
    print(sliceSum(v[1..3]).toString())
    print(nested(P { n: 4 }).toString())
    var count: i64 = 0
    repeat(5, (): void => {
        count = count + 2
    })
    print(count.toString())
    let w: Vec<i64> = [1, 2, 3]
    let n = get((): i64 => w.len)
    print(n.toString() + " " + w.len.toString())
    return 0
}
