// @expect: captured 42
// @expect: done

// Every capturing spawn leaks its closure environment, and this fixture is NOT on
// tests/leak-clean.txt for that reason. It was, briefly: `reapTask` was made to free the
// env, which looked like ownership and was not — `fn` is a Copy type, so `Task.spawn(f)`
// gives the task a COPY of `{ptr fn, ptr env}` and the caller keeps an equally valid one.
// Freeing on the task's side turned a leak into a use-after-free (see
// spawnClosureStillValid.milo, which pins the safe behaviour). Fixing it for real means
// making an owning closure non-Copy so spawn MOVES it — docs/backlog.md #20 — and until
// then this program is a correctness test, not a leak test.
from "std/runtime" import {
    Task
}

pub fn main(): i32 {
    let n = 42
    let t = Task.spawn(move(): void => {
        print("captured ", n.toString())
    })
    t.join()
    print("done")
    return 0
}
