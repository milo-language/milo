// @expect: zero-size rejected
// @expect: true
// @expect: zero-count rejected
// @expect: valid pool alloc ok

// The free list used to thread an 8-byte pointer through each block, so a block SMALLER
// than 8 wrote past the allocation: `requires size >= 8` said so, a `requires` is dropped
// at the default -O2, and ASan reported a heap-buffer-overflow WRITE for `Pool.new(2, 64)`.
// The free list now lives in a side table, so a 2-byte block is legal; a zero size and a
// zero count must still be refused at runtime. Sizes are derived at runtime here so the
// prover cannot reject them statically, which is what makes this a test of the RELEASE
// build rather than of the contract.
from "std/pool" import {
    Pool
}

fn runtimeVal(n: i64): i64 {
    return n
}

pub fn main(): i32 {
    match Pool.new(runtimeVal(0), 64) {
        Result.Ok(p) => {
            print("BAD: accepted a 0-byte block")
        }
        Result.Err(e) => {
            print("zero-size rejected")
        }
    }
    match Pool.new(runtimeVal(2), 64) {
        Result.Ok(p) => {
            var small = p
            let b = small.alloc()!
            print(small.write(b, (bytes: &mut [u8]) => {
                bytes[1] = 3
            }))
        }
        Result.Err(e) => {
            print("BAD: rejected a 2-byte block")
        }
    }
    match Pool.new(16, runtimeVal(0)) {
        Result.Ok(p) => {
            print("BAD: accepted a zero count")
        }
        Result.Err(e) => {
            print("zero-count rejected")
        }
    }
    match Pool.new(16, 8) {
        Result.Ok(p) => {
            var pool = p
            match pool.alloc() {
                Result.Ok(block) => {
                    print("valid pool alloc ok")
                }
                Result.Err(e) => {
                    print("BAD: valid pool failed to allocate")
                }
            }
        }
        Result.Err(e) => {
            print("BAD: valid pool rejected")
        }
    }
    return 0
}
