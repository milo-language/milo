// A string handed to C as `*u8` is made the only handle to its buffer first: C may write
// through the pointer, and a shared buffer would carry that write into every other handle.
// memset, not bzero (the Windows CRT has no bzero), declared void so the call stays a
// safe one: its pointer result is not needed.
extern fn memset(p: *u8, c: i32, n: i64)

struct Row { name: string }

fn main() {
    var a = ""
    a.pushStr("hello world")
    let b = a.clone()
    memset(a, 0, 5)
    print(a.len)
    print(a.substr(5, 11))
    print(b)

    // A field of an owned struct is a place too.
    var r = Row { name: "" }
    r.name.pushStr("field text")
    let c = r.name.clone()
    memset(r.name, 0, 5)
    print(r.name.substr(5, 10))
    print(c)

    // A temporary that shares the buffer: the copy C writes is the temporary's own.
    let d = b.clone()
    memset(d.clone(), 0, 5)
    print(d)
    print(b)
}

// @expect: 11
// @expect:  world
// @expect: hello world
// @expect: text
// @expect: field text
// @expect: hello world
// @expect: hello world
