// @expect: parking
// @expect: unparking
// @expect: resumed

from "std/runtime" import {
    Task, schedulerCurrent, schedulerPark, schedulerUnpark, schedulerYield, schedulerRunToCompletion
}
from "std/sync" import {
    AtomicI64
}

pub fn main(): i32 {
    let slot = AtomicI64.new(0)

    let s1 = slot.clone()
    Task.spawn(move(): void => {
        s1.store(schedulerCurrent() as i64)
        print("parking")
        schedulerPark()
        print("resumed")
    })

    let s2 = slot.clone()
    Task.spawn(move(): void => {
        while s2.load() == 0 {
            schedulerYield()
        }
        print("unparking")
        unsafe {
            schedulerUnpark(s2.load() as *u8)
        }
    })

    schedulerRunToCompletion()
    return 0
}
