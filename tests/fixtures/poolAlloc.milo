// @expect: 0
// @expect: 1
// @expect: 2
// @expect: 3
// @expect: true
// @expect: 2
// @expect: true
// @expect: 1
// @expect: true
// @expect: true

from "std/pool" import {
    Pool
}

pub fn main(): i32 {
    var pool = Pool.new(16, 3)!

    print(pool.live())
    let a = pool.alloc()!
    print(pool.live())
    let b = pool.alloc()!
    print(pool.live())
    let _c = pool.alloc()!
    print(pool.live())

    print(pool.free(b))
    print(pool.live())
    print(pool.free(a))
    print(pool.live())

    print(pool.full() == false)

    pool.reset()
    print(pool.empty())

    return 0
}
