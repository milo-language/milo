// An Option whose payload is itself a multi-slot enum must reserve room for the
// WHOLE payload enum — its tag word included — not just that enum's payload blob.
//
// Enums lower to `{ i32 tag, payload union }`. Getting the union one word short does not
// fail to compile and does not fail any test that only reads the Option back: the
// store simply runs 8 bytes past the end of the alloca and lands on whatever local
// the stack allocator put next. In the self-hosted compiler that neighbour was a
// loop counter, so `for j in 0..info.fields.len` resumed with a garbage j and
// tripped a bounds check thousands of iterations into an unrelated function.
//
// The assertions below are deliberately about a NEIGHBOURING local surviving, not
// about the Option's own value — an 8-byte overrun leaves the Option itself
// perfectly readable, which is why this class of bug hides.

// The payload types that matter are the GENERIC INSTANCES (Option<i64>). They are
// registered under a mangled name (Option_i64), so a sizing pass that measures the
// unmangled spelling finds no such enum and falls back to a bare word — 8 bytes for
// something that is really 16. Plain scalar payloads never expose this.
enum Wide {
    Big(i32, bool, Option<i64>, Option<i64>),
    Small(i64),
}

fn main() {
    // `guard` and `count` are ordinary locals. If Option<Wide> is sized one slot
    // short, storing into it writes past its own storage and corrupts one of them.
    var count: i64 = 0
    var guard: i64 = 777

    var slot: Option<Wide> = Option.None
    for i in 0..4 {
        slot = Option.Some(Wide.Big(32, true, Option.Some(i), Option.Some(i + 1)))
        count = count + 1
    }

    print(count == 4)
    // @expect: true
    print(guard == 777)
    // @expect: true

    match slot {
        Option.Some(w) => {
            match w {
                Wide.Big(bits, signed, lo, hi) => {
                    print(bits == 32 && signed)
                    // @expect: true
                    print(lo! == 3 && hi! == 4)
                    // @expect: true
                }
                Wide.Small(x) => {
                    print(false)
                }
            }
        }
        Option.None => {
            print(false)
        }
    }
    print(guard == 777)
    // @expect: true
}
