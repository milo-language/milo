// `[v; N]` of a non-Copy owned temporary clones it N-1 times and moves the original into
// the last slot. It used to clone N times and never drop the original, so one value per
// evaluation leaked (1000 leaks for a loop of 1000 under `leaks -atExit`) and its Drop
// never ran. A place (`[t; 2]`) is consumed the same way: one clone, and `t` moves in.
// The copies go through Clone (Tok's derived one calls Tag's), so every Drop below
// belongs to exactly one construction.
//
// The leak itself is caught by the ownership ledger (scripts/own-ledger.ts).
struct Tag {
    name: string,
}

impl Drop for Tag {
    fn drop(self: &mut Self): void {
        print("drop " + self.name)
    }
}

impl Clone for Tag {
    fn clone(self: &Self): Self {
        print("clone " + self.name)
        return Tag { name: self.name + "'" }
    }
}

@derive(Clone)
struct Tok {
    tag: Tag,
}

fn mk(name: string): Tok {
    return Tok { tag: Tag { name: name } }
}

fn temp() {
    let a = [mk("a"); 3]
    print(a[2].tag.name)
}

fn place() {
    let t = mk("t")
    let b = [t; 2]
    print(b[1].tag.name)
}

fn main() {
    temp()
    print("--")
    place()
    print("end")
}
// @expect: clone a
// @expect: clone a
// @expect: a
// @expect: drop a'
// @expect: drop a'
// @expect: drop a
// @expect: --
// @expect: clone t
// @expect: t
// @expect: drop t'
// @expect: drop t
// @expect: end
