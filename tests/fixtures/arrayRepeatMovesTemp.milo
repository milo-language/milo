// `[v; N]` of a non-Copy owned temporary clones it N-1 times and moves the original into
// the last slot. It used to clone N times and never drop the original, so one value per
// evaluation leaked (1000 leaks for a loop of 1000 under `leaks -atExit`) and its Drop
// never ran. A place (`[t; 2]`) is only read: every slot is a clone and `t` keeps its own.
//
// No Drop count can tell a moved original from a clone, so the leak itself is caught by
// the ownership ledger (scripts/own-ledger.ts); this pins the drops to one per slot.
struct Tag {
    name: string,
}

impl Drop for Tag {
    fn drop(self: &mut Self): void {
        print("drop " + self.name)
    }
}

struct Tok {
    tag: Tag,
}

fn mk(name: string): Tok {
    return Tok { tag: Tag { name: name } }
}

fn temp() {
    let a = [mk("a"); 3]
    print(a[2].tag.name)
}

fn place() {
    let t = mk("t")
    let b = [t; 2]
    print(b[1].tag.name)
}

fn main() {
    temp()
    print("--")
    place()
    print("end")
}
// @expect: a
// @expect: drop a
// @expect: drop a
// @expect: drop a
// @expect: --
// @expect: t
// @expect: drop t
// @expect: drop t
// @expect: drop t
// @expect: end
