// @expect: reader sees 1
// @expect: writer done
// @expect: reader sees 2
// @expect: reader sees 3
// H3 from docs/plans/soundness-sweep-2026-09.md. The for-in over a mutable global
// freezes it against writes from functions the body calls, but not from another task:
// the body yields, `writer` pushes 100000 elements, the buffer reallocates, and the
// loop reads the freed one (`1, 4, 0` at HEAD). The @expect lines are what an index
// loop over a snapshot prints. The real fix (WP1, `@parks` plus the cross-task freeze
// rule) rejects this program at compile time and this file then moves to
// tests/errors/. Until then it sits in tests/known-red.txt: the fixture lane skips it,
// the ASan sweep still runs it.
from "std/runtime" import {
    Task, schedulerYield, schedulerRunToCompletion
}
var g: Vec<i64> = []

fn reader(): void {
    for x in g {
        print("reader sees " + x.toString())
        schedulerYield()
    }
}

fn writer(): void {
    var i: i64 = 0
    while i < 100000 {
        g.push(777)
        i = i + 1
    }
    // stomp: allocate and fill so the freed buffer is reused
    var _junk: Vec<i64> = Vec.filled(4, 424242)
    print("writer done")
}

pub fn main(): i32 {
    g.push(1)
    g.push(2)
    g.push(3)
    Task.spawn(move() => {
        reader()
    }
    )
    Task.spawn(move() => {
        writer()
    }
    )
    schedulerRunToCompletion()
    return 0
}
