// @expect: r1 b conn
// @expect: r2 b
// @expect: r1 c conn
// @expect: r2 c
// @expect: readers joined
// @expect: total 10
// @expect: log 3 m0 m2
// @expect: move owned
// @expect: late hi
// @expect: early joined
// @expect: took given
// @expect: nested outer+inner
// @expect: nested joined
