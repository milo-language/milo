// Fixture for tests/header.test.ts — exercises the C header generator: opaque types,
// nested extern structs (dep order), scalar/pointer/fn-ptr params, and the skip paths
// (by-value struct return, non-C-representable return).
pub extern type Handle

pub extern struct Point {
    x: i32,
    y: i32,
}

pub extern struct Rect {
    origin: Point,
    w: i32,
    h: i32,
}

pub fn add(a: i32, b: i32): i32 {
    return privateBump(a) + b - 1
}

// Not `pub`: must stay out of the generated header. The header is the library's published
// API, and `userFnNames` (what the header used to be built from) is every fn in the entry
// file regardless of visibility.
fn privateBump(x: i32): i32 {
    return x + 1
}

pub fn scale(v: f64, k: f64): f64 {
    return v * k
}

pub fn rect_area(r: *Rect): i64 {
    unsafe {
        return (r.w as i64) * (r.h as i64)
    }
}

pub fn apply(cb: (i32) => i32, v: i32): i32 {
    return cb(v)
}

// A nullable extern reference. The C spelling is `Point*` and nothing else — one
// parameter, no tag, no wrapper struct — so the header must declare it exactly as it
// declares `rect_area`'s raw pointer, and a C caller may pass NULL. What the caller gets
// for NULL is chosen HERE, in the else block, because only this author knows what this
// API's error convention is.
@externalLinkage
pub fn point_bump(p: ?&mut Point): i32 {
    let q = p else {
        return -1
    }
    q.x = q.x + 1
    return q.x
}

// A C function-pointer field: one thin code pointer, spelled `int32_t (*read)(uint8_t*,
// int32_t)` in the generated header. The C consumer builds one of these from its OWN
// declaration of the struct and a C function, so Milo's layout claim is checked against
// a real C compiler rather than against another copy of Milo.
// `type` is a Milo keyword, so the Milo side names the field `kind`; C sees `type`.
pub extern struct Tagged {
    @cName("type") kind: i32,
    value: i32,
}

pub fn tagged_kind(t: *Tagged): i32 {
    unsafe {
        return (*t).kind
    }
}

pub extern struct Ops {
    read: (*u8, i32) => i32,
}

// The callback direction: C fills the table, calls in here, and this calls back out
// through the field. A null slot is a real case in every C ops table, which is why
// isNull exists.
@externalLinkage
pub fn ops_apply(ops: *Ops, v: i32): i32 {
    unsafe {
        if isNull(ops.read) {
            return -1
        }
        return ops.read(0 as *u8, v)
    }
}

// returns a struct by value → skipped until define-side ABI lowering (stage 6)
pub fn make_point(x: i32, y: i32): Point {
    return Point {
        x: x, y: y
    }
}

// non-C-representable return → skipped with a comment
pub fn build(n: i32): Vec<i32> {
    var out: Vec<i32> = Vec.new()
    out.push(n)
    return out
}

pub fn main(): i32 {
    return 0
}
