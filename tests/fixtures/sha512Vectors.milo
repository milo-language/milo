// @expect: 9d0e1809716474cb086e834e310a4a1ced149e9c00f248527972cec5704c2a5b07b8b3dc38ecc4ebae97ddd87f3d8985
from "std/sha512" import {
    Sha512,
    Sha384
}

// Published SHA-512 / SHA-384 vectors: the empty string, FIPS 180-4's one- and
// two-block examples (also RFC 6234 §8.5), and the million-'a' vector. These are
// the values every conforming implementation prints; a round-trip test would not
// catch a wrong round constant or a mis-ordered rotation, and these do.
pub fn main(): i32 {
    print(Sha512.hash(""))
    print(Sha512.hash("abc"))
    print(Sha512.hash("abcdefghbcdefghicdefghijdefghijkefghijklfghijklmghijklmnhijklmnoijklmnopjklmnopqklmnopqrlmnopqrsmnopqrstnopqrstu"))
    print(Sha384.hash(""))
    print(Sha384.hash("abc"))
    print(Sha384.hash("abcdefghbcdefghicdefghijdefghijkefghijklfghijklmghijklmnhijklmnoijklmnopjklmnopqklmnopqrlmnopqrsmnopqrstnopqrstu"))
    var m = ""
    for _i in 0..1000000 {
        m.push(97)
    }
    print(Sha512.hash(m))
    print(Sha384.hash(m))
    return 0
}
