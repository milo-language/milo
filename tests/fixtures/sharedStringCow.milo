// @expect: abcabc
// @expect: abcabc-plus
// @expect: abcabc
// @expect: abcabc-concat
// @expect: abcabc
// @expect: abcabc42
// @expect: abcabc
// @expect: ab
// @expect: abcabc
// @expect: 0
// @expect: abcabc
// @expect: Zbcabc
// @expect: abcabc
// @expect: abcabc<abcabc|abcabc>
// @expect: abcabc
// @expect: abcabcabcabc
// @expect: abcabc
