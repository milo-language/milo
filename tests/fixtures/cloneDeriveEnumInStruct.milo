// Structs and enums share one derive fixpoint, so a struct holding an enum and an enum
// holding a struct both end up clonable. The two do not hold each other: an enum whose
// payload reached its container by value would have infinite size and is rejected
// (tests/errors/enumRecursiveThroughStruct.milo).
struct A {
    name: string,
    e: E,
}

struct B {
    name: string,
}

enum E {
    X(B),
    Y,
    Z(string),
}

fn describe(a: &A): string {
    match a.e {
        E.X(inner) => {
            return $"{a.name}>{inner.name}"
        }
        E.Y => {
            return $"{a.name}>Y"
        }
        E.Z(s) => {
            return $"{a.name}>Z({s})"
        }
    }
}

fn main() {
    let root = A {
        name: "root", e: E.X(B {
            name: "leaf"
        }
        )
    }
    let copy = root.clone()
    print(describe(root))
    print(describe(copy))
    let e = E.X(B {
        name: "solo"
    }
    )
    let e2 = e.clone()
    match e2 {
        E.X(b) => {
            print(b.name)
        }
        E.Y => {
            print("Y")
        }
        E.Z(s) => {
            print(s)
        }
    }
    let a2 = A {
        name: "z", e: E.Z("zed")
    }
    print(describe(a2.clone()))
}
// @expect: root>leaf
// @expect: root>leaf
// @expect: solo
// @expect: z>Z(zed)
