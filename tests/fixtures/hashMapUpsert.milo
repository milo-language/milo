// @expect: the=3 cat=2 sat=1 absent=0
// @expect: inserted true then false
// @expect: groups a=[1, 3] b=[2]
// @expect: setdefault 5 5 7 len 2
// @expect: res made 2 gone 1
// HashMap.upsert and getOrInsert (std/prelude): counting with a moved key, a Vec value
// grown in place, setdefault semantics, and an `init` that is dropped when unused.
var made: i64 = 0
var gone: i64 = 0

struct Res {
    id: i64,
}

impl Drop for Res {
    fn drop(self: &mut Self): void {
        gone += 1
    }
}

fn mk(id: i64): Res {
    made += 1
    return Res { id: id }
}

fn words(): void {
    var counts: HashMap<string, i64> = HashMap.new()
    for w in "the cat sat the cat the".split(" ") {
        counts.upsert(w, 0, (c: &mut i64): void => {
            c += 1
        })
    }
    print($"the={counts.getOrDefault("the", 0)} cat={counts.getOrDefault("cat", 0)} sat={counts.getOrDefault("sat", 0)} absent={counts.getOrDefault("dog", 0)}")
    let first = counts.upsert("new", 0, (c: &mut i64): void => {
        c += 1
    })
    let second = counts.upsert("new", 0, (c: &mut i64): void => {
        c += 1
    })
    print($"inserted {first} then {second}")
}

fn main(): i32 {
    words()
    var groups: HashMap<string, Vec<i64>> = HashMap.new()
    let pairs: Vec<string> = ["a", "b", "a"]
    for i in 0..pairs.len {
        let n = i + 1
        groups.upsert(pairs[i], [], (v: &mut Vec<i64>): void => {
            v.push(n)
        })
    }
    print($"groups a={groups.get("a")!} b={groups.get("b")!}")

    var d: HashMap<string, i64> = HashMap.new()
    let x = d.getOrInsert("k", 5)
    let y = d.getOrInsert("k", 6)
    let z = d.getOrInsert("j", 7)
    print($"setdefault {x} {y} {z} len {d.len}")

    var rs: HashMap<i64, Res> = HashMap.new()
    rs.upsert(1, mk(1), (r: &mut Res): void => {
        r.id += 10
    })
    // The key is present, so this init is dropped unused.
    rs.upsert(1, mk(2), (r: &mut Res): void => {
        r.id += 10
    })
    print($"res made {made} gone {gone}")
    return 0
}
