// @expect: both done

from "std/runtime" import {
    Promise
}
from "std/sync" import {
    WaitGroup
}

pub fn main(): i32 {
    let wg = WaitGroup.new()
    wg.add(2)
    let wg1 = wg.clone()
    let t1 = Promise<i64>.blocking(move(): i64 => {
        wg1.done()
        return 0
    })
    let wg2 = wg.clone()
    let t2 = Promise<i64>.blocking(move(): i64 => {
        wg2.done()
        return 0
    })
    wg.wait()
    print("both done")
    t1.await()!
    t2.await()!
    return 0
}
