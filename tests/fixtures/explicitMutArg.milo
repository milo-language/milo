// `f(&mut x)` on every kind of call whose parameter is `&mut T`: free fn, generic fn,
// method argument, interface method argument, closure call, closure stored in a field,
// slice and Vec-to-slice coercion, and a `&mut` param passed on. The marker is stripped
// by the checker, so every path below must behave exactly as the bare form did.
// @expect: 3 9 9 7 7
// @expect: 2
// @expect: 5
// @expect: 12 12
// @expect: 20
// @expect: 21
interface Bumper {
    fn bumpBy(self: &Self, n: &mut i64): void
}

struct P {
    xs: Vec<i64>, n: i64
}

struct Adder {
    by: i64, f: (&mut i64) => void
}

impl P {
    fn addTo(self: &Self, out: &mut i64): void {
        out = out + self.n
    }
    fn bumpBy(self: &Self, n: &mut i64): void {
        n = n + self.n
    }
}

fn bump(p: &mut P, by: i64): void {
    p.n = p.n + by
}

fn fill(s: &mut [i64], v: i64): void {
    for i in 0..s.len() {
        s[i] = v
    }
}

fn setAll<T>(v: &mut Vec<T>, x: T): void {
    for i in 0..v.len() {
        v[i] = x
    }
}

fn inc(x: &mut i64): void {
    x = x + 1
}

fn twice(f: (&mut i64) => void, x: &mut i64): void {
    f(&mut x)
    f(&mut x)
}

fn viaBumper(b: &Bumper, n: &mut i64): void {
    b.bumpBy(&mut n)
}

fn main(): i32 {
    var p = P {
        xs: [0, 0, 0, 0], n: 1
    }
    bump(&mut p, 2)
    fill(&mut p.xs[0..2], 9)
    fill(&mut p.xs[2..4], 7)
    print(p.n, " ", p.xs[0], " ", p.xs[1], " ", p.xs[2], " ", p.xs[3])
    var k: i64 = 0
    twice(inc, &mut k)
    print(k)
    p.addTo(&mut k)
    print(k)
    var ys: Vec<i64> = [1, 2]
    setAll(&mut ys, 11)
    fill(&mut ys, 12)
    ys[1] = 12
    print(ys[0], " ", ys[1])
    var m: i64 = 17
    viaBumper(p, &mut m)
    print(m)
    let a = Adder {
        by: 1, f: inc
    }
    a.f(&mut m)
    print(m)
    return 0
}
