// Vec.map is std/vec.milo's map<U>, U inferred from the callback's return type. Covers an
// empty Vec, int to int, a by-value callback on a Copy element (adapted to &T; a fn value
// taking it by value is wrapped in a thunk, as the builtin took one), a named
// fn, int to string and string to int, a struct result and a Vec result, a Drop result
// (each dropped once, with the Vec), a slice and a fixed array as the receiver, a
// temporary receiver, chained maps, and a callback that captures. The result has exactly
// len slots, as before.
// @expect: 0 []
// @expect: [1, 4, 9] 3 [2, 4, 6]
// @expect: ["n1", "n2", "n3"] [2, 2, 2]
// @expect: n3 2
// @expect: 3 3
// @expect: [3, 1] [3, 4]
// @expect: [1, 3, 5, 7]
// @expect: [3, 6, 9] 3
// @expect: [11, 12, 13]
// @expect: [3, 5]
// @expect: made 2
// @expect: drop 1
// @expect: drop 2
// @expect: done

struct P {
    name: string,
    n: i64,
}

struct Noisy {
    id: i64,
}

impl Drop for Noisy {
    fn drop(self: &mut Self) {
        print("drop ", self.id)
    }
}

fn twice(x: i64): i64 {
    return x * 2
}

fn mk(n: i64): Vec<i64> {
    var v: Vec<i64> = Vec.new()
    for i in 0..n {
        v.push(i)
    }
    return v
}

fn lens(s: &[string]): Vec<i64> {
    return s.map((w: &string) => w.len())
}

fn run() {
    let ids: Vec<i64> = [1, 2]
    let ns = ids.map((i: &i64) => Noisy { id: i })
    print("made ", ns.len())
}

fn main() {
    let e: Vec<i64> = Vec.new()
    let em = e.map((x: &i64) => x + 1)
    print(em.len(), " ", em)
    let v: Vec<i64> = [1, 2, 3]
    let sq = v.map((x: i64) => x * x)
    print(sq, " ", sq.capacity(), " ", v.map(twice))
    let names = v.map((x: &i64) => "n" + x.toString())
    print(names, " ", names.map((w: &string) => w.len()))
    let ps = names.map((w: &string) => P { name: w, n: w.len() })
    print(ps[2].name, " ", ps[2].n)
    let vv = v.map((x: &i64) => [x, x])
    print(vv.len(), " ", vv[2][1])
    let words: Vec<string> = ["ab", "cde", "f"]
    print(lens(words[1..3]), " ", [4, 5].map((x: &i64) => x - 1))
    print(mk(4).map(twice).map((x: &i64) => x + 1))
    let tw = (x: i64) => x * 3
    print(v.map(tw), " ", v.map(tw).len())
    let k = 10
    print(v.map((x: &i64) => x + k))
    let fs: Vec<f64> = [1.5, 2.5]
    print(fs.map((x: &f64) => x * 2.0))
    run()
    print("done")
}
