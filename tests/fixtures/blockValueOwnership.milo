// @expect: if-temps 1244000
// @expect: match-temps 1240000
// @expect: mixed 620040
// @expect: locals 1244000
// @expect: scalar 280
// An `if`/`match` used as an EXPRESSION hands back whatever its arms produce. When every
// arm produces a value nobody else owns, so does the expression — and nothing was freeing
// it: `(if c { big(i) } else { big(j) }).len` leaked the whole string every evaluation.
//
// The test is an AND across arms, and it deliberately does NOT accept an arm that is a
// plain variable. `??` does accept one, because it MOVES out of the branch it takes and
// zeroes the source; an `if` arm does not, so `if c { a } else { b }` for locals a and b
// leaves both still owned by the enclosing scope. Dropping the result on top of that is a
// double free — it aborts with exit 133 — which is why the `locals` case below is here: it
// must keep working, and it is already correct because the scope frees a and b.
//
// ~16 KB strings on purpose; `leaks` does not report a small abandoned block, because it
// stays reachable from a stale stack slot. See tests/fixtures/closureParamOwnership.milo.
fn big(n: i64): string {
    return ("ab" + n.toString()).repeat(4000)
}

pub fn main(): i32 {
    var ifTemps = 0
    var i = 0
    while i < 80 {
        ifTemps = ifTemps + (if i % 2 == 0 {
            big(i)
        } else {
            big(i + 1)
        }).len
        i = i + 1
    }
    print("if-temps " + ifTemps.toString())

    var matchTemps = 0
    var j = 0
    while j < 80 {
        let o: Option<i64> = Option.Some(j)
        matchTemps = matchTemps + (match o {
            Option.Some(k) => {
                big(k)
            }
            Option.None => {
                big(0)
            }
        }).len
        j = j + 1
    }
    print("match-temps " + matchTemps.toString())

    // a literal arm owns nothing to free, and must not stop the other arm being freed
    var mixed = 0
    var m = 0
    while m < 80 {
        mixed = mixed + (if m % 2 == 0 {
            big(m)
        } else {
            "z"
        }).len
        m = m + 1
    }
    print("mixed " + mixed.toString())

    // arms that are LOCALS: already correct, and dropping the result would double free
    var locals = 0
    var p = 0
    while p < 80 {
        let a = big(p)
        let b = big(p + 1)
        locals = locals + (if p % 2 == 0 {
            a
        } else {
            b
        }).len
        p = p + 1
    }
    print("locals " + locals.toString())

    // a scalar result must be untouched by any of this
    var scalar = 0
    var q = 0
    while q < 80 {
        scalar = scalar + (if q % 2 == 0 {
            3
        } else {
            4
        })
        q = q + 1
    }
    print("scalar " + scalar.toString())
    return 0
}
