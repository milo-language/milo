// A float literal in a binary expression adopts the other operand's width, the
// same way integer literals adopt theirs. Before this, `1.0 - x` on an f32 was a
// hard error and needed a named f32 constant.
fn lerp(a: f32, b: f32, t: f32): f32 {
    return a * (1.0 - t) + b * t
}

fn scale(v: &Vec<f32>, i: i64): f32 {
    return v[i] * 2.0 + 0.5
}

fn main(): i32 {
    let t: f32 = 0.25
    // @expect: 25
    print((lerp(0.0, 100.0, t) as i64) + 0)

    let v: Vec<f32> = Vec.filled(3, 1.5)
    // @expect: 3
    print(scale(v, 0) as i64)

    // const subexpression, not just a bare literal
    let w: f32 = 2.0
    let r = (1.0 + 3.0) * w
    // @expect: 8
    print(r as i64)

    // f64 is untouched
    let d: f64 = 1.0 - 0.25
    // @expect: 0
    print(d as i64)
    return 0
}
