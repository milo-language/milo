// resolveUrl against every normal and abnormal example of RFC 3986 §5.4, plus the
// shapes HTML documents actually carry (protocol-relative CDN links, query-only).
from "std/url" import { resolveUrl }

fn check(base: &string, refs: &Vec<string>, want: &Vec<string>) {
    for i in 0..refs.len {
        let got = resolveUrl(base, refs[i])
        if got != want[i] {
            print($"FAIL {refs[i]}: got {got} want {want[i]}")
        }
    }
    print($"{refs.len} checked")
}

fn v(items: &[string]): Vec<string> {
    var out: Vec<string> = Vec.new()
    for s in items {
        out.push(s.clone())
    }
    return out
}

pub fn main(): void {
    let base = "http://a/b/c/d;p?q"
    let normalRefs = v(["g:h", "g", "./g", "g/", "/g", "//g", "?y", "g?y", "#s", "g#s", "g?y#s", ";x", "g;x", "g;x?y#s", "", ".", "./", "..", "../", "../g", "../..", "../../", "../../g"])
    let normalWant = v(["g:h", "http://a/b/c/g", "http://a/b/c/g", "http://a/b/c/g/", "http://a/g", "http://g", "http://a/b/c/d;p?y", "http://a/b/c/g?y", "http://a/b/c/d;p?q#s", "http://a/b/c/g#s", "http://a/b/c/g?y#s", "http://a/b/c/;x", "http://a/b/c/g;x", "http://a/b/c/g;x?y#s", "http://a/b/c/d;p?q", "http://a/b/c/", "http://a/b/c/", "http://a/b/", "http://a/b/", "http://a/b/g", "http://a/", "http://a/", "http://a/g"])
    check(base, normalRefs, normalWant)

    let abnormalRefs = v(["../../../g", "../../../../g", "/./g", "/../g", "g.", ".g", "g..", "..g", "./../g", "./g/.", "g/./h", "g/../h", "g;x=1/./y", "g;x=1/../y", "g?y/./x", "g?y/../x", "g#s/./x", "g#s/../x", "http:g"])
    let abnormalWant = v(["http://a/g", "http://a/g", "http://a/g", "http://a/g", "http://a/b/c/g.", "http://a/b/c/.g", "http://a/b/c/g..", "http://a/b/c/..g", "http://a/b/g", "http://a/b/c/g/", "http://a/b/c/g/h", "http://a/b/c/h", "http://a/b/c/g;x=1/y", "http://a/b/c/y", "http://a/b/c/g?y/./x", "http://a/b/c/g?y/../x", "http://a/b/c/g#s/./x", "http://a/b/c/g#s/../x", "http:g"])
    check(base, abnormalRefs, abnormalWant)

    let page = "https://www.example.com/news/2026/story.html"
    let htmlRefs = v(["//cdn.example.net/img/a.jpg", "/favicon.ico", "../img/b.png", "img/c.png", "https://other.org/x", "?page=2"])
    let htmlWant = v(["https://cdn.example.net/img/a.jpg", "https://www.example.com/favicon.ico", "https://www.example.com/news/img/b.png", "https://www.example.com/news/2026/img/c.png", "https://other.org/x", "https://www.example.com/news/2026/story.html?page=2"])
    check(page, htmlRefs, htmlWant)
    // a base with an authority and no path merges under "/"
    print(resolveUrl("https://example.com", "a.png"))
}
// @expect: 23 checked
// @expect: 19 checked
// @expect: 6 checked
// @expect: https://example.com/a.png
