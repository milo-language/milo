// std/webpush reproduces the RFC 8291 section 5 message byte for byte from the
// appendix A inputs (receiver keys, auth secret, sender key, salt): the ECDH secret,
// both HKDF stages, the aes128gcm header and the AES-128-GCM record all have to be
// right for the base64url text to match. VapidKeys.fromPrivate derives the appendix's
// sender public key from its private key. Then each input the subscription or the
// server controls is refused with the variant that says what to fix.
// @skip-os: win32
// Windows is skipped like the std/fetch fixtures: std/webpush links OpenSSL's libcrypto,
// which the xwin sysroot does not ship.
// @expect: rfc 8291 message: true (144 bytes)
// @expect: derived public key: BP4z9KsN6nGRTbVYI_c7VJSPQTBtkgcy27mlmlMoZIIgDll6e3vCYLocInmYWAmS6TlzAC8wEqKK6PBru3jl7A8
// @expect: fresh messages: 108 true
// @expect: bad push subscription: p256dh is not a point on P-256
// @expect: bad push subscription: p256dh is not a 65-byte uncompressed P-256 point
// @expect: bad push subscription: auth secret must be 16 bytes, got 5
// @expect: push payload of 3994 bytes exceeds 3993
// @expect: ok 4096 bytes
// @expect: bad VAPID key: not a P-256 private key
// @expect: bad VAPID key: endpoint is not an absolute https URL
// @expect: vapid: true k=true
from "std/webpush" import { WebPush, VapidKeys, WebPushError }
from "std/base64" import { Base64 }

let UA_PUBLIC = "BCVxsr7N_eNgVRqvHtD0zTZsEc6-VV-JvLexhqUzORcxaOzi6-AYWXvTBHm4bjyPjs7Vd8pZGH6SRpkNtoIAiw4"
let AUTH = "BTBZMqHH6r4Tts7J_aSIgg"
let AS_PRIVATE = "yfWPiYE-n46HLnH0KqZOF1fJJU3MYrct3AELtAQ-oRw"
let SALT = "DGv6ra1nlYgDCS1FRnbzlw"
let EXPECTED = "DGv6ra1nlYgDCS1FRnbzlwAAEABBBP4z9KsN6nGRTbVYI_c7VJSPQTBtkgcy27mlmlMoZIIgDll6e3vCYLocInmYWAmS6TlzAC8wEqKK6PBru3jl7A_yl95bQpu6cVPTpK4Mqgkf1CXztLVBSt2Ks3oZwbuwXPXLWyouBWLVWGNWQexSgSxsj_Qulcy4a-fN"

fn report(r: Result<string, WebPushError>): void {
    match r {
        Ok(v) => print($"ok {v.len} bytes")
        Err(e) => print(e.message())
    }
}

fn main(): i32 {
    let body = WebPush.encryptWith("When I grow up, I want to be a watermelon", UA_PUBLIC, AUTH, Base64.urlDecode(AS_PRIVATE)!, Base64.urlDecode(SALT)!)!
    print($"rfc 8291 message: {Base64.urlEncode(body) == EXPECTED} ({body.len} bytes)")
    let keys = VapidKeys.fromPrivate(AS_PRIVATE)!
    print($"derived public key: {keys.publicKey}")

    // A random sender key and salt: the same length, never the same bytes twice.
    let a = WebPush.encrypt("hello", UA_PUBLIC, AUTH)!
    let b = WebPush.encrypt("hello", UA_PUBLIC, AUTH)!
    print($"fresh messages: {a.len} {a != b}")

    var offCurve = Base64.urlDecode(UA_PUBLIC)!
    offCurve.setByte(64, offCurve[64] ^ 1)
    report(WebPush.encrypt("x", Base64.urlEncode(offCurve), AUTH))
    report(WebPush.encrypt("x", AUTH, AUTH))
    report(WebPush.encrypt("x", UA_PUBLIC, "c2hvcnQ"))
    report(WebPush.encrypt("x".repeat(3994), UA_PUBLIC, AUTH))
    report(WebPush.encrypt("x".repeat(3993), UA_PUBLIC, AUTH))
    match VapidKeys.fromPrivate("AAAA") {
        Ok(_k) => print("short key accepted")
        Err(e) => print(e.message())
    }
    match WebPush.vapid("http://push.example.net/x", "mailto:a@b.c", keys, 1791813600) {
        Ok(_h) => print("http endpoint accepted")
        Err(e) => print(e.message())
    }
    let header = WebPush.vapid("https://push.example.net/push/abc", "mailto:ops@example.com", keys, 1791813600)!
    print($"vapid: {header.startsWith("vapid t=eyJ0eXAiOiJKV1QiLCJhbGciOiJFUzI1NiJ9.")} k={header.endsWith(", k=" + keys.publicKey)}")
    return 0
}
