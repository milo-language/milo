// @skip-os: win32
// the green scheduler's event loop is kqueue/epoll readiness-based; Windows
// needs the IOCP completion port rewrite (docs/roadmap.md).

// @expect: fd woke: hi

// select over an fd read and a channel recv: a task writes the pipe, so the
// fd arm wins while the channel arm stays quiet — exercises the scheduler
// poll claiming a select and tearing down the still-armed channel arm
from "std/platform" import {
    pipe
}
from "std/runtime" import {
    Task, schedulerRunToCompletion
}
from "std/sync" import {
    Channel
}
from "std/select" import {
    Select
}
from "std/io" import {
    OwnedFd, adoptFd, Reader, Writer
}

struct Pipe {
    r: OwnedFd,
    w: OwnedFd,
}

fn makePipe(): Pipe {
    var fds: [i32; 2] = [0; 2]
    unsafe {
        pipe(fds as *i32)
        // pipe() returns two fresh descriptors nothing else owns.
        return Pipe {
            r: adoptFd(fds[0]),
            w: adoptFd(fds[1])
        }
    }
}

pub fn main(): i32 {
    let p = makePipe()
    let r = p.r
    let w = p.w
    let ch = Channel<i64>.new(1)!

    Task.spawn(move(): void => {
        var sel = Select.new()
        sel.onRecv(ch)
        sel.onRead(r)
        sel.onTimeout(2000)
        match sel.wait() {
            0 => {
                print("chan")
            }
            1 => {
                var s = r.stream()
                print("fd woke: ", s.read(8)!)
            }
            2 => {
                print("timeout")
            }
            _ => {
                print("other")
            }
        }
    })

    Task.spawn(move(): void => {
        var s = w.stream()
        s.write("hi")!
    })

    schedulerRunToCompletion()
    return 0
}
