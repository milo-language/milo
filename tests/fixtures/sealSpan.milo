// @expect: len=27
// @expect: name
// @expect: milo
// @expect: eq-keyword=true
// @expect: eq-wrong=false
// @expect: holds-foreign=false
// @expect: bytes=4
// @expect: unsealed=27
from "std/seal" import {
    Sealed, Span, seal
}

struct Token {
    kind: i64,
    at: Span,
}

pub fn main(): i32 {
    var buf: string = "{\"name\":\"milo\",\"name\":\"x\"}"
    buf.push('!')
    let src = seal(buf)
    print("len=" + src.len().toString())

    // Spans stored in a struct, in a Vec, outliving the expression that made
    // them. No reference is stored and nothing is copied.
    var toks: Vec<Token> = Vec.new()
    toks.push(Token {
        kind: 1, at: src.spanOf(2, 4)
    })
    toks.push(Token {
        kind: 2, at: src.spanOf(9, 4)
    })
    toks.push(Token {
        kind: 1, at: src.spanOf(16, 4)
    })

    print(src.text(toks[0].at))
    print(src.text(toks[1].at))

    // The comparison a scanner actually wants: no allocation.
    print("eq-keyword=" + src.eq(toks[0].at, "name").toString())
    print("eq-wrong=" + src.eq(toks[1].at, "name").toString())

    // A span that does not fit is rejected rather than read.
    let foreign: Span = src.spanOf(100, 4)
    print("holds-foreign=" + src.holds(foreign).toString())

    var n = 0
    src.each(toks[1].at, (b: u8): void => {
        n = n + 1
    })
    print("bytes=" + n.toString())

    let back = src.unseal()
    print("unsealed=" + back.len.toString())
    return 0
}
