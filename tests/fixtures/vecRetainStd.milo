// Vec.retain is std/vec.milo code: one pass, keepers compacted toward the front, the rest
// dropped in place first to last. Covers an empty Vec, keep-all, keep-none, alternating,
// a by-value predicate on a Copy element (coerced to &T), a named fn predicate, string
// and nested Vec elements, Drop elements (each rejected one dropped once, during the pass,
// in order), a predicate that captures, a field receiver, and a predicate that reads the
// element's field.
// @expect: 0
// @expect: [1, 2, 3, 4, 5, 6]
// @expect: [2, 4, 6]
// @expect: [] 0
// @expect: ["apple", "cherry"]
// @expect: [[1], [2, 3]]
// @expect: drop 1
// @expect: drop 2
// @expect: drop 4
// @expect: drop 5
// @expect: kept 2 0 3
// @expect: [10, 15]
// @expect: done
// @expect: drop 0
// @expect: drop 3

struct Noisy {
    id: i64,
}

impl Drop for Noisy {
    fn drop(self: &mut Self) {
        print("drop ", self.id)
    }
}

struct Holder {
    items: Vec<i64>,
}

fn isEven(x: i64): bool {
    return x % 2 == 0
}

fn main() {
    var e: Vec<i64> = Vec.new()
    e.retain((x: &i64) => true)
    print(e.len())
    var v: Vec<i64> = [1, 2, 3, 4, 5, 6]
    v.retain((x: i64) => x != 99)
    print(v)
    v.retain(isEven)
    print(v)
    v.retain((x: &i64) => false)
    print(v, " ", v.len())
    var s: Vec<string> = ["apple", "b" + "x", "cherry", "d"]
    let min = 2
    s.retain((w: &string) => w.len() > min)
    print(s)
    var nested: Vec<Vec<i64>> = [[1], [], [2, 3], []]
    nested.retain((w: &Vec<i64>) => w.len() > 0)
    print(nested)
    var ns: Vec<Noisy> = Vec.new()
    for i in 0..6 {
        ns.push(Noisy { id: i })
    }
    ns.retain((n: &Noisy) => n.id % 3 == 0)
    print("kept ", ns.len(), " ", ns[0].id, " ", ns[1].id)
    var h = Holder { items: [5, 10, 15] }
    h.items.retain((x: &i64) => x > 7)
    print(h.items)
    print("done")
}
