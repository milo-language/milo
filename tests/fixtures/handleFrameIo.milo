// Framed IO through handles, never a descriptor number: Child.takeStdin hands the
// stdin pipe over (the child sees EOF once it and every dup drop), OwnedFd.writeOnce
// writes a whole message in one write(2), and FdReader.attach reads off a handle.
// @skip-os: win32
from "std/process" import { Child }
from "std/io" import { OwnedFd, FdReader }

fn send(w: &OwnedFd, body: &string): bool {
    let msg = $"Content-Length: {body.len}\r\n\r\n" + body
    return w.writeOnce(msg) == msg.len
}

// Both write handles drop when this returns, which is the child's EOF.
fn writeBoth(c: &mut Child): void {
    let inp = c.takeStdin()
    // A second writer on the same pipe, as a server's other task would hold.
    let other = OwnedFd.dup(inp)!
    print(send(inp, "{\"a\":1}"))
    print(send(other, "{\"b\":2}"))
    // closeStdin no longer owns the pipe: the handles above are what close it.
    c.closeStdin()
}

fn main() {
    var args: Vec<string> = []
    var c = Child.spawn("cat", args, false)!
    let out = c.takeStdout()
    writeBoth(&mut c)
    let r = FdReader.attach(out)
    var got = ""
    while true {
        let b = r.readByte()
        if b < 0 {
            break
        }
        got.push(b as u8)
    }
    print(got.replace("\r\n", "|"))
    print(c.wait()!)
    let gone = c.takeStdin()
    print(gone.isOpen())
    print(gone.writeOnce("x"))
}
// @expect: true
// @expect: true
// @expect: Content-Length: 7||{"a":1}Content-Length: 7||{"b":2}
// @expect: 0
// @expect: false
// @expect: -1
