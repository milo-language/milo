// @skip-os: win32
// std/fetch request serialization and form encoding, exercised without a socket.
// Windows is skipped because importing std/fetch links OpenSSL, which the xwin
// sysroot does not ship.

from "std/fetch" import {
    FetchOptions, FormField, buildRequest, findHeader, formEncode, urlEncode
}

fn get(headers: string): FetchOptions {
    return FetchOptions {
        method: "GET", headers: headers, body: ""
    }
}

fn main(): void {
    // Servers like Overpass 406 a request with no Accept, so one is always sent.
    let plain = buildRequest("example.com", "/x", get(""))
    // @expect: default accept true
    print("default accept " + findHeader(plain, "Accept").isSome().toString())
    // @expect: default ua true
    print("default ua " + findHeader(plain, "User-Agent").isSome().toString())

    // A caller-supplied header must not be duplicated by the default.
    let custom = buildRequest("example.com", "/x", get("Accept: application/json"))
    var accepts: i64 = 0
    var i: i64 = 0
    while i + 7 < custom.len {
        if (i == 0 || custom[i - 1] == '\n') && custom.substr(i, i + 7) == "Accept:" {
            accepts = accepts + 1
        }
        i = i + 1
    }
    // @expect: accept count 1
    print("accept count " + accepts.toString())

    // A header block with an empty value still counts as present, and findHeader
    // says so: Some("") for present-but-empty, None only for genuinely absent.
    // @expect: empty value present true
    print("empty value present " + findHeader("Accept:", "Accept").isSome().toString())
    // @expect: empty value is empty true
    print("empty value is empty " + ((findHeader("Accept:", "Accept") ?? "x") == "").toString())
    // @expect: absent false
    print("absent " + findHeader("Accept: */*", "Authorization").isSome().toString())
    // @expect: absent falls back x
    print("absent falls back " + (findHeader("Accept: */*", "Authorization") ?? "x"))

    var withBody = FetchOptions {
        method: "POST",
        headers: "Content-Type: application/x-www-form-urlencoded",
        body: "data=1",
    }
    let post = buildRequest("example.com", "/api", withBody)
    // @expect: content length true
    print("content length " + findHeader(post, "Content-Length").isSome().toString())

    // @expect: a%20b%2Bc%2Fd~e
    print(urlEncode("a b+c/d~e"))

    var fields: Vec<FormField> = []
    fields.push(FormField {
        name: "data", value: "way[\"natural\"]"
    })
    fields.push(FormField {
        name: "n", value: "1&2"
    })
    // @expect: data=way%5B%22natural%22%5D&n=1%262
    print(formEncode(fields))
}
