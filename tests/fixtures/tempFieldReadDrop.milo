// An owning field read out of a temporary is cloned, and the temporary is dropped right
// after the read, before the statement goes on: `print(mk(1).name)` runs mk(1)'s Drop
// before print does. A fork of named places is a view and drops nothing.
// @expect: drop 1
// @expect: n1
// @expect: drop 2
// @expect: n2
// @expect: n4
// @expect: drop 5
// @expect: drop 4
struct R { id: i64, name: string }

impl Drop for R {
    fn drop(self: &mut Self): void { print($"drop {self.id}") }
}

fn mk(i: i64): R { return R { id: i, name: $"n{i}" } }

fn main() {
    print(mk(1).name)
    let c = true
    print((if c { mk(2) } else { mk(3) }).name)
    let a = mk(4)
    let b = mk(5)
    print((if c { a } else { b }).name)
}
