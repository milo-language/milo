// @expect: 1
// @expect: 2
// @expect: 3
// @expect: done

// close wakes a parked green receiver; `for v in ch` drains pending items
// then ends — the hades wsWriterLoop pattern with no self-pipe machinery
from "std/runtime" import {
    Task, schedulerRunToCompletion
}
from "std/sync" import {
    Channel
}

pub fn main(): i32 {
    var ch = Channel<i64>.new(2)!
    let chProd = ch.clone()

    Task.spawn(move(): void => {
        for v in ch {
            print(v)
        }
        print("done")
    })

    Task.spawn(move(): void => {
        chProd.send(1)!
        chProd.send(2)!
        chProd.send(3)!
        chProd.close()
    })

    schedulerRunToCompletion()
    return 0
}
