// @expect: 0
// @expect: 3
// A `?` that fails inside an interpolation returns early. Pieces of the same
// interpolation evaluated before it (here `wrap("q")`) are owned temporaries still
// pending, and the error path drops them (codegen's pending-temporaries stack; the
// ownership ledger gates it). The success path is unchanged.
fn part(n: i64): Result<string, string> {
    if n > 0 {
        return Err("no")
    }
    return Ok("x")
}

fn wrap(s: &string): string {
    return "<" + s + ">" + "y".repeat(256)
}

fn whole(n: i64): Result<string, string> {
    return Ok($"a {wrap("q")} and {part(n)?} b")
}

fn main() {
    var errs: i64 = 0
    for i in 0..3 {
        if whole(1).isErr() {
            errs += 1
        }
    }
    print((whole(0) ?? "").len - 269)
    print(errs)
}
