// @expect: 1
// @expect: 2
// @expect: 3
// @expect: done
from "std/runtime" import {
    Promise
}
from "std/sync" import {
    Channel
}

pub fn main(): i32 {
    var ch = Channel<i64>.new(4)!

    let chW = ch.clone()
    let t = Promise<i64>.blocking(move(): i64 => {
        chW.send(1)!
        chW.send(2)!
        chW.send(3)!
        chW.close()
        return 0
    })

    for val in ch {
        print(val)
    }
    print("done")

    t.await()!
    return 0
}
