// Integer-only, bounded, no allocation, no recursion: passes do178c-a on the binary.
fn clamp(x: i32, lo: i32, hi: i32): i32 {
    if x < lo { return lo }
    if x > hi { return hi }
    return x
}

pub fn main(): i32 {
    var v: i32 = 0
    var k: i32 = 0
    while k < 100 {
        v = clamp(v + k, 0, 1000)
        k += 1
    }
    return v
}
