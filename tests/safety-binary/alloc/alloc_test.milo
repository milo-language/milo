from "std/testing" import { assertEq }
from "./alloc" import { entry }

// banner is private (a pub fn would change its codegen to realloc, which the shim lacks), so it is tested through entry.
@req(LLR-1)
fn testBanner(): void {
    assertEq(entry(), 10)
}

@req(LLR-2)
fn testEntry(): void {
    assertEq(entry(), 10)
}

@req(HLR-1)
fn testHlr(): void {
    assertEq(entry() > 0, true)
}
