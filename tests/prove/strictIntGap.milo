// @proven: 2
// @failed: 0
// @unknown: 0
// `x < y` implies `x + 1 <= y` over the INTEGERS, but not over the rationals (y = x + 0.5).
//
// A solver that decides over the rationals cannot see this gap; z3 decides over Int, so the
// contract proves.
pub fn tighten(x: i64, y: i64): i64
requires x < y
ensures result <= y
{
    return x + 1
}

pub fn main(): i32 {
    print(tighten(2, 5))
    return 0
}
