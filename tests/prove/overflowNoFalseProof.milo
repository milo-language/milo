// @proven: 1
// @failed: 1
// @unknown: 0
// Soundness: a contract that only holds for non-negative n must not prove for a caller whose
// bound allows a negative one. `x = -1` satisfies
//   (>= x -4611686018427387904) & (<= x 4611686018427387904) & (not (>= x 0))
// so `buggy` really can call `half` with a negative n. A false proof is the worst answer a
// prover can give, so the check is that this comes back `failed` with that witness.
//
// (The 1 proven is main's own call, buggy(10), a constant that satisfies the bound.)
pub fn half(n: i64): i64
requires n >= 0
{
    return n / 2
}

pub fn buggy(x: i64): i64
requires x >= 0 - 4611686018427387904 && x <= 4611686018427387904
{
    return half(x)
}

pub fn main() {
    print(buggy(10))
}
