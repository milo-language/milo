// @proven: 0
// @failed: 1
// @unknown: 0
// One factor has no bound, so the claim is false (a = 10, b = 21): z3 refutes it with a real
// counterexample, and it must never come back proven.
pub fn scale(a: i64, b: i64): i64
requires a >= -10 && a <= 10
ensures result >= -200 && result <= 200
{
    return a * b
}
