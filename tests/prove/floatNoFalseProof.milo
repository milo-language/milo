// @proven: 1
// @failed: 1
// @unknown: 0
//
// A real-valued variable must not be reasoned about as an integer.
//
// An obviously false postcondition over a strict real interval must be refuted, not proven:
// reasoning about `0 < x && x < 1` as if x were an integer makes the system look infeasible,
// and infeasible is how a refutation-based prover spells *proven*. `honest` is the other
// half: a conjunction of linear bounds over the reals must still prove.

// x is strictly inside (0, 1), so this ensures is false for every admissible input.
pub fn bogus(x: f64): f64
requires x > 0.0 && x < 1.0
ensures result > 100.0
{
    return x
}

pub fn honest(x: f64, lo: f64, hi: f64): f64
requires lo <= hi
ensures result >= lo && result <= hi
{
    if x < lo {
        return lo
    }
    if x > hi {
        return hi
    }
    return x
}

pub fn main(): i32 {
    return 0
}
