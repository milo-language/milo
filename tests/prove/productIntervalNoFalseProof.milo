// @proven: 0
// @failed: 1
// @unknown: 0
// The corners reach 200 (10 * 20), so `result <= 199` is false. A false bound must never prove;
// z3 refutes it with the witness a = 10, b = 20.
pub fn scale(a: i64, b: i64): i64
requires a >= -10 && a <= 10
requires b >= -20 && b <= 20
ensures result >= -199 && result <= 199
{
    return a * b
}
