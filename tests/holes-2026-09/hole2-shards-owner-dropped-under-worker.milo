// drop the owner while a worker still holds a window
from "std/shard" import {
    Shard, Shards, shatter
}
from "std/runtime" import {
    Promise
}
from "std/time" import {
    sleepMs
}

fn leak(): Promise<Shard<f64>> {
    var data: Vec<f64> = Vec.filled(1000000, 1.0)
    var owner = shatter(data, 1)
    var ws = owner.windows()
    let w = ws.pop()!
    let p = Promise<Shard<f64>>.blocking(move(): Shard<f64> => {
        var s = w
        sleepMs(50)
        var j: i64 = 0
        while j < s.len() {
            s.set(j, 2.0)
            j = j + 1
        }
        return s
    }
    )
    return p
    // owner dropped here: buffer freed while worker writes
}

pub fn main(): i32 {
    let p = leak()
    var junk: Vec<f64> = Vec.filled(1000000, 9.0)
    let s = p.await()!
    print(s.get(0))
    print(junk[0])
    return 0
}
