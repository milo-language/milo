fn noop(v: &mut Vec<i64>): void
ensures v.len == old(v.len)
{
}

fn setFirst(v: &mut Vec<i64>): void
requires v.len > 0
ensures v.len == old(v.len)
{
    v[0] = 5
}

fn viaCall(v: &mut Vec<i64>): void
requires v.len > 0
ensures v.len == old(v.len)
{
    setFirst(v)
}

pub fn main(): i32 {
    var v: Vec<i64> = Vec.new()
    v.push(1)
    viaCall(v)
    print(v.len)
    return 0
}
