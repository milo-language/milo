fn push1(v: &mut Vec<i64>, x: i64): void
requires x > 0
ensures v.len == old(v.len) + 1
{
    v.push(x)
}

fn bad(v: &mut Vec<i64>): void
ensures v.len == old(v.len) + 1
{
    v.push(1)
    v.push(2)
}

pub fn main(): i32 {
    var v: Vec<i64> = Vec.new()
    push1(v, 3)
    print(v.len)
    bad(v)
    print(v.len)
    return 0
}
