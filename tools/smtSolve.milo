// smtSolve — native front end for std/smt. Reads a whitespace-separated integer
// DSL of proof obligations from stdin and prints one verdict per problem. Built
// once and cached by `milo prove`, which pipes each contract's verification
// conditions here — so obligations are discharged by a native Milo binary, no
// per-proof compile and no external solver.
//
// DSL grammar (all tokens are integers):
//   P                                  number of problems
//   repeat P times:
//     nvars natoms
//     repeat nvars: isInt                               (1 = integer variable, 0 = real)
//     repeat natoms: strict c0 .. c(nvars-1) konst      (atom: row·x + konst <op> 0)
//     nnodes
//     repeat nnodes, in creation order (children first):
//       0 atomIdx                      atom node
//       1 childIdx                     not
//       2 nkids kid0 ..                and
//       3 nkids kid0 ..                or
//     rootIdx
// Output: one line per problem, "<index> <proven|violated|unknown>".

from "std/io" import {
    readStdin
}
from "std/os" import {
    exit
}
from "std/smt" import {
    Verdict, newProblemMixed, addAtom, nAtom, nNot, nAnd, nOr, decide
}

// Read the token at `pos` as an integer and advance the cursor. The stream is
// machine-generated by `milo prove`, so a non-integer token means the writer and
// this reader disagree about the grammar — stopping is the only honest answer,
// since a guessed value would be silently discharged as a proof.
fn nextInt(toks: &Vec<string>, pos: &mut i64): i64 {
    let Option.Some(v) = toks[pos].parseInt() else {
        eprint($"smtSolve: token {pos} is not an integer: '{toks[pos]}'")
        exit(1)
        // unreachable — exit never returns, but the compiler doesn't know that
        // and a let-else block has to end in a diverging statement.
        return 0
    }
    pos = pos + 1
    return v
}

fn main(): i32 {
    let s = readStdin()
    let toks = s.splitWhitespace()
    var pos: i64 = 0

    let nprob = nextInt(toks, &mut pos)

    var pi: i64 = 0
    while pi < nprob {
        let nvars = nextInt(toks, &mut pos)
        let natoms = nextInt(toks, &mut pos)
        var flags: Vec<bool> = []
        var f: i64 = 0
        while f < nvars {
            flags.push(nextInt(toks, &mut pos) == 1)
            f = f + 1
        }
        var p = newProblemMixed(nvars, flags)

        var a: i64 = 0
        while a < natoms {
            let strict = nextInt(toks, &mut pos)
            var row: Vec<i64> = []
            var c: i64 = 0
            while c < nvars {
                row.push(nextInt(toks, &mut pos))
                c = c + 1
            }
            let konst = nextInt(toks, &mut pos)
            // atoms are created in order, so atom index == a
            let _ai = addAtom(&mut p, row, konst, strict == 1)
            a = a + 1
        }

        let nnodes = nextInt(toks, &mut pos)
        var nd: i64 = 0
        while nd < nnodes {
            let kind = nextInt(toks, &mut pos)
            if kind == 0 {
                let ai = nextInt(toks, &mut pos)
                let _n = nAtom(&mut p, ai)
            } else if kind == 1 {
                let ch = nextInt(toks, &mut pos)
                let _n = nNot(&mut p, ch)
            } else {
                let nk = nextInt(toks, &mut pos)
                var kids: Vec<i64> = []
                var kk: i64 = 0
                while kk < nk {
                    kids.push(nextInt(toks, &mut pos))
                    kk = kk + 1
                }
                if kind == 2 {
                    let _n = nAnd(&mut p, kids)
                } else {
                    let _n = nOr(&mut p, kids)
                }
            }
            nd = nd + 1
        }

        let root = nextInt(toks, &mut pos)
        // A violated verdict carries a witness — emit the concrete values (one
        // per variable, in declaration order) so the caller can report the
        // failing input, not just that one exists.
        match decide(p, root) {
            Verdict.Proven => {
                print(pi, " proven")
            }
            Verdict.Unknown => {
                print(pi, " unknown")
            }
            Verdict.Violated(w) => {
                var line: string = $"{pi} violated"
                var k: i64 = 0
                while k < w.len {
                    line = line + $" {w[k]}"
                    k = k + 1
                }
                print(line)
            }
        }
        pi = pi + 1
    }
    return 0
}
