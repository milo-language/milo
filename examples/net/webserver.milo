// Router-based HTTP server — demos Milo's std/http router, context, and middleware
from "std/http" import {
    Context, Response, Router, serveRouter
}
from "std/argparse" import {
    ArgParser
}
from "std/strconv" import {
    parseInt
}

// ── Algorithms ──

pub fn fibonacci(n: i64): i64 {
    if n <= 1 {
        return n
    }
    var a: i64 = 0
    var b: i64 = 1
    var i: i64 = 2
    while i <= n {
        let next = a + b
        a = b
        b = next
        i += 1
    }
    return b
}

pub fn isPrime(n: i64): bool {
    if n < 2 {
        return false
    }
    if n < 4 {
        return true
    }
    if n % 2 == 0 {
        return false
    }
    var i: i64 = 3
    while i * i <= n {
        if n % i == 0 {
            return false
        }
        i += 2
    }
    return true
}

pub fn collatzSteps(start: i64): i64 {
    var x: i64 = start
    var steps: i64 = 0
    while x != 1 && steps < 500 {
        if x % 2 == 0 {
            x /= 2
        } else {
            x = x * 3 + 1
        }
        steps += 1
    }
    return steps
}

pub fn fizzbuzzText(n: i64): string {
    var result: string = ""
    var i: i64 = 1
    while i <= n {
        if i > 1 {
            result += "\n"
        }
        if i % 15 == 0 {
            result += "FizzBuzz"
        } else if i % 3 == 0 {
            result += "Fizz"
        } else if i % 5 == 0 {
            result += "Buzz"
        } else {
            result += i.toString()
        }
        i += 1
    }
    return result
}

// ── Route handlers ──

pub fn homeHandler(ctx: &mut Context): Response {
    return ctx.html(@embedFile("index.html"))
}

pub fn helloHandler(ctx: &mut Context): Response {
    return ctx.text("Hello from Milo!")
}

pub fn jsonHandler(ctx: &mut Context): Response {
    return ctx.json({
        language: "milo", backend: "llvm", memorySafe: true
    })
}

pub fn fibHandler(ctx: &mut Context): Response {
    let n = parseInt(ctx.param("n") ?? "")!
    return ctx.json({
        n: n, result: fibonacci(n)
    })
}

pub fn primeHandler(ctx: &mut Context): Response {
    let n = parseInt(ctx.param("n") ?? "")!
    return ctx.json({
        n: n, isPrime: isPrime(n)
    })
}

pub fn collatzHandler(ctx: &mut Context): Response {
    let n = parseInt(ctx.param("n") ?? "")!
    return ctx.json({
        start: n, steps: collatzSteps(n)
    })
}

pub fn fizzbuzzHandler(ctx: &mut Context): Response {
    let n = parseInt(ctx.param("n") ?? "")!
    return ctx.text(fizzbuzzText(n))
}

pub fn searchHandler(ctx: &mut Context): Response {
    // `?q=` is present with an empty value; no `?q=` at all is absent. They are
    // different client mistakes, so they get different messages.
    let Some(q) = ctx.query("q") else {
        ctx.setStatus(400)
        return ctx.json({
            error: "missing ?q= parameter"
        })
    }
    if q.len == 0 {
        ctx.setStatus(400)
        return ctx.json({
            error: "empty ?q= parameter"
        })
    }
    return ctx.json({
        query: q
    })
}

pub fn logMiddleware(ctx: &mut Context, next: (&mut Context) => Response): Response {
    print(ctx.req.method + " " + ctx.req.path)
    return next(&mut ctx)
}

// ── Main ──

pub fn main(): i32 {
    var parser = ArgParser.new("webserver", "Router-based HTTP server")
    parser.addI64("port", "p", "Port to listen on", 8080)
    let args = parser.parse()

    var r: Router = Router.new()

    r.use(logMiddleware)
    r.get("/", homeHandler)
    r.get("/hello", helloHandler)
    r.get("/json", jsonHandler)
    r.get("/fib/:n", fibHandler)
    r.get("/prime/:n", primeHandler)
    r.get("/collatz/:n", collatzHandler)
    r.get("/fizzbuzz/:n", fizzbuzzHandler)
    r.get("/search", searchHandler)

    let port = args.getU16("port")
    let result = serveRouter(port, r)
    if let Err(msg) = result {
        print("server error: ", msg)
        return 1
    }
    return 0
}
