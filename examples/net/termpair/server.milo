// termpair server — WebSocket relay for terminal sharing

from "std/http" import {
    Context, Outbox, Response, Router, WebSocket, serveRouter
}
from "std/argparse" import {
    ArgParser
}
from "std/json" import {
    Json
}

from "./protocol" import {
    makeTerminalInfo, makePublicSession, makeStartBroadcast,
    makeResizeMsg, makeNumClients, parseEvent, parsePayloadI64
}

// ── Session state ──

// One shared terminal. `term` reaches the terminal's socket and `viewers` each browser's;
// std/http writes what they queue from each connection's own task, and a send to one that
// has gone is refused rather than written anywhere.
pub struct Session {
    terminalId: string,
    command: string,
    startTime: string,
    isPublic: bool,
    allowControl: bool,
    displayName: string,
    rows: i64,
    cols: i64,
    browserCount: i64,
    alive: bool,
    term: Outbox,
    viewers: Vec<Outbox>,
}

pub var sessions: Vec<Session> = []

pub var nextId: i64 = 1

pub fn generateId(): string {
    let id = nextId
    nextId += 1
    return "t" + id.toString()
}

pub fn findSession(terminalId: &string): i64 {
    for i in 0..sessions.len {
        if sessions[i].terminalId == terminalId {
            return i
        }
    }
    return -1
}

// Send `msg` to every browser watching session `idx`, forgetting the ones that left.
pub fn broadcastTo(idx: i64, msg: &string): void {
    var i: i64 = 0
    while i < sessions[idx].viewers.len {
        if sessions[idx].viewers[i].send(msg) {
            i += 1
        } else {
            sessions[idx].viewers.remove(i)
        }
    }
}

// ── HTTP helpers ──

pub fn reply(ctx: &mut Context, status: i32, contentType: &string, body: &string): Response {
    ctx.setHeader("Access-Control-Allow-Origin", "*")
    return Response.Status(status, contentType, body)
}

// True if `path` is exactly `suffix` or ends with it (e.g. "/app.js" matches
// both "/app.js" and "/s/app.js"). index.html references assets relatively, so
// when the page is served at /s/<id> the browser requests /s/app.js etc.
pub fn pathEndsWith(path: &string, suffix: &string): bool {
    if path.len < suffix.len {
        return false
    }
    return path.substr(path.len - suffix.len, path.len) == suffix
}

// ── Embedded static files (initialized in main — global string init is NYI) ──

pub var indexHtml: string = ""

pub var appJs: string = ""

pub var styleCss: string = ""

pub var xtermJs: string = ""

pub var xtermCss: string = ""

// ── Handle terminal WebSocket ──

pub fn handleTerminalWs(_ctx: &mut Context, ws: &mut WebSocket): void {
    // read init message
    let Option.Some(initPayload) = ws.recv() else {
        return
    }

    let j = Json.parse(initPayload)!
    let rows = j.i64("rows") ?? 24
    let cols = j.i64("cols") ?? 80
    let command = j.str("command") ?? "bash"
    let startTime = j.str("broadcast_start_time_iso") ?? ""
    let isPublic = j.bool("is_public") ?? false
    let allowControl = j.bool("allow_browser_control") ?? false

    let terminalId = generateId()
    let displayName = if isPublic {
        "milo-terminal"
    } else {
        ""
    }

    sessions.push(Session {
        terminalId: terminalId,
        command: command,
        startTime: startTime,
        isPublic: isPublic,
        allowControl: allowControl,
        displayName: displayName,
        rows: rows, cols: cols,
        browserCount: 0,
        alive: true,
        term: ws.outbox(),
        viewers: [],
    })

    if !ws.sendText(makeStartBroadcast(terminalId)) {
        return
    }
    print($"terminal connected: {terminalId} (command: {command})")
    flush()

    // read terminal output, broadcast to browsers
    while true {
        let Option.Some(raw) = ws.recv() else {
            break
        }
        let event = parseEvent(raw)
        let idx = findSession(terminalId)
        if idx < 0 {
            break
        }
        if event == "resize" {
            sessions[idx].rows = parsePayloadI64(raw, "rows")
            sessions[idx].cols = parsePayloadI64(raw, "cols")
            broadcastTo(idx, raw)
        } else if event == "new_output" || event == "aes_keys" || event == "aes_key_rotation" {
            broadcastTo(idx, raw)
        }
    }

    // A tombstone (alive=false) rather than a removal: lookups gate on `alive`, and
    // generateId never reuses an id.
    print($"terminal disconnected: {terminalId}")
    let idx = findSession(terminalId)
    if idx >= 0 {
        sessions[idx].alive = false
        broadcastTo(idx, "{\"event\":\"fatal_error\",\"payload\":\"session ended\"}")
    }
}

// ── Handle browser WebSocket ──

pub fn handleBrowserWs(ctx: &mut Context, ws: &mut WebSocket): void {
    let terminalId = ctx.query("terminal_id") ?? ""
    let idx = findSession(terminalId)
    if idx < 0 || !sessions[idx].alive {
        return
    }

    sessions[idx].browserCount += 1
    let count = sessions[idx].browserCount
    broadcastTo(idx, makeNumClients(count))

    if !ws.sendText(makeResizeMsg(sessions[idx].rows, sessions[idx].cols)) {
        return
    }
    sessions[idx].viewers.push(ws.outbox())
    let _ = sessions[idx].term.send("{\"event\":\"new_browser_connected\",\"payload\":{}}")

    print($"browser connected to {terminalId} (viewers: {count})")

    // read loop: browser → terminal
    while true {
        let Option.Some(raw) = ws.recv() else {
            break
        }
        let event = parseEvent(raw)
        let bidx = findSession(terminalId)
        if bidx < 0 {
            break
        }
        if event == "command" || event == "new_browser_connected" || event == "request_key_rotation" {
            let _ = sessions[bidx].term.send(raw)
        } else if event == "chat" {
            broadcastTo(bidx, raw)
        } else if event == "request_terminal_dimensions" {
            if !ws.sendText(makeResizeMsg(sessions[bidx].rows, sessions[bidx].cols)) {
                break
            }
        }
    }

    let didx = findSession(terminalId)
    if didx >= 0 {
        sessions[didx].browserCount -= 1
        broadcastTo(didx, makeNumClients(sessions[didx].browserCount))
        print($"browser disconnected from {terminalId} (viewers: {sessions[didx].browserCount})")
    }
}

// ── API handlers ──

pub fn handleGetSessions(): string {
    var result: string = "["
    var first: bool = true
    for i in 0..sessions.len {
        if sessions[i].isPublic && sessions[i].alive {
            if !first {
                result.pushStr(",")
            }
            first = false
            result.pushStr(makePublicSession(sessions[i].terminalId, sessions[i].displayName, sessions[i].command, sessions[i].rows, sessions[i].cols, sessions[i].startTime, sessions[i].browserCount))
        }
    }
    result += "]"
    return result
}

pub fn handleGetTerminal(terminalId: &string): string {
    let idx = findSession(terminalId)
    if idx < 0 {
        return ""
    }
    return makeTerminalInfo(sessions[idx].terminalId, sessions[idx].rows, sessions[idx].cols, sessions[idx].command, sessions[idx].startTime, sessions[idx].isPublic, sessions[idx].displayName, sessions[idx].allowControl)
}

// ── Main ──

// Every GET that is not a WebSocket upgrade: the page, its assets and the JSON API.
pub fn staticHandler(ctx: &mut Context): Response {
    let path = ctx.req.path
    if path == "/" || path == "/index.html" {
        return reply(&mut ctx, 200, "text/html; charset=utf-8", indexHtml)
    } else if pathEndsWith(path, "/app.js") {
        return reply(&mut ctx, 200, "application/javascript", appJs)
    } else if pathEndsWith(path, "/style.css") {
        return reply(&mut ctx, 200, "text/css", styleCss)
    } else if pathEndsWith(path, "/xterm.min.js") {
        return reply(&mut ctx, 200, "application/javascript", xtermJs)
    } else if pathEndsWith(path, "/xterm.min.css") {
        return reply(&mut ctx, 200, "text/css", xtermCss)
    } else if path == "/ping" {
        return reply(&mut ctx, 200, "application/json", "\"pong\"")
    } else if path == "/api/sessions" {
        return reply(&mut ctx, 200, "application/json", handleGetSessions())
    } else if path.startsWith("/terminal/") {
        let body = handleGetTerminal(path.substr(10, path.len))
        if body.len == 0 {
            return reply(&mut ctx, 404, "text/plain", "not found")
        }
        return reply(&mut ctx, 200, "application/json", body)
    } else if path.startsWith("/s/") {
        return reply(&mut ctx, 200, "text/html; charset=utf-8", indexHtml)
    }
    return reply(&mut ctx, 404, "text/plain", "not found")
}

pub fn main(): i32 {
    indexHtml = @embedFile("static/index.html")
    appJs = @embedFile("static/app.js")
    styleCss = @embedFile("static/style.css")
    xtermJs = @embedFile("static/xterm.min.js")
    xtermCss = @embedFile("static/xterm.min.css")

    var parser = ArgParser.new("termpair-server", "terminal sharing server")
    parser.addI64("port", "p", "port to listen on", 8000)
    let args = parser.parse()
    let port = args.getU16("port")

    var r = Router.new()
    r.ws("/connect_to_terminal", handleTerminalWs)
    r.ws("/connect_browser_to_terminal", handleBrowserWs)
    r.get("/*", staticHandler)
    // Each connection is its own green task; std/http owns every socket.
    if let Result.Err(e) = serveRouter(port, r) {
        print($"error: {e}")
        return 1
    }
    return 0
}
