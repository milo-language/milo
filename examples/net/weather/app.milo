// weather — weather.gov frontend served from a single static Milo binary.
// Assets and the US place-name index are compiled in with embedFile, so the
// deploy artifact is one file with no adjacent data directory to keep in sync.
from "std/http" import {
    Context, Response, Router, serveRouter
}
from "std/argparse" import {
    ArgParser
}
from "std/string" import {
    strSplit, strStartsWith, strToLower, strTrim, strContains
}
from "std/json" import {
    Json, jsonEscapeStr
}
from "std/fetch" import {
    FetchOptions, fetchWith, findHeader
}
from "std/time" import {
    epochMillis
}
from "std/strconv" import {
    parseInt
}

pub struct City {
    name: string,
    state: string,
    lat: string,
    lon: string,
    // name lowercased once at load; matching every keystroke against 17k
    // freshly-lowercased strings would dominate the request
    key: string,
    // Lowercased alternates from the TSV's optional 6th column. The name a
    // place is filed under and the name its residents say are often different
    // words: this row's GNIS name is "Emerald Lake Hills", but everyone in San
    // Mateo County — and the USPS — calls it Emerald Hills. Both have to find
    // it; only the one people say gets displayed.
    altKeys: Vec<string>,
}

// Populated by loadCities() at startup. Module scope only permits a
// compile-time-constant initializer, hence the empty literal.
pub var cities: Vec<City> = []

pub let MAX_SUGGESTIONS = 8

// Rows are "name<TAB>state<TAB>lat<TAB>lon<TAB>population", pre-sorted by
// population descending, so a first-match-wins scan is already popularity-ranked.
pub fn loadCities(): void {
    let raw = @embedFile("data/uscities.tsv")
    // lines() views into the embedded blob — splitting it would copy every row first
    for line in raw.lines() {
        let f = line.split("\t")
        if f.len < 4 {
            continue
        }
        var alts: Vec<string> = []
        if f.len > 5 {
            for a in f[5].split(";") {
                let alt = a.trim()
                if alt.len > 0 {
                    alts.push(alt.toLower())
                }
            }
        }
        cities.push(City {
            name: f[0].clone(),
            state: f[1].clone(),
            lat: f[2].clone(),
            lon: f[3].clone(),
            key: f[0].toLower(),
            altKeys: alts,
        }
        )
    }
}

// Concatenated rather than built with jsonStringify({...}) because lat/lon must
// survive verbatim: jsonStringify formats floats with %g (6 significant digits),
// which silently truncates -122.2364 to -122.236. Passing the TSV's own text
// through keeps the coordinates exact.
pub fn cityJson(c: &City): string {
    let q = "\""
    var s = "{" + q + "name" + q + ":" + q + jsonEscapeStr(c.name) + q
    s = s + "," + q + "state" + q + ":" + q + c.state.clone() + q
    s = s + "," + q + "lat" + q + ":" + c.lat.clone()
    s = s + "," + q + "lon" + q + ":" + c.lon.clone() + "}"
    return s
}

// An empty state filter matches everything; otherwise the two-letter code must
// match exactly, so "Springfield, IL" can't return the Missouri one.
pub fn cityMatchesState(c: &City, stateQ: &string): bool {
    if stateQ.len == 0 {
        return true
    }
    return c.state.toLower() == stateQ
}

// Every whitespace-separated token must appear somewhere in the key, in any
// order. The Census name for a place is often not the name people type:
// "Emerald Hills" is what the residents and USPS call the CDP that GNIS (and
// therefore this TSV) records as "Emerald Lake Hills". The words are right,
// they're just not adjacent, so startsWith and contains both miss it. Runs
// only as a last backfill so the ranked passes above keep their ordering.
pub fn keyHasAllTokens(key: &string, q: &string): bool {
    var n = 0
    for t in q.split(" ") {
        let tok = t.trim()
        if tok.len == 0 {
            continue
        }
        if !key.contains(tok) {
            return false
        }
        n = n + 1
    }
    // A one-token query already had its shot in the contains pass; only a
    // multi-token query can find anything new here.
    return n > 1
}

// Each pass below runs over the display name and every alternate, so a place
// is reachable by any name it goes by while still rendering as one row.
pub fn cityStartsWith(c: &City, q: &string): bool {
    if c.key.startsWith(q) {
        return true
    }
    for k in c.altKeys {
        if k.startsWith(q) {
            return true
        }
    }
    return false
}

pub fn cityContains(c: &City, q: &string): bool {
    if c.key.contains(q) {
        return true
    }
    for k in c.altKeys {
        if k.contains(q) {
            return true
        }
    }
    return false
}

pub fn cityHasAllTokens(c: &City, q: &string): bool {
    if keyHasAllTokens(c.key, q) {
        return true
    }
    for k in c.altKeys {
        if keyHasAllTokens(k, q) {
            return true
        }
    }
    return false
}

// Typeahead over US place names. Nominatim is a geocoder, not a search index —
// it can't prefix-match ("red" never reaches Redwood City) — so the lookup that
// actually drives the search box lives here.
pub fn citiesHandler(ctx: &mut Context): Response {
    let raw = ((ctx.query("q") ?? "").trim()).toLower()
    if raw.len == 0 {
        return ctx.json("[]")
    }

    // Queries arrive in two shapes: a bare prefix as you type ("santa ro"), and
    // a full label ("Santa Rosa, CA"). The app writes the label form into ?q=
    // and into saved favorites, so it has to round-trip — matching the whole
    // label against a bare city name would find nothing.
    let parts = raw.split(",")
    let q = parts[0].trim()
    var stateQ = ""
    if parts.len > 1 {
        stateQ = parts[1].trim()
    }
    if q.len == 0 {
        return ctx.json("[]")
    }

    var out: Vec<string> = []
    // Prefix hits first; only backfill with interior matches if there's room,
    // so "red" ranks Redwood City above Coreopsis Red.
    for c in cities {
        if out.len >= MAX_SUGGESTIONS {
            break
        }
        if cityStartsWith(c, q) && cityMatchesState(c, stateQ) {
            out.push(cityJson(c))
        }
    }
    if out.len < MAX_SUGGESTIONS {
        for c in cities {
            if out.len >= MAX_SUGGESTIONS {
                break
            }
            if !cityStartsWith(c, q) && cityContains(c, q)
            && cityMatchesState(c, stateQ) {
                out.push(cityJson(c))
            }
        }
    }

    // Last resort: tokens present but not contiguous. Guarding on !contains(q)
    // is enough to exclude both passes above, since a prefix hit is also a
    // substring hit.
    if out.len < MAX_SUGGESTIONS {
        for c in cities {
            if out.len >= MAX_SUGGESTIONS {
                break
            }
            if !cityContains(c, q) && cityHasAllTokens(c, q)
            && cityMatchesState(c, stateQ) {
                out.push(cityJson(c))
            }
        }
    }

    var body = "["
    for i in 0..out.len {
        if i > 0 {
            body = body + ","
        }
        body = body + out[i]
    }
    body = body + "]"

    ctx.setHeader("Cache-Control", "public, max-age=600")
    return ctx.json(body)
}

// ── Upstream proxy ──
//
// Every forecast read the browser makes goes through this server instead of
// straight to weather.gov. Two reasons, and the second is the one that matters:
//
//   1. One cache serves every visitor. A direct-from-browser app asks the
//      provider once per tab per load; this asks once per feed per TTL no
//      matter how many people are watching.
//   2. It makes refreshing affordable. The page can re-read on focus without
//      that turning into traffic upstream, because a warm entry never leaves
//      this process.
//
// The TTL is the provider's own max-age, not a number we picked. weather.gov
// says 3570s; honouring that verbatim is the whole politeness story, and it
// also means we are never serving data staler than they intended.

pub struct CacheEntry {
    key: string,
    body: string,
    status: i32,
    expiresMs: i64,
}

// Module scope permits only a compile-time-constant initializer, hence the
// empty literal; entries accumulate as requests arrive.
pub var apiCache: Vec<CacheEntry> = []

// Bounds the process at a few MB of forecast JSON. Past this an expired entry
// is recycled before a new one is appended; if every entry is still live the
// oldest expiry loses, since it is the one closest to being refetched anyway.
pub let MAX_CACHE_ENTRIES = 256

// Fallback when the upstream sends no max-age. Ten minutes is short enough
// that a missing header cannot pin stale weather for an hour.
pub let DEFAULT_TTL_SECS: i64 = 600

pub let MIN_TTL_SECS: i64 = 60

pub let MAX_TTL_SECS: i64 = 3600

// weather.gov blocks anonymous clients and asks for a contact address in the
// User-Agent, so this is a hard requirement of talking to them, not a courtesy.
pub var contactUa: string = "milo-weather (https://github.com/milo-language/milo)"

// The only hosts this server will talk to. A short key rather than a URL in the
// query string: the client cannot name a host that is not on this list, so the
// proxy can never be pointed at an internal address.
pub fn upstreamBase(host: &string): string {
    if host == "nws" {
        return "https://api.weather.gov"
    }
    if host == "om" {
        return "https://api.open-meteo.com"
    }
    if host == "aq" {
        return "https://air-quality-api.open-meteo.com"
    }
    if host == "omarchive" {
        return "https://archive-api.open-meteo.com"
    }
    return ""
}

// The path is concatenated onto a fixed base, so the job here is to make sure it
// cannot escape that base. A leading "//" would turn the result into a new
// authority ("https:" + "//evil.host/x"), and "@" would smuggle one past a
// host-looking prefix. Everything outside the allowed set is rejected rather
// than escaped: no legitimate forecast path needs it.
pub fn isSafeUpstreamPath(p: &string): bool {
    if p.len == 0 || p.len > 512 {
        return false
    }
    if p[0] != '/' {
        return false
    }
    if p.startsWith("//") || p.contains("..") || p.contains("@") || p.contains("\\") {
        return false
    }
    for ch in p {
        let ok = (ch >= 'a' && ch <= 'z') || (ch >= 'A' && ch <= 'Z')
        || (ch >= '0' && ch <= '9') || ch == '/' || ch == '.' || ch == '_'
        || ch == '-' || ch == ',' || ch == '~' || ch == ':' || ch == '%'
        || ch == '?' || ch == '&' || ch == '=' || ch == '+'
        if !ok {
            return false
        }
    }
    return true
}

// Seconds from the upstream's Cache-Control, clamped. Clamping low stops a
// max-age=0 from making every page load a live request; clamping high stops a
// year-long max-age from pinning a forecast until the process restarts.
pub fn upstreamTtlSecs(headers: &string): i64 {
    let cc = findHeader(headers, "Cache-Control") ?? ""
    var ttl = DEFAULT_TTL_SECS
    // Split rather than scan: the tail after the first "max-age=" starts with
    // the digits we want, and anything else in the header ("public, s-maxage=…")
    // stops the digit run on its own.
    let parts = cc.split("max-age=")
    if parts.len > 1 {
        var digits = ""
        for ch in parts[1] {
            if ch < '0' || ch > '9' {
                break
            }
            digits.push(ch)
        }
        if digits.len > 0 {
            if let Option.Some(n) = parseInt(digits) {
                ttl = n
            }
        }
    }
    if ttl < MIN_TTL_SECS {
        return MIN_TTL_SECS
    }
    if ttl > MAX_TTL_SECS {
        return MAX_TTL_SECS
    }
    return ttl
}

// Index of `key` in the cache regardless of freshness. A stale hit is still
// useful: it is what gets served when the upstream is down.
pub fn cacheFind(key: &string): i64 {
    for i in 0..apiCache.len {
        if apiCache[i].key == key {
            return i
        }
    }
    return -1
}

pub fn cacheStore(key: &string, body: string, status: i32, expiresMs: i64): void {
    let at = cacheFind(key)
    if at >= 0 {
        apiCache[at].body = body
        apiCache[at].status = status
        apiCache[at].expiresMs = expiresMs
        return
    }
    if apiCache.len >= MAX_CACHE_ENTRIES {
        var victim: i64 = 0
        for i in 0..apiCache.len {
            if apiCache[i].expiresMs < apiCache[victim].expiresMs {
                victim = i
            }
        }
        apiCache[victim].key = key.clone()
        apiCache[victim].body = body
        apiCache[victim].status = status
        apiCache[victim].expiresMs = expiresMs
        return
    }
    apiCache.push(CacheEntry {
        key: key.clone(), body: body, status: status, expiresMs: expiresMs
    }
    )
}

// GET /api/up?h=<host key>&q=<path>
//
// `q` arrives percent-encoded and is decoded by the query parser, so the
// handler validates the decoded form — the only form that reaches the socket.
pub fn upstreamHandler(ctx: &mut Context): Response {
    let hostKey = ctx.query("h") ?? ""
    let path = ctx.query("q") ?? ""
    let base = upstreamBase(hostKey)
    if base.len == 0 || !isSafeUpstreamPath(path) {
        ctx.setStatus(400)
        return ctx.json("{\"error\":\"bad upstream request\"}")
    }

    let key = hostKey.clone() + path.clone()
    let nowMs = epochMillis()
    let at = cacheFind(key)
    if at >= 0 && apiCache[at].expiresMs > nowMs {
        let left = (apiCache[at].expiresMs - nowMs) / 1000
        ctx.setHeader("Cache-Control", "public, max-age=" + left.toString())
        ctx.setHeader("X-Cache", "hit")
        ctx.setStatus(apiCache[at].status)
        return ctx.json(apiCache[at].body.clone())
    }

    // Blocking, and the accept loop is single-threaded: a slow upstream stalls
    // every other client for the duration. The cache is what makes that
    // survivable — this runs once per feed per TTL, not once per request.
    var opts = FetchOptions {
        method: "GET",
        headers: "User-Agent: " + contactUa.clone() + "\r\nAccept: application/geo+json,application/json",
        body: "",
    }
    let url = base + path.clone()
    match fetchWith(url, opts) {
        Result.Ok(resp) => {
            if resp.status >= 200 && resp.status < 300 {
                let ttl = upstreamTtlSecs(resp.headers)
                cacheStore(key, resp.body.clone(), resp.status, nowMs + ttl * 1000)
                ctx.setHeader("Cache-Control", "public, max-age=" + ttl.toString())
                ctx.setHeader("X-Cache", "miss")
                return ctx.json(resp.body.clone())
            }
            // An upstream error must not evict good data: a 500 from weather.gov
            // is a worse answer than a forecast half an hour old.
            if at >= 0 {
                ctx.setHeader("Cache-Control", "public, max-age=60")
                ctx.setHeader("X-Cache", "stale")
                return ctx.json(apiCache[at].body.clone())
            }
            ctx.setStatus(502)
            return ctx.json("{\"error\":\"upstream " + resp.status.toString() + "\"}")
        }
        Result.Err(_) => {
            if at >= 0 {
                ctx.setHeader("Cache-Control", "public, max-age=60")
                ctx.setHeader("X-Cache", "stale")
                return ctx.json(apiCache[at].body.clone())
            }
            ctx.setStatus(502)
            return ctx.json("{\"error\":\"upstream unreachable\"}")
        }
    }
}

// no-store, not no-cache, on every embedded text asset: no-cache only promises
// revalidation, and revalidation needs an ETag or Last-Modified — which this
// server doesn't send. Chrome then reuses its cached copy and a deploy stays
// invisible. Costs a ~50KB refetch per visit; the service worker covers offline.
// Public origin+prefix, e.g. "https://chadsmith.dev/weather/". Only used to
// make og:image absolute, which the spec requires and crawlers enforce. It
// cannot be derived from the request: nginx proxies with a trailing slash, so
// the app never sees the /weather/ prefix, and it forwards no Host either.
// Empty means "omit og:image" rather than "guess and emit a broken one".
pub var publicUrl: string = ""

// The label is user-controlled text going into an HTML attribute, so quotes and
// angle brackets have to die before anything else happens to it. Ampersand
// first, or it would re-escape the escapes.
pub fn htmlAttrEscape(s: &string): string {
    var out = s.replace("&", "&amp;")
    out = out.replace("<", "&lt;")
    out = out.replace(">", "&gt;")
    out = out.replace("\"", "&quot;")
    out = out.replace("'", "&#39;")
    return out
}

// The place name a shared link is pointing at, or "" for the bare app. No
// length cap: escaping is what makes the value safe in an attribute, and every
// unfurler truncates a long title itself. Capping here would have to count code
// points, and a byte-offset cut lands inside a multibyte character.
pub fn shareLabel(ctx: &Context): string {
    let raw = (ctx.query("q") ?? "").trim()
    if raw.len == 0 {
        return ""
    }
    // Predates &ll= and still in bookmarks; it names no place to a recipient.
    if raw.toLower() == "current location" {
        return ""
    }
    return raw
}

// no-store, not no-cache, on every embedded text asset: no-cache only promises
// revalidation, and revalidation needs an ETag or Last-Modified — which this
// server doesn't send. Chrome then reuses its cached copy and a deploy stays
// invisible. Costs a ~50KB refetch per visit; the service worker covers offline.
pub fn indexHandler(ctx: &mut Context): Response {
    ctx.setHeader("Cache-Control", "no-store")
    let label = shareLabel(ctx)

    var pageTitle = "Weather by Milo"
    var ogTitle = "Weather"
    var ogDesc = "Current conditions, hourly and 7-day forecast for any US city."
    if label.len > 0 {
        let safe = htmlAttrEscape(label)
        pageTitle = safe.clone() + " Weather"
        ogTitle = safe.clone()
        ogDesc = "Current conditions, hourly and 7-day forecast for " + safe + "."
    }

    var ogImage = ""
    if publicUrl.len > 0 {
        ogImage = "<meta property=\"og:image\" content=\"" + publicUrl
        + "icons/icon-512.png\" />"
    }

    var page = @embedFile("public/index.html").replace("__PAGE_TITLE__", pageTitle)
    page = page.replace("__OG_TITLE__", ogTitle)
    page = page.replace("__OG_DESC__", ogDesc)
    page = page.replace("__OG_IMAGE__", ogImage)
    return ctx.html(page)
}

pub fn styleHandler(ctx: &mut Context): Response {
    ctx.setHeader("Cache-Control", "no-store")
    return Response.Status(200, "text/css; charset=utf-8", @embedFile("public/style.css"))
}

pub fn scriptHandler(ctx: &mut Context): Response {
    ctx.setHeader("Cache-Control", "no-store")
    return Response.Status(200, "application/javascript; charset=utf-8", @embedFile("public/app.js"))
}

pub fn radarScriptHandler(ctx: &mut Context): Response {
    ctx.setHeader("Cache-Control", "no-store")
    return Response.Status(200, "application/javascript; charset=utf-8", @embedFile("public/radar.js"))
}

pub fn adviceScriptHandler(ctx: &mut Context): Response {
    ctx.setHeader("Cache-Control", "no-store")
    return Response.Status(200, "application/javascript; charset=utf-8", @embedFile("public/advice.js"))
}

pub fn insightScriptHandler(ctx: &mut Context): Response {
    ctx.setHeader("Cache-Control", "no-store")
    return Response.Status(200, "application/javascript; charset=utf-8", @embedFile("public/insight.js"))
}

pub fn skyScriptHandler(ctx: &mut Context): Response {
    ctx.setHeader("Cache-Control", "no-store")
    return Response.Status(200, "application/javascript; charset=utf-8", @embedFile("public/sky.js"))
}

// Vendored satellite.js (MIT) for ISS pass prediction; loaded lazily by sky.js.
pub fn satLibHandler(ctx: &mut Context): Response {
    ctx.setHeader("Cache-Control", "no-store")
    return Response.Status(200, "application/javascript; charset=utf-8", @embedFile("public/satellite.min.js"))
}

pub fn manifestHandler(ctx: &mut Context): Response {
    ctx.setHeader("Cache-Control", "no-store")
    return Response.Status(200, "application/manifest+json; charset=utf-8", @embedFile("public/manifest.webmanifest"))
}

// Served from the app root so its scope covers every page, including under
// nginx's /weather/ prefix. Never cached: a stale worker pins a stale shell.
pub fn swHandler(ctx: &mut Context): Response {
    ctx.setHeader("Cache-Control", "no-store")
    return Response.Status(200, "application/javascript; charset=utf-8", @embedFile("public/sw.js"))
}

pub fn icon192Handler(ctx: &mut Context): Response {
    ctx.setHeader("Cache-Control", "public, max-age=604800")
    return Response.Status(200, "image/png", @embedFile("public/icons/icon-192.png"))
}

pub fn icon512Handler(ctx: &mut Context): Response {
    ctx.setHeader("Cache-Control", "public, max-age=604800")
    return Response.Status(200, "image/png", @embedFile("public/icons/icon-512.png"))
}

pub fn appleIconHandler(ctx: &mut Context): Response {
    ctx.setHeader("Cache-Control", "public, max-age=604800")
    return Response.Status(200, "image/png", @embedFile("public/icons/apple-touch-icon.png"))
}

pub fn healthHandler(ctx: &mut Context): Response {
    return ctx.json({
        status: "ok", app: "weather", cities: cities.len
    }
    )
}

pub fn logMiddleware(ctx: &mut Context, next: (&mut Context) => Response): Response {
    print($"{ctx.req.method} {ctx.req.path}")
    return next(ctx)
}

pub fn main(): i32 {
    var parser = ArgParser.new("weather", "Weather app powered by weather.gov")
    parser.addI64("port", "p", "port to listen on", 3000)
    parser.addString("public-url", "u", "public origin and path prefix, for og:image", "")
    // weather.gov rejects anonymous clients, so the operator has to be
    // reachable; the default names the project rather than a person.
    parser.addString("contact", "c", "contact string for the upstream User-Agent", "")
    let args = parser.parse()
    let port = args.getU16("port")
    publicUrl = args.getString("public-url") ?? ""
    let contact = args.getString("contact") ?? ""
    if contact.len > 0 {
        contactUa = "milo-weather (" + contact + ")"
    }
    // og:image must be absolute, so a prefix without its trailing slash would
    // concatenate into a 404 that no unfurler reports back.
    if publicUrl.len > 0 && !publicUrl.endsWith("/") {
        publicUrl = publicUrl + "/"
    }

    loadCities()
    print($"Weather App (Milo) — {cities.len} US places indexed")

    var r: Router = Router.new()
    r.use(logMiddleware)
    r.get("/", indexHandler)
    r.get("/index.html", indexHandler)
    r.get("/style.css", styleHandler)
    r.get("/app.js", scriptHandler)
    r.get("/radar.js", radarScriptHandler)
    r.get("/sky.js", skyScriptHandler)
    r.get("/advice.js", adviceScriptHandler)
    r.get("/insight.js", insightScriptHandler)
    r.get("/satellite.min.js", satLibHandler)
    r.get("/api/cities", citiesHandler)
    r.get("/api/up", upstreamHandler)
    r.get("/manifest.webmanifest", manifestHandler)
    r.get("/sw.js", swHandler)
    r.get("/icons/icon-192.png", icon192Handler)
    r.get("/icons/icon-512.png", icon512Handler)
    r.get("/icons/apple-touch-icon.png", appleIconHandler)
    r.get("/healthz", healthHandler)

    if let Result.Err(msg) = serveRouter(port, r) {
        print($"error: {msg}")
        return 1
    }
    return 0
}
