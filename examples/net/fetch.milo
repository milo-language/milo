// Fetch data from an HTTP API and parse the JSON response.
//
// The response is a Result, so the failure has to be handled — but reading a
// nested field out of the body is one `strPath` call, and `??` supplies the
// default instead of a match arm per level.
from "std/fetch" import {
    fetch
}

pub fn main(): i32 {
    let resp = fetch("https://httpbin.org/get")
    match resp {
        Ok(r) => {
            print("status: ", r.status)
            let data = r.json()
            print("origin: ", data.strPath("origin") ?? "(none)")
            print("host: ", data.strPath("headers.Host") ?? "(none)")
            print("url: ", data.strPath("url") ?? "(none)")
        }
        Err(msg) => {
            print("error: ", msg)
        }
    }

    return 0
}
