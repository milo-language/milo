// The smallest traced program: one function, two requirements, one test file.

// The heater command for a reading, given a target temperature (both in tenths of a degree).
@req(R-1)
@req(R-2)
pub fn heaterPercent(reading: i32, target: i32): i32
requires reading >= -1000 && reading <= 2000
requires target >= 0 && target <= 1000
@req(R-1) ensures result >= 0 && result <= 100
@req(R-2) ensures reading >= target ==> result == 0
{
    if reading >= target {
        return 0
    }
    let gap = target - reading
    if gap >= 100 {
        return 100
    }
    return gap
}

@derived(R-1)
pub fn main(): i32 {
    print(heaterPercent(150, 200))
    return 0
}
