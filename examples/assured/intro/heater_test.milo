from "./heater" import { heaterPercent, demoCommand }

@req(R-1)
fn testCommandStaysInRange() {
    assert(heaterPercent(-1000, 1000) == 100)
    assert(heaterPercent(199, 200) == 1)
}

@req(R-2)
fn testAtTargetTurnsOff() {
    assert(heaterPercent(200, 200) == 0)
    assert(heaterPercent(500, 200) == 0)
}

@req(D-1)
fn testDemoPrintsHalfPower() {
    assert(demoCommand() == 50)
}
