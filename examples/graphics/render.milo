// Offline path tracer: one physically based still, rendered across every core.
//
//   milo run examples/graphics/render.milo --release                 # 1600x900, 128 spp
//   milo run examples/graphics/render.milo --release -- 800 450 32   # quick preview
//
// Glass (Snell refraction with Schlick's Fresnel), metal with roughness, diffuse
// surfaces and a sky that lights everything, plus a thin-lens camera for depth of
// field. Every pixel is a Monte-Carlo estimate of the rendering equation; soft
// shadows, caustic-ish glass highlights and colour bleeding all fall out of it.
//
// The pixel buffer is divided by OWNERSHIP with std/shard: each worker owns a band
// of pixels outright, so there is no lock and no shared mutable state. The scene is
// an immutable global every worker reads. The PNG is encoded by std/png, so the whole
// program is Milo from ray to file.
from "std/shard" import {
    Shard, parallelMap
}
from "std/png" import {
    encodePng
}
from "std/fs" import {
    writeFile
}
from "std/time" import {
    epochMillis
}
from "std/args" import {
    args
}
from "std/strconv" import {
    parseInt
}
from "std/math" import {
    Math
}

pub struct Vec3 {
    x: f64,
    y: f64,
    z: f64,
}

fn v3(x: f64, y: f64, z: f64): Vec3 {
    return Vec3 { x: x, y: y, z: z }
}

fn add(a: Vec3, b: Vec3): Vec3 {
    return v3(a.x + b.x, a.y + b.y, a.z + b.z)
}

fn sub(a: Vec3, b: Vec3): Vec3 {
    return v3(a.x - b.x, a.y - b.y, a.z - b.z)
}

fn scale(a: Vec3, s: f64): Vec3 {
    return v3(a.x * s, a.y * s, a.z * s)
}

fn mul(a: Vec3, b: Vec3): Vec3 {
    return v3(a.x * b.x, a.y * b.y, a.z * b.z)
}

fn dot(a: Vec3, b: Vec3): f64 {
    return a.x * b.x + a.y * b.y + a.z * b.z
}

fn cross(a: Vec3, b: Vec3): Vec3 {
    return v3(a.y * b.z - a.z * b.y, a.z * b.x - a.x * b.z, a.x * b.y - a.y * b.x)
}

fn norm(a: Vec3): Vec3 {
    return scale(a, 1.0 / Math.sqrt(dot(a, a)))
}

let DIFFUSE: i64 = 0
let METAL: i64 = 1
let GLASS: i64 = 2

pub struct Sphere {
    c: Vec3,
    r: f64,
    albedo: Vec3,
    mat: i64,
    param: f64, // metal: roughness; glass: index of refraction
}

// xorshift64*: each worker seeds its own from its window, so bands are independent.
@wrapping
fn rnd(s: &mut u64): f64 {
    var x = s
    x ^= x >> 12
    x ^= x << 25
    x ^= x >> 27
    s = x
    let r = (x * 2685821657736338717) >> 11
    return (r as f64) * (1.0 / 9007199254740992.0)
}

fn inUnitSphere(s: &mut u64): Vec3 {
    while true {
        let p = v3(rnd(&mut s) * 2.0 - 1.0, rnd(&mut s) * 2.0 - 1.0, rnd(&mut s) * 2.0 - 1.0)
        if dot(p, p) < 1.0 {
            return p
        }
    }
    return v3(0.0, 0.0, 0.0)
}

fn inUnitDisk(s: &mut u64): Vec3 {
    while true {
        let p = v3(rnd(&mut s) * 2.0 - 1.0, rnd(&mut s) * 2.0 - 1.0, 0.0)
        if dot(p, p) < 1.0 {
            return p
        }
    }
    return v3(0.0, 0.0, 0.0)
}

fn reflect(d: Vec3, n: Vec3): Vec3 {
    return sub(d, scale(n, 2.0 * dot(d, n)))
}

// Schlick's approximation to the Fresnel reflectance of a dielectric.
fn schlick(cosine: f64, ratio: f64): f64 {
    var r0 = (1.0 - ratio) / (1.0 + ratio)
    r0 = r0 * r0
    let m = 1.0 - cosine
    return r0 + (1.0 - r0) * m * m * m * m * m
}

// Deterministic pseudo-random layout, so the scene is identical on every run.
@wrapping
fn hash01(i: i64): f64 {
    var x = (i as u64) * 0x9E3779B97F4A7C15 + 0x632BE59BD9B4E019
    x ^= x >> 31
    x = x * 0xBF58476D1CE4E5B9
    x ^= x >> 29
    return ((x >> 11) as f64) * (1.0 / 9007199254740992.0)
}

fn buildScene(): Vec<Sphere> {
    var s: Vec<Sphere> = Vec.new()
    s.push(Sphere { c: v3(0.0, -1000.0, 0.0), r: 1000.0, albedo: v3(0.38, 0.34, 0.3), mat: DIFFUSE, param: 0.0 })
    s.push(Sphere { c: v3(0.0, 1.0, 0.0), r: 1.0, albedo: v3(1.0, 1.0, 1.0), mat: GLASS, param: 1.5 })
    s.push(Sphere { c: v3(-4.0, 1.0, 0.0), r: 1.0, albedo: v3(0.72, 0.22, 0.12), mat: DIFFUSE, param: 0.0 })
    s.push(Sphere { c: v3(4.0, 1.0, 0.0), r: 1.0, albedo: v3(0.95, 0.76, 0.42), mat: METAL, param: 0.02 })
    // Saturated small spheres: a palette, not random RGB, so the frame reads as designed.
    var palette: Vec<Vec3> = Vec.new()
    palette.push(v3(0.90, 0.30, 0.20))
    palette.push(v3(0.95, 0.65, 0.15))
    palette.push(v3(0.20, 0.60, 0.85))
    palette.push(v3(0.25, 0.70, 0.45))
    palette.push(v3(0.60, 0.35, 0.80))
    palette.push(v3(0.95, 0.90, 0.85))
    var k: i64 = 0
    var a: i64 = -6
    while a < 6 {
        var b: i64 = -6
        while b < 6 {
            let c = v3((a as f64) + 0.8 * hash01(k), 0.2, (b as f64) + 0.8 * hash01(k + 1))
            let pick = hash01(k + 2)
            k += 3
            let clear = dot(sub(c, v3(4.0, 0.2, 0.0)), sub(c, v3(4.0, 0.2, 0.0))) > 1.2
            && dot(sub(c, v3(0.0, 0.2, 0.0)), sub(c, v3(0.0, 0.2, 0.0))) > 1.2
            && dot(sub(c, v3(-4.0, 0.2, 0.0)), sub(c, v3(-4.0, 0.2, 0.0))) > 1.2
            if clear {
                let col = palette[(hash01(k) * 6.0) as i64 % 6]
                k += 1
                if pick < 0.62 {
                    s.push(Sphere { c: c, r: 0.2, albedo: col, mat: DIFFUSE, param: 0.0 })
                } else if pick < 0.86 {
                    s.push(Sphere { c: c, r: 0.2, albedo: scale(add(col, v3(1.0, 1.0, 1.0)), 0.5), mat: METAL, param: 0.3 * hash01(k) })
                } else {
                    s.push(Sphere { c: c, r: 0.2, albedo: v3(1.0, 1.0, 1.0), mat: GLASS, param: 1.5 })
                }
            }
            b += 1
        }
        a += 1
    }
    return s
}

let SCENE: Vec<Sphere> = buildScene()

// Low warm sun from the camera's left, plus a sky dome as fill. The sun is sampled
// directly at every diffuse hit (a shadow ray toward it) instead of waiting for a
// random bounce to find a disk that small, which is what keeps its shadows clean.
let SUN_DIR: Vec3 = norm(v3(0.5, 0.3, 1.0))
let SUN_COS: f64 = 0.9993 // angular radius about 2.1 degrees: soft shadow edges
let SUN_RGB: Vec3 = v3(2.6, 1.95, 1.3)

fn sky(d: Vec3): Vec3 {
    // Keyed on elevation, not the full sphere: the camera looks along the horizon, and
    // a symmetric blend left the whole background one flat midtone.
    let t = Math.sqrt(Math.maxF64(norm(d).y, 0.0))
    let horizon = v3(0.95, 0.58, 0.38)
    let zenith = v3(0.12, 0.22, 0.55)
    return add(scale(horizon, 1.0 - t), scale(zenith, t))
}

// A direction inside the sun's disk, so shadow edges come out soft.
fn sunSample(s: &mut u64): Vec3 {
    let j = scale(inUnitSphere(&mut s), 0.035)
    return norm(add(SUN_DIR, j))
}

// Fraction of sunlight reaching p: 0 behind anything opaque. Glass passes most of it,
// a cheap stand-in for the caustic a real light transport solve would find.
fn sunVisible(p: Vec3, l: Vec3): f64 {
    var vis = 1.0
    var i: i64 = 0
    while i < SCENE.len {
        let sp = SCENE[i]
        let oc = sub(p, sp.c)
        let hb = dot(oc, l)
        let c = dot(oc, oc) - sp.r * sp.r
        let disc = hb * hb - c
        if disc > 0.0 {
            let t = -hb + Math.sqrt(disc)
            if t > 0.001 {
                if sp.mat == GLASS {
                    vis = vis * 0.7
                } else {
                    return 0.0
                }
            }
        }
        i += 1
    }
    return vis
}

fn radiance(ro0: Vec3, rd0: Vec3, s: &mut u64): Vec3 {
    var ro = ro0
    var rd = rd0
    var through = v3(1.0, 1.0, 1.0)
    var color = v3(0.0, 0.0, 0.0)
    // The sun reaches diffuse surfaces only through direct sampling; a ray that finds
    // it after a diffuse bounce must not count it again.
    var specular = true
    var depth: i64 = 0
    while depth < 12 {
        var tBest = 1.0e30
        var hit: i64 = -1
        var i: i64 = 0
        while i < SCENE.len {
            let sp = SCENE[i]
            let oc = sub(ro, sp.c)
            let hb = dot(oc, rd)
            let c = dot(oc, oc) - sp.r * sp.r
            let disc = hb * hb - c
            if disc > 0.0 {
                let sq = Math.sqrt(disc)
                var t = -hb - sq
                if t < 0.001 {
                    t = -hb + sq
                }
                if t > 0.001 && t < tBest {
                    tBest = t
                    hit = i
                }
            }
            i += 1
        }
        if hit < 0 {
            var env = sky(rd)
            if specular && dot(norm(rd), SUN_DIR) > SUN_COS {
                env = add(env, scale(SUN_RGB, 12.0))
            }
            return add(color, mul(through, env))
        }
        let sp = SCENE[hit]
        let p = add(ro, scale(rd, tBest))
        let outward = scale(sub(p, sp.c), 1.0 / sp.r)
        let front = dot(rd, outward) < 0.0
        var n = outward
        if !front {
            n = scale(outward, -1.0)
        }
        ro = p
        if sp.mat == DIFFUSE {
            let l = sunSample(&mut s)
            let cosL = dot(n, l)
            if cosL > 0.0 {
                let vis = sunVisible(p, l)
                if vis > 0.0 {
                    color = add(color, scale(mul(mul(through, sp.albedo), SUN_RGB), cosL * vis))
                }
            }
            rd = norm(add(n, norm(inUnitSphere(&mut s))))
            specular = false
        } else if sp.mat == METAL {
            rd = norm(add(reflect(rd, n), scale(inUnitSphere(&mut s), sp.param)))
            if dot(rd, n) <= 0.0 {
                return color
            }
            specular = sp.param < 0.1
        } else {
            var ratio = sp.param
            if front {
                ratio = 1.0 / sp.param
            }
            let cosT = Math.minF64(dot(scale(rd, -1.0), n), 1.0)
            let sinT = Math.sqrt(1.0 - cosT * cosT)
            if ratio * sinT > 1.0 || schlick(cosT, ratio) > rnd(&mut s) {
                rd = reflect(rd, n)
            } else {
                let perp = scale(add(rd, scale(n, cosT)), ratio)
                let par = scale(n, -Math.sqrt(Math.abs(1.0 - dot(perp, perp))))
                rd = norm(add(perp, par))
            }
        }
        through = mul(through, sp.albedo)
        // Russian roulette past a few bounces: unbiased, and it stops paying for
        // paths that can no longer contribute much.
        if depth > 3 {
            let q = Math.maxF64(through.x, Math.maxF64(through.y, through.z))
            if rnd(&mut s) > q {
                return color
            }
            through = scale(through, 1.0 / q)
        }
        depth += 1
    }
    return color
}

var W: i64 = 1600
var H: i64 = 900
var SPP: i64 = 128

// ACES filmic curve (Narkowicz fit): keeps highlights from clipping to flat white.
fn aces(x: f64): f64 {
    let v = (x * (2.51 * x + 0.03)) / (x * (2.43 * x + 0.59) + 0.14)
    return Math.minF64(Math.maxF64(v, 0.0), 1.0)
}

fn toByte(linear: f64): u32 {
    return (Math.pow(aces(linear * 0.62), 1.0 / 2.2) * 255.0 + 0.5) as u32
}

@wrapping
fn mixSeed(i: i64): u64 {
    return ((i as u64) + 1) * 0x9E3779B97F4A7C15
}

fn renderBand(w: Shard<u32>): Shard<u32> {
    let width = W
    let height = H
    let spp = SPP
    let from = v3(13.0, 2.0, 3.0)
    let at = v3(0.0, 0.5, 0.0)
    // Focus on the gold sphere, the frame's subject; the rest falls off with distance.
    let focus = Math.sqrt(dot(sub(from, v3(4.0, 1.0, 0.0)), sub(from, v3(4.0, 1.0, 0.0))))
    let aperture = 0.12
    let theta = 20.0 * 3.141592653589793 / 180.0
    let hh = Math.tan(theta / 2.0)
    let hw = hh * (width as f64) / (height as f64)
    let ww = norm(sub(from, at))
    let uu = norm(cross(v3(0.0, 1.0, 0.0), ww))
    let vv = cross(ww, uu)
    var seed: u64 = mixSeed(w.start())
    let base = w.start()
    for i in 0..w.len() {
        let px = (base + i) % width
        let py = (base + i) / width
        var acc = v3(0.0, 0.0, 0.0)
        var n: i64 = 0
        while n < spp {
            let u = ((px as f64) + rnd(&mut seed)) / (width as f64) * 2.0 - 1.0
            let v = 1.0 - ((py as f64) + rnd(&mut seed)) / (height as f64) * 2.0
            let lens = scale(inUnitDisk(&mut seed), aperture / 2.0)
            let off = add(scale(uu, lens.x), scale(vv, lens.y))
            let target = add(from, scale(sub(add(scale(uu, u * hw), scale(vv, v * hh)), ww), focus))
            let o = add(from, off)
            acc = add(acc, radiance(o, norm(sub(target, o)), &mut seed))
            n += 1
        }
        let c = scale(acc, 1.0 / (spp as f64))
        w.set(i, toByte(c.x) | (toByte(c.y) << 8) | (toByte(c.z) << 16) | (255 << 24))
    }
    return w
}

pub fn main(): i32 {
    let argv = args()
    if argv.len > 3 {
        W = parseInt(argv[1].clone()) ?? 1600
        H = parseInt(argv[2].clone()) ?? 900
        SPP = parseInt(argv[3].clone()) ?? 128
    }
    var pixels: Vec<u32> = Vec.withCapacity(W * H)
    for _ in 0..W * H {
        pixels.push(0)
    }
    let t0 = epochMillis()
    // Many more bands than cores: rows near the glass sphere cost far more than sky
    // rows, and small bands keep every core busy until the end.
    let out = parallelMap(pixels, 256, renderBand)
    let ms = epochMillis() - t0
    var raw: string = ""
    for px in out {
        raw.push((px & 255) as u8)
        raw.push(((px >> 8) & 255) as u8)
        raw.push(((px >> 16) & 255) as u8)
        raw.push(((px >> 24) & 255) as u8)
    }
    writeFile("render.png", encodePng(raw, W, H, 4)!)!
    print($"{W}x{H}, {SPP} samples per pixel, {SCENE.len} spheres: {ms} ms -> render.png")
    return 0
}
