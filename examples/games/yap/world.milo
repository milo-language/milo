// Simulation: one dog, a queue of fire hydrants, and gravity.
//
// The whole game is a single ballistic arc interrupted by a key press, so all
// the feel lives in three numbers — GRAVITY, FLAP and the gap between hydrants —
// and in the two forgiveness rules further down: the hitbox is smaller than the
// dog, and a hydrant only counts as passed once its centre is behind him.
//
// Nothing in this file is unsafe and nothing in it touches SDL.

from "std/math" import {
    Math
}
from "std/random" import {
    Random
}

// ── tuning ────────────────────────────────────────────────────────────────────

pub let GROUND_Y: f64 = 618.0

pub let CEILING_Y: f64 = 8.0

pub let GRAVITY: f64 = 1450.0

// The upward velocity a flap *sets* — not adds, so a panicked mash cannot stack
// into escape velocity.
pub let FLAP: f64 = 455.0

pub let MAX_FALL: f64 = 700.0

pub let DOG_X: f64 = 340.0

// The hitbox is a good deal smaller than the sprite: ears and tail are drawn
// outside it on purpose. A near miss that clips the ear fur reads as skill, and
// a near miss that kills you reads as a bug.
pub let HIT_HW: f64 = 22.0

pub let HIT_HH: f64 = 16.0

pub let POST_HW: f64 = 52.0

pub let SPACING: f64 = 470.0

pub let SCROLL0: f64 = 205.0

pub let GAP0: f64 = 352.0

pub let BONE_R: f64 = 48.0

pub let ST_READY: i64 = 0

pub let ST_PLAY: i64 = 1

pub let ST_FALL: i64 = 2 // hit something, tumbling toward the ground

pub let ST_OVER: i64 = 3

// ── entities ──────────────────────────────────────────────────────────────────

pub struct Gate {
    x: f64, // centre of the hydrant column
    gapY: f64,
    gap: f64,
    passed: bool,
    bone: bool,
    boneTaken: bool,
}

pub struct Part {
    x: f64,
    y: f64,
    vx: f64,
    vy: f64,
    life: f64,
    max: f64,
    r: f64,
    g: f64,
    b: f64,
    size: f64,
    grav: f64,
}

pub struct World {
    y: f64, // dog centre
    vy: f64,
    spin: f64, // tumble phase while falling, drives the flip in render
    state: i64,
    t: f64,
    flapT: f64, // seconds since the last flap, drives the ear frame
    bobT: f64,
    gates: Vec<Gate>,
    parts: Vec<Part>,
    score: i64,
    best: i64,
    treats: i64,
    runs: i64,
    nextPraise: i64,
    scroll: f64,
    groundX: f64, // scrolled grass offset, kept separate so it never resets
    shake: f64,
    flash: f64,
    overT: f64, // input lockout after death, so the death press cannot restart
    toast: string,
    toastT: f64,
    vw: f64,
    vh: f64,
    evFlap: bool,
    evScore: bool,
    evTreat: bool,
    evHit: bool,
    evThud: bool,
}

pub fn worldNew(vw: f64, vh: f64): World {
    var w = World {
        y: 300.0, vy: 0.0, spin: 0.0,
        state: ST_READY, t: 0.0, flapT: 9.0, bobT: 0.0,
        gates: Vec.new(), parts: Vec.new(),
        score: 0, best: 0, treats: 0, runs: 0, nextPraise: 10,
        scroll: SCROLL0, groundX: 0.0,
        shake: 0.0, flash: 0.0, overT: 0.0,
        toast: "", toastT: 0.0,
        vw: vw, vh: vh,
        evFlap: false, evScore: false, evTreat: false, evHit: false, evThud: false,
    }
    return w
}

// Reset for another run. `best` and `runs` survive, everything else does not.
pub fn worldReset(w: &mut World) {
    w.y = 300.0
    w.vy = 0.0
    w.spin = 0.0
    w.state = ST_READY
    w.flapT = 9.0
    w.score = 0
    w.treats = 0
    w.nextPraise = 10
    w.scroll = SCROLL0
    w.shake = 0.0
    w.flash = 0.0
    w.overT = 0.0
    w.toast = ""
    w.toastT = 0.0
    w.gates = Vec.new()
    w.parts = Vec.new()
}

// ── particles ─────────────────────────────────────────────────────────────────

fn puff(w: &mut World, x: f64, y: f64, n: i64, spread: f64, r: f64, g: f64, b: f64, size: f64, grav: f64) {
    for i in 0..n {
        let life = Random.floatRange(0.20, 0.50)
        let pt = Part {
            x: x, y: y,
            vx: Random.floatRange(0.0 - spread, spread),
            vy: Random.floatRange(0.0 - spread, spread * 0.5),
            life: life, max: life,
            r: r, g: g, b: b,
            size: size * Random.floatRange(0.6, 1.4),
            grav: grav,
        }
        w.parts.push(pt)
    }
}

fn burst(w: &mut World, x: f64, y: f64, n: i64, speed: f64, r: f64, g: f64, b: f64) {
    for i in 0..n {
        let a = Random.floatRange(0.0, 6.2831853)
        let s = Random.floatRange(speed * 0.35, speed)
        let life = Random.floatRange(0.30, 0.70)
        let pt = Part {
            x: x, y: y,
            vx: Math.cos(a) * s, vy: Math.sin(a) * s,
            life: life, max: life,
            r: r, g: g, b: b,
            size: Random.floatRange(1.8, 3.6),
            grav: 420.0,
        }
        w.parts.push(pt)
    }
}

fn stepParts(w: &mut World, dt: f64) {
    var i = 0
    while i < w.parts.len {
        w.parts[i].life -= dt
        if w.parts[i].life <= 0.0 {
            let _ = w.parts.remove(i)
        } else {
            w.parts[i].vy = w.parts[i].vy + w.parts[i].grav * dt
            w.parts[i].x = w.parts[i].x + w.parts[i].vx * dt - w.scroll * dt * 0.25
            w.parts[i].y = w.parts[i].y + w.parts[i].vy * dt
            i += 1
        }
    }
}

// ── hydrants ──────────────────────────────────────────────────────────────────

// Difficulty is one curve, read off the score: the gap closes and the world
// speeds up together, and both stop moving well before they get unfair.
fn gapFor(score: i64): f64 {
    var g = GAP0 - (score as f64) * 1.4
    if g < 268.0 {
        g = 268.0
    }
    return g
}

fn scrollFor(score: i64): f64 {
    var s = SCROLL0 + (score as f64) * 2.0
    if s > 300.0 {
        s = 300.0
    }
    return s
}

fn spawnGate(w: &mut World, x: f64) {
    let gap = gapFor(w.score)
    let lo = 72.0 + gap * 0.5
    let hi = GROUND_Y - 64.0 - gap * 0.5
    let g = Gate {
        x: x,
        gapY: Random.floatRange(lo, hi),
        gap: gap,
        passed: false,
        // A treat on most gates but not all: the ones without are where the
        // player stops flying to the bone and starts flying to the gap.
        bone: Random.float() < 0.62,
        boneTaken: false,
    }
    w.gates.push(g)
}

fn stepGates(w: &mut World, dt: f64) {
    var i = 0
    while i < w.gates.len {
        w.gates[i].x = w.gates[i].x - w.scroll * dt
        if w.gates[i].x < 0.0 - 140.0 {
            let _ = w.gates.remove(i)
        } else {
            i += 1
        }
    }
    var far = 0.0 - 1.0e9
    for g in w.gates {
        if g.x > far {
            far = g.x
        }
    }
    if w.gates.len == 0 {
        spawnGate(&mut w, w.vw + 220.0)
    } else {
        if far < w.vw + SPACING {
            spawnGate(&mut w, far + SPACING)
        }
    }
}

// ── the run ───────────────────────────────────────────────────────────────────

fn praise(w: &mut World) {
    let n = Random.range(0, 5)
    var s = "GOOD BOY"
    if n == 1 {
        s = "WHO IS A GOOD BOY"
    }
    if n == 2 {
        s = "SUCH FLY"
    }
    if n == 3 {
        s = "VERY EAR"
    }
    if n == 4 {
        s = "SMALL DOG BIG SKY"
    }
    w.toast = s
    w.toastT = 1.9
}

pub fn flap(w: &mut World) {
    if w.state == ST_READY {
        w.state = ST_PLAY
    }
    if w.state != ST_PLAY {
        return
    }
    w.vy = 0.0 - FLAP
    w.flapT = 0.0
    w.evFlap = true
    puff(&mut w, DOG_X - 40.0, w.y + 6.0, 5, 80.0, 0.30, 0.26, 0.20, 3.0, 200.0)
}

fn die(w: &mut World, hitX: f64, hitY: f64) {
    w.state = ST_FALL
    w.evHit = true
    w.shake = 16.0
    w.flash = 0.55
    w.spin = 0.0
    // A dead dog still has the momentum he died with, plus a kick away from
    // whatever he hit — falling straight down out of a collision looks like the
    // game stopped rather than like an impact.
    if w.vy < 0.0 {
        w.vy *= 0.3
    }
    w.vy -= 120.0
    burst(&mut w, hitX, hitY, 16, 340.0, 0.90, 0.55, 0.30)
    if w.score > w.best {
        w.best = w.score
    }
}

fn overlapsGate(w: &World, g: &Gate): bool {
    let dx = Math.abs(g.x - DOG_X)
    if dx > POST_HW + HIT_HW {
        return false
    }
    let top = g.gapY - g.gap * 0.5
    let bot = g.gapY + g.gap * 0.5
    return w.y - HIT_HH < top || w.y + HIT_HH > bot
}

fn checkGates(w: &mut World) {
    var hitX = 0.0
    var hitY = 0.0
    var hit = false
    var scored = 0
    var treat = false
    var treatX = 0.0
    var treatY = 0.0

    var i = 0
    while i < w.gates.len {
        if !w.gates[i].boneTaken && w.gates[i].bone {
            let dx = w.gates[i].x - DOG_X
            let dy = w.gates[i].gapY - w.y
            if Math.sqrt(dx * dx + dy * dy) < BONE_R + 18.0 {
                w.gates[i].boneTaken = true
                treat = true
                treatX = w.gates[i].x
                treatY = w.gates[i].gapY
            }
        }
        if !w.gates[i].passed && w.gates[i].x < DOG_X {
            w.gates[i].passed = true
            scored += 1
        }
        if !hit && overlapsGate(w, w.gates[i]) {
            hit = true
            hitX = w.gates[i].x - POST_HW
            hitY = w.y
        }
        i += 1
    }

    if treat {
        w.treats += 1
        w.score += 3
        w.evTreat = true
        w.flash = 0.18
        burst(&mut w, treatX, treatY, 14, 260.0, 1.20, 1.10, 0.70)
    }
    if scored > 0 {
        w.score += scored
        w.evScore = true
    }
    if w.score >= w.nextPraise {
        w.nextPraise += 10
        praise(&mut w)
    }
    if hit {
        die(&mut w, hitX, hitY)
    }
}

pub fn worldUpdate(w: &mut World, dt: f64) {
    w.evFlap = false
    w.evScore = false
    w.evTreat = false
    w.evHit = false
    w.evThud = false

    w.t += dt
    w.flapT += dt
    w.shake *= Math.pow(0.0015, dt)
    w.flash *= Math.pow(0.0009, dt)
    if w.toastT > 0.0 {
        w.toastT -= dt
    }
    stepParts(&mut w, dt)

    if w.state == ST_READY {
        // Idle bob. The dog is already airborne, so the pose the player sees
        // first is the pose the controls produce.
        w.bobT += dt
        w.y = 300.0 + Math.sin(w.bobT * 3.4) * 14.0
        w.vy = 0.0
        w.groundX = w.groundX + w.scroll * dt * 0.55
        stepGates(&mut w, dt)
        return
    }

    if w.state == ST_PLAY {
        w.scroll = scrollFor(w.score)
        w.groundX = w.groundX + w.scroll * dt
        w.vy = w.vy + GRAVITY * dt
        if w.vy > MAX_FALL {
            w.vy = MAX_FALL
        }
        w.y = w.y + w.vy * dt
        if w.y - HIT_HH < CEILING_Y {
            // The sky is a wall, not a kill: bonking it costs height and pride.
            w.y = CEILING_Y + HIT_HH
            if w.vy < 0.0 {
                w.vy = 60.0
            }
        }
        stepGates(&mut w, dt)
        checkGates(&mut w)
        if w.state == ST_PLAY && w.y + HIT_HH >= GROUND_Y {
            w.y = GROUND_Y - HIT_HH
            die(&mut w, DOG_X, GROUND_Y - 20.0)
            w.state = ST_FALL
        }
        return
    }

    if w.state == ST_FALL {
        w.vy = w.vy + GRAVITY * 1.35 * dt
        if w.vy > MAX_FALL {
            w.vy = MAX_FALL
        }
        w.y = w.y + w.vy * dt
        w.spin = w.spin + dt * 9.0
        if w.y + HIT_HH >= GROUND_Y {
            w.y = GROUND_Y - HIT_HH
            w.state = ST_OVER
            w.overT = 0.55
            w.runs += 1
            w.evThud = true
            w.shake = 11.0
            puff(&mut w, DOG_X, GROUND_Y - 6.0, 14, 190.0, 0.35, 0.30, 0.18, 4.5, 240.0)
        }
        return
    }

    if w.overT > 0.0 {
        w.overT -= dt
    }
}

// True once the game-over card will accept a key.
pub fn canRestart(w: &World): bool {
    return w.state == ST_OVER && w.overT <= 0.0
}
