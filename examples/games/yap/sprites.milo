// Every sprite in the game, built at startup: no asset directory, no loader.
// The frames are pixel art written as strings, one character per pixel.
//
// A palette entry is three floats of linear light and values run past 1.0 on
// purpose — the collar and the tongue clear the bloom threshold and glow, the
// fur beside them does not. That is the whole reason the art is authored in
// linear light instead of in 8-bit colour.

from "./gfx" import {
    Sprite, spriteNew, spriteSet
}

// ── string art ────────────────────────────────────────────────────────────────
//
// '.' is transparent, '0'-'9' index the palette. Rows need not be padded —
// anything short is transparent to the right — so a frame only spells out the
// pixels it actually uses, and the ears can stick out past the body.

fn palAdd(p: &mut Vec<f64>, r: f64, g: f64, b: f64) {
    p.push(r)
    p.push(g)
    p.push(b)
}

fn charAt(rows: &Vec<string>, r: i64, c: i64): i64 {
    if c >= rows[r].len {
        return 46 // '.'
    }
    return rows[r][c] as i64
}

fn widest(rows: &Vec<string>): i64 {
    var w = 0
    for r in rows {
        if r.len > w {
            w = r.len
        }
    }
    return w
}

fn spriteFrom(rows: &Vec<string>, pal: &Vec<f64>): Sprite {
    let w = widest(rows)
    let h = rows.len
    var s = spriteNew(w, h)
    for y in 0..h {
        for x in 0..w {
            let ch = charAt(rows, y, x)
            if ch >= 48 && ch <= 57 {
                let i = (ch - 48) * 3
                if i + 2 < pal.len {
                    spriteSet(&mut s, x, y, pal[i], pal[i + 1], pal[i + 2], 1.0)
                }
            }
        }
    }
    return s
}

// ── Milo the chihuahua ────────────────────────────────────────────────────────
//
//   0 outline   1 fur shadow   2 fur   3 fur lit   4 cream
//   5 ear/tongue pink   6 eye glint   7 eye + nose   8 collar   9 tag

fn dogPalette(): Vec<f64> {
    var p: Vec<f64> = Vec.new()
    palAdd(&mut p, 0.030, 0.020, 0.030) // 0 outline
    palAdd(&mut p, 0.240, 0.150, 0.080) // 1 fur shadow
    palAdd(&mut p, 0.520, 0.330, 0.150) // 2 fur
    palAdd(&mut p, 0.780, 0.550, 0.280) // 3 fur lit
    palAdd(&mut p, 0.880, 0.740, 0.550) // 4 cream
    palAdd(&mut p, 1.300, 0.420, 0.550) // 5 ear / tongue (glows)
    palAdd(&mut p, 1.500, 1.500, 1.600) // 6 eye glint
    palAdd(&mut p, 0.020, 0.020, 0.030) // 7 eye, nose
    palAdd(&mut p, 1.500, 0.200, 0.220) // 8 collar  (glows)
    palAdd(&mut p, 1.800, 1.300, 0.300) // 9 name tag (glows)
    return p
}

pub let DOG_UP: i64 = 0

pub let DOG_MID: i64 = 1

pub let DOG_DOWN: i64 = 2

pub let DOG_DEAD: i64 = 3

// Four poses. Only the ears differ between the three living ones — the body,
// the tail and the four legs are identical, and every frame is the same width,
// so switching frames moves the ears and nothing else. Without that the dog
// would jitter sideways once per flap.
//
// The ears are rooted *under* the skull: an ear drawn above the head reads as a
// rabbit, which is exactly what the first draft of this sprite looked like.
pub fn dogFrames(): Vec<Sprite> {
    let pal = dogPalette()
    var out: Vec<Sprite> = Vec.new()

    // Ears thrown up and back — the frame a player sees the instant they press
    // the key, so it is the most extreme pose of the three.
    var up: Vec<string> = Vec.new()
    up.push(".............030..030........")
    up.push(".............0300.0300")
    up.push(".............0330003300")
    up.push(".............0353003530")
    up.push(".............03533333500")
    up.push(".............033333333300")
    up.push("..000.......00333333333300")
    up.push("..0200......03333333333330")
    up.push("..002000...003333673333300")
    up.push("...0022000.03333377333333000")
    up.push("....002220000333333334447770")
    up.push(".....00220222333333444447770")
    up.push(".....00222222233333444447770")
    up.push("....002222228883333444444400")
    up.push("....02222222888433333555500")
    up.push("....0222222289844442000000")
    up.push("....02222222244444440")
    up.push("....00222222224444400")
    up.push(".....022222222444400")
    up.push("....002220222224000")
    up.push("....04444400444440")
    up.push("....04444400444440")
    up.push("....00000000000000")
    out.push(spriteFrom(up, pal))

    // Ears streaming back at a diagonal: coasting.
    var mid: Vec<string> = Vec.new()
    mid.push(".............000.............")
    mid.push(".......000...03000")
    mid.push(".......03000.0033000")
    mid.push(".......003300000533000")
    mid.push("........0035530033333000")
    mid.push(".........00355333333333000")
    mid.push("..000.....0035333333333330")
    mid.push("..0200.....003333333333300")
    mid.push("..002000...003333673333300")
    mid.push("...0022000.03333377333333000")
    mid.push("....002220000333333334447770")
    mid.push(".....00220222333333444447770")
    mid.push(".....00222222233333444447770")
    mid.push("....002222228883333444444400")
    mid.push("....02222222888433333555500")
    mid.push("....0222222289844442000000")
    mid.push("....02222222244444440")
    mid.push("....00222222224444400")
    mid.push(".....022222222444400")
    mid.push("....002220222224000")
    mid.push("....04444400444440")
    mid.push("....04444400444440")
    mid.push("....00000000000000")
    out.push(spriteFrom(mid, pal))

    // Ears blown flat back over the skull: falling.
    var down: Vec<string> = Vec.new()
    down.push(".............................")
    down.push("")
    down.push("")
    down.push("...............0000000000")
    down.push(".........0000000333330030")
    down.push(".........0333333333333300")
    down.push("..00000000333333333333300")
    down.push("..02033355555333333333330")
    down.push("..002000033553333673333300")
    down.push("...0022000003333377333333000")
    down.push("....002220000333333334447770")
    down.push(".....00220222333333444447770")
    down.push(".....00222222233333444447770")
    down.push("....002222228883333444444400")
    down.push("....02222222888433333555500")
    down.push("....0222222289844442000000")
    down.push("....02222222244444440")
    down.push("....00222222224444400")
    down.push(".....022222222444400")
    down.push("....002220222224000")
    down.push("....04444400444440")
    down.push("....04444400444440")
    down.push("....00000000000000")
    out.push(spriteFrom(down, pal))

    // X eyes, tongue out to here.
    var dead: Vec<string> = Vec.new()
    dead.push(".............................")
    dead.push("")
    dead.push("")
    dead.push("...............0000000000")
    dead.push(".........0000000333330030")
    dead.push(".........0333333333333300")
    dead.push("..00000000333333333333300")
    dead.push("..02033355555333733733330")
    dead.push("..002000033553333773333300")
    dead.push("...0022000003333377333333000")
    dead.push("....002220000333733734447770")
    dead.push(".....00220222333333444447770")
    dead.push(".....00222222233333444447770")
    dead.push("....0022222288833334444444000")
    dead.push("....0222222288843333355555550")
    dead.push("....0222222289844442005555550")
    dead.push("....0222222224444444005555550")
    dead.push("....0022222222444440000000000")
    dead.push(".....022222222444400")
    dead.push("....002220222224000")
    dead.push("....04444400444440")
    dead.push("....04444400444440")
    dead.push("....00000000000000")
    out.push(spriteFrom(dead, pal))

    return out
}

// ── a treat ───────────────────────────────────────────────────────────────────

pub fn boneSprite(): Sprite {
    var p: Vec<f64> = Vec.new()
    palAdd(&mut p, 0.030, 0.020, 0.030) // 0 outline
    palAdd(&mut p, 0.0, 0.0, 0.0)
    palAdd(&mut p, 0.0, 0.0, 0.0)
    palAdd(&mut p, 0.0, 0.0, 0.0)
    palAdd(&mut p, 1.500, 1.420, 1.150) // 4 bone (glows)
    var v: Vec<string> = Vec.new()
    v.push(".00...00.")
    v.push("0440.0440")
    v.push(".04444440")
    v.push("0440.0440")
    v.push(".00...00.")
    return spriteFrom(v, p)
}
