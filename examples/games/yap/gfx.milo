// Software HDR renderer for VOLT.
//
// Two kinds of ink share one linear-light float buffer:
//
//   blend — alpha-over, for anything with mass: tiles, sprites, silhouettes.
//   add   — additive, for anything that emits: neon rims, sparks, the goal beam.
//
// A purely additive canvas (which is what ../neon and ../flight use) cannot draw
// a solid dark shape against a bright sky, and a platformer is mostly solid dark
// shapes. Keeping both means the art has weight and the glow still blooms.
//
// The frame is bright-passed, blurred at quarter resolution and composited back
// through a Reinhard curve. No GPU, no shaders — plain loops over Vec<f32>.

from "std/math" import {
    Math
}
from "./font" import {
    fontTable
}

pub struct Canvas {
    w: i64,
    h: i64,
    hdr: Vec<f32>, // 3 floats per pixel, linear light, unbounded above 1.0
    bw: i64,
    bh: i64,
    b0: Vec<f32>, // bright-pass / ping
    b1: Vec<f32>, // pong
    fb: Vec<u32>, // ABGR8888 output handed to SDL
    font: Vec<i64>,
    // Precomputed so the composite pass does no float coordinate math and no
    // pow() per channel — those two alone dominate the frame at 720p.
    tonelut: Vec<u32>,
    ux0: Vec<i64>, // bloom bilinear: left source column per output x
    utx: Vec<f32>, //                 horizontal lerp weight
    uy0: Vec<i64>,
    uty: Vec<f32>,
}

// A pixel-art image: straight (non-premultiplied) RGBA in linear light, four
// floats per pixel. Colours run past 1.0 on purpose — that is what makes a
// visor or a shard core bloom while the suit around it does not.
pub struct Sprite {
    w: i64,
    h: i64,
    px: Vec<f32>,
}

pub fn spriteNew(w: i64, h: i64): Sprite {
    return Sprite {
        w: w, h: h, px: Vec.filled(w * h * 4, 0.0)
    }
}

pub fn spriteSet(s: &mut Sprite, x: i64, y: i64, r: f64, g: f64, b: f64, a: f64) {
    if x < 0 || y < 0 || x >= s.w || y >= s.h {
        return
    }
    let i = (y * s.w + x) * 4
    s.px[i] = (r as f32)
    s.px[i + 1] = (g as f32)
    s.px[i + 2] = (b as f32)
    s.px[i + 3] = (a as f32)
}

pub fn canvasNew(w: i64, h: i64): Canvas {
    let bw = w / 4
    let bh = h / 4
    var lut: Vec<u32> = Vec.filled(TONE_STEPS + 1, 0)
    for i in 0..TONE_STEPS + 1 {
        lut[i] = encodeSlow((i as f64) / 256.0)
    }
    var ux0: Vec<i64> = Vec.filled(w, 0)
    var utx: Vec<f32> = Vec.filled(w, 0.0)
    for x in 0..w {
        let fx = ((x as f64) + 0.5) * 0.25 - 0.5
        var i0 = Math.floor(fx) as i64
        let t = fx - (i0 as f64)
        if i0 < 0 {
            i0 = 0
        }
        if i0 > bw - 2 {
            i0 = bw - 2
        }
        ux0[x] = i0
        utx[x] = (t as f32)
    }
    var uy0: Vec<i64> = Vec.filled(h, 0)
    var uty: Vec<f32> = Vec.filled(h, 0.0)
    for y in 0..h {
        let fy = ((y as f64) + 0.5) * 0.25 - 0.5
        var i0 = Math.floor(fy) as i64
        let t = fy - (i0 as f64)
        if i0 < 0 {
            i0 = 0
        }
        if i0 > bh - 2 {
            i0 = bh - 2
        }
        uy0[y] = i0
        uty[y] = (t as f32)
    }
    return Canvas {
        w: w,
        h: h,
        hdr: Vec.filled(w * h * 3, 0.0),
        bw: bw,
        bh: bh,
        b0: Vec.filled(bw * bh * 3, 0.0),
        b1: Vec.filled(bw * bh * 3, 0.0),
        fb: Vec.filled(w * h, 0),
        font: fontTable(),
        tonelut: lut,
        ux0: ux0,
        utx: utx,
        uy0: uy0,
        uty: uty,
    }
}

// ── primitives ────────────────────────────────────────────────────────────────

pub fn addPix(c: &mut Canvas, x: i64, y: i64, r: f64, g: f64, b: f64) {
    if x < 0 || y < 0 || x >= c.w || y >= c.h {
        return
    }
    let i = (y * c.w + x) * 3
    c.hdr[i] = c.hdr[i] + (r as f32)
    c.hdr[i + 1] = c.hdr[i + 1] + (g as f32)
    c.hdr[i + 2] = c.hdr[i + 2] + (b as f32)
}

pub fn blendPix(c: &mut Canvas, x: i64, y: i64, r: f64, g: f64, b: f64, a: f64) {
    if x < 0 || y < 0 || x >= c.w || y >= c.h || a <= 0.0 {
        return
    }
    var k = a
    if k > 1.0 {
        k = 1.0
    }
    let inv = (1.0 - k) as f32
    let i = (y * c.w + x) * 3
    c.hdr[i] = c.hdr[i] * inv + ((r * k) as f32)
    c.hdr[i + 1] = c.hdr[i + 1] * inv + ((g * k) as f32)
    c.hdr[i + 2] = c.hdr[i + 2] * inv + ((b * k) as f32)
}

pub fn fillRectAdd(c: &mut Canvas, x0: f64, y0: f64, x1: f64, y1: f64, r: f64, g: f64, b: f64) {
    var ix0 = Math.floor(x0) as i64
    var iy0 = Math.floor(y0) as i64
    var ix1 = Math.floor(x1) as i64
    var iy1 = Math.floor(y1) as i64
    if ix0 < 0 {
        ix0 = 0
    }
    if iy0 < 0 {
        iy0 = 0
    }
    if ix1 > c.w {
        ix1 = c.w
    }
    if iy1 > c.h {
        iy1 = c.h
    }
    var y = iy0
    while y < iy1 {
        var x = ix0
        while x < ix1 {
            let i = (y * c.w + x) * 3
            c.hdr[i] = c.hdr[i] + (r as f32)
            c.hdr[i + 1] = c.hdr[i + 1] + (g as f32)
            c.hdr[i + 2] = c.hdr[i + 2] + (b as f32)
            x = x + 1
        }
        y = y + 1
    }
}

pub fn fillRect(c: &mut Canvas, x0: f64, y0: f64, x1: f64, y1: f64, r: f64, g: f64, b: f64, a: f64) {
    if a <= 0.0 {
        return
    }
    var k = a
    if k > 1.0 {
        k = 1.0
    }
    let inv = (1.0 - k) as f32
    let cr = ((r * k) as f32)
    let cg = ((g * k) as f32)
    let cb = ((b * k) as f32)
    var ix0 = Math.floor(x0) as i64
    var iy0 = Math.floor(y0) as i64
    var ix1 = Math.floor(x1) as i64
    var iy1 = Math.floor(y1) as i64
    if ix0 < 0 {
        ix0 = 0
    }
    if iy0 < 0 {
        iy0 = 0
    }
    if ix1 > c.w {
        ix1 = c.w
    }
    if iy1 > c.h {
        iy1 = c.h
    }
    var y = iy0
    while y < iy1 {
        var x = ix0
        while x < ix1 {
            let i = (y * c.w + x) * 3
            c.hdr[i] = c.hdr[i] * inv + cr
            c.hdr[i + 1] = c.hdr[i + 1] * inv + cg
            c.hdr[i + 2] = c.hdr[i + 2] * inv + cb
            x = x + 1
        }
        y = y + 1
    }
}

// Vertical gradient across the whole canvas, written rather than blended — this
// is the frame's first ink and it replaces whatever the composite left behind.
pub fn skyGradient(c: &mut Canvas, r0: f64, g0: f64, b0: f64, r1: f64, g1: f64, b1: f64) {
    for y in 0..c.h {
        let t = (y as f64) / ((c.h - 1) as f64)
        let r = ((r0 + (r1 - r0) * t) as f32)
        let g = ((g0 + (g1 - g0) * t) as f32)
        let b = ((b0 + (b1 - b0) * t) as f32)
        var i = y * c.w * 3
        for x in 0..c.w {
            c.hdr[i] = r
            c.hdr[i + 1] = g
            c.hdr[i + 2] = b
            i = i + 3
        }
    }
}

// A soft radial blob — particles, muzzle flashes, cores, the goal beam.
pub fn spot(c: &mut Canvas, cx: f64, cy: f64, rad: f64, r: f64, g: f64, b: f64) {
    if rad <= 0.0 {
        return
    }
    var x0 = Math.floor(cx - rad) as i64
    var x1 = (Math.floor(cx + rad) as i64) + 1
    var y0 = Math.floor(cy - rad) as i64
    var y1 = (Math.floor(cy + rad) as i64) + 1
    if x0 < 0 {
        x0 = 0
    }
    if y0 < 0 {
        y0 = 0
    }
    if x1 > c.w {
        x1 = c.w
    }
    if y1 > c.h {
        y1 = c.h
    }
    let inv = 1.0 / (rad * rad)
    var y = y0
    while y < y1 {
        let dy = (y as f64) + 0.5 - cy
        var x = x0
        while x < x1 {
            let dx = (x as f64) + 0.5 - cx
            let t = 1.0 - (dx * dx + dy * dy) * inv
            if t > 0.0 {
                let f = t * t
                let i = (y * c.w + x) * 3
                c.hdr[i] = c.hdr[i] + ((r * f) as f32)
                c.hdr[i + 1] = c.hdr[i + 1] + ((g * f) as f32)
                c.hdr[i + 2] = c.hdr[i + 2] + ((b * f) as f32)
            }
            x = x + 1
        }
        y = y + 1
    }
}

fn plot(c: &mut Canvas, x: i64, y: i64, cov: f64, r: f64, g: f64, b: f64) {
    if cov <= 0.0 {
        return
    }
    addPix(&mut c, x, y, r * cov, g * cov, b * cov)
}

// Xiaolin Wu antialiased line, drawn additively.
pub fn line(c: &mut Canvas, x0i: f64, y0i: f64, x1i: f64, y1i: f64, r: f64, g: f64, b: f64) {
    var x0 = x0i
    var y0 = y0i
    var x1 = x1i
    var y1 = y1i
    var steep = false
    if Math.abs(y1 - y0) > Math.abs(x1 - x0) {
        steep = true
        var t = x0
        x0 = y0
        y0 = t
        t = x1
        x1 = y1
        y1 = t
    }
    if x0 > x1 {
        var t = x0
        x0 = x1
        x1 = t
        t = y0
        y0 = y1
        y1 = t
    }
    let dx = x1 - x0
    let dy = y1 - y0
    var grad = 1.0
    if dx != 0.0 {
        grad = dy / dx
    }
    var xs = Math.floor(x0 + 0.5) as i64
    var xe = Math.floor(x1 + 0.5) as i64
    let limit = if steep {
        c.h
    } else {
        c.w
    }
    if xe < 0 || xs > limit {
        return
    }
    var yv = y0 + grad * ((xs as f64) + 0.5 - x0)
    if xs < -1 {
        yv = yv + grad * ((-1 - xs) as f64)
        xs = -1
    }
    if xe > limit {
        xe = limit
    }
    var x = xs
    while x <= xe {
        let fy = Math.floor(yv)
        let frac = yv - fy
        let iy = fy as i64
        if steep {
            plot(&mut c, iy, x, 1.0 - frac, r, g, b)
            plot(&mut c, iy + 1, x, frac, r, g, b)
        } else {
            plot(&mut c, x, iy, 1.0 - frac, r, g, b)
            plot(&mut c, x, iy + 1, frac, r, g, b)
        }
        yv = yv + grad
        x = x + 1
    }
}

// ── sprites ───────────────────────────────────────────────────────────────────

// Nearest-neighbour blit into a destination rectangle. Scale is a float pair
// rather than an integer so squash-and-stretch is free: the landing squash is
// blitSprite with sx 1.25 and sy 0.75, not a second set of frames.
//
// `glow` adds the sprite's own colour back on top of the blended result, which
// is what pushes a visor or a shard core past the bloom threshold while the
// solid body around it stays matte. `tmix` washes the whole sprite toward a
// tint — the white flash on a hit, the red flash on a stomp.
pub fn blitSprite(c: &mut Canvas, s: &Sprite, dx: f64, dy: f64, sx: f64, sy: f64, flip: bool, alpha: f64, glow: f64, tr: f64, tg: f64, tb: f64, tmix: f64) {
    if alpha <= 0.0 || sx <= 0.0 || sy <= 0.0 {
        return
    }
    let dw = (s.w as f64) * sx
    let dh = (s.h as f64) * sy
    var x0 = Math.floor(dx) as i64
    var y0 = Math.floor(dy) as i64
    var x1 = (Math.floor(dx + dw) as i64) + 1
    var y1 = (Math.floor(dy + dh) as i64) + 1
    if x1 <= 0 || y1 <= 0 || x0 >= c.w || y0 >= c.h {
        return
    }
    if x0 < 0 {
        x0 = 0
    }
    if y0 < 0 {
        y0 = 0
    }
    if x1 > c.w {
        x1 = c.w
    }
    if y1 > c.h {
        y1 = c.h
    }
    let invx = 1.0 / sx
    let invy = 1.0 / sy
    var y = y0
    while y < y1 {
        var v = Math.floor(((y as f64) + 0.5 - dy) * invy) as i64
        if v < 0 {
            v = 0
        }
        if v >= s.h {
            v = s.h - 1
        }
        let rowBase = v * s.w
        var x = x0
        while x < x1 {
            var u = Math.floor(((x as f64) + 0.5 - dx) * invx) as i64
            if u < 0 {
                u = 0
            }
            if u >= s.w {
                u = s.w - 1
            }
            if flip {
                u = s.w - 1 - u
            }
            let si = (rowBase + u) * 4
            let a = (s.px[si + 3] as f64) * alpha
            if a > 0.001 {
                var r = s.px[si] as f64
                var g = s.px[si + 1] as f64
                var b = s.px[si + 2] as f64
                if tmix > 0.0 {
                    r = r + (tr - r) * tmix
                    g = g + (tg - g) * tmix
                    b = b + (tb - b) * tmix
                }
                blendPix(&mut c, x, y, r, g, b, a)
                if glow > 0.0 {
                    addPix(&mut c, x, y, r * a * glow, g * a * glow, b * a * glow)
                }
            }
            x = x + 1
        }
        y = y + 1
    }
}

// The common case: upright, opaque, untinted.
pub fn drawSprite(c: &mut Canvas, s: &Sprite, dx: f64, dy: f64, scale: f64, flip: bool, glow: f64) {
    blitSprite(&mut c, s, dx, dy, scale, scale, flip, 1.0, glow, 0.0, 0.0, 0.0, 0.0)
}

// A flat silhouette of a sprite, for shadows and dash ghosts.
pub fn shadowSprite(c: &mut Canvas, s: &Sprite, dx: f64, dy: f64, sx: f64, sy: f64, flip: bool, alpha: f64, r: f64, g: f64, b: f64) {
    blitSprite(&mut c, s, dx, dy, sx, sy, flip, alpha, 0.0, r, g, b, 1.0)
}

// ── text ──────────────────────────────────────────────────────────────────────

pub fn textWidth(s: &string, scale: i64): i64 {
    return s.len * 6 * scale
}

pub fn text(c: &mut Canvas, x: i64, y: i64, s: &string, scale: i64, r: f64, g: f64, b: f64) {
    var pen = x
    for k in 0..s.len {
        var code = s[k] as i64
        if code >= 97 && code <= 122 && code != 120 {
            code = code - 32 // the table is uppercase-only, apart from 'x'
        }
        if code >= 0 && code < 128 {
            let bits = c.font[code]
            if bits != 0 {
                for row in 0..7 {
                    for col in 0..5 {
                        if ((bits >> (row * 5 + col)) & 1) == 1 {
                            let px = pen + col * scale
                            let py = y + row * scale
                            for sy in 0..scale {
                                for sx in 0..scale {
                                    addPix(&mut c, px + sx, py + sy, r, g, b)
                                }
                            }
                        }
                    }
                }
            }
        }
        pen = pen + 6 * scale
    }
}

pub fn textCentered(c: &mut Canvas, cx: i64, y: i64, s: &string, scale: i64, r: f64, g: f64, b: f64) {
    text(&mut c, cx - textWidth(s, scale) / 2, y, s, scale, r, g, b)
}

// ── bloom + tone mapping ──────────────────────────────────────────────────────

fn brightPass(c: &mut Canvas, threshold: f64) {
    let bw = c.bw
    let bh = c.bh
    for by in 0..bh {
        for bx in 0..bw {
            var sr = 0.0
            var sg = 0.0
            var sb = 0.0
            let sy0 = by * 4
            let sx0 = bx * 4
            for dy in 0..4 {
                let rowBase = ((sy0 + dy) * c.w + sx0) * 3
                for dx in 0..4 {
                    let i = rowBase + dx * 3
                    sr = sr + (c.hdr[i] as f64)
                    sg = sg + (c.hdr[i + 1] as f64)
                    sb = sb + (c.hdr[i + 2] as f64)
                }
            }
            sr = sr * 0.0625
            sg = sg * 0.0625
            sb = sb * 0.0625
            let lum = sr * 0.299 + sg * 0.587 + sb * 0.114
            var keep = 0.0
            if lum > threshold {
                keep = (lum - threshold) / lum
            }
            let o = (by * bw + bx) * 3
            c.b0[o] = ((sr * keep) as f32)
            c.b0[o + 1] = ((sg * keep) as f32)
            c.b0[o + 2] = ((sb * keep) as f32)
        }
    }
}

// Separable [1,4,6,4,1]/16 blur with a tap stride, so a couple of passes at
// different strides give a wide halo for very few samples.
fn blurPass(c: &mut Canvas, stride: i64) {
    let bw = c.bw
    let bh = c.bh
    for y in 0..bh {
        for x in 0..bw {
            var sr = 0.0
            var sg = 0.0
            var sb = 0.0
            for k in 0..5 {
                var sx = x + (k - 2) * stride
                if sx < 0 {
                    sx = 0
                }
                if sx >= bw {
                    sx = bw - 1
                }
                let wgt = KERNEL[k]
                let i = (y * bw + sx) * 3
                sr = sr + (c.b0[i] as f64) * wgt
                sg = sg + (c.b0[i + 1] as f64) * wgt
                sb = sb + (c.b0[i + 2] as f64) * wgt
            }
            let o = (y * bw + x) * 3
            c.b1[o] = (sr as f32)
            c.b1[o + 1] = (sg as f32)
            c.b1[o + 2] = (sb as f32)
        }
    }
    for y in 0..bh {
        for x in 0..bw {
            var sr = 0.0
            var sg = 0.0
            var sb = 0.0
            for k in 0..5 {
                var sy = y + (k - 2) * stride
                if sy < 0 {
                    sy = 0
                }
                if sy >= bh {
                    sy = bh - 1
                }
                let wgt = KERNEL[k]
                let i = (sy * bw + x) * 3
                sr = sr + (c.b1[i] as f64) * wgt
                sg = sg + (c.b1[i + 1] as f64) * wgt
                sb = sb + (c.b1[i + 2] as f64) * wgt
            }
            let o = (y * bw + x) * 3
            c.b0[o] = (sr as f32)
            c.b0[o + 1] = (sg as f32)
            c.b0[o + 2] = (sb as f32)
        }
    }
}

pub let KERNEL: [f64; 5] = [0.0625, 0.25, 0.375, 0.25, 0.0625]

// Reinhard, not ACES: the filmic curve lifts the low end so hard that every
// colour flattens toward paper, which is wrong for art that is mostly dark.
fn tone(x: f64): f64 {
    if x <= 0.0 {
        return 0.0
    }
    return x / (1.0 + x)
}

pub let TONE_STEPS: i64 = 2048 // covers linear 0..8, past which the curve is saturated

fn encodeSlow(v: f64): u32 {
    let s = Math.pow(tone(v), 0.4545454545)
    var n = (s * 255.0 + 0.5) as i64
    if n < 0 {
        n = 0
    }
    if n > 255 {
        n = 255
    }
    return n as u32
}

// Bloom, composite, tone-map and pack into the ABGR framebuffer.
//
// Unlike the vector games this canvas came from, the threshold is high: solid
// art fills most of the frame, and a low threshold would bloom the level itself
// into fog. Only the emissive ink — visors, shards, beams, sparks — clears it.
pub fn present(c: &mut Canvas, bloomGain: f64, exposure: f64, threshold: f64) {
    brightPass(&mut c, threshold)
    blurPass(&mut c, 1)
    blurPass(&mut c, 2)
    blurPass(&mut c, 4)
    blurPass(&mut c, 8) // without the widest pass the halo has a visible square edge

    let bw = c.bw
    let gain = (bloomGain * exposure) as f32
    let expo = (exposure * 256.0) as f32
    let maxIdx = TONE_STEPS
    for y in 0..c.h {
        let by0 = c.uy0[y]
        let ty = c.uty[y]
        let row0 = by0 * bw * 3
        let row1 = (by0 + 1) * bw * 3
        var s = y * c.w * 3
        var o = y * c.w
        for x in 0..c.w {
            let bx = c.ux0[x] * 3
            let tx = c.utx[x]
            let w00: f32 = (1.0 - tx) * (1.0 - ty)
            let w01: f32 = tx * (1.0 - ty)
            let w10: f32 = (1.0 - tx) * ty
            let w11: f32 = tx * ty
            let i00 = row0 + bx
            let i10 = row1 + bx

            var v0 = (c.hdr[s] + (c.b0[i00] * w00 + c.b0[i00 + 3] * w01 + c.b0[i10] * w10 + c.b0[i10 + 3] * w11) * gain) * expo
            var v1 = (c.hdr[s + 1] + (c.b0[i00 + 1] * w00 + c.b0[i00 + 4] * w01 + c.b0[i10 + 1] * w10 + c.b0[i10 + 4] * w11) * gain) * expo
            var v2 = (c.hdr[s + 2] + (c.b0[i00 + 2] * w00 + c.b0[i00 + 5] * w01 + c.b0[i10 + 2] * w10 + c.b0[i10 + 5] * w11) * gain) * expo

            var n0 = v0 as i64
            var n1 = v1 as i64
            var n2 = v2 as i64
            if n0 < 0 {
                n0 = 0
            }
            if n1 < 0 {
                n1 = 0
            }
            if n2 < 0 {
                n2 = 0
            }
            if n0 > maxIdx {
                n0 = maxIdx
            }
            if n1 > maxIdx {
                n1 = maxIdx
            }
            if n2 > maxIdx {
                n2 = maxIdx
            }
            c.fb[o] = 0xFF000000 | (c.tonelut[n2] << 16) | (c.tonelut[n1] << 8) | c.tonelut[n0]
            s = s + 3
            o = o + 1
        }
    }
}
