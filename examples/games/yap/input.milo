// One frame of input, snapshotted out of SDL so the rest of the game never
// touches a pointer.
//
// The game has exactly one verb, so every key anyone might press for it is
// wired to the same flag — plus the mouse, because a one-button game should
// never make you find the button.

from "../../shared/sdlkit" import {
    pollEvents, keyboard, mouse
}
from "sdl/keys" import {
    SC_W, SC_K, SC_M, SC_R, SC_Z, SC_ESCAPE, SC_SPACE, SC_UP, SC_RETURN
}

// `flap`, `restart` and `mute` are edge-triggered — true only on the frame the
// key goes down. A held space bar must not beat its ears sixty times a second.
pub struct Input {
    flap: bool,
    restart: bool,
    mute: bool,
    quit: bool,
    prevFlap: bool,
    prevRestart: bool,
    prevMute: bool,
}

pub fn inputNew(): Input {
    return Input {
        flap: false, restart: false, mute: false, quit: false,
        prevFlap: false, prevRestart: false, prevMute: false,
    }
}

pub fn pollInput(inp: &mut Input) {
    if pollEvents().quit {
        inp.quit = true
    }
    let ks = keyboard()
    if ks.down(SC_ESCAPE) {
        inp.quit = true
    }
    let ms = mouse()
    let btn = ms.buttons

    let keyFlap = ks.down(SC_SPACE) || ks.down(SC_UP) || ks.down(SC_W)
    let altFlap = ks.down(SC_K) || ks.down(SC_Z) || ks.down(SC_RETURN)
    let flapNow = keyFlap || altFlap || (btn & 1) != 0
    let restartNow = ks.down(SC_R)
    let muteNow = ks.down(SC_M)

    inp.flap = flapNow && !inp.prevFlap
    inp.restart = restartNow && !inp.prevRestart
    inp.mute = muteNow && !inp.prevMute

    inp.prevFlap = flapNow
    inp.prevRestart = restartNow
    inp.prevMute = muteNow
}
