// YAP — a chihuahua flaps his ears through the neighbourhood, written in Milo.
//
//   milo run examples/games/yap/main.milo
//   milo build examples/games/yap/main.milo -o /tmp/yap --release && /tmp/yap
//
//   SPACE / UP / W / CLICK   flap        R   restart
//   M                        music       ESC quit
//
// One button. Milo is four inches tall and the hydrants are not, so the only
// question the game ever asks is when to beat your ears.
//
// Everything on screen is software: the dog is pixel art written as strings and
// the neighbourhood is hashed out of its own world position, all composited into
// a linear-light float buffer with bloom and tone mapping (gfx.milo). SDL only
// blits the finished frame. The SDL declarations come from the `sdl` package —
// see milo.json.
//
// Nothing in this game is `unsafe`: every SDL call goes through ../../shared/sdlkit.milo.

from "std/random" import {
    Random
}
from "sdl" import {
    SDL_INIT_VIDEO, SDL_INIT_AUDIO, SDL_WINDOW_SHOWN, SDL_RENDERER_ACCELERATED, SDL_RENDERER_PRESENTVSYNC
}
from "../../shared/sdlkit" import {
    Sdl, Window, Presenter, setCursorVisible, ticks
}
from "./input" import {
    inputNew, pollInput
}
from "./gfx" import {
    canvasNew, present
}
from "./sprites" import {
    dogFrames, boneSprite
}
from "./world" import {
    worldNew, worldReset, worldUpdate, flap, canRestart, ST_OVER
}
from "./render" import {
    drawBackground, drawGates, drawDog, drawParts, drawHud
}
from "./sound" import {
    soundNew, musicTick, musicToggle, playYap, playPoint, playCrunch, playHurt, playThud
}

pub let W: i64 = 1280

pub let H: i64 = 720

pub fn main(): i32 {
    // Declared in teardown's reverse: the presenter goes first, then the window, then
    // SDL itself.
    let _sdl = match Sdl.init(SDL_INIT_VIDEO | SDL_INIT_AUDIO) {
        Ok(v) => v,
        Err(e) => {
            print(e)
            return 1
        }
    }
    let win = match Window.create("YAP — written in Milo", W, H, SDL_WINDOW_SHOWN) {
        Ok(v) => v,
        Err(e) => {
            print(e)
            return 2
        }
    }
    let screen = match Presenter.create(win, W, H, SDL_RENDERER_ACCELERATED | SDL_RENDERER_PRESENTVSYNC) {
        Ok(v) => v,
        Err(e) => {
            print(e)
            return 2
        }
    }
    setCursorVisible(false)

    var c = canvasNew(W, H)
    let dog = dogFrames()
    let bone = boneSprite()
    var w = worldNew(W as f64, H as f64)
    var snd = soundNew()
    var inp = inputNew()

    var last = ticks()
    var fpsAccum: f64 = 0.0
    var fpsFrames: i64 = 0
    var fpsShown: i64 = 0

    while !inp.quit {
        let now = ticks()
        var dt = ((now - last) as f64) / 1000.0
        last = now
        // A frame longer than 50 ms is a hitch, not slow motion: clamp it so the
        // dog never takes a step that tunnels him through a hydrant.
        if dt > 0.05 {
            dt = 0.05
        }
        if dt < 0.0005 {
            dt = 0.0005
        }

        pollInput(&mut inp)
        if inp.mute {
            musicToggle(&mut snd)
        }
        musicTick(snd)

        if inp.restart {
            worldReset(&mut w)
        }
        if inp.flap {
            if w.state == ST_OVER {
                if canRestart(w) {
                    worldReset(&mut w)
                }
            } else {
                flap(&mut w)
            }
        }

        worldUpdate(&mut w, dt)

        if w.evFlap {
            playYap(&mut snd)
        }
        if w.evScore {
            playPoint(snd)
        }
        if w.evTreat {
            playCrunch(snd)
        }
        if w.evHit {
            playHurt(snd)
        }
        if w.evThud {
            playThud(snd)
        }

        // Screen shake is a camera offset at draw time, so it never touches the
        // simulation and can never desync collision from what is on screen.
        var ox = 0.0
        var oy = 0.0
        if w.shake > 0.2 {
            ox = Random.floatRange(0.0 - w.shake, w.shake)
            oy = Random.floatRange(0.0 - w.shake, w.shake)
        }

        drawBackground(&mut c, w)
        drawGates(&mut c, w, bone, ox, oy)
        drawDog(&mut c, w, dog, ox, oy)
        drawParts(&mut c, w, ox, oy)

        fpsAccum += dt
        fpsFrames += 1
        if fpsAccum > 0.5 {
            fpsShown = ((fpsFrames as f64) / fpsAccum) as i64
            fpsAccum = 0.0
            fpsFrames = 0
        }
        drawHud(&mut c, w, bone, fpsShown)

        var exposure = 1.0
        if w.flash > 0.0 {
            exposure = exposure + w.flash * 0.8
        }
        // A high bloom threshold: it is daytime and most of the frame is bright,
        // so a low one would fog the sky instead of lighting the collar, the
        // treats and the chrome on the hydrant caps.
        present(&mut c, 0.40, exposure, 0.90)

        screen.present(c.fb)
    }

    return 0
}
