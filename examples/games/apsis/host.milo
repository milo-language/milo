// The window, the GL 3.3 core context, and one frame of input.
//
// Nothing above this file touches a pointer or an SDL constant: `pollInput`
// snapshots the keyboard and the mouse into a plain struct once per frame, and
// every key is edge-triggered unless holding it down is the point.
//
// The SDL declarations themselves live in the `sdl` package, header-verified and
// written once; what is left here is this game's window setup and control scheme.

from "sdl" import {
    SDL_BUTTON_LMASK, SDL_INIT_VIDEO, SDL_WINDOW_ALLOW_HIGHDPI, SDL_WINDOW_HIDDEN, SDL_WINDOW_RESIZABLE, SDL_WINDOW_SHOWN
}
from "sdl/glcontext" import {
    SDL_GL_CONTEXT_MAJOR_VERSION, SDL_GL_CONTEXT_MINOR_VERSION, SDL_GL_CONTEXT_PROFILE_CORE, SDL_GL_CONTEXT_PROFILE_MASK, SDL_WINDOW_OPENGL
}
from "../../shared/sdlkit" import {
    Sdl, Window, SdlGlContext, glSetAttribute, glSetSwapInterval, pollEvents, keyboard, mouse
}
from "sdl/keys" import {
    SC_1, SC_A, SC_D, SC_DOWN, SC_EQUALS, SC_ESCAPE, SC_F, SC_H, SC_LEFT,
    SC_LEFTBRACKET, SC_MINUS, SC_Q, SC_R, SC_RETURN, SC_RIGHT, SC_RIGHTBRACKET,
    SC_S, SC_SPACE, SC_UP
}

// One frame of input, in drawable pixels. The 3D scene is projected with the
// live drawable size and the overlay is laid out in the same space, so unlike a
// letterboxed fixed-resolution game there is no second coordinate system here.
pub struct Input {
    quit: bool,
    mx: f64,
    my: f64,
    dragX: f64,
    dragY: f64,
    down: bool,
    clicked: bool, // edge: the button released without a drag
    dragged: bool,
    wheel: f64,
    zoom: f64, // held, -1 in / +1 out
    scrubX: f64, // held, the departure dial
    scrubY: f64, // held, the flight-time dial
    advance: bool, // SPACE
    commit: bool, // RETURN
    snap: bool, // S
    reset: bool, // R
    help: bool, // H
    fullscreen: bool, // F
    warpUp: bool,
    warpDown: bool,
    digit: i64, // 1..6, or 0
    spaceHeld: bool,
    returnHeld: bool,
    snapHeld: bool,
    resetHeld: bool,
    helpHeld: bool,
    fullHeld: bool,
    warpUpHeld: bool,
    warpDownHeld: bool,
    digitHeld: bool,
    pressX: f64,
    pressY: f64,
}

pub fn inputNew(): Input {
    return Input {
        quit: false, mx: 0.0, my: 0.0, dragX: 0.0, dragY: 0.0,
        down: false, clicked: false, dragged: false, wheel: 0.0, zoom: 0.0,
        scrubX: 0.0, scrubY: 0.0,
        advance: false, commit: false, snap: false, reset: false, help: false,
        fullscreen: false, warpUp: false, warpDown: false, digit: 0,
        spaceHeld: false, returnHeld: false, snapHeld: false, resetHeld: false,
        helpHeld: false, fullHeld: false, warpUpHeld: false, warpDownHeld: false,
        digitHeld: false, pressX: 0.0, pressY: 0.0,
    }
}

fn edge(now: bool, held: &mut bool): bool {
    let fired = now && !held
    held = now
    return fired
}

// A press that travels further than this is a camera drag, and releasing it must
// not also count as a click on whatever button happens to be under the pointer.
pub let DRAG_SLOP: f64 = 5.0

// `scale` converts SDL's window-space mouse position into drawable pixels; it is
// 2.0 on a Retina display and 1.0 everywhere else. Getting it wrong puts every
// click at half the distance from the top-left that the player aimed at.
pub fn pollInput(inp: &mut Input, scale: f64) {
    inp.wheel = 0.0
    inp.clicked = false
    inp.dragX = 0.0
    inp.dragY = 0.0
    let evs = pollEvents()
    if evs.quit {
        inp.quit = true
    }
    inp.wheel += evs.wheel
    let ms = mouse()
    let buttons = ms.buttons
    let nx = (ms.x as f64) * scale
    let ny = (ms.y as f64) * scale
    let downNow = (buttons & SDL_BUTTON_LMASK) != 0
    if downNow && !inp.down {
        inp.pressX = nx
        inp.pressY = ny
        inp.dragged = false
    }
    if downNow && inp.down {
        inp.dragX = nx - inp.mx
        inp.dragY = ny - inp.my
        let tx = nx - inp.pressX
        let ty = ny - inp.pressY
        if tx * tx + ty * ty > DRAG_SLOP * DRAG_SLOP {
            inp.dragged = true
        }
    }
    if !downNow && inp.down && !inp.dragged {
        inp.clicked = true
    }
    inp.down = downNow
    inp.mx = nx
    inp.my = ny

    let ks = keyboard()
    if ks.down(SC_Q) || ks.down(SC_ESCAPE) {
        inp.quit = true
    }
    inp.advance = edge(ks.down(SC_SPACE), &mut inp.spaceHeld)
    inp.commit = edge(ks.down(SC_RETURN), &mut inp.returnHeld)
    inp.snap = edge(ks.down(SC_S), &mut inp.snapHeld)
    inp.reset = edge(ks.down(SC_R), &mut inp.resetHeld)
    inp.help = edge(ks.down(SC_H), &mut inp.helpHeld)
    inp.fullscreen = edge(ks.down(SC_F), &mut inp.fullHeld)
    inp.warpDown = edge(ks.down(SC_LEFTBRACKET), &mut inp.warpDownHeld)
    inp.warpUp = edge(ks.down(SC_RIGHTBRACKET), &mut inp.warpUpHeld)

    // The dials are held, not tapped: the whole feel of the plan screen is
    // watching a number fall while a key is down.
    inp.scrubX = 0.0
    inp.scrubY = 0.0
    if ks.down(SC_LEFT) || ks.down(SC_A) {
        inp.scrubX -= 1.0
    }
    if ks.down(SC_RIGHT) || ks.down(SC_D) {
        inp.scrubX += 1.0
    }
    if ks.down(SC_UP) {
        inp.scrubY += 1.0
    }
    if ks.down(SC_DOWN) {
        inp.scrubY -= 1.0
    }

    inp.zoom = 0.0
    if ks.down(SC_MINUS) {
        inp.zoom += 1.0
    }
    if ks.down(SC_EQUALS) {
        inp.zoom -= 1.0
    }

    // The number row jumps to a mission. One `digitHeld` for all six keys is
    // deliberate: pressing two at once should pick one mission, not race.
    var pressed = 0
    var i = 0
    while i < 6 {
        if ks.down(SC_1 + i) {
            pressed = i + 1
        }
        i += 1
    }
    inp.digit = 0
    if edge(pressed != 0, &mut inp.digitHeld) {
        inp.digit = pressed
    }
}

// The window and its GL 3.3 core context. An Err means this machine cannot run the
// game and the caller should say so and stop.
pub struct Host {
    // Field order is teardown order reversed: the context goes first, then the
    // window, then SDL itself.
    _sdl: Sdl,
    win: Window,
    _ctx: SdlGlContext,
}

pub fn hostNew(title: &string, w: i64, h: i64, visible: bool): Result<Host, string> {
    let sdl = Sdl.init(SDL_INIT_VIDEO)?
    // Set before the window exists: SDL reads these when it picks the pixel format
    // and ignores them afterwards.
    let _ = glSetAttribute(SDL_GL_CONTEXT_MAJOR_VERSION, 3)
    let _ = glSetAttribute(SDL_GL_CONTEXT_MINOR_VERSION, 3)
    let _ = glSetAttribute(SDL_GL_CONTEXT_PROFILE_MASK, SDL_GL_CONTEXT_PROFILE_CORE)
    var shown = SDL_WINDOW_SHOWN
    if !visible {
        shown = SDL_WINDOW_HIDDEN
    }
    let win = Window.create(title, w, h, shown | SDL_WINDOW_RESIZABLE | SDL_WINDOW_OPENGL | SDL_WINDOW_ALLOW_HIGHDPI)?
    let ctx = match SdlGlContext.create(win) {
        Ok(c) => c,
        Err(e) => {
            return Result.Err("no GL 3.3 core context: " + e)
        }
    }
    let _ = glSetSwapInterval(1)
    return Result.Ok(Host { _sdl: sdl, win: win, _ctx: ctx })
}

pub struct Size {
    w: i64,
    h: i64,
}

// The drawable size in real pixels, which on a Retina display is twice the window
// size the user dragged. Every layout in the game is expressed in these pixels,
// so the overlay is crisp instead of upscaled — which is also why `pollInput` has
// to be told the window-to-drawable ratio.
pub fn drawableSize(win: &Window): Size {
    let d = win.drawableSize()
    return Size {
        w: d.w, h: d.h
    }
}

pub fn pixelScale(win: &Window): f64 {
    let points = win.size()
    if points.w <= 0 {
        return 1.0
    }
    let d = win.drawableSize()
    return (d.w as f64) / (points.w as f64)
}
