// The window, the GL 3.3 core context, and one frame of input.
//
// Nothing above this file touches a pointer or an SDL constant: `pollInput`
// snapshots the keyboard and the mouse into a plain struct once per frame, and
// every key is edge-triggered unless holding it down is the point.
//
// The SDL declarations themselves live in the `sdl` package, header-verified and
// written once; what is left here is this game's window setup and control scheme.

from "gl" import {
    GlContext,
    Gpu
}
from "sdl" import {
    SDL_CreateWindow, SDL_DestroyWindow, SDL_GetError, SDL_GetKeyboardState,
    SDL_GetMouseState, SDL_GetTicks, SDL_GetWindowSize, SDL_Init, SDL_PollEvent,
    SDL_Quit, SDL_SetWindowFullscreen,
    SDL_BUTTON_LMASK, SDL_INIT_VIDEO, SDL_MOUSEWHEEL, SDL_QUIT,
    SDL_WINDOWPOS_CENTERED, SDL_WINDOW_ALLOW_HIGHDPI,
    SDL_WINDOW_FULLSCREEN_DESKTOP, SDL_WINDOW_HIDDEN, SDL_WINDOW_RESIZABLE,
    SDL_WINDOW_SHOWN
}
from "sdl/glcontext" import {
    SDL_GL_CreateContext, SDL_GL_DeleteContext, SDL_GL_GetDrawableSize,
    SDL_GL_SetAttribute, SDL_GL_SetSwapInterval, SDL_GL_SwapWindow,
    SDL_GL_CONTEXT_MAJOR_VERSION, SDL_GL_CONTEXT_MINOR_VERSION,
    SDL_GL_CONTEXT_PROFILE_CORE, SDL_GL_CONTEXT_PROFILE_MASK, SDL_WINDOW_OPENGL
}
from "sdl/keys" import {
    SC_1, SC_A, SC_D, SC_DOWN, SC_EQUALS, SC_ESCAPE, SC_F, SC_H, SC_LEFT,
    SC_LEFTBRACKET, SC_MINUS, SC_Q, SC_R, SC_RETURN, SC_RIGHT, SC_RIGHTBRACKET,
    SC_S, SC_SPACE, SC_UP
}

// One frame of input, in drawable pixels. The 3D scene is projected with the
// live drawable size and the overlay is laid out in the same space, so unlike a
// letterboxed fixed-resolution game there is no second coordinate system here.
pub struct Input {
    quit: bool,
    mx: f64,
    my: f64,
    dragX: f64,
    dragY: f64,
    down: bool,
    clicked: bool, // edge: the button released without a drag
    dragged: bool,
    wheel: f64,
    zoom: f64, // held, -1 in / +1 out
    scrubX: f64, // held, the departure dial
    scrubY: f64, // held, the flight-time dial
    advance: bool, // SPACE
    commit: bool, // RETURN
    snap: bool, // S
    reset: bool, // R
    help: bool, // H
    fullscreen: bool, // F
    warpUp: bool,
    warpDown: bool,
    digit: i64, // 1..6, or 0
    spaceHeld: bool,
    returnHeld: bool,
    snapHeld: bool,
    resetHeld: bool,
    helpHeld: bool,
    fullHeld: bool,
    warpUpHeld: bool,
    warpDownHeld: bool,
    digitHeld: bool,
    pressX: f64,
    pressY: f64,
}

pub fn inputNew(): Input {
    return Input {
        quit: false, mx: 0.0, my: 0.0, dragX: 0.0, dragY: 0.0,
        down: false, clicked: false, dragged: false, wheel: 0.0, zoom: 0.0,
        scrubX: 0.0, scrubY: 0.0,
        advance: false, commit: false, snap: false, reset: false, help: false,
        fullscreen: false, warpUp: false, warpDown: false, digit: 0,
        spaceHeld: false, returnHeld: false, snapHeld: false, resetHeld: false,
        helpHeld: false, fullHeld: false, warpUpHeld: false, warpDownHeld: false,
        digitHeld: false, pressX: 0.0, pressY: 0.0,
    }
}

fn edge(now: bool, held: &mut bool): bool {
    let fired = now && !held
    held = now
    return fired
}

// A press that travels further than this is a camera drag, and releasing it must
// not also count as a click on whatever button happens to be under the pointer.
pub let DRAG_SLOP: f64 = 5.0

// `scale` converts SDL's window-space mouse position into drawable pixels; it is
// 2.0 on a Retina display and 1.0 everywhere else. Getting it wrong puts every
// click at half the distance from the top-left that the player aimed at.
pub fn pollInput(inp: &mut Input, ev: &mut [u8; 64], scale: f64) {
    inp.wheel = 0.0
    inp.clicked = false
    inp.dragX = 0.0
    inp.dragY = 0.0
    unsafe {
        while SDL_PollEvent(ev) != 0 {
            let evType: u32 = (ev[0] as u32) | ((ev[1] as u32) << 8) | ((ev[2] as u32) << 16) | ((ev[3] as u32) << 24)
            if evType == SDL_QUIT {
                inp.quit = true
            }
            if evType == SDL_MOUSEWHEEL {
                // SDL_MouseWheelEvent's signed y delta sits at byte offset 20;
                // the event union arrives here as raw little-endian storage.
                let raw: u32 = (ev[20] as u32) | ((ev[21] as u32) << 8) | ((ev[22] as u32) << 16) | ((ev[23] as u32) << 24)
                inp.wheel = inp.wheel + (raw as i32 as f64)
            }
        }
        var wx: i32 = 0
        var wy: i32 = 0
        let buttons = SDL_GetMouseState(wx.addrOf(), wy.addrOf())
        let nx = (wx as f64) * scale
        let ny = (wy as f64) * scale
        let downNow = (buttons & SDL_BUTTON_LMASK) != 0
        if downNow && !inp.down {
            inp.pressX = nx
            inp.pressY = ny
            inp.dragged = false
        }
        if downNow && inp.down {
            inp.dragX = nx - inp.mx
            inp.dragY = ny - inp.my
            let tx = nx - inp.pressX
            let ty = ny - inp.pressY
            if tx * tx + ty * ty > DRAG_SLOP * DRAG_SLOP {
                inp.dragged = true
            }
        }
        if !downNow && inp.down && !inp.dragged {
            inp.clicked = true
        }
        inp.down = downNow
        inp.mx = nx
        inp.my = ny

        let ks = SDL_GetKeyboardState(0 as *i32)
        if ks[SC_Q] != 0 || ks[SC_ESCAPE] != 0 {
            inp.quit = true
        }
        inp.advance = edge(ks[SC_SPACE] != 0, &mut inp.spaceHeld)
        inp.commit = edge(ks[SC_RETURN] != 0, &mut inp.returnHeld)
        inp.snap = edge(ks[SC_S] != 0, &mut inp.snapHeld)
        inp.reset = edge(ks[SC_R] != 0, &mut inp.resetHeld)
        inp.help = edge(ks[SC_H] != 0, &mut inp.helpHeld)
        inp.fullscreen = edge(ks[SC_F] != 0, &mut inp.fullHeld)
        inp.warpDown = edge(ks[SC_LEFTBRACKET] != 0, &mut inp.warpDownHeld)
        inp.warpUp = edge(ks[SC_RIGHTBRACKET] != 0, &mut inp.warpUpHeld)

        // The dials are held, not tapped: the whole feel of the plan screen is
        // watching a number fall while a key is down.
        inp.scrubX = 0.0
        inp.scrubY = 0.0
        if ks[SC_LEFT] != 0 || ks[SC_A] != 0 {
            inp.scrubX = inp.scrubX - 1.0
        }
        if ks[SC_RIGHT] != 0 || ks[SC_D] != 0 {
            inp.scrubX = inp.scrubX + 1.0
        }
        if ks[SC_UP] != 0 {
            inp.scrubY = inp.scrubY + 1.0
        }
        if ks[SC_DOWN] != 0 {
            inp.scrubY = inp.scrubY - 1.0
        }

        inp.zoom = 0.0
        if ks[SC_MINUS] != 0 {
            inp.zoom = inp.zoom + 1.0
        }
        if ks[SC_EQUALS] != 0 {
            inp.zoom = inp.zoom - 1.0
        }

        // The number row jumps to a mission. One `digitHeld` for all six keys is
        // deliberate: pressing two at once should pick one mission, not race.
        var pressed = 0
        var i = 0
        while i < 6 {
            if ks[SC_1 + i] != 0 {
                pressed = i + 1
            }
            i = i + 1
        }
        inp.digit = 0
        if edge(pressed != 0, &mut inp.digitHeld) {
            inp.digit = pressed
        }
    }
}

pub struct Host {
    win: *u8,
    ctx: *u8,
    ok: bool,
    err: string,
}

// `visible` is false for a screenshot run: those never present a frame, so an
// on-screen window is a black rectangle that opens over whatever the person is
// actually doing and then vanishes.
pub fn hostNew(title: &string, w: i64, h: i64, visible: bool): Host {
    if SDL_Init(SDL_INIT_VIDEO) != 0 {
        return Host {
            win: 0 as *u8, ctx: 0 as *u8, ok: false, err: "SDL_Init failed"
        }
    }
    unsafe {
        // Set before the window exists — SDL reads these when it picks the pixel
        // format and ignores them afterwards.
        let _ = SDL_GL_SetAttribute(SDL_GL_CONTEXT_MAJOR_VERSION, 3)
        let _ = SDL_GL_SetAttribute(SDL_GL_CONTEXT_MINOR_VERSION, 3)
        let _ = SDL_GL_SetAttribute(SDL_GL_CONTEXT_PROFILE_MASK, SDL_GL_CONTEXT_PROFILE_CORE)
        var shown = SDL_WINDOW_SHOWN
        if !visible {
            shown = SDL_WINDOW_HIDDEN
        }
        let win = SDL_CreateWindow(title.cstr(), SDL_WINDOWPOS_CENTERED, SDL_WINDOWPOS_CENTERED, w as i32, h as i32, shown | SDL_WINDOW_RESIZABLE | SDL_WINDOW_OPENGL | SDL_WINDOW_ALLOW_HIGHDPI)
        if (win as i64) == 0 {
            return Host {
                win: 0 as *u8, ctx: 0 as *u8, ok: false, err: "window: " + _cstrToString(SDL_GetError())
            }
        }
        let ctx = SDL_GL_CreateContext(win)
        if (ctx as i64) == 0 {
            return Host {
                win: win, ctx: 0 as *u8, ok: false, err: "no GL 3.3 core context: " + _cstrToString(SDL_GetError())
            }
        }
        let _ = SDL_GL_SetSwapInterval(1)
        return Host {
            win: win, ctx: ctx, ok: true, err: Gpu.version()
        }
    }
}

pub struct Size {
    w: i64,
    h: i64,
}

// The drawable size in real pixels, which on a Retina display is twice the window
// size the user dragged. Every layout in the game is expressed in these pixels,
// so the overlay is crisp instead of upscaled — which is also why `pollInput` has
// to be told the window-to-drawable ratio.
pub fn drawableSize(win: *u8): Size {
    var dw: i32 = 0
    var dh: i32 = 0
    unsafe {
        SDL_GL_GetDrawableSize(win, dw.addrOf(), dh.addrOf())
    }
    return Size {
        w: dw as i64, h: dh as i64
    }
}

pub fn pixelScale(win: *u8): f64 {
    var ww: i32 = 0
    var wh: i32 = 0
    unsafe {
        SDL_GetWindowSize(win, ww.addrOf(), wh.addrOf())
    }
    if ww <= 0 {
        return 1.0
    }
    let d = drawableSize(win)
    return (d.w as f64) / (ww as f64)
}
