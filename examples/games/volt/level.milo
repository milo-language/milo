// Levels: one character per tile, and the same characters place the entities.
//
//   .  air          #  solid rock      =  one-way platform
//   ^  spikes       %  breakable       !  launch pad
//   S  spawn        G  gate            k  hydrant (checkpoint)
//   o  treat        O  gem             b  bone (turns you into a shepherd)
//   c  cat          d  bird
//
// Rows are ragged on purpose — a row is only as long as its last non-air tile,
// and the parser treats everything past the end as air. Most of a platformer is
// sky, and this way the sky costs nothing to write down.

from "./tiles" import {
    TILE
}

pub let T_EMPTY: i64 = 0

pub let T_SOLID: i64 = 1

pub let T_PLAT: i64 = 2

pub let T_SPIKE: i64 = 3

pub let T_CRATE: i64 = 4

pub let T_PAD: i64 = 5

pub struct Level {
    name: string,
    cols: i64,
    rows: i64,
    t: Vec<i64>,
    spawnX: f64,
    spawnY: f64,
    goalX: f64,
    goalY: f64,
    shardX: Vec<f64>,
    shardY: Vec<f64>,
    coreX: Vec<f64>,
    coreY: Vec<f64>,
    catX: Vec<f64>,
    catY: Vec<f64>,
    birdX: Vec<f64>,
    birdY: Vec<f64>,
    boneX: Vec<f64>,
    boneY: Vec<f64>,
    checkX: Vec<f64>,
    checkY: Vec<f64>,
}

pub fn tileAt(l: &Level, cx: i64, cy: i64): i64 {
    // Outside the map is solid at the sides and open at the top and bottom: a
    // player who leaves the bottom has fallen out of the world, which is a
    // death, and one who leaves the side has not.
    if cx < 0 || cx >= l.cols {
        return T_SOLID
    }
    if cy < 0 || cy >= l.rows {
        return T_EMPTY
    }
    return l.t[cy * l.cols + cx]
}

pub fn setTile(l: &mut Level, cx: i64, cy: i64, v: i64) {
    if cx < 0 || cx >= l.cols || cy < 0 || cy >= l.rows {
        return
    }
    l.t[cy * l.cols + cx] = v
}

pub fn isSolid(l: &Level, cx: i64, cy: i64): bool {
    let v = tileAt(l, cx, cy)
    return v == T_SOLID || v == T_CRATE || v == T_PAD
}

fn widest(rows: &Vec<string>): i64 {
    var w = 0
    for r in rows {
        if r.len > w {
            w = r.len
        }
    }
    return w
}

fn charAt(rows: &Vec<string>, r: i64, c: i64): i64 {
    if c >= rows[r].len {
        return 46 // '.'
    }
    return rows[r][c] as i64
}

fn levelParse(name: string, rows: &Vec<string>): Level {
    let cols = widest(rows)
    let nrows = rows.len
    var l = Level {
        name: name,
        cols: cols,
        rows: nrows,
        t: Vec.filled(cols * nrows, T_EMPTY),
        spawnX: TILE * 2.0,
        spawnY: TILE * 2.0,
        goalX: TILE * ((cols - 3) as f64),
        goalY: TILE * 2.0,
        shardX: Vec.new(),
        shardY: Vec.new(),
        coreX: Vec.new(),
        coreY: Vec.new(),
        catX: Vec.new(),
        catY: Vec.new(),
        birdX: Vec.new(),
        birdY: Vec.new(),
        boneX: Vec.new(),
        boneY: Vec.new(),
        checkX: Vec.new(),
        checkY: Vec.new(),
    }
    for y in 0..nrows {
        for x in 0..cols {
            let ch = charAt(rows, y, x)
            // centre of the tile, in world pixels
            let wx = ((x as f64) + 0.5) * TILE
            let wy = ((y as f64) + 0.5) * TILE
            if ch == 35 { // '#'
                setTile(&mut l, x, y, T_SOLID)
            } else if ch == 61 { // '='
                setTile(&mut l, x, y, T_PLAT)
            } else if ch == 94 { // '^'
                setTile(&mut l, x, y, T_SPIKE)
            } else if ch == 37 { // '%'
                setTile(&mut l, x, y, T_CRATE)
            } else if ch == 33 { // '!'
                setTile(&mut l, x, y, T_PAD)
            } else if ch == 83 { // 'S'
                l.spawnX = wx
                l.spawnY = wy
            } else if ch == 71 { // 'G'
                l.goalX = wx
                l.goalY = wy
            } else if ch == 111 { // 'o'
                l.shardX.push(wx)
                l.shardY.push(wy)
            } else if ch == 79 { // 'O'
                l.coreX.push(wx)
                l.coreY.push(wy)
            } else if ch == 99 { // 'c'
                l.catX.push(wx)
                l.catY.push(wy)
            } else if ch == 100 { // 'd'
                l.birdX.push(wx)
                l.birdY.push(wy)
            } else if ch == 98 { // 'b'
                l.boneX.push(wx)
                l.boneY.push(wy)
            } else if ch == 107 { // 'k'
                l.checkX.push(wx)
                l.checkY.push(wy)
            }
        }
    }
    return l
}

pub fn levelCount(): i64 {
    return 3
}

pub fn levelName(n: i64): string {
    if n == 0 {
        return "MORNING WALK"
    }
    if n == 1 {
        return "THE LONG PARK"
    }
    return "UP THE HILL"
}

