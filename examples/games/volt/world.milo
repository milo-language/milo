// Simulation: movement, collision, enemies, pickups, particles, camera.
//
// The movement model is the modern platformer one rather than the 1985 one, and
// the difference is entirely in the forgiveness:
//
//   coyote time     you can still jump for a moment after walking off an edge
//   jump buffering  a jump pressed just before landing fires on landing
//   variable height a short tap is a short jump
//   apex hang       gravity eases near the top of an arc, so the peak reads
//   wall jump       and a slide that gives you time to aim it
//   dash            one air dash, refilled by touching ground or wall
//
// None of those change what is possible; they change how often the game does
// what the player meant. That is what "feels modern" actually means here.
//
// Two more things carry the difficulty, and both are about giving a mistake
// somewhere to go instead of ending the run:
//
//   the bone       eat one and you are a german shepherd, who takes the next
//                  hit for you and goes back to being a chihuahua
//   the hydrant    the last one you passed is where you come back
//
// Nothing in this file is unsafe and nothing in it touches SDL.

from "std/math" import {
    Math
}
from "std/random" import {
    Random
}
from "./level" import {
    Level, levelLoad, levelCount, tileAt, setTile, isSolid,
    T_EMPTY, T_SOLID, T_PLAT, T_SPIKE, T_CRATE, T_PAD
}
from "./tiles" import {
    TILE
}

// ── tuning ────────────────────────────────────────────────────────────────────
//
// Lengths are in world pixels and a tile is 64 of them, so every number here is
// really a number of tiles. Changing TILE alone would change the game's feel;
// these move with it.

pub let GRAVITY: f64 = 4300.0

pub let MAX_FALL: f64 = 1880.0

pub let RUN_SPEED: f64 = 611.0

pub let RUN_ACCEL: f64 = 5200.0

pub let AIR_ACCEL: f64 = 3500.0

pub let GROUND_FRICTION: f64 = 5800.0

pub let AIR_DRAG: f64 = 1240.0

// Sized so a three-tile step clears with room to spare. At 1320 the peak was
// 193 px against the 192 a three-tile climb needs — a pixel-perfect jump that
// looked like a wall you were simply not allowed past.
pub let JUMP_VEL: f64 = 1450.0

pub let JUMP_CUT: f64 = 0.42 // vy kept when the jump key is released early

// Both windows are wider than they were. The game asks for a lot of jumps and
// almost none of them are meant to be the hard part.
pub let COYOTE: f64 = 0.13

pub let BUFFER: f64 = 0.15

// Near the apex the arc is the part a player actually aims with, so it gets
// stretched: weaker gravity and stronger air control for a moment.
pub let APEX_SPEED: f64 = 220.0

pub let WALL_SLIDE_MAX: f64 = 331.0

pub let WALL_JUMP_VX: f64 = 720.0

pub let WALL_JUMP_VY: f64 = 1231.0

pub let WALL_LOCK: f64 = 0.15

pub let DASH_SPEED: f64 = 1580.0

pub let DASH_TIME: f64 = 0.145

pub let DASH_KEEP: f64 = 0.46 // fraction of dash speed left when it ends

pub let DASH_COOL: f64 = 0.14

pub let STOMP_BOUNCE: f64 = 1171.0

pub let PAD_BOUNCE: f64 = 2160.0

// The hitbox is three quarters of a tile square and the dog is drawn larger
// than it — the art overhangs the box on every side, so what looks like a near
// miss is a miss.
pub let PLAYER_W: f64 = 48.0

pub let PLAYER_H: f64 = 48.0

// Collision substep. A dash covers 1185 px/s, which at a 50 ms frame is more
// than a whole tile — resolving that in one step would tunnel straight through
// a wall, so movement is chopped into pieces smaller than a tile.
pub let STEP_MAX: f64 = 13.0

// ── the bark ──
//
// The one attack, and it works in both builds. As a chihuahua it clears what is
// right in front of your nose; as a shepherd it clears the room.

pub let BARK_COOL: f64 = 0.45

pub let BARK_TIME: f64 = 0.26 // how long the frame and the ring last

pub let BARK_R_CHI: f64 = 128.0

pub let BARK_R_SHEP: f64 = 224.0

// After a hit you are solid light for a moment and nothing can touch you. Long
// enough to walk out of a spike pit, which is exactly what it is for.
pub let INVULN: f64 = 1.7

pub let HURT_TIME: f64 = 0.45

pub let HURT_KNOCK_X: f64 = 400.0

pub let HURT_KNOCK_Y: f64 = 747.0

// How far the player may travel from the centre of the screen before the
// camera moves at all. Roughly two tiles across and one and a half down.
pub let DEAD_X: f64 = 130.0

pub let DEAD_Y: f64 = 96.0

// Where the player sits vertically once the camera has settled on the ground.
// Low in the frame on purpose: the interesting half of a platformer is the sky
// you are about to jump into, not the dirt you are standing on.
pub let REST_Y: f64 = 0.70

// Marking the hydrant. Long enough to read as a deliberate act, short enough
// that nobody resents standing still for it — and any jump or dash cuts it.
// Eating a bone is not instant. Long enough to see him swap, short enough that
// it never costs you a jump you had lined up.
pub let GROW_TIME: f64 = 0.55

pub let PEE_TIME: f64 = 1.0

// How far from the hydrant he plants himself, centre to centre.
pub let MARK_STANDOFF: f64 = 82.0

pub let FORM_CHI: i64 = 0

pub let FORM_SHEP: i64 = 1

pub let MOB_CAT: i64 = 0

pub let MOB_BIRD: i64 = 1

pub let PK_SHARD: i64 = 0

pub let PK_CORE: i64 = 1

pub let PK_BONE: i64 = 2

pub let ST_PLAY: i64 = 0

pub let ST_CLEAR: i64 = 1

pub let ST_DONE: i64 = 2

// ── entities ──────────────────────────────────────────────────────────────────

pub struct Player {
    x: f64,
    y: f64,
    vx: f64,
    vy: f64,
    onGround: bool,
    coyote: f64,
    buffer: f64,
    jumping: bool,
    wallDir: f64, // -1 wall to the left, +1 to the right, 0 none
    wallT: f64, // coyote time for the wall, same idea as for the ground
    lockT: f64, // horizontal input lockout right after a wall jump
    dashT: f64,
    dashCd: f64,
    dashes: i64,
    dashX: f64,
    dashY: f64,
    facing: f64,
    animT: f64,
    sqX: f64, // squash and stretch, springs back toward 1
    sqY: f64,
    form: i64,
    invT: f64, // invulnerable, and flickering while it lasts
    hurtT: f64,
    barkT: f64,
    barkCd: f64,
    peeT: f64,
    growT: f64,
    dead: bool,
    deadT: f64,
    spawnT: f64,
}

pub struct Mob {
    kind: i64,
    x: f64,
    y: f64,
    w: f64,
    h: f64,
    vx: f64,
    baseX: f64,
    baseY: f64,
    phase: f64,
    alive: bool,
    dieT: f64,
}

pub struct Pickup {
    x: f64,
    y: f64,
    kind: i64,
    taken: bool,
    t: f64,
}

// A hydrant. Touch it and it lights up; die and you come back to the last one
// you lit rather than to the start of the level.
pub struct Check {
    x: f64,
    y: f64,
    lit: bool,
    t: f64,
    wet: f64, // the puddle, which grows while it is being made and then dries
}

pub struct Part {
    x: f64,
    y: f64,
    vx: f64,
    vy: f64,
    life: f64,
    max: f64,
    r: f64,
    g: f64,
    b: f64,
    size: f64,
    grav: f64,
}

// A frozen copy of the player, left behind by a dash and fading out. Cheap, and
// it is most of what makes a dash read as fast rather than as teleporting.
pub struct Ghost {
    x: f64,
    y: f64,
    t: f64,
    frame: i64,
    flip: bool,
}

pub struct World {
    lvl: Level,
    lvlIdx: i64,
    p: Player,
    mobs: Vec<Mob>,
    pk: Vec<Pickup>,
    checks: Vec<Check>,
    parts: Vec<Part>,
    ghosts: Vec<Ghost>,
    camX: f64,
    camY: f64,
    vw: f64,
    vh: f64,
    shake: f64,
    flash: f64,
    hitstop: f64,
    // where the player comes back, which is the last hydrant they lit
    spawnX: f64,
    spawnY: f64,
    // the live bark ring, for the renderer
    barkX: f64,
    barkY: f64,
    barkRingT: f64,
    barkR: f64,
    peeIdx: i64,
    peeStandX: f64, // where he shuffles to, so his own sprite is not on top of it
    shards: i64,
    shardTotal: i64,
    banked: i64,
    cores: i64,
    deaths: i64,
    time: f64,
    t: f64,
    state: i64,
    clearT: f64,
    // one-frame events, read by the audio layer and then forgotten
    evJump: bool,
    evLand: bool,
    evDash: bool,
    evShard: bool,
    evCore: bool,
    evStomp: bool,
    evDie: bool,
    evGoal: bool,
    evPad: bool,
    evBreak: bool,
    evWall: bool,
    evBark: bool,
    evBone: bool,
    evHurt: bool,
    evCheck: bool,
    evPee: bool,
}

// ── construction ──────────────────────────────────────────────────────────────

fn playerAt(x: f64, y: f64, form: i64): Player {
    return Player {
        x: x - PLAYER_W * 0.5, y: y - PLAYER_H,
        vx: 0.0, vy: 0.0,
        onGround: false, coyote: 0.0, buffer: 0.0, jumping: false,
        wallDir: 0.0, wallT: 0.0, lockT: 0.0,
        dashT: 0.0, dashCd: 0.0, dashes: 1, dashX: 1.0, dashY: 0.0,
        facing: 1.0, animT: 0.0, sqX: 1.0, sqY: 1.0,
        form: form, invT: 0.0, hurtT: 0.0, barkT: 0.0, barkCd: 0.0, peeT: 0.0, growT: 0.0,
        dead: false, deadT: 0.0, spawnT: 0.55,
    }
}

fn spawnEntities(w: &mut World) {
    w.mobs = Vec.new()
    w.pk = Vec.new()
    w.checks = Vec.new()
    var i = 0
    while i < w.lvl.catX.len {
        let m = Mob {
            kind: MOB_CAT,
            x: w.lvl.catX[i] - 28.0, y: w.lvl.catY[i] - 8.0,
            w: 56.0, h: 40.0,
            vx: 99.0, baseX: w.lvl.catX[i], baseY: w.lvl.catY[i],
            phase: (i as f64) * 1.7, alive: true, dieT: 0.0,
        }
        w.mobs.push(m)
        i = i + 1
    }
    i = 0
    while i < w.lvl.birdX.len {
        let m = Mob {
            kind: MOB_BIRD,
            x: w.lvl.birdX[i] - 28.0, y: w.lvl.birdY[i] - 20.0,
            w: 56.0, h: 40.0,
            vx: 0.0, baseX: w.lvl.birdX[i], baseY: w.lvl.birdY[i],
            phase: (i as f64) * 2.1, alive: true, dieT: 0.0,
        }
        w.mobs.push(m)
        i = i + 1
    }
    i = 0
    while i < w.lvl.shardX.len {
        let s = Pickup {
            x: w.lvl.shardX[i], y: w.lvl.shardY[i], kind: PK_SHARD, taken: false, t: (i as f64) * 0.5
        }
        w.pk.push(s)
        i = i + 1
    }
    i = 0
    while i < w.lvl.coreX.len {
        let s = Pickup {
            x: w.lvl.coreX[i], y: w.lvl.coreY[i], kind: PK_CORE, taken: false, t: (i as f64) * 0.9
        }
        w.pk.push(s)
        i = i + 1
    }
    i = 0
    while i < w.lvl.boneX.len {
        let s = Pickup {
            x: w.lvl.boneX[i], y: w.lvl.boneY[i], kind: PK_BONE, taken: false, t: (i as f64) * 0.7
        }
        w.pk.push(s)
        i = i + 1
    }
    i = 0
    while i < w.lvl.checkX.len {
        let ck = Check {
            x: w.lvl.checkX[i], y: w.lvl.checkY[i], lit: false, t: 0.0, wet: 0.0
        }
        w.checks.push(ck)
        i = i + 1
    }
    w.shardTotal = w.lvl.shardX.len
}

pub fn worldNew(lvlIdx: i64, vw: f64, vh: f64): World {
    let l = levelLoad(lvlIdx)
    let sx = l.spawnX
    let sy = l.spawnY
    var w = World {
        lvl: l, lvlIdx: lvlIdx,
        p: playerAt(sx, sy, FORM_CHI),
        mobs: Vec.new(), pk: Vec.new(), checks: Vec.new(), parts: Vec.new(), ghosts: Vec.new(),
        camX: 0.0, camY: 0.0, vw: vw, vh: vh,
        shake: 0.0, flash: 0.0, hitstop: 0.0,
        spawnX: sx, spawnY: sy,
        barkX: 0.0, barkY: 0.0, barkRingT: 0.0, barkR: 0.0, peeIdx: 0 - 1, peeStandX: 0.0,
        shards: 0, shardTotal: 0, banked: 0, cores: 0, deaths: 0,
        time: 0.0, t: 0.0, state: ST_PLAY, clearT: 0.0,
        evJump: false, evLand: false, evDash: false, evShard: false, evCore: false,
        evStomp: false, evDie: false, evGoal: false, evPad: false, evBreak: false,
        evWall: false, evBark: false, evBone: false, evHurt: false, evCheck: false,
        evPee: false,
    }
    spawnEntities(&mut w)
    centreCamera(&mut w)
    return w
}

// Load a level in place, keeping the run's totals.
pub fn worldGoto(w: &mut World, n: i64) {
    w.lvlIdx = n
    w.lvl = levelLoad(n)
    w.spawnX = w.lvl.spawnX
    w.spawnY = w.lvl.spawnY
    w.p = playerAt(w.spawnX, w.spawnY, FORM_CHI)
    w.parts = Vec.new()
    w.ghosts = Vec.new()
    w.shards = 0
    w.state = ST_PLAY
    w.clearT = 0.0
    w.barkRingT = 0.0
    spawnEntities(&mut w)
    centreCamera(&mut w)
}

// Restart after a death, at the last hydrant rather than at the start of the
// level. The tiles are reloaded and the enemies come back; the hydrants that
// were lit stay lit, so the ground you have covered stays covered.
pub fn worldRetry(w: &mut World) {
    let sx = w.spawnX
    let sy = w.spawnY
    var lit: Vec<bool> = Vec.new()
    var i = 0
    while i < w.checks.len {
        lit.push(w.checks[i].lit)
        i = i + 1
    }
    w.lvl = levelLoad(w.lvlIdx)
    w.p = playerAt(sx, sy, FORM_CHI)
    w.shards = 0
    w.parts = Vec.new()
    w.ghosts = Vec.new()
    w.barkRingT = 0.0
    spawnEntities(&mut w)
    i = 0
    while i < w.checks.len && i < lit.len {
        w.checks[i].lit = lit[i]
        i = i + 1
    }
    centreCamera(&mut w)
}

pub fn centreCamera(w: &mut World) {
    w.camX = clampCamX(w, w.p.x + PLAYER_W * 0.5 - w.vw * 0.5)
    w.camY = clampCamY(w, w.p.y + PLAYER_H * 0.5 - w.vh * REST_Y)
}

fn clampCamX(w: &World, x: f64): f64 {
    let maxX = (w.lvl.cols as f64) * TILE - w.vw
    if maxX <= 0.0 {
        return maxX * 0.5
    }
    return Math.clampF64(x, 0.0, maxX)
}

fn clampCamY(w: &World, y: f64): f64 {
    let maxY = (w.lvl.rows as f64) * TILE - w.vh
    if maxY <= 0.0 {
        return maxY * 0.5
    }
    return Math.clampF64(y, 0.0, maxY)
}

// ── particles ─────────────────────────────────────────────────────────────────

pub fn puff(w: &mut World, x: f64, y: f64, n: i64, spread: f64, r: f64, g: f64, b: f64, size: f64, grav: f64) {
    for i in 0..n {
        let life = Random.floatRange(0.22, 0.55)
        let pt = Part {
            x: x, y: y,
            vx: Random.floatRange(0.0 - spread, spread),
            vy: Random.floatRange(0.0 - spread, spread * 0.4),
            life: life, max: life,
            r: r, g: g, b: b,
            size: size * Random.floatRange(0.6, 1.4),
            grav: grav,
        }
        w.parts.push(pt)
    }
}

fn burst(w: &mut World, x: f64, y: f64, n: i64, speed: f64, r: f64, g: f64, b: f64) {
    for i in 0..n {
        let a = Random.floatRange(0.0, 6.2831853)
        let s = Random.floatRange(speed * 0.35, speed)
        let life = Random.floatRange(0.3, 0.75)
        let pt = Part {
            x: x, y: y,
            vx: Math.cos(a) * s, vy: Math.sin(a) * s,
            life: life, max: life,
            r: r, g: g, b: b,
            size: Random.floatRange(1.6, 3.4),
            grav: 760.0,
        }
        w.parts.push(pt)
    }
}

fn stepParts(w: &mut World, dt: f64) {
    var i = 0
    while i < w.parts.len {
        w.parts[i].life = w.parts[i].life - dt
        if w.parts[i].life <= 0.0 {
            let _ = w.parts.remove(i)
        } else {
            w.parts[i].vy = w.parts[i].vy + w.parts[i].grav * dt
            w.parts[i].x = w.parts[i].x + w.parts[i].vx * dt
            w.parts[i].y = w.parts[i].y + w.parts[i].vy * dt
            i = i + 1
        }
    }
    var j = 0
    while j < w.ghosts.len {
        w.ghosts[j].t = w.ghosts[j].t - dt
        if w.ghosts[j].t <= 0.0 {
            let _ = w.ghosts.remove(j)
        } else {
            j = j + 1
        }
    }
}

// ── collision ─────────────────────────────────────────────────────────────────

fn cellOf(v: f64): i64 {
    return Math.floor(v / TILE) as i64
}

// One axis, one substep. Returns true if something was hit.
fn stepX(p: &mut Player, l: &Level, dx: f64): bool {
    p.x = p.x + dx
    if dx == 0.0 {
        return false
    }
    let y0 = cellOf(p.y)
    let y1 = cellOf(p.y + PLAYER_H - 0.01)
    if dx > 0.0 {
        let cx = cellOf(p.x + PLAYER_W - 0.01)
        var hit = false
        for cy in y0..y1 + 1 {
            if isSolid(l, cx, cy) {
                hit = true
            }
        }
        if hit {
            p.x = (cx as f64) * TILE - PLAYER_W
            p.vx = 0.0
            return true
        }
    } else {
        let cx = cellOf(p.x)
        var hit = false
        for cy in y0..y1 + 1 {
            if isSolid(l, cx, cy) {
                hit = true
            }
        }
        if hit {
            p.x = ((cx + 1) as f64) * TILE
            p.vx = 0.0
            return true
        }
    }
    return false
}

fn stepY(p: &mut Player, l: &Level, dy: f64, dropThrough: bool): i64 {
    let prevBottom = p.y + PLAYER_H
    p.y = p.y + dy
    if dy == 0.0 {
        return 0
    }
    let x0 = cellOf(p.x)
    let x1 = cellOf(p.x + PLAYER_W - 0.01)
    if dy > 0.0 {
        let cy = cellOf(p.y + PLAYER_H - 0.01)
        var hit = false
        var pad = false
        for cx in x0..x1 + 1 {
            let v = tileAt(l, cx, cy)
            if v == T_SOLID || v == T_CRATE {
                hit = true
            } else if v == T_PAD {
                hit = true
                pad = true
            } else if v == T_PLAT && !dropThrough && prevBottom <= (cy as f64) * TILE + 2.0 {
                // One-way: only a foot that was already above the surface lands
                // on it, so you rise through a platform and stand on it coming
                // back down.
                hit = true
            }
        }
        if hit {
            p.y = (cy as f64) * TILE - PLAYER_H
            p.vy = 0.0
            p.onGround = true
            if pad {
                return 2
            }
            return 1
        }
    } else {
        let cy = cellOf(p.y)
        var hit = false
        for cx in x0..x1 + 1 {
            if isSolid(l, cx, cy) {
                hit = true
            }
        }
        if hit {
            p.y = ((cy + 1) as f64) * TILE
            p.vy = 0.0
            return 0 - 1
        }
    }
    return 0
}

fn touchingWall(p: &Player, l: &Level, dir: f64): bool {
    let probe = if dir > 0.0 {
        p.x + PLAYER_W + 1.0
    } else {
        p.x - 1.0
    }
    let cx = cellOf(probe)
    // Ignore the top and bottom few pixels so a wall does not "grab" from a
    // corner the player is only clipping.
    let y0 = cellOf(p.y + 5.0)
    let y1 = cellOf(p.y + PLAYER_H - 8.0)
    for cy in y0..y1 + 1 {
        if isSolid(l, cx, cy) {
            return true
        }
    }
    return false
}

fn overlapsSpike(p: &Player, l: &Level): bool {
    // Spikes get a forgiving box: the hitbox is inset a good third of the body
    // all round, so brushing the edge of a tooth is not a hit.
    let x0 = cellOf(p.x + 15.0)
    let x1 = cellOf(p.x + PLAYER_W - 16.0)
    let y0 = cellOf(p.y + 15.0)
    let y1 = cellOf(p.y + PLAYER_H - 5.0)
    for cy in y0..y1 + 1 {
        for cx in x0..x1 + 1 {
            if tileAt(l, cx, cy) == T_SPIKE {
                return true
            }
        }
    }
    return false
}

fn breakCrateAt(w: &mut World, cx: i64, cy: i64) {
    if tileAt(w.lvl, cx, cy) != T_CRATE {
        return
    }
    setTile(&mut w.lvl, cx, cy, T_EMPTY)
    let px = ((cx as f64) + 0.5) * TILE
    let py = ((cy as f64) + 0.5) * TILE
    burst(&mut w, px, py, 16, 520.0, 0.95, 0.55, 0.18)
    w.shake = w.shake + 5.0
    w.evBreak = true
}

// Break any crate the player is driving into, either dashing or head-first.
fn breakCrates(w: &mut World) {
    let dashing = w.p.dashT > 0.0
    let rising = w.p.vy < 0.0 - 30.0
    if !dashing && !rising {
        return
    }
    let x0 = cellOf(w.p.x - 4.0)
    let x1 = cellOf(w.p.x + PLAYER_W + 4.0)
    let y0 = cellOf(w.p.y - 4.0)
    let y1 = cellOf(w.p.y + PLAYER_H + 4.0)
    for cy in y0..y1 + 1 {
        for cx in x0..x1 + 1 {
            breakCrateAt(&mut w, cx, cy)
        }
    }
}

// ── the player ────────────────────────────────────────────────────────────────

fn killPlayer(w: &mut World) {
    if w.p.dead {
        return
    }
    w.p.dead = true
    w.p.deadT = 0.85
    w.deaths = w.deaths + 1
    w.shake = w.shake + 16.0
    w.flash = 0.9
    w.hitstop = 0.09
    burst(&mut w, w.p.x + PLAYER_W * 0.5, w.p.y + PLAYER_H * 0.5, 34, 840.0, 1.6, 0.35, 0.55)
    w.evDie = true
}

// One hit. As a shepherd it costs you the shepherd; as a chihuahua it costs you
// the life. Either way you are thrown clear and untouchable for a moment, which
// is what stops a spike pit from killing you twice in three frames.
fn hurtPlayer(w: &mut World, fromX: f64) {
    if w.p.dead || w.p.invT > 0.0 {
        return
    }
    if w.p.form == FORM_SHEP {
        w.p.form = FORM_CHI
        w.p.invT = INVULN
        w.p.hurtT = HURT_TIME
        w.p.dashT = 0.0
        w.p.peeT = 0.0
        w.p.vy = 0.0 - HURT_KNOCK_Y
        let away = if w.p.x + PLAYER_W * 0.5 < fromX {
            0.0 - 1.0
        } else {
            1.0
        }
        w.p.vx = away * HURT_KNOCK_X
        w.p.onGround = false
        w.p.jumping = false
        w.shake = w.shake + 12.0
        w.flash = Math.maxF64(w.flash, 0.55)
        w.hitstop = 0.07
        burst(&mut w, w.p.x + PLAYER_W * 0.5, w.p.y + PLAYER_H * 0.5, 24, 640.0, 1.5, 0.75, 0.25)
        w.evHurt = true
    } else {
        killPlayer(&mut w)
    }
}

fn barkRadius(w: &World): f64 {
    if w.p.form == FORM_SHEP {
        return BARK_R_SHEP
    }
    return BARK_R_CHI
}

fn doBark(w: &mut World) {
    let r = barkRadius(w)
    let cx = w.p.x + PLAYER_W * 0.5 + w.p.facing * 10.0
    let cy = w.p.y + PLAYER_H * 0.45
    w.p.barkT = BARK_TIME
    w.p.barkCd = BARK_COOL
    w.barkX = cx
    w.barkY = cy
    w.barkRingT = BARK_TIME
    w.barkR = r
    w.shake = w.shake + 3.0 + r * 0.02
    w.evBark = true

    // The ring is drawn from barkT, but a few particles along it sell the front
    // of the wave better than the ring alone.
    for i in 0..14 {
        let a = Random.floatRange(0.0 - 1.1, 1.1)
        let sp = Random.floatRange(r * 1.6, r * 3.0)
        let life = Random.floatRange(0.16, 0.34)
        let pt = Part {
            x: cx, y: cy,
            vx: Math.cos(a) * sp * w.p.facing, vy: Math.sin(a) * sp * 0.55,
            life: life, max: life,
            r: 1.30, g: 1.05, b: 0.45,
            size: Random.floatRange(1.8, 3.6),
            grav: 0.0,
        }
        w.parts.push(pt)
    }

    var i = 0
    while i < w.mobs.len {
        if w.mobs[i].alive {
            let mx = w.mobs[i].x + w.mobs[i].w * 0.5
            let my = w.mobs[i].y + w.mobs[i].h * 0.5
            let dx = mx - cx
            let dy = my - cy
            if dx * dx + dy * dy <= r * r {
                killMob(&mut w, i, 1.5, 1.1, 0.35)
            }
        }
        i = i + 1
    }

    // A bark loosens crates too — most of the bones in the ground are behind
    // one, and barking at the dirt is how you dig them out.
    let cx0 = cellOf(cx - r)
    let cx1 = cellOf(cx + r)
    let cy0 = cellOf(cy - r)
    let cy1 = cellOf(cy + r)
    for gy in cy0..cy1 + 1 {
        for gx in cx0..cx1 + 1 {
            let tx = ((gx as f64) + 0.5) * TILE - cx
            let ty = ((gy as f64) + 0.5) * TILE - cy
            if tx * tx + ty * ty <= r * r {
                breakCrateAt(&mut w, gx, gy)
            }
        }
    }
}

// Only the splash. The stream itself is drawn as an explicit arc in the
// renderer rather than simulated: a spray of physics particles piles up into a
// dust cloud at this scale, and what this wants is a line you can follow.
fn peeStream(w: &mut World) {
    if w.peeIdx < 0 || w.peeIdx >= w.checks.len {
        return
    }
    if Random.float() > 0.3 {
        return
    }
    let hx = w.checks[w.peeIdx].x
    let hy = w.checks[w.peeIdx].y + 26.0
    let sp = Part {
        x: hx + Random.floatRange(0.0 - 8.0, 8.0), y: hy,
        vx: Random.floatRange(0.0 - 45.0, 45.0),
        vy: Random.floatRange(0.0 - 80.0, 0.0 - 30.0),
        life: 0.24, max: 0.24,
        r: 0.46, g: 0.35, b: 0.06,
        size: Random.floatRange(0.9, 1.5),
        grav: 900.0,
    }
    w.parts.push(sp)
}

fn updatePlayer(w: &mut World, dt: f64, moveX: f64, down: bool, jump: bool, jumpHeld: bool, dash: bool, bark: bool) {
    // Ground state is recomputed every frame from the collision pass below.
    let wasGround = w.p.onGround
    w.p.onGround = false

    if w.p.coyote > 0.0 {
        w.p.coyote = w.p.coyote - dt
    }
    if w.p.wallT > 0.0 {
        w.p.wallT = w.p.wallT - dt
    }
    if w.p.lockT > 0.0 {
        w.p.lockT = w.p.lockT - dt
    }
    if w.p.dashCd > 0.0 {
        w.p.dashCd = w.p.dashCd - dt
    }
    if w.p.spawnT > 0.0 {
        w.p.spawnT = w.p.spawnT - dt
    }
    if w.p.invT > 0.0 {
        w.p.invT = w.p.invT - dt
    }
    if w.p.hurtT > 0.0 {
        w.p.hurtT = w.p.hurtT - dt
    }
    if w.p.barkT > 0.0 {
        w.p.barkT = w.p.barkT - dt
    }
    if w.p.barkCd > 0.0 {
        w.p.barkCd = w.p.barkCd - dt
    }
    if w.p.growT > 0.0 {
        w.p.growT = w.p.growT - dt
    }
    if w.p.peeT > 0.0 {
        // wasGround, NOT w.p.onGround: onGround is cleared at the top of this
        // function and only recomputed after the collision pass below, so
        // testing it here always reads false and cancelled the marking on the
        // frame after it started.
        if jump || dash || !wasGround {
            w.p.peeT = 0.0
        } else {
            w.p.peeT = w.p.peeT - dt
            // Stop dead rather than sliding out from under the stream. The
            // input is already ignored below; this kills the momentum he
            // arrived with.
            w.p.vx = w.p.vx * Math.maxF64(0.0, 1.0 - dt * 16.0)
            // Shuffle into position. Goes through stepX so a hydrant tucked
            // against a wall cannot push him into the rock.
            let want = w.peeStandX - w.p.x
            if Math.abs(want) > 1.5 {
                let _ = stepX(&mut w.p, w.lvl, Math.clampF64(want, 0.0 - 7.0, 7.0))
            }
            peeStream(&mut w)
        }
    }
    w.p.buffer = w.p.buffer - dt
    if jump {
        w.p.buffer = BUFFER
    }

    if bark && w.p.barkCd <= 0.0 {
        doBark(&mut w)
    }

    var mx = moveX
    if w.p.peeT > 0.0 {
        // Standing still is the animation. Letting the stick drive here would
        // slide the dog out from under his own stream.
        mx = 0.0
    }
    if w.p.lockT > 0.0 {
        // After a wall jump the stick is ignored for a moment, or holding
        // "into the wall" would cancel the push-off and stick you to it.
        mx = 0.0
    }
    if mx != 0.0 {
        w.p.facing = mx
    }

    // ── dash ──
    if w.p.dashT > 0.0 {
        w.p.dashT = w.p.dashT - dt
        w.p.vx = w.p.dashX * DASH_SPEED
        w.p.vy = w.p.dashY * DASH_SPEED
        if w.p.dashT <= 0.0 {
            w.p.vx = w.p.vx * DASH_KEEP
            w.p.vy = w.p.vy * DASH_KEEP * 0.5
            w.p.dashCd = DASH_COOL
        }
        // ghosts, one every other frame or so
        if w.ghosts.len < 14 {
            let g = Ghost {
                x: w.p.x, y: w.p.y, t: 0.22, frame: 7, flip: w.p.facing < 0.0
            }
            w.ghosts.push(g)
        }
    } else if dash && w.p.dashes > 0 && w.p.dashCd <= 0.0 {
        var dx = mx
        var dy = 0.0
        if down {
            dy = 1.0
        }
        // Eight-way, but a dash with no direction held goes where you face —
        // never nowhere.
        if dx == 0.0 && dy == 0.0 {
            dx = w.p.facing
        }
        let len = Math.sqrt(dx * dx + dy * dy)
        w.p.dashX = dx / len
        w.p.dashY = dy / len
        w.p.dashT = DASH_TIME
        w.p.dashes = w.p.dashes - 1
        w.p.sqX = 1.45
        w.p.sqY = 0.62
        w.shake = w.shake + 4.0
        w.evDash = true
        puff(&mut w, w.p.x + PLAYER_W * 0.5, w.p.y + PLAYER_H * 0.5, 12, 380.0, 1.5, 0.9, 0.5, 2.4, 80.0)
    }

    let dashing = w.p.dashT > 0.0

    if !dashing {
        // ── horizontal ──
        let accel = if wasGround {
            RUN_ACCEL
        } else if Math.abs(w.p.vy) < APEX_SPEED {
            AIR_ACCEL * 1.3 // the apex is where a jump is aimed
        } else {
            AIR_ACCEL
        }
        if mx != 0.0 {
            let target = mx * RUN_SPEED
            if w.p.vx < target {
                w.p.vx = Math.minF64(w.p.vx + accel * dt, target)
            } else if w.p.vx > target {
                w.p.vx = Math.maxF64(w.p.vx - accel * dt, target)
            }
        } else {
            let drag = if wasGround {
                GROUND_FRICTION
            } else {
                AIR_DRAG
            }
            if w.p.vx > 0.0 {
                w.p.vx = Math.maxF64(0.0, w.p.vx - drag * dt)
            } else {
                w.p.vx = Math.minF64(0.0, w.p.vx + drag * dt)
            }
        }

        // ── gravity ──
        var g = GRAVITY
        if Math.abs(w.p.vy) < APEX_SPEED && !wasGround {
            g = g * 0.62
        }
        if w.p.vy > 0.0 {
            g = g * 1.12 // fall a little faster than you rise
        }
        w.p.vy = Math.minF64(w.p.vy + g * dt, MAX_FALL)

        // ── wall slide ──
        let sliding = !wasGround && w.p.wallDir != 0.0 && w.p.vy > 0.0 && mx * w.p.wallDir > 0.0
        if sliding {
            w.p.vy = Math.minF64(w.p.vy, WALL_SLIDE_MAX)
            if Random.float() < 0.35 {
                let sx = if w.p.wallDir > 0.0 {
                    w.p.x + PLAYER_W
                } else {
                    w.p.x
                }
                puff(&mut w, sx, w.p.y + Random.floatRange(12.0, 40.0), 1, 60.0, 0.9, 0.9, 1.2, 1.6, 180.0)
            }
        }

        // ── jump ──
        if w.p.buffer > 0.0 {
            if wasGround || w.p.coyote > 0.0 {
                w.p.vy = 0.0 - JUMP_VEL
                w.p.jumping = true
                w.p.buffer = 0.0
                w.p.coyote = 0.0
                w.p.sqX = 0.72
                w.p.sqY = 1.38
                w.evJump = true
                puff(&mut w, w.p.x + PLAYER_W * 0.5, w.p.y + PLAYER_H, 8, 220.0, 0.8, 0.85, 1.1, 2.2, 520.0)
            } else if w.p.wallT > 0.0 && w.p.wallDir != 0.0 {
                w.p.vy = 0.0 - WALL_JUMP_VY
                w.p.vx = 0.0 - w.p.wallDir * WALL_JUMP_VX
                w.p.facing = 0.0 - w.p.wallDir
                w.p.lockT = WALL_LOCK
                w.p.jumping = true
                w.p.buffer = 0.0
                w.p.wallT = 0.0
                w.p.dashes = 1
                w.p.sqX = 0.78
                w.p.sqY = 1.30
                w.evWall = true
                let sx = if w.p.wallDir > 0.0 {
                    w.p.x + PLAYER_W
                } else {
                    w.p.x
                }
                puff(&mut w, sx, w.p.y + PLAYER_H * 0.6, 12, 340.0, 1.0, 0.95, 1.4, 2.4, 400.0)
            }
        }
        // Releasing the key early cuts the rise — the whole of variable jump
        // height is this one line.
        if !jumpHeld && w.p.jumping && w.p.vy < 0.0 {
            w.p.vy = w.p.vy * JUMP_CUT
            w.p.jumping = false
        }
        if w.p.vy >= 0.0 {
            w.p.jumping = false
        }
    }

    // ── move, in substeps no larger than most of a tile ──
    let dx = w.p.vx * dt
    let dy = w.p.vy * dt
    let dist = Math.maxF64(Math.abs(dx), Math.abs(dy))
    var steps = (dist / STEP_MAX) as i64
    if steps < 1 {
        steps = 1
    }
    if steps > 24 {
        steps = 24
    }
    let sdx = dx / (steps as f64)
    let sdy = dy / (steps as f64)
    var landed = 0
    for i in 0..steps {
        let hitX = stepX(&mut w.p, w.lvl, sdx)
        if hitX && dashing {
            // A dash into a wall ends there rather than scraping along it.
            w.p.dashT = 0.0
            w.p.dashCd = DASH_COOL
        }
        let r = stepY(&mut w.p, w.lvl, sdy, down)
        if r > landed {
            landed = r
        }
        if r < 0 && dashing {
            w.p.dashT = 0.0
        }
    }

    // ── after the move ──
    var wall = 0.0
    if touchingWall(w.p, w.lvl, 1.0) {
        wall = 1.0
    } else if touchingWall(w.p, w.lvl, -1.0) {
        wall = -1.0
    }
    w.p.wallDir = wall
    if wall != 0.0 && !w.p.onGround {
        w.p.wallT = COYOTE
        w.p.dashes = 1 // a wall refills the dash, same as the ground
    }

    if w.p.onGround {
        w.p.coyote = COYOTE
        w.p.dashes = 1
        if !wasGround {
            // landing
            let speed = Math.abs(w.p.vx)
            w.p.sqX = 1.28
            w.p.sqY = 0.74
            w.evLand = true
            puff(&mut w, w.p.x + PLAYER_W * 0.5, w.p.y + PLAYER_H, 7, 180.0 + speed * 0.2, 0.85, 0.9, 1.15, 2.2, 640.0)
        }
    }

    if landed == 2 {
        // launch pad
        w.p.vy = 0.0 - PAD_BOUNCE
        w.p.onGround = false
        w.p.jumping = false
        w.p.dashes = 1
        w.p.sqX = 0.62
        w.p.sqY = 1.55
        w.shake = w.shake + 7.0
        w.evPad = true
        puff(&mut w, w.p.x + PLAYER_W * 0.5, w.p.y + PLAYER_H, 18, 520.0, 1.7, 1.2, 0.35, 2.8, 520.0)
    }

    breakCrates(&mut w)

    // running dust
    if w.p.onGround && Math.abs(w.p.vx) > 380.0 && Random.float() < 0.5 {
        puff(&mut w, w.p.x + PLAYER_W * 0.5, w.p.y + PLAYER_H - 1.0, 1, 80.0, 0.7, 0.75, 0.95, 1.8, 400.0)
    }

    // squash springs back
    w.p.sqX = w.p.sqX + (1.0 - w.p.sqX) * Math.minF64(1.0, dt * 13.0)
    w.p.sqY = w.p.sqY + (1.0 - w.p.sqY) * Math.minF64(1.0, dt * 13.0)
    w.p.animT = w.p.animT + dt

    if overlapsSpike(w.p, w.lvl) {
        // Thrown back the way you came: a spike you walked into sideways is a
        // hit and a shove, not the end of the run.
        hurtPlayer(&mut w, w.p.x + PLAYER_W * 0.5 + w.p.facing * TILE)
    }
    if w.p.y > (w.lvl.rows as f64) * TILE + 160.0 {
        killPlayer(&mut w)
    }
}

// ── enemies ───────────────────────────────────────────────────────────────────

fn updateMobs(w: &mut World, dt: f64) {
    var i = 0
    while i < w.mobs.len {
        if !w.mobs[i].alive {
            w.mobs[i].dieT = w.mobs[i].dieT - dt
            i = i + 1
        } else if w.mobs[i].kind == MOB_CAT {
            let nx = w.mobs[i].x + w.mobs[i].vx * dt
            // Turn at a wall, and turn at a ledge: a cat that walks off its own
            // platform is a cat the player never meets.
            let aheadX = if w.mobs[i].vx > 0.0 {
                nx + w.mobs[i].w + 4.0
            } else {
                nx - 4.0
            }
            let cxAhead = cellOf(aheadX)
            let cyBody = cellOf(w.mobs[i].y + w.mobs[i].h * 0.5)
            let cyBelow = cellOf(w.mobs[i].y + w.mobs[i].h + 8.0)
            if isSolid(w.lvl, cxAhead, cyBody) || !isSolid(w.lvl, cxAhead, cyBelow) {
                w.mobs[i].vx = 0.0 - w.mobs[i].vx
            } else {
                w.mobs[i].x = nx
            }
            w.mobs[i].phase = w.mobs[i].phase + dt * 7.0
            i = i + 1
        } else {
            // bird: a slow sweep with a bob, entirely scripted off its phase so
            // it never needs collision
            w.mobs[i].phase = w.mobs[i].phase + dt * 1.15
            w.mobs[i].x = w.mobs[i].baseX - 28.0 + Math.sin(w.mobs[i].phase) * 192.0
            w.mobs[i].y = w.mobs[i].baseY - 20.0 + Math.sin(w.mobs[i].phase * 2.3) * 29.0
            i = i + 1
        }
    }
    // reap the long-dead
    var j = 0
    while j < w.mobs.len {
        if !w.mobs[j].alive && w.mobs[j].dieT <= 0.0 {
            let _ = w.mobs.remove(j)
        } else {
            j = j + 1
        }
    }
}

fn killMob(w: &mut World, i: i64, r: f64, g: f64, b: f64) {
    w.mobs[i].alive = false
    w.mobs[i].dieT = 0.35
    burst(&mut w, w.mobs[i].x + w.mobs[i].w * 0.5, w.mobs[i].y + w.mobs[i].h * 0.5, 22, 660.0, r, g, b)
    w.shake = w.shake + 8.0
    w.hitstop = 0.055
    w.evStomp = true
}

fn hitMobs(w: &mut World) {
    if w.p.dead {
        return
    }
    let px0 = w.p.x
    let px1 = w.p.x + PLAYER_W
    let py0 = w.p.y
    let py1 = w.p.y + PLAYER_H
    var i = 0
    while i < w.mobs.len {
        if w.mobs[i].alive {
            let mx0 = w.mobs[i].x
            let mx1 = w.mobs[i].x + w.mobs[i].w
            let my0 = w.mobs[i].y
            let my1 = w.mobs[i].y + w.mobs[i].h
            if px1 > mx0 && px0 < mx1 && py1 > my0 && py0 < my1 {
                if w.p.dashT > 0.0 {
                    // A dash goes through anything. That is what makes the dash
                    // an answer to the bird rather than only a movement toy.
                    killMob(&mut w, i, 1.5, 0.9, 0.3)
                } else if w.mobs[i].kind == MOB_CAT && w.p.vy > 50.0 && py1 < my0 + 32.0 {
                    killMob(&mut w, i, 1.2, 0.5, 1.6)
                    w.p.vy = 0.0 - STOMP_BOUNCE
                    w.p.sqX = 1.3
                    w.p.sqY = 0.7
                    w.p.dashes = 1
                    w.p.jumping = true
                } else {
                    hurtPlayer(&mut w, mx0 + w.mobs[i].w * 0.5)
                }
            }
        }
        i = i + 1
    }
}

fn hitPickups(w: &mut World, dt: f64) {
    let px0 = w.p.x - 11.0
    let px1 = w.p.x + PLAYER_W + 11.0
    let py0 = w.p.y - 11.0
    let py1 = w.p.y + PLAYER_H + 11.0
    var i = 0
    while i < w.pk.len {
        w.pk[i].t = w.pk[i].t + dt
        if !w.pk[i].taken && !w.p.dead {
            let r = if w.pk[i].kind == PK_SHARD {
                19.0
            } else {
                29.0
            }
            if w.pk[i].x + r > px0 && w.pk[i].x - r < px1 && w.pk[i].y + r > py0 && w.pk[i].y - r < py1 {
                w.pk[i].taken = true
                if w.pk[i].kind == PK_CORE {
                    w.cores = w.cores + 1
                    w.flash = Math.maxF64(w.flash, 0.45)
                    w.shake = w.shake + 5.0
                    burst(&mut w, w.pk[i].x, w.pk[i].y, 26, 600.0, 0.5, 1.4, 1.7)
                    w.evCore = true
                } else if w.pk[i].kind == PK_BONE {
                    if w.p.form == FORM_CHI {
                        w.p.growT = GROW_TIME
                    }
                    w.p.form = FORM_SHEP
                    w.p.sqX = 0.70
                    w.p.sqY = 1.45
                    w.flash = Math.maxF64(w.flash, 0.75)
                    w.shake = w.shake + 9.0
                    burst(&mut w, w.pk[i].x, w.pk[i].y, 34, 720.0, 1.7, 1.5, 0.9)
                    w.evBone = true
                } else {
                    w.shards = w.shards + 1
                    burst(&mut w, w.pk[i].x, w.pk[i].y, 10, 400.0, 1.5, 1.0, 0.4)
                    w.evShard = true
                }
            }
        }
        i = i + 1
    }
}

fn hitChecks(w: &mut World, dt: f64) {
    var i = 0
    while i < w.checks.len {
        w.checks[i].t = w.checks[i].t + dt
        if i == w.peeIdx && w.p.peeT > 0.0 {
            w.checks[i].wet = Math.minF64(1.0, w.checks[i].wet + dt * 1.8)
        } else if w.checks[i].wet > 0.0 {
            w.checks[i].wet = Math.maxF64(0.0, w.checks[i].wet - dt * 0.10)
        }
        if !w.checks[i].lit && !w.p.dead {
            let dx = w.checks[i].x - (w.p.x + PLAYER_W * 0.5)
            let dy = w.checks[i].y - (w.p.y + PLAYER_H * 0.5)
            if Math.abs(dx) < 53.0 && Math.abs(dy) < 64.0 {
                w.checks[i].lit = true
                w.spawnX = w.checks[i].x
                w.spawnY = w.checks[i].y + 4.0
                w.flash = Math.maxF64(w.flash, 0.35)
                burst(&mut w, w.checks[i].x, w.checks[i].y - 21.0, 20, 440.0, 0.5, 1.3, 1.6)
                w.evCheck = true
                // Face away from it and lift a leg. A dog marks with his back to
                // the thing, so the facing is the opposite of the approach.
                if w.p.onGround {
                    w.p.peeT = PEE_TIME
                    w.peeIdx = i
                    // He is on one side of it; stay on that side, and stand far
                    // enough off that the hydrant is not hidden behind his own
                    // sprite. The art is much wider than the hitbox, so "next
                    // to it" has to mean most of a tile, not a few pixels.
                    let side = if dx > 0.0 {
                        0.0 - 1.0
                    } else {
                        1.0
                    }
                    w.p.facing = side
                    w.peeStandX = w.checks[i].x + side * MARK_STANDOFF - PLAYER_W * 0.5
                    w.evPee = true
                }
            }
        }
        i = i + 1
    }
}

fn hitGoal(w: &mut World) {
    if w.p.dead || w.state != ST_PLAY {
        return
    }
    let gx = w.lvl.goalX
    let gy = w.lvl.goalY
    if w.p.x + PLAYER_W > gx - 44.0 && w.p.x < gx + 44.0 && w.p.y + PLAYER_H > gy - 80.0 && w.p.y < gy + 60.0 {
        w.state = ST_CLEAR
        w.clearT = 1.6
        w.banked = w.banked + w.shards
        w.flash = 1.0
        w.evGoal = true
        burst(&mut w, gx, gy, 46, 840.0, 0.7, 1.6, 1.5)
    }
}

// ── frame ─────────────────────────────────────────────────────────────────────

fn clearEvents(w: &mut World) {
    w.evJump = false
    w.evLand = false
    w.evDash = false
    w.evShard = false
    w.evCore = false
    w.evStomp = false
    w.evDie = false
    w.evGoal = false
    w.evPad = false
    w.evBreak = false
    w.evWall = false
    w.evBark = false
    w.evBone = false
    w.evHurt = false
    w.evCheck = false
    w.evPee = false
}

pub fn worldUpdate(w: &mut World, dt: f64, moveX: f64, down: bool, jump: bool, jumpHeld: bool, dash: bool, bark: bool) {
    clearEvents(&mut w)
    w.t = w.t + dt
    if w.barkRingT > 0.0 {
        w.barkRingT = w.barkRingT - dt
    }

    // Hit stop: a few frames of frozen simulation on an impact. The screen keeps
    // drawing, so it reads as weight rather than as a dropped frame.
    if w.hitstop > 0.0 {
        w.hitstop = w.hitstop - dt
        stepParts(&mut w, dt * 0.25)
        w.shake = Math.maxF64(0.0, w.shake - dt * 26.0)
        return
    }

    w.shake = Math.maxF64(0.0, w.shake - dt * 42.0)
    w.flash = Math.maxF64(0.0, w.flash - dt * 2.6)

    if w.state == ST_CLEAR {
        w.clearT = w.clearT - dt
        stepParts(&mut w, dt)
        updateCamera(&mut w, dt)
        if w.clearT <= 0.0 {
            let next = w.lvlIdx + 1
            if next >= levelCount() {
                w.state = ST_DONE
            } else {
                worldGoto(&mut w, next)
            }
        }
        return
    }
    if w.state == ST_DONE {
        stepParts(&mut w, dt)
        updateCamera(&mut w, dt)
        return
    }

    w.time = w.time + dt

    if w.p.dead {
        w.p.deadT = w.p.deadT - dt
        stepParts(&mut w, dt)
        updateCamera(&mut w, dt)
        if w.p.deadT <= 0.0 {
            worldRetry(&mut w)
        }
        return
    }

    updatePlayer(&mut w, dt, moveX, down, jump, jumpHeld, dash, bark)
    updateMobs(&mut w, dt)
    hitMobs(&mut w)
    hitPickups(&mut w, dt)
    hitChecks(&mut w, dt)
    hitGoal(&mut w)
    stepParts(&mut w, dt)
    updateCamera(&mut w, dt)
}

fn updateCamera(w: &mut World, dt: f64) {
    let px = w.p.x + PLAYER_W * 0.5
    let py = w.p.y + PLAYER_H * 0.5
    let halfW = w.vw * 0.5
    let halfH = w.vh * 0.5

    // Horizontal: a dead zone in the middle of the screen. Inside it the camera
    // does not move at all — which is the whole point. A camera that leads the
    // player by their facing swings the entire world every time they tap the
    // other direction, and that is what made this feel like it was sliding
    // around underneath you. Outside the zone the player pushes the edge along.
    let camMidX = w.camX + halfW
    var tx = w.camX
    if px > camMidX + DEAD_X {
        tx = px - halfW - DEAD_X
    } else if px < camMidX - DEAD_X {
        tx = px - halfW + DEAD_X
    }

    // Vertical: the same idea with a taller box, so an ordinary jump never
    // moves the view. Standing on the ground the camera settles back to put the
    // floor a little below centre, slowly enough that it is never a lurch.
    let camMidY = w.camY + halfH
    var ty = w.camY
    if py > camMidY + DEAD_Y {
        ty = py - halfH - DEAD_Y
    } else if py < camMidY - DEAD_Y {
        ty = py - halfH + DEAD_Y
    }
    // On the ground the resting height wins outright. Easing the *target*
    // toward it and then easing the camera toward that target multiplies the
    // two rates together, and the view takes seconds to settle instead of a
    // third of one.
    if w.p.onGround {
        ty = py - w.vh * REST_Y
    }

    // The dead zone already decides when to move, so the smoothing only has to
    // take the edge off: fast enough that the player never outruns the view.
    // Settling to the resting height is the one motion allowed to be leisurely.
    let kx = Math.minF64(1.0, dt * 11.0)
    let ky = if w.p.onGround {
        Math.minF64(1.0, dt * 3.2)
    } else {
        Math.minF64(1.0, dt * 8.0)
    }
    w.camX = clampCamX(w, w.camX + (tx - w.camX) * kx)
    w.camY = clampCamY(w, w.camY + (ty - w.camY) * ky)
}

// Where the stream starts: the raised hip, which is at the tail end because he
// is standing with his back to the hydrant.
pub fn peeSourceX(w: &World): f64 {
    return w.p.x + PLAYER_W * 0.5 - w.p.facing * 20.0
}

pub fn peeSourceY(w: &World): f64 {
    return w.p.y + PLAYER_H * 0.52
}

// How far the bark ring has travelled, 0 at the nose and 1 at full radius.
pub fn barkPhase(w: &World): f64 {
    if w.barkRingT <= 0.0 {
        return 1.0
    }
    return Math.clampF64(1.0 - w.barkRingT / BARK_TIME, 0.0, 1.0)
}

// Which dog frame the player is in. Kept here rather than in the renderer
// because it is a fact about the simulation, not about how it is drawn.
pub fn dogFrameOf(w: &World): i64 {
    if w.p.hurtT > 0.0 {
        return 10
    }
    if w.p.peeT > 0.0 && w.p.onGround {
        return 11
    }
    if w.p.barkT > 0.0 && w.p.onGround {
        return 9
    }
    if w.p.dashT > 0.0 {
        return 7
    }
    if !w.p.onGround {
        if w.p.wallDir != 0.0 && w.p.vy > 0.0 {
            return 8
        }
        if w.p.vy < 0.0 {
            return 5
        }
        return 6
    }
    if Math.abs(w.p.vx) > 36.0 {
        // cycle rate follows speed, so the paws stay planted at any pace
        let rate = 5.0 + Math.abs(w.p.vx) * 0.019
        let k = ((w.p.animT * rate) as i64) % 4
        return 1 + k
    }
    return 0
}
