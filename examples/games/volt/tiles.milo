// Terrain tiles, generated at startup. 16 art pixels square, drawn at ART, so
// a tile is 64 screen pixels and the art grid and the collision grid are the
// same grid — there is no sub-tile alignment to get wrong.
//
// Ground comes in two variants picked by what is above it: a capped tile with
// grass on top, and a buried dirt tile. That is the whole autotiler, and at
// this scale it is enough — the grass is what makes a surface read as one you
// can stand on.

from "std/math" import {
    Math
}
from "./gfx" import {
    Sprite, spriteNew, spriteSet
}

pub let TILE_ART: i64 = 16

// Art pixels to screen pixels, and the tile size that follows from it. This is
// the one number that sets how close the camera is: raise it and everything
// comes in nearer, at the cost of seeing less of the jump ahead. At 4x a
// 1280-wide window shows 20 tiles, which is about what Mario showed.
pub let ART: f64 = 4.0

pub let TILE: f64 = 64.0

pub let TILE_I: i64 = 64

// Characters are drawn a little larger than the world they stand in. Strictly
// wrong, and it is what makes them read as the thing you are looking at.
pub let CHAR_ART: f64 = 4.6

// Bit-mixing hash. Wrapping by declaration: this is *supposed* to overflow, and
// Milo traps on overflow by default.
@wrapping
fn hash2(x: i64, y: i64, seed: i64): f64 {
    var h = x * 374761393 + y * 668265263 + seed * 1442695040
    h = (h ^ (h >> 13)) * 1274126177
    h = h ^ (h >> 16)
    var m = h % 4096
    if m < 0 {
        m = 0 - m
    }
    return (m as f64) / 4096.0
}

fn valueNoise(x: f64, y: f64, seed: i64): f64 {
    let x0 = Math.floor(x) as i64
    let y0 = Math.floor(y) as i64
    let tx = x - (x0 as f64)
    let ty = y - (y0 as f64)
    let sx = tx * tx * (3.0 - 2.0 * tx)
    let sy = ty * ty * (3.0 - 2.0 * ty)
    let n00 = hash2(x0, y0, seed)
    let n10 = hash2(x0 + 1, y0, seed)
    let n01 = hash2(x0, y0 + 1, seed)
    let n11 = hash2(x0 + 1, y0 + 1, seed)
    let a = n00 + (n10 - n00) * sx
    let b = n01 + (n11 - n01) * sx
    return a + (b - a) * sy
}

pub struct TileSet {
    groundCap: Sprite, // exposed top surface
    groundFill: Sprite, // buried
    platform: Sprite, // one-way
    spike: Sprite,
    crate: Sprite,
    pad: Sprite,
}

// Earth, two octaves of noise over a warm brown. The capped variant wears four
// rows of grass with a ragged lower edge — the ragged line is what stops a
// hillside from reading as a stack of identical boxes.
fn rockTile(capped: bool, seed: i64): Sprite {
    var s = spriteNew(TILE_ART, TILE_ART)
    for y in 0..TILE_ART {
        for x in 0..TILE_ART {
            let u = (x as f64) * 0.5
            let v = (y as f64) * 0.5
            let n = valueNoise(u, v, seed) * 0.62 + valueNoise(u * 2.3, v * 2.3, seed + 7) * 0.38
            var r = 0.230 + n * 0.170
            var g = 0.150 + n * 0.115
            var b = 0.075 + n * 0.060
            // a few darker pebbles in the dirt
            if n > 0.78 {
                r = r * 0.72
                g = g * 0.70
                b = b * 0.68
            }
            if capped {
                let blade = valueNoise((x as f64) * 1.7, 0.0, seed + 3)
                let grassDepth = 3.0 + blade * 2.6
                if (y as f64) < grassDepth {
                    let t = (y as f64) / grassDepth
                    // bright at the tips, deeper green underneath
                    r = 0.180 + (1.0 - t) * 0.320 + n * 0.10
                    g = 0.620 + (1.0 - t) * 0.900 + n * 0.14
                    b = 0.140 + (1.0 - t) * 0.180 + n * 0.06
                } else if (y as f64) < grassDepth + 1.0 {
                    // the shadow the grass casts on the earth under it
                    r = r * 0.68
                    g = g * 0.70
                    b = b * 0.72
                }
            }
            // a darker seam at the tile border keeps a wall of tiles from
            // melting into one flat field
            if x == 0 || y == TILE_ART - 1 {
                r = r * 0.80
                g = g * 0.80
                b = b * 0.82
            }
            spriteSet(&mut s, x, y, r, g, b, 1.0)
        }
    }
    return s
}

// Six art rows of metal slab, transparent below — you fall through it from
// underneath, and the sprite says so by not being there.
fn platformTile(): Sprite {
    var s = spriteNew(TILE_ART, TILE_ART)
    for y in 0..6 {
        for x in 0..TILE_ART {
            let n = valueNoise((x as f64) * 0.7, (y as f64) * 0.7, 31)
            var r = 0.52 + n * 0.20
            var g = 0.34 + n * 0.14
            var b = 0.16 + n * 0.08
            if y == 0 {
                // a sunlit top edge, so you can tell what you can land on
                r = 0.95
                g = 0.72 + n * 0.10
                b = 0.42
            }
            // the grain
            if y == 2 || y == 4 {
                r = r * 0.82
                g = g * 0.80
                b = b * 0.80
            }
            if y == 5 {
                r = r * 0.55
                g = g * 0.52
                b = b * 0.50
            }
            spriteSet(&mut s, x, y, r, g, b, 1.0)
        }
    }
    return s
}

// Four teeth per tile. Bright at the tip, dark at the base — the eye reads the
// glinting line as the dangerous end without being told.
fn spikeTile(): Sprite {
    var s = spriteNew(TILE_ART, TILE_ART)
    for y in 0..TILE_ART {
        for x in 0..TILE_ART {
            let local = x % 4
            let centre = 1.5
            let d = Math.abs((local as f64) - centre)
            // teeth widen toward the bottom of the tile
            let allow = (y as f64) / (TILE_ART as f64) * 2.0
            if d <= allow {
                let t = (y as f64) / ((TILE_ART - 1) as f64)
                let up = 1.0 - t
                // iron: dark at the base, a hard white glint at the point
                spriteSet(&mut s, x, y, 0.20 + up * up * 1.10, 0.21 + up * up * 1.15, 0.26 + up * up * 1.20, 1.0)
            }
        }
    }
    return s
}

// Breakable: a crate with a bright cross brace, so "hit this" is legible at a
// glance next to solid rock.
fn crateTile(): Sprite {
    var s = spriteNew(TILE_ART, TILE_ART)
    for y in 0..TILE_ART {
        for x in 0..TILE_ART {
            let n = valueNoise((x as f64) * 0.8, (y as f64) * 0.8, 77)
            var r = 0.26 + n * 0.14
            var g = 0.17 + n * 0.09
            var b = 0.10 + n * 0.06
            let edge = x == 0 || y == 0 || x == TILE_ART - 1 || y == TILE_ART - 1
            if edge {
                r = 0.52
                g = 0.34
                b = 0.16
            }
            // the diagonal brace
            if x == y || x == TILE_ART - 1 - y {
                r = 0.95
                g = 0.55
                b = 0.18
            }
            spriteSet(&mut s, x, y, r, g, b, 1.0)
        }
    }
    return s
}

// Launch pad: a compressed spring under a hot plate.
fn padTile(): Sprite {
    var s = spriteNew(TILE_ART, TILE_ART)
    for y in 0..TILE_ART {
        for x in 0..TILE_ART {
            if y < 4 {
                let t = (y as f64) / 3.0
                spriteSet(&mut s, x, y, 1.70 * (1.0 - t * 0.4), 0.55 * (1.0 - t * 0.3), 0.30, 1.0)
            } else if y < 12 {
                // zigzag coil
                let band = (y - 4) / 2
                let on = if band % 2 == 0 {
                    x % 6 < 3
                } else {
                    x % 6 >= 3
                }
                if on {
                    spriteSet(&mut s, x, y, 0.72, 0.62, 0.30, 1.0)
                }
            } else {
                spriteSet(&mut s, x, y, 0.30, 0.22, 0.14, 1.0)
            }
        }
    }
    return s
}

pub fn tileSetNew(): TileSet {
    return TileSet {
        groundCap: rockTile(true, 11),
        groundFill: rockTile(false, 23),
        platform: platformTile(),
        spike: spikeTile(),
        crate: crateTile(),
        pad: padTile(),
    }
}
