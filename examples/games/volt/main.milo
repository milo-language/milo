// VOLT — a 2D momentum platformer written in Milo.
//
//   milo run examples/games/volt/main.milo
//   milo build examples/games/volt/main.milo -o /tmp/volt --release && /tmp/volt
//
//   ARROWS / WASD    move          SPACE / Z / K   jump (hold for height)
//   SHIFT / X / J    dash          B / C / E       bark
//   walk into a hydrant and he marks it; jump or dash cuts it short
//   DOWN             drop through  R  restart      M  music      ESC  quit
//
// You are Milo, a chihuahua. Run right, stomp the cats, bark the birds out of
// the sky, dig a bone out of the dirt and spend a while as a german shepherd.
// Three levels, hydrants for checkpoints, instant respawn.
//
// Everything on screen is software: the sprites are pixel art written as strings
// and the terrain is generated noise, all composited into a linear-light float
// buffer with bloom and tone mapping (gfx.milo). SDL only blits the finished
// frame. The SDL declarations come from the `sdl` package — see milo.json.
//
// Nothing in this game is `unsafe`: every SDL call goes through ../../shared/sdlkit.milo.

from "std/math" import {
    Math
}
from "std/random" import {
    Random
}
from "sdl" import {
    SDL_INIT_VIDEO, SDL_INIT_AUDIO, SDL_WINDOW_SHOWN, SDL_RENDERER_ACCELERATED, SDL_RENDERER_PRESENTVSYNC
}
from "../../shared/sdlkit" import {
    Sdl, Window, Presenter, setCursorVisible, ticks
}
from "./input" import {
    inputNew, pollInput
}
from "./gfx" import {
    canvasNew, present
}
from "./sprites" import {
    dogFrames, catFrames, birdFrames, boneSprite, hydrantSprite, shardFrames, coreSprite
}
from "./tiles" import {
    tileSetNew
}
from "./world" import {
    worldNew, worldUpdate, worldGoto, worldRetry, FORM_SHEP, ST_PLAY, ST_CLEAR, ST_DONE
}
from "./render" import {
    drawBackground, drawLevel, drawGoal, drawChecks, drawPickups, drawMobs,
    drawPlayer, drawPee, drawBark, drawParts, drawSpeedLines, drawHud
}
from "./sound" import {
    soundNew, musicTick, musicToggle, playJump, playLand, playDash, playShard,
    playCore, playStomp, playDie, playGoal, playPad, playCrash, playBark,
    playBone, playHurt, playCheck, playPee
}

pub let W: i64 = 1280

pub let H: i64 = 720

pub fn main(): i32 {
    // Declared in teardown's reverse: the presenter goes first, then the window, then
    // SDL itself.
    let _sdl = match Sdl.init(SDL_INIT_VIDEO | SDL_INIT_AUDIO) {
        Ok(v) => v,
        Err(e) => {
            print(e)
            return 1
        }
    }
    let win = match Window.create("VOLT — a very small dog, written in Milo", W, H, SDL_WINDOW_SHOWN) {
        Ok(v) => v,
        Err(e) => {
            print(e)
            return 2
        }
    }
    let screen = match Presenter.create(win, W, H, SDL_RENDERER_ACCELERATED | SDL_RENDERER_PRESENTVSYNC) {
        Ok(v) => v,
        Err(e) => {
            print(e)
            return 2
        }
    }
    setCursorVisible(false)

    var c = canvasNew(W, H)
    let dog = dogFrames()
    let cat = catFrames()
    let bird = birdFrames()
    let bone = boneSprite()
    let hydrant = hydrantSprite()
    let shards = shardFrames()
    let core = coreSprite()
    let ts = tileSetNew()
    var w = worldNew(0, W as f64, H as f64)
    var snd = soundNew()
    var inp = inputNew()

    var last = ticks()
    var fpsAccum: f64 = 0.0
    var fpsFrames: i64 = 0
    var fpsShown: i64 = 0

    while !inp.quit {
        let now = ticks()
        var dt = ((now - last) as f64) / 1000.0
        last = now
        // A frame longer than 50 ms is a hitch, not slow motion: clamp it so the
        // simulation never takes a step it cannot resolve.
        if dt > 0.05 {
            dt = 0.05
        }
        if dt < 0.0005 {
            dt = 0.0005
        }

        pollInput(&mut inp)
        if inp.mute {
            musicToggle(&mut snd)
        }
        musicTick(snd)

        if inp.restart {
            if w.state == ST_DONE {
                w = worldNew(0, W as f64, H as f64)
            } else {
                worldRetry(&mut w)
            }
        }

        worldUpdate(&mut w, dt, inp.moveX, inp.down, inp.jump, inp.jumpHeld, inp.dash, inp.bark)

        if w.evJump {
            playJump(snd)
        }
        if w.evWall {
            playJump(snd)
        }
        if w.evLand {
            playLand(snd)
        }
        if w.evDash {
            playDash(snd)
        }
        if w.evShard {
            playShard(snd)
        }
        if w.evCore {
            playCore(snd)
        }
        if w.evStomp {
            playStomp(snd)
        }
        if w.evDie {
            playDie(snd)
        }
        if w.evGoal {
            playGoal(snd)
        }
        if w.evPad {
            playPad(snd)
        }
        if w.evBreak {
            playCrash(snd)
        }
        if w.evBark {
            playBark(snd, w.p.form == FORM_SHEP)
        }
        if w.evBone {
            playBone(snd)
        }
        if w.evHurt {
            playHurt(snd)
        }
        if w.evCheck {
            playCheck(snd)
        }
        if w.evPee {
            playPee(snd)
        }

        // Screen shake is applied as a camera offset at draw time, so it never
        // touches the simulation and can never desync collision from what is on
        // screen.
        var ox = 0.0
        var oy = 0.0
        if w.shake > 0.2 {
            ox = Random.floatRange(0.0 - w.shake, w.shake)
            oy = Random.floatRange(0.0 - w.shake, w.shake)
        }

        drawBackground(&mut c, w)
        drawLevel(&mut c, w, ts, ox, oy)
        drawGoal(&mut c, w, ox, oy)
        drawChecks(&mut c, w, hydrant, ox, oy)
        drawPickups(&mut c, w, shards, core, bone, ox, oy)
        drawMobs(&mut c, w, cat, bird, ox, oy)
        drawPlayer(&mut c, w, dog, ox, oy)
        drawPee(&mut c, w, ox, oy)
        drawBark(&mut c, w, ox, oy)
        drawParts(&mut c, w, ox, oy)
        drawSpeedLines(&mut c, w)

        fpsAccum += dt
        fpsFrames += 1
        if fpsAccum > 0.5 {
            fpsShown = ((fpsFrames as f64) / fpsAccum) as i64
            fpsAccum = 0.0
            fpsFrames = 0
        }
        drawHud(&mut c, w, shards[0], bone, fpsShown)

        var exposure = 1.0
        if w.flash > 0.0 {
            exposure = exposure + w.flash * 0.7
        }
        // The threshold sits above the sky. Daylight art is bright everywhere,
        // and a low threshold would bloom the blue into white fog instead of
        // lighting the few things that are actually emitting.
        present(&mut c, 0.28, exposure, 2.2)

        screen.present(c.fb)
    }

    return 0
}
