// Everything that puts ink on the canvas.
//
// Back to front: sky, three parallax layers, tiles, pickups, hydrants, enemies,
// the player, particles, then the HUD. The parallax layers are generated from a
// hash of their world position rather than stored, so a level of any length has
// a skyline behind it and none of it is in the binary.

from "std/math" import {
    Math
}
from "./gfx" import {
    Canvas, Sprite, addPix, blendPix, fillRect, fillRectAdd, skyGradient, spot, line,
    drawSprite, blitSprite, shadowSprite, text, textCentered, textWidth
}
from "./tiles" import {
    TileSet, TILE, TILE_I, ART, CHAR_ART
}
from "./level" import {
    Level, tileAt, T_EMPTY, T_SOLID, T_PLAT, T_SPIKE, T_CRATE, T_PAD
}
from "./world" import {
    World, Player, Mob, Pickup, Check, Part, Ghost, dogFrameOf, barkPhase,
    peeSourceX, peeSourceY, GROW_TIME,
    PLAYER_W, PLAYER_H, MOB_CAT, MOB_BIRD, PK_SHARD, PK_CORE, PK_BONE,
    FORM_CHI, FORM_SHEP, ST_PLAY, ST_CLEAR, ST_DONE
}
from "./sprites" import {
    DogArt, SHARD_FRAMES, CAT_FRAMES, BIRD_FRAMES
}

@wrapping
fn hashi(i: i64, seed: i64): f64 {
    var h = i * 374761393 + seed * 668265263
    h = (h ^ (h >> 13)) * 1274126177
    h ^= (h >> 16)
    var m = h % 8192
    if m < 0 {
        m = 0 - m
    }
    return (m as f64) / 8192.0
}

fn noise1(x: f64, seed: i64): f64 {
    let i = Math.floor(x) as i64
    let t = x - (i as f64)
    let s = t * t * (3.0 - 2.0 * t)
    let a = hashi(i, seed)
    let b = hashi(i + 1, seed)
    return a + (b - a) * s
}

// ── background ────────────────────────────────────────────────────────────────
//
// Daytime, outdoors, and four layers deep. Nothing here is stored: the clouds,
// the ridges and the trees are all hashed from world position, so a level of
// any length has a landscape behind it and none of it is in the binary.
//
// The layers move at 8%, 22% and 42% of the camera. That spread is the whole
// trick — the eye reads the difference in rates as distance.

fn skyOf(c: &mut Canvas, lvl: i64) {
    if lvl == 1 {
        // midday
        skyGradient(&mut c, 0.26, 0.60, 1.70, 1.05, 1.40, 1.85)
    } else if lvl == 2 {
        // late afternoon, warmer down at the horizon
        skyGradient(&mut c, 0.34, 0.52, 1.30, 1.60, 1.30, 1.15)
    } else {
        // morning
        skyGradient(&mut c, 0.30, 0.64, 1.60, 1.15, 1.42, 1.70)
    }
}

// A soft cloud: a handful of overlapping discs, additive over the sky so the
// edges stay feathered instead of cutting a hard hole in the blue.
fn cloud(c: &mut Canvas, x: f64, y: f64, scale: f64, k: f64) {
    spot(&mut c, x, y, 34.0 * scale, 0.42 * k, 0.46 * k, 0.52 * k)
    spot(&mut c, x - 26.0 * scale, y + 6.0 * scale, 24.0 * scale, 0.34 * k, 0.38 * k, 0.44 * k)
    spot(&mut c, x + 28.0 * scale, y + 5.0 * scale, 26.0 * scale, 0.34 * k, 0.38 * k, 0.44 * k)
    spot(&mut c, x + 8.0 * scale, y - 12.0 * scale, 22.0 * scale, 0.30 * k, 0.34 * k, 0.40 * k)
}

fn drawClouds(c: &mut Canvas, camX: f64, camY: f64, t: f64) {
    for i in 0..14 {
        // the far band drifts slower and sits higher
        let far = i % 2 == 0
        let par = if far {
            0.05
        } else {
            0.11
        }
        let span = 520.0
        let drift = t * (if far {
            5.0
        } else {
            11.0
        }
        )
        var x = hashi(i, 61) * span * 3.0 - camX * par + drift
        x = x - Math.floor(x / (span * 3.0)) * (span * 3.0)
        let y = 60.0 + hashi(i, 67) * 250.0 - camY * par * 0.5
        let scale = if far {
            0.7
        } else {
            1.05
        }
        cloud(&mut c, x, y, scale, if far {
            0.55
        } else {
            0.85
        }
        )
    }
}

// The height of a ridge at one screen column. Shared so the trees can stand on
// the same line the ridge is drawn at rather than near it.
fn ridgeTop(x: i64, off: f64, yoff: f64, base: f64, amp: f64, freq: f64, seed: i64): f64 {
    let wx = ((x as f64) + off) * freq
    let n = noise1(wx, seed) * 0.6 + noise1(wx * 2.7, seed + 5) * 0.28 + noise1(wx * 6.1, seed + 11) * 0.12
    return base - n * amp - yoff
}

// One column of fill per screen x, with a lit rim on the crest: the silhouette
// carries the shape and the rim keeps it from reading as a hole in the sky.
fn drawRidge(c: &mut Canvas, camX: f64, camY: f64, par: f64, base: f64, amp: f64, freq: f64, seed: i64, r: f64, g: f64, b: f64) {
    let off = camX * par
    let yoff = camY * par * 0.4
    for x in 0..c.w {
        let top = ridgeTop(x, off, yoff, base, amp, freq, seed)
        var y = top as i64
        if y < 0 {
            y = 0
        }
        blendPix(&mut c, x, y, r * 2.6, g * 2.6, b * 2.4, 0.95)
        y += 1
        if y < c.h {
            blendPix(&mut c, x, y, r * 1.5, g * 1.5, b * 1.4, 1.0)
            y += 1
        }
        while y < c.h {
            blendPix(&mut c, x, y, r, g, b, 1.0)
            y += 1
        }
    }
}

fn disc(c: &mut Canvas, cx: f64, cy: f64, r: f64, red: f64, green: f64, blue: f64, a: f64) {
    var y = (cy - r) as i64
    let y1 = (cy + r) as i64
    while y <= y1 {
        var x = (cx - r) as i64
        let x1 = (cx + r) as i64
        while x <= x1 {
            let dx = (x as f64) + 0.5 - cx
            let dy = (y as f64) + 0.5 - cy
            if dx * dx + dy * dy <= r * r {
                blendPix(&mut c, x, y, red, green, blue, a)
            }
            x += 1
        }
        y += 1
    }
}

// Round trees along a ridge, each one's size and position out of its own hash
// so the line of them is stable as the camera moves.
fn drawTrees(c: &mut Canvas, camX: f64, camY: f64, par: f64, base: f64, amp: f64, freq: f64, seed: i64, tint: f64) {
    let off = camX * par
    let yoff = camY * par * 0.4
    let span = 86.0
    let first = Math.floor(off / span) as i64
    for k in 0..22 {
        let i = first + k
        let sx = (i as f64) * span - off + hashi(i, 31) * 40.0
        if sx > 0.0 - 60.0 && sx < (c.w as f64) + 60.0 {
            let ix = sx as i64
            let ground = ridgeTop(ix, off, yoff, base, amp, freq, seed)
            let sc = 1.15 + hashi(i, 37) * 1.05
            let trunkH = 20.0 * sc
            fillRect(&mut c, sx - 3.0 * sc, ground - trunkH, sx + 3.0 * sc, ground + 2.0, 0.115 * tint, 0.070 * tint, 0.038 * tint, 1.0)
            // three discs make a canopy that is not a circle
            let cy = ground - trunkH - 12.0 * sc
            disc(&mut c, sx - 11.0 * sc, cy + 8.0 * sc, 15.0 * sc, 0.075 * tint, 0.185 * tint, 0.065 * tint, 1.0)
            disc(&mut c, sx + 11.0 * sc, cy + 7.0 * sc, 15.0 * sc, 0.075 * tint, 0.185 * tint, 0.065 * tint, 1.0)
            disc(&mut c, sx, cy, 19.0 * sc, 0.095 * tint, 0.235 * tint, 0.080 * tint, 1.0)
            // the sun catches the top left of every canopy, which is what makes
            // a row of green blobs read as a row of trees
            disc(&mut c, sx - 5.0 * sc, cy - 6.0 * sc, 8.0 * sc, 0.150 * tint, 0.360 * tint, 0.110 * tint, 1.0)
        }
    }
}

pub fn drawBackground(c: &mut Canvas, w: &World) {
    skyOf(&mut c, w.lvlIdx)
    // the sun, parked high and barely moving
    let sunX = (c.w as f64) * 0.78 - w.camX * 0.02
    let sunY = (c.h as f64) * 0.16 - w.camY * 0.02
    spot(&mut c, sunX, sunY, 260.0, 0.55, 0.45, 0.22)
    spot(&mut c, sunX, sunY, 76.0, 1.60, 1.40, 0.80)
    drawClouds(&mut c, w.camX, w.camY, w.t)

    // far mountains, hazy and blue, with a rim bright enough to read as snow
    drawRidge(&mut c, w.camX, w.camY, 0.08, (c.h as f64) * 0.60, 190.0, 0.0011, 5, 0.300, 0.400, 0.620)
    // middle hills, green, with a line of trees standing on them
    drawRidge(&mut c, w.camX, w.camY, 0.22, (c.h as f64) * 0.80, 120.0, 0.0022, 17, 0.155, 0.330, 0.135)
    drawTrees(&mut c, w.camX, w.camY, 0.22, (c.h as f64) * 0.80, 120.0, 0.0022, 17, 1.0)
    // near hills, darker because they are out of the haze
    drawRidge(&mut c, w.camX, w.camY, 0.42, (c.h as f64) * 1.06, 90.0, 0.0038, 29, 0.085, 0.195, 0.080)
}

// ── tiles ─────────────────────────────────────────────────────────────────────

pub fn drawLevel(c: &mut Canvas, w: &World, ts: &TileSet, ox: f64, oy: f64) {
    let camX = w.camX - ox
    let camY = w.camY - oy
    var cx0 = (Math.floor(camX / TILE) as i64) - 1
    var cy0 = (Math.floor(camY / TILE) as i64) - 1
    let cx1 = cx0 + (c.w / TILE_I) + 3
    let cy1 = cy0 + (c.h / TILE_I) + 3
    if cx0 < 0 {
        cx0 = 0
    }
    if cy0 < 0 {
        cy0 = 0
    }
    for cy in cy0..cy1 + 1 {
        for cx in cx0..cx1 + 1 {
            let v = tileAt(w.lvl, cx, cy)
            if v != T_EMPTY {
                let sx = (cx as f64) * TILE - camX
                let sy = (cy as f64) * TILE - camY
                if v == T_SOLID {
                    // The only autotiling there is: an exposed top gets the lit
                    // cap, everything else gets fill.
                    if tileAt(w.lvl, cx, cy - 1) == T_SOLID {
                        drawSprite(&mut c, ts.groundFill, sx, sy, ART, false, 0.0)
                    } else {
                        drawSprite(&mut c, ts.groundCap, sx, sy, ART, false, 0.35)
                    }
                } else if v == T_PLAT {
                    drawSprite(&mut c, ts.platform, sx, sy, ART, false, 0.55)
                } else if v == T_SPIKE {
                    drawSprite(&mut c, ts.spike, sx, sy, ART, false, 0.7)
                } else if v == T_CRATE {
                    drawSprite(&mut c, ts.crate, sx, sy, ART, false, 0.2)
                } else if v == T_PAD {
                    drawSprite(&mut c, ts.pad, sx, sy, ART, false, 0.9)
                }
            }
        }
    }
}

// ── entities ──────────────────────────────────────────────────────────────────

pub fn drawGoal(c: &mut Canvas, w: &World, ox: f64, oy: f64) {
    let x = w.lvl.goalX - w.camX + ox
    let y = w.lvl.goalY - w.camY + oy
    if x < -120.0 || x > (c.w as f64) + 120.0 {
        return
    }
    // a column of light, brightest at the base
    var k = 0
    while k < 26 {
        let t = (k as f64) / 26.0
        let a = (1.0 - t) * 0.55
        let wob = Math.sin(w.t * 3.0 + t * 8.0) * 5.0
        fillRectAdd(&mut c, x - 29.0 + wob * 0.4, y - 32.0 - (k as f64) * 32.0, x + 29.0 + wob * 0.4, y - (k as f64) * 32.0 + 4.0, 0.30 * a, 0.24 * a, 0.07 * a)
        k += 1
    }
    // the ring itself
    let pulse = 1.0 + 0.25 * Math.sin(w.t * 4.0)
    var i = 0
    while i < 40 {
        let a = (i as f64) / 40.0 * 6.2831853
        let r = 44.0 * pulse
        let px = x + Math.cos(a) * r
        let py = y - 40.0 + Math.sin(a) * r * 0.85
        spot(&mut c, px, py, 9.0, 1.70, 1.30, 0.40)
        i += 1
    }
    spot(&mut c, x, y - 40.0, 50.0, 0.42, 0.32, 0.10)
    spot(&mut c, x, y, 66.0, 0.50, 0.38, 0.12)
}

// Hydrants. An unlit one is a dull red lump with a slow pulse; a lit one throws
// a cone of light and never stops moving, because it is the one thing on screen
// that is purely good news.
pub fn drawChecks(c: &mut Canvas, w: &World, hydrant: &Sprite, ox: f64, oy: f64) {
    var i = 0
    while i < w.checks.len {
        let x = w.checks[i].x - w.camX + ox
        // the hydrant stands on the floor of its tile, not at its centre
        let y = w.checks[i].y - w.camY + oy + TILE * 0.5
        if x > -80.0 && x < (c.w as f64) + 80.0 {
            if w.checks[i].wet > 0.02 {
                // a shallow puddle at the foot of it, drying slowly
                let k = w.checks[i].wet
                var e = 0
                while e < 7 {
                    let t = (e as f64) / 7.0
                    let rw = (30.0 - t * 22.0) * k
                    fillRect(&mut c, x - rw, y - 3.0 + t * 5.0, x + rw, y + 1.0 + t * 5.0, 0.55 * k, 0.44 * k, 0.09 * k, 0.22 * k)
                    e += 1
                }
            }
            if w.checks[i].lit {
                let pulse = 0.75 + 0.25 * Math.sin(w.checks[i].t * 4.0)
                spot(&mut c, x, y - 30.0, 66.0 * pulse, 0.55, 0.42, 0.10)
                var k = 0
                while k < 12 {
                    let t = (k as f64) / 12.0
                    let a = (1.0 - t) * 0.30 * pulse
                    fillRectAdd(&mut c, x - 12.0, y - 40.0 - (k as f64) * 18.0, x + 12.0, y - 30.0 - (k as f64) * 18.0, 0.34 * a, 0.26 * a, 0.06 * a)
                    k += 1
                }
                drawSprite(&mut c, hydrant, x - 6.0 * ART, y - 14.0 * ART, ART, false, 0.60)
            } else {
                drawSprite(&mut c, hydrant, x - 6.0 * ART, y - 14.0 * ART, ART, false, 0.0)
            }
        }
        i += 1
    }
}

pub fn drawPickups(c: &mut Canvas, w: &World, shards: &Vec<Sprite>, core: &Sprite, bone: &Sprite, ox: f64, oy: f64) {
    var i = 0
    while i < w.pk.len {
        if !w.pk[i].taken {
            let bob = Math.sin(w.pk[i].t * 2.6) * 5.0
            let x = w.pk[i].x - w.camX + ox
            let y = w.pk[i].y - w.camY + oy + bob
            if x > -90.0 && x < (c.w as f64) + 90.0 {
                if w.pk[i].kind == PK_CORE {
                    spot(&mut c, x, y, 46.0, 0.16, 0.42, 0.10)
                    let s = 1.0 + 0.08 * Math.sin(w.pk[i].t * 3.4)
                    drawSprite(&mut c, core, x - 8.0 * ART * s, y - 8.0 * ART * s, ART * s, false, 0.35)
                } else if w.pk[i].kind == PK_BONE {
                    // The bone gets its own halo and a slow tumble. Nothing else
                    // in the level is this warm, so it is never mistaken for a
                    // treat lying on the floor.
                    let pulse = 0.75 + 0.25 * Math.sin(w.pk[i].t * 3.2)
                    spot(&mut c, x, y, 44.0 * pulse, 0.34, 0.27, 0.09)
                    spot(&mut c, x, y, 20.0, 0.45, 0.36, 0.15)
                    let s = 1.0 + 0.07 * Math.sin(w.pk[i].t * 2.2)
                    drawSprite(&mut c, bone, x - 8.0 * ART * s, y - 5.0 * ART * s, ART * s, false, 0.30)
                } else {
                    let f = ((w.pk[i].t * 7.0) as i64) % SHARD_FRAMES
                    spot(&mut c, x, y, 24.0, 0.30, 0.20, 0.06)
                    drawSprite(&mut c, shards[f], x - 5.5 * ART, y - 5.5 * ART, ART, false, 0.35)
                }
            }
        }
        i += 1
    }
}

pub fn drawMobs(c: &mut Canvas, w: &World, cat: &Vec<Sprite>, bird: &Vec<Sprite>, ox: f64, oy: f64) {
    var i = 0
    while i < w.mobs.len {
        let x = w.mobs[i].x - w.camX + ox
        let y = w.mobs[i].y - w.camY + oy
        let flip = w.mobs[i].vx < 0.0
        if x > -120.0 && x < (c.w as f64) + 120.0 {
            let mw = w.mobs[i].w
            let mh = w.mobs[i].h
            if !w.mobs[i].alive {
                // a flattened, fading corpse
                let t = Math.maxF64(0.0, w.mobs[i].dieT / 0.35)
                let aw = (cat[0].w as f64) * CHAR_ART
                blitSprite(&mut c, cat[0], x + (mw - aw) * 0.5, y + mh * (1.0 - t), CHAR_ART, CHAR_ART * t, flip, t, 0.9, 1.4, 1.4, 1.6, 0.6)
            } else if w.mobs[i].kind == MOB_CAT {
                let f = ((w.mobs[i].phase * 0.9) as i64) % CAT_FRAMES
                let aw = (cat[f].w as f64) * CHAR_ART
                let ah = (cat[f].h as f64) * CHAR_ART
                drawSprite(&mut c, cat[f], x + (mw - aw) * 0.5, y + mh - ah, CHAR_ART, flip, 0.12)
            } else {
                let f = ((w.mobs[i].phase * 6.0) as i64) % BIRD_FRAMES
                let aw = (bird[f].w as f64) * CHAR_ART
                let ah = (bird[f].h as f64) * CHAR_ART
                drawSprite(&mut c, bird[f], x + (mw - aw) * 0.5, y + mh - ah, CHAR_ART, flip, 0.14)
            }
        }
        i += 1
    }
}

// The bark: a ring that starts at the nose and runs out to the radius that
// actually killed things, so what you see is exactly what you hit.
pub fn drawBark(c: &mut Canvas, w: &World, ox: f64, oy: f64) {
    if w.barkRingT <= 0.0 {
        return
    }
    let t = barkPhase(w)
    let x = w.barkX - w.camX + ox
    let y = w.barkY - w.camY + oy
    let r = w.barkR * (0.25 + t * 0.85)
    let fade = 1.0 - t
    var i = 0
    while i < 44 {
        // a broad arc in front of the dog rather than a full circle
        let a = 0.0 - 1.35 + (i as f64) / 44.0 * 2.70
        let dir = if w.p.facing < 0.0 {
            0.0 - 1.0
        } else {
            1.0
        }
        let px = x + Math.cos(a) * r * dir
        let py = y + Math.sin(a) * r * 0.8
        spot(&mut c, px, py, 7.0 * fade, 1.10 * fade, 0.85 * fade, 0.30 * fade)
        i += 1
    }
    spot(&mut c, x, y, 30.0 * fade, 0.40 * fade, 0.30 * fade, 0.10 * fade)
}

// Which build is on screen is the only thing the two paths differ by, and it is
// decided here rather than inside the draw so the frame set can stay borrowed.
// The stream: droplets marching along a fixed parabola from the raised hip to
// the foot of the hydrant. Drawn rather than simulated, so it always lands
// where it is aimed and always reads as one line instead of as a cloud.
pub fn drawPee(c: &mut Canvas, w: &World, ox: f64, oy: f64) {
    if w.p.peeT <= 0.0 || w.peeIdx < 0 || w.peeIdx >= w.checks.len {
        return
    }
    let sx = peeSourceX(w) - w.camX + ox
    let sy = peeSourceY(w) - w.camY + oy
    let tx = w.checks[w.peeIdx].x - w.camX + ox
    let ty = w.checks[w.peeIdx].y + 22.0 - w.camY + oy
    // opens and closes rather than snapping on, which is most of why it is funny
    let ramp = Math.minF64(1.0, Math.minF64(w.p.peeT * 5.0, (1.0 - w.p.peeT) * 6.0 + 0.15))
    if ramp <= 0.0 {
        return
    }
    // The arc has to scale with how far away he stood: a fixed height over a
    // short span throws the stream straight up in the air.
    let span = Math.abs(tx - sx)
    let arc = Math.minF64(30.0, span * 0.42)
    let n = 15
    let march = (w.t * 5.0) - Math.floor(w.t * 5.0)
    for i in 0..n {
        var t = ((i as f64) + march) / (n as f64)
        if t > 1.0 {
            t -= 1.0
        }
        let px = sx + (tx - sx) * t
        let py = sy + (ty - sy) * t - arc * 4.0 * t * (1.0 - t)
        // the droplets thin out and speed up along the arc
        let size = (4.2 - t * 1.4) * ramp
        // Alpha-over, and no glow under it: additive yellow on a bright sky
        // washes straight to white, and the one thing this has to be is yellow.
        disc(&mut c, px, py, size, 1.05, 0.72, 0.06, 1.0)
    }
}

pub fn drawPlayer(c: &mut Canvas, w: &World, art: &DogArt, ox: f64, oy: f64) {
    if w.p.form == FORM_SHEP {
        drawDog(&mut c, w, art.shep, ox, oy)
    } else {
        drawDog(&mut c, w, art.chi, ox, oy)
    }
}

fn drawDog(c: &mut Canvas, w: &World, frames: &Vec<Sprite>, ox: f64, oy: f64) {
    if w.p.dead {
        return
    }
    let flip = w.p.facing < 0.0
    let bx = w.p.x - w.camX + ox
    let by = w.p.y - w.camY + oy

    // dash ghosts, oldest first
    var i = 0
    while i < w.ghosts.len {
        let t = w.ghosts[i].t / 0.22
        let gx = w.ghosts[i].x - w.camX + ox - 3.0
        let gy = w.ghosts[i].y - w.camY + oy
        shadowSprite(&mut c, frames[w.ghosts[i].frame], gx, gy, CHAR_ART, CHAR_ART, w.ghosts[i].flip, t * 0.40, 1.30 * t, 1.00 * t, 0.45 * t)
        i += 1
    }

    let sq = frames[dogFrameOf(w)]
    // Squash and stretch about the feet: the sprite's bottom edge stays on the
    // ground while the body compresses, which is the only way it reads as impact
    // rather than as the character sinking into the floor.
    // Growing is the shepherd swelling into place, not a strobe between two
    // dogs. It settles a touch past full size and comes back, which is what
    // makes it land instead of just stopping.
    var grow = 1.0
    if w.p.growT > 0.0 {
        let t = 1.0 - w.p.growT / GROW_TIME
        grow = 0.72 + 0.28 * t + 0.13 * Math.sin(3.14159265 * t)
    }
    let sx = CHAR_ART * w.p.sqX * grow
    let sy = CHAR_ART * w.p.sqY * grow
    let dw = (sq.w as f64) * sx
    let dh = (sq.h as f64) * sy
    let footY = by + PLAYER_H
    let dx = bx + PLAYER_W * 0.5 - dw * 0.5
    let dy = footY - dh

    // contact shadow
    if w.p.onGround {
        fillRect(&mut c, bx - 5.0, footY - 5.0, bx + PLAYER_W + 5.0, footY + 1.0, 0.0, 0.0, 0.0, 0.30)
    }
    var glow = 0.10
    if w.p.growT > 0.0 {
        glow = glow + w.p.growT * 1.8
    }
    var tmix = 0.0
    if w.p.dashT > 0.0 {
        glow = 1.1
        tmix = 0.35
    }
    if w.p.form == FORM_SHEP {
        // the shepherd is darker art, so he needs the extra lift to stay legible
        glow += 0.10
    }
    // Invulnerable: flicker, and do not draw at all on the off beat. Skipping
    // frames outright reads as invulnerability; dimming reads as a bug.
    var alpha = 1.0
    if w.p.invT > 0.0 {
        let ph = (w.p.invT * 14.0) as i64
        if ph % 2 == 0 {
            alpha = 0.62
        }
    }

    if w.p.spawnT > 0.0 {
        // materialising: flicker in over half a second
        let t = w.p.spawnT / 0.55
        spot(&mut c, bx + PLAYER_W * 0.5, by + PLAYER_H * 0.5, 70.0 * t, 0.9 * t, 0.7 * t, 0.3 * t)
        blitSprite(&mut c, sq, dx, dy, sx, sy, flip, 1.0 - t * 0.6, glow + t, 1.6, 1.3, 0.6, t)
    } else {
        blitSprite(&mut c, sq, dx, dy, sx, sy, flip, alpha, glow, 1.5, 1.1, 0.5, tmix)
    }
}

pub fn drawParts(c: &mut Canvas, w: &World, ox: f64, oy: f64) {
    var i = 0
    while i < w.parts.len {
        let t = w.parts[i].life / w.parts[i].max
        let x = w.parts[i].x - w.camX + ox
        let y = w.parts[i].y - w.camY + oy
        if x > -20.0 && x < (c.w as f64) + 20.0 {
            spot(&mut c, x, y, w.parts[i].size * (0.4 + t * 0.9), w.parts[i].r * t, w.parts[i].g * t, w.parts[i].b * t)
        }
        i += 1
    }
}

// Speed streaks while dashing — drawn in screen space, behind nothing.
pub fn drawSpeedLines(c: &mut Canvas, w: &World) {
    if w.p.dashT <= 0.0 {
        return
    }
    let k = w.p.dashT / 0.145
    for i in 0..22 {
        let y = hashi(i, 71) * (c.h as f64)
        let len = 175.0 + hashi(i, 73) * 350.0
        let x = hashi(i + 400, 79) * (c.w as f64)
        let dir = 0.0 - w.p.dashX
        line(&mut c, x, y, x + dir * len, y + w.p.dashY * len * 0.4, 0.10 * k, 0.22 * k, 0.30 * k)
    }
}

// ── HUD ───────────────────────────────────────────────────────────────────────

fn timeString(t: f64): string {
    let total = (t * 100.0) as i64
    let cs = total % 100
    let secs = (total / 100) % 60
    let mins = total / 6000
    var s = mins.toString() + ":"
    if secs < 10 {
        s += "0"
    }
    s = s + secs.toString() + "."
    if cs < 10 {
        s += "0"
    }
    return s + cs.toString()
}

pub fn drawHud(c: &mut Canvas, w: &World, shard: &Sprite, bone: &Sprite, fps: i64) {
    // a dark bar so text stays readable over a bright sky
    fillRect(&mut c, 0.0, 0.0, c.w as f64, 46.0, 0.0, 0.0, 0.0, 0.35)

    text(&mut c, 22, 16, w.lvl.name, 2, 0.35, 0.95, 1.10)

    drawSprite(&mut c, shard, 300.0, 10.0, 2.0, false, 0.9)
    let got = w.shards.toString() + "/" + w.shardTotal.toString()
    text(&mut c, 322, 16, got, 2, 1.00, 0.80, 0.40)

    if w.cores > 0 {
        text(&mut c, 420, 16, "GEMS " + w.cores.toString(), 2, 0.55, 1.20, 1.30)
    }

    // What you are, which is also how many hits you have left. The bone icon is
    // the same one that is lying in the level, so the connection needs no words.
    if w.p.form == FORM_SHEP {
        drawSprite(&mut c, bone, 540.0, 12.0, 1.4, false, 1.0)
        text(&mut c, 572, 16, "SHEPHERD", 2, 1.20, 0.95, 0.45)
    } else {
        text(&mut c, 540, 16, "CHIHUAHUA", 2, 0.55, 0.42, 0.30)
    }

    let tm = timeString(w.time)
    text(&mut c, c.w - 22 - textWidth(tm, 2), 16, tm, 2, 0.55, 0.70, 0.95)

    let dth = "DEATHS " + w.deaths.toString()
    text(&mut c, c.w - 200 - textWidth(dth, 2), 16, dth, 2, 0.70, 0.30, 0.35)

    // Dash on the left, bark beside it: the two things that are either ready or
    // not, shown as bars rather than as numbers.
    let cx = 22
    let cy = 34
    if w.p.dashes > 0 && w.p.dashCd <= 0.0 {
        fillRectAdd(&mut c, cx as f64, cy as f64, (cx + 16) as f64, (cy + 4) as f64, 0.9, 0.35, 1.2)
    } else {
        fillRect(&mut c, cx as f64, cy as f64, (cx + 16) as f64, (cy + 4) as f64, 0.25, 0.12, 0.30, 1.0)
    }
    if w.p.barkCd <= 0.0 {
        fillRectAdd(&mut c, (cx + 22) as f64, cy as f64, (cx + 38) as f64, (cy + 4) as f64, 1.1, 0.85, 0.30)
    } else {
        fillRect(&mut c, (cx + 22) as f64, cy as f64, (cx + 38) as f64, (cy + 4) as f64, 0.30, 0.22, 0.10, 1.0)
    }

    text(&mut c, 22, c.h - 28, fps.toString() + " FPS", 2, 0.16, 0.26, 0.34)
    let help = "ARROWS MOVE   SPACE JUMP   SHIFT DASH   B BARK   R RESET   ESC QUIT"
    text(&mut c, c.w - 22 - textWidth(help, 2), c.h - 28, help, 2, 0.16, 0.26, 0.34)

    if w.state == ST_CLEAR {
        fillRect(&mut c, 0.0, (c.h / 2 - 70) as f64, c.w as f64, (c.h / 2 + 60) as f64, 0.0, 0.0, 0.0, 0.45)
        textCentered(&mut c, c.w / 2, c.h / 2 - 46, "GOOD DOG", 6, 1.40, 1.10, 0.45)
        let line1 = "TREATS " + w.shards.toString() + "/" + w.shardTotal.toString()
        textCentered(&mut c, c.w / 2, c.h / 2 + 16, line1, 3, 1.00, 0.80, 0.40)
    }
    if w.state == ST_DONE {
        fillRect(&mut c, 0.0, 0.0, c.w as f64, c.h as f64, 0.0, 0.0, 0.0, 0.55)
        textCentered(&mut c, c.w / 2, c.h / 2 - 90, "WHO IS A GOOD DOG", 5, 1.50, 1.15, 0.50)
        textCentered(&mut c, c.w / 2, c.h / 2 + 6, "TREATS " + w.banked.toString(), 3, 1.00, 0.80, 0.40)
        textCentered(&mut c, c.w / 2, c.h / 2 + 42, "GEMS " + w.cores.toString(), 3, 0.55, 1.20, 1.30)
        textCentered(&mut c, c.w / 2, c.h / 2 + 78, "TIME " + timeString(w.time), 3, 0.55, 0.70, 0.95)
        textCentered(&mut c, c.w / 2, c.h / 2 + 114, "DEATHS " + w.deaths.toString(), 3, 0.70, 0.30, 0.35)
        textCentered(&mut c, c.w / 2, c.h / 2 + 164, "R TO RUN IT AGAIN", 2, 0.40, 0.50, 0.65)
    }
}
