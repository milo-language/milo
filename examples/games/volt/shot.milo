// @run: /tmp/milo-shot-volt 1
// Absolute /tmp prefix on purpose: the example harnesses run from the repo root,
// so a bare prefix would drop .ppm frames into the working tree.
// Headless capture: a bot plays the game and PPM frames are dumped at chosen
// ticks. Doubles as a deterministic smoke test for the whole simulation — no
// SDL, no window, so it runs anywhere and its output can be looked at.
//
//   milo run examples/games/volt/shot.milo --release -- /tmp/volt 60 240 600
//   milo run examples/games/volt/shot.milo --release -- /tmp/volt --level 2 300
//
// The bot is deliberately mediocre: it runs right, jumps at walls, gaps and
// spikes, barks at what is in front of it and dashes when it is stuck. It is
// here to move the camera through the level so the art can be inspected, not to
// prove the game is beatable.

from "std/math" import {
    Math
}
from "std/args" import {
    args
}
from "./gfx" import {
    Canvas, canvasNew, present, drawSprite, fillRect
}
from "./tiles" import {
    tileSetNew, TILE
}
from "./level" import {
    tileAt, isSolid, T_SPIKE
}
from "./sprites" import {
    dogFrames, catFrames, birdFrames, boneSprite, hydrantSprite, shardFrames, coreSprite,
    DOG_PEE
}
from "./world" import {
    World, worldNew, worldUpdate, PLAYER_W, PLAYER_H
}
from "./render" import {
    drawBackground, drawLevel, drawGoal, drawChecks, drawPickups, drawMobs,
    drawPlayer, drawPee, drawBark, drawParts, drawSpeedLines, drawHud
}

pub extern fn fopen(path: *u8, mode: *u8): *u8

pub extern fn fwrite(ptr: *u8, size: i64, count: i64, stream: *u8): i64

pub extern fn fclose(stream: *u8): i32

pub let W: i64 = 1280

pub let H: i64 = 720

fn writePpm(path: &string, c: &Canvas) {
    var rgb: Vec<u8> = Vec.filled(W * H * 3, 0)
    for i in 0..W * H {
        let px = c.fb[i]
        rgb[i * 3] = (px & 0xFF) as u8
        rgb[i * 3 + 1] = ((px >> 8) & 0xFF) as u8
        rgb[i * 3 + 2] = ((px >> 16) & 0xFF) as u8
    }
    let header = "P6\n" + W.toString() + " " + H.toString() + "\n255\n"
    unsafe {
        let f = fopen(path.cstr(), "wb".cstr())
        if (f as i64) == 0 {
            print("cannot open " + path)
            return
        }
        let _ = fwrite(header.cstr(), 1, header.len, f)
        let _ = fwrite(rgb.ptr() as *u8, 1, W * H * 3, f)
        let _ = fclose(f)
    }
}

// ── the bot ───────────────────────────────────────────────────────────────────

pub struct Bot {
    stuckT: f64,
    barkT: f64,
    jump: bool,
    dash: bool,
    bark: bool,
    moveX: f64,
}

fn cellOf(v: f64): i64 {
    return Math.floor(v / TILE) as i64
}

fn hazardAhead(w: &World, tiles: f64): bool {
    let probe = w.p.x + PLAYER_W * 0.5 + tiles * TILE
    let cx = cellOf(probe)
    let cyFeet = cellOf(w.p.y + PLAYER_H - 2.0)
    let cyBody = cellOf(w.p.y + PLAYER_H * 0.5)
    if isSolid(w.lvl, cx, cyFeet) || isSolid(w.lvl, cx, cyBody) {
        return true
    }
    if tileAt(w.lvl, cx, cyFeet) == T_SPIKE || tileAt(w.lvl, cx, cyBody) == T_SPIKE {
        return true
    }
    // a hole: nothing to stand on within a couple of tiles below
    var solidBelow = false
    for k in 1..3 {
        if isSolid(w.lvl, cx, cyFeet + k) {
            solidBelow = true
        }
    }
    return !solidBelow
}

fn botStep(b: &mut Bot, w: &World, dt: f64) {
    b.moveX = 1.0
    b.jump = false
    b.dash = false
    b.bark = false
    b.barkT = b.barkT - dt

    // Let a marking finish. Jump and dash both cancel it, and a bot that jumps
    // whenever it feels like it never sees the animation at all.
    if w.p.peeT > 0.0 {
        return
    }

    if w.p.onGround && Math.abs(w.p.vx) < 24.0 {
        b.stuckT = b.stuckT + dt
    } else {
        b.stuckT = 0.0
    }

    if hazardAhead(w, 1.4) && (w.p.onGround || w.p.wallDir != 0.0) {
        b.jump = true
    }
    // Bark on a timer rather than on sight: it is a capture, and a bark that
    // fires now and then puts the animation and its ring in the frames.
    if b.barkT <= 0.0 {
        b.bark = true
        b.barkT = 1.3
    }
    if b.stuckT > 0.4 {
        b.jump = true
        b.dash = true
        b.stuckT = 0.0
    }
}

// Every sprite in the game, laid out large on a flat background. Pixel art is
// authored blind — as strings — so this is the only way to see whether a frame
// says "dog" before it is six pixels tall in a level.
fn sheet(path: &string) {
    var c = canvasNew(W, H)
    fillRect(&mut c, 0.0, 0.0, W as f64, H as f64, 0.020, 0.022, 0.038, 1.0)
    let dog = dogFrames()
    let cat = catFrames()
    let bird = birdFrames()
    let s = 4.0
    var i = 0
    while i < dog.chi.len {
        let x = 16.0 + (i as f64) * 105.0
        drawSprite(&mut c, dog.chi[i], x, 60.0, s, false, 0.25)
        drawSprite(&mut c, dog.shep[i], x, 200.0, s, false, 0.25)
        i = i + 1
    }
    i = 0
    while i < cat.len {
        drawSprite(&mut c, cat[i], 40.0 + (i as f64) * 130.0, 360.0, s, false, 0.25)
        i = i + 1
    }
    i = 0
    while i < bird.len {
        drawSprite(&mut c, bird[i], 600.0 + (i as f64) * 130.0, 360.0, s, false, 0.25)
        i = i + 1
    }
    drawSprite(&mut c, boneSprite(), 40.0, 500.0, s, false, 0.6)
    drawSprite(&mut c, hydrantSprite(), 240.0, 480.0, s, false, 0.4)
    drawSprite(&mut c, coreSprite(), 400.0, 500.0, s, false, 0.5)
    let shards = shardFrames()
    i = 0
    while i < shards.len {
        drawSprite(&mut c, shards[i], 560.0 + (i as f64) * 70.0, 500.0, s, false, 0.6)
        i = i + 1
    }
    // the marking pose large, because it is the one that has to be right
    drawSprite(&mut c, dog.chi[DOG_PEE], 700.0, 440.0, 11.0, false, 0.25)
    drawSprite(&mut c, dog.shep[DOG_PEE], 960.0, 420.0, 11.0, false, 0.25)
    present(&mut c, 0.4, 1.0, 0.9)
    writePpm(path, c)
    print("wrote " + path)
}

pub fn main(): i32 {
    let argv = args()
    var prefix = "/tmp/volt"
    var level: i64 = 0
    var shots: Vec<i64> = Vec.new()
    var i = 1
    while i < argv.len {
        if argv[i] == "--sheet" {
            sheet("/tmp/volt-sheet.ppm")
            return 0
        } else if argv[i] == "--level" && i + 1 < argv.len {
            level = argv[i + 1].parseInt().unwrapOr(level)
            i = i + 2
        } else if argv[i].len > 0 && argv[i][0] >= 48 && argv[i][0] <= 57 {
            shots.push(argv[i].parseInt().unwrapOr(0))
            i = i + 1
        } else {
            prefix = argv[i]
            i = i + 1
        }
    }
    if shots.len == 0 {
        shots.push(60)
        shots.push(300)
        shots.push(700)
    }
    var maxFrame: i64 = 0
    for k in 0..shots.len {
        maxFrame = Math.maxI64(maxFrame, shots[k])
    }

    var c = canvasNew(W, H)
    let dog = dogFrames()
    let cat = catFrames()
    let bird = birdFrames()
    let bone = boneSprite()
    let hydrant = hydrantSprite()
    let shards = shardFrames()
    let core = coreSprite()
    let ts = tileSetNew()
    var w = worldNew(level, W as f64, H as f64)
    var b = Bot {
        stuckT: 0.0, barkT: 0.6, jump: false, dash: false, bark: false, moveX: 1.0
    }
    let dt = 1.0 / 60.0

    for frame in 0..maxFrame + 1 {
        botStep(&mut b, w, dt)
        worldUpdate(&mut w, dt, b.moveX, false, b.jump, true, b.dash, b.bark)

        if w.evPee {
            print("marking a hydrant at frame " + frame.toString())
        }
        var want = false
        for k in 0..shots.len {
            if shots[k] == frame {
                want = true
            }
        }
        if want {
            drawBackground(&mut c, w)
            drawLevel(&mut c, w, ts, 0.0, 0.0)
            drawGoal(&mut c, w, 0.0, 0.0)
            drawChecks(&mut c, w, hydrant, 0.0, 0.0)
            drawPickups(&mut c, w, shards, core, bone, 0.0, 0.0)
            drawMobs(&mut c, w, cat, bird, 0.0, 0.0)
            drawPlayer(&mut c, w, dog, 0.0, 0.0)
            drawPee(&mut c, w, 0.0, 0.0)
            drawBark(&mut c, w, 0.0, 0.0)
            drawParts(&mut c, w, 0.0, 0.0)
            drawSpeedLines(&mut c, w)
            drawHud(&mut c, w, shards[0], bone, 60)
            present(&mut c, 0.28, 1.0, 2.2)
            writePpm(prefix + "-" + frame.toString() + ".ppm", c)
            print("wrote " + prefix + "-" + frame.toString() + ".ppm")
        }
    }
    print("level " + w.lvlIdx.toString() + " x " + (w.p.x as i64).toString() + " shards " + w.shards.toString() + "/" + w.shardTotal.toString() + " deaths " + w.deaths.toString() + " form " + w.p.form.toString())
    return 0
}
