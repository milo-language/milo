// @run: /tmp/milo-shot-dig 1
// Absolute /tmp prefix on purpose: the example harnesses run from the repo root,
// so a bare prefix would drop .ppm frames into the working tree.
// Headless capture: drives the digger on a scripted path and dumps PPM frames.
// Also a deterministic smoke test for worldgen and the drill.

from "std/math" import {
    Math
}
from "std/args" import {
    args
}
from "./gfx" import {
    Canvas, canvasNew, present
}
from "./world" import {
    Mine, mineNew, mineUpdate, TILE, MAP_W, MAP_H, tileAt, tileValue
}
from "./render" import {
    drawMine, drawHud
}

pub extern fn fopen(path: *u8, mode: *u8): *u8

pub extern fn fwrite(ptr: *u8, size: i64, count: i64, stream: *u8): i64

pub extern fn fclose(stream: *u8): i32

pub let W: i64 = 1280

pub let H: i64 = 720

fn writePpm(path: &string, c: &Canvas) {
    var rgb: Vec<u8> = Vec.filled(W * H * 3, 0)
    for i in 0..W * H {
        let px = c.fb[i]
        rgb[i * 3] = (px & 0xFF) as u8
        rgb[i * 3 + 1] = ((px >> 8) & 0xFF) as u8
        rgb[i * 3 + 2] = ((px >> 16) & 0xFF) as u8
    }
    let header = "P6\n" + W.toString() + " " + H.toString() + "\n255\n"
    unsafe {
        let f = fopen(path.cstr(), "wb".cstr())
        if (f as i64) == 0 {
            print("cannot open " + path)
            return
        }
        let _ = fwrite(header.cstr(), 1, header.len, f)
        let _ = fwrite(rgb.ptr() as *u8, 1, W * H * 3, f)
        let _ = fclose(f)
    }
}

pub fn main(): i32 {
    let argv = args()
    var prefix = "/tmp/prospect"
    if argv.len > 1 {
        prefix = argv[1]
    }
    var shots: Vec<i64> = Vec.new()
    for i in 2..argv.len {
        let Some(frame) = argv[i].parseInt() else {
            continue
        }
        shots.push(frame)
    }
    if shots.len == 0 {
        shots.push(300)
        shots.push(1500)
    }
    var maxFrame: i64 = 0
    for i in 0..shots.len {
        maxFrame = Math.maxI64(maxFrame, shots[i])
    }

    var c = canvasNew(W, H)
    var m = mineNew()
    let dt = 1.0 / 60.0

    var tgtX: i64 = -1
    var tgtY: i64 = -1
    var lastScore: i64 = 0
    var stall: i64 = 0
    var detour: i64 = 0

    for frame in 0..maxFrame + 1 {
        // Steer at the door once it is open, otherwise at the nearest seam.
        // A fixed sweep pattern wedges itself along the bottom row and stops
        // collecting, which reads as an unwinnable level when it is only an
        // unwinnable robot — and that is exactly the thing this is here to catch.
        if m.exitOpen {
            tgtX = m.exitX
            tgtY = m.gateY
        } else if frame % 20 == 0 || tgtX < 0 {
            let cx = (m.px / TILE) as i64
            let cy = (m.py / TILE) as i64
            var best: i64 = 1000000
            tgtX = -1
            for y in 0..MAP_H {
                for x in 0..MAP_W {
                    if tileValue(tileAt(m, x, y)) == 0 {
                        continue
                    }
                    let d = Math.absI64(x - cx) + Math.absI64(y - cy)
                    if d < best {
                        best = d
                        tgtX = x
                        tgtY = y
                    }
                }
            }
        }
        // The locked door is a 2x2 obstacle in the middle of the map, and a
        // greedy seeker will grind against it forever if the seam it wants is on
        // the far side. Bank on the score: if nothing has been collected in four
        // seconds, climb for a while and re-approach from above.
        if m.score != lastScore {
            lastScore = m.score
            stall = 0
        } else {
            stall += 1
        }
        if stall > 240 {
            detour = 100
            stall = 0
        }
        var ix = 0.0
        var iy = 0.0
        if detour > 0 {
            detour -= 1
            iy = 0.0 - 1.0
        } else if tgtX >= 0 {
            let dx = ((tgtX as f64) + 0.5) * TILE - m.px
            let dy = ((tgtY as f64) + 0.5) * TILE - m.py
            if Math.abs(dx) > 8.0 && Math.abs(dx) >= Math.abs(dy) {
                ix = if dx > 0.0 {
                    1.0
                } else {
                    0.0 - 1.0
                }
            } else if Math.abs(dy) > 8.0 {
                iy = if dy > 0.0 {
                    1.0
                } else {
                    0.0 - 1.0
                }
            }
        } else {
            iy = 1.0
        }
        mineUpdate(&mut m, dt, ix, iy, W as f64, H as f64)

        var want = false
        for i in 0..shots.len {
            if shots[i] == frame {
                want = true
            }
        }
        if want {
            drawMine(&mut c, m, 0.0, 0.0)
            drawHud(&mut c, m)
            present(&mut c, 0.18, 1.0)
            writePpm(prefix + "-" + frame.toString() + ".ppm", c)
            print("wrote " + prefix + "-" + frame.toString() + ".ppm")
        }
    }
    print("level " + m.level.toString() + " value " + m.score.toString() + " gold " + m.gold.toString() + " gems " + m.gems.toString() + " depth " + m.deepest.toString())
    return 0
}
