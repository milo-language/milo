// PROSPECT — the mine.
//
// A side-on tile world you tunnel through. There is no timer, nothing chases you,
// and you cannot die: the whole loop is dig, find, collect. Depth is the only
// pressure, and it is entirely self-imposed.

from "std/math" import {
    Math
}
from "std/random" import {
    Random
}

// Big chunky tiles. A five-year-old reads "one block = one thing you can dig";
// at 18px the ground was a field of detail nobody could parse.
//
// 40 px divides the 1280-wide window exactly 32 times, and the map is exactly
// that wide — so there is never any horizontal scrolling and the door, which
// runs the full height of the right-hand wall, is on screen at all times. You
// can see the thing you are working towards from the first frame to the last.
pub let TILE: f64 = 40.0

pub let MAP_W: i64 = 32

pub let MAP_H: i64 = 40

// tile kinds
pub let T_SKY: i64 = 0

pub let T_DIRT: i64 = 1

pub let T_CLAY: i64 = 2

pub let T_STONE: i64 = 3

pub let T_BEDROCK: i64 = 4

pub let T_GOLD: i64 = 5

pub let T_GEM: i64 = 6

pub let T_CRYSTAL: i64 = 7

pub let T_WATER: i64 = 8

pub let T_PWR_DRILL: i64 = 9

pub let T_PWR_WIDE: i64 = 10

pub let T_PWR_LAMP: i64 = 11

pub let T_GATE: i64 = 12

pub struct Col {
    r: f64,
    g: f64,
    b: f64,
}

pub struct Part {
    x: f64,
    y: f64,
    vx: f64,
    vy: f64,
    life: f64,
    maxLife: f64,
    size: f64,
    grow: f64, // a dust puff swells as it dies; solid debris keeps this at 0
    drag: f64,
    gravity: f64,
    cr: f64,
    cg: f64,
    cb: f64,
}

// A nugget in flight between the seam it came out of and the satchel. It drifts
// out first, hangs for a beat, then homes in and accelerates — the counter only
// ticks when it actually lands, which is what makes collecting feel like collecting.
pub struct Fly {
    x: f64,
    y: f64,
    vx: f64,
    vy: f64,
    age: f64,
    kind: i64,
    value: i64,
}

// A value that floats up from where something was collected.
pub struct Pop {
    x: f64,
    y: f64,
    life: f64,
    text: string,
    cr: f64,
    cg: f64,
    cb: f64,
}

pub struct Mine {
    tiles: Vec<u8>,
    // How far the current tile has been drilled, 0..1. Only the tile under the
    // drill is ever non-zero, so one scalar is enough.
    digX: i64,
    digY: i64,
    digProgress: f64,
    px: f64, // player position, in pixels
    py: f64,
    faceX: f64, // last facing direction, for the drill sprite
    faceY: f64,
    camX: f64,
    camY: f64,
    gold: i64,
    gems: i64,
    crystals: i64,
    score: i64,
    deepest: i64,
    drillRate: f64,
    lampRadius: f64,
    parts: Vec<Part>,
    pops: Vec<Pop>,
    flies: Vec<Fly>,
    satchelPulse: f64,
    goldPulse: f64,
    shake: f64,
    flash: f64,
    time: f64,
    banner: f64,
    hint: f64,
    level: i64,
    quota: i64,
    levelValue: i64,
    exitX: i64,
    exitOpen: bool,
    gateY: i64,
    // The playable box. Width is pinned to exactly one screen forever; only the
    // depth grows with the level. Everything past worldH is filled with bedrock.
    worldW: i64,
    worldH: i64,
    cleared: f64,
    wideDig: bool,
    lampLevel: i64,
    drillLevel: i64,
    // What the dog is doing, and for how long. The renderer picks a whole
    // animation off these three: paws churning while the drill bites, a sit and a
    // tail wag when you let go. `stateT` restarts on every change so a transition
    // can be played rather than snapped to.
    digging: bool,
    moving: bool,
    stateT: f64,
    blinkT: f64, // counts down to the next blink; negative while the eyes are shut
    // 0 while the door is shut, 1 once the leaf has finished swinging clear. The
    // door is passable the instant the quota lands; this is only the picture of
    // it, and it has to take long enough to be seen.
    doorAnim: f64,
}

// Deterministic value noise — no allocation, no state, same map every run so a
// good seam is somewhere you can go back to.
fn hash2(x: i64, y: i64): f64 {
    let v = Math.sin((x as f64) * 127.1 + (y as f64) * 311.7) * 43758.5453
    return v - Math.floor(v)
}

fn smoothNoise(x: f64, y: f64): f64 {
    let x0 = Math.floor(x) as i64
    let y0 = Math.floor(y) as i64
    let fx = x - (x0 as f64)
    let fy = y - (y0 as f64)
    let sx = fx * fx * (3.0 - 2.0 * fx)
    let sy = fy * fy * (3.0 - 2.0 * fy)
    let n00 = hash2(x0, y0)
    let n10 = hash2(x0 + 1, y0)
    let n01 = hash2(x0, y0 + 1)
    let n11 = hash2(x0 + 1, y0 + 1)
    let a = n00 + (n10 - n00) * sx
    let b = n01 + (n11 - n01) * sx
    return a + (b - a) * sy
}

pub fn tileAt(m: &Mine, x: i64, y: i64): i64 {
    if x < 0 || y < 0 || x >= MAP_W || y >= MAP_H {
        return T_BEDROCK
    }
    return m.tiles[y * MAP_W + x] as i64
}

pub fn setTile(m: &mut Mine, x: i64, y: i64, t: i64) {
    if x < 0 || y < 0 || x >= MAP_W || y >= MAP_H {
        return
    }
    m.tiles[y * MAP_W + x] = t as u8
}

pub let SURFACE: i64 = 4

// How big this level's box is, and what it costs to open the door.
fn sizeForLevel(m: &mut Mine) {
    // Always exactly one screen wide — that is the whole point, and nothing here
    // may change it. Level 1 is exactly one screen tall too, so the first level
    // does not scroll at all; later levels grow downward only.
    // One screen, exactly, on every level: 32 x 18 tiles of 40 px is 1280 x 720.
    // Nothing scrolls, ever — what you see is the whole level. Later levels get
    // harder through what is IN the ground, not through more of it.
    m.worldW = MAP_W
    m.worldH = SURFACE + 14
    m.quota = 75 + (m.level - 1) * 25
    // The door is a 2x2 block buried out in the ground, not a wall down the side
    // of the map. It sits well clear of the shaft head you start in, and its top
    // left corner is (exitX, gateY). Somewhere different every level, but always
    // reachable and never against an edge.
    let spanX = Math.maxI64(1, m.worldW - 14)
    let spanY = Math.maxI64(1, m.worldH - SURFACE - 6)
    m.exitX = 8 + (m.level * 7) % spanX
    m.gateY = SURFACE + 2 + (m.level * 5) % spanY
}

fn generate(m: &mut Mine) {
    sizeForLevel(&mut m)
    // The level number offsets every noise field, so each level is a different
    // stretch of ground rather than the same map re-tuned.
    let seed = (m.level as f64) * 137.0
    // There is NO bedrock inside the map — only the border. Scattered boulders
    // looked good and could, rarely, ring a pocket of ground and wall it off for
    // good. "I am stuck and I do not know why" is the one way this game can stop
    // being fun, and the only way to rule it out completely is for every single
    // tile inside the border to be diggable. Difficulty comes from how hard the
    // ground is and how much the door costs, not from walls.
    for y in 0..MAP_H {
        for x in 0..MAP_W {
            var t = T_DIRT
            if y < SURFACE {
                t = T_SKY
            } else if y >= m.worldH - 1 || x == 0 || x >= m.worldW - 1 || x >= MAP_W - 1 || y >= MAP_H - 1 {
                t = T_BEDROCK
            } else {
                let depth = ((y - SURFACE) as f64) / ((m.worldH - SURFACE) as f64)
                // Three grounds, in three clear bands: soft brown dirt on top,
                // orange clay in the middle, grey stone at the bottom. Banded by
                // depth rather than scattered by noise, so "where am I" and "what
                // is this" are the same question.
                let hardness = smoothNoise((x as f64) * 0.11 + seed, (y as f64) * 0.11 + seed)
                // A slow horizontal wobble on the band boundaries. Without it the
                // change from dirt to clay is a ruler-straight line across the
                // whole map, which looks drawn rather than dug.
                let band = depth + (smoothNoise((x as f64) * 0.13 + 700.0 + seed, (y as f64) * 0.04 + seed) - 0.5) * 0.44
                if band > 0.34 && hardness > 0.72 - band * 0.55 {
                    t = T_CLAY
                }
                if band > 0.64 && hardness > 0.86 - band * 0.62 {
                    t = T_STONE
                }
                // Ore veins: a separate noise field per ore, each past its own
                // depth. Generous — finding treasure is the whole game, so it
                // should happen every few seconds, not every few minutes.
                let vein = smoothNoise((x as f64) * 0.19 + 11.0 + seed, (y as f64) * 0.19 + 7.0 + seed)
                if depth > 0.04 && vein > 0.888 {
                    t = T_GOLD
                }
                let vein2 = smoothNoise((x as f64) * 0.22 + 91.0 + seed, (y as f64) * 0.22 + 51.0 + seed)
                if depth > 0.45 && vein2 > 0.930 {
                    t = T_GEM
                }
                let vein3 = smoothNoise((x as f64) * 0.28 + 5.0 + seed, (y as f64) * 0.28 + 77.0 + seed)
                if depth > 0.72 && vein3 > 0.955 {
                    t = T_CRYSTAL
                }
                // One or two small ponds. Broad, smooth noise so they come out as
                // pools rather than speckle. You swim through; nothing bad happens.
                let wet = smoothNoise((x as f64) * 0.07 + 300.0 + seed, (y as f64) * 0.13 + 120.0 + seed)
                if depth > 0.28 && depth < 0.88 && wet > 0.895 {
                    t = T_WATER
                }
                // Buried upgrades: uncommon, but shallow enough to actually meet one.
                let up = smoothNoise((x as f64) * 0.55 + 613.0 + seed, (y as f64) * 0.55 + 217.0 + seed)
                if depth > 0.10 && up > 0.960 {
                    let pick = (hash2(x * 7 + 3, y * 11 + 5) * 3.0) as i64
                    if pick == 0 {
                        t = T_PWR_DRILL
                    } else if pick == 1 {
                        t = T_PWR_WIDE
                    } else {
                        t = T_PWR_LAMP
                    }
                }
            }
            m.tiles[y * MAP_W + x] = t as u8
        }
    }
    // A narrow shaft head to start in, rather than a wide pit — a 5x2 hole read
    // as a bathtub with the dog sitting in it.
    for y in SURFACE..SURFACE + 5 {
        m.tiles[y * MAP_W + 4] = T_SKY as u8
        m.tiles[y * MAP_W + 5] = T_SKY as u8
    }
    // The door, written last so nothing in the generator can bury it. Bedrock
    // touching it is downgraded to plain dirt: bedrock cannot be dug, and a door
    // you cannot reach is worse than no door at all.
    for y in m.gateY - 1..m.gateY + 3 {
        for x in m.exitX - 1..m.exitX + 3 {
            if x < 1 || y < SURFACE || x >= m.worldW - 1 || y >= m.worldH - 1 {
                continue
            }
            if m.tiles[y * MAP_W + x] as i64 == T_BEDROCK {
                m.tiles[y * MAP_W + x] = T_DIRT as u8
            }
        }
    }
    for y in m.gateY..m.gateY + 2 {
        for x in m.exitX..m.exitX + 2 {
            m.tiles[y * MAP_W + x] = T_GATE as u8
        }
    }
    ensureEnoughTreasure(&mut m)
}

// A level must always be winnable. Noise thresholds do not promise that: an
// unlucky seed can leave less gold in the ground than the door costs, and a
// child digging a map that cannot be finished has no way to know that is what
// happened. So count what is actually buried here and seed more until there is
// twice the quota, which also means you never have to strip the whole map.
//
// The scatter is deterministic — a stride coprime with the grid size — because
// a level has to be the same every run.
fn ensureEnoughTreasure(m: &mut Mine) {
    let cells = m.worldW * m.worldH
    var total: i64 = 0
    for y in SURFACE..m.worldH {
        for x in 0..m.worldW {
            total += tileValue(m.tiles[y * MAP_W + x] as i64)
        }
    }
    let need = m.quota * 2
    var i: i64 = 0
    while total < need && i < cells {
        let idx = (i * 7919) % cells
        let x = idx % m.worldW
        let y = idx / m.worldW
        i += 1
        if x < 1 || x >= m.worldW - 1 || y < SURFACE + 1 || y >= m.worldH - 1 {
            continue
        }
        let t = m.tiles[y * MAP_W + x] as i64
        if t != T_DIRT && t != T_CLAY && t != T_STONE {
            continue
        }
        m.tiles[y * MAP_W + x] = T_GOLD as u8
        total += tileValue(T_GOLD)
    }
}

pub fn mineNew(): Mine {
    var m = Mine {
        tiles: Vec.filled(MAP_W * MAP_H, 0),
        digX: 0 - 1,
        digY: 0 - 1,
        digProgress: 0.0,
        px: 5.0 * TILE,
        py: (SURFACE as f64) * TILE - TILE * 0.5,
        faceX: 1.0,
        faceY: 0.0,
        camX: 0.0,
        camY: 0.0,
        gold: 0,
        gems: 0,
        crystals: 0,
        score: 0,
        deepest: SURFACE,
        drillRate: 3.0,
        lampRadius: 420.0,
        parts: Vec.new(),
        pops: Vec.new(),
        flies: Vec.new(),
        satchelPulse: 0.0,
        goldPulse: 0.0,
        shake: 0.0,
        flash: 0.0,
        time: 0.0,
        banner: 3.0,
        hint: 6.0,
        level: 1,
        quota: 75,
        levelValue: 0,
        exitX: 12,
        exitOpen: false,
        gateY: SURFACE + 6,
        worldW: 0,
        worldH: 0,
        cleared: 0.0,
        wideDig: false,
        lampLevel: 0,
        drillLevel: 0,
        digging: false,
        moving: false,
        stateT: 0.0,
        blinkT: 2.0,
        doorAnim: 0.0,
    }
    generate(&mut m)
    return m
}

// Fresh ground, one level further along the seam.
pub fn nextLevel(m: &mut Mine) {
    m.level += 1
    m.levelValue = 0
    m.exitOpen = false
    m.wideDig = false
    m.banner = 2.6
    m.px = 5.0 * TILE
    m.py = (SURFACE as f64) * TILE - TILE * 0.5
    m.camX = 0.0
    m.camY = 0.0
    m.doorAnim = 0.0
    m.deepest = SURFACE
    m.digX = 0 - 1
    m.digProgress = 0.0
    m.flies.clear()
    generate(&mut m)
}

// Each ground gets its own HUE, not its own shade of brown: warm tan, orange
// clay, cool blue-grey stone, violet-black bedrock. Telling them apart at a
// glance matters more than realism.
pub fn tileColor(t: i64): Col {
    if t == T_DIRT {
        return Col {
            r: 1.00, g: 0.58, b: 0.22
        }
    }
    if t == T_CLAY {
        return Col {
            r: 1.15, g: 0.28, b: 0.10
        }
    }
    if t == T_STONE {
        return Col {
            r: 0.32, g: 0.46, b: 0.72
        }
    }
    if t == T_BEDROCK {
        return Col {
            r: 0.22, g: 0.16, b: 0.32
        }
    }
    if t == T_GOLD {
        return Col {
            r: 1.55, g: 1.05, b: 0.22
        }
    }
    if t == T_GEM {
        return Col {
            r: 0.25, g: 1.35, b: 0.70
        }
    }
    if t == T_CRYSTAL {
        return Col {
            r: 1.20, g: 0.40, b: 1.55
        }
    }
    if t == T_WATER {
        return Col {
            r: 0.20, g: 0.75, b: 1.30
        }
    }
    // These four used to fall through to black, which drew the gate and every
    // buried upgrade as an invisible tile lit by an ambient term.
    if t == T_GATE {
        return Col {
            r: 1.30, g: 0.55, b: 0.06
        }
    }
    if t == T_PWR_DRILL {
        return Col {
            r: 1.50, g: 0.55, b: 0.20
        }
    }
    if t == T_PWR_WIDE {
        return Col {
            r: 0.35, g: 0.80, b: 1.55
        }
    }
    if t == T_PWR_LAMP {
        return Col {
            r: 1.55, g: 1.40, b: 0.35
        }
    }
    return Col {
        r: 0.0, g: 0.0, b: 0.0
    }
}

// How many seconds of drilling a tile costs. Short: a block should crumble about
// as fast as a small child's patience runs out.
pub fn tileToughness(t: i64): f64 {
    if t == T_DIRT {
        return 0.22
    }
    if t == T_CLAY {
        return 0.34
    }
    if t == T_STONE {
        return 0.55
    }
    if t == T_GOLD {
        return 0.30
    }
    if t == T_GEM {
        return 0.40
    }
    if t == T_CRYSTAL {
        return 0.55
    }
    return 0.0 // bedrock: never
}

pub fn tileValue(t: i64): i64 {
    if t == T_GOLD {
        return 25
    }
    if t == T_GEM {
        return 100
    }
    if t == T_CRYSTAL {
        return 300
    }
    return 0
}

pub fn isUpgrade(t: i64): bool {
    return t == T_PWR_DRILL || t == T_PWR_WIDE || t == T_PWR_LAMP
}

pub fn tileName(t: i64): string {
    if t == T_GOLD {
        return "GOLD"
    }
    if t == T_GEM {
        return "EMERALD"
    }
    if t == T_CRYSTAL {
        return "CRYSTAL"
    }
    return ""
}

pub fn isSolid(t: i64): bool {
    return t != T_SKY && t != T_WATER
}

// The gate blocks the way until the quota is met; after that you walk straight in.
pub fn gateBlocks(m: &Mine, t: i64): bool {
    return t == T_GATE && !m.exitOpen
}

// ── effects ───────────────────────────────────────────────────────────────────

pub fn burst(m: &mut Mine, x: f64, y: f64, n: i64, speed: f64, c: &Col) {
    for i in 0..n {
        let a = Random.floatRange(0.0, 6.283185307179586)
        let sp = Random.floatRange(speed * 0.2, speed)
        let life = Random.floatRange(0.3, 0.9)
        m.parts.push(Part {
            x: x,
            y: y,
            vx: Math.cos(a) * sp,
            vy: Math.sin(a) * sp - 40.0,
            life: life,
            maxLife: life,
            size: Random.floatRange(2.2, 4.2),
            grow: 0.0,
            drag: 0.25,
            gravity: 560.0,
            cr: c.r,
            cg: c.g,
            cb: c.b,
        }
        )
    }
}

// The demolition effect: a dust cloud that swells and vanishes fast, plus a few
// solid chunks that arc out and fall. The cloud is what sells the collapse; it
// has to dissipate quickly or the tunnel fills with fog.
pub fn poof(m: &mut Mine, x: f64, y: f64, c: &Col) {
    for i in 0..9 {
        let a = Random.floatRange(0.0, 6.283185307179586)
        let sp = Random.floatRange(22.0, 80.0)
        let life = Random.floatRange(0.22, 0.40)
        m.parts.push(Part {
            x: x + Random.floatRange(0.0 - 9.0, 9.0),
            y: y + Random.floatRange(0.0 - 9.0, 9.0),
            vx: Math.cos(a) * sp,
            vy: Math.sin(a) * sp - 26.0,
            life: life,
            maxLife: life,
            size: Random.floatRange(9.0, 17.0),
            grow: 2.4, // swells as it fades
            drag: 3.2, // and stalls almost immediately
            gravity: 0.0 - 30.0, // dust drifts up, it does not fall
            cr: c.r * 0.55,
            cg: c.g * 0.50,
            cb: c.b * 0.46,
        }
        )
    }
    for i in 0..7 {
        let a = Random.floatRange(0.0 - 2.6, 0.0 - 0.5)
        let sp = Random.floatRange(120.0, 300.0)
        let life = Random.floatRange(0.5, 1.0)
        m.parts.push(Part {
            x: x,
            y: y,
            vx: Math.cos(a) * sp,
            vy: Math.sin(a) * sp,
            life: life,
            maxLife: life,
            size: Random.floatRange(2.8, 5.2),
            grow: 0.0,
            drag: 0.4,
            gravity: 900.0,
            cr: c.r,
            cg: c.g,
            cb: c.b,
        }
        )
    }
}

pub fn addPop(m: &mut Mine, x: f64, y: f64, t: string, c: &Col) {
    m.pops.push(Pop {
        x: x, y: y, life: 1.3, text: t, cr: c.r, cg: c.g, cb: c.b
    }
    )
}

// ── digging ───────────────────────────────────────────────────────────────────

fn collect(m: &mut Mine, t: i64, x: f64, y: f64) {
    let v = tileValue(t)
    if v == 0 {
        return
    }
    let col = tileColor(t)
    burst(&mut m, x, y, 22, 240.0, col)
    m.flash = Math.maxF64(m.flash, 0.14)
    m.shake = Math.maxF64(m.shake, 2.5)
    // Split the tile's worth across a handful of nuggets, so a gold seam sprays
    // and a crystal pours. Nothing is banked here — that happens on arrival.
    var n = 3
    if v >= 120 {
        n = 5
    }
    if v >= 500 {
        n = 9
    }
    let each = v / n
    for i in 0..n {
        let a = Random.floatRange(0.0, 6.283185307179586)
        let sp = Random.floatRange(60.0, 180.0)
        m.flies.push(Fly {
            x: x,
            y: y,
            vx: Math.cos(a) * sp,
            vy: Math.sin(a) * sp - 60.0,
            age: 0.0 - Random.floatRange(0.0, 0.08),
            kind: t,
            value: each,
        }
        )
    }
}

// Where the satchel rides on the digger.
pub fn satchelX(m: &Mine): f64 {
    return m.px - m.faceX * 20.0
}

pub fn satchelY(m: &Mine): f64 {
    return m.py + 14.0
}

fn bank(m: &mut Mine, kind: i64, value: i64) {
    m.score += value
    m.levelValue += value
    m.satchelPulse = 0.30
    m.goldPulse = 0.30
    if kind == T_GOLD {
        m.gold += 1
    } else if kind == T_GEM {
        m.gems += 1
    } else if kind == T_CRYSTAL {
        m.crystals += 1
    }
    if m.levelValue >= m.quota && !m.exitOpen {
        m.exitOpen = true
        m.flash = 0.8
        m.shake = 9.0
        // splinters and dust off the door as the lock gives
        let dx = (m.exitX as f64) * TILE + TILE
        for i in 0..5 {
            let dy = m.py + Random.floatRange(0.0 - 90.0, 90.0)
            poof(&mut m, dx, dy, Col {
                r: 0.70, g: 0.34, b: 0.12
            }
            )
        }
        addPop(&mut m, m.px, m.py - 44.0, "THE DOOR IS OPEN", Col {
            r: 0.4, g: 1.4, b: 0.6
        }
        )
    }
}

// Nuggets scatter out of the seam, hang for a beat, then home in on the satchel
// with an acceleration that keeps rising. The counter ticks when one lands.
fn updateFlies(m: &mut Mine, dt: f64) {
    let tx = satchelX(m)
    let ty = satchelY(m)
    var i: i64 = 0
    while i < m.flies.len {
        m.flies[i].age += dt
        if m.flies[i].age < 0.0 {
            i += 1
            continue
        }
        if m.flies[i].age < 0.22 {
            let d = Math.pow(0.02, dt)
            m.flies[i].vx *= d
            m.flies[i].vy = m.flies[i].vy * d + 260.0 * dt
        } else {
            let dx = tx - m.flies[i].x
            let dy = ty - m.flies[i].y
            let dist = Math.sqrt(dx * dx + dy * dy) + 0.001
            let pull = 1500.0 + (m.flies[i].age - 0.22) * 5200.0
            m.flies[i].vx = m.flies[i].vx + dx / dist * pull * dt
            m.flies[i].vy = m.flies[i].vy + dy / dist * pull * dt
            let damp = Math.pow(0.18, dt)
            m.flies[i].vx *= damp
            m.flies[i].vy *= damp
        }
        m.flies[i].x = m.flies[i].x + m.flies[i].vx * dt
        m.flies[i].y = m.flies[i].y + m.flies[i].vy * dt

        let dx2 = tx - m.flies[i].x
        let dy2 = ty - m.flies[i].y
        if dx2 * dx2 + dy2 * dy2 < 324.0 && m.flies[i].age > 0.22 {
            let col = tileColor(m.flies[i].kind)
            let k = m.flies[i].kind
            let v2 = m.flies[i].value
            let last = m.flies.len - 1
            m.flies[i] = m.flies[last]
            let _ = m.flies.pop()
            bank(&mut m, k, v2)
            burst(&mut m, tx, ty, 4, 90.0, col)
        } else {
            i += 1
        }
    }
}

fn breakTile(m: &mut Mine, tx: i64, ty: i64, t: i64) {
    let cx = (tx as f64) * TILE + TILE * 0.5
    let cy = (ty as f64) * TILE + TILE * 0.5
    setTile(&mut m, tx, ty, T_SKY)
    let col = tileColor(t)
    poof(&mut m, cx, cy, col)
    m.shake = Math.maxF64(m.shake, 1.2)
    if isUpgrade(t) {
        applyUpgrade(&mut m, t, cx, cy)
    } else {
        collect(&mut m, t, cx, cy)
    }
    if ty > m.deepest {
        m.deepest = ty
    }
}

// The extra bite a wide drill takes: only soft ground, never bedrock, and it does
// not chain into more wide digging.
fn breakSoft(m: &mut Mine, tx: i64, ty: i64) {
    let t = tileAt(m, tx, ty)
    if t == T_SKY || t == T_BEDROCK || t == T_WATER {
        return
    }
    breakTile(&mut m, tx, ty, t)
}

fn applyUpgrade(m: &mut Mine, t: i64, x: f64, y: f64) {
    let col = tileColor(t)
    burst(&mut m, x, y, 40, 300.0, col)
    m.flash = Math.maxF64(m.flash, 0.5)
    m.shake = Math.maxF64(m.shake, 6.0)
    if t == T_PWR_DRILL {
        m.drillLevel += 1
        m.drillRate *= 1.45
        addPop(&mut m, x, y - 12.0, "DRILL UPGRADED", col)
    } else if t == T_PWR_WIDE {
        m.wideDig = true
        addPop(&mut m, x, y - 12.0, "WIDE DRILL", col)
    } else {
        m.lampLevel += 1
        m.lampRadius += 110.0
        addPop(&mut m, x, y - 12.0, "BRIGHTER LAMP", col)
    }
}

// Advance the drill against whatever tile the player is pushing into. Returns
// true while a tile is actively being dug, so the renderer can show the bite.
fn drill(m: &mut Mine, tx: i64, ty: i64, dt: f64): bool {
    let t = tileAt(m, tx, ty)
    if t == T_SKY || t == T_BEDROCK || t == T_GATE {
        m.digX = 0 - 1
        m.digProgress = 0.0
        return false
    }
    if tx != m.digX || ty != m.digY {
        m.digX = tx
        m.digY = ty
        m.digProgress = 0.0
    }
    m.digProgress = m.digProgress + dt * m.drillRate / tileToughness(t)
    // crumbs while the bit is turning
    if Random.range(0, 3) == 0 {
        let col = tileColor(t)
        let cx = (tx as f64) * TILE + TILE * 0.5
        let cy = (ty as f64) * TILE + TILE * 0.5
        m.parts.push(Part {
            x: cx + Random.floatRange(0.0 - 16.0, 16.0),
            y: cy + Random.floatRange(0.0 - 16.0, 16.0),
            vx: Random.floatRange(0.0 - 70.0, 70.0),
            vy: Random.floatRange(0.0 - 120.0, 0.0 - 20.0),
            life: 0.3,
            maxLife: 0.3,
            size: 3.0,
            grow: 0.0,
            drag: 0.4,
            gravity: 760.0,
            cr: col.r,
            cg: col.g,
            cb: col.b,
        }
        )
    }
    if m.digProgress >= 1.0 {
        breakTile(&mut m, tx, ty, t)
        // A wide drill takes the two tiles either side of the bit as well, along
        // whichever axis is perpendicular to the direction of travel.
        if m.wideDig {
            if m.faceY != 0.0 {
                breakSoft(&mut m, tx - 1, ty)
                breakSoft(&mut m, tx + 1, ty)
            } else {
                breakSoft(&mut m, tx, ty - 1)
                breakSoft(&mut m, tx, ty + 1)
            }
        }
        m.digX = 0 - 1
        m.digProgress = 0.0
    }
    return true
}

pub fn mineUpdate(m: &mut Mine, dt: f64, inX: f64, inY: f64, viewW: f64, viewH: f64) {
    m.time += dt
    if m.shake > 0.0 {
        m.shake *= Math.pow(0.02, dt)
    }
    if m.flash > 0.0 {
        m.flash = m.flash - dt * 1.6
    }
    if m.banner > 0.0 {
        m.banner -= dt
    }
    if m.hint > 0.0 && (inX != 0.0 || inY != 0.0) {
        m.hint -= dt
    }

    if inX != 0.0 || inY != 0.0 {
        m.faceX = inX
        m.faceY = inY
    }

    // Move freely through open ground; push into solid ground and the drill bites.
    // No gravity and no fall damage — this is a game about choosing where to go.
    let speed = 300.0
    var moved = false
    var biting = false
    if inX != 0.0 {
        let nx = m.px + inX * speed * dt
        let tx = ((nx + inX * TILE * 0.42) / TILE) as i64
        let ty = (m.py / TILE) as i64
        let tt = tileAt(m, tx, ty)
        if !isSolid(tt) || (tt == T_GATE && m.exitOpen) {
            m.px = nx
            moved = true
        } else {
            biting = drill(&mut m, tx, ty, dt) || biting
            moved = true
        }
    }
    if inY != 0.0 {
        let ny = m.py + inY * speed * dt
        let tx = (m.px / TILE) as i64
        let ty = ((ny + inY * TILE * 0.42) / TILE) as i64
        let tt = tileAt(m, tx, ty)
        if !isSolid(tt) || (tt == T_GATE && m.exitOpen) {
            m.py = ny
            moved = true
        } else {
            biting = drill(&mut m, tx, ty, dt) || biting
            moved = true
        }
    }
    if !moved {
        m.digX = 0 - 1
        m.digProgress = 0.0
    }
    // Animation state. A change restarts the clock, so the renderer can play the
    // first half-second of "just stopped" differently from "has been sitting a while".
    if biting != m.digging || moved != m.moving {
        m.stateT = 0.0
    } else {
        m.stateT += dt
    }
    m.digging = biting
    m.moving = moved
    m.blinkT -= dt
    if m.blinkT < 0.0 - 0.13 {
        m.blinkT = Random.floatRange(1.4, 4.5)
    }
    m.px = Math.clampF64(m.px, TILE, (m.worldW as f64) * TILE - TILE)
    m.py = Math.clampF64(m.py, TILE * 0.5, (m.worldH as f64) * TILE - TILE)

    // reaching the lit shaft on the right ends the level
    if m.cleared > 0.0 {
        m.cleared -= dt
        if m.cleared <= 0.0 {
            nextLevel(&mut m)
        }
    } else if m.exitOpen {
        // Standing anywhere in the doorway finishes the level.
        let dx0 = (m.exitX as f64) * TILE
        let dy0 = (m.gateY as f64) * TILE
        if m.px > dx0 - TILE * 0.4 && m.px < dx0 + TILE * 2.4 && m.py > dy0 - TILE * 0.4 && m.py < dy0 + TILE * 2.4 {
            m.cleared = 2.6
            m.flash = 0.40
            m.shake = 10.0
        }
    }

    // camera eases toward the player and stops at the world edges
    let wx = Math.maxF64((m.worldW as f64) * TILE - viewW, 0.0)
    let wy = Math.maxF64((m.worldH as f64) * TILE - viewH, 0.0)
    let wantX = Math.clampF64(m.px - viewW * 0.5, 0.0, wx)
    let wantY = Math.clampF64(m.py - viewH * 0.5, 0.0, wy)
    m.camX = m.camX + (wantX - m.camX) * Math.minF64(1.0, dt * 4.0)
    m.camY = m.camY + (wantY - m.camY) * Math.minF64(1.0, dt * 4.0)

    updateParts(&mut m, dt)
    updateFlies(&mut m, dt)
    // The leaf swings clear over about a second, so the moment you earn it is
    // something you watch happen rather than something that has already happened.
    if m.exitOpen && m.doorAnim < 1.0 {
        m.doorAnim = Math.minF64(1.0, m.doorAnim + dt * 0.9)
    }
    if m.satchelPulse > 0.0 {
        m.satchelPulse -= dt
    }
    if m.goldPulse > 0.0 {
        m.goldPulse -= dt
    }
}

fn updateParts(m: &mut Mine, dt: f64) {
    var i: i64 = 0
    while i < m.parts.len {
        m.parts[i].life -= dt
        if m.parts[i].life <= 0.0 {
            let last = m.parts.len - 1
            m.parts[i] = m.parts[last]
            let _ = m.parts.pop()
        } else {
            m.parts[i].vy = m.parts[i].vy + m.parts[i].gravity * dt
            let d = Math.pow(0.25, m.parts[i].drag * dt * 4.0)
            m.parts[i].vx *= d
            m.parts[i].x = m.parts[i].x + m.parts[i].vx * dt
            m.parts[i].y = m.parts[i].y + m.parts[i].vy * dt
            i += 1
        }
    }
    var p: i64 = 0
    while p < m.pops.len {
        m.pops[p].life -= dt
        m.pops[p].y = m.pops[p].y - 26.0 * dt
        if m.pops[p].life <= 0.0 {
            let last = m.pops.len - 1
            m.pops[p] = m.pops[last]
            let _ = m.pops.pop()
        } else {
            p += 1
        }
    }
}
