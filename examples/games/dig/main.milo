// PROSPECT — a digging game written in Milo.
//
//   milo build examples/games/dig/main.milo -o /tmp/prospect --release && /tmp/prospect
//
//   ARROW KEYS / WASD   dig — hold a direction and the drill bites
//   ESC                 quit
//
// No timer, no enemies, no fail state. You cannot lose; you can only decide how
// deep to go. Ore glows faintly at the edge of the lamp, which is the whole hook.

from "std/math" import {
    Math
}
from "sdl" import {
    SDL_INIT_VIDEO, SDL_WINDOW_SHOWN, SDL_RENDERER_ACCELERATED, SDL_RENDERER_PRESENTVSYNC
}
from "../../shared/sdlkit" import {
    Sdl, Window, Presenter, setCursorVisible, ticks
}
from "./input" import {
    Input, inputNew, pollInput
}
from "./gfx" import {
    Canvas, canvasNew, present, text, textWidth
}
from "./world" import {
    Mine, mineNew, mineUpdate
}
from "./render" import {
    drawMine, drawHud
}
from "std/random" import {
    Random
}

pub let W: i64 = 1280

pub let H: i64 = 720

pub fn main(): i32 {
    // Declared in teardown's reverse: the presenter goes first, then the window, then
    // SDL itself.
    let _sdl = match Sdl.init(SDL_INIT_VIDEO) {
        Ok(v) => v,
        Err(e) => {
            print(e)
            return 1
        }
    }
    let win = match Window.create("PROSPECT — written in Milo", W, H, SDL_WINDOW_SHOWN) {
        Ok(v) => v,
        Err(e) => {
            print(e)
            return 2
        }
    }
    let screen = match Presenter.create(win, W, H, SDL_RENDERER_ACCELERATED | SDL_RENDERER_PRESENTVSYNC) {
        Ok(v) => v,
        Err(e) => {
            print(e)
            return 2
        }
    }
    setCursorVisible(false)

    var c = canvasNew(W, H)
    var m = mineNew()
    var inp = inputNew()
    var last = ticks()
    var fpsAccum: f64 = 0.0
    var fpsFrames: i64 = 0
    var fpsShown: i64 = 0

    while !inp.quit {
        let now = ticks()
        var dt = ((now - last) as f64) / 1000.0
        last = now
        if dt > 0.05 {
            dt = 0.05
        }
        if dt < 0.0005 {
            dt = 0.0005
        }
        pollInput(&mut inp, 1.0)

        // One axis at a time: diagonal drilling would let you cut corners through
        // solid ground, and it makes the tunnels messy.
        var ix = inp.moveX
        var iy = inp.moveY
        if ix != 0.0 && iy != 0.0 {
            iy = 0.0
        }
        mineUpdate(&mut m, dt, ix, iy, W as f64, H as f64)

        var ox = 0.0
        var oy = 0.0
        if m.shake > 0.2 {
            ox = Random.floatRange(0.0 - m.shake, m.shake)
            oy = Random.floatRange(0.0 - m.shake, m.shake)
        }
        drawMine(&mut c, m, ox, oy)
        drawHud(&mut c, m)

        fpsAccum += dt
        fpsFrames += 1
        if fpsAccum > 0.5 {
            fpsShown = ((fpsFrames as f64) / fpsAccum) as i64
            fpsAccum = 0.0
            fpsFrames = 0
        }
        text(&mut c, 24, H - 30, fpsShown.toString() + " FPS", 2, 0.16, 0.20, 0.24)
        let help = "HOLD A DIRECTION TO DIG    ESC QUITS"
        text(&mut c, W - 24 - textWidth(help, 2), H - 30, help, 2, 0.16, 0.20, 0.24)

        var exposure = 1.0
        if m.flash > 0.0 {
            exposure = 1.0 + m.flash * 1.2
        }
        present(&mut c, 0.18, exposure)

        screen.present(c.fb)
    }
    return 0
}
