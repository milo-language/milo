// Drawing the mine. Only the tiles inside the view are touched.
//
// Everything here is aimed at one target: a five-year-old has to be able to look
// at the screen and say what each thing is. That is why the ground is lit almost
// flat with a single soft lamp glow on top rather than shaded per tile, why every
// material carries a marking as well as a hue, why tiles are drawn as rounded
// lumps that bulge past their cells, and why the dog is drawn brighter than life
// with a dark outline. Mood lost to legibility, on purpose.

from "std/math" import {
    Math
}
from "./gfx" import {
    Canvas, line, spot, circle, text, textCentered, textWidth, fillRect, setRect
}
from "./mascot" import {
    Sprite, spriteMilo
}
from "./world" import {
    satchelX, satchelY,
    Mine, Col, TILE, SURFACE, tileAt, tileColor, isSolid,
    T_SKY, T_DIRT, T_CLAY, T_STONE, T_GOLD, T_GEM, T_CRYSTAL, T_BEDROCK, T_WATER,
    T_GATE, isUpgrade
}

// Stable per-tile pseudo-random in 0..1.
fn tileNoise(x: i64, y: i64): f64 {
    let v = Math.sin((x as f64) * 12.9898 + (y as f64) * 78.233) * 43758.5453
    return v - Math.floor(v)
}

// A tile drawn as a rounded lump instead of a square. A corner is only cut when
// BOTH of its neighbours are open, so the inside of a mass stays solid and only
// its outline goes soft — which is the whole difference between "ground" and
// "graph paper". The radius wobbles per corner so no two lumps match.
fn roundTile(c: &mut Canvas, x0: f64, y0: f64, x1: f64, y1: f64, r: f64, g: f64, b: f64, rtl: f64, rtr: f64, rbl: f64, rbr: f64) {
    // Rows are stepped in whole screen pixels, not in tile-local ones. Walking
    // fractional row edges through a truncating setRect drops the bottom row of
    // every tile whose top bulges — which came out as a one-pixel black seam
    // ruled straight across the map.
    let h = y1 - y0
    let py0 = Math.floor(y0) as i64
    let py1 = Math.floor(y1) as i64
    var yy = py0
    while yy < py1 {
        let fy = (yy as f64) + 0.5 - y0
        var cutL = 0.0
        var cutR = 0.0
        if fy < rtl {
            let d = rtl - fy
            cutL = Math.maxF64(cutL, rtl - Math.sqrt(Math.maxF64(rtl * rtl - d * d, 0.0)))
        }
        if fy < rtr {
            let d = rtr - fy
            cutR = Math.maxF64(cutR, rtr - Math.sqrt(Math.maxF64(rtr * rtr - d * d, 0.0)))
        }
        if fy > h - rbl {
            let d = fy - (h - rbl)
            cutL = Math.maxF64(cutL, rbl - Math.sqrt(Math.maxF64(rbl * rbl - d * d, 0.0)))
        }
        if fy > h - rbr {
            let d = fy - (h - rbr)
            cutR = Math.maxF64(cutR, rbr - Math.sqrt(Math.maxF64(rbr * rbr - d * d, 0.0)))
        }
        setRect(&mut c, x0 + cutL, yy as f64, x1 - cutR, (yy + 1) as f64, r, g, b)
        yy += 1
    }
}

// How far this tile bulges past its cell on a side that faces open air. Two or
// three pixels is enough: it breaks the shared straight line that made a wall of
// tiles read as masonry.
fn bulge(m: &Mine, tx: i64, ty: i64, dx: i64, dy: i64, seed: i64): f64 {
    if isSolid(tileAt(m, tx + dx, ty + dy)) {
        return 0.0
    }
    return 1.0 + 3.4 * tileNoise(tx * 11 + seed, ty * 7 + seed)
}

// How round each corner of this tile is. Open on both sides of a corner means
// that corner is on the outside of the mass; a little per-tile jitter keeps the
// silhouette from looking machined.
fn cornerR(m: &Mine, tx: i64, ty: i64, dx: i64, dy: i64, seed: i64): f64 {
    var open = 0
    if !isSolid(tileAt(m, tx + dx, ty)) {
        open += 1
    }
    if !isSolid(tileAt(m, tx, ty + dy)) {
        open += 1
    }
    if open == 0 {
        return 0.0
    }
    let j = tileNoise(tx * 3 + seed, ty * 5 + seed)
    if open == 1 {
        // Only one side is open: a shallow scallop, so a flat face still ripples.
        return TILE * (0.10 + 0.24 * j)
    }
    return TILE * (0.34 + 0.28 * j)
}

// Everything above the dig site: sky gradient, sun, clouds, hills, a tree, and
// Milo sitting by the mine mouth. It is the first thing you see, so it should look
// like somewhere rather than like a grid of empty cells.
fn drawSurface(c: &mut Canvas, m: &Mine, camX: f64, camY: f64) {
    let groundY = (SURFACE as f64) * TILE - camY
    if groundY < 0.0 - 40.0 {
        return
    }
    // sky
    var y: i64 = 0
    let gy = groundY as i64
    while y < gy && y < c.h {
        if y >= 0 {
            let t = (y as f64) / Math.maxF64(groundY, 1.0)
            let r = 0.22 + 0.42 * t
            let g = 0.42 + 0.38 * t
            let b = 0.80 + 0.10 * t
            fillRect(&mut c, 0.0, y as f64, c.w as f64, (y + 1) as f64, r, g, b)
        }
        y += 1
    }
    // sun, fixed in the sky rather than pinned to the world
    let sunX = (c.w as f64) * 0.80
    let sunY = groundY - 112.0
    spot(&mut c, sunX, sunY, 130.0, 0.40, 0.32, 0.12)
    spot(&mut c, sunX, sunY, 50.0, 1.6, 1.35, 0.60)
    spot(&mut c, sunX, sunY, 28.0, 2.4, 2.2, 1.4)
    // clouds drifting
    for i in 0..4 {
        let base = Math.mod((i as f64) * 340.0 + m.time * 9.0 - camX * 0.25, (c.w as f64) + 400.0) - 200.0
        let cy = groundY - 132.0 + (i as f64) * 22.0
        spot(&mut c, base, cy, 52.0, 0.42, 0.44, 0.50)
        spot(&mut c, base + 44.0, cy + 7.0, 38.0, 0.40, 0.42, 0.48)
        spot(&mut c, base - 40.0, cy + 9.0, 32.0, 0.36, 0.38, 0.44)
    }
    // grass strip along the top of the ground
    fillRect(&mut c, 0.0, groundY - 9.0, c.w as f64, groundY, 0.16, 0.52, 0.18)
    var gx = 0.0 - Math.mod(camX, 13.0)
    while gx < (c.w as f64) {
        let hh = 7.0 + tileNoise((gx as i64), 3) * 9.0
        line(&mut c, gx, groundY, gx + 2.5, groundY - hh, 0.20, 0.66, 0.22)
        gx += 13.0
    }
    // a tree just right of the mine mouth
    let treeX = 8.0 * TILE - camX
    let ty0 = groundY
    setRect(&mut c, treeX - 10.0, ty0 - 58.0, treeX + 10.0, ty0, 0.34, 0.20, 0.10)
    // canopy as a few solid clumps — same blocky language as the ground
    setRect(&mut c, treeX - 56.0, ty0 - 96.0, treeX + 56.0, ty0 - 58.0, 0.10, 0.48, 0.14)
    setRect(&mut c, treeX - 40.0, ty0 - 122.0, treeX + 40.0, ty0 - 94.0, 0.12, 0.55, 0.16)
    setRect(&mut c, treeX - 20.0, ty0 - 140.0, treeX + 24.0, ty0 - 120.0, 0.14, 0.62, 0.18)
    // Two low spoil heaps flanking the shaft head. Small, so the entrance reads
    // as a dig rather than a sunken box.
    let mx = 5.0 * TILE - camX
    setRect(&mut c, mx - 52.0, ty0 - 8.0, mx - 32.0, ty0, 0.42, 0.28, 0.14)
    setRect(&mut c, mx + 32.0, ty0 - 8.0, mx + 52.0, ty0, 0.42, 0.28, 0.14)
}

// Blit a palette-indexed sprite about its CENTRE, with independent x and y
// scale. Squash and stretch is most of what makes a sprite feel alive, and it
// needs a centre to squash about. Source pixel edges are computed from the same
// expression on both sides so neighbouring pixels tile with no seam.
fn drawSpriteT(c: &mut Canvas, s: &Sprite, cx: f64, cy: f64, sclX: f64, sclY: f64, bright: f64, flip: f64) {
    let hw = (s.w as f64) * 0.5
    let hh = (s.h as f64) * 0.5
    for py in 0..s.h {
        let y0 = cy + ((py as f64) - hh) * sclY
        let y1 = cy + (((py + 1) as f64) - hh) * sclY
        for px in 0..s.w {
            var sx2 = px
            if flip < 0.0 {
                sx2 = s.w - 1 - px
            }
            let idx = s.px[py * s.w + sx2] as i64
            if idx == 0 {
                continue
            }
            let rgb = s.pal[idx]
            let r = ((rgb >> 16) & 0xFF) as f64 / 255.0 * bright
            let g = ((rgb >> 8) & 0xFF) as f64 / 255.0 * bright
            let b = (rgb & 0xFF) as f64 / 255.0 * bright
            let x0 = cx + ((px as f64) - hw) * sclX
            let x1 = cx + (((px + 1) as f64) - hw) * sclX
            setRect(&mut c, x0, y0, x1, y1, r, g, b)
        }
    }
}

// The same shape in one flat colour — used four times at small offsets to give
// the dog a dark outline, so he never disappears into the wall he is chewing on.
fn drawSpriteSolid(c: &mut Canvas, s: &Sprite, cx: f64, cy: f64, sclX: f64, sclY: f64, flip: f64, r: f64, g: f64, b: f64) {
    let hw = (s.w as f64) * 0.5
    let hh = (s.h as f64) * 0.5
    for py in 0..s.h {
        let y0 = cy + ((py as f64) - hh) * sclY
        let y1 = cy + (((py + 1) as f64) - hh) * sclY
        for px in 0..s.w {
            var sx2 = px
            if flip < 0.0 {
                sx2 = s.w - 1 - px
            }
            if s.px[py * s.w + sx2] as i64 == 0 {
                continue
            }
            let x0 = cx + ((px as f64) - hw) * sclX
            let x1 = cx + (((px + 1) as f64) - hw) * sclX
            setRect(&mut c, x0, y0, x1, y1, r, g, b)
        }
    }
}

// An opaque oval with a dark rim: body, legs, paws, tail. Everything about the
// dog that is not his face is built from this one shape, which is what keeps him
// looking like one animal instead of a pile of parts.
fn oval(c: &mut Canvas, x: f64, y: f64, rx: f64, ry: f64, cr: f64, cg: f64, cb: f64) {
    let ryo = ry + 2.0
    var yy = 0.0 - ryo
    while yy <= ryo {
        let to = 1.0 - yy * yy / (ryo * ryo)
        if to > 0.0 {
            let ow = (rx + 2.0) * Math.sqrt(to)
            setRect(&mut c, x - ow, y + yy, x + ow, y + yy + 1.0, 0.06, 0.04, 0.03)
        }
        let ti = 1.0 - yy * yy / (ry * ry)
        if ti > 0.0 {
            let iw = rx * Math.sqrt(ti)
            setRect(&mut c, x - iw, y + yy, x + iw, y + yy + 1.0, cr, cg, cb)
        }
        yy += 1.0
    }
}

// One leg: a stubby upper and a paw on the end.
fn leg(c: &mut Canvas, x: f64, y: f64, len: f64, cr: f64, cg: f64, cb: f64) {
    oval(&mut c, x, y + len * 0.5, 4.0, len * 0.5 + 2.0, cr, cg, cb)
    oval(&mut c, x, y + len, 5.5, 4.0, cr * 1.15, cg * 1.15, cb * 1.15)
}

// The dog, and everything he is doing.
//
// Three states, read straight off the world: DIGGING (the drill is biting),
// TROTTING (moving through open ground) and SITTING (you let go). Each one is a
// different body rhythm plus its own set of stuck-on parts — a fast tail and
// churning paws while he digs, a slow breath and a blink and the odd yawn when
// he stops. The transition matters as much as the pose: `stateT` restarts on
// every change, so the sit begins with a little settle rather than a snap.
fn drawDog(c: &mut Canvas, m: &Mine, px: f64, py: f64) {
    let dog = spriteMilo()
    let flip = if m.faceX < 0.0 {
        0.0 - 1.0
    } else {
        1.0
    }
    let base = 1.95

    var sclX = base
    var sclY = base
    var bob = 0.0 // whole animal
    var headBob = 0.0 // head only, on top of that
    var lean = 0.0
    var tailFreq = 3.0
    var tailAmp = 0.40
    var legSwing = 0.0
    var legFreq = 0.0
    var rearLen = 13.0
    var yawn = 0.0

    if m.digging {
        let w = Math.sin(m.time * 26.0)
        sclX = base * (1.0 + 0.07 * w)
        sclY = base * (1.0 - 0.07 * w)
        bob = w * 1.5
        headBob = w * 2.0
        lean = m.faceX * 4.0
        tailFreq = 24.0
        tailAmp = 1.05
        legSwing = 6.0
        legFreq = 24.0
    } else if m.moving {
        let w = Math.sin(m.time * 13.0)
        bob = 0.0 - Math.abs(w) * 3.5 // a trot is a series of little hops
        headBob = 0.0 - Math.abs(w) * 1.5
        tailFreq = 11.0
        tailAmp = 0.7
        legSwing = 7.0
        legFreq = 13.0
    } else {
        let br = Math.sin(m.time * 2.4)
        sclY = base * (1.0 + 0.04 * br)
        sclX = base * (1.0 - 0.03 * br)
        bob = br * 1.2
        rearLen = 7.0 // he sits down, so the back legs fold under him
        // Every few seconds of sitting he pops up, and every few after that he
        // yawns. Idle animation is the difference between a paused game and a
        // dog waiting for you.
        let hop = Math.mod(m.stateT, 3.4)
        if hop < 0.34 {
            bob = bob - Math.sin(hop / 0.34 * 3.14159) * 9.0
        }
        let yw = Math.mod(m.stateT + 2.1, 5.6)
        if yw < 0.7 {
            yawn = Math.sin(yw / 0.7 * 3.14159)
        }
    }

    var cx = px + lean
    var cy = py + bob
    if m.cleared > 0.0 {
        // He steps into the dark and shrinks away down it. Without this he just
        // stops being drawn, which reads as a glitch instead of an exit.
        let t = Math.minF64(1.0, (2.6 - m.cleared) / 0.55)
        let dcx = ((m.exitX as f64) + 1.0) * TILE - (m.px - px)
        let dcy = ((m.gateY as f64) + 1.0) * TILE - (m.py - py)
        cx = cx + (dcx - cx) * t
        cy = cy + (dcy - cy) * t
        sclX *= (1.0 - 0.45 * t)
        sclY *= (1.0 - 0.45 * t)
    }
    // Every stuck-on part is sized off `half`, so shrinking that shrinks the
    // whole animal together. Without it the tail and ears kept their full length
    // while he shrank into the doorway, and stuck out of the hole after he was
    // gone.
    let sc = (sclX + sclY) / (base * 2.0)
    let half = 9.0 * base * sc
    let behind = 0.0 - flip
    // He is drawn as one animal: a body, four legs and a tail, with the mascot's
    // face as the head. Hanging extra ears and paws off the bare 18x18 logo — the
    // first thing tried here — did not read as a dog at all.
    let bodyX = cx + behind * 14.0 * sc
    let bodyY = cy + 7.0 * sc
    let headX = cx + flip * 12.0 * sc
    let headY = cy - 5.0 * sc + headBob

    // Head bright, body mid, legs dark. The gradient is what separates the three
    // from each other without needing an outline between them.
    let furR = 0.80
    let furG = 0.55
    let furB = 0.32
    let darkR = 0.50
    let darkG = 0.32
    let darkB = 0.17

    // A small warm pool right under him, on top of the scene-wide lamp glow.
    spot(&mut c, cx, cy, 54.0, 0.10, 0.08, 0.04)

    // Tail: three ovals tapering off the back of the body, wagging at the speed
    // of his mood, with a pale tip.
    let wag = Math.sin(m.time * tailFreq) * tailAmp
    var seg = 0
    while seg <= 3 {
        let t = (seg as f64)
        let ang = 0.75 + wag * t * 0.28
        let len = (6.0 + t * 5.0) * sc // overlapping, or the tip reads as a loose ball
        let tx2 = bodyX + behind * Math.cos(ang) * len
        let ty2 = bodyY - 4.0 * sc - Math.sin(ang) * len
        if seg == 3 {
            oval(&mut c, tx2, ty2, 4.5 * sc, 4.5 * sc, 1.10, 0.98, 0.82)
        } else {
            let r2 = (7.0 - t * 0.8) * sc
            oval(&mut c, tx2, ty2, r2, r2, furR * 0.86, furG * 0.86, furB * 0.86)
        }
        seg += 1
    }

    // Back legs, behind the body.
    var i = 0
    while i < 2 {
        let ph = m.time * legFreq + (i as f64) * 3.14159
        let sw = Math.sin(ph) * legSwing
        leg(&mut c, bodyX + behind * (2.0 + (i as f64) * 9.0) * sc + sw * 0.6 * sc, bodyY + 4.0 * sc, rearLen * sc, darkR, darkG, darkB)
        i += 1
    }

    oval(&mut c, bodyX, bodyY, 19.0 * sc, 13.0 * sc, furR, furG, furB)

    // Front legs. While the drill is biting they leave the ground entirely and
    // scrabble at the rock face — the churning paws ARE the digging animation.
    var f2 = 0
    while f2 < 2 {
        let ph = m.time * legFreq + (f2 as f64) * 3.14159
        let sw = Math.sin(ph)
        if m.digging {
            let reach = half * 0.95 + sw * 7.0 * sc
            let across = (7.0 - 14.0 * (f2 as f64)) * sc
            let pxp = headX + m.faceX * reach + m.faceY * across
            let pyp = headY + m.faceY * reach + m.faceX * across
            oval(&mut c, pxp, pyp, 6.0 * sc, 5.0 * sc, furR * 1.12, furG * 1.12, furB * 1.12)
        } else {
            leg(&mut c, bodyX + flip * (8.0 + (f2 as f64) * 7.0) * sc + sw * legSwing * 0.6 * sc, bodyY + 3.0 * sc, 13.0 * sc, furR * 0.9, furG * 0.9, furB * 0.9)
        }
        f2 += 1
    }

    // dark outline: four offset silhouettes under the real head sprite
    let o = 2.5
    drawSpriteSolid(&mut c, dog, headX - o, headY, sclX, sclY, flip, 0.05, 0.03, 0.02)
    drawSpriteSolid(&mut c, dog, headX + o, headY, sclX, sclY, flip, 0.05, 0.03, 0.02)
    drawSpriteSolid(&mut c, dog, headX, headY - o, sclX, sclY, flip, 0.05, 0.03, 0.02)
    drawSpriteSolid(&mut c, dog, headX, headY + o, sclX, sclY, flip, 0.05, 0.03, 0.02)

    // Brighter than life on purpose: the ground is lit almost flat now, so the
    // only way the dog stays the most-readable thing on screen is to out-shine it.
    drawSpriteT(&mut c, dog, headX, headY, sclX, sclY, 1.55, flip)

    // hard hat — reads as "miner" from across the room, and its lamp is the light
    let hx0 = headX - half * 0.90
    let hx1 = headX + half * 0.90
    let hy = headY - half * 0.78
    setRect(&mut c, hx0, hy, hx1, hy + 8.0 * sc, 1.05, 0.72, 0.10)
    setRect(&mut c, hx0 + 4.0 * sc, hy - 5.0 * sc, hx1 - 4.0 * sc, hy, 1.20, 0.82, 0.14)
    // brim, out in front of the face
    setRect(&mut c, headX + flip * half * 0.78, hy + 5.0 * sc, headX + flip * (half * 1.30), hy + 9.0 * sc, 0.85, 0.56, 0.08)
    let lampX = headX + flip * half * 0.52
    setRect(&mut c, lampX - 3.5 * sc, hy - 3.5 * sc, lampX + 3.5 * sc, hy + 2.5 * sc, 1.5, 1.4, 1.0)
    spot(&mut c, lampX, hy, 7.0 * sc, 0.7, 0.6, 0.35)

    // blink — paint muzzle fur over the eyes, with a lash line on top
    if m.blinkT < 0.0 && !m.digging {
        var e = 0
        while e < 2 {
            let dx = if e == 0 {
                0.0 - 3.5
            } else {
                2.5
            }
            let ex = headX + flip * dx * sclX
            let ey = headY - 0.5 * sclY
            setRect(&mut c, ex - sclX, ey - sclY, ex + sclX * 1.4, ey + sclY, 0.886, 0.753, 0.588)
            line(&mut c, ex - sclX, ey, ex + sclX * 1.2, ey, 0.10, 0.07, 0.05)
            e += 1
        }
    }

    // A yawn: the muzzle opens and a small tongue shows. Only when he is sitting.
    if yawn > 0.0 {
        let my = headY + half * 0.48
        let mw = 5.0 * yawn
        oval(&mut c, headX, my, mw, mw * 0.9, 0.16, 0.07, 0.07)
        oval(&mut c, headX, my + mw * 0.35, mw * 0.6, mw * 0.4, 0.92, 0.50, 0.58)
    }

    // Left alone long enough, he dozes off. Nothing happens as a result — it is
    // there so that a player who wanders away comes back to a dog, not a pause menu.
    if !m.moving && m.stateT > 6.0 {
        var z = 0
        while z < 3 {
            let ph = Math.mod(m.time * 0.45 + (z as f64) * 0.33, 1.0)
            let zx = headX + flip * (half * 0.7 + ph * 26.0)
            let zy = headY - half * 0.9 - ph * 34.0
            let fz = (1.0 - ph) * Math.minF64(1.0, (m.stateT - 6.0) * 0.7)
            text(&mut c, zx as i64, zy as i64, "Z", 2 + (ph * 2.0) as i64, 0.7 * fz, 0.7 * fz, 0.9 * fz)
            z += 1
        }
    }

    // No tongue. A dark-rimmed pink oval anywhere near the muzzle stops reading as
    // a tongue and starts reading as a wound — the paws and the tail carry the
    // energy on their own.
    if m.digging {
        // the bite: a spinning three-spoke bit on the tile face, kept dim enough
        // that it does not white out the paws working right beside it
        let bx = headX + m.faceX * half * 1.55
        let by = headY + m.faceY * half * 1.55
        var q = 0
        while q < 3 {
            let a = m.time * 30.0 + (q as f64) * 2.0944
            line(&mut c, bx, by, bx + Math.cos(a) * 9.0, by + Math.sin(a) * 9.0, 1.1, 0.95, 0.6)
            q += 1
        }
        spot(&mut c, bx, by, 6.0, 0.9, 0.75, 0.35)
    }
}

// Which plain ground a seam is embedded in. Nearest non-ore neighbour wins;
// dirt if the seam is somehow surrounded by nothing but more seam.
fn hostKind(m: &Mine, tx: i64, ty: i64): i64 {
    var q = 1
    while q <= 3 {
        var d = 0
        while d < 4 {
            var nx = tx
            var ny = ty
            if d == 0 {
                nx = tx - q
            } else if d == 1 {
                nx = tx + q
            } else if d == 2 {
                ny = ty - q
            } else {
                ny = ty + q
            }
            let n = tileAt(m, nx, ny)
            if n == T_DIRT || n == T_CLAY || n == T_STONE {
                return n
            }
            d += 1
        }
        q += 1
    }
    return T_DIRT
}

// Each ground gets its own marking, not just its own colour: dirt is pebbly,
// clay is layered, stone is cracked, bedrock is speckled. Colour alone stops
// working the moment the lamp dims it; a pattern survives.
fn drawGrain(c: &mut Canvas, tx: i64, ty: i64, sx: f64, sy: f64, t: i64, col: &Col, kk: f64) {
    if t == T_DIRT {
        for q in 0..3 {
            let a = tileNoise(tx * 7 + q * 31, ty * 13 + q * 17)
            let b2 = tileNoise(tx * 5 + q * 11, ty * 3 + q * 23)
            let s = TILE * (0.09 + 0.05 * b2)
            let px2 = sx + TILE * (0.20 + 0.60 * a)
            let py2 = sy + TILE * (0.20 + 0.60 * b2)
            setRect(&mut c, px2, py2, px2 + s, py2 + s, col.r * kk * 0.72, col.g * kk * 0.66, col.b * kk * 0.60)
        }
        return
    }
    if t == T_CLAY {
        // Sedimentary streaks. Every one gets its own row, length and side from
        // the tile hash — evenly placed bands line up across neighbours and turn
        // the clay into brickwork, which is exactly the look being avoided here.
        var q = 0
        while q < 3 {
            let a = tileNoise(tx * 13 + q * 7, ty * 29 + q * 3)
            let b2 = tileNoise(tx * 5 + q * 19, ty * 11 + q * 23)
            let yb = sy + TILE * (0.12 + 0.76 * a)
            let xb = sx + TILE * (0.04 + 0.34 * b2)
            let wb = TILE * (0.30 + 0.52 * tileNoise(tx + q * 3, ty * 7 + q))
            if b2 > 0.45 {
                setRect(&mut c, xb, yb, xb + wb, yb + 3.0, col.r * kk * 1.30, col.g * kk * 1.15, col.b * kk * 0.95)
            } else {
                setRect(&mut c, xb, yb, xb + wb, yb + 3.0, col.r * kk * 0.60, col.g * kk * 0.45, col.b * kk * 0.38)
            }
            q += 1
        }
        return
    }
    if t == T_STONE {
        // A crooked crack, drawn additively so it catches the lamp. Every vertex
        // gets its own hash: one shared random only slid the same chevron left and
        // right, which tiled into wallpaper.
        let a = tileNoise(tx * 9, ty * 9)
        let b2 = tileNoise(tx * 31 + 4, ty * 17 + 9)
        let d2 = tileNoise(tx * 3 + 21, ty * 41 + 2)
        let e2 = tileNoise(tx * 47 + 6, ty * 5 + 13)
        let x0 = sx + TILE * (0.10 + 0.35 * a)
        let y0 = sy + TILE * (0.06 + 0.24 * b2)
        let x1 = sx + TILE * (0.28 + 0.50 * d2)
        let y1 = sy + TILE * (0.38 + 0.24 * a)
        let x2 = sx + TILE * (0.15 + 0.70 * e2)
        let y2 = sy + TILE * (0.72 + 0.24 * d2)
        line(&mut c, x0, y0, x1, y1, col.r * kk * 0.5, col.g * kk * 0.55, col.b * kk * 0.65)
        line(&mut c, x1, y1, x2, y2, col.r * kk * 0.5, col.g * kk * 0.55, col.b * kk * 0.65)
        return
    }
    if t == T_BEDROCK {
        for q in 0..4 {
            let a = tileNoise(tx * 3 + q * 41, ty * 19 + q * 7)
            let b2 = tileNoise(tx * 23 + q * 5, ty * 29 + q * 13)
            spot(&mut c, sx + TILE * (0.15 + 0.7 * a), sy + TILE * (0.15 + 0.7 * b2), 2.6, 0.16, 0.14, 0.22)
        }
    }
}

// The door: one 2x2 object out in the ground, drawn as a whole rather than tile
// by tile, so it can have a frame, a lintel and two leaves that meet in the
// middle instead of being a repeating wall pattern.
//
// It is bright green and it glows through the dirt on purpose. The level is one
// screen, so a small child should be able to look at the map, see the green
// thing, and know where they are going before they have dug a single block.
fn drawDoor(c: &mut Canvas, m: &Mine, camX: f64, camY: f64) {
    let x0 = (m.exitX as f64) * TILE - camX
    let y0 = (m.gateY as f64) * TILE - camY
    let w = TILE * 2.0
    let h = TILE * 2.0
    if x0 > (c.w as f64) + w || y0 > (c.h as f64) + h || x0 + w < 0.0 - w || y0 + h < 0.0 - h {
        return
    }
    let cxd = x0 + w * 0.5
    let cyd = y0 + h * 0.5
    let a = m.doorAnim

    // The beacon. Light leaking out through solid ground is not physical, and it
    // is the whole reason the door works as a target.
    let pulse = 0.72 + 0.28 * Math.sin(m.time * 3.0)
    spot(&mut c, cxd, cyd, w * 1.7, 0.04 * pulse, 0.20 * pulse, 0.08 * pulse)
    spot(&mut c, cxd, cyd, w * 0.95, 0.04 * pulse, 0.18 * pulse, 0.08 * pulse)
    if m.exitOpen {
        spot(&mut c, cxd, cyd, w * 1.4, 0.03, 0.14, 0.06)
    }

    // frame, and the opening behind the leaves
    let jamb = 7.0
    setRect(&mut c, x0 - 4.0, y0 - 4.0, x0 + w + 4.0, y0 + h + 4.0, 0.10, 0.16, 0.11)
    setRect(&mut c, x0, y0, x0 + w, y0 + h, 0.22, 0.34, 0.24)
    // Beyond the door is daylight, which is what you are digging towards.
    // Behind the leaves is a hole, not a light. The actual mouth is drawn again
    // after the dog by drawDoorMouth so that it occludes him; this is only the
    // part the leaves are about to uncover.
    setRect(&mut c, x0 + jamb, y0 + jamb, x0 + w - jamb, y0 + h - jamb, 0.020, 0.016, 0.014)

    // Two leaves meeting in the middle, each hinged on its own outer jamb, so
    // opening them sweeps the gap outward from the centre.
    let halfW = (w * 0.5 - jamb) * (1.0 - a)
    let ly0 = y0 + jamb
    let ly1 = y0 + h - jamb
    var side = 0
    while side < 2 {
        var lx0 = x0 + jamb
        var lx1 = lx0 + halfW
        if side == 1 {
            lx1 = x0 + w - jamb
            lx0 = lx1 - halfW
        }
        if halfW > 1.5 {
            let shade = 0.60 + 0.40 * (1.0 - a)
            setRect(&mut c, lx0, ly0, lx1, ly1, 0.10 * shade, 0.62 * shade, 0.26 * shade)
            // planks
            var p = 1
            while p < 3 {
                let pxp = lx0 + halfW * (p as f64) / 3.0
                setRect(&mut c, pxp, ly0, pxp + 1.5, ly1, 0.05 * shade, 0.34 * shade, 0.14 * shade)
                p += 1
            }
            // iron straps and the meeting edge
            setRect(&mut c, lx0, ly0 + h * 0.16, lx1, ly0 + h * 0.24, 0.16, 0.18, 0.16)
            setRect(&mut c, lx0, ly1 - h * 0.24, lx1, ly1 - h * 0.16, 0.16, 0.18, 0.16)
            let inner = if side == 0 {
                lx1 - 2.5
            } else {
                lx0
            }
            setRect(&mut c, inner, ly0, inner + 2.5, ly1, 0.03, 0.20, 0.09)
        }
        side += 1
    }

    // Handles where the two leaves meet, and a keyhole under them while it is
    // shut. This is the bit that says "door" rather than "green block".
    if halfW > 6.0 {
        let f = 1.0 - a
        let gap = (w * 0.5 - jamb) * a
        var s2 = 0
        while s2 < 2 {
            let hx = if s2 == 0 {
                cxd - 5.0 - gap
            } else {
                cxd + 5.0 + gap
            }
            circle(&mut c, hx, cyd - 2.0, 5.5, 10, 1.30 * f, 0.95 * f, 0.30 * f)
            s2 += 1
        }
        if !m.exitOpen {
            setRect(&mut c, cxd - 2.5, cyd + 5.0, cxd + 2.5, cyd + 11.0, 0.04, 0.10, 0.05)
            setRect(&mut c, cxd - 4.5, cyd + 4.0, cxd + 4.5, cyd + 8.0, 0.04, 0.10, 0.05)
            let rattle = Math.sin(m.time * 3.0) * 1.4
            spot(&mut c, cxd, cyd + 6.0, 6.0 + rattle, 0.10, 0.30, 0.12)
        }
    }
}

// The mouth of the doorway, drawn AFTER the dog so that stepping into it puts
// him behind it. Him vanishing into the dark IS the reward — it is the only
// thing that says he went somewhere rather than that he stopped moving.
//
// A tunnel, not a lit panel: near-black, darkest in the middle, with a lip along
// the top and sides where the lamp catches the cut edge of the rock.
fn drawDoorMouth(c: &mut Canvas, m: &Mine, camX: f64, camY: f64) {
    if m.doorAnim <= 0.0 {
        return
    }
    let x0 = (m.exitX as f64) * TILE - camX
    let y0 = (m.gateY as f64) * TILE - camY
    let w = TILE * 2.0
    let h = TILE * 2.0
    let jamb = 7.0
    let halfW = (w * 0.5 - jamb) * (1.0 - m.doorAnim)
    let gx0 = x0 + jamb + halfW
    let gx1 = x0 + w - jamb - halfW
    let gy0 = y0 + jamb
    let gy1 = y0 + h - jamb
    if gx1 - gx0 < 1.5 {
        return
    }
    setRect(&mut c, gx0, gy0, gx1, gy1, 0.016, 0.013, 0.012)
    // Darker toward the centre, so it reads as depth rather than as a black card.
    let inx = (gx1 - gx0) * 0.22
    let iny = (gy1 - gy0) * 0.20
    setRect(&mut c, gx0 + inx, gy0 + iny, gx1 - inx, gy1 - iny, 0.004, 0.003, 0.003)
    // the lit lip of the cut, top and sides
    setRect(&mut c, gx0, gy0, gx1, gy0 + 3.0, 0.20, 0.17, 0.14)
    setRect(&mut c, gx0, gy0, gx0 + 2.0, gy1, 0.11, 0.09, 0.08)
    setRect(&mut c, gx1 - 2.0, gy0, gx1, gy1, 0.11, 0.09, 0.08)
    setRect(&mut c, gx0, gy1 - 2.0, gx1, gy1, 0.06, 0.05, 0.05)
}

// Treasure has to LOOK like treasure. Fat nuggets, a specular highlight that
// travels across the seam, and a four-point twinkle that fires on its own clock
// per tile — the sparkle is the reward, arriving before the number does.
fn drawShimmer(c: &mut Canvas, m: &Mine, tx: i64, ty: i64, cx: f64, cy: f64, col: &Col, kk: f64) {
    for q in 0..3 {
        let a = tileNoise(tx * 5 + q, ty * 11 + q) * 6.2831853
        let rr = 0.10 + 0.16 * tileNoise(tx + q * 13, ty + q * 7)
        let nx = cx + Math.cos(a) * TILE * rr
        let ny = cy + Math.sin(a) * TILE * rr
        // body of the nugget, then a hard specular chip up and to the left — the
        // offset highlight is what makes a blob read as something faceted
        spot(&mut c, nx, ny, TILE * 0.30, col.r * kk * 0.80, col.g * kk * 0.80, col.b * kk * 0.80)
        spot(&mut c, nx, ny, TILE * 0.17, col.r * kk * 0.70, col.g * kk * 0.70, col.b * kk * 0.70)
        spot(&mut c, nx - 2.5, ny - 2.5, TILE * 0.09, 1.1, 1.05, 0.85)
    }
    // A bright band sweeping across the tile, on a phase unique to the tile.
    let ph = tileNoise(tx * 17, ty * 23)
    let sweep = Math.mod(m.time * 0.55 + ph, 1.0)
    let bandY = cy - TILE * 0.6 + sweep * TILE * 1.2
    let fade = 1.0 - Math.abs(sweep - 0.5) * 2.0
    spot(&mut c, cx, bandY, TILE * 0.42, col.r * 0.30 * fade, col.g * 0.30 * fade, col.b * 0.30 * fade)
    // Twinkle: a short, bright four-point star with a long gap between firings.
    let tw = Math.mod(m.time * 0.9 + ph * 3.1, 1.0)
    if tw < 0.16 {
        let f = Math.sin(tw / 0.16 * 3.14159)
        let armr = TILE * 0.55 * f
        let bx = cx + Math.cos(ph * 6.28) * TILE * 0.22
        let by = cy + Math.sin(ph * 6.28) * TILE * 0.22
        line(&mut c, bx - armr, by, bx + armr, by, 1.5 * f, 1.4 * f, 1.1 * f)
        line(&mut c, bx, by - armr, bx, by + armr, 1.5 * f, 1.4 * f, 1.1 * f)
        spot(&mut c, bx, by, TILE * 0.22 * f, 1.6 * f, 1.5 * f, 1.2 * f)
    }
}

pub fn drawMine(c: &mut Canvas, m: &Mine, ox: f64, oy: f64) {
    let camX = m.camX + ox
    let camY = m.camY + oy
    let x0 = ((camX / TILE) as i64) - 1
    let y0 = ((camY / TILE) as i64) - 1
    let x1 = x0 + ((c.w as f64) / TILE) as i64 + 3
    let y1 = y0 + ((c.h as f64) / TILE) as i64 + 3

    drawSurface(&mut c, m, camX, camY)

    for ty in y0..y1 {
        for tx in x0..x1 {
            let t = tileAt(m, tx, ty)
            let sx = (tx as f64) * TILE - camX
            let sy = (ty as f64) * TILE - camY
            if t == T_WATER {
                // Animated water: two travelling sine waves set the surface
                // height inside the tile, everything under it is tinted body
                // water, and the crest gets a bright line. Cheap, and it reads as
                // liquid immediately because it moves.
                let openAbove = tileAt(m, tx, ty - 1) != T_WATER
                let cx = sx + TILE * 0.5
                let cyw = sy + TILE * 0.5
                let dxw = cx - (m.px - camX)
                let dyw = cyw - (m.py - camY)
                let dw = Math.sqrt(dxw * dxw + dyw * dyw)
                var litw = 1.0 - dw / (m.lampRadius * 1.25)
                if litw < 0.0 {
                    litw = 0.0
                }
                let kw = 0.45 + litw * litw * 0.60
                var top = sy
                if openAbove {
                    let wob = Math.sin(m.time * 2.2 + (tx as f64) * 0.7) * 4.6
                    + Math.sin(m.time * 3.7 + (tx as f64) * 1.9) * 2.4
                    top = sy + 7.0 + wob
                }
                fillRect(&mut c, sx, top, sx + TILE, sy + TILE, 0.05 * kw, 0.30 * kw, 0.70 * kw)
                // depth shading toward the bottom of the tile
                fillRect(&mut c, sx, sy + TILE * 0.6, sx + TILE, sy + TILE, 0.0, 0.05 * kw, 0.18 * kw)
                if openAbove {
                    line(&mut c, sx, top, sx + TILE, top, 0.5 * kw + 0.15, 1.4 * kw + 0.2, 1.9 * kw + 0.3)
                    // a glint riding along the crest
                    let g = 0.5 + 0.5 * Math.sin(m.time * 2.6 + (tx as f64) * 0.55)
                    spot(&mut c, sx + TILE * g, top, 6.0, 0.5 * kw, 1.1 * kw, 1.6 * kw)
                }
                // caustic banding under the surface
                let cau = 0.5 + 0.5 * Math.sin(m.time * 1.9 + (tx as f64) * 1.3 + (ty as f64) * 0.8)
                spot(&mut c, cx, cyw + TILE * 0.2, TILE * 0.42, 0.02 * cau * kw, 0.16 * cau * kw, 0.30 * cau * kw)
                continue
            }
            if t == T_SKY {
                if ty < SURFACE {
                    continue // above ground the sky is drawSurface's job
                }
                // A dug-out tile is a hole with a back wall, not a void. Painting
                // it dark-warm instead of leaving it black is what makes a tunnel
                // read as carved rather than as a gap in the picture — and it is
                // what the dog is silhouetted against.
                let hx = sx + TILE * 0.5
                let hy = sy + TILE * 0.5
                let ddx = hx - (m.px - camX)
                let ddy = hy - (m.py - camY)
                var hl = 1.0 - Math.sqrt(ddx * ddx + ddy * ddy) / (m.lampRadius * 0.9)
                if hl < 0.0 {
                    hl = 0.0
                }
                let hk = 0.045 + hl * hl * 0.16
                fillRect(&mut c, sx, sy, sx + TILE, sy + TILE, hk * 1.0, hk * 0.72, hk * 0.52)
                continue
            }
            // Lamp falloff — but only on tiles the light could actually reach.
            // A tile with no open neighbour is buried inside the rock, and lighting
            // it is what turned the lamp into a brown bubble shining through solid
            // ground. Exposed faces catch the light; the interior stays dark.
            let cx = sx + TILE * 0.5
            let cy = sy + TILE * 0.5
            let dx = cx - (m.px - camX)
            let dy = cy - (m.py - camY)
            let d = Math.sqrt(dx * dx + dy * dy)
            var exposed = false
            if !isSolid(tileAt(m, tx - 1, ty)) || !isSolid(tileAt(m, tx + 1, ty)) {
                exposed = true
            }
            if !isSolid(tileAt(m, tx, ty - 1)) || !isSolid(tileAt(m, tx, ty + 1)) {
                exposed = true
            }
            // A slightly ragged radius, so the reach of the lamp is not a circle.
            let jitter = 0.86 + 0.28 * tileNoise(tx * 2, ty * 2)
            var lit = 1.0 - d / (m.lampRadius * jitter)
            if lit < 0.0 {
                lit = 0.0
            }
            // smoothstep instead of a hard linear edge
            lit = lit * lit * (3.0 - 2.0 * lit)
            if !exposed {
                lit *= 0.45
            }
            // Tiles are lit almost flat, and the lamp is added afterwards as one
            // smooth glow over the whole scene. Per-tile lamp falloff was the
            // real reason the ground read as squares: it painted every 34-pixel
            // cell a slightly different uniform grey, which is a checkerboard no
            // amount of rounded corners can hide.
            var ambient = 0.62
            if !exposed {
                ambient = 0.46
            }
            if t == T_GOLD || t == T_GEM || t == T_CRYSTAL {
                ambient += 0.06
            }
            if isUpgrade(t) {
                ambient = 0.80 + 0.25 * Math.sin(m.time * 6.0 + (tx as f64))
            }
            let k = ambient + lit * 0.22
            let col = tileColor(t)
            // Only a whisper of per-tile shade variation. More than this and the
            // patchwork of slightly different cells IS the grid.
            let grain = 0.97 + 0.06 * tileNoise(tx, ty)
            let kk = k * grain
            let rtl = cornerR(m, tx, ty, 0 - 1, 0 - 1, 1)
            let rtr = cornerR(m, tx, ty, 1, 0 - 1, 2)
            let rbl = cornerR(m, tx, ty, 0 - 1, 1, 3)
            let rbr = cornerR(m, tx, ty, 1, 1, 4)
            let bl = bulge(m, tx, ty, 0 - 1, 0, 5)
            let br = bulge(m, tx, ty, 1, 0, 6)
            let bt = bulge(m, tx, ty, 0, 0 - 1, 7)
            let bb = bulge(m, tx, ty, 0, 1, 8)
            // Ore is rock with lumps in it. The body of an ore tile is painted in
            // the colour of the ground AROUND it, not in the ore colour — fill a
            // whole cell with gold and a seam reads as a yellow brick, a square
            // you can see the outline of from across the map. Only the nuggets
            // are metal.
            let isOre = t == T_GOLD || t == T_GEM || t == T_CRYSTAL
            var texture = t
            if isOre {
                texture = hostKind(m, tx, ty)
            }
            let body = tileColor(texture)
            // The door is drawn as one 2x2 object after the whole tile pass, not
            // as four independent cells.
            if t == T_GATE {
                continue
            }
            roundTile(&mut c, sx - bl, sy - bt, sx + TILE + br, sy + TILE + bb, body.r * kk, body.g * kk, body.b * kk, rtl, rtr, rbl, rbr)
            drawGrain(&mut c, tx, ty, sx, sy, texture, body, kk)
            // A lit rim wherever the ground faces open air. Cheap, and it is what
            // makes a tunnel wall look like a surface rather than a colour.
            if !isSolid(tileAt(m, tx, ty - 1)) {
                line(&mut c, sx + rtl, sy - bt + 0.5, sx + TILE - rtr, sy - bt + 0.5, body.r * kk * 0.45, body.g * kk * 0.45, body.b * kk * 0.40)
            }
            if t == T_GOLD || t == T_GEM || t == T_CRYSTAL || isUpgrade(t) {
                drawShimmer(&mut c, m, tx, ty, cx, cy, col, kk)
            }
        }
    }

    drawDoor(&mut c, m, camX, camY)

    // The lamp, as ONE smooth additive glow over the finished tiles rather than a
    // per-tile brightness. It spills a little through rock, which is the price of
    // not having the light itself drawn as a grid of squares.
    let lx = m.px - camX
    let ly = m.py - camY
    spot(&mut c, lx, ly, m.lampRadius * 0.85, 0.09, 0.075, 0.045)
    spot(&mut c, lx, ly, m.lampRadius * 0.40, 0.11, 0.09, 0.05)
    spot(&mut c, lx + m.faceX * 60.0, ly + m.faceY * 60.0, m.lampRadius * 0.30, 0.08, 0.065, 0.035)

    // the bite being taken out of the tile under the drill
    if m.digX >= 0 && m.digProgress > 0.0 {
        let sx = (m.digX as f64) * TILE - camX
        let sy = (m.digY as f64) * TILE - camY
        let p = Math.minF64(m.digProgress, 1.0)
        let r = TILE * 0.40 * p
        circle(&mut c, sx + TILE * 0.5, sy + TILE * 0.5, r, 12, 0.55, 0.42, 0.16)
        spot(&mut c, sx + TILE * 0.5, sy + TILE * 0.5, r * 0.8, 0.35 * p, 0.25 * p, 0.08 * p)
    }

    // particles
    for i in 0..m.parts.len {
        let t = m.parts[i].life / m.parts[i].maxLife
        let f = t * t
        // Dust swells as it thins out; debris just shrinks.
        let sz = m.parts[i].size * (1.0 + m.parts[i].grow * (1.0 - t))
        spot(&mut c, m.parts[i].x - camX, m.parts[i].y - camY, sz, m.parts[i].cr * f, m.parts[i].cg * f, m.parts[i].cb * f)
    }

    // the digger
    let px = m.px - camX
    let py = m.py - camY
    drawDog(&mut c, m, px, py)

    // the satchel, which swells for a moment each time something lands in it.
    // It goes through the door with him, so it stops being drawn on the way in.
    if m.cleared <= 0.0 {
        let stx = satchelX(m) - camX
        let sty = satchelY(m) - camY
        var sw = 6.0
        if m.satchelPulse > 0.0 {
            sw = 6.0 + m.satchelPulse * 14.0
            spot(&mut c, stx, sty, sw * 2.0, 0.6, 0.45, 0.12)
        }
        setRect(&mut c, stx - sw, sty - sw * 0.75, stx + sw, sty + sw * 0.75, 0.30, 0.17, 0.07)
        setRect(&mut c, stx - sw, sty - sw * 0.75, stx + sw, sty - sw * 0.4, 0.40, 0.24, 0.10)
    }

    // nuggets in flight
    for i in 0..m.flies.len {
        if m.flies[i].age < 0.0 {
            continue
        }
        let col = tileColor(m.flies[i].kind)
        let fx = m.flies[i].x - camX
        let fy = m.flies[i].y - camY
        spot(&mut c, fx, fy, 6.0, col.r * 0.30, col.g * 0.30, col.b * 0.30)
        spot(&mut c, fx, fy, 2.6, col.r * 1.2, col.g * 1.2, col.b * 1.2)
    }

    // The mouth of the doorway goes over the dog, his satchel and any nugget
    // still in flight, but under the floating labels.
    drawDoorMouth(&mut c, m, camX, camY)

    // floating labels
    for i in 0..m.pops.len {
        let f = Math.minF64(1.0, m.pops[i].life)
        textCentered(&mut c, (m.pops[i].x - camX) as i64, (m.pops[i].y - camY) as i64, m.pops[i].text, 2, m.pops[i].cr * f, m.pops[i].cg * f, m.pops[i].cb * f)
    }
}

// A little treasure icon: the same nugget-and-sparkle language as the seams, so
// the counter and the thing in the ground are obviously the same object. Counts
// beat names when the reader may not read yet.
fn hudGem(c: &mut Canvas, x: f64, y: f64, t: f64, col: &Col, n: i64, scale: i64) {
    spot(&mut c, x, y, 15.0, col.r * 0.22, col.g * 0.22, col.b * 0.22)
    setRect(&mut c, x - 8.0, y - 8.0, x + 8.0, y + 8.0, col.r * 0.75, col.g * 0.75, col.b * 0.75)
    setRect(&mut c, x - 8.0, y - 8.0, x + 2.0, y + 1.0, col.r, col.g, col.b)
    let tw = 0.5 + 0.5 * Math.sin(t)
    spot(&mut c, x - 4.0, y - 4.0, 5.0 * tw + 2.0, 1.4 * tw, 1.3 * tw, 1.1 * tw)
    text(&mut c, (x + 16.0) as i64, (y - 10.0) as i64, n.toString(), scale, 0.90, 0.86, 0.78)
}

pub fn drawHud(c: &mut Canvas, m: &Mine) {
    // Three counters, as pictures with a number next to each. No labels to read.
    let gc = tileColor(T_GOLD)
    let ec = tileColor(T_GEM)
    let cc = tileColor(T_CRYSTAL)
    hudGem(&mut c, 40.0, 36.0, m.time * 3.0, gc, m.gold, 4)
    hudGem(&mut c, 150.0, 36.0, m.time * 3.0 + 2.0, ec, m.gems, 4)
    hudGem(&mut c, 260.0, 36.0, m.time * 3.0 + 4.0, cc, m.crystals, 4)

    let lv = "LEVEL " + m.level.toString()
    text(&mut c, c.w - 24 - textWidth(lv, 4), 22, lv, 4, 0.55, 0.70, 0.90)
    let d = (m.deepest - SURFACE).toString() + " M DEEP"
    text(&mut c, c.w - 24 - textWidth(d, 2), 66, d, 2, 0.30, 0.38, 0.48)

    // The bar. This is the only rule in the game, so it gets the middle of the
    // screen and a chunky frame: fill it, then walk out the door.
    let bw = 460.0
    let bx = (c.w as f64) * 0.5 - bw * 0.5
    let by = 26.0
    let bh = 26.0
    setRect(&mut c, bx - 4.0, by - 4.0, bx + bw + 4.0, by + bh + 4.0, 0.16, 0.13, 0.10)
    setRect(&mut c, bx, by, bx + bw, by + bh, 0.05, 0.04, 0.04)
    if m.exitOpen {
        let pulse = 0.7 + 0.3 * Math.sin(m.time * 5.0)
        fillRect(&mut c, bx, by, bx + bw, by + bh, 0.10 * pulse, 0.70 * pulse, 0.24 * pulse)
        textCentered(&mut c, c.w / 2, 70, "THE DOOR IS OPEN! GO TO IT!", 3, 0.5 * pulse, 1.3 * pulse, 0.6 * pulse)
    } else {
        var frac = (m.levelValue as f64) / (m.quota as f64)
        if frac > 1.0 {
            frac = 1.0
        }
        fillRect(&mut c, bx, by, bx + bw * frac, by + bh, 0.85, 0.62, 0.14)
        // a moving sheen on the filled part, so the bar itself looks like treasure
        if frac > 0.02 {
            let s = Math.mod(m.time * 0.7, 1.0) * frac
            spot(&mut c, bx + bw * s, by + bh * 0.5, 20.0, 0.5, 0.42, 0.12)
        }
        textCentered(&mut c, c.w / 2, 70, "FILL THE BAR WITH TREASURE", 3, 0.44, 0.40, 0.30)
    }

    // No off-screen door marker: every level is exactly one screen and nothing
    // scrolls, so the door is in view on every frame of every level.

    if m.cleared > 0.0 {
        textCentered(&mut c, c.w / 2, c.h / 2 - 40, "NICE DIGGING!", 7, 0.6, 1.3, 0.7)
        textCentered(&mut c, c.w / 2, c.h / 2 + 30, "LEVEL " + (m.level + 1).toString() + " NEXT", 3, 1.2, 1.0, 0.3)
    }

    if m.banner > 0.0 {
        var f = 1.0
        if m.banner < 1.0 {
            f = m.banner
        }
        textCentered(&mut c, c.w / 2, 170, "PROSPECT", 9, 1.3 * f, 1.0 * f, 0.3 * f)
        textCentered(&mut c, c.w / 2, 260, "DIG! FIND TREASURE!", 3, 0.7 * f, 0.6 * f, 0.4 * f)
    }
    if m.hint > 0.0 {
        var f = 1.0
        if m.hint < 1.0 {
            f = m.hint
        }
        textCentered(&mut c, c.w / 2, c.h - 100, "HOLD AN ARROW KEY TO DIG", 3, 0.55 * f, 0.50 * f, 0.40 * f)
        textCentered(&mut c, c.w / 2, c.h - 60, "YOU CANNOT LOSE", 2, 0.35 * f, 0.33 * f, 0.28 * f)
    }
}
