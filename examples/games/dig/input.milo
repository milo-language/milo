// One frame of input, snapshotted out of SDL so the rest of the game never touches
// a pointer. The bindings themselves come from the `sdl` package; what is here is
// this game's control scheme, which is not something a bindings package can hold.

from "sdl" import {
    SDL_GetKeyboardState, SDL_GetMouseState, SDL_PollEvent,
    SDL_BUTTON_LMASK, SDL_QUIT
}
from "sdl/keys" import {
    SC_1, SC_A, SC_D, SC_DOWN, SC_ESCAPE, SC_LEFT, SC_P, SC_R, SC_RETURN,
    SC_RIGHT, SC_S, SC_SPACE, SC_UP, SC_W
}

pub struct Input {
    moveX: f64,
    moveY: f64,
    mouseX: f64,
    mouseY: f64,
    fire: bool,
    bomb: bool,
    restart: bool,
    pause: bool,
    quit: bool,
    pick: i64, // 1..3 on the upgrade screen, 0 for nothing
}

pub fn inputNew(): Input {
    return Input {
        moveX: 0.0, moveY: 0.0,
        mouseX: 0.0, mouseY: 0.0,
        fire: false, bomb: false, restart: false, pause: false, quit: false, pick: 0,
    }
}

// Poll SDL and fill `inp`. `scale` converts window pixels to canvas pixels.
pub fn pollInput(inp: &mut Input, ev: &mut [u8; 64], scale: f64) {
    inp.moveX = 0.0
    inp.moveY = 0.0
    inp.fire = false
    inp.bomb = false
    inp.restart = false
    inp.pause = false
    inp.pick = 0

    unsafe {
        while SDL_PollEvent(ev) != 0 {
            let evType: u32 = (ev[0] as u32) | ((ev[1] as u32) << 8) | ((ev[2] as u32) << 16) | ((ev[3] as u32) << 24)
            if evType == SDL_QUIT {
                inp.quit = true
            }
        }
        let ks = SDL_GetKeyboardState(0 as *i32)
        if ks[SC_ESCAPE] != 0 {
            inp.quit = true
        }
        if ks[SC_A] != 0 {
            inp.moveX -= 1.0
        }
        if ks[SC_D] != 0 {
            inp.moveX += 1.0
        }
        if ks[SC_W] != 0 {
            inp.moveY -= 1.0
        }
        if ks[SC_S] != 0 {
            inp.moveY += 1.0
        }
        // Arrows move too. Aiming is the mouse's job only — a second keyboard
        // stick reads as a puzzle, not a control scheme.
        if ks[SC_LEFT] != 0 {
            inp.moveX -= 1.0
        }
        if ks[SC_RIGHT] != 0 {
            inp.moveX += 1.0
        }
        if ks[SC_UP] != 0 {
            inp.moveY -= 1.0
        }
        if ks[SC_DOWN] != 0 {
            inp.moveY += 1.0
        }
        if ks[SC_SPACE] != 0 {
            inp.bomb = true
        }
        if ks[SC_R] != 0 {
            inp.restart = true
        }
        if ks[SC_P] != 0 {
            inp.pause = true
        }
        if ks[SC_RETURN] != 0 {
            inp.restart = true
        }
        for k in 0..3 {
            if ks[SC_1 + k] != 0 {
                inp.pick = k + 1
            }
        }

        var mpos: [i32; 2] = [0; 2]
        let btn = SDL_GetMouseState(mpos[0].addrOf() as *i32, mpos[1].addrOf() as *i32)
        inp.mouseX = (mpos[0] as f64) * scale
        inp.mouseY = (mpos[1] as f64) * scale
        if (btn & SDL_BUTTON_LMASK) != 0 {
            inp.fire = true
        }
    }
}
