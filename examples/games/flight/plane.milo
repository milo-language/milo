// The aircraft.
//
// It used to be twenty-four hand-placed points and about sixty triangles, each
// with a flat colour written next to it. That reads as deliberately retro next to
// photographic terrain, and it was retro for a reason: with a flat-shading
// rasteriser there was nothing to be gained from more geometry, because every
// facet was going to be one colour regardless.
//
// This builds the airframe instead of listing it. The fuselage is a set of
// STATIONS — a position along the body with a cross-section — swept into rings,
// and the surface between two rings is a strip of quads. That buys three things
// at once: a round body rather than a square one, per-vertex normals accumulated
// from the faces that share them (so the shading is smooth and the highlight
// travels across the nose as it banks), and a shape that can be changed by moving
// four numbers rather than by editing sixty triangles.
//
// The silhouette is a modern single-engine fast jet — blended body, leading-edge
// strakes, one canted fin. It is a lookalike, not a copy of any type: the shapes
// are chosen for how they read at a hundred metres with the sun behind them.

from "std/math" import {
    Math
}
from "./gfx3d" import {
    Frame, Rgb, Scene, Vec3, View, frameOf, rgb, shade, triangleV, v3
}
from "./texture" import {
    Texture, Vtx, vtxC
}
from "./world3d" import {
    World
}

// How many points go around a fuselage ring. Eight is where a body stops reading
// as a prism: four is unmistakably square in silhouette, six still shows a facet
// along the top, eight does not, and past that the triangle count doubles for a
// difference nobody sees from the chase camera.
pub let RING: i64 = 8

// A cross-section of the body: how far along it sits, how wide and tall it is
// there, and where its centre is relative to the reference line.
//
// The width and height are separate because a fast jet is not round — it is a
// flattened oval under the intake and a taller one behind the cockpit, and that
// change of proportion along the body is most of what makes a silhouette read as
// a particular kind of aircraft.
struct Station {
    fwd: f64,
    halfW: f64,
    halfH: f64,
    up: f64, // centre offset, so the spine can rise over the cockpit
}

fn st(fwd: f64, halfW: f64, halfH: f64, up: f64): Station {
    return Station {
        fwd: fwd, halfW: halfW, halfH: halfH, up: up
    }
}

// The body, nose to nozzle. Read it as a side view: `halfH` is the depth of the
// fuselage at that station and `up` is where its centreline sits.
fn stations(): Vec<Station> {
    var s: Vec<Station> = Vec.new()
    s.push(st(30.0, 0.35, 0.35, 0.4)) // nose tip, not quite a point
    s.push(st(26.0, 1.5, 1.4, 0.4)) // radome
    s.push(st(20.0, 2.8, 2.6, 0.5)) // forward fuselage
    s.push(st(13.0, 3.6, 3.4, 1.1)) // under the windscreen
    s.push(st(6.0, 4.2, 4.0, 1.3)) // cockpit, widest of the forward body
    s.push(st(0.0 - 1.0, 4.8, 4.4, 0.9)) // intake shoulder
    s.push(st(0.0 - 9.0, 4.6, 4.2, 0.6)) // mid
    s.push(st(0.0 - 17.0, 3.9, 3.7, 0.5)) // aft, tapering
    s.push(st(0.0 - 23.0, 3.0, 3.0, 0.5)) // nozzle shroud
    s.push(st(0.0 - 26.0, 2.4, 2.4, 0.5)) // nozzle lip
    return s
}

// A mesh under construction: positions, accumulated normals, uvs, and the
// triangles that index them.
//
// Normals are summed per vertex from every face that touches a vertex and
// normalised at the end. That is the whole reason this is built as an indexed
// mesh rather than emitted triangle by triangle — a vertex shared by four faces
// has to see all four before it knows which way it points, and a vertex that only
// ever existed inside one triangle cannot be smooth.
struct Build {
    pos: Vec<Vec3>,
    nrm: Vec<Vec3>,
    u: Vec<f64>,
    v: Vec<f64>,
    idx: Vec<i64>,
}

fn buildNew(): Build {
    return Build {
        pos: Vec.new(), nrm: Vec.new(), u: Vec.new(), v: Vec.new(), idx: Vec.new()
    }
}

fn vert(b: &mut Build, p: Vec3, uu: f64, vv: f64): i64 {
    b.pos.push(p)
    b.nrm.push(v3(0.0, 0.0, 0.0))
    b.u.push(uu)
    b.v.push(vv)
    return b.pos.len - 1
}

fn tri(b: &mut Build, a: i64, c: i64, d: i64) {
    b.idx.push(a)
    b.idx.push(c)
    b.idx.push(d)
}

fn quad(b: &mut Build, a: i64, c: i64, d: i64, e: i64) {
    tri(&mut b, a, c, d)
    tri(&mut b, a, d, e)
}

// Sum every face's normal into its three vertices, weighted by the face's area —
// which falling out of the un-normalised cross product is exactly what you want,
// since a sliver triangle should not steer the normal of a vertex it barely
// touches.
fn accumulate(b: &mut Build) {
    var i = 0
    while i < b.idx.len {
        let a = b.idx[i]
        let c = b.idx[i + 1]
        let d = b.idx[i + 2]
        let n = (b.pos[c] - b.pos[a]).cross(b.pos[d] - b.pos[a])
        b.nrm[a] = b.nrm[a] + n
        b.nrm[c] = b.nrm[c] + n
        b.nrm[d] = b.nrm[d] + n
        i = i + 3
    }
    for k in 0..b.nrm.len {
        b.nrm[k] = b.nrm[k].norm()
    }
}

// A point in the aircraft's own frame: forward, right and up in metres.
fn bodyAt(origin: &Vec3, f: &Frame, fwd: f64, right: f64, up: f64): Vec3 {
    return origin + f.fwd.scale(fwd) + f.right.scale(right) + f.up.scale(up)
}

// The fuselage: ring after ring, joined into strips.
fn fuselage(b: &mut Build, origin: &Vec3, f: &Frame) {
    let sts = stations()
    var rings: Vec<Vec<i64>> = Vec.new()
    for i in 0..sts.len {
        var ring: Vec<i64> = Vec.new()
        let vv = (i as f64) / ((sts.len - 1) as f64)
        for k in 0..RING {
            let a = (k as f64) / (RING as f64) * 6.283185307179586
            let ca = Math.cos(a)
            var sa = Math.sin(a)
            // Flatten the underside. A circular belly makes an aircraft look like
            // a rocket; real fuselages are close to flat-bottomed where the wing
            // and the intake meet them.
            if sa < 0.0 {
                sa = sa * 0.72
            }
            let p = bodyAt(origin, f, sts[i].fwd, ca * sts[i].halfW, sts[i].up + sa * sts[i].halfH)
            ring.push(vert(&mut b, p, (k as f64) / (RING as f64), vv))
        }
        rings.push(ring)
    }
    for i in 0..rings.len - 1 {
        for k in 0..RING {
            let k2 = (k + 1) % RING
            quad(&mut b, rings[i][k], rings[i][k2], rings[i + 1][k2], rings[i + 1][k])
        }
    }
}

// A flat surface with thickness — wings, fins, tailplanes.
//
// Given the four corners of the planform, it builds an upper and a lower skin
// separated by `thick` and closes the rim, so a wing seen edge-on is a thin solid
// rather than a sheet that disappears. The old model drew single sheets and had
// to draw each one twice, once per winding, to be visible from both sides.
fn slab(b: &mut Build, a: Vec3, c: Vec3, d: Vec3, e: Vec3, up: &Vec3, thick: f64, u0: f64, v0: f64, u1: f64, v1: f64) {
    let h = up.scale(thick * 0.5)
    let t0 = vert(&mut b, a + h, u0, v0)
    let t1 = vert(&mut b, c + h, u1, v0)
    let t2 = vert(&mut b, d + h, u1, v1)
    let t3 = vert(&mut b, e + h, u0, v1)
    let b0 = vert(&mut b, a - h, u0, v0)
    let b1 = vert(&mut b, c - h, u1, v0)
    let b2 = vert(&mut b, d - h, u1, v1)
    let b3 = vert(&mut b, e - h, u0, v1)
    quad(&mut b, t0, t1, t2, t3)
    quad(&mut b, b3, b2, b1, b0)
    quad(&mut b, b0, b1, t1, t0)
    quad(&mut b, b1, b2, t2, t1)
    quad(&mut b, b2, b3, t3, t2)
    quad(&mut b, b3, b0, t0, t3)
}

// The whole airframe, recorded into the scene.
//
// `ail` and `elev` are the stick, so the control surfaces move with it. It is a
// small thing that costs four numbers and is the difference between a model being
// flown and a model being carried.
pub fn drawAirframe(s: &mut Scene, w: &World, v: &View, skin: &Texture, ail: f64, elev: f64) {
    let f = frameOf(w.plane.yaw, w.plane.pitch, w.plane.roll)
    let origin = v3(w.plane.x, w.plane.y, w.plane.z)
    var b = buildNew()

    fuselage(&mut b, origin, f)

    // Wings: a swept trapezoid with a leading-edge strake running forward along
    // the fuselage, which is what blends the two into one body rather than a tube
    // with planks attached.
    for side in 0..2 {
        var sgn = 1.0
        if side == 1 {
            sgn = 0.0 - 1.0
        }
        // Cropped delta: a strongly swept leading edge, a short tip chord, and a
        // trailing edge close to square. The old planform was nearly straight,
        // which from behind is a plank.
        let rootFwd = 6.0
        let rootAft = 0.0 - 19.0
        let tipFwd = 0.0 - 12.0
        let tipAft = 0.0 - 18.5
        let span = 21.0
        let yy = 0.6
        slab(&mut b, bodyAt(origin, f, rootFwd, sgn * 4.2, yy), bodyAt(origin, f, tipFwd, sgn * span, yy), bodyAt(origin, f, tipAft, sgn * span, yy), bodyAt(origin, f, rootAft, sgn * 4.2, yy), f.up, 1.1, 0.12, 0.12, 0.95, 0.45)
        // Strake, forward of the wing root and much thinner.
        slab(&mut b, bodyAt(origin, f, 15.0, sgn * 2.6, yy + 0.3), bodyAt(origin, f, 5.0, sgn * 5.4, yy + 0.3), bodyAt(origin, f, 2.0, sgn * 5.0, yy + 0.3), bodyAt(origin, f, 12.0, sgn * 3.0, yy + 0.3), f.up, 0.45, 0.20, 0.50, 0.60, 0.62)
        // Aileron, hinged at the trailing edge and deflecting opposite each side.
        let d = ail * sgn * 1.6
        slab(&mut b, bodyAt(origin, f, rootAft, sgn * 12.0, yy), bodyAt(origin, f, tipAft, sgn * span, yy), bodyAt(origin, f, tipAft - 3.0, sgn * span, yy - d), bodyAt(origin, f, rootAft - 3.4, sgn * 12.0, yy - d), f.up, 0.8, 0.20, 0.64, 0.90, 0.74)
        // Tailplane, all-moving, deflecting with pitch.
        slab(&mut b, bodyAt(origin, f, 0.0 - 18.0, sgn * 3.2, 0.2), bodyAt(origin, f, 0.0 - 21.0, sgn * 12.5, 0.2 - elev * 1.1), bodyAt(origin, f, 0.0 - 25.5, sgn * 12.5, 0.2 - elev * 1.1), bodyAt(origin, f, 0.0 - 25.0, sgn * 3.2, 0.2), f.up, 0.7, 0.20, 0.20, 0.95, 0.45)
        // Canted fins, splayed outward. Swept BACK as they rise — the leading
        // edge has to rake aft or the aircraft reads as having its tail on
        // backwards, which is exactly what a vertical or forward-raked fin looks
        // like at any distance where the silhouette is all you have.
        slab(&mut b, bodyAt(origin, f, 0.0 - 12.0, sgn * 2.4, 2.6), bodyAt(origin, f, 0.0 - 20.5, sgn * 5.6, 11.0), bodyAt(origin, f, 0.0 - 25.5, sgn * 5.6, 11.0), bodyAt(origin, f, 0.0 - 24.5, sgn * 2.4, 2.6), f.right.scale(sgn), 0.7, 0.24, 0.26, 0.92, 0.42)
    }

    accumulate(&mut b)

    // Emit. The per-vertex light term is the Lambert the shader multiplies by, and
    // because the normals were averaged it now varies across a face — which is
    // what turns eight flat panels into a round body.
    let tint = rgb(0.94, 0.95, 0.99)
    var i = 0
    while i < b.idx.len {
        let a = b.idx[i]
        let c = b.idx[i + 1]
        let d = b.idx[i + 2]
        triangleV(&mut s, v, skin, skinVtx(s, b, a, tint), skinVtx(s, b, c, tint), skinVtx(s, b, d, tint), 1.0, 1.0, 1.0)
        i = i + 3
    }
}

fn skinVtx(s: &Scene, b: &Build, i: i64, tint: &Rgb): Vtx {
    // Ambient 0.34: an aircraft in flight is lit from below by the ground as well
    // as from above by the sun, and a hard zero turns the underside into a
    // silhouette against a bright sky.
    let l = shade(s, b.nrm[i].x, b.nrm[i].y, b.nrm[i].z, 0.34)
    return vtxC(b.pos[i].x, b.pos[i].y, b.pos[i].z, b.u[i], b.v[i], l, tint.r, tint.g, tint.b, 1.0)
}
