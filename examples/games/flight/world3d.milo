// FLYBY — the world: a noise heightmap, a wandering trail of coins, and an
// arcade flight model. No fail state; you cannot crash, only skim.

from "std/math" import {
    Math
}
from "std/rng" import {
    Rng
}
from "./gfx3d" import {
    Camera, Scene, Vec3, altScale
}
from "./live" import {
    LiveEnv, envNew, envSetPlace, envRetime, envF64
}
from "./city" import {
    City, cityEmpty, cityHeightAt, cityCoverAt, cityRoofAt, COVER_URBAN
}

// One turn and half a turn. Both were open-coded at every use, and in two
// different truncations — 6.28318530717959 in the steering code,
// 6.283185307179586 everywhere else.
pub let TAU: f64 = 6.283185307179586

pub let PI: f64 = 3.141592653589793

// The stretches of invented country the procedural world cycles through. An
// enum rather than a bare i64: `theme` was compared against 0..3 in five places
// and advanced with a hand-written `% 4`, so adding a fifth region meant finding
// every one of them. `nextTheme` gets the wrap from tryFrom instead.
pub enum Theme: i32 {
    Coast, Desert, Forest, City
}

pub fn nextTheme(t: Theme): Theme {
    return Theme.tryFrom((t as i32) + 1) ?? Theme.Coast
}

// Terrain quads are coarse on purpose now. Before the aerial drape the quad WAS
// the detail — colour was per-corner, so a big quad meant a visibly blocky
// ground. With a photograph sampled per pixel the geometry only has to carry the
// silhouette, which lets the same triangle budget reach several kilometres
// instead of one. A city you can see across is worth more than a smooth hill.
pub let TILE: f64 = 110.0 // world units per terrain quad

pub let VIEW_TILES: i64 = 40 // radius of the drawn terrain grid -> 4.4 km

// The elevation the weather is measured from: the ground at the middle of the
// map, in metres above sea level.
//
// One number for a whole map is a simplification a real ceiling does not make —
// over Yosemite the valley floor and the rim are 900 m apart and the cloud base
// is flat in neither frame. It is right at the centre, which is where the flying
// happens, and it is enormously better than measuring from sea level over a
// place that is nowhere near it.
pub fn cityGroundRef(c: &City): f64 {
    if !c.loaded {
        return 0.0
    }
    let h = heightAt(c, 0.0, 0.0)
    if h < 0.0 {
        return 0.0
    }
    return h
}

// How big a terrain quad is, given how high the camera is. The scale itself
// lives in gfx3d, next to the `viewOf` that has to agree with it.
pub fn terrainTile(camY: f64): f64 {
    return TILE * altScale(camY)
}
// A ring you fly THROUGH, Pilotwings-style: far easier to read at speed than a
// coin you have to touch, and it tells you which way to be pointing.
pub struct Ring {
    x: f64,
    y: f64,
    z: f64,
    face: f64, // heading the ring faces along, radians
    r: f64,
    alive: bool,
    pop: f64, // expands and fades once flown through
    side: f64, // signed distance of the aircraft last frame, for crossing detection
    bonus: bool, // blue: smaller, worth four times as much
    // A landmark beacon rather than a hoop on a course: a column of light
    // standing ON the subject, collected by flying over it at any height. See
    // placeMarkRing for why the hoop had to go.
    beacon: bool,
    // A beacon arms once the aircraft has been OUTSIDE its radius. Landmarks sit
    // where they sit — Honolulu's first one is 235 m from the spawn point — and
    // without this the tour collects its own first stop before the player has
    // touched a key.
    armed: bool,
}

// A point on a wingtip contrail. Trails are ring buffers of world points, drawn
// as fading segments — cheap, and they make a hard bank read instantly.
pub struct Trail {
    x: f64,
    y: f64,
    z: f64,
    life: f64,
}

// A 3D spark thrown out when a ring is cleared.
pub struct Spark {
    x: f64,
    y: f64,
    z: f64,
    vx: f64,
    vy: f64,
    vz: f64,
    life: f64,
    maxLife: f64,
    cr: f64,
    cg: f64,
    cb: f64,
}

// A flock of birds crossing the course. Kept as world state rather than hashed
// off position like the clouds and trees: birds are an EVENT — they arrive, pass
// and leave — and an event needs a lifetime, which a stateless hash cannot have.
pub struct Flock {
    x: f64,
    y: f64,
    z: f64,
    vx: f64,
    vz: f64,
    n: i64,
    seed: f64,
    life: f64,
}

// A place worth flying over. The course is laid THROUGH these rather than along
// a sine wander, because a wander over a real city is a wander over whichever
// four blocks it happened to pick — and the reason to fly San Francisco is the
// Golden Gate, not an arbitrary stretch of the Richmond.
//
// Local metres from the asset origin. They belong to the map, not to the world,
// so a place with no tour laid out for it falls back to the wander.
pub struct Mark {
    name: string,
    x: f64,
    z: f64,
    // Shown during the orbit. The reward for flying somewhere worth seeing is
    // finding out what you are looking at; a score would not be.
    fact: string,
    // Filled in as the tour is flown. Kept on the landmark rather than in a
    // parallel Vec<bool> + Vec<f64> the checklist would have to keep in step.
    found: bool,
    took: f64, // seconds from becoming the target to being reached
    // Width in metres of the waterfall that falls here, or zero. A named fall
    // with no water in it is the one landmark that reads as missing rather than
    // as low detail: the terrain grid records the cliff and nothing else, so
    // Yosemite Falls was a blank granite face with a beam standing on it.
    fall: f64,
}

// Every list below is this long. Five is short enough to hold in your head and
// to finish in one sitting, which is what makes the checklist on the right a
// goal rather than a wall of text.
pub let MARKS_PER_REGION: i64 = 5

// A tour entry. Milo has no default field values, so without this every new
// field on Mark meant editing twenty-five struct literals.
fn mk(name: string, x: f64, z: f64, fact: string): Mark {
    return Mark {
        name: name, x: x, z: z, fact: fact, found: false, took: 0.0, fall: 0.0
    }
}

// A landmark that is a waterfall. `wide` is the width of the water at the lip.
fn mkFall(name: string, x: f64, z: f64, fact: string, wide: f64): Mark {
    return Mark {
        name: name, x: x, z: z, fact: fact, found: false, took: 0.0, fall: wide
    }
}

// Ordered as a route, not by importance: consecutive entries are near each
// other, so the aircraft tours the city instead of crossing it end to end
// between every pair of landmarks.
pub fn marksFor(cityName: &string): Vec<Mark> {
    var m: Vec<Mark> = Vec.new()
    if cityName == "San Francisco" {
        m.push(mk("SALESFORCE TOWER", 1126.0, 412.0, "326 m. Tallest in San Francisco since 2018."))
        m.push(mk("BAY BRIDGE", 2833.0, 1369.0, "Two bridges end to end, joined at Yerba Buena Island."))
        m.push(mk("COIT TOWER", 370.0, 1826.0, "Paid for by a woman who chased fire engines as a girl."))
        m.push(mk("ALCATRAZ", 0.0 - 1144.0, 4564.0, "A federal prison for 29 years. No escape was ever confirmed."))
        m.push(mk("GOLDEN GATE BRIDGE", 0.0 - 6009.0, 3774.0, "International Orange. The repainting never finishes."))
        return m
    }
    if cityName == "Manhattan" {
        m.push(mk("CENTRAL PARK", 1062.0, 2772.0, "341 hectares, entirely built. Nothing in it is natural."))
        m.push(mk("ROCKEFELLER CENTER", 0.0 - 59.0, 78.0, "Nineteen buildings raised through the Depression."))
        m.push(mk("EMPIRE STATE BUILDING", 0.0 - 649.0, 0.0 - 1069.0, "Built in 410 days, roughly a storey a day."))
        m.push(mk("ONE WORLD TRADE", 0.0 - 2985.0, 0.0 - 5043.0, "541 m to the tip. That is 1776 feet, deliberately."))
        m.push(mk("BROOKLYN BRIDGE", 0.0 - 1594.0, 0.0 - 5778.0, "1883. The first steel-wire suspension bridge anywhere."))
        return m
    }
    // Honolulu is the third kind of place in the lineup: a real skyline with a
    // volcano in it. The tour opens over Pearl Harbor, runs the waterfront and
    // finishes on the crater at the far end of Waikiki.
    //
    // Coordinates are in the 19 km asset centred at 21.3130, -157.8880. The
    // first one is why it is that big: on the old 16 km square centred downtown,
    // Battleship Row was 1.4 km outside the map, so PEARL HARBOR stood on East
    // Loch instead — and even that sat 240 m inside the boundary, close enough
    // that the run in to it was one long fight with the turn-back. The wider
    // square holds the real thing with three kilometres to spare.
    if cityName == "Honolulu" {
        // The USS Arizona Memorial, over Battleship Row itself.
        m.push(mk("PEARL HARBOR", 0.0 - 6430.0, 5789.0, "December 7, 1941. The Arizona is still down there, under the memorial."))
        m.push(mk("ALOHA TOWER", 2281.0, 0.0 - 680.0, "1926. Ten storeys, and for thirty years the tallest thing in Hawaii."))
        m.push(mk("PUNCHBOWL", 4459.0, 0.0, "A crater the Hawaiians called Puowaina. Now 53,000 graves."))
        m.push(mk("WAIKIKI", 6326.0, 0.0 - 4119.0, "Wetland and fishponds until the Ala Wai Canal drained it in 1928."))
        m.push(mk("DIAMOND HEAD", 8607.0, 0.0 - 5678.0, "Leahi. Sailors named it for calcite they took for diamonds."))
        return m
    }
    // Natural country works exactly the same way: a landmark is a named thing
    // you go and look at, and a granite dome is a better subject than most
    // buildings. Only the nouns change.
    if cityName == "Yosemite Valley" {
        m.push(mkFall("YOSEMITE FALLS", 0.0 - 343.0, 1291.0, "739 m in three drops, the tallest in North America.", 26.0))
        m.push(mk("HALF DOME", 5264.0, 111.0, "Never split in half. A glacier took one face away."))
        m.push(mk("GLACIER POINT", 1769.0, 0.0 - 1948.0, "975 m straight down to the valley floor."))
        m.push(mkFall("BRIDALVEIL FALL", 0.0 - 4745.0, 0.0 - 3161.0, "189 m. In a light wind it blows sideways and never lands.", 14.0))
        m.push(mk("EL CAPITAN", 0.0 - 3952.0, 0.0 - 1225.0, "900 m of unbroken granite, the largest such face on Earth."))
        return m
    }
    if cityName == "Grand Canyon" {
        m.push(mk("MATHER POINT", 603.0, 0.0 - 935.0, "Where most visitors see the canyon for the first time."))
        m.push(mk("YAVAPAI POINT", 0.0 - 423.0, 0.0 - 401.0, "The rock exposed here spans nearly two billion years."))
        m.push(mk("INDIAN GARDEN", 0.0 - 2564.0, 668.0, "A green shelf halfway down, kept alive by a spring."))
        m.push(mk("PLATEAU POINT", 0.0 - 2429.0, 1625.0, "400 m above the river, still 900 m below the rim."))
        m.push(mk("BRIGHT ANGEL TRAILHEAD", 0.0 - 2573.0, 0.0 - 1403.0, "The trail follows a fault line down through the wall."))
        return m
    }
    return m
}

pub struct Plane {
    x: f64,
    y: f64,
    z: f64,
    yaw: f64,
    pitch: f64,
    roll: f64,
    speed: f64,
}

pub struct World {
    // The world owns its generator rather than reaching for the global CSPRNG in
    // std/random. Seeded, so a run replays exactly: the same seed lays the same
    // course, spawns the same flocks and throws the same sparks. That is what
    // makes shot.milo a regression test instead of a screenshot.
    rng: Rng,
    // Empty unless a .city asset was loaded. Loaded once at startup and never
    // touched again — there is no fetching, decoding or streaming during play.
    city: City,
    // Sun (and, as this grows, sky and weather) for wherever the city actually
    // is, at whatever time it actually is. Follows the city: a place change has
    // to retime it or San Francisco keeps New York's sun.
    env: LiveEnv,
    // The places waiting their turn. Every region change rotates one in, so a
    // run crosses San Francisco, Hong Kong, Rio and the Grand Canyon rather
    // than mirroring one map forever. All of them are already parsed and in
    // memory — a swap is two moves, not a load.
    next: Vec<City>,
    nextIdx: i64,
    // One-axis mode: the player only climbs and dives, and the aircraft steers
    // itself along the course. Default on; `--pro` gives back the bank axis.
    easy: bool,
    plane: Plane,
    cam: Camera,
    rings: Vec<Ring>,
    sparks: Vec<Spark>,
    flocks: Vec<Flock>,
    flockTimer: f64,
    trailL: Vec<Trail>,
    trailR: Vec<Trail>,
    trailTick: f64,
    boosting: bool,
    boostBlend: f64, // eased 0..1, drives every visual speed cue
    // One-frame event flags, drained by the main loop to fire sounds. Keeps the
    // simulation free of any dependency on audio.
    evRing: bool,
    evBonus: bool,
    evRegion: bool,
    evBoost: bool,
    evMiss: bool,
    missFlash: f64,
    bestCombo: i64,
    theme: Theme,
    prevTheme: Theme,
    themeMix: f64, // 1 → fully the previous region, 0 → fully the new one
    level: i64,
    cleared: i64, // rings cleared in total
    toNext: i64, // rings remaining before the country changes
    // The tour, and how far along it the course has been laid. Empty for a place
    // with no landmarks, which puts layRing back on the wandering sine.
    marks: Vec<Mark>,
    markIdx: i64,
    markName: string, // the landmark currently being sought
    markDist: f64, // metres to it, for the HUD
    markFound: i64, // how many have been reached this visit
    // w.time when the current landmark became the target. The checklist clock is
    // per landmark, not per region: "how long did that one take" is the number
    // you want to beat, and a running total tells you nothing about the last leg.
    markStart: f64,
    foundTook: f64, // held for the arrival card, which outlives markStart
    foundPop: f64, // 1 the frame a landmark is reached, decays; drives the celebration
    // The whole tour here is done. Held for one more orbit so the region can be
    // signed off on screen before the next one is decoded.
    regionDone: bool,
    evPlaceDone: bool, // one-frame: the caller should bring the next region in
    nextName: string, // the region after this one, named under the checklist
    // The opening survey: the camera starts kilometres up, sweeps three quarters
    // of a turn around the aircraft and settles into the chase pose. The
    // simulation is frozen while it runs, the same way the arrival orbit freezes
    // it — a player who cannot steer yet should not be losing altitude either.
    intro: f64,
    introLen: f64,
    // The orbit that plays when a landmark is collected. While `showT` is
    // positive the simulation is frozen and the camera flies a circle around
    // the subject instead of following the aircraft.
    showT: f64,
    showIdx: i64,
    showAngle: f64,
    // The orbit used to cut to a fixed start angle and cut back when it ended,
    // which is two hard jumps around a shot whose whole job is to show you
    // something. It now begins at the camera you already had, sweeps, and eases
    // back to it: the pose at the moment of arrival, and how long the shot runs.
    showLen: f64,
    showFromX: f64,
    showFromY: f64,
    showFromZ: f64,
    showFromYaw: f64,
    showFromPitch: f64,
    showFromRoll: f64,
    showFromFov: f64,
    pathT: f64, // how far along the coin trail we have laid track
    // Trail head. Kept here rather than read off the end of `rings`, which is
    // swap-removed and so does not hold the newest ring last.
    trailX: f64,
    trailZ: f64,
    score: i64,
    // The streak only ever grows by flying through a hoop, and only ever resets
    // by missing one. It used to also expire on a hidden 6s timer, which made it
    // read as random — the number you are playing for must never move for a
    // reason the screen did not show you.
    combo: i64,
    comboPop: f64, // 1 → a ring was just cleared, decays; drives the HUD punch
    gain: i64, // points from the last ring, shown as a flyup
    gainPop: f64,
    best: i64,
    time: f64,
    flash: f64,
    shake: f64,
    banner: f64,
    hint: f64,
    offCourse: f64, // 0 on the course line, 1 at the corridor wall
    fence: f64, // 0 well inside the map, 1 against the boundary
    skipHeld: bool, // the skip key was already down last frame
    lastFind: bool, // this orbit is the tour's last, and signs the region off
    // Where the boundary wall stands for THIS place, as a half-extent. Derived
    // from the map and its tour together — see `computeFence`.
    fenceLim: f64,
}

// Smooth value noise — the same hash-based field the mining game uses, so the
// terrain is identical every run.
fn hash2(x: i64, y: i64): f64 {
    let v = Math.sin((x as f64) * 127.1 + (y as f64) * 311.7) * 43758.5453
    return v - Math.floor(v)
}

fn noise(x: f64, y: f64): f64 {
    let x0 = Math.floor(x) as i64
    let y0 = Math.floor(y) as i64
    let fx = x - (x0 as f64)
    let fy = y - (y0 as f64)
    let sx = fx * fx * (3.0 - 2.0 * fx)
    let sy = fy * fy * (3.0 - 2.0 * fy)
    let n00 = hash2(x0, y0)
    let n10 = hash2(x0 + 1, y0)
    let n01 = hash2(x0, y0 + 1)
    let n11 = hash2(x0 + 1, y0 + 1)
    let a = n00 + (n10 - n00) * sx
    let b = n01 + (n11 - n01) * sx
    return a + (b - a) * sy
}

// Three octaves: broad ranges, ridges, then a little roughness.
fn proceduralHeight(x: f64, z: f64): f64 {
    let a = noise(x * 0.0032, z * 0.0032) * 210.0
    let b = noise(x * 0.0090, z * 0.0090) * 74.0
    let c = noise(x * 0.0280, z * 0.0280) * 17.0
    return a + b + c - 120.0
}

// A real city is a finite square; the flight is not. Rather than fence the
// player in or let them fly off into blank sea, the map REFLECTS: cross the
// eastern edge and you come back over the same city travelling west.
//
// A reflection, not a modulo. Taking coordinates modulo the map joins the far
// edge to the near one, and since the two do not match you get a cliff and a
// visible seam every span. A reflection is continuous at the join by
// construction — the height, the coastline and the streets all line up, because
// on both sides of the seam they are the same points.
//
// blockOf/foldIn are the two halves of that map: which reflected copy of the
// city a coordinate lands in, and where inside the city it lands.
pub fn blockOf(v: f64, reach: f64): i64 {
    return Math.floor((v + reach) / (reach * 2.0)) as i64
}

pub fn foldIn(v: f64, reach: f64): f64 {
    let period = reach * 2.0
    let k = blockOf(v, reach)
    let r = v + reach - (k as f64) * period
    if k % 2 == 0 {
        return r - reach
    }
    return reach - r
}

// The inverse: where local coordinate u inside reflected copy k sits in the
// world. Odd copies are mirrored, which also flips polygon winding — the
// building draw has to reverse its point order to match, or every facade in
// every other copy is backface-culled away.
pub fn unfold(k: i64, u: f64, reach: f64): f64 {
    let base = (k as f64) * reach * 2.0
    if k % 2 == 0 {
        return base + u
    }
    return base - u
}

pub fn heightAt(c: &City, x: f64, z: f64): f64 {
    if c.loaded {
        return cityHeightAt(c, foldIn(x, c.reach), foldIn(z, c.reach))
    }
    return proceduralHeight(x, z)
}

// What you would hit at (x, z): the terrain, or a roof if a building stands
// there. `pad` widens the footprints by the span of whatever is asking.
//
// The floor and the hoops both go through this rather than through heightAt, so
// nothing the game places or pushes ends up inside a building — a hoop halfway
// through a tower is unflyable, and a plane through one is a hole in the world.
pub fn solidAt(c: &City, x: f64, z: f64, pad: f64): f64 {
    let ground = heightAt(c, x, z)
    if !c.loaded {
        return ground
    }
    let roof = cityRoofAt(c, foldIn(x, c.reach), foldIn(z, c.reach), pad)
    if roof > ground {
        return roof
    }
    return ground
}

pub fn coverAt(c: &City, x: f64, z: f64): u8 {
    if c.loaded {
        return cityCoverAt(c, foldIn(x, c.reach), foldIn(z, c.reach))
    }
    return COVER_URBAN
}

pub let SEED: i64 = 20260731

pub fn worldNew(): World {
    return worldSeeded(SEED)
}

pub fn worldSeeded(seed: i64): World {
    return worldIn(seed, Vec.new(), true)
}

// `places` is the whole rotation: the head is flown first and the rest come in
// one per region change. An empty list, or a list of one, is a world that never
// changes place — which is what --place, --city and the procedural world all
// want.
// How far out a place starts you from its first landmark. A short run: long
// enough to see the beam standing on it and to be flying rather than falling out
// of the sky, short enough that the opening leg is not the longest one.
pub let SPAWN_RUN: f64 = 1500.0

// The survey that plays when a place is swapped in mid-run. Shorter than the
// one at launch — you already know what the game is by then, and the only new
// information is what this place looks like.
pub let INTRO_ARRIVE: f64 = 5.5

// Put the aircraft a short run out from the first landmark, pointed at it.
//
// The offset runs toward the middle of the map, not backwards along the tour's
// own bearing. Backwards along the bearing is the obvious choice and it puts you
// off the edge of the world: Pearl Harbor sits 540 m from Honolulu's western
// boundary, and 1500 m back along the route from it lands 550 m outside the map,
// where the terrain is a mirrored copy of the far side. Toward the centre is
// inside the map by construction — and for every place in the lineup it also
// happens to be roughly the direction the tour carries on in.
fn spawnAt(w: &mut World) {
    if w.marks.len == 0 {
        return
    }
    let mx = w.marks[0].x
    let mz = w.marks[0].z
    let l = Math.sqrt(mx * mx + mz * mz)
    var ux = 0.0
    var uz = 1.0
    if l > 1.0 {
        ux = 0.0 - mx / l
        uz = 0.0 - mz / l
    }
    w.plane.x = mx + ux * SPAWN_RUN
    w.plane.z = mz + uz * SPAWN_RUN
    // Pointed at it. Spawning on a fixed heading put the player's back to the
    // landmark as often as not, which reads as the game having lost it.
    w.plane.yaw = Math.atan2(mx - w.plane.x, mz - w.plane.z)
    w.plane.pitch = 0.0
    w.plane.roll = 0.0
    // Above whatever is under the SPAWN, not above the map origin. Yosemite's
    // valley floor and its rim are 900 m apart, and the origin is not where you
    // are standing any more.
    let ground = solidAt(w.city, w.plane.x, w.plane.z, 20.0)
    var spawnY = ground + 320.0
    // Spawn UNDER the ceiling when there is one.
    //
    // 320 m is a good height to see a city from and a terrible one under a real
    // overcast: New York reported eight eighths at 261 m while this was being
    // written, which put the aircraft inside the cloud on the first frame with
    // nothing visible in any direction. That is a true rendering of that weather
    // and a broken start to a flight. A pilot under a low ceiling does the
    // obvious thing and flies beneath it, so this does too — and only when it has
    // to, since dropping below a base that is already high would throw away the
    // view for nothing.
    if w.env.clouds.valid {
        let under = w.env.clouds.baseM - 90.0
        if under < spawnY {
            spawnY = under
        }
        // Never so low that the city is above the aircraft.
        if spawnY < ground + 130.0 {
            spawnY = ground + 130.0
        }
    }
    w.plane.y = spawnY
    if envF64("FLYBY_DEBUG_SPAWN", 0.0) > 0.5 {
        print("spawn: ground " + ((ground as i64)).toString() + " base " + ((w.env.clouds.baseM as i64)).toString() + " -> plane y " + ((spawnY as i64)).toString())
    }
    let pose = chasePose(w)
    w.cam = pose
}

pub fn worldIn(seed: i64, places: Vec<City>, easy: bool): World {
    var rest = places
    var head = cityEmpty()
    if rest.len > 0 {
        head = replace(rest[0], cityEmpty())
        // Shift the tail down over the hole. Four elements at most, once, at
        // startup — the alternative is teaching the rotation about an index
        // that has to skip slot zero forever.
        for i in 1..rest.len {
            rest[i - 1] = replace(rest[i], cityEmpty())
        }
        let _ = rest.pop()
    }
    var w = World {
        rng: Rng.new(seed),
        env: envNew(head.originLat, head.originLon, head.reach, cityGroundRef(head)),
        city: head,
        easy: easy,
        plane: Plane {
            x: 0.0, y: 160.0, z: 0.0, yaw: 0.0, pitch: 0.0, roll: 0.0, speed: 190.0
        }
        ,
        cam: Camera {
            // `far` IS the terrain draw distance — render3d culls tiles against it,
            // so the grid radius and the camera agree by construction.
            x: 0.0, y: 0.0, z: 0.0, yaw: 0.0, pitch: 0.0, roll: 0.0, fov: 1.15, near: 0.6, far: (VIEW_TILES as f64) * TILE
        }
        ,
        next: rest,
        nextIdx: 0,
        rings: Vec.new(),
        sparks: Vec.new(),
        flocks: Vec.new(),
        flockTimer: 6.0,
        trailL: Vec.new(),
        trailR: Vec.new(),
        trailTick: 0.0,
        boosting: false,
        boostBlend: 0.0,
        evRing: false,
        evBonus: false,
        evRegion: false,
        evBoost: false,
        evMiss: false,
        missFlash: 0.0,
        bestCombo: 0,
        theme: Theme.Coast,
        prevTheme: Theme.Coast,
        themeMix: 0.0,
        level: 1,
        cleared: 0,
        toNext: 10,
        marks: Vec.new(),
        markIdx: 0,
        markName: "",
        markDist: 0.0,
        markFound: 0,
        markStart: 0.0,
        foundTook: 0.0,
        foundPop: 0.0,
        regionDone: false,
        evPlaceDone: false,
        nextName: "",
        intro: INTRO_LEN,
        introLen: INTRO_LEN,
        showT: 0.0,
        showIdx: 0,
        showAngle: 0.0,
        showLen: SHOW_LEN,
        showFromX: 0.0,
        showFromY: 0.0,
        showFromZ: 0.0,
        showFromYaw: 0.0,
        showFromPitch: 0.0,
        showFromRoll: 0.0,
        showFromFov: 1.15,
        pathT: 0.0,
        trailX: 0.0,
        trailZ: 0.0,
        score: 0,
        combo: 0,
        comboPop: 0.0,
        gain: 0,
        gainPop: 0.0,
        best: 0,
        time: 0.0,
        flash: 0.0,
        shake: 0.0,
        banner: 3.0,
        hint: 8.0,
        offCourse: 0.0,
        fence: 0.0,
        fenceLim: 0.0,
        skipHeld: false,
        lastFind: false,
    }
    w.marks = marksFor(w.city.name)
    computeFence(&mut w)
    w.plane.y = heightAt(w.city, 0.0, 0.0) + 320.0
    spawnAt(&mut w)
    // Hoops only over invented country. Over a real place the landmarks are the
    // reason to fly and a line of scoring rings just gets in front of them.
    if w.city.loaded {
        placeMarkRing(&mut w)
    } else {
        for i in 0..10 {
            layRing(&mut w)
        }
    }
    return w
}

// Tallest roof under the span of a hoop facing `heading`, or NO_ROOF-ish (a
// large negative) if nothing is built under it. The hoop's plane is
// perpendicular to the heading, so the samples walk the perpendicular.
fn roofUnderRing(c: &City, x: f64, z: f64, heading: f64, rad: f64): f64 {
    let px = Math.cos(heading)
    let pz = 0.0 - Math.sin(heading)
    var top = 0.0 - 1.0e18
    for i in 0..5 {
        let t = ((i as f64) - 2.0) * 0.5 * rad
        let r = solidAt(c, x + px * t, z + pz * t, 6.0)
        if r > top {
            top = r
        }
    }
    return top
}

// Bring the next place in. The plane keeps its position and heading — every map
// is mirrored to infinity, so any world coordinate lands somewhere valid in the
// new one — and the hoops already laid ahead are lifted clear of whatever is
// now under them.
fn rotatePlace(w: &mut World) {
    stepPlace(&mut w, 1)
}

// Swap in a place that the caller has just decoded. Kept separate from the
// preloaded `next` queue because holding four decoded cities at once cost about
// 290 MB — a 16 km asset is ~60 MB of footprints once parsed, plus its drape —
// and the memory guard killed the process for it. One place is resident at a
// time; the caller decodes the next on demand.
pub fn worldSetPlace(w: &mut World, c: City) {
    w.city = c
    envSetPlace(&mut w.env, w.city.originLat, w.city.originLon, w.city.reach, cityGroundRef(w.city))
    w.marks = marksFor(w.city.name)
    w.markIdx = 0
    w.markName = ""
    w.showT = 0.0
    // The tally belongs to the visit, not to the run. It used to survive a place
    // change, so arriving in Honolulu with three found in San Francisco signed
    // the region off after two.
    w.markFound = 0
    w.regionDone = false
    w.markStart = w.time
    w.foundPop = 0.0
    placeMarkRing(&mut w)
    // A place change is a new start, not a teleport with the old coordinates
    // kept: every map is mirrored to infinity so the old position IS valid
    // somewhere in the new one, but "valid" landed you 9 km from the first
    // landmark of a tour you had not been shown yet.
    spawnAt(&mut w)
    w.intro = INTRO_ARRIVE
    w.introLen = INTRO_ARRIVE
    // Hoops already laid may now be inside something: lift them clear.
    for i in 0..w.rings.len {
        if w.rings[i].alive {
            let low = roofUnderRing(w.city, w.rings[i].x, w.rings[i].z, w.rings[i].face, w.rings[i].r) + w.rings[i].r + 34.0
            if w.rings[i].y < low {
                w.rings[i].y = low
            }
        }
    }
    w.banner = 2.2
    w.evRegion = true
}

// Fly the same tour again. The rotation is what normally follows a completed
// region, but --city and --procedural have nowhere to rotate to, and finishing
// there would otherwise leave the player with five ticks, no beacon and nothing
// to aim at.
pub fn resetTour(w: &mut World) {
    for i in 0..w.marks.len {
        w.marks[i].found = false
        w.marks[i].took = 0.0
    }
    w.markIdx = 0
    w.markFound = 0
    w.markStart = w.time
    w.regionDone = false
    w.foundPop = 0.0
    placeMarkRing(&mut w)
}

// Step the rotation by one, either way. `dir` < 0 walks it backwards, which is
// the exact inverse: forward consumes slot `nextIdx` and leaves the outgoing
// place there, so backward reclaims slot `nextIdx - 1` and rewinds the cursor
// onto it. Bound to LEFT / RIGHT so a place can be looked at on demand instead
// of only arriving every tenth hoop.
pub fn stepPlace(w: &mut World, dir: i64) {
    if w.next.len == 0 {
        return
    }
    var k = w.nextIdx % w.next.len
    if dir < 0 {
        k = (w.nextIdx - 1 + w.next.len) % w.next.len
    }
    // Two moves through a hole: the slot the incoming place came out of is
    // where the outgoing one is parked, so the queue keeps cycling.
    let incoming = replace(w.next[k], cityEmpty())
    w.next[k] = replace(w.city, incoming)
    if dir < 0 {
        w.nextIdx = k
    } else {
        w.nextIdx = (k + 1) % w.next.len
    }
    // The tour belongs to the place, so it is rebuilt whenever the place moves.
    envSetPlace(&mut w.env, w.city.originLat, w.city.originLon, w.city.reach, cityGroundRef(w.city))
    w.marks = marksFor(w.city.name)
    computeFence(&mut w)
    w.markIdx = 0
    w.markName = ""
    w.markFound = 0
    w.regionDone = false
    w.markStart = w.time
    w.foundPop = 0.0
    spawnAt(&mut w)
    w.intro = INTRO_ARRIVE
    w.introLen = INTRO_ARRIVE
    w.banner = 2.2
    w.evRegion = true
    for i in 0..w.rings.len {
        if w.rings[i].alive {
            let low = roofUnderRing(w.city, w.rings[i].x, w.rings[i].z, w.rings[i].face, w.rings[i].r) + w.rings[i].r + 34.0
            if w.rings[i].y < low {
                w.rings[i].y = low
            }
        }
    }
}

// The course wanders as a slow sine in heading, so it curls through valleys and
// over ridges instead of running dead straight.
pub fn layRing(w: &mut World) {
    w.pathT += 1.0
    let t = w.pathT
    // No tour for this place: the original wander, which is the right shape for
    // invented country where one heading is as good as another.
    var heading = Math.sin(t * 0.030) * 0.9 + Math.sin(t * 0.008) * 2.0
    if w.marks.len > 0 {
        // Lay toward the landmark the tour is currently on, and step to the next
        // once the track has reached it. The hoops keep their spacing, so a
        // distant landmark simply takes more of them to arrive at.
        var dx = w.marks[w.markIdx].x - w.trailX
        var dz = w.marks[w.markIdx].z - w.trailZ
        if Math.sqrt(dx * dx + dz * dz) < 420.0 {
            w.markIdx = (w.markIdx + 1) % w.marks.len
            dx = w.marks[w.markIdx].x - w.trailX
            dz = w.marks[w.markIdx].z - w.trailZ
        }
        // Straight at it. There was a slow weave across this bearing to give the
        // player something to do between hoops; flown for real it is a constant
        // shallow S with the horizon rolling under you, which is exactly the
        // recipe for motion sickness. The view is the thing to look at.
        heading = Math.atan2(dx, dz)
        w.markName = w.marks[w.markIdx].name.clone()
    }
    // Far apart: a hoop you have to line up needs room to line up in.
    let step = 300.0
    let nx = w.trailX + Math.sin(heading) * step
    let nz = w.trailZ + Math.cos(heading) * step
    w.trailX = nx
    w.trailZ = nz
    let ground = heightAt(w.city, nx, nz)
    // High and nearly level. Low hoops put the aircraft in among the towers
    // where the frame is all parallax and no view; from up here the city reads
    // as a city, and the height barely changes hoop to hoop so the flight path
    // stops being a rollercoaster.
    let ride = 330.0 + 70.0 * (0.5 + 0.5 * Math.sin(t * 0.13))
    // Roughly one in four is a blue bonus hoop: tighter, and worth four times as
    // much, so there is a reason to take the harder line.
    let bonus = w.rng.range(0, 3) == 0
    var rad = 62.0
    if bonus {
        rad = 40.0
    }
    // Lift the hoop clear of anything built under it. A ring is a disc, not a
    // point, so the sample runs the width of the hoop across its own plane —
    // downtown, one tower under the rim is enough to make it unflyable.
    var y = ground + ride
    let low = roofUnderRing(w.city, nx, nz, heading, rad) + rad + 34.0
    if low > y {
        y = low
    }
    w.rings.push(Ring {
        x: nx,
        y: y,
        z: nz,
        face: heading,
        r: rad,
        alive: true,
        pop: 0.0,
        side: 0.0 - 1.0,
        bonus: bonus,
        beacon: false,
        armed: true,
    }
    )
}

// The current landmark, marked by a column of light standing on it and collected
// by flying over it at any height.
//
// It used to be a hoop 900 m short of the subject, faced along the bearing from
// the previous landmark, so that passing through it left the nose pointed at the
// thing. That framing is lovely and it only works when consecutive landmarks are
// kilometres apart. Honolulu's are not — Aloha Tower to the Iolani Palace is
// 800 m — so the hoop was placed BEHIND the landmark you had just left, out of
// frame in the one direction the player was not looking, with no way to reach it
// and therefore no way to advance. A tour is a list of places to go and look at,
// not a slalom, and a beam is visible from anywhere on the map at any altitude.
pub fn placeMarkRing(w: &mut World) {
    w.rings.clear()
    if w.marks.len == 0 {
        return
    }
    let mx = w.marks[w.markIdx].x
    let mz = w.marks[w.markIdx].z
    var px = 0.0
    var pz = 0.0
    if w.marks.len > 1 {
        let prev = (w.markIdx - 1 + w.marks.len) % w.marks.len
        px = w.marks[prev].x
        pz = w.marks[prev].z
    }
    var dx = mx - px
    var dz = mz - pz
    let l = Math.sqrt(dx * dx + dz * dz) + 0.0001
    // Kept only so anything that wants a heading for the target has one.
    let heading = Math.atan2(dx / l, dz / l)
    w.rings.push(Ring {
        x: mx, y: solidAt(w.city, mx, mz, 60.0), z: mz, face: heading,
        r: MARK_REACH, alive: true,
        pop: 0.0, side: 0.0 - 1.0, bonus: false, beacon: true, armed: false,
    }
    )
}

// How close, in plan, counts as arriving. Two seconds of flight at cruise: wide
// enough that a landmark cannot be missed by a wingspan at 190 m/s, tight enough
// that it is still a place you flew to rather than past.
pub let MARK_REACH: f64 = 320.0

// The arrival orbit runs exactly one revolution — `showAngle` is advanced at
// TAU / SHOW_LEN, so the sweep is a full circle of the subject and not the 120
// degrees a fixed rate happened to cover.
pub let SHOW_LEN: f64 = 8.0

// How long the orbit takes to ease back into the chase pose at its end, and how
// long the region sign-off holds on screen before the place changes. A skipped
// shot is wound down to the first of these, which is the shortest clock that
// still lands the camera home smoothly.
pub let SHOW_EASE: f64 = 1.6

pub let SIGNOFF: f64 = 3.2

// The opening survey.
pub let INTRO_LEN: f64 = 9.0

// mm:ss. Every clock on the checklist goes through this rather than printing raw
// seconds, which read as a lap time for the first minute and as nonsense after.
pub fn fmtTime(s: f64): string {
    var t = s
    if t < 0.0 {
        t = 0.0
    }
    let total = t as i64
    let sec = total % 60
    var out = (total / 60).toString() + ":"
    if sec < 10 {
        out += "0"
    }
    return out + sec.toString()
}

// Keeps the aircraft on the course. The world is infinite procedural terrain, so
// flying off the route is not a fail state — it is just nothing, forever, and a
// player who wanders has no way to tell they have left. Two layers, both scaled
// so that flying the rings never touches either:
//   - a turn assist that starts at the corridor edge and ramps in, banking you
//     back toward the course rather than snatching the controls
//   - a hard wall well outside it, which slides you along instead of stopping
// Both are measured to the nearest live ring. Consecutive rings are 300 apart, so
// a player exactly on the line is never more than ~150 out — well inside SOFT.
// One-axis mode. The aircraft flies the course on its own: it aims at the next
// hoop AHEAD of it and banks into the turn, so the bank still reads as flying
// rather than as the world swivelling. The player is left with climb and dive,
// which is the whole game — every hoop is placed at a different height.
//
// "Ahead" matters. Targeting the nearest live hoop makes the aircraft turn
// around and go back for one it has just passed, which is the single worst thing
// an autopilot can do to a six-year-old.
// An angle difference folded into -pi..pi, so a heading either side of due
// north is a small correction rather than most of a circle.
pub fn wrapPi(a: f64): f64 {
    var d = a
    while d > PI {
        d -= TAU
    }
    while d < 0.0 - PI {
        d += TAU
    }
    return d
}

fn autoSteer(w: &mut World, dt: f64) {
    let fwdX = Math.sin(w.plane.yaw)
    let fwdZ = Math.cos(w.plane.yaw)
    var bi = 0 - 1
    var bd = 1.0e18
    for i in 0..w.rings.len {
        if w.rings[i].alive {
            let rx = w.rings[i].x - w.plane.x
            let rz = w.rings[i].z - w.plane.z
            if rx * fwdX + rz * fwdZ <= 0.0 {
                continue
            }
            let d2 = rx * rx + rz * rz
            if d2 < bd {
                bd = d2
                bi = i
            }
        }
    }
    if bi < 0 {
        // Nothing ahead: hold the heading and roll level rather than snapping.
        w.plane.roll = w.plane.roll - w.plane.roll * Math.minF64(1.0, dt * 2.0)
        return
    }
    let want = Math.atan2(w.rings[bi].x - w.plane.x, w.rings[bi].z - w.plane.z)
    // Straight proportional control on the raw bearing. There was a "bumpless
    // transfer" here that absorbed the bearing step at a target change into a
    // decaying offset, to stop the switch reading as a twitch. It was the twitch:
    // for the ~0.3s the offset took to decay it told the controller the hoop was
    // on the side it was NOT on, so the aircraft banked away from every new
    // target before turning back. Bearing error held at 30-40 degrees the whole
    // way in and the bank oscillated up to 45 degrees on a four-second period,
    // growing. The yaw rate is already clamped, so the step it defended against
    // was never able to become a twitch in the first place.
    var diff = wrapPi(want - w.plane.yaw)
    w.plane.yaw = w.plane.yaw + Math.clampF64(diff * 1.1, 0.0 - 0.6, 0.6) * dt
    // Shallower bank, eased in more slowly. A 60-degree wing-over reads as
    // aerobatics; this is meant to read as an airliner turning onto final.
    let bank = Math.clampF64(diff * 0.8, 0.0 - 0.6, 0.6)
    w.plane.roll = w.plane.roll + (bank - w.plane.roll) * Math.minF64(1.0, dt * 1.4)
}

// Put the aircraft back under the ceiling after the weather has changed beneath
// it.
//
// The first spawn happens before the first fetch — the world is built, and only
// then does anything go to the network — so it clamps against whatever synthetic
// sky was there and not against the real one that arrives a moment later. Place
// changes do not have this problem, because they refetch before they respawn.
// Rather than reorder startup around a network call, the caller applies this once
// the sky it asked for has actually landed.
pub fn settleUnderCeiling(w: &mut World) {
    if !w.env.clouds.valid {
        return
    }
    let ground = solidAt(w.city, w.plane.x, w.plane.z, 20.0)
    let under = w.env.clouds.baseM - 90.0
    if under >= w.plane.y {
        return
    }
    var y = under
    if y < ground + 130.0 {
        y = ground + 130.0
    }
    w.plane.y = y
    w.cam = chasePose(w)
}

// How high you may fly. Two rules, the higher of the two wins:
//   - 900 m over whatever is directly under you, so there is always sky to climb
//     into wherever you happen to be
//   - a clear kilometre over the highest point in the whole map
//
// The second rule is the one that matters over terrain with relief. A ceiling
// measured only from the ground beneath sinks with the ground: over the Grand
// Canyon floor it sat a few hundred metres BELOW the rim, and over the Yosemite
// valley floor below the top of El Capitan, so climbing out of either one hit an
// invisible lid partway up the wall you were trying to get above.
fn ceilingY(w: &World, ground: f64): f64 {
    var top = ground + 900.0
    if w.city.loaded {
        let overMap = w.city.topMax + 1200.0
        if overMap > top {
            top = overMap
        }
    }
    return top
}

// The map edge. Outside it the terrain is a mirrored copy of the inside
// (foldIn), which is continuous but is also the same city over again — flying
// out there is how you end up over a second Manhattan with no landmarks in it.
// So the boundary is a wall: it shows itself, it turns you back, and it caps
// your position. Never a fail state, the same as the ground and the ceiling.
pub let FENCE_SOFT: f64 = 1500.0 // starts turning you this far inside the cap

pub let FENCE_HARD: f64 = 300.0 // and the cap is this far inside the data edge

// Where the wall stands, as a half-extent, for this place and its tour.
//
// Inside the data edge by FENCE_HARD — unless a landmark sits out there, in
// which case the wall moves out to clear it. The Brooklyn Bridge is 5778 m from
// the middle of a Manhattan asset that only reaches 6000, so a fixed 300 m
// margin fenced off the last landmark of the tour and the region could not be
// finished. A boundary that can make the game unwinnable is a worse bug than the
// one it was added to fix, so the tour wins and the margin gives.
//
// Never past the data edge itself: out there the terrain is a mirrored copy, and
// a landmark you collect over a reflection is not the landmark.
fn computeFence(w: &mut World) {
    if !w.city.loaded || w.city.reach <= 0.0 {
        w.fenceLim = 0.0
        return
    }
    var lim = w.city.reach - FENCE_HARD
    for i in 0..w.marks.len {
        // Half the collection radius past the landmark, so it can be flown OVER
        // rather than only just touched from the side of it.
        let need = Math.maxF64(Math.abs(w.marks[i].x), Math.abs(w.marks[i].z)) + MARK_REACH * 0.5
        if need > lim {
            lim = need
        }
    }
    w.fenceLim = Math.minF64(lim, w.city.reach - 60.0)
}

pub fn fenceK(v: f64, lim: f64): f64 {
    let soft = lim - FENCE_SOFT
    let d = Math.abs(v)
    if d <= soft {
        return 0.0
    }
    return Math.clampF64((d - soft) / FENCE_SOFT, 0.0, 1.0)
}

fn fence(w: &mut World, dt: f64) {
    if !w.city.loaded || w.fenceLim <= 0.0 {
        w.fence = 0.0
        return
    }
    let lim = w.fenceLim
    let kx = fenceK(w.plane.x, lim)
    let kz = fenceK(w.plane.z, lim)
    let k = Math.maxF64(kx, kz)
    w.fence = k
    if k <= 0.0 {
        return
    }
    // Inward normal of whichever walls are close, weighted by how close each is,
    // so a corner turns you diagonally rather than into the other wall.
    var inX = 0.0
    var inZ = 0.0
    if kx > 0.0 {
        inX = kx
        if w.plane.x > 0.0 {
            inX = 0.0 - kx
        }
    }
    if kz > 0.0 {
        inZ = kz
        if w.plane.z > 0.0 {
            inZ = 0.0 - kz
        }
    }
    let want = Math.atan2(inX, inZ)
    let diff = wrapPi(want - w.plane.yaw)
    // How much of the aircraft's heading is pointed OUT of the map. Flying along
    // the edge, or already turning back, is not leaving — correcting it anyway is
    // the invisible hand on the stick this game took out of the ring course.
    let n = Math.sqrt(inX * inX + inZ * inZ)
    var head = 0.0
    if n > 0.0001 {
        head = 0.0 - (Math.sin(w.plane.yaw) * inX + Math.cos(w.plane.yaw) * inZ) / n
    }
    head = Math.clampF64(head, 0.0, 1.0)
    // Quadratic, so the first touch of the wall is barely perceptible and it only
    // becomes a hand on the stick once you are clearly leaving.
    var assist = k * k * (0.15 + 0.85 * head)
    // Off on the approach to a landmark that itself sits near the edge. Half the
    // tours have one out there, and a wall that steers you off the thing it is
    // standing behind is the same unwinnable game as a wall in front of it.
    //
    // The bubble is sized from how close the LANDMARK is to the wall, not from a
    // fixed radius: Pearl Harbor sits 240 m inside Honolulu's boundary, so the
    // whole of its final approach is inside the turn-back zone, and a fixed
    // thousand-metre bubble still spent the two kilometres before it shoving the
    // nose away. The position cap below is untouched, so none of this lets
    // anyone out of the map.
    if w.marks.len > 0 && w.markIdx < w.marks.len {
        let mdx = w.plane.x - w.marks[w.markIdx].x
        let mdz = w.plane.z - w.marks[w.markIdx].z
        let md = Math.sqrt(mdx * mdx + mdz * mdz)
        let edge = lim - Math.maxF64(Math.abs(w.marks[w.markIdx].x), Math.abs(w.marks[w.markIdx].z))
        var bubble = MARK_REACH + 700.0
        if edge < FENCE_SOFT {
            // Far enough out to cover the whole run in from where the wall
            // starts pushing, plus the room needed to line up on the hoop.
            bubble = FENCE_SOFT - edge + MARK_REACH + 700.0
        }
        if md < bubble {
            assist *= Math.clampF64(md / bubble, 0.0, 1.0)
        }
    }
    w.plane.yaw = w.plane.yaw + Math.clampF64(diff * 2.0, 0.0 - 1.6, 1.6) * assist * dt
    // Bank into the turn: the correction has to read as the aircraft flying
    // rather than as the world rotating underneath it.
    w.plane.roll = w.plane.roll + Math.clampF64(diff, 0.0 - 1.0, 1.0) * assist * 2.4 * dt
    w.plane.roll = Math.clampF64(w.plane.roll, 0.0 - 1.10, 1.10)
    // The turn on its own loses to a player who holds the nose at the wall, so
    // the position is capped as well. At the cap you slide along it and turn.
    w.plane.x = Math.clampF64(w.plane.x, 0.0 - lim, lim)
    w.plane.z = Math.clampF64(w.plane.z, 0.0 - lim, lim)
}

fn corridor(w: &mut World, dt: f64) {
    // The autopilot already keeps the aircraft on the line; a second steering
    // force fighting it would only make the turns wobble.
    if w.easy {
        w.offCourse = 0.0
        return
    }
    let SOFT = 420.0
    let HARD = 950.0
    var bi = 0 - 1
    var bd = 1.0e18
    for i in 0..w.rings.len {
        if w.rings[i].alive {
            let rx = w.rings[i].x - w.plane.x
            let rz = w.rings[i].z - w.plane.z
            let d2 = rx * rx + rz * rz
            if d2 < bd {
                bd = d2
                bi = i
            }
        }
    }
    if bi < 0 {
        w.offCourse = 0.0
        return
    }
    let cx = w.rings[bi].x
    let cz = w.rings[bi].z
    let dx = w.plane.x - cx
    let dz = w.plane.z - cz
    let d = Math.sqrt(dx * dx + dz * dz)
    var k = (d - SOFT) / (HARD - SOFT)
    if k < 0.0 {
        k = 0.0
    }
    if k > 1.0 {
        k = 1.0
    }
    w.offCourse = k
    if k <= 0.0 {
        return
    }
    // shortest signed turn back toward the course
    let want = Math.atan2(cx - w.plane.x, cz - w.plane.z)
    let diff = wrapPi(want - w.plane.yaw)
    // Quadratic, so the first touch of the corridor is barely perceptible and it
    // only becomes a real force once you are clearly leaving.
    let assist = k * k
    w.plane.yaw = w.plane.yaw + diff * assist * 1.5 * dt
    // bank into the correction, so the assist is visible as flying rather than
    // as the world rotating underneath you
    w.plane.roll = w.plane.roll + Math.clampF64(diff, 0.0 - 1.0, 1.0) * assist * 2.2 * dt
    w.plane.roll = Math.clampF64(w.plane.roll, 0.0 - 1.25, 1.25)
    if d > HARD {
        let pull = HARD / d
        w.plane.x = cx + dx * pull
        w.plane.z = cz + dz * pull
    }
}

// The collect orbit. The camera leaves the aircraft, circles the subject and
// looks at it. Held level and well above, because the point is to show the thing
// whole — a camera that banks or sits at its base shows a wall.
// The cinematic orbit around a collected landmark.
//
// It eases out of the camera the player already had and eases back into it, so
// the shot brackets the flight rather than interrupting it. Cutting straight to a
// fixed pose and cutting straight back was two jumps in seven seconds, and both
// of them landed on a frame where nothing else had moved — which is exactly when
// a cut is most obvious.
// How high the orbit camera has to fly at (ox, oz) to see the subject at all.
//
// A fixed height above the SUBJECT is only enough where the subject is the
// highest thing around. Half the Grand Canyon tour is below the rim, so a circle
// 320 m over Plateau Point spends a third of its sweep inside the wall behind it
// and the shot cuts to brown rock. Two constraints, both cheap:
//   - stay above whatever is under the camera itself
//   - keep the straight line to the subject clear of everything in between
//
// Only ever raises, so one forward pass is enough: lifting the camera for a
// sample near the subject cannot re-block a sample further out.
// How far out a camera may go. Zero over invented country, which has no edge.
fn camLimit(w: &World): f64 {
    if !w.city.loaded || w.fenceLim <= 0.0 {
        return 0.0
    }
    return w.fenceLim - 40.0
}

fn orbitHeight(w: &World, ox: f64, oz: f64, mx: f64, mz: f64, ly: f64): f64 {
    var oy = ly + 320.0
    let under = solidAt(w.city, ox, oz, 40.0) + 150.0
    if under > oy {
        oy = under
    }
    let STEPS = 14
    for i in 1..STEPS {
        let t = (i as f64) / (STEPS as f64)
        let sx = ox + (mx - ox) * t
        let sz = oz + (mz - oz) * t
        let need = solidAt(w.city, sx, sz, 40.0) + 70.0
        // Height of the sight line at t, given the camera at oy and the subject
        // at ly. Solve oy(1-t) + ly*t = need for the oy that just clears it.
        if need > oy + (ly - oy) * t {
            oy = (need - ly * t) / (1.0 - t)
        }
    }
    // A landmark at the bottom of a mile-deep hole would otherwise put the
    // camera in orbit. Past this the shot is better off clipping than tiny.
    return Math.minF64(oy, ly + 2200.0)
}

fn orbitCamera(w: &mut World) {
    let mx = w.marks[w.showIdx].x
    let mz = w.marks[w.showIdx].z
    let ly = solidAt(w.city, mx, mz, 60.0) + 80.0
    var rad = 640.0
    var ox = mx + Math.sin(w.showAngle) * rad
    var oz = mz + Math.cos(w.showAngle) * rad
    var oy = orbitHeight(w, ox, oz, mx, mz, ly)
    // Clearing the wall is only half the job. Indian Garden sits 900 m below the
    // rim, so the height that gets a sight line at 640 m out is a near-vertical
    // look-down — the shot stops being blocked and becomes a map. Widen the
    // circle until the depression angle is back under about 40 degrees.
    let SLOPE = 0.84
    if oy - ly > rad * SLOPE {
        rad = Math.minF64((oy - ly) / SLOPE, 2400.0)
        ox = mx + Math.sin(w.showAngle) * rad
        oz = mz + Math.cos(w.showAngle) * rad
        oy = orbitHeight(w, ox, oz, mx, mz, ly)
    }
    // Same fence the survey respects: Pearl Harbor sits 540 m from Honolulu's
    // western edge, and a 2.4 km orbit around it is otherwise half over the
    // mirrored copy of the island.
    let camLim = camLimit(w)
    if camLim > 0.0 {
        ox = Math.clampF64(ox, 0.0 - camLim, camLim)
        oz = Math.clampF64(oz, 0.0 - camLim, camLim)
        oy = orbitHeight(w, ox, oz, mx, mz, ly)
    }
    let oyaw = Math.atan2(mx - ox, mz - oz)
    let horiz = Math.sqrt((mx - ox) * (mx - ox) + (mz - oz) * (mz - oz))
    let opitch = 0.0 - Math.atan2(oy - ly, horiz)

    // Blend in over the first EASE seconds and out over the last, and take the
    // smaller of the two so a shot shorter than 2*EASE still ends where it began.
    let EASE = 1.6
    let elapsed = w.showLen - w.showT
    var k = Math.minF64(elapsed / EASE, w.showT / EASE)
    k = Math.clampF64(k, 0.0, 1.0)
    // Smoothstep, so the camera leaves and rejoins the flight at zero speed.
    k = k * k * (3.0 - 2.0 * k)

    w.cam.x = w.showFromX + (ox - w.showFromX) * k
    w.cam.y = w.showFromY + (oy - w.showFromY) * k
    w.cam.z = w.showFromZ + (oz - w.showFromZ) * k
    // Through the short way round: lerping raw headings across the seam spins the
    // camera most of a circle to travel a few degrees.
    w.cam.yaw = w.showFromYaw + wrapPi(oyaw - w.showFromYaw) * k
    w.cam.pitch = w.showFromPitch + (opitch - w.showFromPitch) * k
    w.cam.roll = w.showFromRoll * (1.0 - k)
    w.cam.fov = w.showFromFov + (1.05 - w.showFromFov) * k
}

// Where the chase camera wants to be this frame, unsmoothed. Pulled out of
// worldUpdate so the opening survey has something to aim at: the intro is a
// blend from a camera kilometres up into exactly this pose, and duplicating the
// arithmetic would mean the survey landed a few metres off and snapped.
fn chasePose(w: &World): Camera {
    let back = 58.0 + w.boostBlend * 22.0
    return Camera {
        x: w.plane.x - Math.sin(w.plane.yaw) * back,
        y: w.plane.y + 20.0,
        z: w.plane.z - Math.cos(w.plane.yaw) * back,
        yaw: w.plane.yaw,
        pitch: w.plane.pitch * 0.55 - 0.06,
        roll: 0.0,
        fov: 1.15,
        near: w.cam.near,
        far: w.cam.far,
    }
}

// The opening survey. Starts high and wide with the whole map under it, sweeps
// three quarters of a turn around the parked aircraft and descends into the
// chase pose, arriving at zero speed.
//
// It ends ON the chase camera rather than near it — the last thing an intro
// should do is cut.
fn introCamera(w: &mut World) {
    var k = 1.0 - w.intro / w.introLen
    k = Math.clampF64(k, 0.0, 1.0)
    // Smoothstep twice: the survey lingers wide, then falls in.
    let e = k * k * (3.0 - 2.0 * k)
    let e2 = e * e * (3.0 - 2.0 * e)
    let chase = chasePose(w)
    let ground = heightAt(w.city, w.plane.x, w.plane.z)
    // Radius and height collapse on the sharper curve, so most of the shot is
    // spent up where the city reads as a city.
    // Held inside the terrain draw distance. Higher and wider reads better in
    // the abstract and is a white screen in practice: the grid is 4.4 km around
    // the camera and the haze finishes inside that, so a survey from three
    // kilometres up looks at fog.
    let rad = 2200.0 + (58.0 - 2200.0) * e2
    var alt = ground + 1050.0 + ((w.plane.y + 20.0) - (ground + 1050.0)) * e2
    // Behind the aircraft is where the sweep has to finish, so it is measured
    // backwards from there — three quarters of a turn, arriving exactly on it.
    let ang = (w.plane.yaw + PI) - (1.0 - e) * TAU * 0.75
    var ox = w.plane.x + Math.sin(ang) * rad
    var oz = w.plane.z + Math.cos(ang) * rad
    // Held inside the boundary. A survey that swings out over the mirrored copy
    // of the map opens the game on the one view the fence exists to prevent.
    let camLim = camLimit(w)
    if camLim > 0.0 {
        ox = Math.clampF64(ox, 0.0 - camLim, camLim)
        oz = Math.clampF64(oz, 0.0 - camLim, camLim)
    }
    // And above the rock. The survey circles at a fixed height over the ground
    // under the AIRCRAFT, which in a valley is a height well inside the walls
    // either side of it — in Yosemite the opening sweep spent a third of its arc
    // inside the granite, looking at the back of it. Same two constraints the
    // arrival orbit already solves, eased out as the shot settles into the chase
    // pose so it does not lift the camera the player is about to fly with.
    let clear = orbitHeight(w, ox, oz, w.plane.x, w.plane.z, w.plane.y)
    if clear > alt {
        alt = alt + (clear - alt) * (1.0 - e2)
    }
    w.cam.x = ox
    w.cam.y = alt
    w.cam.z = oz
    // Looking at the aircraft the whole way. At e = 1 this IS the chase yaw,
    // because the camera is directly behind it by construction.
    w.cam.yaw = Math.atan2(w.plane.x - ox, w.plane.z - oz)
    let horiz = Math.sqrt((w.plane.x - ox) * (w.plane.x - ox) + (w.plane.z - oz) * (w.plane.z - oz))
    let look = 0.0 - Math.atan2(alt - (w.plane.y + 20.0), Math.maxF64(horiz, 1.0))
    w.cam.pitch = look + (chase.pitch - look) * e2
    w.cam.roll = 0.0
    w.cam.fov = 1.32 + (chase.fov - 1.32) * e
}

// Name and range of the landmark being sought, for the HUD and the checklist.
fn updateMarkReadout(w: &mut World) {
    if w.marks.len == 0 {
        return
    }
    let dx = w.marks[w.markIdx].x - w.plane.x
    let dz = w.marks[w.markIdx].z - w.plane.z
    w.markDist = Math.sqrt(dx * dx + dz * dz)
    w.markName = w.marks[w.markIdx].name.clone()
}

// The next landmark on the tour that has not been found. A plain +1 would be
// enough while the tour is only ever flown in order, but the search makes
// "found" the thing that decides, so a landmark collected out of order — or a
// list that gains a shortcut later — cannot strand the cursor on it.
fn advanceMark(w: &mut World) {
    for k in 0..w.marks.len {
        let i = (w.markIdx + 1 + k) % w.marks.len
        if !w.marks[i].found {
            w.markIdx = i
            w.markStart = w.time
            return
        }
    }
}

pub fn worldUpdate(w: &mut World, dt: f64, inRoll: f64, inPitch: f64, boost: bool) {
    w.evRing = false
    w.evBonus = false
    w.evRegion = false
    w.evBoost = false
    w.evMiss = false
    w.evPlaceDone = false
    w.time += dt
    // The sun moves because the day does. At real time this is a fraction of a
    // degree an hour and invisible frame to frame, which is the point: it is
    // right rather than animated.
    envRetime(&mut w.env, w.time)
    if w.missFlash > 0.0 {
        w.missFlash = w.missFlash - dt * 1.4
    }
    if w.flash > 0.0 {
        w.flash = w.flash - dt * 1.8
    }
    if w.shake > 0.0 {
        w.shake *= Math.pow(0.02, dt)
    }
    if w.banner > 0.0 {
        w.banner -= dt
    }
    if w.themeMix > 0.0 {
        w.themeMix = w.themeMix - dt * 0.55
        if w.themeMix < 0.0 {
            w.themeMix = 0.0
        }
    }
    if w.hint > 0.0 && (inRoll != 0.0 || inPitch != 0.0) {
        w.hint -= dt
    }
    if w.comboPop > 0.0 {
        w.comboPop = w.comboPop - dt * 2.2
    }
    if w.foundPop > 0.0 {
        w.foundPop = w.foundPop - dt * 0.55
    }

    // Opening survey. Frozen like the arrival orbit, and skippable — a player who
    // has already seen it reaches for the stick, and the shot should read that as
    // "get on with it" rather than ignore them for nine seconds.
    if w.intro > 0.0 {
        if (inRoll != 0.0 || inPitch != 0.0 || boost) && w.intro > 1.0 {
            w.intro = 1.0
        }
        w.intro -= dt
        // The clock on the first landmark starts when the player gets the stick.
        w.markStart = w.time
        introCamera(&mut w)
        updateMarkReadout(&mut w)
        return
    }

    // Orbit running: the aircraft holds station and the camera does the work.
    // Nothing else in the simulation advances, so a landmark cannot be collected
    // while another is being shown.
    if w.showT > 0.0 {
        // Space cuts the shot short. Not a hard cut: the orbit already eases back
        // into the chase pose over its last SHOW_EASE seconds, so a skip winds
        // the clock down to exactly that and the camera flies home rather than
        // teleporting. Held down, it is one press per shot — the key has to be
        // released before it can skip the next one.
        if boost && !w.skipHeld && w.showT > SHOW_EASE {
            w.showT = SHOW_EASE
        }
        w.skipHeld = boost
        w.showT -= dt
        // One full revolution over the length of the shot, whatever that length
        // is, so the subject is seen from every side and the sweep ends where it
        // started instead of stopping wherever a fixed rate had got to.
        w.showAngle = w.showAngle + dt * TAU / w.showLen
        // The last landmark of a region signs the region off on the SAME orbit,
        // rather than starting a second one. Two orbits back to back — one for
        // the landmark, one for the region — is eight seconds of the world
        // turning under you, and the cut between them lands on the one frame
        // where nothing else has moved.
        if w.lastFind && !w.regionDone && w.showT <= SIGNOFF {
            w.regionDone = true
            w.flash = Math.maxF64(w.flash, 0.9)
        }
        orbitCamera(&mut w)
        updateSparks(&mut w, dt)
        if w.showT <= 0.0 {
            if w.regionDone {
                // The sign-off has played: ask the caller for the next region.
                w.evPlaceDone = true
                w.regionDone = false
                w.lastFind = false
            } else {
                advanceMark(&mut w)
                placeMarkRing(&mut w)
            }
        }
        return
    }
    if w.gainPop > 0.0 {
        w.gainPop = w.gainPop - dt * 0.8
    }

    // Arcade flight: roll banks the aircraft, and a banked aircraft turns. Pitch
    // is direct. Both self-centre, so letting go levels you out.
    // Roll is rate-controlled and self-centres, so letting go rolls wings-level.
    // Free flight. The autopilot flew the course for you, which made sense when
    // the course WAS the game; over a real city the point is to go and look at
    // something, and being steered is the opposite of that.
    //
    // Gentler than the old --pro numbers: roll builds over about a second rather
    // than a third of one, and tops out at 40 degrees instead of 72. Fast enough
    // to turn onto a landmark, slow enough that the horizon never swings.
    w.plane.roll = w.plane.roll + (inRoll * 1.2 - w.plane.roll * 1.6) * dt
    w.plane.roll = Math.clampF64(w.plane.roll, 0.0 - 0.70, 0.70)
    // Pitch HOLDS where you put it, with only a weak return to level. Springing
    // back to zero the instant you let go is what made the vertical axis feel
    // wrong — you could never settle into a climb.
    w.plane.pitch = w.plane.pitch + (inPitch * 1.1 - w.plane.pitch * 0.5) * dt
    w.plane.pitch = Math.clampF64(w.plane.pitch, 0.0 - 0.55, 0.55)
    // A banked aircraft turns. This is the only way to change heading, which is
    // what makes it feel like flying rather than driving.
    w.plane.yaw = w.plane.yaw + w.plane.roll * 1.30 * dt

    // Energy, not a constant: a dive trades height for speed and a climb trades
    // it back. Throttle shifts the whole band. This is why the number on the HUD
    // was static before — nothing was driving it but the boost key.
    // The afterburner is a switch, not a budget. It used to be a four-second tank
    // that took eight to refill and locked out when run dry — a rationing rule
    // that made sense when the goal was a hoop course with a par time. The goal
    // now is to go and look at something eight kilometres away, and metering the
    // one control that shortens that flight only makes it longer. It also cost a
    // fuel gauge on a HUD that is otherwise down to two lines.
    let burning = boost
    if burning && !w.boosting {
        w.evBoost = true
    }
    w.boosting = burning
    // Every speed cue rides this one eased value, so they all arrive together.
    var bt = 0.0
    if burning {
        bt = 1.0
    }
    w.boostBlend = w.boostBlend + (bt - w.boostBlend) * Math.minF64(1.0, dt * 5.0)
    var target = 175.0
    if burning {
        target = 320.0
    }
    w.plane.speed = w.plane.speed + (target - w.plane.speed) * Math.minF64(1.0, dt * 0.9)
    w.plane.speed = w.plane.speed - Math.sin(w.plane.pitch) * 140.0 * dt
    w.plane.speed = Math.clampF64(w.plane.speed, 130.0, 430.0)

    let cp = Math.cos(w.plane.pitch)
    w.plane.x = w.plane.x + Math.sin(w.plane.yaw) * cp * w.plane.speed * dt
    w.plane.z = w.plane.z + Math.cos(w.plane.yaw) * cp * w.plane.speed * dt
    w.plane.y = w.plane.y + Math.sin(w.plane.pitch) * w.plane.speed * dt

    // No corridor. It existed to keep the player on the ring course by turning
    // the aircraft for them; with nowhere you are supposed to be, an invisible
    // hand on the stick is just a bug you cannot see the cause of.

    // You cannot crash: the ground pushes you up and the sky pushes you down.
    // Roofs push too — flying THROUGH a tower is worse than being bumped over
    // it, and the push is the same rule the terrain already uses, so there is
    // still no fail state. The pad is a wing half-span, so a wing does not
    // disappear into a facade the fuselage cleared.
    let ground = solidAt(w.city, w.plane.x, w.plane.z, 12.0)
    let floorY = ground + 26.0
    if w.plane.y < floorY {
        w.plane.y = w.plane.y + (floorY - w.plane.y) * Math.minF64(1.0, dt * 7.0)
        if w.plane.pitch < 0.0 {
            w.plane.pitch *= 0.85
        }
    }
    let ceil = ceilingY(w, ground)
    if w.plane.y > ceil {
        // Pushed rather than clamped, and the nose is levelled the same way the
        // floor levels a dive. A hard clamp on y with the nose still up flies the
        // aircraft along an invisible sheet of glass at full climb attitude.
        w.plane.y = w.plane.y + (ceil - w.plane.y) * Math.minF64(1.0, dt * 7.0)
        if w.plane.pitch > 0.0 {
            w.plane.pitch *= 0.85
        }
    }

    fence(&mut w, dt)

    // chase camera, trailing and slightly above
    let back = 58.0 + w.boostBlend * 22.0
    let backX = 0.0 - Math.sin(w.plane.yaw) * back
    let backZ = 0.0 - Math.cos(w.plane.yaw) * back
    w.cam.x = w.cam.x + (w.plane.x + backX - w.cam.x) * Math.minF64(1.0, dt * 6.0)
    w.cam.y = w.cam.y + (w.plane.y + 20.0 - w.cam.y) * Math.minF64(1.0, dt * 6.0)
    w.cam.z = w.cam.z + (w.plane.z + backZ - w.cam.z) * Math.minF64(1.0, dt * 6.0)
    w.cam.fov = 1.15 + w.boostBlend * 0.30
    w.cam.yaw = w.plane.yaw
    w.cam.pitch = w.plane.pitch * 0.55 - 0.06
    // The camera keeps the horizon much closer to level than the aircraft. A
    // chase camera that rolls with the wings puts the whole world on a pivot,
    // which is what turns a gentle turn into something you feel in your stomach.
    w.cam.roll = w.cam.roll + (w.plane.roll * 0.18 - w.cam.roll) * Math.minF64(1.0, dt * 2.5)

    updateMarkReadout(&mut w)
    updateRings(&mut w, dt)
    updateTrails(&mut w, dt)
    updateFlocks(&mut w, dt)
}

// Ring passing: watch which side of the ring's plane the aircraft is on. When
// that flips and it happened inside the hoop, it counts. Distance-based tests
// miss at speed; a plane crossing cannot.
// Birds. A flock spawns off to one side every so often, crosses ahead of the
// aircraft and leaves. They are scenery with a lifetime, not obstacles — nothing
// collides with them.
fn updateFlocks(w: &mut World, dt: f64) {
    w.flockTimer -= dt
    if w.flockTimer <= 0.0 {
        w.flockTimer = 11.0 + w.rng.floatRange(0.0, 14.0)
        // Spawn ahead and off to one side, crossing the flight path rather than
        // running parallel with it — a flock you overtake from behind is barely
        // visible, one that cuts across the nose reads immediately.
        let ahead = 620.0 + w.rng.floatRange(0.0, 500.0)
        var side = 520.0 + w.rng.floatRange(0.0, 420.0)
        var dir = 1.0
        if w.rng.bool() {
            side = 0.0 - side
            dir = 0.0 - 1.0
        }
        let fx = Math.sin(w.plane.yaw)
        let fz = Math.cos(w.plane.yaw)
        // right vector is the forward vector turned 90 degrees
        let rx = fz
        let rz = 0.0 - fx
        let px = w.plane.x + fx * ahead + rx * side
        let pz = w.plane.z + fz * ahead + rz * side
        let ground = heightAt(w.city, px, pz)
        let sp = 26.0 + w.rng.floatRange(0.0, 22.0)
        w.flocks.push(Flock {
            x: px,
            y: Math.maxF64(ground + 60.0, w.plane.y + w.rng.floatRange(0.0 - 40.0, 80.0)),
            z: pz,
            // fly across the nose, back toward the course line
            vx: 0.0 - rx * dir * sp,
            vz: 0.0 - rz * dir * sp,
            n: 5 + w.rng.range(0, 8),
            seed: w.rng.floatRange(0.0, 10.0),
            life: 44.0,
        }
        )
    }
    var i: i64 = 0
    while i < w.flocks.len {
        w.flocks[i].x = w.flocks[i].x + w.flocks[i].vx * dt
        w.flocks[i].z = w.flocks[i].z + w.flocks[i].vz * dt
        // drift gently up and down as they glide
        w.flocks[i].y = w.flocks[i].y + Math.sin(w.time * 0.5 + w.flocks[i].seed) * 4.0 * dt
        w.flocks[i].life -= dt
        let dx = w.flocks[i].x - w.plane.x
        let dz = w.flocks[i].z - w.plane.z
        let gone = w.flocks[i].life <= 0.0 || dx * dx + dz * dz > 3200.0 * 3200.0
        if gone {
            let last = w.flocks.len - 1
            w.flocks[i] = w.flocks[last]
            let _ = w.flocks.pop()
        } else {
            i += 1
        }
    }
}

fn updateRings(w: &mut World, dt: f64) {
    var toLay: i64 = 0
    var i: i64 = 0
    while i < w.rings.len {
        if w.rings[i].pop > 0.0 {
            w.rings[i].pop = w.rings[i].pop - dt * 1.6
        }
        var drop = false
        if w.rings[i].alive && w.rings[i].beacon {
            // Plan distance only. A beam is a place on the map, and a place is
            // arrived at from any heading and any height — which is the whole
            // point of replacing the hoop.
            let bdx = w.plane.x - w.rings[i].x
            let bdz = w.plane.z - w.rings[i].z
            let inside = bdx * bdx + bdz * bdz < w.rings[i].r * w.rings[i].r
            if !w.rings[i].armed {
                if !inside {
                    w.rings[i].armed = true
                }
            } else if inside {
                clearRing(&mut w, i)
                toLay += 1
            }
        } else if w.rings[i].alive {
            let nx = Math.sin(w.rings[i].face)
            let nz = Math.cos(w.rings[i].face)
            let dx = w.plane.x - w.rings[i].x
            let dy = w.plane.y - w.rings[i].y
            let dz = w.plane.z - w.rings[i].z
            let sideNow = dx * nx + dz * nz
            let prev = w.rings[i].side
            w.rings[i].side = sideNow
            if prev < 0.0 && sideNow >= 0.0 {
                // radial offset within the ring's plane
                let px2 = dx - nx * sideNow
                let pz2 = dz - nz * sideNow
                let rad = Math.sqrt(px2 * px2 + dy * dy + pz2 * pz2)
                if rad < w.rings[i].r {
                    clearRing(&mut w, i)
                    toLay += 1
                } else {
                    // Judged the moment you pass the hoop's plane, not when the
                    // hoop is finally far enough behind to be culled. That cull
                    // is 420 units back — over two seconds at speed — by which
                    // time you have flown the NEXT ring, and the late break then
                    // wipes a streak you had already rebuilt. The player sees a
                    // streak reset two rings after the ring they actually fluffed.
                    missRing(&mut w, i)
                    toLay += 1
                }
            }
        }
        if !w.rings[i].alive && w.rings[i].pop <= 0.0 {
            drop = true
        }
        // The landmark hoop is a destination, not a hurdle on a course: it stays
        // until it is flown through, however many times the player goes round.
        // The cull below exists because a passed hoop on the endless course was
        // gone for good — applied here it deleted the only hoop in the world a
        // few seconds after takeoff and never replaced it.
        let bx = w.rings[i].x - w.plane.x
        let bz = w.rings[i].z - w.plane.z
        if !w.city.loaded && bx * Math.sin(w.plane.yaw) + bz * Math.cos(w.plane.yaw) < 0.0 - 420.0 {
            // Still live this far behind means the hoop's plane was never
            // crossed at all — flown around rather than fluffed. Same penalty.
            if w.rings[i].alive {
                missRing(&mut w, i)
                toLay += 1
            }
            drop = true
        }
        if drop {
            let last = w.rings.len - 1
            w.rings[i] = w.rings[last]
            let _ = w.rings.pop()
        } else {
            i += 1
        }
    }
    if !w.city.loaded {
        for k in 0..toLay {
            layRing(&mut w)
        }
    }
    updateSparks(&mut w, dt)
}

// Breaking the streak has to be felt, or the streak means nothing — this is the
// whole tension of the mode.
fn missRing(w: &mut World, i: i64) {
    w.rings[i].alive = false
    w.rings[i].pop = 0.0
    if w.combo > w.bestCombo {
        w.bestCombo = w.combo
    }
    // Any live streak breaking gets announced. Only telling the player above x3
    // meant the rule looked inconsistent from below.
    if w.combo > 0 {
        w.evMiss = true
        w.missFlash = 1.0
    }
    w.combo = 0
    w.comboPop = 0.0
    w.gainPop = 0.0
}

// A fountain of light off the landmark, thrown up and outward. Blue-white to
// match the beam that led you here, and slow enough to still be falling when the
// orbit has swung round to the far side of the subject.
fn burstAt(w: &mut World, x: f64, z: f64) {
    let base = solidAt(w.city, x, z, 60.0)
    for k in 0..150 {
        let a = w.rng.floatRange(0.0, TAU)
        // Biased steeply upward: a flat ring of sparks reads as an explosion, a
        // column reads as the beam itself coming apart.
        let spread = w.rng.floatRange(0.0, 1.0)
        let horiz = spread * spread * 190.0
        let life = w.rng.floatRange(1.4, 3.4)
        w.sparks.push(Spark {
            x: x + Math.sin(a) * horiz * 0.4,
            y: base + w.rng.floatRange(0.0, 90.0),
            z: z + Math.cos(a) * horiz * 0.4,
            vx: Math.sin(a) * horiz,
            vy: w.rng.floatRange(190.0, 430.0),
            vz: Math.cos(a) * horiz,
            life: life,
            maxLife: life,
            cr: 0.55 + w.rng.floatRange(0.0, 0.5),
            cg: 1.05 + w.rng.floatRange(0.0, 0.35),
            cb: 1.90,
        }
        )
    }
}

fn clearRing(w: &mut World, i: i64) {
    w.rings[i].alive = false
    w.rings[i].pop = 1.0
    // Over a real place a hoop means one thing: the landmark behind it has been
    // reached. Freeze and show it off rather than adding to a score.
    if w.city.loaded {
        w.showT = SHOW_LEN
        w.showLen = SHOW_LEN
        // The tour's last landmark carries the region sign-off as well, so its
        // shot runs long enough to hold both cards.
        w.lastFind = w.markFound + 1 >= w.marks.len
        if w.lastFind {
            w.showT = SHOW_LEN + SIGNOFF
        }
        w.showIdx = w.markIdx
        // Start the sweep exactly where the player is standing, not at due north.
        w.showAngle = Math.atan2(w.cam.x - w.marks[w.markIdx].x, w.cam.z - w.marks[w.markIdx].z)
        w.showFromX = w.cam.x
        w.showFromY = w.cam.y
        w.showFromZ = w.cam.z
        w.showFromYaw = w.cam.yaw
        w.showFromPitch = w.cam.pitch
        w.showFromRoll = w.cam.roll
        w.showFromFov = w.cam.fov
        w.marks[w.markIdx].found = true
        w.marks[w.markIdx].took = w.time - w.markStart
        w.foundTook = w.marks[w.markIdx].took
        w.foundPop = 1.0
        w.markFound += 1
        w.flash = Math.maxF64(w.flash, 1.0)
        w.shake = Math.maxF64(w.shake, 7.0)
        // Arriving used to be a white flash and a camera move. The fountain is
        // what makes it land: it goes off at the subject, so the thing the shot
        // is about is also the thing that erupts.
        burstAt(&mut w, w.marks[w.markIdx].x, w.marks[w.markIdx].z)
        w.evRegion = true
        w.evBonus = true
        return
    }
    w.combo += 1
    w.comboPop = 1.0
    w.cleared += 1
    if w.combo > w.bestCombo {
        w.bestCombo = w.combo
    }
    var worth = 50
    if w.rings[i].bonus {
        worth = 200
    }
    let gained = worth * Math.minI64(w.combo, 20)
    w.score += gained
    w.gain = gained
    w.gainPop = 1.0
    if w.score > w.best {
        w.best = w.score
    }
    w.flash = Math.maxF64(w.flash, 0.45)
    w.shake = Math.maxF64(w.shake, 4.0)
    if w.rings[i].bonus {
        w.evBonus = true
    } else {
        w.evRing = true
    }
    // A burst of sparks around the hoop, thrown outward in its plane and given
    // gravity, so the reward is something you fly through rather than a number.
    let nx = Math.sin(w.rings[i].face)
    let nz = Math.cos(w.rings[i].face)
    let tx = nz
    let tz = 0.0 - nx
    for k in 0..44 {
        let a = w.rng.floatRange(0.0, TAU)
        let sp = w.rng.floatRange(30.0, 130.0)
        let rr = w.rings[i].r
        let ox = tx * Math.cos(a) * rr
        let oy = Math.sin(a) * rr
        let oz = tz * Math.cos(a) * rr
        let life = w.rng.floatRange(0.5, 1.3)
        w.sparks.push(Spark {
            x: w.rings[i].x + ox,
            y: w.rings[i].y + oy,
            z: w.rings[i].z + oz,
            vx: tx * Math.cos(a) * sp + w.rng.floatRange(0.0 - 20.0, 20.0),
            vy: Math.sin(a) * sp + 40.0,
            vz: tz * Math.cos(a) * sp + w.rng.floatRange(0.0 - 20.0, 20.0),
            life: life,
            maxLife: life,
            cr: 1.7,
            cg: 1.25 + w.rng.floatRange(0.0, 0.4),
            cb: 0.30,
        }
        )
    }
    // Over a real place the course is a tour of that place and the aircraft
    // stays put. Being yanked to another city ten hoops into the Golden Gate run
    // is not progression, it is an interruption — LEFT / RIGHT move the place
    // now, so leaving is the player's call.
    if w.city.loaded {
        return
    }
    // Invented country still cycles: there, the region change IS the
    // progression, announced beforehand and crossfaded rather than snapped.
    w.toNext -= 1
    if w.toNext <= 0 {
        w.toNext = 10
        w.level += 1
        w.prevTheme = w.theme
        w.theme = nextTheme(w.theme)
        w.themeMix = 1.0
        rotatePlace(&mut w)
        w.banner = 3.4
        w.flash = 1.0
        w.shake = 9.0
        w.evRegion = true
    }
}

// Wingtip vortices: emitted faster the harder you are pulling, so a tight turn
// leaves a thick pair of ribbons and level flight leaves almost nothing.
fn updateTrails(w: &mut World, dt: f64) {
    var load = Math.abs(w.plane.roll) + Math.abs(w.plane.pitch) * 0.6
    if w.boosting {
        load += 1.6
    }
    w.trailTick = w.trailTick - dt * (6.0 + load * 26.0)
    if w.trailTick <= 0.0 {
        w.trailTick = 1.0
        let cy = Math.cos(w.plane.yaw)
        let sy = Math.sin(w.plane.yaw)
        let cp = Math.cos(w.plane.pitch)
        let sp = Math.sin(w.plane.pitch)
        let cr = Math.cos(w.plane.roll)
        let sr = Math.sin(w.plane.roll)
        let fx = sy * cp
        let fy = sp
        let fz = cy * cp
        let rx = cy * cr
        let ry = 0.0 - sr
        let rz = 0.0 - sy * cr
        let life = 0.8 + load * 0.9
        w.trailL.push(Trail {
            x: w.plane.x - fx * 4.0 - rx * 22.0, y: w.plane.y - fy * 4.0 - ry * 22.0, z: w.plane.z - fz * 4.0 - rz * 22.0, life: life
        }
        )
        w.trailR.push(Trail {
            x: w.plane.x - fx * 4.0 + rx * 22.0, y: w.plane.y - fy * 4.0 + ry * 22.0, z: w.plane.z - fz * 4.0 + rz * 22.0, life: life
        }
        )
    }
    ageTrail(&mut w.trailL, dt)
    ageTrail(&mut w.trailR, dt)
}

// A trail is a path, so it cannot be swap-removed — order IS the data. Compact
// the survivors forward in one pass instead: removing in place shifted the whole
// tail down per expiry, and since points expire in roughly the order they were
// laid, that was very nearly the whole buffer every frame.
//
// Not simply dropping a prefix: `life` varies with how hard the aircraft was
// pulling when the point was laid, so a later point can outlive an earlier one.
fn ageTrail(t: &mut Vec<Trail>, dt: f64) {
    var keep: i64 = 0
    for i in 0..t.len {
        t[i].life -= dt
        if t[i].life > 0.0 {
            if keep != i {
                t[keep] = t[i]
            }
            keep += 1
        }
    }
    while t.len > keep {
        let _ = t.pop()
    }
}

fn updateSparks(w: &mut World, dt: f64) {
    var i: i64 = 0
    while i < w.sparks.len {
        w.sparks[i].life -= dt
        if w.sparks[i].life <= 0.0 {
            let last = w.sparks.len - 1
            w.sparks[i] = w.sparks[last]
            let _ = w.sparks.pop()
        } else {
            w.sparks[i].vy = w.sparks[i].vy - 150.0 * dt
            let d = Math.pow(0.5, dt)
            w.sparks[i].vx *= d
            w.sparks[i].vz *= d
            w.sparks[i].x = w.sparks[i].x + w.sparks[i].vx * dt
            w.sparks[i].y = w.sparks[i].y + w.sparks[i].vy * dt
            w.sparks[i].z = w.sparks[i].z + w.sparks[i].vz * dt
            i += 1
        }
    }
}
