}

pub let W: i64 = 1280

pub let H: i64 = 720

pub let EPILOG: string = "built-in places (--place):
  sf          San Francisco — the Golden Gate, the bay, downtown
  manhattan   Manhattan — the densest skyline there is
  yosemite    Yosemite Valley — El Capitan, Half Dome, granite
  canyon      the Grand Canyon — no buildings at all, just the rock
  honolulu    Honolulu — a skyline with a volcano behind it, and reef below

controls:
  UP / DOWN                   pitch
  LEFT / RIGHT                bank
  SPACE                       afterburner — hold as long as you like
  ENTER                       fly somewhere else
  F                           fullscreen on / off
  M                           music on / off
  ESC                         quit

Up dives and down climbs, the way a stick works; --natural flips it.

Launched with no --place, --city or --procedural, FLYBY opens on a start screen
that asks where to fly; naming a place on the command line skips it.

Every place has five landmarks, listed down the right of the screen. A blue
column of light stands on the one you are looking for; fly over it at any
height and it is yours, timed and ticked off. Find all five and the next region
comes in. You cannot crash. Every place is baked into the binary, so nothing is
read or fetched while flying.

Terrain: NASA SRTM (public domain). Buildings and land cover:
(c) OpenStreetMap contributors, ODbL — openstreetmap.org/copyright."

// std/argparse owns --help, unknown flags and missing values, so the game does
// not grow its own half of a CLI parser.
fn parseOpts(): ParsedArgs {
    var p = ArgParser.new("flyby", "a 3D flying game written in Milo")
    p.addString("place", "P", "Which built-in place to fly (default: a different one each launch)", "")
    p.addString("city", "c", "Fly a .city asset from disk instead of a built-in place", "")
    p.addBool("procedural", "", "Fly the endless generated world instead of a real place")
    p.addBool("pro", "p", "Give back the bank axis on LEFT / RIGHT, and the corridor")
    p.addBool("natural", "n", "UP climbs (default is stick-style: UP dives, DOWN climbs)")
    p.addBool("fullscreen", "f", "Open filling the display (F toggles it while flying)")
    p.addBool("maximized", "m", "Open maximised rather than in a 1280x720 window")
    p.addBool("cpu", "", "Bloom and tone-map on the CPU instead of the GPU (they should look the same)")
    p.addString("scale", "s", "Scene resolution as a percent of the window (100 native, 200 supersampled, 0 auto)", "0")
    p.setEpilog(EPILOG)
    return p.parse()
}

pub let PLACES: string = "sf manhattan yosemite canyon honolulu"

// Every place is an @embedFile of the same bytes `--city` would read off disk,
// so the decoder cannot tell the difference. They cost about 3 MB of binary
// between them and buy a game that runs from anywhere with no asset directory
// beside it — and four landscapes instead of one.
//
// All four are embedded whichever this returns: @embedFile is resolved at
// compile time, so the branch picks bytes that are already in the binary.
fn placeBytes(name: &string): string {
    if name == "honolulu" {
        return @embedFile("cities/honolulu.city")
    }
    if name == "manhattan" {
        return @embedFile("cities/manhattan.city")
    }
    if name == "yosemite" {
        return @embedFile("cities/yosemite.city")
    }
    if name == "canyon" {
        return @embedFile("cities/canyon.city")
    }
    return @embedFile("cities/sf.city")
}

fn placeName(i: i64): string {
    if i == 1 {
        return "manhattan"
    }
    if i == 2 {
        return "yosemite"
    }
    if i == 3 {
        return "canyon"
    }
    if i == 4 {
        return "honolulu"
    }
    return "sf"
}

fn placeIndex(name: &string): i64 {
    for i in 0..PLACE_COUNT {
        if placeName(i) == name {
            return i
        }
    }
    return -1
}

// The aerial photograph for a built-in place, or "" if it has none yet. Same
// @embedFile story as the .city itself — resolved at compile time, so every arm
// is in the binary whichever this returns.
// Every place has one. That is why all five are in the United States: the open
// imagery that can be redistributed is USGS/USDA, and the global alternative
// (Sentinel-2 via EOX) serves JPEG, which nothing here can decode. Hong Kong and
// Rio were dropped rather than left as the only two flat-shaded places.
//
// Hawaii is US but not CONUS, so NAIP — a USDA farm survey — has nothing there;
// the drape comes off the USGS National Map basemap instead. See fetchcity.
fn orthoBytes(name: &string): string {
    if name == "honolulu" {
        return @embedFile("cities/honolulu.ortho.png")
    }
    if name == "manhattan" {
        return @embedFile("cities/manhattan.ortho.png")
    }
    if name == "yosemite" {
        return @embedFile("cities/yosemite.ortho.png")
    }
    if name == "canyon" {
        return @embedFile("cities/canyon.ortho.png")
    }
    return @embedFile("cities/sf.ortho.png")
}

fn parsePlace(name: &string): City {
    match cityParse(placeBytes(name)) {
        Result.Ok(city) => {
            var c = city
            let png = orthoBytes(name)
            if png != "" {
                match cityAttachOrtho(&mut c, png) {
                    Result.Ok(_) => {
                    }
                    Result.Err(e) => {
                        print("built-in place '" + name + "' has a bad ortho: " + e)
                    }
                }
            }
            return c
        }
        Result.Err(e) => {
            print("built-in place '" + name + "' is corrupt: " + e)
            return cityEmpty()
        }
    }
}

// Every built-in place, starting from `first` and wrapping. The world flies the
// head of this list and rotates the rest in, one per region change — so a run
// crosses four real places instead of mirroring one forever. Which one you
// start on comes off the wall clock, so two launches in a row are not the same
// flight.
fn allPlaces(first: i64): Vec<City> {
    var v: Vec<City> = Vec.new()
    for k in 0..PLACE_COUNT {
        v.push(parsePlace(placeName((first + k) % PLACE_COUNT)))
    }
    return v
}

// A .city file from disk, or an empty city (the procedural world) if it will
// not load. Only failure says anything on the terminal — the place's name is on
// the HUD the moment the window opens, which is where a player is looking.
fn loadFile(path: &string): City {
    match cityLoad(path) {
        Result.Ok(city) => {
            return city
        }
        Result.Err(e) => {
            print("could not load city: " + e)
            return cityEmpty()
        }
    }
}

// Which built-in place to open on, or -1 for "not a built-in place at all"
// (--procedural, or a --city asset from disk).
fn startIndex(o: &ParsedArgs): i64 {
    if o.getBool("procedural") {
        return -1
    }
    if (o.getString("city") ?? "") != "" {
        return -1
    }
    let want = o.getString("place") ?? ""
    if want == "" {
        // Open on San Francisco: it is the one with a landmark tour laid out.
        return placeIndex("sf")
    }
    let idx = placeIndex(want)
    if idx < 0 {
        print("no built-in place called '" + want + "' — try: " + PLACES)
        return -1
    }
    return idx
}

// Exactly one place is decoded at a time. Preloading all four held ~290 MB of
// parsed footprints and imagery and got the process killed by the run guard;
// decoding on the key press costs a beat and nothing else.
fn placesFor(o: &ParsedArgs, idx: i64): Vec<City> {
    var v: Vec<City> = Vec.new()
    if o.getBool("procedural") {
        v.push(cityEmpty())
        return v
    }
    let path = o.getString("city") ?? ""
    if path != "" {
        v.push(loadFile(path))
        return v
    }
    if idx < 0 {
        v.push(cityEmpty())
        return v
    }
    v.push(parsePlace(placeName(idx)))
    return v
}

pub fn main(): i32 {
    let o = parseOpts()
    var placeIdx = startIndex(o)
    let easy = !o.getBool("pro")
    let invert = !o.getBool("natural")
    if SDL_Init(SDL_INIT_VIDEO | SDL_INIT_AUDIO) != 0 {
        print("SDL_Init failed")
        return 1
    }
    // The 2D overlay's own canvas, at its own fixed resolution. The 3D scene
    // renders at the window's, which is a different and much larger number — that
    // separation is why a bigger window costs GPU time and no CPU time at all.
    var c = canvasNew(W, H)
    var s = sceneNew(W, H)
    // Scene resolution. `0` means pick one.
    //
    // Auto exists because the honest default on a retina panel is not 100. Every
    // heavy pass here is per-pixel, and a 2880x1864 drawable is 5.4 million of
    // them — measured at 68 ms a frame on this machine, which is not a frame rate.
    // Auto keeps roughly two megapixels, which is a sharp picture at a playable
    // speed; `--scale 100` gives back every pixel the display has.
    // Zero means "pick one" — `renderSize` decides, because it is the only place
    // that knows how big the drawable actually is.
    // getString is Option<string>. `scale` is registered with a default so it is always
    // Some, but a string is not Copy, so the value has to be moved out with a match
    // rather than unwrapOr'd.
    let renderPct = match o.getString("scale") {
        Option.Some(scaleArg) => parseInt(scaleArg) ?? 0
        Option.None => 0
    }
    var scr = match screenOpen("FLYBY — written in Milo", W, H, W, H, renderPct, o.getBool("fullscreen"), o.getBool("maximized")) {
        Result.Ok(opened) => opened
        Result.Err(e) => {
            print("SDL setup failed: " + e)
            return 2
        }
    }
    let _ = SDL_ShowCursor(0)
    // The procedural textures and the GPU renderer come up before the start
    // screen, because the start screen draws a sky and the sky is a GPU pass.
    let groundTex = groundTexture()
    let skinTex = planeTexture()
    let facadeTex = facadeTexture()
    var gw = match gpuWorldNew(&mut scr.gl, groundTex, skinTex, facadeTex) {
        Result.Ok(g) => g
        Result.Err(e) => {
            // No screenClose here: it consumes the Screen, and the checker then
            // has to assume it is gone on the path that continues. SDL_Quit tears
            // the context and the window down anyway, which is all this would do.
            print("gpu: " + e)
            SDL_Quit()
            return 2
        }
    }
    var inp = inputNew(invert)
    var ev: [u8; 64] = [0; 64]
    // Ask before decoding anything. A place costs a beat to parse and drape, and
    // spending it on San Francisco to then be asked which place you wanted is the
    // wrong order — `--place`, `--city` and `--procedural` all say the answer
    // already, so the screen only appears when nothing has.
    if placeIdx >= 0 && (o.getString("place") ?? "") == "" {
        let pick = chooseRegion(&mut scr, gw, &mut c, s, &mut inp, &mut ev, placeIdx)
        if pick < 0 {
            gpuWorldFree(&mut scr.gl, gw)
            screenClose(scr)
            SDL_Quit()
            return 0
        }
        placeIdx = pick
    }
    var places = placesFor(o, placeIdx)
    var w = worldIn(SEED, places, easy)
    // Before the window opens and long before the first frame: this is several
    // network round trips and nothing on the frame path may ever wait on a public
    // API. Every place visited afterwards refetches at the place change, which is
    // already a pause for decoding the next city.
    if envLiveRequested() {
        if envGoLive(&mut w.env, w.city.reach) {
            print("weather: " + envWeatherLabel(w.env))
            settleUnderCeiling(&mut w)
        } else {
            print("weather: fetch failed, using synthetic sky")
        }
    }
    if placeIdx >= 0 {
        w.nextName = placeTitle((placeIdx + 1) % PLACE_COUNT)
    }
    // The cover grid only changes when the place does, so it is built here and
    // re-uploaded on the swap rather than every frame — it is 14 MB for a 19 km
    // map, which is more than the whole HDR canvas.
    var cover = demHeights(w.city)
    var grid = CoverGrid {
        n: w.city.demN, x0: w.city.demX0, z0: w.city.demZ0, step: w.city.demStep, reach: w.city.reach
    }
    var coverDirty = true
    if w.city.orthoLoaded {
        setOrtho(&mut scr.gl, &mut gw, w.city.ortho)
    }
    var snd = soundNew()
    var full = o.getBool("fullscreen")
    var last = SDL_GetTicks()
    var fpsAccum: f64 = 0.0
    var fpsFrames: i64 = 0
    var fpsShown: i64 = 0

    while !inp.quit {
        let now = SDL_GetTicks()
        var dt = ((now - last) as f64) / 1000.0
        last = now
        if dt > 0.05 {
            dt = 0.05
        }
        if dt < 0.0005 {
            dt = 0.0005
        }
        pollInput(&mut inp, &mut ev)

        if inp.mute {
            musicToggle(&mut snd)
        }
        if inp.fullscreen {
            full = !full
            screenFullscreen(scr, full)
        }
        // Only in one-axis mode: with `--pro` these same keys are the bank axis
        // and stepping the world every time the player turned would be absurd.
        // Either the player asked for somewhere else, or the tour here is
        // finished and the world has asked for the next region. Same swap.
        var step = 0
        if easy && inp.placeStep != 0 {
            step = inp.placeStep
        }
        if w.evPlaceDone {
            step = 1
        }
        if step != 0 && placeIdx >= 0 {
            placeIdx = (placeIdx + step + PLACE_COUNT) % PLACE_COUNT
            worldSetPlace(&mut w, parsePlace(placeName(placeIdx)))
            cover = demHeights(w.city)
            grid = CoverGrid {
                n: w.city.demN, x0: w.city.demX0, z0: w.city.demZ0, step: w.city.demStep, reach: w.city.reach
            }
            coverDirty = true
            if w.city.orthoLoaded {
                setOrtho(&mut scr.gl, &mut gw, w.city.ortho)
            } else {
                clearOrtho(&mut scr.gl, &mut gw)
            }
            w.nextName = placeTitle((placeIdx + 1) % PLACE_COUNT)
        } else if w.evPlaceDone {
            resetTour(&mut w)
        }
        musicTick(snd)

        // Off the frame path in the sense that matters: this yields to the
        // fetching task and returns, it never waits on the network itself.
        envWeatherTick(&mut w.env, w.city.reach)
        worldUpdate(&mut w, dt, inp.moveX, inp.moveY, inp.boost)
        let view = viewOf(w.cam, c.w, c.h)
        // Bind the scene target and match it to the window before any geometry is
        // recorded, because the render size is what the projection is built from.
        let rs = screenBegin(&mut scr)
        drawWorld(&mut c, &mut s, w, groundTex, skinTex, facadeTex, view)
        // Record, upload once, then rasterise twice: from the sun, then from the
        // camera. The shadow pass binds its own framebuffer, so the scene target
        // has to be bound again before anything else is drawn.
        uploadStreams(&mut gw, &mut s)
        drawShadowPass(&mut gw, &mut s, view)
        screenRebind(scr)
        drawSkyPass(gw, s, view, rs.w as f64, rs.h as f64, w.time)
        drawStreams(&mut gw, &mut s, view, rs.w as f64, rs.h as f64, w.time)

        fpsAccum += dt
        fpsFrames += 1
        if fpsAccum > 0.5 {
            fpsShown = ((fpsFrames as f64) / fpsAccum) as i64
            fpsAccum = 0.0
            fpsFrames = 0
        }
        if w.evRing {
            playRing(snd)
        }
        if w.evBonus {
            playRingBonus(snd)
        }
        if w.evRegion {
            playRegion(snd)
        }
        if w.evBoost {
            playBoost(snd)
        }
        if w.evMiss {
            playMiss(snd)
        }
        drawSpeedLines(&mut c, w)
        drawGuide(&mut c, w, view)
        drawFence(&mut c, w, view)
        drawMarkBeam(&mut c, w, view)
        drawMarkGuide(&mut c, w, view)
        drawChecklist(&mut c, w)
        drawFound(&mut c, w)
        drawHud(&mut c, w, s, fpsShown)

        var exposure = 1.0
        if w.flash > 0.0 {
            exposure = 1.0 + w.flash * 0.8
        }
        // The sea only exists where the DEM says it does, and its camera is the
        // one the geometry was just drawn with.
        if w.env.cloudsDirty {
            screenSetClouds(scr, w.env.clouds)
            gpuWorldSetClouds(gw, w.env.clouds)
            w.env.cloudsDirty = false
        }
        screenPresent(&mut scr, &mut c, view, s, grid, cover, coverDirty, cityHasSea(w.city), w.time, 0.35, exposure)
        coverDirty = false
    }
    gpuWorldFree(&mut scr.gl, gw)
    screenClose(scr)
    SDL_Quit()
    return 0
}
