// The world, rasterised by the driver.
//
// Every triangle in the game — terrain, city blocks, bridge decks and cables,
// props, waterfalls, rings, the aircraft — already went through `gfx3d.triangleV`
// and `triangleG`, which never drew anything: they transformed, clipped and
// RECORDED. That recording used to be a command list for a scanline rasteriser
// running on N threads. It is now five vertex streams and five draw calls, and
// the two thousand lines of geometry above did not change at all.
//
// What the move buys, in order of how much it matters:
//
//   - The sky, the haze and the sea are the same function now (see sky.milo).
//     They could not be before: the haze was three constants because a per-pixel
//     sky was not affordable in a scanline loop.
//   - Depth is the driver's. Draw order stops mattering, which is what
//     let the second flush and the interleaving rules go away.
//   - Texturing is free, so the LOD dodges that existed to avoid it — a detail
//     texture that faded out past ring 7 and stopped entirely at ring 11 — are
//     gone, and the terrain keeps its grain to the horizon.
//   - Resolution stops being a frame-time decision. The scene renders at the
//     drawable size, and `--ss 2` renders it at twice that and downsamples.
//
// Streams are keyed by texture rather than by what the geometry is, because a
// draw call is a texture binding: `Texture.slot` says which of the five a
// triangle belongs to and everything with the same slot goes out together.

from "gl" import {
    GlContext, Gpu, Mesh, Shader, Texture2D, Wrap
}
from "./texture" import {
    SLOT_COUNT, SLOT_FACADE, SLOT_FALL, SLOT_GROUND, SLOT_NONE, SLOT_ORTHO,
    SLOT_SKIN, Texture
}
from "./gfx3d" import {
    Scene, View
}
from "std/math" import {
    Math
}
from "./sky" import {
    SKY_GLSL
}
from "./cloud" import {
    CLOUD_SHADOW_GLSL, CloudField, cloudEmpty, cloudUpload, cloudUpdate
}
from "./gpushadow" import {
    ShadowMap, SHADOW_SAMPLE_GLSL, SHADOW_EXTENT, SHADOW_DEPTH, lightMatrix, shadowNew, shadowFree
}

// Ten floats per vertex, laid out exactly as `texture.Vtx` declares them.
pub let VERTEX_FLOATS: i64 = 10

pub let WORLD_VERT: string = "#version 330 core
layout (location = 0) in vec3 aPos;
layout (location = 1) in vec2 aUv;
layout (location = 2) in float aLight;
layout (location = 3) in vec3 aTint;
layout (location = 4) in float aTw;

uniform mat4 uViewProj;

out vec2 vUv;
out float vLight;
out vec3 vTint;
out float vTw;
out float vDepth;
out vec3 vWorld;

void main() {
    vUv = aUv;
    vLight = aLight;
    vTint = aTint;
    vTw = aTw;
    vWorld = aPos;
    vec4 clip = uViewProj * vec4(aPos, 1.0);
    // The projection is built so that w IS camera-space depth along the view
    // axis — the same number the old rasteriser depth-tested on. That is what
    // lets the fragment shader hand it to the sea pass in the alpha channel
    // without reconstructing anything from a depth buffer.
    vDepth = clip.w;
    gl_Position = clip;
}
"

// Colour in rgb, camera-space depth in alpha.
//
// The alpha channel is the whole occlusion story for the passes downstream. The
// target is RGBA16F and nothing was using alpha; writing linear depth into it is
// free, exact, and saves attaching a depth texture the sea pass would then have
// to un-project. The sky pass writes 0 there, meaning "nothing is here".
// A function, not a global: the source is `SKY_GLSL` pasted into a body, and a
// global whose initializer concatenates another global is not a compile-time
// constant. Shaders are compiled once at startup, so the call costs nothing.
pub fn worldFrag(): string {
    return "#version 330 core
in vec2 vUv;
in float vLight;
in vec3 vTint;
in float vTw;
in float vDepth;
in vec3 vWorld;

out vec4 fragColor;

uniform sampler2D uTex;
uniform vec3 uEye;
uniform vec2 uFogRange;
"

    + SKY_GLSL + SHADOW_SAMPLE_GLSL + CLOUD_SHADOW_GLSL + "
uniform float uShadowAmb;   // how bright a shadowed surface is, against sunlit

void main() {
    // `tw` fades the detail texture toward 1.0, which is a no-op multiplier —
    // that is how terrain and water share one draw call, and how the untextured
    // stream works at all: it carries tw = 0 and never sees its white texture.
    // `vTw` is 0 untextured, 1 textured, 2 textured glass. See `prism`.
    float glass = clamp(vTw - 1.0, 0.0, 1.0);
    float tw = min(vTw, 1.0);
    vec3 texel = texture(uTex, vUv).rgb;
    vec3 albedo = vTint * mix(vec3(1.0), texel, tw);

    // `vLight` is `ambient + (1 - ambient) * NdotL`, baked per vertex, and those
    // two halves cannot be pulled apart again from the single scalar that
    // arrived. So shadow does not subtract a direct term — it swaps the LIGHT
    // SOURCE. A point the sun can see is lit by the sun; a point it cannot is lit
    // by the sky, which is dimmer and blue. That is what actually happens
    // outdoors, and it is the only form this can take without a sixth float per
    // vertex.
    // Two things can stand between this point and the sun: something solid, and
    // the weather. They multiply.
    float vis = sunVisibility(vWorld) * cloudSunlight(vWorld);
    vec3 sun = sunLight();
    vec3 lightCol = mix(sun * uShadowAmb * skyTint(), sun, vis);
    vec3 col = albedo * vLight * lightCol;

    // Aerial perspective, toward the sky THIS pixel is looking at rather than
    // toward a constant. A ridge against a bright horizon and the same ridge
    // against the blue overhead now fade into different colours, which is what
    // distance actually looks like and what one fog colour could never give.
    vec3 rd = normalize(vWorld - uEye);

    // Glass, which is to say: a mirror with a slight tint.
    //
    // A curtain wall is not a diffuse surface with windows drawn on it, and
    // lighting it as one is why every tower in this city read as an old concrete
    // block. What you actually see in one is the sky — pale near the horizon,
    // deep blue higher up, the sun where the angle happens to be right — and the
    // building's own colour is a minor correction on top.
    //
    // The normal comes from the screen-space derivatives of the world position
    // rather than from the vertex, because a vertex normal would be an eleventh
    // float through the whole pipeline to say something the rasteriser already
    // knows: two neighbouring fragments on a flat wall differ by exactly the two
    // tangents of that wall.
    if (glass > 0.001) {
        vec3 n = normalize(cross(dFdx(vWorld), dFdy(vWorld)));
        if (dot(n, -rd) < 0.0) { n = -n; }
        vec3 r = reflect(rd, n);
        // Never let the reflected ray point into the ground: a vertical wall
        // reflects almost horizontally, and half a degree of numerical noise
        // there swaps sky for dirt across a whole face.
        r.y = max(r.y, 0.015);
        vec3 mirrored = skyColor(r, true);
        // Schlick, with a floor. Glass at normal incidence still returns a few
        // percent, and at the grazing angles a street-level view is full of it
        // returns almost everything.
        float fres = 0.05 + 0.85 * pow(1.0 - clamp(dot(n, -rd), 0.0, 1.0), 4.0);
        col = mix(col, mirrored, clamp(fres, 0.0, 0.90) * glass);
    }

    col = aerial(col, rd, vDepth, uEye.y, vWorld.y);

    fragColor = vec4(col, vDepth);
}
"

}

// The sky, as one fullscreen quad behind everything.
//
// Depth-tested against nothing and written first, so the world draws over it.
// The ray is the inverse of the projection in `viewProj` — the same three camera
// axes, undone.
pub fn skyboxFrag(): string {
    return "#version 330 core
in vec2 vUv;
out vec4 fragColor;

uniform vec3 uRight;
uniform vec3 uUp;
uniform vec3 uFwd;
uniform vec2 uProj;
"

    + SKY_GLSL + "
void main() {
    float a = (vUv.x * 2.0 - 1.0) / uProj.x;
    float b = (vUv.y * 2.0 - 1.0) / uProj.y;
    vec3 rd = normalize(uRight * a + uUp * b + uFwd);
    // Alpha 0: no geometry here. The sea pass reads that as open sky.
    fragColor = vec4(skyColor(rd, true), 0.0);
}
"

}

// Falling water.
//
// A waterfall is the one thing in this world that a lit-surface shader cannot
// draw. It is translucent and gets less so as it falls; it is made of threads
// that move; it tears into spray on the way down and is pure spray by the time it
// lands; and lit from behind it glows rather than shading. Drawn as albedo times a
// Lambert term — which is what it was — it comes out as a flat white quad hanging
// on a cliff.
//
// So the vertex attributes mean different things in this stream, and the geometry
// that emits them (render3d.fallRibbon) knows it:
//
//   uv.x    across the ribbon, 0..1
//   uv.y    METRES fallen from the lip, not a 0..1 coordinate — threads have to
//           keep their real length whether the drop is 30 m or 700
//   light   how fast the water is moving here, 0..1
//   tint.x  the ribbon's width in metres, so the thread frequency is per-metre
//   tint.y  the total drop, for working out how far down this pixel is
//   tint.z  0 for the falling sheet, 1 for a spray puff
//   tw      extra atomisation, for the parts already breaking up at the lip
pub fn fallFrag(): string {
    return "#version 330 core
in vec2 vUv;
in float vLight;
in vec3 vTint;
in float vTw;
in float vDepth;
in vec3 vWorld;

out vec4 fragColor;

uniform vec3 uEye;
uniform vec2 uFogRange;
"

    + SKY_GLSL + "
// A rainbow, in the direction a rainbow actually is.
//
// Not decoration and not placed by hand: sunlight refracting through spray comes
// back at 42 degrees from the anti-solar point, which is why you only ever see one
// with the sun behind you. `cos(42 degrees)` is 0.743, so the arc appears exactly
// where the geometry says it should — fly around the fall and it swings round the
// plume on its own.
vec3 rainbow(vec3 rd) {
    float a = dot(rd, -uSun);
    float band = 1.0 - smoothstep(0.0, 0.030, abs(a - 0.743));
    if (band <= 0.0) { return vec3(0.0); }
    // Red outside, violet inside — the order refraction puts them in.
    float t = clamp((a - 0.713) / 0.060, 0.0, 1.0);
    vec3 c = vec3(
        smoothstep(0.15, 0.62, t),
        sin(clamp(t, 0.0, 1.0) * 3.14159),
        smoothstep(0.85, 0.35, t));
    // Only when the sun is up and reasonably strong.
    return c * band * clamp(uSun.y * 3.0, 0.0, 1.0);
}

void main() {
    vec3 rd = normalize(vWorld - uEye);
    float across = vUv.x;
    float fallen = vUv.y;
    float width = max(vTint.x, 1.0);
    float total = max(vTint.y, 1.0);
    bool spray = vTint.z > 0.5;

    // How far down the drop this pixel is, and how broken up the water is by the
    // time it gets here. Water leaves a lip as a coherent sheet and is mostly air
    // a couple of hundred metres later; that transition is the whole look.
    float down = clamp(fallen / total, 0.0, 1.0);
    float atomise = clamp(down * 1.45 + vTw * 0.6, 0.0, 1.0);

    vec3 col = vec3(0.0);
    float alpha = 0.0;

    if (spray) {
        // A puff of mist. `across`/`fallen` are -1..1 across the billboard here.
        float r = length(vec2(across, fallen));
        float soft = 1.0 - smoothstep(0.25, 1.0, r);
        if (soft <= 0.001) { discard; }
        // Turbulence, drifting upward, so the plume boils instead of sitting.
        float n = skyFbm(vec2(vWorld.x * 0.09 + uTime * 0.10,
                              vWorld.y * 0.09 - uTime * 0.55) * 2.0);
        n = 0.45 + 0.55 * n;
        alpha = soft * soft * n * 0.30 * vLight;
        // Mist is lit by the whole sky, not by a direction — it is a cloud a few
        // metres across. Backlit it glows, which is why the plume at the foot of a
        // fall is brightest when you are looking toward the sun.
        float back = pow(clamp(dot(rd, uSun), 0.0, 1.0), 2.0);
        col = skyColor(vec3(0.0, 1.0, 0.0), false) * 1.30
            + sunLight() * (0.55 + 1.60 * back);
        col += rainbow(rd) * 1.9 * soft;
    } else {
        // Threads. Noise stretched hard along the fall and scrolling down it, in
        // two bands at different rates so the sheet does not read as one texture
        // sliding. The frequency is per-metre, so a wide fall gets more threads
        // rather than wider ones.
        float speed = 20.0 + vLight * 42.0;
        vec2 p0 = vec2(across * width * 0.42, fallen * 0.16 - uTime * speed * 0.055);
        vec2 p1 = vec2(across * width * 1.15, fallen * 0.44 - uTime * speed * 0.115);
        float thread = skyFbm(p0) * 0.62 + skyFbm(p1) * 0.38;
        // Coherent water is a few wide bands; aerated water is many fine ones.
        float streak = mix(smoothstep(0.38, 0.72, thread),
                           smoothstep(0.14, 0.96, thread), atomise);

        // Feather the edges: a fall does not have a cut edge, it frays.
        float mid = abs(across - 0.5) * 2.0;
        float body = 1.0 - smoothstep(mix(0.80, 0.30, atomise), 1.0, mid);
        if (body <= 0.001) { discard; }

        // Glassy and see-through at the lip, dense and white at the bottom.
        alpha = body * (0.42 + 0.58 * streak) * mix(0.62, 1.0, down);

        // Water in free fall is white almost at once. The green-blue of deep
        // water only shows where there is depth to look through, and a sheet
        // coming off a lip has none — a photograph of Yosemite Falls is a white
        // thread against grey granite from the very top. The tint below is what
        // the water is BEFORE it aerates, and it survives only in the first few
        // metres and along the thin edges.
        vec3 glacial = vec3(0.62, 0.78, 0.86);
        vec3 aerated = vec3(1.35, 1.42, 1.48);
        col = mix(glacial, aerated, clamp(0.30 + atomise * 0.80 + streak * 0.35, 0.0, 1.0));
        col *= sunLight();

        // Forward scatter. Aerated water is a cloud, and a cloud lit from behind
        // glows — this is what stops a backlit fall reading as a grey stripe.
        float back = pow(clamp(dot(rd, uSun), 0.0, 1.0), 2.5);
        col += vec3(1.00, 0.95, 0.86) * back * 1.15 * atomise;

        // Individual droplets catching the sun. Rare and very bright, which is
        // what the bloom pass then turns into sparkle.
        float spark = pow(skyFbm(vec2(across * width * 4.0,
                                      fallen * 1.7 - uTime * speed * 0.42)), 11.0);
        col += vec3(2.6, 2.5, 2.3) * spark * atomise * clamp(uSun.y * 2.5, 0.0, 1.0);

        col += rainbow(rd) * atomise * 0.7;
    }

    // The same aerial perspective as everything else in the frame.
    col = aerial(col, rd, vDepth, uEye.y, vWorld.y);

    // Premultiplied, to match the blend the pass is drawn with.
    fragColor = vec4(col * alpha, alpha);
}
"

}

// Everything the GPU needs to draw a frame's geometry.
//
// One mesh per slot rather than one per draw: the streams are refilled and
// re-uploaded every frame with GL_STREAM_DRAW, which is the orphaning idiom —
// the driver hands back fresh storage instead of stalling on last frame's read.
pub struct GpuWorld {
    shader: Shader,
    fall: Shader,
    sky: Shader,
    quad: Mesh,
    meshNone: Mesh,
    meshGround: Mesh,
    meshSkin: Mesh,
    meshFacade: Mesh,
    meshOrtho: Mesh,
    meshFall: Mesh,
    // A single white texel, bound for the untextured stream. Cheaper than a
    // second shader and it can never be sampled anyway — those vertices carry
    // tw = 0, so the mix() weight on the texel is zero.
    white: Texture2D,
    ground: Texture2D,
    skin: Texture2D,
    facade: Texture2D,
    // The aerial drape arrives with a city and changes when the place does.
    ortho: Option<Texture2D>,
    shadow: ShadowMap,
    // A second copy of the weather grid, because the sea pass owns the one in
    // `Post` and both passes need it. It is 128x128 of three floats and it is
    // written only when a fetch lands, so the duplication costs 196 KB and no
    // per-frame work — considerably less than threading one texture through two
    // module boundaries and four call sites would cost in signatures.
    cloudTex: Texture2D,
}

pub fn gpuWorldNew(gl: &mut GlContext, ground: &Texture, skin: &Texture, facade: &Texture): Result<GpuWorld, string> {
    let shader = Shader.compile(&mut gl, WORLD_VERT, worldFrag())?
    // The same vertex shader: the attributes are the same ten floats, they just
    // mean different things downstream.
    let fall = Shader.compile(&mut gl, WORLD_VERT, fallFrag())?
    let sky = Shader.compile(&mut gl, QUAD_VERT_LOCAL, skyboxFrag())?
    var white: Vec<f32> = Vec.filled(3, 1.0)
    return Ok(GpuWorld {
        shader: shader,
        fall: fall,
        sky: sky,
        quad: Mesh.fullscreenQuad(&mut gl),
        meshNone: worldMesh(&mut gl),
        meshGround: worldMesh(&mut gl),
        meshSkin: worldMesh(&mut gl),
        meshFacade: worldMesh(&mut gl),
        meshOrtho: worldMesh(&mut gl),
        meshFall: worldMesh(&mut gl),
        white: Texture2D.rgb32f(&mut gl, 1, 1, white, false),
        ground: uploadTexture(&mut gl, ground),
        skin: uploadTexture(&mut gl, skin),
        facade: uploadTexture(&mut gl, facade),
        ortho: None,
        // 1024 over a 2.6 km square is 2.5 m a texel.
        //
        // It was 2048, on the reasoning that finer is better. What that missed is
        // that a shadow map is a FILL cost paid every frame: four megapixels of
        // it, and over Manhattan every one of those texels is overdrawn by a stack
        // of towers. Measured there, the shadow pass alone was 14 ms of a 36 ms
        // frame — more than a third of the budget for a buffer nobody looks at.
        // At half the side it is a quarter of the fill and costs about 2 ms, and
        // the shadows it casts are visibly the same: at this range what reads is
        // the PATTERN of shadow down the avenues, not its edge sharpness.
        shadow: shadowNew(&mut gl, 1024)?,
        cloudTex: cloudUpload(&mut gl, cloudEmpty()),
    })
}

// The fullscreen-quad vertex shader, restated rather than imported, because the
// sky pass needs `vUv` and the gl package's own `QUAD_VERT` is the same thing.
pub let QUAD_VERT_LOCAL: string = "#version 330 core
layout (location = 0) in vec2 aPos;
layout (location = 1) in vec2 aUv;
out vec2 vUv;
void main() {
    vUv = aUv;
    gl_Position = vec4(aPos, 0.0, 1.0);
}
"

fn worldMesh(gl: &mut GlContext): Mesh {
    var attrs: Vec<i64> = Vec.new()
    attrs.push(3) // position
    attrs.push(2) // uv
    attrs.push(1) // light
    attrs.push(3) // tint
    attrs.push(1) // texture weight
    return Mesh.new(&mut gl, attrs)
}

// A CPU texture becomes a GL one, once, at startup.
//
// The drape goes up as GL_SRGB8 and the procedural ones as float, which is not
// an arbitrary split: the drape's texels came off a PNG as sRGB bytes and the
// hardware decodes them exactly, before filtering. The procedural textures were
// computed in linear light and never had a byte form to decode.
//
// Mipmaps and anisotropy matter more here than anything else in this file. The
// old rasteriser sampled one texel per pixel with no filtering, which is why the
// detail texture had to be faded out by distance — drawn to the horizon it would
// have crawled. With a mip chain it settles, and the fade could be deleted.
fn uploadTexture(gl: &mut GlContext, t: &Texture): Texture2D {
    var tex = Texture2D.rgb32f(&mut gl, 1, 1, Vec.filled(3, 1.0), false)
    if t.byteSrc {
        tex = Texture2D.srgb8(&mut gl, t.w, t.h, t.pxu, true)
    } else {
        tex = Texture2D.rgb32f(&mut gl, t.w, t.h, t.px, true)
    }
    if t.mirror {
        tex.setWrap(Wrap.Mirror)
    } else {
        tex.setWrap(Wrap.Repeat)
    }
    tex.generateMipmaps()
    tex.setAnisotropy(16.0)
    return tex
}

// Hand the renderer this place's aerial photograph. Freeing the old one first is
// not optional — `Texture2D` is @noCopy and `free` consumes it, so the previous
// drape has to be taken out of the field before the new one goes in.
pub fn setOrtho(gl: &mut GlContext, g: &mut GpuWorld, t: &Texture) {
    match replace(g.ortho, None) {
        Some(old) => {
            old.free(&mut gl)
        }
        None => {
        }
    }
    g.ortho = Some(uploadTexture(&mut gl, t))
}

pub fn clearOrtho(gl: &mut GlContext, g: &mut GpuWorld) {
    match replace(g.ortho, None) {
        Some(old) => {
            old.free(&mut gl)
        }
        None => {
        }
    }
}

// World → clip, as one matrix.
//
// Built directly rather than as a view matrix times a projection matrix, because
// the projection is four non-zero entries and multiplying a mostly-empty 4x4 by
// hand is more code than folding it in. The rows are:
//
//   row0 = sx * right       row1 = sy * up
//   row2 = A * fwd + B      row3 = fwd
//
// with the translation of each being minus that axis dotted with the eye. `sx`
// and `sy` reproduce the old rasteriser's projection exactly — it wrote
// `sx = cx + camX*scale/camZ`, so the ndc form is `camX*scale/(camZ*w/2)`.
//
// Column-major, because that is the layout GLSL's `mat4` already has, so nothing
// transposes on the way in.
pub fn viewProj(v: &View, w: f64, h: f64): Vec<f32> {
    let s = projScale(v, w, h)
    let sx = s.x
    let sy = s.y
    let n = v.near
    let f = v.far
    let a = (f + n) / (f - n)
    let b = 0.0 - 2.0 * f * n / (f - n)

    let tr = 0.0 - v.right.dot(v.eye)
    let tu = 0.0 - v.up.dot(v.eye)
    let tf = 0.0 - v.fwd.dot(v.eye)

    var m: Vec<f32> = Vec.filled(16, 0.0)
    // col*4 + row
    m[0] = (sx * v.right.x) as f32
    m[4] = (sx * v.right.y) as f32
    m[8] = (sx * v.right.z) as f32
    m[12] = (sx * tr) as f32

    m[1] = (sy * v.up.x) as f32
    m[5] = (sy * v.up.y) as f32
    m[9] = (sy * v.up.z) as f32
    m[13] = (sy * tu) as f32

    m[2] = (a * v.fwd.x) as f32
    m[6] = (a * v.fwd.y) as f32
    m[10] = (a * v.fwd.z) as f32
    m[14] = (a * tf + b) as f32

    m[3] = v.fwd.x as f32
    m[7] = v.fwd.y as f32
    m[11] = v.fwd.z as f32
    m[15] = tf as f32
    return m
}

// The two projection scales, as one thing, because the sky pass and the sea pass
// both have to invert exactly what the geometry pass applied — and a ray
// reconstructed with a slightly different field of view is a sea that does not
// line up with the coast it is lapping against.
//
// `v.scale` is pixels per unit at unit depth for the OVERLAY's resolution, which
// is not the render target's. Dividing by `v.cy` cancels that out: the result is
// `1/tan(fov/2)`, which is resolution-free. Horizontal then follows from the
// render target's aspect, so widening the window widens the view rather than
// stretching it.
pub fn projScale(v: &View, w: f64, h: f64): Vec2 {
    let sy = v.scale / v.cy
    return Vec2 {
        x: sy * h / w, y: sy
    }
}

pub struct Vec2 {
    x: f64,
    y: f64,
}

// The sky, first, with depth writes off so it never occludes anything.
pub fn drawSkyPass(g: &GpuWorld, s: &Scene, v: &View, w: f64, h: f64, time: f64) {
    Gpu.depthTest(false)
    Gpu.depthWrite(false)
    Gpu.blendOff()
    g.sky.bind()
    g.sky.uniform3F("uRight", v.right.x, v.right.y, v.right.z)
    g.sky.uniform3F("uUp", v.up.x, v.up.y, v.up.z)
    g.sky.uniform3F("uFwd", v.fwd.x, v.fwd.y, v.fwd.z)
    let ps = projScale(v, w, h)
    g.sky.uniform2F("uProj", ps.x, ps.y)
    skyUniforms(g.sky, s, time)
    g.quad.draw()
}

// The world from the sun's point of view, into the shadow map.
//
// Runs before the camera pass and before the sky, and leaves the framebuffer
// rebound to whatever the caller was drawing into — the caller passes its own
// target back in, because this file has no idea whether the frame is going to
// the window or to an offscreen buffer.
//
// The square is centred AHEAD of the aircraft rather than under it. A shadow map
// centred on the camera spends half its texels behind the viewer, where nothing
// is drawn; pushing it forward by two thirds of its own radius puts the
// resolution where the city being looked at actually is.
pub fn drawShadowPass(g: &mut GpuWorld, s: &mut Scene, v: &View) {
    let cx = v.eye.x + v.fwd.x * SHADOW_EXTENT * 0.62
    let cz = v.eye.z + v.fwd.z * SHADOW_EXTENT * 0.62
    // Centred vertically on the ground rather than on the aircraft: the depth
    // range has to cover what casts, and what casts is the city, not the plane.
    let cy = 0.0

    // Snap the centre to whole texels along the light's own axes. Without this
    // the map shifts by a fraction of a texel every frame and every shadow edge
    // in the scene crawls and shimmers as the aircraft moves — which is far more
    // noticeable in motion than the shadows themselves are.
    let step = g.shadow.texelWorld * 2.0
    let sx = Math.floor(cx / step) * step
    let sz = Math.floor(cz / step) * step

    g.shadow.mat = lightMatrix(s.sunX, s.sunY, s.sunZ, sx, cy, sz, SHADOW_EXTENT, SHADOW_DEPTH)

    g.shadow.target.bind()
    // Far away, in the encoding the fragment shader writes: 1.0 is "nothing
    // between here and the sun", so an untouched texel has to read as lit.
    Gpu.clear(1.0, 0.0, 0.0, 1.0, true)
    Gpu.depthTest(true)
    Gpu.depthWrite(true)
    Gpu.blendOff()
    // Front faces only would halve the work and is the usual trick, but this
    // world is not closed — terrain quads and bridge decks are single-sided —
    // so culling here drops real casters.
    Gpu.cullBackFaces(false)

    g.shadow.shader.bind()
    g.shadow.shader.uniformMat4("uLightVP", g.shadow.mat)
    drawMesh(g, s, SLOT_NONE)
    drawMesh(g, s, SLOT_GROUND)
    drawMesh(g, s, SLOT_FACADE)
    drawMesh(g, s, SLOT_ORTHO)
    drawMesh(g, s, SLOT_SKIN)
}

// Bind the finished shadow map and everything needed to read it.
fn shadowUniforms(g: &GpuWorld, sh: &Shader, s: &Scene) {
    g.shadow.target.bindTexture(1)
    sh.uniformI("uShadowTex", 1)
    sh.uniformMat4("uLightVP", g.shadow.mat)
    sh.uniformF("uShadowTexel", 1.0 / (g.shadow.size as f64))
    // The bias is in light-clip z, where the whole range spans 2 * SHADOW_DEPTH
    // metres. Scaled by texel size because that is what sets how far a sloped
    // surface can drift within one texel — a fixed bias that works on a roof
    // stripes a hillside.
    sh.uniformF("uShadowBias", 2.5 * g.shadow.texelWorld / (2.0 * SHADOW_DEPTH))
    // A shadow lit only by the sky, at about a fifth of full sun. Measured
    // outdoor ratios run from a tenth to a third depending on how much sky the
    // surface can see; a city street sees a strip of it, a roof sees all of it,
    // and one number has to stand in for both.
    sh.uniformF("uShadowAmb", 0.30)
    // Below the horizon there is no sun to be shadowed from, and the map is full
    // of garbage from a light direction pointing into the ground.
    if s.sunY > 0.02 {
        sh.uniformF("uShadowOn", 1.0)
    } else {
        sh.uniformF("uShadowOn", 0.0)
    }
}

// Everything recorded this frame, in five draws.
pub fn drawStreams(g: &mut GpuWorld, s: &mut Scene, v: &View, w: f64, h: f64, time: f64) {
    Gpu.depthTest(true)
    Gpu.depthWrite(true)
    Gpu.blendOff()
    // No back-face culling. The world is not a closed solid — terrain quads,
    // bridge cables, ring bands and waterfall ribbons are all single-sided
    // surfaces meant to be seen from either side, and the old rasteriser drew
    // them whichever way they wound.
    Gpu.cullBackFaces(false)

    g.shader.bind()
    let m = viewProj(v, w, h)
    g.shader.uniformMat4("uViewProj", m)
    g.shader.uniform3F("uEye", v.eye.x, v.eye.y, v.eye.z)
    g.shader.uniform2F("uFogRange", s.fogStart, s.fogEnd)
    g.shader.uniformI("uTex", 0)
    skyUniforms(g.shader, s, time)
    shadowUniforms(g, g.shader, s)
    g.cloudTex.bind(2)
    g.shader.uniformI("uCloudTex", 2)
    g.shader.uniformF("uCloudBase", s.cloudBase)
    g.shader.uniformF("uCloudTopMax", s.cloudTopMax)
    g.shader.uniformF("uCloudReach", s.cloudReach)
    g.shader.uniformF("uCloudOn", s.cloudOn)

    drawSlot(&mut g, &mut s, SLOT_NONE)
    drawSlot(&mut g, &mut s, SLOT_GROUND)
    drawSlot(&mut g, &mut s, SLOT_FACADE)
    drawSlot(&mut g, &mut s, SLOT_ORTHO)
    drawSlot(&mut g, &mut s, SLOT_SKIN)

    // Water last, and translucent.
    //
    // Depth TEST on so a cliff in front of the fall still hides it; depth WRITE
    // off so the sheet does not occlude the spray drifting in front of it, and so
    // two layers of the same plume both contribute. That is the standard
    // arrangement for transparency and the reason it has to come after every
    // opaque draw rather than being just another slot in the list.
    if s.streams[SLOT_FALL].len > 0 {
        Gpu.depthWrite(false)
        Gpu.blendPremultiplied()
        g.fall.bind()
        g.fall.uniformMat4("uViewProj", m)
        g.fall.uniform3F("uEye", v.eye.x, v.eye.y, v.eye.z)
        g.fall.uniform2F("uFogRange", s.fogStart, s.fogEnd)
        skyUniforms(g.fall, s, time)
        g.meshFall.upload(s.streams[SLOT_FALL])
        g.meshFall.draw()
        Gpu.blendOff()
        Gpu.depthWrite(true)
    }
}

// Upload every stream once per frame.
//
// Split out from drawing because the geometry is now rasterised TWICE — once
// from the sun into the shadow map, once from the camera — and re-uploading the
// same few megabytes between the two passes is pure waste. The shadow pass runs
// first and this runs before it.
pub fn uploadStreams(g: &mut GpuWorld, s: &mut Scene) {
    if s.streams[SLOT_NONE].len > 0 {
        g.meshNone.upload(s.streams[SLOT_NONE])
    }
    if s.streams[SLOT_GROUND].len > 0 {
        g.meshGround.upload(s.streams[SLOT_GROUND])
    }
    if s.streams[SLOT_FACADE].len > 0 {
        g.meshFacade.upload(s.streams[SLOT_FACADE])
    }
    if s.streams[SLOT_ORTHO].len > 0 {
        g.meshOrtho.upload(s.streams[SLOT_ORTHO])
    }
    if s.streams[SLOT_SKIN].len > 0 {
        g.meshSkin.upload(s.streams[SLOT_SKIN])
    }
}

fn drawMesh(g: &GpuWorld, s: &Scene, slot: i64) {
    if s.streams[slot].len == 0 {
        return
    }
    if slot == SLOT_NONE {
        g.meshNone.draw()
    } else if slot == SLOT_GROUND {
        g.meshGround.draw()
    } else if slot == SLOT_FACADE {
        g.meshFacade.draw()
    } else if slot == SLOT_ORTHO {
        g.meshOrtho.draw()
    } else {
        g.meshSkin.draw()
    }
}

fn drawSlot(g: &mut GpuWorld, s: &mut Scene, slot: i64) {
    if s.streams[slot].len == 0 {
        return
    }
    bindSlot(g, slot)
    drawMesh(g, s, slot)
}

fn bindSlot(g: &GpuWorld, slot: i64) {
    if slot == SLOT_GROUND {
        g.ground.bind(0)
    } else if slot == SLOT_FACADE {
        g.facade.bind(0)
    } else if slot == SLOT_SKIN {
        g.skin.bind(0)
    } else if slot == SLOT_ORTHO {
        match g.ortho {
            Some(t) => {
                t.bind(0)
            }
            None => {
                g.white.bind(0)
            }
        }
    } else {
        g.white.bind(0)
    }
}

// The four uniforms `SKY_GLSL` declares. Every shader that pastes it needs all
// four set, and a shader that got three of them right is a sea lit by a
// different sun than the sky above it — which is invisible in a diff and obvious
// on screen. One function, called from every bind site.
pub fn skyUniforms(sh: &Shader, s: &Scene, time: f64) {
    sh.uniform3F("uSun", s.sunX, s.sunY, s.sunZ)
    sh.uniformF("uTime", time)
    sh.uniformF("uTurbidity", s.turbidity)
    sh.uniformF("uCloud", s.cloud)
    sh.uniformF("uHaze", s.haze)
}

// Push a new weather field to the geometry pass's copy.
pub fn gpuWorldSetClouds(g: &GpuWorld, f: &CloudField) {
    cloudUpdate(g.cloudTex, f)
}

pub fn gpuWorldFree(gl: &mut GlContext, g: GpuWorld) {
    var own = g
    // The drape lives in an Option and `free` consumes it, so it has to come out
    // of the field first — a borrow cannot hand over a @noCopy handle.
    match replace(own.ortho, None) {
        Some(t) => {
            t.free(&mut gl)
        }
        None => {
        }
    }
    own.cloudTex.free(&mut gl)
    shadowFree(&mut gl, own.shadow)
    own.shader.free(&mut gl)
    own.fall.free(&mut gl)
    own.sky.free(&mut gl)
    own.quad.free(&mut gl)
    own.meshNone.free(&mut gl)
    own.meshGround.free(&mut gl)
    own.meshSkin.free(&mut gl)
    own.meshFacade.free(&mut gl)
    own.meshOrtho.free(&mut gl)
    own.meshFall.free(&mut gl)
    own.white.free(&mut gl)
    own.ground.free(&mut gl)
    own.skin.free(&mut gl)
    own.facade.free(&mut gl)
}
