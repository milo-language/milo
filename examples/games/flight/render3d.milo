// Drawing the flight world: sky, terrain, coins, the aircraft, and the HUD.

from "std/math" import {
    Math
}
from "./gfx" import {
    Canvas, fillRect, shadeRect, spot, line, thickLine, darkLine, text, textCentered, textWidth
}
// Small by-value carrier. Returning a Vec<i64> from this allocated once per
// terrain quad per frame — a few thousand mallocs a frame, and most of the
// frame time.
pub struct Off {
    x: i64,
    z: i64,
}

from "./gfx3d" import {
    Vec3,
    Scene, View, Camera, viewOf, sceneClear, triangle, shade, toCamera,
    triangleV, triangleG, triangleF, farOf
}
from "./texture" import {
    Texture, Vtx, vtxC
}
from "./textures" import {
    groundTexture, planeTexture, facadeTexture
}
from "./plane" import {
    drawAirframe
}
from "./live" import {
    envWeatherLabel, envStamp
}
from "./world3d" import {
    World, Trail, Theme, nextTheme, heightAt, coverAt, blockOf, foldIn, unfold, TILE, VIEW_TILES, TAU, MARK_REACH,
    fmtTime, fenceK, FENCE_SOFT, terrainTile
}
from "./city" import {
    City, COVER_URBAN, COVER_PARK, COVER_SAND, COVER_WATER, BUILDING_MARGIN, cityCellX, cityCellZ, cityOrthoLocal,
    cityRoofKind, cityRoofHeight, cityBase, ROOF_FLAT, ROOF_PYRAMIDAL, ROOF_DOME, ROOF_HIPPED, ROOF_GABLED
}

pub fn themeName(t: Theme): string {
    match t {
        Theme.Coast => {
            return "COASTLINE"
        }
        Theme.Desert => {
            return "DESERT"
        }
        Theme.Forest => {
            return "FOREST"
        }
        Theme.City => {
            return "CITY"
        }
    }
}

// The atmosphere of one region: what the fog is made of, how far you can see
// through it, and where the sun sits. This used to be three functions — one for
// fog colour, one for fog distance, one for colour AND sun — which meant the
// same four fog colours were typed out twice and the distances rode in an `Rgb`
// with `r`=start, `g`=end and `b` carrying nothing. Worse, only the fog
// crossfaded between regions; the sun jumped, because the function that set it
// was called first and then overwritten.
pub struct Weather {
    // What the air DOES, not what colour it is. A region used to carry three fog
    // constants and the terrain faded into them; now it carries how thick the
    // haze is and how much cloud is in it, and sky.skyColor turns that into a
    // colour per direction. Sunrise over a hazy coast and noon over a clear
    // desert used to need the same three numbers to mean two different things.
    turbidity: f64,
    cloud: f64,
    // Fog distance is the weather: the coast is hazy, the desert is glass-clear,
    // the forest sits in the middle, the city is smogged in.
    fogStart: f64,
    fogEnd: f64,
    sunX: f64,
    sunY: f64,
    sunZ: f64,
}

fn weatherOf(t: Theme): Weather {
    if (t as i32) == (Theme.Desert as i32) {
        return Weather { // desert: see forever, and almost nothing in the sky
            turbidity: 0.16, cloud: 0.10,
            fogStart: 1100.0, fogEnd: 3200.0,
            sunX: 0.30, sunY: 0.90, sunZ: 0.30,
        }
    }
    if (t as i32) == (Theme.Forest as i32) {
        return Weather { // forest: some haze, broken cloud
            turbidity: 0.42, cloud: 0.45,
            fogStart: 620.0, fogEnd: 1900.0,
            sunX: 0.50, sunY: 0.72, sunZ: 0.48,
        }
    }
    if (t as i32) == (Theme.City as i32) {
        return Weather { // city: smog, and a lid on it
            turbidity: 0.78, cloud: 0.55,
            fogStart: 380.0, fogEnd: 1300.0,
            sunX: 0.40, sunY: 0.84, sunZ: 0.36,
        }
    }
    return Weather { // coast: sea haze under a big sky
        turbidity: 0.38, cloud: 0.35,
        fogStart: 560.0, fogEnd: 1700.0,
        sunX: 0.44, sunY: 0.78, sunZ: 0.44,
    }
}

// Hand the weather volume's geometry to the renderer.
//
// Only the scalars: the grid itself lives on the GPU and is uploaded when it
// changes, not per frame.
pub fn applyClouds(s: &mut Scene, w: &World) {
    s.cloudBase = w.env.clouds.baseM
    s.cloudTopMax = w.env.clouds.topMaxM
    s.cloudReach = w.env.clouds.reach
    s.cloudDens = 1.0
    s.cloudWindX = w.env.clouds.windX
    s.cloudWindZ = w.env.clouds.windZ
    // The slab only reaches the ground where rain is actually falling somewhere
    // on the map; extending it costs march resolution in the cloud above.
    s.rainPeak = 0.0
    // The same threshold the HUD uses to say RAIN. They disagreed: below 0.02 the
    // label stayed off while the volume still reached the ground, so a map with a
    // trace of echo rendered shafts under a sky it was calling dry.
    if w.env.rainFrac > 0.02 {
        s.rainPeak = w.env.rainPeak
    }
    if w.env.clouds.valid {
        s.cloudOn = 1.0
    } else {
        s.cloudOn = 0.0
    }
}

// Cross the whole atmosphere from region `a` to region `b` as one value, so
// nothing can be left behind mid-fade. `mix` is 1 at the old region, 0 at the new.
pub fn applyWeather(s: &mut Scene, a: Theme, b: Theme, mix: f64) {
    let wa = weatherOf(a)
    let wb = weatherOf(b)
    s.turbidity = wb.turbidity + (wa.turbidity - wb.turbidity) * mix
    s.cloud = wb.cloud + (wa.cloud - wb.cloud) * mix
    // The invented regions never had a visibility of their own, so derive one
    // from how thick their air already says it is.
    s.haze = 0.00009 + s.turbidity * 0.00034
    s.fogStart = wb.fogStart + (wa.fogStart - wb.fogStart) * mix
    s.fogEnd = wb.fogEnd + (wa.fogEnd - wb.fogEnd) * mix
    // The sun is a direction, so it has to come back off the lerp normalised —
    // a shortened sun vector is a dimmer sun, which is not what a crossfade means.
    let sx = wb.sunX + (wa.sunX - wb.sunX) * mix
    let sy = wb.sunY + (wa.sunY - wb.sunY) * mix
    let sz = wb.sunZ + (wa.sunZ - wb.sunZ) * mix
    let l = Math.sqrt(sx * sx + sy * sy + sz * sz) + 0.000001
    s.sunX = sx / l
    s.sunY = sy / l
    s.sunZ = sz / l
}

// How many tiles are on the perimeter of ring `r` (ring 0 is the single centre).
// How many rings of the near field are drawn at half tile size. Nine rings is
// about a kilometre, which is the range at which a 110 m quad starts to show.
pub let FINE_RINGS: i64 = 9

// Rings drawn at a QUARTER tile, inside the half-tile ones.
//
// The half-tile grid puts a corner every 55 m and the elevation data has a post
// every 30 m, so it samples a little over half of what is there — which is
// invisible over rolling ground and is exactly wrong on the thing worth flying
// to. Yosemite's walls and the Grand Canyon's rim are near-vertical steps in the
// data, and a mesh that steps over every other post rounds them into slopes.
//
// A quarter tile is 27.5 m, finer than the data, so nothing is skipped. It is
// only the three rings you are sitting on: 25 tiles becoming 400 quads instead of
// 100, about six hundred extra triangles, which is nothing against the twelve
// thousand a city already costs.
pub let VFINE_RINGS: i64 = 3

pub fn ringCount(r: i64): i64 {
    if r == 0 {
        return 1
    }
    return 8 * r
}

// The `i`th tile offset around ring `r`, walking the square perimeter.
pub fn ringOffset(r: i64, i: i64): Off {
    if r == 0 {
        return Off {
            x: 0, z: 0
        }
    }
    let side = 2 * r
    let seg = i / side
    let k = i % side
    if seg == 0 {
        return Off {
            x: 0 - r + k, z: 0 - r
        }
    }
    if seg == 1 {
        return Off {
            x: r, z: 0 - r + k
        }
    }
    if seg == 2 {
        return Off {
            x: r - k, z: r
        }
    }
    return Off {
        x: 0 - r, z: r - k
    }
}

// ── smooth terrain colour ─────────────────────────────────────────────────────
//
// Every one of these is a CONTINUOUS function of world position. That is the
// whole point: terrain colour used to be evaluated once per quad from the quad's
// average height, so two quads sharing an edge could land on opposite sides of a
// "sand vs grass" threshold and the seam between them drew a hard 44-unit line.
// Enough of those and the landscape is a checkerboard. Sampling per *corner* is
// only half the fix — the function being sampled has to be smooth too, or the
// step just moves from the quad edge to the middle of the quad.

fn smoothstep(e0: f64, e1: f64, x: f64): f64 {
    var t = (x - e0) / (e1 - e0)
    if t < 0.0 {
        t = 0.0
    }
    if t > 1.0 {
        t = 1.0
    }
    return t * t * (3.0 - 2.0 * t)
}

// Value noise on the integer lattice, smoothstep-interpolated. `propHash` alone
// is white noise — used per tile it paints the grid it is meant to hide.
fn noise2(x: f64, z: f64): f64 {
    let xi = Math.floor(x)
    let zi = Math.floor(z)
    let fx = x - xi
    let fz = z - zi
    let ix = xi as i64
    let iz = zi as i64
    let ux = fx * fx * (3.0 - 2.0 * fx)
    let uz = fz * fz * (3.0 - 2.0 * fz)
    let n00 = propHash(ix, iz)
    let n10 = propHash(ix + 1, iz)
    let n01 = propHash(ix, iz + 1)
    let n11 = propHash(ix + 1, iz + 1)
    let a = n00 + (n10 - n00) * ux
    let b = n01 + (n11 - n01) * ux
    return a + (b - a) * uz
}

// The same palette as `themedColor`, with every hard threshold replaced by a
// blend band. Widths are chosen so a transition spans several quads.
fn themedSmooth(theme: Theme, h: f64, slope: f64): Rgb {
    if (theme as i32) == (Theme.Desert as i32) {
        // desert: sand, red rock on the steep faces
        let sand = rgb(0.72, 0.58, 0.32)
        let rock = rgb(0.46, 0.24, 0.14)
        return sand.lerp(rock, smoothstep(0.44, 0.64, slope))
    }
    if (theme as i32) == (Theme.Forest as i32) {
        // forest: deep greens, rock on the steep parts, no snow
        let low = rgb(0.09, 0.26, 0.10)
        let high = rgb(0.16, 0.30, 0.16)
        let rock = rgb(0.26, 0.24, 0.22)
        var col = low.lerp(high, smoothstep(130.0, 172.0, h))
        return col.lerp(rock, smoothstep(0.50, 0.70, slope))
    }
    if (theme as i32) == (Theme.City as i32) {
        // city: concrete, grey-green parks, tarmac in place of water
        let park = rgb(0.22, 0.26, 0.22)
        let slab = rgb(0.34, 0.34, 0.36)
        let wall = rgb(0.24, 0.24, 0.26)
        var col = park.lerp(slab, smoothstep(70.0, 110.0, h))
        return col.lerp(wall, smoothstep(0.40, 0.60, slope))
    }
    // coastline: sand, grass, rock, snow. Water is not in here — it is shaded
    // separately in `cornerAt`, because it needs the view direction.
    let sand = rgb(0.62, 0.55, 0.34)
    let grass = rgb(0.16, 0.36, 0.14)
    let rock = rgb(0.34, 0.31, 0.30)
    let snow = rgb(0.82, 0.86, 0.92)
    var col = sand.lerp(grass, smoothstep(9.0, 26.0, h))
    // rock takes over on the steep parts, and with altitude
    let rocky = Math.maxF64(smoothstep(0.50, 0.70, slope), smoothstep(112.0, 146.0, h))
    col = col.lerp(rock, rocky)
    return col.lerp(snow, smoothstep(150.0, 182.0, h))
}

// Gradient magnitude of the seabed, ignoring the wave train — how steeply the
// land goes under. Used to tell a beach from a flat shallow pan.
fn bedSlope(cc: &City, x: f64, z: f64): f64 {
    let e = 9.0
    let dx = heightAt(cc, x + e, z) - heightAt(cc, x - e, z)
    let dz = heightAt(cc, x, z + e) - heightAt(cc, x, z - e)
    return Math.sqrt(dx * dx + dz * dz) / (2.0 * e)
}

// Ground colour over a real city. The land-cover grid decides, not the height:
// a park and the block next to it sit at the same elevation, so the
// height-banded palette that reads a coastline correctly paints Golden Gate
// Park as beach. Slope still gets a say — SF's hills are steep enough that the
// scarps want to read as rock however they are zoned.
fn cityGround(w: &World, x: f64, z: f64, slope: f64): Rgb {
    let cv = coverAt(w.city, x, z)
    var base = rgb(0.30, 0.29, 0.28)
    if cv == COVER_PARK {
        base = rgb(0.11, 0.29, 0.11)
    } else if cv == COVER_SAND {
        base = rgb(0.62, 0.56, 0.40)
    } else if cv == COVER_WATER {
        base = rgb(0.05, 0.20, 0.30)
    } else {
        // Built ground is not one grey. A slow field mottles it into districts,
        // which is what stops a whole city from looking like poured concrete.
        let m = noise2(x * 0.004, z * 0.004)
        base = rgb(0.20, 0.20, 0.22).lerp(rgb(0.29, 0.29, 0.30), m)
    }
    let rock = smoothstep(0.42, 0.85, slope)
    return base.lerp(rgb(0.31, 0.29, 0.27), rock)
}

// One terrain grid corner: height, its own light term, and its own colour. The
// tile loop reads four of these per quad and hands them to the rasteriser as
// vertex attributes, so a shared edge is shaded identically from both sides.
pub struct Corner {
    h: f64,
    lt: f64,
    r: f64,
    g: f64,
    b: f64,
    tw: f64, // detail-texture weight: 1 on land, 0 on open water
}

// Memo over the visible corner grid. Four quads meet at every interior corner,
// so without this the surface is evaluated four times per corner per frame.
pub struct Corners {
    n: i64,
    baseX: i64,
    baseZ: i64,
    // Grid spacing and the index of the centre, so one cache type serves both the
    // coarse grid and the half-size one drawn over the near field.
    tile: f64,
    half: i64,
    // The two grid lines where this mesh butts onto a coarser one, in the same
    // units as baseX/baseZ. Equal (or hi < lo) on a mesh with no such boundary.
    snapLo: i64,
    snapHi: i64,
    ok: Vec<bool>,
    h: Vec<f64>,
    lt: Vec<f64>,
    r: Vec<f64>,
    g: Vec<f64>,
    b: Vec<f64>,
    tw: Vec<f64>,
}

fn cornersNew(baseX: i64, baseZ: i64, tile: f64, half: i64, snapLo: i64, snapHi: i64): Corners {
    let n = 2 * half + 2
    return Corners {
        n: n,
        baseX: baseX,
        baseZ: baseZ,
        tile: tile,
        half: half,
        snapLo: snapLo,
        snapHi: snapHi,
        ok: Vec.filled(n * n, false),
        h: Vec.filled(n * n, 0.0),
        lt: Vec.filled(n * n, 0.0),
        r: Vec.filled(n * n, 0.0),
        g: Vec.filled(n * n, 0.0),
        b: Vec.filled(n * n, 0.0),
        tw: Vec.filled(n * n, 1.0),
    }
}

fn cornerAt(cc: &mut Corners, s: &Scene, w: &World, ix: i64, iz: i64): Corner {
    let i = iz * cc.n + ix
    if !cc.ok[i] {
        let x = ((cc.baseX + ix - cc.half) as f64) * cc.tile
        let z = ((cc.baseZ + iz - cc.half) as f64) * cc.tile
        var h = surfaceAt(w.city, x, z, w.time)
        // Where the fine grid meets the coarse one, a fine corner sitting halfway
        // along a coarse edge has no vertex to match on the other side: the coarse
        // quad interpolates straight across it, and wherever the ground does not,
        // the two edges part company and you see daylight through the seam. Snapped
        // to the average of its two neighbours, which is exactly what the coarse
        // edge does, the crack cannot open. Only the boundary ring is affected;
        // everywhere else the fine mesh follows the terrain.
        if cc.snapHi > cc.snapLo {
            let ax = ix - cc.half
            let az = iz - cc.half
            let onZ = az == cc.snapLo || az == cc.snapHi
            let onX = ax == cc.snapLo || ax == cc.snapHi
            if onZ && ax % 2 != 0 {
                h = (surfaceAt(w.city, x - cc.tile, z, w.time) + surfaceAt(w.city, x + cc.tile, z, w.time)) * 0.5
            } else if onX && az % 2 != 0 {
                h = (surfaceAt(w.city, x, z - cc.tile, w.time) + surfaceAt(w.city, x, z + cc.tile, w.time)) * 0.5
            }
        }
        let nrm = normalAt(w.city, x, z, w.time)
        let slope = 1.0 - nrm.y
        var col = themedSmooth(w.theme, h, slope)
        if w.city.loaded {
            col = cityGround(w, x, z, slope)
        } else if w.themeMix > 0.0 {
            col = col.lerp(themedSmooth(w.prevTheme, h, slope), w.themeMix)
        }
        // Two low-frequency fields break up the flat wash. Both are smooth in
        // world space, so neither can reintroduce a tile edge.
        let det = 0.86 + 0.28 * noise2(x * 0.013, z * 0.013)
        let band = 0.94 + 0.12 * Math.sin(h * 0.09)
        var lt = shade(s, nrm.x, nrm.y, nrm.z, 0.34)
        var tw = 1.0
        if w.city.loaded {
            tw = 0.45
        }
        var rr = col.r * det * band
        var gg = col.g * det * band
        var bb = col.b * det * band

        // Water. Three things make a surface read as liquid, and a height
        // threshold on a blue polygon delivers none of them:
        //   depth      — shallows are bright and green, deep water is near-black
        //   reflection — at a grazing angle water is a mirror and takes the sky;
        //                that is the Fresnel term, and it is most of the effect
        //                when flying low across a bay
        //   motion     — a broad sun sheen sliding over the wave train
        // Blended in over a narrow band around sea level, with a foam line right
        // at the waterline, so the shore is an edge you can see rather than a
        // colour change you infer.
        let wet = smoothstep(1.5, -2.5, h)
        if wet > 0.0 {
            var shallow = rgb(0.06, 0.40, 0.42)
            var deep = rgb(0.004, 0.03, 0.13)
            if w.city.loaded {
                // A tropical shallow-water green is exactly wrong for a cold,
                // silty northern bay, and SRTM puts nearly all of one at 0 m —
                // so that green would be the WHOLE bay.
                shallow = rgb(0.055, 0.150, 0.175)
                deep = rgb(0.010, 0.045, 0.085)
            }
            // depth is measured against the seabed, not the animated surface
            let bed = heightAt(w.city, x, z)
            let body = shallow.lerp(deep, smoothstep(-2.0, -46.0, bed))

            // view direction from the eye to this point
            var vx = x - w.cam.x
            var vy = h - w.cam.y
            var vz = z - w.cam.z
            let vl = Math.sqrt(vx * vx + vy * vy + vz * vz) + 0.0001
            vx = vx / vl
            vy = vy / vl
            vz = vz / vl
            // Schlick, but capped. Physically the term goes to 1 at a grazing
            // angle; taken literally, a chase camera looking flat across a bay
            // turns the whole bay into sky colour and the water vanishes into
            // haze. Holding it well under 1 keeps the sea reading as sea.
            var cosI = 0.0 - (vx * nrm.x + vy * nrm.y + vz * nrm.z)
            if cosI < 0.0 {
                cosI = 0.0
            }
            let m = 1.0 - cosI
            let m2 = m * m
            let fres = 0.02 + 0.42 * m2 * m2 * m
            // Reflected sky. This is the per-vertex cousin of what the sea
            // shader does per pixel, for the DEM's own water sheet — lakes and
            // river surfaces that are terrain rather than ocean. Sampling the
            // real skyColor here is not possible (it is GLSL, and this runs on
            // the CPU), so it is the same idea by hand: a zenith blue thinned
            // toward white by however hazy the air is.
            let clear = 1.0 - s.turbidity
            let skyR = 0.05 + 0.30 * s.turbidity
            let skyG = 0.13 + 0.28 * s.turbidity
            let skyB = 0.34 * clear + 0.42
            var wr = body.r + (skyR - body.r) * fres
            var wg = body.g + (skyG - body.g) * fres
            var wb = body.b + (skyB - body.b) * fres

            // Sun glitter off the wave normals, via the half vector. Getting the
            // exponent right here is the whole difference between sea and haze:
            // open water is nearly flat, so the half-vector term sits close to 1
            // over huge areas, and anything broad (an exponent of 20, say) does
            // not light a glitter path — it washes the entire sea to pale grey.
            // Tight lobe for the actual sun streak, plus a very weak wide term
            // for sheen, which is all a 44-unit vertex spacing can carry.
            let hx = s.sunX - vx
            let hy = s.sunY - vy
            let hz = s.sunZ - vz
            let hl = Math.sqrt(hx * hx + hy * hy + hz * hz) + 0.0001
            var nh = (hx / hl) * nrm.x + (hy / hl) * nrm.y + (hz / hl) * nrm.z
            if nh < 0.0 {
                nh = 0.0
            }
            // Very tight, so it only fires on crests actually angled at the sun.
            let sheen = Math.pow(nh, 300.0) * 0.9
            wr = wr + sheen * 1.0
            wg = wg + sheen * 0.97
            wb = wb + sheen * 0.85

            // A travelling ripple field, brightening and darkening the surface.
            // With vertices 44 units apart a specular lobe cannot paint a glitter
            // path — but a moving low-frequency field can, and unlike a static
            // blanket of glare it actually reads as a surface in motion.
            // Wavelength has to stay well above the 44-unit vertex spacing. At
            // 130 units it is sampled under three times per wave, and instead of
            // a ripple you get a coarse lumpy pattern crawling over the surface.
            // ~480 units gives eleven samples per wave, which interpolates clean.
            let rip = Math.sin(x * 0.013 + w.time * 0.9) * Math.sin(z * 0.011 - w.time * 0.7)
            let ripK = 1.0 + 0.10 * rip
            wr = wr * ripK
            wg = wg * ripK
            wb = wb * ripK

            // Foam at the waterline. The wave train moves the surface up and
            // down through sea level, so this band crawls up and down the beach
            // on its own — the cheapest surf there is. Gated on the seabed
            // actually sloping: a broad flat shelf sitting a metre under water
            // satisfies "near sea level" across acres and turns into one huge
            // white sheet, which is what a plain height test gives you.
            let shoreSlope = smoothstep(0.010, 0.075, bedSlope(w.city, x, z))
            let foam = smoothstep(1.6, 0.15, Math.abs(h)) * shoreSlope
            wr = wr + foam * 0.55
            wg = wg + foam * 0.62
            wb = wb + foam * 0.62

            // Water carries its own shading; flat Lambert would fight the Fresnel
            // term, and the land grain does not belong on it at all.
            rr = rr + (wr - rr) * wet
            gg = gg + (wg - gg) * wet
            bb = bb + (wb - bb) * wet
            lt = lt + (1.0 - lt) * wet
            tw = tw - tw * wet
        }

        cc.h[i] = h
        cc.lt[i] = lt
        cc.r[i] = rr
        cc.g[i] = gg
        cc.b[i] = bb
        cc.tw[i] = tw
        cc.ok[i] = true
    }
    return Corner {
        h: cc.h[i], lt: cc.lt[i], r: cc.r[i], g: cc.g[i], b: cc.b[i], tw: cc.tw[i]
    }
}

// Height including moving water. Land is the heightmap; anything below sea level
// gets a travelling wave train so the sea has a surface instead of being a flat
// blue plate.
fn surfaceAt(cc: &City, x: f64, z: f64, t: f64): f64 {
    let h = heightAt(cc, x, z)
    if h >= 0.0 {
        return h
    }
    let wave = Math.sin(x * 0.020 + t * 1.5) * 2.4 + Math.sin(z * 0.031 - t * 1.1) * 1.8 + Math.sin((x + z) * 0.012 + t * 0.7) * 3.0
    return wave
}

// The surface normal at a point, from central differences. Sampling this at each
// corner and interpolating is what removes the faceting.
fn normalAt(cc: &City, x: f64, z: f64, t: f64): Vec3 {
    let e = 7.0
    let hx = surfaceAt(cc, x + e, z, t) - surfaceAt(cc, x - e, z, t)
    let hz = surfaceAt(cc, x, z + e, t) - surfaceAt(cc, x, z - e, t)
    let nx = 0.0 - hx
    let nz = 0.0 - hz
    let ny = 2.0 * e
    let l = Math.sqrt(nx * nx + ny * ny + nz * nz)
    return Vec3 {
        x: nx / l, y: ny / l, z: nz / l
    }
}

pub fn drawWorld(c: &mut Canvas, s: &mut Scene, w: &World, ground: &Texture, skin: &Texture, facade: &Texture, v: &View) {
    if w.city.loaded {
        // The region weather table is a set of moods for invented places. Over a
        // real city the point is to SEE it, so: clear air, fog only far enough
        // out to hide the edge of the data.
        s.turbidity = 0.30
        // The projected deck is off over a real place: the volume below draws the
        // weather now, and a deck at infinity drawn on top of it is a second,
        // disagreeing set of clouds in the same sky. It stays in the code because
        // it is still the right answer for a cirrus sheet at nine kilometres,
        // which has no parallax worth having over a 16 km map.
        s.cloud = 0.0
        s.fogStart = 1500.0
        // Tied to the draw distance, which now moves with altitude.
        //
        // `fogEnd` no longer colours anything — `sky.aerial` does the atmosphere —
        // but it still decides where the SEA stops being drawn, and it was left at
        // a constant 4200 when the terrain started reaching 17 km. From 3 km up
        // that cut the ocean off in a hard dark wedge a few kilometres out while
        // the land carried on past it to the horizon.
        s.fogEnd = farOf(w.cam.y) * 0.95
        // ~30 km visibility. `fogStart`/`fogEnd` still bound the draw distance
        // and the camera, but they no longer decide what the air looks like.
        // The measured visibility when there is one, and a clear-day default
        // when there is not. `hazeK` is where that decision already happened.
        s.haze = w.env.hazeK
        applyClouds(&mut s, w)
        // The sun is WHERE THE SUN IS: computed from the city's own latitude and
        // longitude and the current UTC instant (`solar.milo`), not chosen.
        //
        // It used to be a hand-placed late-afternoon vector, which was the right
        // call while the sky was a fixed gradient and a low sun bought nothing
        // but a different shade of grey. Over a real place it is worth more than
        // any amount of shader work: it is what makes the shadow down an avenue
        // fall where the shadow down that avenue actually falls, and it is the
        // difference between a picture of San Francisco and a picture of
        // somewhere that looks like it.
        //
        // A real sun also means real night. That is a genuine cost — fly at 03:00
        // local and there is nothing to see, where the old constant guaranteed a
        // postcard every time — and it is the cost of the thing being true.
        s.sunX = w.env.sunX
        s.sunY = w.env.sunY
        s.sunZ = w.env.sunZ
    } else {
        applyWeather(&mut s, w.prevTheme, w.theme, w.themeMix)
    }
    // Fog HAS to finish inside the draw distance. Every preset was written with
    // an end past the far plane, so nothing was ever more than half fogged and
    // the last row of terrain — and every building reaching the cull radius —
    // switched on against clear sky.
    //
    // Where it STARTS is the difference between distance and smog. Held to the
    // last third of the view, the near city keeps its own colours and only the
    // far edge dissolves; started any closer, the haze sits on everything and
    // the whole world goes grey.
    // The opening survey looks down from a kilometre up, where the presets put
    // the whole city past the haze wall and the shot is a white screen. Pushed
    // out to the draw distance for as long as the camera is up there — the fog
    // still finishes inside the far plane, so the grid edge stays hidden.
    // Against the far plane the camera is ACTUALLY using. `Camera.far` is a
    // vestigial field: `viewOf` derives the real one from altitude, so the stored
    // value is whatever it was when the camera was built and is wrong the moment
    // the aircraft climbs.
    let drawFar = farOf(w.cam.y)
    if w.intro > 0.0 {
        let up = Math.clampF64(w.intro / w.introLen, 0.0, 1.0)
        s.fogEnd = s.fogEnd + (drawFar - s.fogEnd) * up
    }
    if s.fogEnd > drawFar {
        s.fogEnd = drawFar
    }
    if s.fogStart > s.fogEnd * 0.78 {
        s.fogStart = s.fogEnd * 0.78
    }
    if s.fogStart < s.fogEnd * 0.66 {
        s.fogStart = s.fogEnd * 0.66
    }
    sceneClear(&mut s)

    // Walk a grid of quads centred on the aircraft. Anything behind the camera is
    // rejected before any per-vertex work.
    // The quad size for THIS frame, which grows with altitude so the drawn radius
    // does too. `viewOf` derives the far plane from the same function, so the grid
    // and the camera cannot disagree about where the world ends.
    let tile = terrainTile(w.cam.y)
    let baseX = Math.floor(w.cam.x / tile) as i64
    let baseZ = Math.floor(w.cam.z / tile) as i64
    let fwdX = Math.sin(w.cam.yaw)
    let fwdZ = Math.cos(w.cam.yaw)
    var cc = cornersNew(baseX, baseZ, tile, VIEW_TILES, 1, 0)
    // The near field is drawn at half the tile size. A 110 m quad is coarser than
    // the 30 m terrain data under it, which is invisible over open country and
    // ruinous on anything small: Alcatraz is 500 m by 300 m, so the whole island
    // — cliffs, quarry face, the drop to the water — was five quads by three, and
    // came out a pancake. Only the rings you are on top of are subdivided, so this
    // costs about two thousand extra triangles and nothing at range.
    let fineLo = 0 - 2 * (FINE_RINGS - 1)
    let fineHi = 2 * FINE_RINGS
    var fc = cornersNew(baseX * 2, baseZ * 2, tile * 0.5, FINE_RINGS * 2, fineLo, fineHi)
    // Same construction again one level down. The boundary snap works unchanged:
    // the corners the half-tile grid already has land on EVEN indices here, so the
    // odd ones are the new ones and averaging their neighbours reproduces exactly
    // what the coarser edge interpolates. That is the whole crack-prevention rule
    // and it does not care how many levels deep it is.
    let vfineLo = 0 - 4 * (VFINE_RINGS - 1)
    let vfineHi = 4 * VFINE_RINGS
    var vfc = cornersNew(baseX * 4, baseZ * 4, tile * 0.25, VFINE_RINGS * 4, vfineLo, vfineHi)

    // Front to back, in rings out from the camera tile. The z-buffer then rejects
    // hidden pixels with a single compare instead of shading them — near terrain
    // covers the screen several times over, so this is most of the frame budget.
    for ring in 0..VIEW_TILES {
        for step in 0..ringCount(ring) {
            let off = ringOffset(ring, step)
            let tx = baseX + off.x
            let tz = baseZ + off.z
            let x0 = (tx as f64) * tile
            let z0 = (tz as f64) * tile
            let x1 = x0 + tile
            let z1 = z0 + tile
            // cheap frustum reject: quad centre must be in front of the camera
            let mx = x0 + tile * 0.5 - w.cam.x
            let mz = z0 + tile * 0.5 - w.cam.z
            if mx * fwdX + mz * fwdZ < 0.0 - tile {
                continue
            }
            let d2 = mx * mx + mz * mz
            let reach = v.far
            if d2 > reach * reach {
                continue
            }

            // Four shared grid corners, each carrying its own height, light and
            // colour. Neighbouring quads read the SAME corner, so no attribute
            // can jump across a quad edge — this is what removes the grid.
            if ring < VFINE_RINGS {
                let vx = tx * 4 - baseX * 4 + VFINE_RINGS * 4
                let vz = tz * 4 - baseZ * 4 + VFINE_RINGS * 4
                let qtr = tile * 0.25
                for sz in 0..4 {
                    for sx in 0..4 {
                        let q00 = cornerAt(&mut vfc, s, w, vx + sx, vz + sz)
                        let q10 = cornerAt(&mut vfc, s, w, vx + sx + 1, vz + sz)
                        let q01 = cornerAt(&mut vfc, s, w, vx + sx, vz + sz + 1)
                        let q11 = cornerAt(&mut vfc, s, w, vx + sx + 1, vz + sz + 1)
                        terrainQuad(&mut s, w, v, ground, q00, q10, q01, q11, x0 + (sx as f64) * qtr, z0 + (sz as f64) * qtr, qtr, ring)
                    }
                }
                continue
            }
            if ring < FINE_RINGS {
                // Four sub-quads off the half-size grid. Its corners at even
                // indices are the coarse corners, so the two meshes agree
                // everywhere except the boundary midpoints, which snap.
                let hx = tx * 2 - baseX * 2 + FINE_RINGS * 2
                let hz = tz * 2 - baseZ * 2 + FINE_RINGS * 2
                let half = tile * 0.5
                for sz in 0..2 {
                    for sx in 0..2 {
                        let f00 = cornerAt(&mut fc, s, w, hx + sx, hz + sz)
                        let f10 = cornerAt(&mut fc, s, w, hx + sx + 1, hz + sz)
                        let f01 = cornerAt(&mut fc, s, w, hx + sx, hz + sz + 1)
                        let f11 = cornerAt(&mut fc, s, w, hx + sx + 1, hz + sz + 1)
                        terrainQuad(&mut s, w, v, ground, f00, f10, f01, f11, x0 + (sx as f64) * half, z0 + (sz as f64) * half, half, ring)
                    }
                }
                continue
            }
            let ix = tx - baseX + VIEW_TILES
            let iz = tz - baseZ + VIEW_TILES
            let k00 = cornerAt(&mut cc, s, w, ix, iz)
            let k10 = cornerAt(&mut cc, s, w, ix + 1, iz)
            let k01 = cornerAt(&mut cc, s, w, ix, iz + 1)
            let k11 = cornerAt(&mut cc, s, w, ix + 1, iz + 1)

            terrainQuad(&mut s, w, v, ground, k00, k10, k01, k11, x0, z0, tile, ring)
        }
    }

    if w.city.loaded {
        drawCity(&mut s, w, v, facade)
        drawBridges(&mut s, w, v)
        drawFalls(&mut s, w, v)
    } else {
        drawProps(&mut s, w, v, baseX, baseZ)
    }
    // Everything below draws into the 2D overlay rather than recording geometry,
    // and the overlay is composited over the finished scene. It used to matter
    // enormously that the recorded triangles were flushed to the canvas before
    // this point — they would have landed on top of the contrails otherwise —
    // and with the depth buffer and the compositing order both being the
    // driver's now, it does not.
    drawTrails(&mut c, w, v)
    drawRings(&mut s, w, v)
    drawPlane(&mut c, &mut s, w, v, skin)
    drawBirds(&mut c, s, w, v)
    drawSparks(&mut c, w, v)
}

// One terrain quad, from four corners that were sampled once and shared with its
// neighbours. Split out of the grid walk because the near field is drawn at half
// this tile size — see FINE_RINGS.
fn terrainQuad(s: &mut Scene, w: &World, v: &View, ground: &Texture, k00: &Corner, k10: &Corner, k01: &Corner, k11: &Corner, x0: f64, z0: f64, tile: f64, ring: i64) {
    let x1 = x0 + tile
    let z1 = z0 + tile
    // UVs are world position over a fixed period, so the detail texture
    // tiles across the terrain with no per-quad seams.
    let uvs = 1.0 / 34.0
    let u0 = x0 * uvs
    let v0 = z0 * uvs
    let u1 = x1 * uvs
    let v1 = z1 * uvs
    // The detail texture dissolves over the last rings before the draw
    // switches to the untextured path, so by the time it switches the
    // texture is contributing nothing and there is nothing to see. It
    // used to stop dead, drawing a line across the ground at a fixed
    // distance — the texture cutoff was visible as a texture cutoff.
    var texFade = 1.0
    if ring >= 7 {
        texFade = (11.0 - (ring as f64)) / 4.0
        if texFade < 0.0 {
            texFade = 0.0
        }
    }
    if w.city.orthoLoaded {
        // The photograph IS the ground colour, so the vertex carries
        // white and the texel supplies the albedo whole — the palette in
        // `cornerAt` is bypassed rather than multiplied, or the picture
        // comes out tinted by the guess it replaces.
        //
        // UV runs 0..1 across the mapped span; outside it the sampler's
        // mirrored addressing folds on the same period as the terrain.
        //
        // v is measured from the NORTH edge, because a PNG's first row is
        // its top and +z is north. Running it from -reach upward hung the
        // photograph on the terrain upside down: the map still read as a
        // city, hills still had relief (that comes from the DEM), and the
        // only place the flip was visible was the water — which is how
        // San Francisco ended up with the Sunset District's street grid
        // painted across the Golden Gate strait.
        let os = 1.0 / (w.city.reach * 2.0)
        let ou0 = (x0 + w.city.reach) * os
        let ov0 = (w.city.reach - z0) * os
        let ou1 = (x1 + w.city.reach) * os
        let ov1 = (w.city.reach - z1) * os
        // Mostly flat light. An aerial photograph already contains the
        // sun that lit it, shadows included; a second Lambert term on
        // top shades everything twice and the hills go to mud. A little
        // is kept so relief still reads.
        let la = 0.72 + 0.28 * k00.lt
        let lb = 0.72 + 0.28 * k10.lt
        let ld = 0.72 + 0.28 * k01.lt
        let le = 0.72 + 0.28 * k11.lt
        let oa = vtxC(x0, k00.h, z0, ou0, ov0, la, 1.0, 1.0, 1.0, 1.0)
        let ob = vtxC(x1, k10.h, z0, ou1, ov0, lb, 1.0, 1.0, 1.0, 1.0)
        let od = vtxC(x0, k01.h, z1, ou0, ov1, ld, 1.0, 1.0, 1.0, 1.0)
        let oe = vtxC(x1, k11.h, z1, ou1, ov1, le, 1.0, 1.0, 1.0, 1.0)
        // No distance cutoff: the far field is exactly what the drape is
        // for, and dropping to flat colour out there would put the
        // diorama back at the horizon.
        triangleV(&mut s, v, w.city.ortho, oa, od, ob, 1.0, 1.0, 1.0)
        triangleV(&mut s, v, w.city.ortho, ob, od, oe, 1.0, 1.0, 1.0)
        return
    }
    let a = vtxC(x0, k00.h, z0, u0, v0, k00.lt, k00.r, k00.g, k00.b, k00.tw * texFade)
    let b = vtxC(x1, k10.h, z0, u1, v0, k10.lt, k10.r, k10.g, k10.b, k10.tw * texFade)
    let d = vtxC(x0, k01.h, z1, u0, v1, k01.lt, k01.r, k01.g, k01.b, k01.tw * texFade)
    let e = vtxC(x1, k11.h, z1, u1, v1, k11.lt, k11.r, k11.g, k11.b, k11.tw * texFade)
    // Texture only what is close enough to see. Distant quads are many,
    // small, and deep in fog — they take the cheaper untextured path,
    // which still interpolates colour so the far field stays smooth.
    // The cutoff sits past where the fog has taken most of the contrast
    // out; nearer than that it was a visible line across the ground
    // where the detail simply stopped.
    if ring < 11 {
        triangleV(&mut s, v, ground, a, d, b, 1.0, 1.0, 1.0)
        triangleV(&mut s, v, ground, b, d, e, 1.0, 1.0, 1.0)
    } else {
        triangleG(&mut s, v, a, d, b, 1.0, 1.0, 1.0)
        triangleG(&mut s, v, b, d, e, 1.0, 1.0, 1.0)
    }
}

// Waterfalls. A named fall is a landmark you fly to look at, and the terrain
// grid has no idea there is water on the cliff — SRTM records the rock and
// nothing else, so Yosemite Falls was blank granite with a beam standing on it.
//
// The course is traced down the terrain rather than stored: from the lip, step
// in the steepest downhill direction until the ground goes flat. That finds the
// same chute the real water found, follows whatever the DEM says the cliff does,
// and costs no asset data at all.
fn drawFalls(s: &mut Scene, w: &World, v: &View) {
    if !w.city.loaded {
        return
    }
    for i in 0..w.marks.len {
        if w.marks[i].fall <= 0.0 {
            continue
        }
        let fx = w.marks[i].x
        let fz = w.marks[i].z
        let dx = fx - w.cam.x
        let dz = fz - w.cam.z
        if dx * dx + dz * dz > v.far * v.far {
            continue
        }
        fallRibbon(&mut s, w, v, fx, fz, w.marks[i].fall)
    }
}

fn fallRibbon(s: &mut Scene, w: &World, v: &View, lipX: f64, lipZ: f64, wide: f64) {
    let STEP = 14.0
    let MAX = 90
    // Trace the chute first and keep it, rather than emitting as we walk: the
    // shader needs to know the TOTAL drop at every vertex — how far down the fall
    // a pixel is decides how broken up the water is there — and that is not known
    // until the walk has finished.
    var px: Vec<f64> = Vec.new()
    var py: Vec<f64> = Vec.new()
    var pz: Vec<f64> = Vec.new()
    var pfall: Vec<f64> = Vec.new() // metres fallen at this point
    var pspeed: Vec<f64> = Vec.new() // how fast the water is moving here, 0..1
    var cx = lipX
    var cz = lipZ
    var cy = heightAt(w.city, cx, cz)
    var drop = 0.0
    var dirX = 0.0
    var dirZ = 1.0
    // Which way is downhill at the lip. Sampled once, at the top, and then held:
    // this is where the water is thrown, and it does not get to change its mind
    // halfway down a cliff.
    let gx0 = heightAt(w.city, cx - STEP, cz) - heightAt(w.city, cx + STEP, cz)
    let gz0 = heightAt(w.city, cx, cz - STEP) - heightAt(w.city, cx, cz + STEP)
    let gl0 = Math.sqrt(gx0 * gx0 + gz0 * gz0)
    if gl0 > 0.0001 {
        dirX = gx0 / gl0
        dirZ = gz0 / gl0
    }
    for _ in 0..MAX {
        px.push(cx)
        py.push(cy)
        pz.push(cz)
        pfall.push(drop)
        // Free fall: speed goes as the square root of the distance dropped.
        pspeed.push(Math.clampF64(Math.sqrt(Math.maxF64(drop, 0.0)) / 14.0, 0.15, 1.0))

        // WATER FALLS. It does not follow the ground down.
        //
        // Tracing steepest descent over the heightfield — which is what this used
        // to do — spreads a 633 m drop over 854 m of horizontal travel, because
        // SRTM's 30 m posts smooth a sheer granite face into a steep slope and
        // steepest descent obediently walks down it. The result is a diagonal
        // smear across a mountainside rather than a plunge, which is why the fall
        // read as tiny: it was never more than a few metres of drop per step of
        // screen distance.
        //
        // So the water leaves the lip and descends, and only rides the terrain
        // where the terrain is genuinely in the way. That handles both cases with
        // one rule: a sheer cliff gives a vertical ribbon, a boulder run gives a
        // cascade that hugs the rock, and Yosemite's three drops come out as three
        // drops because the ledges between them really are ledges.
        let stepDown = 14.0
        // Forward throw. Larger than the water's real trajectory on purpose: the
        // DEM does not contain the cliff. SRTM's 30 m posts smooth a vertical
        // granite face into a slope, so the surface the heightfield describes sits
        // WELL BEHIND where the rock actually is, and water that stops when it
        // meets that surface stops a couple of hundred metres above the valley
        // floor. Carrying the ribbon out from the face as it drops puts it in
        // front of the smoothed slope, which is both where the real water is and
        // where it has to be to read as falling.
        let throwOut = 5.5
        let ny = cy - stepDown
        let nx = cx + dirX * throwOut
        let nz = cz + dirZ * throwOut
        let ground = heightAt(w.city, nx, nz)
        // Only a real ledge counts as an obstruction. Within this tolerance the
        // heightfield is describing the smoothed face, not something the water
        // would actually land on.
        if ground > ny + 22.0 {
            // The rock is in the way — this is a ledge or a chute, so run along it
            // rather than through it. If the ground here is no lower than where we
            // already are, the fall has reached the valley floor and is finished.
            if ground >= cy - 0.4 {
                break
            }
            drop = drop + (cy - ground)
            cy = ground
            cx = nx
            cz = nz
        } else {
            drop = drop + stepDown
            cy = ny
            cx = nx
            cz = nz
        }
    }
    if drop < 20.0 || px.len < 2 {
        return
    }

    // The ribbon. `uv.x` runs across it, `uv.y` is metres fallen — a real length,
    // not a normalised one, so the threads in the shader keep their scale whether
    // the drop is thirty metres or seven hundred.
    for i in 0..px.len - 1 {
        let t0 = (i as f64) / ((px.len - 1) as f64)
        let t1 = ((i + 1) as f64) / ((px.len - 1) as f64)
        // Water narrows at the lip and spreads toward the plunge pool, and stands
        // a little off the rock so the two do not z-fight.
        let h0 = wide * (0.6 + 2.4 * t0) * 0.5
        let h1 = wide * (0.6 + 2.4 * t1) * 0.5
        let ax = 0.0 - dirZ
        let az = dirX
        let lift = 2.0
        // r/g/b are 1.0 on purpose: `triangleF` multiplies the vertex tint by the
        // three numbers it is handed, so leaving them at one is what makes those
        // three arrive at the shader as width, total drop and the spray flag.
        let a0 = vtxC(px[i] - ax * h0, py[i] + lift, pz[i] - az * h0, 0.0, pfall[i], pspeed[i], 1.0, 1.0, 1.0, 0.0)
        let a1 = vtxC(px[i] + ax * h0, py[i] + lift, pz[i] + az * h0, 1.0, pfall[i], pspeed[i], 1.0, 1.0, 1.0, 0.0)
        let b0 = vtxC(px[i + 1] - ax * h1, py[i + 1] + lift, pz[i + 1] - az * h1, 0.0, pfall[i + 1], pspeed[i + 1], 1.0, 1.0, 1.0, 0.0)
        let b1 = vtxC(px[i + 1] + ax * h1, py[i + 1] + lift, pz[i + 1] + az * h1, 1.0, pfall[i + 1], pspeed[i + 1], 1.0, 1.0, 1.0, 0.0)
        triangleF(&mut s, v, a0, a1, b1, wide, drop, 0.0)
        triangleF(&mut s, v, a0, b1, b0, wide, drop, 0.0)
    }

    // Mist torn off the sheet on the way down. A drop this tall is half spray
    // before it lands, and without this the sheet ends in a plume that looks
    // stuck on rather than thrown.
    if drop > 120.0 {
        for k in 0..18 {
            let idx = 1 + ((k * 7) % (px.len - 1))
            let cyc = w.time * 0.34 + propHash(k, 23)
            let life = cyc - Math.floor(cyc)
            let r = wide * (0.5 + 1.5 * life)
            let fade = Math.sin(life * 3.14159265358979) * 0.55
            if fade <= 0.02 {
                continue
            }
            let sx = px[idx] + (propHash(k, 29) - 0.5) * wide * 2.2
            let sy = py[idx] - life * 26.0
            let sz = pz[idx] + (propHash(k, 31) - 0.5) * wide * 2.2
            let rx = v.right.x * r
            let ry = v.right.y * r
            let rz = v.right.z * r
            let ux = v.up.x * r
            let uy = v.up.y * r
            let uz = v.up.z * r
            let q0 = vtxC(sx - rx - ux, sy - ry - uy, sz - rz - uz, 0.0 - 1.0, 0.0 - 1.0, fade, 1.0, 1.0, 1.0, 0.0)
            let q1 = vtxC(sx + rx - ux, sy + ry - uy, sz + rz - uz, 1.0, 0.0 - 1.0, fade, 1.0, 1.0, 1.0, 0.0)
            let q2 = vtxC(sx + rx + ux, sy + ry + uy, sz + rz + uz, 1.0, 1.0, fade, 1.0, 1.0, 1.0, 0.0)
            let q3 = vtxC(sx - rx + ux, sy - ry + uy, sz - rz + uz, 0.0 - 1.0, 1.0, fade, 1.0, 1.0, 1.0, 0.0)
            triangleF(&mut s, v, q0, q1, q2, wide, drop, 1.0)
            triangleF(&mut s, v, q0, q2, q3, wide, drop, 1.0)
        }
    }

    // The plume at the foot.
    //
    // Camera-facing billboards rather than the three flat rings this used to be:
    // a ring seen edge-on is a line, and from an aircraft you are almost always
    // looking at one edge-on. A billboard has no edge to catch.
    let baseX = px[px.len - 1]
    let baseY = py[py.len - 1]
    let baseZ = pz[pz.len - 1]
    // The plume is what you actually see from a kilometre away. The sheet itself
    // is honestly narrow — Yosemite Falls is about thirty metres across at the lip
    // — and at flyby's distances a thirty-metre thread is a few pixels. What makes
    // a tall fall visible from the air is the mist it throws, which is far wider
    // than the water and catches the light.
    let rad = wide * 3.4
    for k in 0..34 {
        let kk = k as f64
        // Each puff has its own phase through a rise-and-fade cycle, so the plume
        // boils continuously instead of pulsing as one.
        let cycle = w.time * 0.26 + propHash(k, 7)
        let life = cycle - Math.floor(cycle)
        let ang = propHash(k, 11) * TAU
        let spread = rad * (0.35 + 1.35 * life)
        let cxx = baseX + Math.cos(ang) * spread * (0.6 + 0.8 * propHash(k, 13))
        let czz = baseZ + Math.sin(ang) * spread * (0.6 + 0.8 * propHash(k, 17))
        // Rises fast and slows, the way a mist plume does.
        let cyy = baseY + 2.0 + rad * (0.20 + 1.15 * Math.sqrt(life))
        // Grows as it rises and thins out as it goes.
        let r = rad * (0.30 + 0.70 * life) * (0.6 + 0.7 * propHash(k, 19))
        let fade = Math.sin(life * 3.14159265358979) // in at the bottom, out at the top
        if fade <= 0.02 {
            continue
        }
        let rx = v.right.x * r
        let ry = v.right.y * r
        let rz = v.right.z * r
        let ux = v.up.x * r
        let uy = v.up.y * r
        let uz = v.up.z * r
        // uv runs -1..1 across the billboard, which is what the shader takes the
        // radial falloff from.
        let q0 = vtxC(cxx - rx - ux, cyy - ry - uy, czz - rz - uz, 0.0 - 1.0, 0.0 - 1.0, fade, 1.0, 1.0, 1.0, 0.0)
        let q1 = vtxC(cxx + rx - ux, cyy + ry - uy, czz + rz - uz, 1.0, 0.0 - 1.0, fade, 1.0, 1.0, 1.0, 0.0)
        let q2 = vtxC(cxx + rx + ux, cyy + ry + uy, czz + rz + uz, 1.0, 1.0, fade, 1.0, 1.0, 1.0, 0.0)
        let q3 = vtxC(cxx - rx + ux, cyy - ry + uy, czz - rz + uz, 0.0 - 1.0, 1.0, fade, 1.0, 1.0, 1.0, 0.0)
        triangleF(&mut s, v, q0, q1, q2, wide, drop, 1.0)
        triangleF(&mut s, v, q0, q2, q3, wide, drop, 1.0)
    }
}

// ── bridges ───────────────────────────────────────────────────────────────────

// A bridge is the one thing in a city that is not on the ground, and the terrain
// grid does not know it is there: SRTM samples the water under the Golden Gate,
// so without this the two San Francisco landmarks that ARE bridges were a hoop
// over open water and nothing else.
//
// Decks are drawn as a ribbon of boxes rather than as flat quads. A deck seen
// from a plane is usually seen from ABOVE and from the SIDE at the same time, and
// a zero-thickness ribbon vanishes edge-on at exactly the angle you approach one.
fn drawBridges(s: &mut Scene, w: &World, v: &View) {
    if !w.city.loaded || w.city.brCount == 0 {
        return
    }
    let reach = w.city.reach
    let far = v.far
    let fwdX = Math.sin(w.cam.yaw)
    let fwdZ = Math.cos(w.cam.yaw)
    let kx0 = blockOf(w.cam.x - far, reach)
    let kx1 = blockOf(w.cam.x + far, reach)
    let kz0 = blockOf(w.cam.z - far, reach)
    let kz1 = blockOf(w.cam.z + far, reach)
    for kz in kz0..(kz1 + 1) {
        for kx in kx0..(kx1 + 1) {
            for b in 0..w.city.brCount {
                bridgeSpan(&mut s, w, v, b, kx, kz, reach, far, fwdX, fwdZ)
            }
        }
    }
}

fn bridgeSpan(s: &mut Scene, w: &World, v: &View, b: i64, kx: i64, kz: i64, reach: f64, far: f64, fwdX: f64, fwdZ: f64) {
    let n = w.city.brLen[b]
    if n < 2 {
        return
    }
    let start = w.city.brStart[b]
    let midX = unfold(kx, (w.city.brPtX[start] + w.city.brPtX[start + n - 1]) * 0.5, reach)
    let midZ = unfold(kz, (w.city.brPtZ[start] + w.city.brPtZ[start + n - 1]) * 0.5, reach)
    let dx = midX - w.cam.x
    let dz = midZ - w.cam.z
    let d2 = dx * dx + dz * dz
    // Half the way's own length as slack, so a two-kilometre span is not culled
    // by its midpoint while one of its towers is filling the screen.
    let slack = far + 1400.0
    if d2 > slack * slack {
        return
    }
    if dx * fwdX + dz * fwdZ < 0.0 - 1400.0 {
        return
    }
    let col = w.city.brCol[b]
    let hw = w.city.brHalfW[b]
    // Girder depth. Real box girders run about a fifteenth of the span they
    // carry; this only has to be thick enough not to disappear edge-on.
    let deep = Math.clampF64(hw * 0.55, 1.6, 5.0)
    let far2 = far * far
    for i in 0..n - 1 {
        let ia = start + i
        let ib = start + i + 1
        let ax = unfold(kx, w.city.brPtX[ia], reach)
        let az = unfold(kz, w.city.brPtZ[ia], reach)
        let bx = unfold(kx, w.city.brPtX[ib], reach)
        let bz = unfold(kz, w.city.brPtZ[ib], reach)
        let ay = w.city.brPtY[ia]
        let by = w.city.brPtY[ib]
        let sdx = (ax + bx) * 0.5 - w.cam.x
        let sdz = (az + bz) * 0.5 - w.cam.z
        let sd2 = sdx * sdx + sdz * sdz
        if sd2 > far2 {
            continue
        }
        deckSegment(&mut s, v, ax, ay, az, bx, by, bz, hw, deep, col, sd2 > 640000.0)
    }
    // Towers stand at the two ends of the water the way crosses, which is where
    // the real ones are founded.
    if w.city.brTower[b] > 0.0 {
        bridgeTower(&mut s, w, v, b, kx, kz, reach, w.city.brTowerA[b], col)
        bridgeTower(&mut s, w, v, b, kx, kz, reach, w.city.brTowerB[b], col)
        bridgeCables(&mut s, w, v, b, kx, kz, reach, col)
    }
}

// One length of deck as a box: road surface on top, two flanks, and a soffit.
// `lod` drops everything but the road once the segment is far enough that the
// flanks are under a pixel.
fn deckSegment(s: &mut Scene, v: &View, ax: f64, ay: f64, az: f64, bx: f64, by: f64, bz: f64, hw: f64, deep: f64, col: &Rgb, lod: bool) {
    var ex = bx - ax
    var ez = bz - az
    let el = Math.sqrt(ex * ex + ez * ez)
    if el < 0.01 {
        return
    }
    ex = ex / el
    ez = ez / el
    // Perpendicular in the ground plane. The deck stays level across its width —
    // real ones are crowned by centimetres, which is nothing from a cockpit.
    let px = 0.0 - ez * hw
    let pz = ex * hw
    let a0 = v3(ax - px, ay, az - pz)
    let a1 = v3(ax + px, ay, az + pz)
    let b0 = v3(bx - px, by, bz - pz)
    let b1 = v3(bx + px, by, bz + pz)
    // Windings follow the same rule as box3: (v1-v0) x (v2-v0) points along the
    // face's outward normal, and `p x e` is +y for any edge direction, so a deck
    // box built from its own local frame comes out correctly wound on a mirrored
    // copy of the map too — there is no winding to flip because none was stored.
    let top = col.scale(1.06)
    triangle(&mut s, v, a0, a1, b1, top)
    triangle(&mut s, v, a0, b1, b0, top)
    if lod {
        return
    }
    let c0 = v3(a0.x, ay - deep, a0.z)
    let c1 = v3(a1.x, ay - deep, a1.z)
    let d0 = v3(b0.x, by - deep, b0.z)
    let d1 = v3(b1.x, by - deep, b1.z)
    // Flanks: the side a driver sees as a parapet and a pilot sees as the girder.
    let side = col.scale(0.62)
    triangle(&mut s, v, a0, b0, d0, side)
    triangle(&mut s, v, a0, d0, c0, side)
    triangle(&mut s, v, a1, d1, b1, side)
    triangle(&mut s, v, a1, c1, d1, side)
    // Soffit, in shadow — nothing lights the underside of a bridge but the water.
    let under = col.scale(0.30)
    triangle(&mut s, v, c0, d0, d1, under)
    triangle(&mut s, v, c0, d1, c1, under)
}

// Where the arc-length fraction `t` along a way lands: deck position, and the
// way's own direction there. Cables, hangers and towers all have to agree about
// this or the cable comes down beside the tower it is supposed to hang from.
struct ArcPoint {
    x: f64,
    y: f64,
    z: f64,
    ex: f64, // unit direction along the way, in the xz plane
    ez: f64,
}

fn arcPoint(w: &World, b: i64, t: f64): ArcPoint {
    let n = w.city.brLen[b]
    let start = w.city.brStart[b]
    var total = 0.0
    for k in 1..n {
        let ddx = w.city.brPtX[start + k] - w.city.brPtX[start + k - 1]
        let ddz = w.city.brPtZ[start + k] - w.city.brPtZ[start + k - 1]
        total = total + Math.sqrt(ddx * ddx + ddz * ddz)
    }
    let want = total * Math.clampF64(t, 0.0, 1.0)
    var acc = 0.0
    var idx = 0
    var frac = 0.0
    for k in 1..n {
        let ddx = w.city.brPtX[start + k] - w.city.brPtX[start + k - 1]
        let ddz = w.city.brPtZ[start + k] - w.city.brPtZ[start + k - 1]
        let seg = Math.sqrt(ddx * ddx + ddz * ddz)
        if acc + seg >= want || k == n - 1 {
            idx = k - 1
            if seg > 0.0 {
                frac = (want - acc) / seg
            }
            break
        }
        acc = acc + seg
    }
    frac = Math.clampF64(frac, 0.0, 1.0)
    let ex = w.city.brPtX[start + idx + 1] - w.city.brPtX[start + idx]
    let ez = w.city.brPtZ[start + idx + 1] - w.city.brPtZ[start + idx]
    var el = Math.sqrt(ex * ex + ez * ez)
    if el < 0.0001 {
        el = 1.0
    }
    return ArcPoint {
        x: w.city.brPtX[start + idx] + ex * frac,
        y: w.city.brPtY[start + idx] + (w.city.brPtY[start + idx + 1] - w.city.brPtY[start + idx]) * frac,
        z: w.city.brPtZ[start + idx] + ez * frac,
        ex: ex / el,
        ez: ez / el,
    }
}

// A cable, drawn as two ribbons crossed at right angles rather than as a tube.
// A suspension cable is under a metre thick and a kilometre long: a tube spends
// a dozen triangles a segment to show one line of pixels, and a single flat
// ribbon disappears whenever you look along its plane. The cross costs four
// triangles and is visible from everywhere.
fn cableSeg(s: &mut Scene, v: &View, ax: f64, ay: f64, az: f64, bx: f64, by: f64, bz: f64, rad: f64, col: &Rgb) {
    var dx = bx - ax
    var dz = bz - az
    let dl = Math.sqrt(dx * dx + dz * dz)
    if dl < 0.0001 {
        return
    }
    let px = 0.0 - (dz / dl) * rad
    let pz = (dx / dl) * rad
    let h0 = v3(ax - px, ay, az - pz)
    let h1 = v3(ax + px, ay, az + pz)
    let h2 = v3(bx + px, by, bz + pz)
    let h3 = v3(bx - px, by, bz - pz)
    triangle(&mut s, v, h0, h1, h2, col)
    triangle(&mut s, v, h0, h2, h3, col)
    triangle(&mut s, v, h2, h1, h0, col)
    triangle(&mut s, v, h3, h2, h0, col)
    let w0 = v3(ax, ay - rad, az)
    let w1 = v3(ax, ay + rad, az)
    let w2 = v3(bx, by + rad, bz)
    let w3 = v3(bx, by - rad, bz)
    triangle(&mut s, v, w0, w1, w2, col)
    triangle(&mut s, v, w0, w2, w3, col)
    triangle(&mut s, v, w2, w1, w0, col)
    triangle(&mut s, v, w3, w2, w0, col)
}

// The cables, which are what makes a suspension bridge one. The main span hangs
// between the tower tops and comes down to deck level at midspan; the side spans
// run from each tower top to an anchorage at the end of the way; hangers drop
// from the cable to the deck. Sine rather than a true catenary — over a span
// this long the two differ by less than the cable is thick.
fn bridgeCables(s: &mut Scene, w: &World, v: &View, b: i64, kx: i64, kz: i64, reach: f64, col: &Rgb) {
    let ta = w.city.brTowerA[b]
    let tb = w.city.brTowerB[b]
    if tb - ta < 0.02 {
        return
    }
    let hw = w.city.brHalfW[b]
    let towerH = w.city.brTower[b]
    let pa = arcPoint(w, b, ta)
    let pb = arcPoint(w, b, tb)
    let topA = pa.y + towerH
    let topB = pb.y + towerH
    let rad = Math.maxF64(hw * 0.055, 0.9)
    let cableCol = col.scale(0.82)
    // Lateral offset of the two cables: the same one the tower legs stand on, so
    // a cable lands on top of its tower and not beside it.
    let offA = hw * 0.86

    // Distance cull, once, off the middle of the span.
    let midP = arcPoint(w, b, (ta + tb) * 0.5)
    let mx = unfold(kx, midP.x, reach) - w.cam.x
    let mz = unfold(kz, midP.z, reach) - w.cam.z
    let d2 = mx * mx + mz * mz
    if d2 > (v.far + 1400.0) * (v.far + 1400.0) {
        return
    }
    // Hangers are hundreds of thin verticals; they earn their triangles only
    // close in, where you can see them as separate lines.
    let hangers = d2 < 3500.0 * 3500.0

    let SEGS = 26
    for side in 0..2 {
        var sign = 1.0
        if side == 1 {
            sign = 0.0 - 1.0
        }
        var prevX = 0.0
        var prevY = 0.0
        var prevZ = 0.0
        var have = false
        // Anchorage to tower to tower to anchorage, in one walk over the way.
        for i in 0..SEGS + 1 {
            let u = (i as f64) / (SEGS as f64)
            let t = ta + (tb - ta) * u
            let p = arcPoint(w, b, t)
            // Sag: the cable leaves each tower top and touches the deck at the
            // middle of the span.
            let straight = topA + (topB - topA) * u
            let deck = p.y + 2.0
            let sag = Math.sin(3.14159265358979 * u)
            let cy = straight - (straight - deck) * sag
            let ox = 0.0 - p.ez * hw * 0.86 * sign
            let oz = p.ex * hw * 0.86 * sign
            let cx = unfold(kx, p.x, reach) + ox
            let cz = unfold(kz, p.z, reach) + oz
            if have {
                cableSeg(&mut s, v, prevX, prevY, prevZ, cx, cy, cz, rad, cableCol)
            }
            if hangers && i > 0 && i < SEGS && cy - p.y > 6.0 {
                cableSeg(&mut s, v, cx, cy, cz, cx, p.y, cz, rad * 0.45, cableCol)
            }
            prevX = cx
            prevY = cy
            prevZ = cz
            have = true
        }
        // Back-stays: tower top down to where the way meets land, which is where
        // a real anchorage sits.
        let endA = arcPoint(w, b, 0.0)
        let endB = arcPoint(w, b, 1.0)
        let axx = unfold(kx, endA.x, reach) - endA.ez * offA * sign
        let azz = unfold(kz, endA.z, reach) + endA.ex * offA * sign
        let bxx = unfold(kx, endB.x, reach) - endB.ez * offA * sign
        let bzz = unfold(kz, endB.z, reach) + endB.ex * offA * sign
        let taX = unfold(kx, pa.x, reach) - pa.ez * offA * sign
        let taZ = unfold(kz, pa.z, reach) + pa.ex * offA * sign
        let tbX = unfold(kx, pb.x, reach) - pb.ez * offA * sign
        let tbZ = unfold(kz, pb.z, reach) + pb.ex * offA * sign
        cableSeg(&mut s, v, taX, topA, taZ, axx, endA.y + 3.0, azz, rad, cableCol)
        cableSeg(&mut s, v, tbX, topB, tbZ, bxx, endB.y + 3.0, bzz, rad, cableCol)
    }
}

// A tapered tower rising from the water to well above the deck.
fn bridgeTower(s: &mut Scene, w: &World, v: &View, b: i64, kx: i64, kz: i64, reach: f64, t: f64, col: &Rgb) {
    let p = arcPoint(w, b, t)
    let lx = p.x
    let lz = p.z
    let dy = p.y
    let x = unfold(kx, lx, reach)
    let z = unfold(kz, lz, reach)
    let dxc = x - w.cam.x
    let dzc = z - w.cam.z
    if dxc * dxc + dzc * dzc > v.far * v.far {
        return
    }
    let hw = w.city.brHalfW[b]
    let top = dy + w.city.brTower[b]
    // Founded at the water line, not on the deck: a tower that starts where the
    // road does is a post balanced on a ribbon.
    let base = Math.minF64(0.0, heightAt(w.city, x, z))
    // Two legs, one either side of the roadway, which is what carries the cables.
    let ox = 0.0 - p.ez * hw * 0.86
    let oz = p.ex * hw * 0.86
    let leg = Math.maxF64(hw * 0.28, 3.2)
    box3(&mut s, v, x + ox, base, top, z + oz, leg, col.scale(0.9))
    box3(&mut s, v, x - ox, base, top, z - oz, leg, col.scale(0.9))
    // Cross braces: one above the roadway and two more up the tower, which is
    // the ladder shape that reads as a suspension tower rather than two posts.
    box3(&mut s, v, x, top - leg * 2.4, top, z, hw * 1.05, col.scale(0.82))
    let above = top - dy
    if above > 40.0 {
        let b1 = dy + above * 0.30
        let b2 = dy + above * 0.66
        box3(&mut s, v, x, b1, b1 + leg * 1.3, z, hw * 1.0, col.scale(0.80))
        box3(&mut s, v, x, b2, b2 + leg * 1.3, z, hw * 1.0, col.scale(0.80))
    }
}

// Ground detail. Each terrain tile near the aircraft may carry one prop, placed
// and sized from a stable hash so the scenery does not crawl as you fly. The kind
// follows the theme: palms on the coast, cactus in the desert, conifers in the
// forest, towers in the city.
fn propHash(x: i64, z: i64): f64 {
    let v = Math.sin((x as f64) * 271.9 + (z as f64) * 133.7) * 27183.1234
    return v - Math.floor(v)
}

// An axis-aligned box, given as its base centre, height and half-width. Faces
// carry their own shade so a block reads as lit without a normal per triangle.
fn box3(s: &mut Scene, v: &View, cx: f64, y0: f64, y1: f64, cz: f64, hw: f64, col: &Rgb) {
    let x0 = cx - hw
    let x1 = cx + hw
    let z0 = cz - hw
    let z1 = cz + hw
    // eight corners: 0..3 bottom, 4..7 top, both counter-clockwise from -x-z
    let b00 = v3(x0, y0, z0)
    let b10 = v3(x1, y0, z0)
    let b11 = v3(x1, y0, z1)
    let b01 = v3(x0, y0, z1)
    let t00 = v3(x0, y1, z0)
    let t10 = v3(x1, y1, z0)
    let t11 = v3(x1, y1, z1)
    let t01 = v3(x0, y1, z1)
    // four walls, brighter on the sunward pair, plus a cap
    let north = col
    let south = col.scale(0.7)
    let east = col.scale(0.85)
    let west = col.scale(0.55)
    let top = col.scale(1.15)
    triangle(&mut s, v, b00, t00, t10, north)
    triangle(&mut s, v, b00, t10, b10, north)
    triangle(&mut s, v, b11, t11, t01, south)
    triangle(&mut s, v, b11, t01, b01, south)
    triangle(&mut s, v, b10, t10, t11, east)
    triangle(&mut s, v, b10, t11, b11, east)
    triangle(&mut s, v, b01, t01, t00, west)
    triangle(&mut s, v, b01, t00, b00, west)
    triangle(&mut s, v, t00, t01, t11, top)
    triangle(&mut s, v, t00, t11, t10, top)
}

fn cone3(s: &mut Scene, v: &View, cx: f64, y0: f64, y1: f64, cz: f64, rad: f64, col: &Rgb) {
    let segs = 10
    let step = TAU / (segs as f64)
    let apex = v3(cx, y1, cz)
    for k in 0..segs {
        let a0 = (k as f64) * step
        let a1 = ((k + 1) as f64) * step
        let p0 = v3(cx + Math.cos(a0) * rad, y0, cz + Math.sin(a0) * rad)
        let p1 = v3(cx + Math.cos(a1) * rad, y0, cz + Math.sin(a1) * rad)
        let sh = 0.65 + 0.35 * Math.cos(a0)
        triangle(&mut s, v, p0, apex, p1, col.scale(sh))
        triangle(&mut s, v, p1, apex, p0, col.scale(sh * 0.7))
    }
}

// A palm crown: fronds radiating from one point and drooping away from it.
//
// This was two stacked `cone3` calls, which is a fir — apex up, rim below, the
// same silhouette the FOREST region grows. The tree shape is most of what tells
// a coast from a forest at a glance, so the coast was quietly wearing the wrong
// biome. Fronds are single triangles, emitted in both windings because the
// rasteriser backface-culls and a frond has to be visible from underneath.
// Twelve triangles a palm, half what the two cones cost.
fn palmCrown(s: &mut Scene, v: &View, crown: &Vec3, reach: f64, droop: f64, col: &Rgb) {
    let fronds = 9
    let step = TAU / (fronds as f64)
    for k in 0..fronds {
        let a = (k as f64) * step
        let dir = v3(Math.cos(a), 0.0, Math.sin(a))
        let tip = crown + dir.scale(reach) - v3(0.0, droop, 0.0)
        // the frond has width at its base, tapering to the tip
        let wing = v3(0.0 - dir.z, 0.0, dir.x).scale(reach * 0.22)
        let sh = 0.72 + 0.28 * Math.cos(a)
        let l = crown + wing
        let r = crown - wing
        triangle(&mut s, v, l, tip, r, col.scale(sh))
        triangle(&mut s, v, r, tip, l, col.scale(sh * 0.75))
    }
}

pub let PROP_TILES: i64 = 9

fn drawProps(s: &mut Scene, w: &World, v: &View, baseX: i64, baseZ: i64) {
    for gz in 0 - PROP_TILES..PROP_TILES {
        for gx in 0 - PROP_TILES..PROP_TILES {
            let tx = baseX + gx
            let tz = baseZ + gz
            let h = propHash(tx, tz)
            if h > 0.30 {
                continue // most tiles are empty
            }
            let jx = propHash(tx + 7919, tz) - 0.5
            let jz = propHash(tx, tz + 6271) - 0.5
            let x = (tx as f64) * TILE + TILE * (0.5 + jx * 0.7)
            let z = (tz as f64) * TILE + TILE * (0.5 + jz * 0.7)
            let g0 = heightAt(w.city, x, z)
            if g0 < 4.0 {
                continue // nothing grows in the water
            }
            let scale = 0.7 + h * 3.0
            if (w.theme as i32) == (Theme.Desert as i32) {
                // cactus: a trunk and one arm
                box3(&mut s, v, x, g0, g0 + 16.0 * scale, z, 2.2, rgb(0.16, 0.34, 0.14))
                box3(&mut s, v, x + 3.0, g0 + 7.0 * scale, g0 + 13.0 * scale, z, 1.4, rgb(0.14, 0.30, 0.12))
            } else if (w.theme as i32) == (Theme.Forest as i32) {
                // conifer
                box3(&mut s, v, x, g0, g0 + 7.0 * scale, z, 1.4, rgb(0.20, 0.12, 0.06))
                cone3(&mut s, v, x, g0 + 5.0 * scale, g0 + 30.0 * scale, z, 7.0 * scale, rgb(0.07, 0.26, 0.10))
            } else if (w.theme as i32) == (Theme.City as i32) {
                // tower block, height keyed off the same hash so a district varies
                let tall = 22.0 + propHash(tz, tx) * 90.0
                box3(&mut s, v, x, g0, g0 + tall, z, 6.0 + h * 12.0, rgb(0.30, 0.31, 0.34))
            } else {
                // palm: bare trunk, fronds drooping off the top of it
                box3(&mut s, v, x, g0, g0 + 15.0 * scale, z, 1.2, rgb(0.26, 0.18, 0.09))
                palmCrown(&mut s, v, v3(x, g0 + 15.0 * scale, z), 11.0 * scale, 6.0 * scale, rgb(0.11, 0.34, 0.13))
            }
        }
    }
}

// Real buildings: every visible OSM footprint extruded to its real height.
//
// The map is finite and reflected (see world3d.foldIn), so this walks the
// reflected copies that overlap the draw radius and emits each one's buildings
// transformed into world space. A copy mirrored on exactly one axis has its
// polygon winding flipped, and the rasteriser backface-culls — so those copies
// walk their footprints backwards, which flips the winding back.
fn drawCity(s: &mut Scene, w: &World, v: &View, facade: &Texture) {
    if !w.city.loaded {
        return
    }
    let reach = w.city.reach
    let far = v.far
    let fwdX = Math.sin(w.cam.yaw)
    let fwdZ = Math.cos(w.cam.yaw)
    let kx0 = blockOf(w.cam.x - far, reach)
    let kx1 = blockOf(w.cam.x + far, reach)
    let kz0 = blockOf(w.cam.z - far, reach)
    let kz1 = blockOf(w.cam.z + far, reach)

    for kz in kz0..(kz1 + 1) {
        for kx in kx0..(kx1 + 1) {
            // The slice of this copy that the camera can actually see, in the
            // copy's own local coordinates.
            let ax = localOf(kx, w.cam.x - far, reach)
            let bx = localOf(kx, w.cam.x + far, reach)
            let az = localOf(kz, w.cam.z - far, reach)
            let bz = localOf(kz, w.cam.z + far, reach)
            let loX = Math.minF64(ax, bx) - BUILDING_MARGIN
            let hiX = Math.maxF64(ax, bx) + BUILDING_MARGIN
            let loZ = Math.minF64(az, bz) - BUILDING_MARGIN
            let hiZ = Math.maxF64(az, bz) + BUILDING_MARGIN
            let cellX0 = cityCellX(w.city, loX)
            let cellX1 = cityCellX(w.city, hiX)
            let cellZ0 = cityCellZ(w.city, loZ)
            let cellZ1 = cityCellZ(w.city, hiZ)
            let reversed = (kx % 2 != 0) != (kz % 2 != 0)

            // One scratch pair of point buffers for the whole copy. A Vec per
            // building was two allocations per building per frame, and downtown
            // is two thousand buildings.
            var px: Vec<f64> = Vec.new()
            var pz: Vec<f64> = Vec.new()

            // Front to back, in rings out from the cell under the camera —
            // the same order the terrain is drawn in, and for the same reason:
            // a city block is drawn over several times, and the z-buffer can
            // reject a hidden pixel with one compare if the near geometry got
            // there first. Grid order would shade every one of those pixels.
            let camCellX = cityCellX(w.city, localOf(kx, w.cam.x, reach))
            let camCellZ = cityCellZ(w.city, localOf(kz, w.cam.z, reach))
            var maxRing = Math.maxI64(camCellX - cellX0, cellX1 - camCellX)
            maxRing = Math.maxI64(maxRing, Math.maxI64(camCellZ - cellZ0, cellZ1 - camCellZ))

            for ring in 0..(maxRing + 1) {
                for step in 0..ringCount(ring) {
                    let ro = ringOffset(ring, step)
                    let cx = camCellX + ro.x
                    let cz = camCellZ + ro.z
                    if cx < cellX0 || cx > cellX1 || cz < cellZ0 || cz > cellZ1 {
                        continue
                    }
                    // Reject the whole cell before touching its contents. Half
                    // the searched square is behind the camera, and a cell is
                    // sixteen buildings.
                    let cellMidX = unfold(kx, w.city.gridX0 + ((cx as f64) + 0.5) * w.city.gridStep, reach)
                    let cellMidZ = unfold(kz, w.city.gridZ0 + ((cz as f64) + 0.5) * w.city.gridStep, reach)
                    let cdx = cellMidX - w.cam.x
                    let cdz = cellMidZ - w.cam.z
                    if cdx * fwdX + cdz * fwdZ < 0.0 - (BUILDING_MARGIN + w.city.gridStep) {
                        continue
                    }
                    let creach = far + BUILDING_MARGIN + w.city.gridStep
                    if cdx * cdx + cdz * cdz > creach * creach {
                        continue
                    }
                    let ci = cz * w.city.gridN + cx
                    for slot in w.city.cellStart[ci]..w.city.cellStart[ci + 1] {
                        let b = w.city.cellItems[slot]
                        if w.city.bSkip[b] {
                            continue
                        }
                        let midX = unfold(kx, (w.city.bMinX[b] + w.city.bMaxX[b]) * 0.5, reach)
                        let midZ = unfold(kz, (w.city.bMinZ[b] + w.city.bMaxZ[b]) * 0.5, reach)
                        let dx = midX - w.cam.x
                        let dz = midZ - w.cam.z
                        if dx * fwdX + dz * fwdZ < 0.0 - 200.0 {
                            continue
                        }
                        let d2 = dx * dx + dz * dz
                        if d2 > far * far {
                            continue
                        }
                        // Drop what would be smaller than a pixel or two. A city
                        // is mostly two-storey houses, and at a kilometre out
                        // they cost as much as the towers and show nothing.
                        let hgt = w.city.bHeight[b]
                        let d = Math.sqrt(d2) + 1.0
                        // About six pixels tall at a 720p vertical field of view.
                        // It was 0.0055 — three pixels — and in a city the size of
                        // Manhattan the difference is thousands of prisms a frame,
                        // each of them recorded, uploaded and rasterised twice, to
                        // show a smudge.
                        if hgt / d < 0.010 {
                            continue
                        }
                        // The box stands in for the real outline only once the
                        // building is small on screen. A flat distance did not
                        // mean that: a 200 m footprint at 800 m fills a quarter
                        // of the frame, and swapping its outline for a rectangle
                        // there is the shape-change you can watch happen as you
                        // fly in. Scale the switch by the footprint instead, so
                        // what pops is always something a few pixels across.
                        let ext = Math.maxF64(w.city.bMaxX[b] - w.city.bMinX[b], w.city.bMaxZ[b] - w.city.bMinZ[b])
                        prism(&mut s, w, v, facade, &mut px, &mut pz, b, kx, kz, reach, reversed, midX, midZ, d > Math.maxF64(780.0, ext * 26.0))
                    }
                }
            }
        }
    }
}

// World position of local coordinate `u`'s inverse: given a world coordinate,
// where it sits inside reflected copy k.
fn localOf(k: i64, world: f64, reach: f64): f64 {
    let base = (k as f64) * reach * 2.0
    if k % 2 == 0 {
        return world - base
    }
    return base - world
}

fn pushPt(px: &mut Vec<f64>, pz: &mut Vec<f64>, kx: i64, kz: i64, reach: f64, x: f64, z: f64) {
    px.push(unfold(kx, x, reach))
    pz.push(unfold(kz, z, reach))
}

fn prism(s: &mut Scene, w: &World, v: &View, facade: &Texture, px: &mut Vec<f64>, pz: &mut Vec<f64>, b: i64, kx: i64, kz: i64, reach: f64, reversed: bool, midX: f64, midZ: f64, lod: bool) {
    let n = w.city.bLen[b]
    if n < 3 {
        return
    }
    let start = w.city.bStart[b]
    // One ground height for the whole footprint. Sampling per corner would sink
    // a corner of every building on a San Francisco hill into the road.
    let ground = heightAt(w.city, midX, midZ)
    // A part of a building starts partway up it (OSM `min_height`), and the two
    // metres of sink that keep a ground-founded footprint out of the road would
    // hang a setback two metres into the slab below it.
    let base = cityBase(w.city, b)
    var y0 = ground - 2.0
    if base > 0.1 {
        y0 = ground + base
    }
    let y1 = ground + w.city.bHeight[b]

    // Concrete, brick and glass, picked off the building id so a given building
    // is always the same colour and a street is not uniform.
    let tint = propHash(b, b * 31 + 7)
    var wall = rgb(0.36, 0.36, 0.37).lerp(rgb(0.52, 0.50, 0.47), tint)
    // Anything this tall is a curtain wall, and a curtain wall is mostly a
    // MIRROR — its own colour barely matters because most of what leaves it is
    // reflected sky. So the albedo goes dark and blue and the shader does the
    // rest; painting glass a light grey and lighting it diffusely is what makes
    // rendered towers look like concrete with windows drawn on.
    var glass = 0.0
    if w.city.bHeight[b] > 45.0 {
        // Curtain walls are not all the same glass, and a skyline where they are
        // reads as one building repeated. Three families, off the building id so a
        // given tower is always itself: mostly the cool blue-green of standard
        // low-E coating, a bronze minority from the seventies, and a few near-black
        // mirrors. The albedo stays dark in every case — what differs is the tint
        // it lends to the sky it reflects.
        let g = propHash(b, b * 17 + 3)
        if g < 0.12 {
            wall = rgb(0.13, 0.09, 0.05).lerp(rgb(0.20, 0.14, 0.07), tint)
        } else if g < 0.24 {
            wall = rgb(0.03, 0.03, 0.04).lerp(rgb(0.06, 0.06, 0.07), tint)
        } else {
            wall = rgb(0.05, 0.10, 0.11).lerp(rgb(0.09, 0.16, 0.18), tint)
        }
        // How mirrored, by height. A twelve-storey block with punched windows is
        // only slightly reflective; a four-hundred-metre tower is a mirror. Riding
        // this on the same float the flag uses means the shader gets the strength
        // for free — see the `tw` note at the wall vertices.
        glass = Math.clampF64((w.city.bHeight[b] - 40.0) / 130.0, 0.34, 1.0)
    }
    // What the roof is, as opposed to what the walls are. Defaults to the wall
    // material for a place with no aerial photograph to sample.
    var roofTop = wall
    if w.city.orthoLoaded {
        // The photograph is looking straight down at this roof, so it already
        // knows what colour it is. Painting fifteen thousand roofs one invented
        // grey was most of what made a real city read as polystyrene — the drape
        // underneath was varied and the boxes standing on it were not.
        let lmx = (w.city.bMinX[b] + w.city.bMaxX[b]) * 0.5
        let lmz = (w.city.bMinZ[b] + w.city.bMaxZ[b]) * 0.5
        // Five samples across the footprint, not one at its centre.
        //
        // One was fine while the drape was 7.8 m a texel, because at that size a
        // texel is already an average over most of a roof. At 3.9 m it is not: a
        // single lookup can land on a rooftop plant room, a skylight or the
        // building's own shadow, and that one texel then paints the entire
        // building. Averaging over the footprint restores what the coarse drape
        // was giving by accident, and does it on purpose.
        let qx = (w.city.bMaxX[b] - w.city.bMinX[b]) * 0.25
        let qz = (w.city.bMaxZ[b] - w.city.bMinZ[b]) * 0.25
        var rs = cityOrthoLocal(w.city, lmx, lmz)
        let s1 = cityOrthoLocal(w.city, lmx - qx, lmz - qz)
        let s2 = cityOrthoLocal(w.city, lmx + qx, lmz - qz)
        let s3 = cityOrthoLocal(w.city, lmx - qx, lmz + qz)
        let s4 = cityOrthoLocal(w.city, lmx + qx, lmz + qz)
        let roofCol = rgb((rs.r + s1.r + s2.r + s3.r + s4.r) / 5.0, (rs.g + s1.g + s2.g + s3.g + s4.g) / 5.0, (rs.b + s1.b + s2.b + s3.b + s4.b) / 5.0)
        // Lifted off the raw sample: the texel already carries the sun that lit
        // it, and it is about to be multiplied by a wall's shading term too.
        let roofLit = roofCol.scale(1.35)
        // The ROOF takes the photograph. The WALLS do not, and that was the bug
        // behind every building looking like an old dark warehouse: one colour was
        // sampled from the drape and used for both, so every façade in every city
        // was painted the colour of its own roof — which from directly above is
        // tar, gravel and air handlers. Roofs really are that colour; walls are
        // not, and a glass tower least of all.
        //
        // Low buildings keep half of it, because a photograph still carries
        // something true about a neighbourhood: brick blocks and white stucco do
        // differ, and losing that entirely made a city uniform in the other
        // direction.
        roofTop = roofLit
        if glass < 0.5 {
            wall = wall.lerp(roofLit, 0.5)
        }
    }

    px.clear()
    pz.clear()
    // Far enough away, a fourteen-sided footprint and its bounding box are the
    // same handful of pixels. Past that distance the real outline is spent on
    // nothing, and a city is mostly far away — so swap in the box and keep the
    // saved triangles for the skyline, which is what you can actually see.
    if lod {
        let x0 = w.city.bMinX[b]
        let x1 = w.city.bMaxX[b]
        let z0 = w.city.bMinZ[b]
        let z1 = w.city.bMaxZ[b]
        pushPt(&mut px, &mut pz, kx, kz, reach, x0, z0)
        pushPt(&mut px, &mut pz, kx, kz, reach, x1, z0)
        pushPt(&mut px, &mut pz, kx, kz, reach, x1, z1)
        pushPt(&mut px, &mut pz, kx, kz, reach, x0, z1)
    } else {
        for i in 0..n {
            pushPt(&mut px, &mut pz, kx, kz, reach, w.city.bPtX[start + i], w.city.bPtZ[start + i])
        }
    }
    // A mirrored copy flips the winding, and the rasteriser backface-culls, so
    // reverse the ring to flip it back. Done once here rather than per face.
    if reversed {
        var lo = 0
        var hi = px.len - 1
        while lo < hi {
            let tx = px[lo]
            let tz = pz[lo]
            px[lo] = px[hi]
            pz[lo] = pz[hi]
            px[hi] = tx
            pz[hi] = tz
            lo = lo + 1
            hi = hi - 1
        }
    }
    let m = px.len

    for i in 0..m {
        var j = i + 1
        if j == m {
            j = 0
        }
        let ex = px[j] - px[i]
        let ez = pz[j] - pz[i]
        let el = Math.sqrt(ex * ex + ez * ez)
        if el < 0.4 {
            continue
        }
        // Outward normal of a counter-clockwise ring, in the xz plane.
        let nx = ez / el
        let nz = 0.0 - ex / el
        let lt = shade(s, nx, 0.0, nz, 0.42)
        // UVs in metres over a storey height, so windows keep their real size
        // whatever the building is. STOREY also sets the texture's repeat, and
        // the tile holds 8 storeys, so a wall always breaks on a floor line.
        let STOREY = 3.6
        let fu = el / STOREY / 8.0
        let fv = (y1 - y0) / STOREY / 8.0
        // Street-level darkening. Real streets are canyons and the bottom of a
        // wall sees almost no sky; without it every building looks like it is
        // floating a little off the ground.
        let ao = lt * 0.45
        // `tw` carries two things: 1 means "textured", and 2 means "textured AND
        // glass". Riding the flag on an existing float keeps the vertex at ten
        // floats — a eleventh would have meant touching the layout, the mesh
        // attributes and every push site to say one bit.
        let wtw = 1.0 + glass
        let a0 = vtxC(px[i], y0, pz[i], 0.0, 0.0, ao, 1.0, 1.0, 1.0, wtw)
        let a1 = vtxC(px[i], y1, pz[i], 0.0, fv, lt, 1.0, 1.0, 1.0, wtw)
        let b1 = vtxC(px[j], y1, pz[j], fu, fv, lt, 1.0, 1.0, 1.0, wtw)
        let b0 = vtxC(px[j], y0, pz[j], fu, 0.0, ao, 1.0, 1.0, 1.0, wtw)
        triangleV(&mut s, v, facade, a0, a1, b1, wall.r, wall.g, wall.b)
        triangleV(&mut s, v, facade, a0, b1, b0, wall.r, wall.g, wall.b)
    }

    // Roof. Flat is a fan wound the opposite way round from the base ring, which
    // is what makes it face up rather than down; a shaped roof is built on top of
    // that ring instead. Shapes are dropped at LOD range — a pyramid four pixels
    // tall and a flat top four pixels tall are the same four pixels.
    let roof = roofTop.scale(shade(s, 0.0, 1.0, 0.0, 0.42) * 1.06)
    let kind = cityRoofKind(w.city, b)
    var rh = cityRoofHeight(w.city, b)
    // The roof eats into the height rather than sitting on top of it: OSM's
    // `height` is to the tip of the pyramid, not to the eaves under it.
    if rh > (y1 - y0) * 0.95 {
        rh = (y1 - y0) * 0.95
    }
    if lod || kind == ROOF_FLAT || rh < 0.5 {
        let a = v3(px[0], y1, pz[0])
        for i in 1..(m - 1) {
            triangle(&mut s, v, a, v3(px[i + 1], y1, pz[i + 1]), v3(px[i], y1, pz[i]), roof)
        }
        return
    }
    shapedRoof(&mut s, v, px, pz, m, y1 - rh, y1, kind, roof, roofTop)
}

// The roof shapes OSM tags and this renderer builds, standing on the ring the
// walls just finished at `yEave` and reaching `yTop`.
//
// Every one of them is the same construction: take the wall ring, make a second
// ring above it — collapsed to a point, shrunk, or squashed onto a ridge line —
// and skin between the two. That keeps the winding rule identical to the walls'
// (ring point i, up, ring point j) so a mirrored copy of the map needs no
// special case here either.
fn shapedRoof(s: &mut Scene, v: &View, px: &Vec<f64>, pz: &Vec<f64>, m: i64, yEave: f64, yTop: f64, kind: u8, roof: &Rgb, col: &Rgb) {
    // Centroid of the ring: the apex of a pyramid, the pole of a dome, and the
    // point everything shrinks toward for a hipped roof.
    var cx = 0.0
    var cz = 0.0
    for i in 0..m {
        cx = cx + px[i]
        cz = cz + pz[i]
    }
    cx = cx / (m as f64)
    cz = cz / (m as f64)
    let side = col.scale(shade(s, 0.7, 0.6, 0.0, 0.42) * 1.02)

    if kind == ROOF_PYRAMIDAL {
        let apex = v3(cx, yTop, cz)
        for i in 0..m {
            var j = i + 1
            if j == m {
                j = 0
            }
            triangle(&mut s, v, v3(px[i], yEave, pz[i]), apex, v3(px[j], yEave, pz[j]), side)
        }
        return
    }
    if kind == ROOF_DOME {
        // Three lifts of a quarter-circle profile, capped with a fan. More reads
        // as a sphere from the air; fewer reads as a cone.
        let LIFTS = 4
        var prevK = 1.0
        var prevY = yEave
        for l in 1..LIFTS + 1 {
            let t = (l as f64) / (LIFTS as f64)
            // x = cos, y = sin of a quarter turn: the profile of a dome.
            let k = Math.cos(t * 1.5707963)
            let y = yEave + (yTop - yEave) * Math.sin(t * 1.5707963)
            for i in 0..m {
                var j = i + 1
                if j == m {
                    j = 0
                }
                let a0 = v3(cx + (px[i] - cx) * prevK, prevY, cz + (pz[i] - cz) * prevK)
                let a1 = v3(cx + (px[i] - cx) * k, y, cz + (pz[i] - cz) * k)
                let b1 = v3(cx + (px[j] - cx) * k, y, cz + (pz[j] - cz) * k)
                let b0 = v3(cx + (px[j] - cx) * prevK, prevY, cz + (pz[j] - cz) * prevK)
                triangle(&mut s, v, a0, a1, b1, side)
                triangle(&mut s, v, a0, b1, b0, side)
            }
            prevK = k
            prevY = y
        }
        return
    }
    if kind == ROOF_HIPPED {
        // One inward step, then a flat cap: the shape of a hip roof seen from
        // anywhere but a lawn.
        let k = 0.45
        for i in 0..m {
            var j = i + 1
            if j == m {
                j = 0
            }
            let a0 = v3(px[i], yEave, pz[i])
            let a1 = v3(cx + (px[i] - cx) * k, yTop, cz + (pz[i] - cz) * k)
            let b1 = v3(cx + (px[j] - cx) * k, yTop, cz + (pz[j] - cz) * k)
            let b0 = v3(px[j], yEave, pz[j])
            triangle(&mut s, v, a0, a1, b1, side)
            triangle(&mut s, v, a0, b1, b0, side)
        }
        let a = v3(cx + (px[0] - cx) * k, yTop, cz + (pz[0] - cz) * k)
        for i in 1..(m - 1) {
            triangle(&mut s, v, a, v3(cx + (px[i + 1] - cx) * k, yTop, cz + (pz[i + 1] - cz) * k), v3(cx + (px[i] - cx) * k, yTop, cz + (pz[i] - cz) * k), roof)
        }
        return
    }
    // Gabled: a ridge over the long axis of the footprint. Each wall-top point
    // rises to the nearest end of the ridge, which gives two slopes and two
    // gable ends on anything rectangular and something sane on anything else.
    var x0 = px[0]
    var x1 = px[0]
    var z0 = pz[0]
    var z1 = pz[0]
    for i in 1..m {
        if px[i] < x0 {
            x0 = px[i]
        }
        if px[i] > x1 {
            x1 = px[i]
        }
        if pz[i] < z0 {
            z0 = pz[i]
        }
        if pz[i] > z1 {
            z1 = pz[i]
        }
    }
    var alongX = true
    if z1 - z0 > x1 - x0 {
        alongX = false
    }
    for i in 0..m {
        var j = i + 1
        if j == m {
            j = 0
        }
        var ri = v3(cx, yTop, pz[i])
        var rj = v3(cx, yTop, pz[j])
        if alongX {
            ri = v3(px[i], yTop, cz)
            rj = v3(px[j], yTop, cz)
        }
        triangle(&mut s, v, v3(px[i], yEave, pz[i]), ri, rj, side)
        triangle(&mut s, v, v3(px[i], yEave, pz[i]), rj, v3(px[j], yEave, pz[j]), side)
    }
}

// A ring: a tube of quads swept around a circle, standing across the course so
// you can see which way to be pointing when you reach it. Cleared rings expand
// and fade instead of vanishing.
fn drawRings(s: &mut Scene, w: &World, v: &View) {
    let segs = 22
    let tube = 5.0
    for i in 0..w.rings.len {
        // A landmark beacon is a column of light, drawn in drawMarkBeam after the
        // geometry pass so it shows through whatever is in front of it. There is
        // no hoop to draw here.
        if w.rings[i].beacon {
            continue
        }
        var rad = w.rings[i].r
        var br = 1.0
        var col = rgb(1.5, 1.15, 0.25)
        if w.rings[i].bonus {
            col = rgb(0.30, 1.05, 1.75)
        }
        if !w.rings[i].alive {
            rad = w.rings[i].r * (1.0 + (1.0 - w.rings[i].pop) * 1.2)
            br = w.rings[i].pop
            col = rgb(0.5, 1.7, 0.7)
            if br <= 0.03 {
                continue
            }
        }
        let centre = v3(w.rings[i].x, w.rings[i].y, w.rings[i].z)
        // The hoop stands across the course: its normal points along `face`, and
        // the tube is swept around the two axes perpendicular to that.
        let across = v3(Math.cos(w.rings[i].face), 0.0, 0.0 - Math.sin(w.rings[i].face))
        let upward = v3(0.0, 1.0, 0.0)
        let step = TAU / (segs as f64)
        for k in 0..segs {
            let a0 = (k as f64) * step
            let a1 = ((k + 1) as f64) * step
            // one radial direction per segment end, in the hoop's own plane
            let d0 = across.scale(Math.cos(a0)) + upward.scale(Math.sin(a0))
            let d1 = across.scale(Math.cos(a1)) + upward.scale(Math.sin(a1))
            let outer0 = centre + d0.scale(rad + tube)
            let inner0 = centre + d0.scale(rad - tube)
            let outer1 = centre + d1.scale(rad + tube)
            let inner1 = centre + d1.scale(rad - tube)
            // banded colour so the hoop reads as a solid object, not a circle
            var band = 1.0
            if k % 2 == 0 {
                band = 0.72
            }
            let front = col.scale(band * br)
            let back = front.scale(0.6)
            // both faces, so the ring is solid from either side
            triangle(&mut s, v, outer0, outer1, inner0, front)
            triangle(&mut s, v, inner0, outer1, inner1, front)
            triangle(&mut s, v, outer1, outer0, inner0, back)
            triangle(&mut s, v, outer1, inner0, inner1, back)
        }
    }
}

// Contrails: project each stored point and join consecutive ones. Drawn without
// depth test, which is fine — they are thin, bright, and always near the camera.
fn drawTrails(c: &mut Canvas, w: &World, v: &View) {
    drawOneTrail(&mut c, w.trailL, v)
    drawOneTrail(&mut c, w.trailR, v)
}

fn drawOneTrail(c: &mut Canvas, t: &Vec<Trail>, v: &View) {
    if t.len < 2 {
        return
    }
    for i in 0..t.len - 1 {
        let a = toCamera(v, t[i].x, t[i].y, t[i].z)
        let b = toCamera(v, t[i + 1].x, t[i + 1].y, t[i + 1].z)
        if a.z < 1.0 || b.z < 1.0 {
            continue
        }
        let ax = v.cx + a.x * v.scale / a.z
        let ay = v.cy - a.y * v.scale / a.z
        let bx = v.cx + b.x * v.scale / b.z
        let by = v.cy - b.y * v.scale / b.z
        let f = Math.minF64(t[i].life, 1.0) * 0.55
        line(&mut c, ax, ay, bx, by, f, f * 1.05, f * 1.15)
    }
}

// Sparks are camera-facing quads, so they stay visible whatever angle you clear
// the ring at.
fn drawSparks(c: &mut Canvas, w: &World, v: &View) {
    for i in 0..w.sparks.len {
        let p = toCamera(v, w.sparks[i].x, w.sparks[i].y, w.sparks[i].z)
        if p.z < 1.0 {
            continue
        }
        let sx = v.cx + p.x * v.scale / p.z
        let sy = v.cy - p.y * v.scale / p.z
        let t = w.sparks[i].life / w.sparks[i].maxLife
        let size = Math.clampF64(v.scale * 1.6 / p.z, 1.2, 14.0) * (0.4 + t)
        let f = t * t
        spot(&mut c, sx, sy, size, w.sparks[i].cr * f, w.sparks[i].cg * f, w.sparks[i].cb * f)
    }
}

// Birds: a flapping V per bird, drawn as two short lines in screen space. At the
// distance these appear, a silhouette is all there is to see — geometry would be
// invisible detail at a real cost.
//
// Depth-tested by hand against the z-buffer, because `line` writes straight to
// the canvas. Without the test a flock behind a ridge draws over the ridge.
// Does the line from the eye to this point pass under the ground?
//
// Six samples, biased toward the far end because that is where a ridge actually
// intervenes — near the camera the ray is barely above the eye and a sample there
// only ever finds the hill the aircraft is already over.
fn rayHitsGround(w: &World, v: &View, px: f64, py: f64, pz: f64): bool {
    for i in 1..7 {
        let t = (i as f64) / 7.0
        let x = v.eye.x + (px - v.eye.x) * t
        let y = v.eye.y + (py - v.eye.y) * t
        let z = v.eye.z + (pz - v.eye.z) * t
        if y < heightAt(w.city, x, z) {
            return true
        }
    }
    return false
}

fn drawBirds(c: &mut Canvas, _s: &Scene, w: &World, v: &View) {
    for i in 0..w.flocks.len {
        let f = w.flocks[i]
        // fade in and out so a flock does not blink into existence
        var vis = 1.0
        if f.life < 2.0 {
            vis = f.life / 2.0
        }
        if f.life > 42.5 {
            vis = (44.0 - f.life) / 1.5
        }
        if vis <= 0.0 {
            continue
        }
        // heading, so the V points the way the flock is going
        let sp = Math.sqrt(f.vx * f.vx + f.vz * f.vz) + 0.0001
        for k in 0..f.n {
            // A rough echelon: each bird trails behind and to the side of the
            // one before it, which is the shape a flock actually flies in.
            let kk = k as f64
            let row = kk * 0.5
            let lat = (kk - (f.n as f64) * 0.5) * 13.0
            let bx = f.x - (f.vx / sp) * row * 17.0 + (0.0 - f.vz / sp) * lat
            let bz = f.z - (f.vz / sp) * row * 17.0 + (f.vx / sp) * lat
            let by = f.y + Math.sin(w.time * 1.3 + kk * 0.9 + f.seed) * 5.0
            let p = toCamera(v, bx, by, bz)
            if p.z < 4.0 {
                continue
            }
            let inv = 1.0 / p.z
            let sx = v.cx + p.x * v.scale * inv
            let sy = v.cy - p.y * v.scale * inv
            if sx < 0.0 || sy < 0.0 || sx >= (c.w as f64) || sy >= (c.h as f64) {
                continue
            }
            // Occlusion, against the terrain rather than against a depth buffer.
            // The depth buffer is the driver's now and reading it back would stall
            // the pipeline for one bird; walking the ray over the heightfield the
            // terrain was built from costs six lookups and answers the same
            // question — is there a hill between the camera and this bird.
            if rayHitsGround(w, v, bx, by, bz) {
                continue
            }
            // wingspan in pixels; below a pixel there is nothing to draw
            let span = v.scale * 4.6 * inv
            if span < 0.7 {
                continue
            }
            // each bird flaps on its own phase
            let flap = Math.sin(w.time * 7.5 + kk * 1.7 + f.seed * 6.0)
            let dy = 0.0 - span * 0.45 * flap
            // Darkening, not additive: a bird is a silhouette against the sky.
            // Fades with distance so far birds are specks rather than dots.
            // Strong: the 2x2 coverage in darkLine spreads each step over four
            // pixels and the bloom pass then lifts them back toward the sky, so a
            // gentle value disappears entirely. Doubled up a pixel down for
            // thickness once the bird is big enough to warrant it.
            let dark = 0.92 * vis * Math.minF64(1.0, span * 0.7)
            darkLine(&mut c, sx - span, sy + dy, sx, sy, dark)
            darkLine(&mut c, sx, sy, sx + span, sy + dy, dark)
            if span > 3.0 {
                darkLine(&mut c, sx - span, sy + dy + 1.0, sx, sy + 1.0, dark * 0.8)
                darkLine(&mut c, sx, sy + 1.0, sx + span, sy + dy + 1.0, dark * 0.8)
            }
        }
    }
}

// The aircraft: a fighter with real volume — a faceted nose, a raised spine, a
// belly, LERX strakes into swept wings, twin tailfins and two engine nozzles.
// Body-space points are (forward, right, up) offsets, transformed once.
fn drawPlane(c: &mut Canvas, s: &mut Scene, w: &World, v: &View, skin: &Texture) {
    // The airframe is generated, not listed — see plane.milo. The stick position
    // is passed in so the control surfaces move with it; there is no input record
    // on the Plane, so it is inferred from the attitude the flight model is
    // holding, which is what those surfaces would be doing to hold it.
    let ail = Math.clampF64(w.plane.roll * 1.4, 0.0 - 1.0, 1.0)
    let elev = Math.clampF64(w.plane.pitch * 1.8, 0.0 - 1.0, 1.0)
    drawAirframe(&mut s, w, v, skin, ail, elev)

    // The burner glow stays a 2D additive splat: it is light in the air, not a
    // surface, and a splat with no depth is both cheaper and more correct than
    // geometry for that.
    let f = frameOf(w.plane.yaw, w.plane.pitch, w.plane.roll)
    let origin = v3(w.plane.x, w.plane.y, w.plane.z)
    // twin nozzles, glowing with throttle
    let k = (w.plane.speed - 170.0) / 170.0
    for side in 0..2 {
        var off = 4.0
        if side == 1 {
            off = 0.0 - 4.0
        }
        let nozzle = origin - f.fwd.scale(21.0) + f.right.scale(off)
        let ep = toCameraV(v, nozzle)
        if ep.z > 1.0 {
            let sx = v.cx + ep.x * v.scale / ep.z
            let sy2 = v.cy - ep.y * v.scale / ep.z
            let px2 = Math.clampF64(v.scale * 3.2 / ep.z, 2.0, 26.0)
            let ab = w.boostBlend
            spot(&mut c, sx, sy2, px2 * (1.4 + k + ab * 3.4), 0.9 + k * 1.2 + ab * 1.6, 0.32 + k * 0.5 + ab * 0.5, 0.10)
            spot(&mut c, sx, sy2, px2 * (0.55 + ab * 1.1), 1.8 + k + ab * 1.5, 1.2 + k + ab, 0.7 + ab * 0.6)
        }
    }
}

// Two triangles from four corner indices, sharing the diagonal.
fn quadT(s: &mut Scene, v: &View, t: &Texture, p: &Vec<Vec3>, a: i64, b: i64, d: i64, e: i64, ua: f64, va: f64, ub: f64, vb: f64, ud: f64, vd: f64, ue: f64, ve: f64, col: &Rgb) {
    triT(&mut s, v, t, p, a, b, d, ua, va, ub, vb, ud, vd, col)
    triT(&mut s, v, t, p, a, d, e, ua, va, ud, vd, ue, ve, col)
}

// A point on the aircraft, given as an offset along its own axes: how far
// forward, how far right, how far up. Sixteen parameters became four.
fn bodyPt(p: &mut Vec<Vec3>, origin: &Vec3, f: &Frame, fwd: f64, right: f64, up: f64) {
    p.push(origin + f.fwd.scale(fwd) + f.right.scale(right) + f.up.scale(up))
}

// Textured variant: the three UVs pick which patch of the skin sheet this facet
// wears, so panel lines and the spine stripe land where they should.
fn triT(s: &mut Scene, v: &View, t: &Texture, p: &Vec<Vec3>, a: i64, b: i64, d: i64, ua: f64, va: f64, ub: f64, vb: f64, ud: f64, vd: f64, col: &Rgb) {
    triangleV(&mut s, v, t, vtx(p[a].x, p[a].y, p[a].z, ua, va, 1.0), vtx(p[b].x, p[b].y, p[b].z, ub, vb, 1.0), vtx(p[d].x, p[d].y, p[d].z, ud, vd, 1.0), col.r, col.g, col.b)
}

// A reticle on the next coin, and an edge arrow when it is off screen. Without
// this the trail is easy to lose the moment you overshoot one.
pub fn drawGuide(c: &mut Canvas, w: &World, v: &View) {
    // Hoops only. Over a real place the single live "ring" is the landmark
    // beacon, which has its own marker in drawMarkGuide — this was drawing a
    // second reticle, in a second colour, on the same target.
    if w.city.loaded || w.intro > 0.0 {
        return
    }
    // nearest live coin ahead
    var bi = 0 - 1
    var bd = 1.0e18
    let fwdX = Math.sin(w.plane.yaw)
    let fwdZ = Math.cos(w.plane.yaw)
    for i in 0..w.rings.len {
        if w.rings[i].alive {
            let dx = w.rings[i].x - w.plane.x
            let dy = w.rings[i].y - w.plane.y
            let dz = w.rings[i].z - w.plane.z
            // Only rings still in front. Nearest-by-distance alone will happily
            // pick one you have already flown past and point you backwards.
            if dx * fwdX + dz * fwdZ < 0.0 - 40.0 {
                continue
            }
            let d = dx * dx + dy * dy + dz * dz
            if d < bd {
                bd = d
                bi = i
            }
        }
    }
    if bi < 0 {
        return
    }
    let p = toCamera(v, w.rings[bi].x, w.rings[bi].y, w.rings[bi].z)
    let pulse = 0.65 + 0.35 * Math.sin(w.time * 6.0)
    if p.z > 1.0 {
        let sx = v.cx + p.x * v.scale / p.z
        let sy = v.cy - p.y * v.scale / p.z
        if sx > 8.0 && sx < (c.w as f64) - 8.0 && sy > 8.0 && sy < (c.h as f64) - 8.0 {
            let r = Math.clampF64(900.0 / p.z, 16.0, 90.0)
            let a = 0.30 * r
            // four corner brackets
            line(&mut c, sx - r, sy - r + a, sx - r, sy - r, 0.4 * pulse, 1.2 * pulse, 0.5 * pulse)
            line(&mut c, sx - r, sy - r, sx - r + a, sy - r, 0.4 * pulse, 1.2 * pulse, 0.5 * pulse)
            line(&mut c, sx + r, sy - r + a, sx + r, sy - r, 0.4 * pulse, 1.2 * pulse, 0.5 * pulse)
            line(&mut c, sx + r, sy - r, sx + r - a, sy - r, 0.4 * pulse, 1.2 * pulse, 0.5 * pulse)
            line(&mut c, sx - r, sy + r - a, sx - r, sy + r, 0.4 * pulse, 1.2 * pulse, 0.5 * pulse)
            line(&mut c, sx - r, sy + r, sx - r + a, sy + r, 0.4 * pulse, 1.2 * pulse, 0.5 * pulse)
            line(&mut c, sx + r, sy + r - a, sx + r, sy + r, 0.4 * pulse, 1.2 * pulse, 0.5 * pulse)
            line(&mut c, sx + r, sy + r, sx + r - a, sy + r, 0.4 * pulse, 1.2 * pulse, 0.5 * pulse)
            return
        }
    }
    // off screen (or behind): pin an arrow on the edge pointing the way to turn
    var dirX = p.x
    var dirY = 0.0 - p.y
    if p.z <= 1.0 {
        dirY = 0.0
    }
    let l = Math.sqrt(dirX * dirX + dirY * dirY) + 0.001
    dirX = dirX / l
    dirY = dirY / l
    let rad = Math.minF64((c.w as f64), (c.h as f64)) * 0.36
    let ax = v.cx + dirX * rad
    let ay = v.cy + dirY * rad
    let px2 = 0.0 - dirY
    let py2 = dirX
    line(&mut c, ax + dirX * 20.0, ay + dirY * 20.0, ax + px2 * 12.0, ay + py2 * 12.0, 0.5 * pulse, 1.3 * pulse, 0.6 * pulse)
    line(&mut c, ax + dirX * 20.0, ay + dirY * 20.0, ax - px2 * 12.0, ay - py2 * 12.0, 0.5 * pulse, 1.3 * pulse, 0.6 * pulse)
    line(&mut c, ax - px2 * 12.0, ay - py2 * 12.0, ax + px2 * 12.0, ay + py2 * 12.0, 0.4 * pulse, 1.0 * pulse, 0.5 * pulse)
}

// Where the next landmark is. Brackets over it when it is in view, an arrow
// pinned to the screen edge pointing the way to turn when it is not — without
// this the HUD names a place and gives no clue which way to look, which is worse
// than saying nothing.
// The column of light standing on the current landmark, and the circle on the
// ground you have to fly over to arrive.
//
// A real column, not a stroke: it is sampled across its own width in WORLD
// metres, so it stands forty metres wide however far away it is — wide and soft
// close up, a thread on the horizon. Drawn additively AFTER the geometry has been
// flushed, so it shows through the ridge or the tower block between you and the
// subject. That is deliberate and it is the whole reason this replaced a hoop: a
// destination you cannot see is not a destination, and over a real city something
// is nearly always in the way.
pub fn drawMarkBeam(c: &mut Canvas, w: &World, v: &View) {
    if !w.city.loaded || w.showT > 0.0 {
        return
    }
    // The beam stays up through the survey — it is the one thing the opening
    // shot is establishing, and it is scenery rather than UI.
    for i in 0..w.rings.len {
        if !w.rings[i].beacon || !w.rings[i].alive {
            continue
        }
        let bx = w.rings[i].x
        let bz = w.rings[i].z
        let by = w.rings[i].y
        // Slow pulse, so a beam reads as a signal rather than as scenery.
        let pulse = 0.72 + 0.28 * Math.sin(w.time * 2.4)
        let dxc = bx - w.cam.x
        let dzc = bz - w.cam.z
        let dist = Math.sqrt(dxc * dxc + dzc * dzc)
        // Fade with distance so a beam eight kilometres off is a hint rather than
        // a floodlight, but never all the way out — the point is to be findable.
        var fade = 1.0 - dist / 14000.0
        if fade < 0.48 {
            fade = 0.48
        }
        let k = pulse * fade
        // Tall enough to clear the Koolau from the far side of the map, and to
        // stand well above the tallest thing anyone has built.
        let TOP = 1800.0
        // Wide enough to read as a landmark from the far side of the map. At 22 m
        // it was a thread against a city of 300 m towers — the thing it competes
        // with for attention is the skyline, not the sky.
        let RADIUS = 52.0
        // One sample per screen pixel of half-width, so the column is solid close
        // up without paying for samples that land on the same pixel far away. A
        // fixed count banded into visible stripes the moment you flew near one.
        // Never allowed to subtend less than this on screen. A column of a fixed
        // width in metres is a hairline at eight kilometres — which is exactly
        // the range at which it is the only thing telling you where to go.
        let MIN_PIX = 9.0
        let wide = Math.maxF64(RADIUS, MIN_PIX * dist / v.scale)
        var CROSS = ((wide * v.scale / Math.maxF64(dist, 1.0)) as i64) + 3
        if CROSS > 64 {
            CROSS = 64
        }
        if CROSS < 5 {
            CROSS = 5
        }
        let LIFTS = 7 // vertical segments, so the column can fade out as it rises
        // Billboarded on the camera's own right vector: a column has no preferred
        // side, and facing the viewer is what keeps its width constant as you
        // circle it.
        let right = v.right
        for step in 0 - CROSS..CROSS + 1 {
            let frac = (step as f64) / (CROSS as f64)
            // Round falloff, bright core, soft edge — a cylinder of light seen
            // through air, rather than a flat card.
            var across = 1.0 - frac * frac
            if across <= 0.0 {
                continue
            }
            across = across * Math.sqrt(across)
            // A hot white core inside a blue column: the core is what makes it
            // read as light rather than as a painted cylinder, and it is narrow
            // enough that the beam still reads blue from a distance.
            let core = Math.maxF64(0.0, 1.0 - Math.abs(frac) * 4.0)
            let ox = right.x * frac * wide
            let oz = right.z * frac * wide
            for seg in 0..LIFTS {
                let t0 = (seg as f64) / (LIFTS as f64)
                let t1 = ((seg + 1) as f64) / (LIFTS as f64)
                // Dissolves toward the top instead of ending on a hard edge.
                let up = (1.0 - t0) * (1.0 - t0)
                let amp = k * across * up * 1.10
                if amp < 0.004 {
                    continue
                }
                let a = toCamera(v, bx + ox, by + TOP * t0, bz + oz)
                let b = toCamera(v, bx + ox, by + TOP * t1, bz + oz)
                let hot = core * up * k * 0.9
                beamSeg(&mut c, v, a, b, (0.22 + hot) * amp, (0.62 + hot) * amp, (1.85 + hot) * amp)
            }
        }
        // The circle on the ground is the collection radius, drawn where it is:
        // fly over the inside of it and the landmark is yours.
        // Two rings rather than one, the inner one turning: a single static
        // circle on a photographic drape is easy to lose, and the rotation is
        // what tells you at a glance that this is the live target.
        groundRing(&mut c, w, v, bx, bz, MARK_REACH, 0.0, k * 1.6)
        groundRing(&mut c, w, v, bx, bz, MARK_REACH * 0.62, w.time * 0.7, k * 0.9)
    }
}

// beamSeg with a width. A hairline lattice a kilometre off aliases into a dashed
// mess exactly where it has to read as a wall, and the boundary has to be legible
// before you reach it rather than once you are in it.
fn fenceSeg(c: &mut Canvas, v: &View, a: &Vec3, b: &Vec3, wide: f64, r: f64, g: f64, bl: f64) {
    var pa = a
    var pb = b
    if pa.z <= v.near && pb.z <= v.near {
        return
    }
    if pa.z <= v.near {
        pa = pa.lerp(pb, (v.near - pa.z) / (pb.z - pa.z))
    }
    if pb.z <= v.near {
        pb = pb.lerp(pa, (v.near - pb.z) / (pa.z - pb.z))
    }
    thickLine(&mut c, v.cx + pa.x * v.scale / pa.z, v.cy - pa.y * v.scale / pa.z, v.cx + pb.x * v.scale / pb.z, v.cy - pb.y * v.scale / pb.z, wide, r, g, bl)
}

// How much of the lattice survives the ground between it and the camera. Nothing
// here is depth-tested, so without this the wall paints itself over every ridge
// in front of it and reads as a decal on the hillside rather than as a thing
// standing at the edge of the map.
//
// Never all the way to zero: a hard cut pops as the aircraft moves, and a ghost
// of the boundary showing through a ridge is useful — it is where you may not go,
// and you want to know that before you crest the ridge.
fn fenceClear(w: &World, x: f64, y: f64, z: f64): f64 {
    let STEPS = 6
    var deepest = 0.0
    for i in 1..STEPS {
        let t = (i as f64) / (STEPS as f64)
        let sx = w.cam.x + (x - w.cam.x) * t
        let sy = w.cam.y + (y - w.cam.y) * t
        let sz = w.cam.z + (z - w.cam.z) * t
        let pen = heightAt(w.city, sx, sz) - sy
        if pen > deepest {
            deepest = pen
        }
    }
    if deepest <= 0.0 {
        return 1.0
    }
    return Math.maxF64(0.16, 1.0 - deepest / 60.0)
}

// The edge of the mapped area, drawn as a blue lattice standing on the terrain:
// posts on the ground, rails at fixed heights. It fades in well before the
// turn-back takes the stick, because an involuntary turn with no visible cause
// is indistinguishable from a bug.
//
// Additive and depth-test-free, like the landmark beams — it reads as a
// projection rather than as something built out there, which is what it is.
pub fn drawFence(c: &mut Canvas, w: &World, v: &View) {
    if !w.city.loaded || w.fenceLim <= 0.0 || w.showT > 0.0 || w.intro > 0.0 {
        return
    }
    let lim = w.fenceLim
    // Visible a little before it starts pushing, so it is a place you see coming.
    let SHOW = FENCE_SOFT + 500.0
    let wallTop = w.city.topMax + 1200.0
    let SPAN = 2800.0
    let STEP = 200.0
    let RAIL_STEP = 300.0
    let n = (SPAN / STEP) as i64
    let levels = (wallTop / RAIL_STEP) as i64 + 1
    // Walls 0/1 stand at x = ±lim, walls 2/3 at z = ±lim.
    for wall in 0..4 {
        var sign = 1.0
        if wall % 2 == 1 {
            sign = 0.0 - 1.0
        }
        let axisX = wall < 2
        var along0 = w.cam.z
        var outAxis = w.cam.x
        if !axisX {
            along0 = w.cam.x
            outAxis = w.cam.z
        }
        let d = lim - sign * outAxis
        if d > SHOW || d < 0.0 - 600.0 {
            continue
        }
        let near = Math.clampF64(1.0 - d / SHOW, 0.0, 1.0)
        let amp0 = 0.30 * near + 0.80 * near * near
        if amp0 < 0.01 {
            continue
        }
        var prevOk = false
        var prevX = 0.0
        var prevZ = 0.0
        var prevBase = 0.0
        for i in 0 - n..n + 1 {
            let along = along0 + (i as f64) * STEP
            var gx = sign * lim
            var gz = along
            if !axisX {
                gx = along
                gz = sign * lim
            }
            let base = heightAt(w.city, gx, gz)
            // Fades out along the wall as well as toward it: the sampled span has
            // to end in air rather than on a hard vertical cut.
            let edge = 1.0 - Math.abs((i as f64) / (n as f64))
            let amp = amp0 * edge * edge
            if amp > 0.004 {
                let LIFTS = 8
                for seg in 0..LIFTS {
                    let t0 = (seg as f64) / (LIFTS as f64)
                    let t1 = ((seg + 1) as f64) / (LIFTS as f64)
                    let y0 = base + (wallTop - base) * t0
                    let y1 = base + (wallTop - base) * t1
                    let up = (1.0 - t0) * (1.0 - t0)
                    let e = amp * up * 1.5 * fenceClear(w, gx, (y0 + y1) * 0.5, gz)
                    let a = toCamera(v, gx, y0, gz)
                    let b = toCamera(v, gx, y1, gz)
                    fenceSeg(&mut c, v, a, b, 3.0, 0.16 * e, 0.62 * e, 2.10 * e)
                }
            }
            if prevOk {
                for l in 1..levels {
                    let y = (l as f64) * RAIL_STEP
                    // A rail below the terrain at either end would be a line
                    // through the hillside.
                    if y < base || y < prevBase {
                        continue
                    }
                    let up = Math.clampF64(1.0 - y / wallTop, 0.0, 1.0)
                    let e = amp0 * edge * edge * (0.30 + 0.70 * up) * 1.2 * fenceClear(w, (prevX + gx) * 0.5, y, (prevZ + gz) * 0.5)
                    if e < 0.004 {
                        continue
                    }
                    let a = toCamera(v, prevX, y, prevZ)
                    let b = toCamera(v, gx, y, gz)
                    fenceSeg(&mut c, v, a, b, 2.4, 0.16 * e, 0.62 * e, 2.10 * e)
                }
            }
            prevOk = true
            prevX = gx
            prevZ = gz
            prevBase = base
        }
    }
}

// A circle drawn on the terrain, following it. Broken into dashes so it reads as
// a marker and not as a road, and `spin` turns the dash pattern without moving
// the circle.
fn groundRing(c: &mut Canvas, w: &World, v: &View, cx: f64, cz: f64, rad: f64, spin: f64, k: f64) {
    let segs = 48
    var prevOk = false
    var pvx = 0.0
    var pvy = 0.0
    for si in 0..segs + 1 {
        let ang = (si as f64) / (segs as f64) * TAU
        let gx = cx + Math.sin(ang + spin) * rad
        let gz = cz + Math.cos(ang + spin) * rad
        let gy = heightAt(w.city, gx, gz) + 12.0
        let p = toCamera(v, gx, gy, gz)
        if p.z <= v.near {
            prevOk = false
            continue
        }
        let sx = v.cx + p.x * v.scale / p.z
        let sy = v.cy - p.y * v.scale / p.z
        // Two segments on, one off.
        if prevOk && si % 3 != 2 {
            thickLine(&mut c, pvx, pvy, sx, sy, 3.0, 0.20 * k, 0.55 * k, 1.30 * k)
        }
        pvx = sx
        pvy = sy
        prevOk = true
    }
}

// One vertical slice of the column, near-clipped. Clipped rather than dropped:
// the beam is at its most useful when you are right on top of the landmark, which
// is exactly when its base crosses the camera plane.
fn beamSeg(c: &mut Canvas, v: &View, a: &Vec3, b: &Vec3, r: f64, g: f64, bl: f64) {
    var pa = a
    var pb = b
    if pa.z <= v.near && pb.z <= v.near {
        return
    }
    if pa.z <= v.near {
        pa = pa.lerp(pb, (v.near - pa.z) / (pb.z - pa.z))
    }
    if pb.z <= v.near {
        pb = pb.lerp(pa, (v.near - pb.z) / (pa.z - pb.z))
    }
    line(&mut c, v.cx + pa.x * v.scale / pa.z, v.cy - pa.y * v.scale / pa.z, v.cx + pb.x * v.scale / pb.z, v.cy - pb.y * v.scale / pb.z, r, g, bl)
}

pub fn drawMarkGuide(c: &mut Canvas, w: &World, v: &View) {
    // Off during both cinematics. A reticle and an edge chevron over a camera
    // move read as UI stuck on top of a cutscene.
    if w.marks.len == 0 || !w.city.loaded || w.showT > 0.0 || w.intro > 0.0 {
        return
    }
    // Nothing left to point at. markIdx still sits on the last landmark until
    // the next region is decoded, and without this the marker spends that beat
    // insisting you fly to somewhere you are already standing on.
    if w.markFound >= w.marks.len {
        return
    }
    let mx = w.marks[w.markIdx].x
    let mz = w.marks[w.markIdx].z
    // Framed a little above the ground: these are things you look AT, and a
    // marker pinned to the dirt at the base of Coit Tower points at a car park.
    let my = heightAt(w.city, mx, mz) + 180.0
    let p = toCamera(v, mx, my, mz)
    // Blue, to match the beam standing on the same spot. Two markers for one
    // destination in two different colours read as two destinations.
    let cr = 0.34
    let cg = 0.74
    let cb = 1.55
    let km = (w.markDist / 100.0) as i64
    let range = ((km as f64) / 10.0).toString() + " KM"
    if p.z > 1.0 {
        let sx = v.cx + p.x * v.scale / p.z
        let sy = v.cy - p.y * v.scale / p.z
        // Generous inset before falling back to the edge arrow. With the test
        // right at the border a landmark hovering there flipped between diamond
        // and arrow every frame, which is what the flickering was.
        let inset = 90.0
        if sx > inset && sx < (c.w as f64) - inset && sy > inset && sy < (c.h as f64) - inset {
            // A diamond rather than the ring reticle, so a landmark never reads
            // as something to fly through.
            let r = Math.clampF64(26000.0 / p.z, 18.0, 54.0)
            thickLine(&mut c, sx, sy - r, sx + r, sy, 3.0, cr, cg, cb)
            thickLine(&mut c, sx + r, sy, sx, sy + r, 3.0, cr, cg, cb)
            thickLine(&mut c, sx, sy + r, sx - r, sy, 3.0, cr, cg, cb)
            thickLine(&mut c, sx - r, sy, sx, sy - r, 3.0, cr, cg, cb)
            // Corner ticks outside the diamond: they widen the mark's footprint
            // without filling the middle of it, which is where the landmark is.
            let t = r * 0.42
            thickLine(&mut c, sx - r - t, sy, sx - r - t * 0.3, sy, 2.0, cr, cg, cb)
            thickLine(&mut c, sx + r + t * 0.3, sy, sx + r + t, sy, 2.0, cr, cg, cb)
            thickLine(&mut c, sx, sy - r - t, sx, sy - r - t * 0.3, 2.0, cr, cg, cb)
            thickLine(&mut c, sx, sy + r + t * 0.3, sx, sy + r + t, 2.0, cr, cg, cb)
            // ABOVE the diamond, not below. You are almost always flying at the
            // thing, so the diamond is almost always in the middle of the screen
            // — which is where the aircraft is drawn, and a label under it lands
            // on the fuselage.
            textCentered(&mut c, sx as i64, (sy - r - 46.0) as i64, w.markName, 3, cr, cg, cb)
            textCentered(&mut c, sx as i64, (sy - r - 20.0) as i64, range, 2, cr * 0.8, cg * 0.8, cb * 0.8)
            return
        }
    }
    // Off screen or behind: an arrow on a circle around the centre.
    var dirX = p.x
    var dirY = 0.0 - p.y
    if p.z <= 1.0 {
        // Behind the aircraft: only the left/right sense is meaningful, and the
        // vertical component of a point behind you points the wrong way.
        dirY = 0.0
        dirX = p.x
        // Directly behind, p.x is ~0 and the normalise below turns that into no
        // direction at all: a zero-size chevron at the centre of the screen with
        // the label floating beside it and nothing to attach it to. Turning
        // either way is a correct answer to "it is behind you", so pick one.
        if Math.abs(dirX) < 1.0 {
            dirX = 1.0
        }
    }
    let l = Math.sqrt(dirX * dirX + dirY * dirY) + 0.001
    dirX = dirX / l
    dirY = dirY / l
    let rad = Math.minF64(c.w as f64, c.h as f64) * 0.30
    let ax = v.cx + dirX * rad
    let ay = v.cy + dirY * rad
    let nx = 0.0 - dirY
    let ny = dirX
    // A solid chevron, twice the size it was. This is the only thing on screen
    // telling a lost player which way to turn, so it is drawn like it matters:
    // filled by nested strokes.
    let tip = 46.0
    let wing = 26.0
    for i in 0..7 {
        let s = 1.0 - (i as f64) * 0.13
        thickLine(&mut c, ax + dirX * tip * s, ay + dirY * tip * s, ax + nx * wing * s, ay + ny * wing * s, 3.0, cr, cg, cb)
        thickLine(&mut c, ax + dirX * tip * s, ay + dirY * tip * s, ax - nx * wing * s, ay - ny * wing * s, 3.0, cr, cg, cb)
    }
    thickLine(&mut c, ax - nx * wing, ay - ny * wing, ax + nx * wing, ay + ny * wing, 3.0, cr * 0.8, cg * 0.8, cb * 0.8)
    // The label sits BEHIND the chevron, and how far behind depends on which way
    // the chevron points. Text only ever grows sideways, so an arrow pointing
    // left or right has to be cleared by half a name — a fixed offset put
    // "GOLDEN GATE BRIDGE" straight through it. There was also a tail line
    // running back toward the centre, which crossed the label whatever the
    // offset; the chevron reads fine without it.
    let half = (textWidth(w.markName, 3) / 2) as f64
    let back = 52.0 + Math.abs(dirX) * (half + 26.0) + Math.abs(dirY) * 22.0
    var lx = ax - dirX * back
    var ly = ay - dirY * back
    // Clamped so a name near the edge of the ring is never half off screen.
    lx = Math.clampF64(lx, half + 14.0, (c.w as f64) - half - 14.0)
    ly = Math.clampF64(ly, 30.0, (c.h as f64) - 54.0)
    textCentered(&mut c, lx as i64, (ly - 12.0) as i64, w.markName, 3, cr, cg, cb)
    textCentered(&mut c, lx as i64, (ly + 16.0) as i64, range, 2, cr * 0.8, cg * 0.8, cb * 0.8)
}

// Speed lines: short streaks flying outward from the centre of the screen. The
// single most legible "you are going fast" cue there is, and it costs nothing.
pub fn drawSpeedLines(c: &mut Canvas, w: &World) {
    if w.boostBlend < 0.02 {
        return
    }
    let k = w.boostBlend
    let cx = (c.w as f64) * 0.5
    let cy = (c.h as f64) * 0.5
    let n = (46.0 * k) as i64
    for i in 0..n {
        let fi = i as f64
        // each streak keeps a stable angle and radius, animated outward by time
        let a = fi * 2.399963
        let phase = Math.mod(w.time * (1.6 + Math.mod(fi, 5.0) * 0.35) + fi * 0.137, 1.0)
        let r0 = 90.0 + phase * 760.0
        let len = (26.0 + phase * 150.0) * k
        let dx = Math.cos(a)
        let dy = Math.sin(a)
        // fade in from the centre, out at the edge
        var f = phase * 2.4
        if f > 1.0 {
            f = 1.0 - (phase - 0.42) * 1.2
        }
        if f < 0.0 {
            continue
        }
        let b = f * k * 0.5
        line(&mut c, cx + dx * r0, cy + dy * r0, cx + dx * (r0 + len), cy + dy * (r0 + len), b * 0.8, b * 0.9, b)
    }
}

// The centre column is shared by several transient messages, and before these
// were pinned to fixed slots a ring pickup, a region telegraph and a streak break
// could all land on the same pixels at once. Ordered top to bottom, non-
// overlapping, with the tier bar just above the streak number.
pub let STREAK_Y: i64 = 62

pub let GAIN_Y: i64 = 176

pub let TELEGRAPH_Y: i64 = 236

// A tick, drawn rather than typed: the 5x7 font is uppercase ASCII and there is
// no glyph for it. Two strokes, short arm down-right then long arm up-right.
fn checkMark(c: &mut Canvas, x: f64, y: f64, s: f64, r: f64, g: f64, b: f64) {
    thickLine(&mut c, x, y + s * 0.55, x + s * 0.38, y + s, 3.0, r, g, b)
    thickLine(&mut c, x + s * 0.38, y + s, x + s, y, 3.0, r, g, b)
}

pub let PANEL_W: i64 = 330

// The tour, down the right-hand side: what is left, what is done and how long
// each one took. This is the game's only progress display — there is no score —
// so it is the one piece of HUD allowed to be large.
pub fn drawChecklist(c: &mut Canvas, w: &World) {
    if w.marks.len == 0 || !w.city.loaded {
        return
    }
    let x0 = c.w - PANEL_W - 18
    let rowH = 34
    let top = 110
    let h = 94 + rowH * w.marks.len + 54
    shadeRect(&mut c, x0 as f64, (top - 70) as f64, (x0 + PANEL_W) as f64, ((top - 70) + h) as f64, 0.34)
    // Where you are, over what you are looking for. It used to sit in the far
    // bottom-left corner, which is the one part of the screen nothing else uses
    // and therefore the one part nobody looks at.
    text(&mut c, x0 + 16, top - 58, w.city.name, 3, 0.86, 0.82, 0.66)
    text(&mut c, x0 + 16, top - 22, "LANDMARKS", 2, 0.50, 0.62, 0.80)
    text(&mut c, c.w - 92, top - 22, w.markFound.toString() + " / " + w.marks.len.toString(), 2, 0.50, 0.62, 0.80)
    for i in 0..w.marks.len {
        let y = top + 22 + rowH * i
        let done = w.marks[i].found
        let here = i == w.markIdx && !done
        var r = 0.24
        var g = 0.28
        var b = 0.34
        if done {
            r = 0.30
            g = 0.95
            b = 0.62
        }
        if here {
            // The live one pulses. Nothing else on the panel moves, so this is
            // unmissable without being loud.
            let pulse = 0.78 + 0.22 * Math.sin(w.time * 4.0)
            r = 0.40 * pulse
            g = 0.86 * pulse
            b = 1.70 * pulse
        }
        // The row that was just ticked flares and then settles into the plain
        // "done" colour, so the eye is pulled to the line that changed.
        if done && i == w.showIdx && w.foundPop > 0.0 {
            let f = w.foundPop * w.foundPop
            r = r + 1.5 * f
            g = g + 1.5 * f
            b = b + 1.2 * f
            shadeRect(&mut c, (x0 + 6) as f64, (y - 6) as f64, (x0 + PANEL_W - 6) as f64, (y + 24) as f64, 1.0 + 2.0 * f)
        }
        if done {
            checkMark(&mut c, (x0 + 16) as f64, y as f64, 15.0, r, g, b)
        } else if here {
            // A caret, not a tick: this one is where you are going.
            thickLine(&mut c, (x0 + 17) as f64, y as f64, (x0 + 29) as f64, (y + 8) as f64, 3.0, r, g, b)
            thickLine(&mut c, (x0 + 29) as f64, (y + 8) as f64, (x0 + 17) as f64, (y + 16) as f64, 3.0, r, g, b)
        }
        text(&mut c, x0 + 42, y + 2, w.marks[i].name, 2, r, g, b)
        if done {
            let stamp = fmtTime(w.marks[i].took)
            text(&mut c, c.w - 34 - textWidth(stamp, 2), y + 2, stamp, 2, r * 0.9, g * 0.9, b * 0.9)
        }
    }
    // The region after this one, named but not opened up. Knowing there is more
    // is the reason to finish the five above; knowing what is in it is the
    // reason to skip them.
    let ny = top + 22 + rowH * w.marks.len + 16
    if w.nextName != "" {
        text(&mut c, x0 + 16, ny, "NEXT", 2, 0.30, 0.34, 0.40)
        text(&mut c, x0 + 16 + textWidth("NEXT  ", 2), ny, w.nextName, 2, 0.52, 0.50, 0.42)
    }
}

// The plate an arrival card sits on. Sized to its own widest line and darkened
// in two steps, so it reads as a card over the shot rather than as a letterbox
// bar the full width of the screen.
fn cardBack(c: &mut Canvas, cx: i64, y0: i64, y1: i64, wide: i64, k: f64) {
    let half = (wide / 2 + 46) as f64
    shadeRect(&mut c, (cx as f64) - half - 26.0, y0 as f64, (cx as f64) + half + 26.0, y1 as f64, 1.0 - 0.55 * k)
    shadeRect(&mut c, (cx as f64) - half, (y0 + 8) as f64, (cx as f64) + half, (y1 - 8) as f64, 1.0 - 0.82 * k)
}

// The arrival card, over the orbit: what you found, what it is, and what it
// cost you. The `fact` on every Mark had been carried since the tour was written
// and never once drawn — this is the payoff the comment on that field promises.
pub fn drawFound(c: &mut Canvas, w: &World) {
    if w.showT <= 0.0 || !w.city.loaded || w.marks.len == 0 {
        return
    }
    // Up over the first half second and out over the last, so the card is never
    // on screen at full strength while the camera is still moving fast.
    let inK = Math.clampF64((w.showLen - w.showT) / 0.5, 0.0, 1.0)
    let outK = Math.clampF64(w.showT / 0.8, 0.0, 1.0)
    let k = Math.minF64(inK, outK)
    if k <= 0.01 {
        return
    }
    // A band along the top, and a short one. The orbit frames its subject in the
    // middle of the screen, so anything tall anywhere near the centre covers the
    // thing the shot exists to show — which is what a 174 px plate did at the
    // bottom and a 5x title did wherever it sat. Centred in the space the
    // checklist leaves rather than on the screen: a fact line is ~690 px wide
    // here, and a screen-centred plate runs under the panel.
    let cx = (c.w - PANEL_W - 38) / 2
    if w.regionDone {
        cardBack(&mut c, cx, 14, 132, textWidth(w.city.name, 4), k)
        textCentered(&mut c, cx, 30, w.city.name, 4, 2.2 * k, 1.85 * k, 0.70 * k)
        textCentered(&mut c, cx, 78, "ALL " + w.marks.len.toString() + " FOUND", 2, 0.70 * k, 1.70 * k, 1.05 * k)
        if w.nextName != "" {
            textCentered(&mut c, cx, 104, "NEXT UP  " + w.nextName, 2, 0.90 * k, 0.92 * k, 0.96 * k)
        }
        return
    }
    // Indexed at each use rather than bound to a local: `let m = w.marks[i]`
    // would move a Mark out of a borrowed Vec, which is exactly the thing the
    // checker is there to stop.
    cardBack(&mut c, cx, 14, 138, Math.maxI64(textWidth(w.marks[w.showIdx].name, 4), textWidth(w.marks[w.showIdx].fact, 2)), k)
    textCentered(&mut c, cx, 28, "FOUND", 2, 0.40 * k, 0.90 * k, 1.70 * k)
    textCentered(&mut c, cx, 52, w.marks[w.showIdx].name, 4, 2.1 * k, 2.0 * k, 1.75 * k)
    textCentered(&mut c, cx, 92, w.marks[w.showIdx].fact, 2, 0.90 * k, 0.94 * k, 1.00 * k)
    textCentered(&mut c, cx, 114, fmtTime(w.marks[w.showIdx].took) + "     " + w.markFound.toString() + " OF " + w.marks.len.toString(), 2, 0.55 * k, 1.55 * k, 1.00 * k)
}

pub fn drawHud(c: &mut Canvas, w: &World, _s: &Scene, _fps: i64) {
    // Deliberately almost empty. Score, altitude, speed, triangle count, the
    // afterburner gauge, the streak and the control hints were all in service of
    // a hoop course that no longer exists, and every one of them was a line of
    // text over the thing the player came to look at. What is left answers the
    // only two questions worth asking in flight: where am I, and what is that.
    if w.city.loaded {
        // The place name moved to the top of the checklist and the landmark's
        // name and range onto the marker itself, where the player is already
        // looking. What is left down here is the two keys that are not obvious.
        text(&mut c, 24, c.h - 26, "ENTER  ELSEWHERE      M  MUSIC", 2, 0.26, 0.28, 0.32)
        // Where the sky came from, and the hour it describes.
        //
        // Not decoration. This sky is assembled from measurements when it can be
        // and invented when it cannot, and those two look similar on screen — a
        // fabricated overcast is exactly as grey as a real one. Naming the station
        // and stamping the time is what keeps "the weather in the game is the
        // weather outside" a checkable claim rather than an assertion. When it is
        // invented it says so, in the same place, in the same words.
        text(&mut c, 24, c.h - 48, envWeatherLabel(w.env), 2, 0.26, 0.30, 0.34)
        text(&mut c, 24, c.h - 70, envStamp(w.env) + "Z", 2, 0.22, 0.25, 0.29)
        return
    }
    // Invented country still runs the hoop game, so it keeps its readouts.
    text(&mut c, 24, 22, "SCORE " + w.score.toString(), 3, 0.95, 0.80, 0.30)
    text(&mut c, 24, c.h - 58, themeName(w.theme), 3, 0.75, 0.72, 0.55)
    text(&mut c, 24, c.h - 26, "NEXT REGION IN " + w.toNext.toString(), 2, 0.32, 0.34, 0.38)
    if w.combo > 0 {
        textCentered(&mut c, c.w / 2, STREAK_Y, "x" + w.combo.toString(), 4, 1.5, 1.1, 0.25)
    }
}
