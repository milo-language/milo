// The 2D overlay layer: HUD, checklist, contrails, sparks, birds, menus.
//
// Everything here draws into a linear-light float buffer at a FIXED resolution,
// independent of the 3D one. That independence is the point — the scene renders
// at the drawable size, or twice it under `--ss 2`, and none of that changes how
// much work the overlay is. It used to be the same buffer the whole frame was
// rasterised into, so every extra pixel of detail cost 2D time as well.
//
// The layer is composited over the finished scene as
//
//     result = overlay + scene * (1 - cov)
//
// which is premultiplied alpha, and covers all three kinds of primitive here
// with one blend:
//
//   - additive (spot, line, text, fillRect): write colour, leave cov at 0, and
//     the scene shows through underneath. This is most of the file — glow,
//     sparks and HUD strokes all want to add light rather than replace it.
//   - darkening (darkPix, shadeRect): write cov, leave colour at 0, and the
//     result is scene * (1 - cov). A card background behind the checklist and a
//     bird silhouetted against a bright sky are the same operation.
//   - opaque: both, which nothing currently needs but which falls out for free.
//
// No GPU, no shaders — plain loops over Vec<f32>.

from "std/math" import {
    Math
}
from "./font" import {
    fontTable
}

pub struct Canvas {
    w: i64,
    h: i64,
    hdr: Vec<f32>, // 3 floats per pixel, linear light, unbounded above 1.0
    // How much of the scene behind this pixel the overlay hides, 0..1. Only the
    // darkening primitives write it; everything else adds light and leaves the
    // scene showing through. See the composite formula at the top of the file.
    cov: Vec<f32>,
    font: Vec<i64>,
}

pub fn canvasNew(w: i64, h: i64): Canvas {
    return Canvas {
        w: w,
        h: h,
        hdr: Vec.filled(w * h * 3, 0.0),
        cov: Vec.filled(w * h, 0.0),
        font: fontTable(),
    }
}

// Hide `k` of the scene behind this pixel — 0 leaves it untouched, 1 blacks it
// out. Kept as a max rather than a sum so two overlapping cards do not stack into
// something darker than either of them asked for.
fn hide(c: &mut Canvas, x: i64, y: i64, k: f64) {
    let i = y * c.w + x
    if (c.cov[i] as f64) < k {
        c.cov[i] = k as f32
    }
}

pub fn canvasClear(c: &mut Canvas) {
    let n = c.w * c.h
    for i in 0..n {
        c.hdr[i * 3] = 0.0
        c.hdr[i * 3 + 1] = 0.0
        c.hdr[i * 3 + 2] = 0.0
        c.cov[i] = 0.0
    }
}

// ── primitives ────────────────────────────────────────────────────────────────

pub fn addPix(c: &mut Canvas, x: i64, y: i64, r: f64, g: f64, b: f64) {
    if x < 0 || y < 0 || x >= c.w || y >= c.h {
        return
    }
    let i = (y * c.w + x) * 3
    c.hdr[i] += (r as f32)
    c.hdr[i + 1] = c.hdr[i + 1] + (g as f32)
    c.hdr[i + 2] = c.hdr[i + 2] + (b as f32)
}

// Darken toward black by `k` (0 = untouched, 1 = black), with coverage for
// antialiasing. Everything else in this file draws ADDITIVELY, which suits glow,
// sparks and HUD strokes — but an additive primitive can only brighten, so it
// cannot draw a dark silhouette against a bright sky. Birds need this.
//
// It writes coverage rather than multiplying pixels, because the thing being
// darkened is the SCENE and the scene is on the GPU. The composite does the
// multiply: `scene * (1 - cov)`.
pub fn darkPix(c: &mut Canvas, x: i64, y: i64, k: f64) {
    if x < 0 || y < 0 || x >= c.w || y >= c.h {
        return
    }
    if k <= 0.0 {
        return
    }
    hide(&mut c, x, y, Math.minF64(k, 1.0))
}

// A dark line, for silhouettes. Same DDA walk as `line`, darkening instead of
// adding.
pub fn darkLine(c: &mut Canvas, x0: f64, y0: f64, x1: f64, y1: f64, k: f64) {
    let dx = x1 - x0
    let dy = y1 - y0
    var steps = (Math.abs(dx)) as i64
    let sy = (Math.abs(dy)) as i64
    if sy > steps {
        steps = sy
    }
    if steps < 1 {
        steps = 1
    }
    let ix = dx / (steps as f64)
    let iy = dy / (steps as f64)
    var px = x0
    var py = y0
    for i in 0..steps + 1 {
        // 2x2 coverage so a one-pixel bird does not shimmer as it moves
        let fx = px - Math.floor(px)
        let fy = py - Math.floor(py)
        let bx = Math.floor(px) as i64
        let by = Math.floor(py) as i64
        darkPix(&mut c, bx, by, k * (1.0 - fx) * (1.0 - fy))
        darkPix(&mut c, bx + 1, by, k * fx * (1.0 - fy))
        darkPix(&mut c, bx, by + 1, k * (1.0 - fx) * fy)
        darkPix(&mut c, bx + 1, by + 1, k * fx * fy)
        px += ix
        py += iy
    }
}

// A soft radial blob — the workhorse for particles, muzzle flashes and cores.
pub fn spot(c: &mut Canvas, cx: f64, cy: f64, rad: f64, r: f64, g: f64, b: f64) {
    if rad <= 0.0 {
        return
    }
    var x0 = (cx - rad) as i64
    var x1 = (cx + rad) as i64 + 1
    var y0 = (cy - rad) as i64
    var y1 = (cy + rad) as i64 + 1
    if x0 < 0 {
        x0 = 0
    }
    if y0 < 0 {
        y0 = 0
    }
    if x1 > c.w {
        x1 = c.w
    }
    if y1 > c.h {
        y1 = c.h
    }
    let inv = 1.0 / (rad * rad)
    var y = y0
    while y < y1 {
        let dy = (y as f64) + 0.5 - cy
        var x = x0
        while x < x1 {
            let dx = (x as f64) + 0.5 - cx
            let t = 1.0 - (dx * dx + dy * dy) * inv
            if t > 0.0 {
                let f = t * t
                let i = (y * c.w + x) * 3
                c.hdr[i] = c.hdr[i] + ((r * f) as f32)
                c.hdr[i + 1] = c.hdr[i + 1] + ((g * f) as f32)
                c.hdr[i + 2] = c.hdr[i + 2] + ((b * f) as f32)
            }
            x += 1
        }
        y += 1
    }
}

fn plot(c: &mut Canvas, x: i64, y: i64, cov: f64, r: f64, g: f64, b: f64) {
    if cov <= 0.0 {
        return
    }
    addPix(&mut c, x, y, r * cov, g * cov, b * cov)
}

// Xiaolin Wu antialiased line, drawn additively. Thin and bright — the bloom
// pass supplies the halo, which is far cheaper than drawing a wide soft stroke.
pub fn line(c: &mut Canvas, x0i: f64, y0i: f64, x1i: f64, y1i: f64, r: f64, g: f64, b: f64) {
    var x0 = x0i
    var y0 = y0i
    var x1 = x1i
    var y1 = y1i
    var steep = false
    if Math.abs(y1 - y0) > Math.abs(x1 - x0) {
        steep = true
        var t = x0
        x0 = y0
        y0 = t
        t = x1
        x1 = y1
        y1 = t
    }
    if x0 > x1 {
        var t = x0
        x0 = x1
        x1 = t
        t = y0
        y0 = y1
        y1 = t
    }
    let dx = x1 - x0
    let dy = y1 - y0
    var grad = 1.0
    if dx != 0.0 {
        grad = dy / dx
    }
    // Long strokes off-screen cost nothing: clip the x range up front.
    var xs = Math.floor(x0 + 0.5) as i64
    var xe = Math.floor(x1 + 0.5) as i64
    let limit = if steep {
        c.h
    } else {
        c.w
    }
    if xe < 0 || xs > limit {
        return
    }
    var yv = y0 + grad * ((xs as f64) + 0.5 - x0)
    if xs < -1 {
        yv = yv + grad * ((-1 - xs) as f64)
        xs = -1
    }
    if xe > limit {
        xe = limit
    }
    var x = xs
    while x <= xe {
        let fy = Math.floor(yv)
        let frac = yv - fy
        let iy = fy as i64
        if steep {
            plot(&mut c, iy, x, 1.0 - frac, r, g, b)
            plot(&mut c, iy + 1, x, frac, r, g, b)
        } else {
            plot(&mut c, x, iy, 1.0 - frac, r, g, b)
            plot(&mut c, x, iy + 1, frac, r, g, b)
        }
        yv += grad
        x += 1
    }
}

// Set every pixel, rather than adding to what was there. fillRect and the sprite
// drawers are additive because the canvas is HDR and everything in flight is a
// light; a menu is the one screen that needs a floor to draw on.
// Full coverage as well as colour: a menu is opaque, and the scene behind it —
// which is still being rendered, because the simulation keeps running — has to
// be hidden rather than added to.
pub fn canvasFill(c: &mut Canvas, r: f64, g: f64, b: f64) {
    let n = c.w * c.h
    for i in 0..n {
        c.hdr[i * 3] = r as f32
        c.hdr[i * 3 + 1] = g as f32
        c.hdr[i * 3 + 2] = b as f32
        c.cov[i] = 1.0
    }
}

// A stroke with weight. The canvas is HDR and additive, so drawing the same
// line twice over itself makes it brighter, not thicker — a bold marker has to
// be several strokes laid side by side along the normal.
pub fn thickLine(c: &mut Canvas, x0: f64, y0: f64, x1: f64, y1: f64, wide: f64, r: f64, g: f64, b: f64) {
    let dx = x1 - x0
    let dy = y1 - y0
    let l = Math.sqrt(dx * dx + dy * dy) + 0.0001
    let nx = 0.0 - dy / l
    let ny = dx / l
    var n = (wide as i64)
    if n < 1 {
        n = 1
    }
    // Spread the weight across the passes so a wide stroke is not also a
    // brighter one — three passes of full brightness blows out to white.
    let k = 1.0 / (n as f64)
    for i in 0..n {
        let off = ((i as f64) - ((n as f64) - 1.0) * 0.5) * 0.9
        line(&mut c, x0 + nx * off, y0 + ny * off, x1 + nx * off, y1 + ny * off, r * k, g * k, b * k)
    }
}

// Darken a rectangle. fillRect ADDS light, which is right for a glow and wrong
// for the panel behind the checklist: over a bright drape, adding to it makes
// the text less readable, not more.
pub fn shadeRect(c: &mut Canvas, x0: f64, y0: f64, x1: f64, y1: f64, k: f64) {
    var ix0 = Math.maxI64(0, x0 as i64)
    var iy0 = Math.maxI64(0, y0 as i64)
    var ix1 = Math.minI64(c.w, x1 as i64)
    var iy1 = Math.minI64(c.h, y1 as i64)
    var y = iy0
    while y < iy1 {
        var x = ix0
        while x < ix1 {
            hide(&mut c, x, y, 1.0 - k)
            x += 1
        }
        y += 1
    }
}

// ── text ──────────────────────────────────────────────────────────────────────

pub fn textWidth(s: &string, scale: i64): i64 {
    return s.len * 6 * scale
}

pub fn text(c: &mut Canvas, x: i64, y: i64, s: &string, scale: i64, r: f64, g: f64, b: f64) {
    var pen = x
    for k in 0..s.len {
        var code = s[k] as i64
        if code >= 97 && code <= 122 && code != 120 {
            code -= 32 // the table is uppercase-only, apart from 'x'
        }
        if code >= 0 && code < 128 {
            let bits = c.font[code]
            if bits != 0 {
                for row in 0..7 {
                    for col in 0..5 {
                        if ((bits >> (row * 5 + col)) & 1) == 1 {
                            let px = pen + col * scale
                            let py = y + row * scale
                            for sy in 0..scale {
                                for sx in 0..scale {
                                    addPix(&mut c, px + sx, py + sy, r, g, b)
                                }
                            }
                        }
                    }
                }
            }
        }
        pen = pen + 6 * scale
    }
}

pub fn textCentered(c: &mut Canvas, cx: i64, y: i64, s: &string, scale: i64, r: f64, g: f64, b: f64) {
    text(&mut c, cx - textWidth(s, scale) / 2, y, s, scale, r, g, b)
}

pub fn fillRect(c: &mut Canvas, x0: f64, y0: f64, x1: f64, y1: f64, r: f64, g: f64, b: f64) {
    var ix0 = x0 as i64
    var iy0 = y0 as i64
    var ix1 = x1 as i64
    var iy1 = y1 as i64
    if ix0 < 0 {
        ix0 = 0
    }
    if iy0 < 0 {
        iy0 = 0
    }
    if ix1 > c.w {
        ix1 = c.w
    }
    if iy1 > c.h {
        iy1 = c.h
    }
    var y = iy0
    while y < iy1 {
        var x = ix0
        while x < ix1 {
            let i = (y * c.w + x) * 3
            c.hdr[i] += (r as f32)
            c.hdr[i + 1] = c.hdr[i + 1] + (g as f32)
            c.hdr[i + 2] = c.hdr[i + 2] + (b as f32)
            x += 1
        }
        y += 1
    }
}
