// Procedural textures, built once at startup. There is no asset pipeline in this
// example and none is needed: surface detail is cheaper to generate than to ship,
// and it tiles seamlessly by construction because the noise wraps.

from "std/math" import {
    Math
}
from "./texture" import {
    SLOT_FACADE, SLOT_GROUND, SLOT_SKIN, Texture, texNew, texSet
}

pub let TEX_SIZE: i64 = 128

pub let TEX_SHIFT: i64 = 7

// Proper lattice value noise that WRAPS: the integer lattice is taken modulo the
// period, so octave N tiles exactly and the texture has no seam. The previous
// version was sin-of-sin, which is smooth mush — it produced an almost uniform
// field, so the only thing visible on screen was the quad tessellation.
// Wrapping by declaration: a bit-mixing hash is *supposed* to overflow, and Milo
// traps on overflow by default. This is the one place in the game where wrapping
// is the intent rather than a bug.
@wrapping
fn hashi(x: i64, y: i64, seed: i64): f64 {
    var h = x * 374761393 + y * 668265263 + seed * 1442695040
    h = (h ^ (h >> 13)) * 1274126177
    h = h ^ (h >> 16)
    var m = h % 4096
    if m < 0 {
        m = 0 - m
    }
    return (m as f64) / 4096.0
}

fn lattice(u: f64, v: f64, period: i64, seed: i64): f64 {
    let fx = u * (period as f64)
    let fy = v * (period as f64)
    let x0 = Math.floor(fx) as i64
    let y0 = Math.floor(fy) as i64
    let tx = fx - (x0 as f64)
    let ty = fy - (y0 as f64)
    let sx = tx * tx * (3.0 - 2.0 * tx)
    let sy = ty * ty * (3.0 - 2.0 * ty)
    let xa = ((x0 % period) + period) % period
    let ya = ((y0 % period) + period) % period
    let xb = (xa + 1) % period
    let yb = (ya + 1) % period
    let n00 = hashi(xa, ya, seed)
    let n10 = hashi(xb, ya, seed)
    let n01 = hashi(xa, yb, seed)
    let n11 = hashi(xb, yb, seed)
    let a = n00 + (n10 - n00) * sx
    let b = n01 + (n11 - n01) * sx
    return a + (b - a) * sy
}

fn fbm(u: f64, v: f64, seed: f64): f64 {
    let sd = seed as i64
    var t = 0.0
    t = t + lattice(u, v, 4, sd) * 0.42
    t = t + lattice(u, v, 8, sd + 7) * 0.26
    t = t + lattice(u, v, 16, sd + 19) * 0.18
    t = t + lattice(u, v, 32, sd + 41) * 0.14
    return t
}

// Ground detail: a broad mottle plus fine grain, kept near 1.0 because it is a
// MULTIPLIER over the terrain's themed colour rather than a colour of its own.
// One texture serves every region for exactly that reason.
pub fn groundTexture(): Texture {
    var t = texNew(TEX_SIZE, TEX_SHIFT)
    t.slot = SLOT_GROUND
    for y in 0..TEX_SIZE {
        for x in 0..TEX_SIZE {
            let u = (x as f64) / (TEX_SIZE as f64)
            let v = (y as f64) / (TEX_SIZE as f64)
            // Clumps at two scales plus a hard speckle. Contrast is deliberately
            // strong — this multiplies the terrain colour, and a subtle multiplier
            // is indistinguishable from no texture at all.
            let clump = fbm(u, v, 1.0)
            let fine = lattice(u, v, 64, 91)
            var k = 0.58 + clump * 0.78 + fine * 0.18
            let grain = hashi(x, y, 5)
            if grain > 0.92 {
                k = k * 1.30
            } else if grain < 0.10 {
                k = k * 0.72
            }
            // slight warm/cool tilt so the mottling is not pure luminance
            texSet(&mut t, x, y, k * 1.04, k, k * 0.94)
        }
    }
    return t
}

// Aircraft skin: light panels with darker seam lines, a coloured spine stripe and
// a few rivet rows. Laid out in UV so the whole airframe indexes into one sheet.
pub fn planeTexture(): Texture {
    var t = texNew(TEX_SIZE, TEX_SHIFT)
    t.slot = SLOT_SKIN
    for y in 0..TEX_SIZE {
        for x in 0..TEX_SIZE {
            var r = 0.86
            var g = 0.88
            var b = 0.92
            // panel seams every 32 texels
            if x % 32 == 0 || y % 32 == 0 {
                r = 0.52
                g = 0.54
                b = 0.60
            }
            // rivets along the seams
            if x % 32 == 0 && y % 8 == 4 {
                r = 0.38
                g = 0.40
                b = 0.46
            }
            // spine stripe down the middle of the sheet
            if y > 54 && y < 74 {
                r = 1.05
                g = 0.40
                b = 0.22
                if y == 55 || y == 73 {
                    r = 0.70
                    g = 0.26
                    b = 0.14
                }
            }
            // a subtle wash so the metal is not perfectly flat
            let n = fbm((x as f64) / (TEX_SIZE as f64), (y as f64) / (TEX_SIZE as f64), 5.0)
            let k = 0.94 + n * 0.12
            texSet(&mut t, x, y, r * k, g * k, b * k)
        }
    }
    return t
}

// A building facade: floor bands with window openings, as a multiplier around
// 1.0 (the rasteriser applies a texel as `1 + (texel-1)*tw`, so 1.0 is "leave
// the wall colour alone"). Sampled with UVs in METRES divided by the storey
// height, so a window is the same size on a two-storey house and on a tower —
// normalised UVs would stretch one window over sixty floors.
pub fn facadeTexture(): Texture {
    var t = texNew(TEX_SIZE, TEX_SHIFT)
    t.slot = SLOT_FACADE
    // 8 storeys and 8 window bays across the tile, so the tile repeats on a
    // whole storey and the bands cannot drift out of alignment when it wraps.
    let cells = 8
    let cell = TEX_SIZE / cells
    for y in 0..TEX_SIZE {
        for x in 0..TEX_SIZE {
            let cx = x / cell
            let cy = y / cell
            let fx = (x % cell) as f64 / (cell as f64)
            let fy = (y % cell) as f64 / (cell as f64)
            // Window occupies the middle of each cell; the rest is spandrel and
            // mullion, which is what actually reads as a facade at distance —
            // the dark/light rhythm, not the glass.
            let inWin = fx > 0.18 && fx < 0.82 && fy > 0.22 && fy < 0.78
            var k = 1.16 // wall between windows, slightly brighter than base
            if inWin {
                // Glass varies pane to pane: some reflecting sky, some dark.
                let r = hashi(cx, cy, 17)
                k = 0.42 + r * 0.5
                // a brighter top edge on each pane reads as a reflection
                if fy < 0.34 {
                    k = k + 0.22
                }
            }
            // Storey line: a darker course at every floor slab.
            if fy < 0.06 {
                k = k * 0.72
            }
            // Vertical grime streaks, very low contrast, breaks the perfect grid
            k = k * (0.96 + lattice((x as f64) / (TEX_SIZE as f64), 0.0, 32, 3) * 0.08)
            texSet(&mut t, x, y, k, k, k * 1.02)
        }
    }
    return t
}
