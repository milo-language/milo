// FLYBY — the window, the GL context, and the one place that knows how a finished
// frame reaches the screen.
//
// There used to be two ways out of the renderer and a seam here to hide which was
// in use: an SDL_Renderer with a streaming texture for the software path, or a GL
// context for the hardware one. The software path is gone — it lives on in
// benchmarks/softraster, where it is a benchmark rather than a second renderer to
// keep in step — so this file is one path, and the seam it existed to hide has
// collapsed into `screenFrame`.
//
// Losing the fallback is a real cost: a machine with no GL 3.3 core context now
// gets an error at startup instead of a slower picture. It buys the sky, which
// could not be built while every visual change had to land twice and look the
// same both times.

from "gl" import {
    GlContext, Gpu
}
from "std/math" import {
    Math
}
from "./gfx" import {
    Canvas, canvasClear
}
from "./gfx3d" import {
    Scene, View
}
from "./cloud" import {
    CloudField
}
from "./gpupost" import {
    CoverGrid, Post, postBeginWorld, postFinish, postFree, postNew, postResize, postBindWorld, postSetClouds
}
from "sdl" import {
    SDL_CreateWindow, SDL_DestroyWindow, SDL_GetError, SDL_MaximizeWindow,
    SDL_SetWindowFullscreen,
    SDL_WINDOWPOS_CENTERED, SDL_WINDOW_ALLOW_HIGHDPI,
    SDL_WINDOW_FULLSCREEN_DESKTOP, SDL_WINDOW_RESIZABLE, SDL_WINDOW_SHOWN
}
from "sdl/glcontext" import {
    SDL_GL_CreateContext, SDL_GL_DeleteContext, SDL_GL_GetDrawableSize,
    SDL_GL_SetAttribute, SDL_GL_SetSwapInterval, SDL_GL_SwapWindow,
    SDL_GL_CONTEXT_MAJOR_VERSION, SDL_GL_CONTEXT_MINOR_VERSION,
    SDL_GL_CONTEXT_PROFILE_CORE, SDL_GL_CONTEXT_PROFILE_MASK,
    SDL_GL_DEPTH_SIZE, SDL_GL_DOUBLEBUFFER, SDL_WINDOW_OPENGL
}

// A cap on the render target, not on the window.
//
// Supersampling multiplies the drawable size, and a maximised window on a Retina
// display is already 5120 wide before any multiplier. Left uncapped, `--ss 2`
// there asks for a 10240 x 5760 RGBA16F target — 470 MB for one attachment, twice
// over, which is how a graphics setting becomes a driver crash.
pub let MAX_RENDER_PX: i64 = 3840

pub struct Screen {
    win: *u8,
    ctx: *u8,
    // Every GL object the renderer makes is registered here, so teardown is one
    // sweep at a point this file chooses — while the GL context is still current,
    // which is the whole reason the gl package has no destructors.
    gl: GlContext,
    post: Post,
    // The last render size the targets were built for, so a window that is not
    // being dragged does not reallocate anything.
    rw: i64,
    rh: i64,
    renderPct: i64, // scene resolution as a percentage of the drawable
}

// Open the window and the context.
//
// `ow`/`oh` are the 2D overlay's fixed resolution, which is NOT the render
// resolution — the HUD is laid out in its own space and stays the same size
// whatever the window does.
pub fn screenOpen(title: &string, w: i64, h: i64, ow: i64, oh: i64, renderPct: i64, fullscreen: bool, maximized: bool): Result<Screen, string> {
    unsafe {
        // Before the window, not after: SDL reads these when it builds the pixel
        // format, and setting them afterwards is accepted and ignored.
        let _ = SDL_GL_SetAttribute(SDL_GL_CONTEXT_MAJOR_VERSION, 3)
        let _ = SDL_GL_SetAttribute(SDL_GL_CONTEXT_MINOR_VERSION, 3)
        let _ = SDL_GL_SetAttribute(SDL_GL_CONTEXT_PROFILE_MASK, SDL_GL_CONTEXT_PROFILE_CORE)
        let _ = SDL_GL_SetAttribute(SDL_GL_DOUBLEBUFFER, 1)
        // The scene has its own depth buffer on its own framebuffer, so the
        // window does not strictly need one — but a driver that hands back a
        // context with no depth bits at all is one worth finding out about here
        // rather than in a shader.
        let _ = SDL_GL_SetAttribute(SDL_GL_DEPTH_SIZE, 24)
        let flags = SDL_WINDOW_SHOWN | SDL_WINDOW_RESIZABLE | SDL_WINDOW_OPENGL | SDL_WINDOW_ALLOW_HIGHDPI
        let win = SDL_CreateWindow(title, SDL_WINDOWPOS_CENTERED, SDL_WINDOWPOS_CENTERED, w as i32, h as i32, flags)
        if (win as i64) == 0 {
            return Err("window: " + sdlError())
        }
        let ctx = SDL_GL_CreateContext(win)
        if (ctx as i64) == 0 {
            let e = sdlError()
            SDL_DestroyWindow(win)
            return Err("no GL 3.3 core context: " + e)
        }
        let _ = SDL_GL_SetSwapInterval(1)
        if fullscreen {
            let _ = SDL_SetWindowFullscreen(win, SDL_WINDOW_FULLSCREEN_DESKTOP)
        } else if maximized {
            SDL_MaximizeWindow(win)
        }

        let d = drawableOf(win)
        let r = renderSize(d.w, d.h, renderPct)
        var glc = GlContext.new()
        match postNew(&mut glc, r.w, r.h, ow, oh) {
            Ok(p) => {
                print("gpu: OpenGL " + Gpu.version())
                return Ok(Screen {
                    win: win, ctx: ctx, gl: glc, post: p, rw: r.w, rh: r.h, renderPct: renderPct
                })
            }
            Err(e) => {
                SDL_GL_DeleteContext(ctx)
                SDL_DestroyWindow(win)
                return Err(e)
            }
        }
    }
}

pub struct Size {
    w: i64,
    h: i64,
}

// The drawable in PIXELS, which on a Retina display is twice the window's size in
// points. Setting a viewport from the window size instead renders the frame into
// a quarter of it.
pub fn drawableOf(win: *u8): Size {
    var dw: i32 = 0
    var dh: i32 = 0
    unsafe {
        SDL_GL_GetDrawableSize(win, dw.addrOf(), dh.addrOf())
    }
    return Size {
        w: Math.maxI64(1, dw as i64), h: Math.maxI64(1, dh as i64)
    }
}

// Pixels the scene is actually rendered at, as a PERCENTAGE of the drawable.
//
// It used to be an integer supersample factor, which could only ever ask for MORE
// pixels than the window. That is the wrong direction on a modern display: a
// retina panel hands back a drawable of 2880x1864, and almost every pass in this
// renderer is per-pixel — the sea is a raymarch, the clouds are a raymarch, the
// bloom is four blurs — so the frame cost scales with all 5.4 million of them.
// Measured on that panel: 68 ms a frame, which is fifteen a second.
//
// A percentage covers both directions. 100 is native, 200 is the old `--ss 2`,
// and anything below 100 trades sharpness for frame rate, which is the trade a
// player under a cloud deck actually wants to make.
// Roughly two megapixels: a sharp picture that leaves headroom for the per-pixel
// passes. Chosen as an AREA rather than a width because what costs is pixels, and
// a 21:9 window and a 4:3 one with the same width are not the same amount of work.
pub let AUTO_TARGET_PX: i64 = 2100000

fn renderSize(dw: i64, dh: i64, pct: i64): Size {
    var p = pct
    if p <= 0 {
        p = 100
        let area = dw * dh
        if area > AUTO_TARGET_PX {
            // Area goes as the square of the linear scale, so the percentage is
            // the square root of the ratio.
            p = (Math.sqrt((AUTO_TARGET_PX as f64) / (area as f64)) * 100.0) as i64
            // A floor, because past a point this stops being a picture.
            if p < 45 {
                p = 45
            }
        }
    }
    var w = dw * p / 100
    var h = dh * p / 100
    let most = Math.maxI64(w, h)
    if most > MAX_RENDER_PX {
        w = w * MAX_RENDER_PX / most
        h = h * MAX_RENDER_PX / most
    }
    return Size {
        w: Math.maxI64(1, w), h: Math.maxI64(1, h)
    }
}

// Start a frame: match the targets to the window and bind the one the world draws
// into. Returns the render size, which is what the projection needs.
pub fn screenBegin(s: &mut Screen): Size {
    let d = drawableOf(s.win)
    let r = renderSize(d.w, d.h, s.renderPct)
    if r.w != s.rw || r.h != s.rh {
        match postResize(&mut s.gl, &mut s.post, r.w, r.h) {
            Ok(_) => {
                s.rw = r.w
                s.rh = r.h
            }
            Err(e) => {
                // Keep drawing at the old size rather than dying because someone
                // dragged a window corner.
                print("gpu: could not resize to " + $"{r.w}x{r.h}" + ": " + e)
            }
        }
    }
    postBeginWorld(s.post)
    return Size {
        w: s.rw, h: s.rh
    }
}

// Point the driver back at the scene target after a pass that bound its own.
//
// The shadow map renders into a framebuffer of its own between recording the
// world and drawing it, and whatever bound the scene target first is not
// necessarily still in scope by then. Binding without clearing, because the
// clear already happened in `screenBegin` and doing it twice would throw away
// the sky if the order ever changes.
pub fn screenRebind(s: &Screen) {
    postBindWorld(s.post)
}

// Push a new weather field to the GPU.
pub fn screenSetClouds(s: &Screen, f: &CloudField) {
    postSetClouds(s.post, f)
}

// Finish it: sea, overlay, bloom, tone map, swap. Clearing the overlay canvas is
// part of presenting, because nothing on the host reads it back.
pub fn screenPresent(s: &mut Screen, c: &mut Canvas, v: &View, sc: &Scene, cov: &CoverGrid, cover: &Vec<f32>, coverDirty: bool, hasSea: bool, time: f64, bloomGain: f64, exposure: f64) {
    let d = drawableOf(s.win)
    postFinish(s.post, c, v, sc, cov, cover, coverDirty, hasSea, time, bloomGain, exposure, d.w, d.h)
    SDL_GL_SwapWindow(s.win)
    canvasClear(&mut c)
}

// The context is a public field rather than something handed out by a getter:
// references here are second-class, so a function CANNOT return a `&mut
// GlContext`. Call sites pass `scr.gl` directly, which is the same borrow without
// the function in the middle.
pub fn screenFullscreen(s: &Screen, on: bool) {
    if on {
        let _ = SDL_SetWindowFullscreen(s.win, SDL_WINDOW_FULLSCREEN_DESKTOP)
    } else {
        let _ = SDL_SetWindowFullscreen(s.win, 0)
    }
}

fn sdlError(): string {
    unsafe {
        let p = SDL_GetError()
        if (p as i64) == 0 {
            return "unknown SDL error"
        }
        return _cstrToString(p)
    }
}

// Tear down in creation order's reverse. SDL_Quit would reclaim all of it anyway,
// but a leak an example teaches is a leak someone copies.
//
// `postFree` consumes the Post — its GL handles are @noCopy, so a borrow cannot
// hand them over, which is why this takes the Screen by value.
pub fn screenClose(s: Screen) {
    var own = s
    postFree(&mut own.gl, own.post)
    // Anything the game forgot goes here, before the context it belongs to is
    // destroyed two lines down.
    own.gl.free()
    SDL_GL_DeleteContext(own.ctx)
    SDL_DestroyWindow(own.win)
}
