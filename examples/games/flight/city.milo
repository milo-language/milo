// FLYBY — real-world city data.
//
// A `.city` asset is a real place: a terrain grid resampled from NASA SRTM, a
// land-cover grid and a set of building footprints from OpenStreetMap, all
// projected into the game's metre-per-unit world space. `tools/fetchcity.milo`
// builds one; this file loads it and answers the two questions the renderer asks
// about any point on the map — how high is the ground, and what is on it.
//
// Google's map data is not usable here: its terms forbid bulk download and
// redistribution, and there is no public elevation/footprint bulk endpoint. SRTM
// (public domain) plus OSM (ODbL) is the stack that is actually legal to ship,
// and it is the same data most "3D city" renderers are built on.
//
// Sea level is the DEM's own zero, so the coastline you fly over is the real
// one — SRTM writes 0 over water, and the engine already treats h <= 0 as sea.

from "std/fs" import {
    readFile
}
from "std/math" import {
    Math
}
from "std/png" import {
    Png
}
from "./gfx3d" import {
    Rgb, rgb
}
from "./texture" import {
    SLOT_ORTHO, Texture, texNew
}

pub let COVER_URBAN: u8 = 0 as u8

pub let COVER_PARK: u8 = 1 as u8

pub let COVER_SAND: u8 = 2 as u8

pub let COVER_WATER: u8 = 3 as u8

// Footprints are stored flat rather than as Vec<Vec<..>>: one contiguous point
// array plus per-building offsets. A city is tens of thousands of buildings and
// the draw loop touches them in spatial order every frame.
pub struct City {
    loaded: bool,
    name: string,
    originLat: f64,
    originLon: f64,

    demN: i64,
    demStep: f64,
    demX0: f64,
    demZ0: f64,
    dem: Vec<f64>,

    coverN: i64,
    coverStep: f64,
    coverX0: f64,
    coverZ0: f64,
    cover: Vec<u8>,

    bCount: i64,
    bHeight: Vec<f64>,
    bMinX: Vec<f64>,
    bMinZ: Vec<f64>,
    bMaxX: Vec<f64>,
    bMaxZ: Vec<f64>,
    bStart: Vec<i64>,
    bLen: Vec<i64>,
    bPtX: Vec<f64>,
    bPtZ: Vec<f64>,

    // Uniform-grid index over the footprints, in CSR form: cellStart[i]..
    // cellStart[i+1] are slots in cellItems holding building ids overlapping
    // cell i. Built at load, never mutated.
    gridN: i64,
    gridStep: f64,
    gridX0: f64,
    gridZ0: f64,
    cellStart: Vec<i64>,
    cellItems: Vec<i64>,

    // Bridges: OSM ways tagged `bridge=yes`, kept as open polylines rather than
    // footprints. A bridge is the one piece of a city that is not on the ground,
    // and the terrain grid has no idea it exists — SRTM samples the water under
    // the Golden Gate, not the deck over it. Without these, the two SF landmarks
    // that ARE bridges are a hoop over open water.
    brCount: i64,
    brHalfW: Vec<f64>,
    brStruct: Vec<i64>, // 0 beam, 1 suspension, 2 cable-stayed, 3 truss, 4 arch
    brCol: Vec<Rgb>,
    brStart: Vec<i64>,
    brLen: Vec<i64>,
    brPtX: Vec<f64>,
    brPtZ: Vec<f64>,
    // Deck height above sea level, one per point. NOT in the asset: it is derived
    // from this city's own terrain at load time (see `deckProfile`), so the
    // heuristic can be changed without refetching eight megabytes of OSM.
    brPtY: Vec<f64>,
    // Height of the towers above the deck, per bridge. Zero for everything that
    // is not a suspension or cable-stayed span.
    brTower: Vec<f64>,
    // Arc-length fractions of the two towers along the way.
    brTowerA: Vec<f64>,
    brTowerB: Vec<f64>,

    // Buildings the bridge layer has taken over. See `claimBridgeStructures`.
    bSkip: Vec<bool>,

    // Roof shape per building, from OSM's `roof:shape`, how much of the
    // building's height that roof takes, and how far off the ground the whole
    // thing starts. Empty on a version-2 asset, which is read as every roof flat
    // and every building founded on the ground — which is what the renderer drew
    // for all of them before this section existed.
    //
    // The base is what makes OSM's `building:part` usable: the Empire State
    // Building is not one box but eight stacked slabs, each with its own
    // footprint, `height` and `min_height`, and the mast on top of them is a
    // pyramid starting at 330 m. Without a base every part starts at the
    // pavement and the setbacks disappear inside the widest one.
    bRoof: Vec<u8>,
    bRoofH: Vec<f64>,
    bBase: Vec<f64>,

    // Where the version-1 body ends, i.e. the first byte of the bridge section
    // (or of nothing, in a v1 file). Tools splice a new trailing section on
    // instead of rebuilding an asset whose expensive layers have not changed.
    bodyEnd: i64,
    // And where the bridge section ends, for the same reason: the roof section
    // after it is rewritten on its own.
    bridgeEnd: i64,

    // Half-extent of the mapped area. Beyond this the ground fades to open sea,
    // which is the only honest thing to draw: there is no data out there.
    reach: f64,

    // The highest thing in the map, above sea level: the tallest terrain sample
    // plus the tallest building. The flight ceiling is measured from this rather
    // than from the ground under the aircraft, because a ceiling that follows the
    // terrain sits BELOW the summits anywhere the ground drops — over the Grand
    // Canyon floor or the Yosemite valley floor it put the roof under the rim.
    topMax: f64,

    // Aerial photograph of exactly this bbox, draped over the terrain. Optional:
    // without it the ground falls back to the land-cover palette, which is four
    // flat colours and reads as a diorama however good the heightmap is.
    ortho: Texture,
    orthoLoaded: bool,
}

pub fn cityEmpty(): City {
    return City {
        loaded: false,
        name: "",
        originLat: 0.0,
        originLon: 0.0,
        demN: 0,
        demStep: 1.0,
        demX0: 0.0,
        demZ0: 0.0,
        dem: Vec.new(),
        coverN: 0,
        coverStep: 1.0,
        coverX0: 0.0,
        coverZ0: 0.0,
        cover: Vec.new(),
        bCount: 0,
        bHeight: Vec.new(),
        bMinX: Vec.new(),
        bMinZ: Vec.new(),
        bMaxX: Vec.new(),
        bMaxZ: Vec.new(),
        bStart: Vec.new(),
        bLen: Vec.new(),
        bPtX: Vec.new(),
        bPtZ: Vec.new(),
        gridN: 0,
        gridStep: 128.0,
        gridX0: 0.0,
        gridZ0: 0.0,
        cellStart: Vec.new(),
        cellItems: Vec.new(),
        brCount: 0,
        brHalfW: Vec.new(),
        brStruct: Vec.new(),
        brCol: Vec.new(),
        brStart: Vec.new(),
        brLen: Vec.new(),
        brPtX: Vec.new(),
        brPtZ: Vec.new(),
        brPtY: Vec.new(),
        brTower: Vec.new(),
        brTowerA: Vec.new(),
        brTowerB: Vec.new(),
        bSkip: Vec.new(),
        bRoof: Vec.new(),
        bRoofH: Vec.new(),
        bBase: Vec.new(),
        bodyEnd: 0,
        bridgeEnd: 0,
        reach: 0.0,
        topMax: 0.0,
        ortho: texNew(1, 0),
        orthoLoaded: false,
    }
}

// sRGB byte -> linear, as a 256-entry table. The canvas is linear HDR and the
// photograph is gamma-encoded; skipping this leaves the whole drape milky,
// because the midtones sit about 20% too bright in linear light. A table
// because the alternative is twelve million pow() calls at startup.
fn srgbTable(): Vec<f32> {
    var t: Vec<f32> = Vec.filled(256, 0.0)
    for i in 0..256 {
        let c = (i as f64) / 255.0
        var lin = c / 12.92
        if c > 0.04045 {
            lin = Math.pow((c + 0.055) / 1.055, 2.4)
        }
        t[i] = lin as f32
    }
    return t
}

// log2 of a power of two, or -1. The Texture sampler indexes rows by shifting,
// so a non-power-of-two drape cannot be addressed at all.
fn shiftOf(n: i64): i64 {
    var k = 0
    var v = 1
    while v < n {
        v = v * 2
        k = k + 1
    }
    if v != n {
        return 0 - 1
    }
    return k
}

// Decode an aerial photograph and hang it on the city as a mirrored texture.
// Mirrored because the map reflects at its edge (world3d.foldIn) — the imagery
// has to fold on the same period as the terrain or they disagree at the seam.
pub fn cityAttachOrtho(c: &mut City, png: &string): Result<i64, string> {
    let img = Png.decode(png)?
    if img.width != img.height {
        return Result.Err($"ortho must be square, got {img.width}x{img.height}")
    }
    let shift = shiftOf(img.width)
    if shift < 0 {
        return Result.Err($"ortho side must be a power of two, got {img.width}")
    }
    let n = img.width
    var t = texNew(n, shift)
    t.mirror = true
    // Byte-backed: the texels stay as the sRGB bytes that came out of the PNG
    // and the LUT converts at sample time. Holding them as f32 triples cost four
    // times the memory for no more information than the bytes already carry.
    t.byteSrc = true
    t.slot = SLOT_ORTHO
    t.lut = srgbTable()
    t.px = Vec.new()
    t.pxu = Vec.filled(n * n * 3, 0 as u8)
    let ch = img.channels
    for y in 0..n {
        for x in 0..n {
            let src = (y * n + x) * ch
            let dst = (y * n + x) * 3
            t.pxu[dst] = img.pixels[src]
            t.pxu[dst + 1] = img.pixels[src + 1]
            t.pxu[dst + 2] = img.pixels[src + 2]
        }
    }
    fillNoData(c, &mut t, n)
    c.ortho = t
    c.orthoLoaded = true
    return Result.Ok(n)
}

// Imagery services answer "outside my coverage" with exact black, not with an
// error — so a coastal place comes back with a wedge of 0,0,0 where the survey
// stopped offshore, and draping that paints a black hole on the sea. Honolulu's
// square is 8.8% no-data, all of it open Pacific.
//
// What goes in the hole is solved, not smeared, and it is solved FROM THE SEA.
//
// Two attempts got that second half wrong. Carrying the last real texel along
// each row painted the Pacific in the service's own edge haze. Relaxing from
// whatever bordered the hole was smoother and just as wrong: a coverage boundary
// runs along a coastline, so most of what borders the hole is surf, sand and
// runway, and the ocean came out the colour of concrete.
//
// The terrain settles it. What is missing is open water — that is what lies
// outside an imagery survey on a coastal tile — and the DEM carries real
// bathymetry, so the asset already knows which parts of the picture are deep sea.
// Only those cells constrain the solve. Everything else is free.
//
// Given the boundary, the fill is Laplace inpainting: relax toward the average of
// the neighbours, iterated, holding the sea fixed. That is the standard answer
// for a hole because the result is the smoothest surface meeting the real data at
// every edge, and for open water it is also the physically right one — the sea's
// colour does vary smoothly with depth, and there is no detail out there to
// invent.
//
// Coarse because the hole is thousands of texels across and the fill has no
// business carrying detail that far. 8x down, solved at 256 square, bilinear back
// up — a few megabytes and a few milliseconds, against 60 MB and a second if the
// relaxation ran at full resolution to produce the same gradient.
//
// See isNoData for what counts as a gap; there is more than one kind.

// Cell size of the grid the fill is solved on, in texels. Coarse on purpose: the
// hole is a fifth of the picture, the answer is a smooth ocean gradient, and a
// Jacobi relaxation carries information one cell per pass — solve it at 256
// square and the middle of the Pacific never hears from the coast. At 64 square
// the whole thing converges in a few thousand passes and a few milliseconds.
let ORTHO_COARSE: i64 = 32

let ORTHO_RELAX: i64 = 4000

// Imagery services do not report a gap, they draw one, and they do not agree on
// what colour to draw it. The National Map basemap uses BOTH: exact black where a
// tile is missing, and an exact (253,253,253) band where the mosaic simply stops
// — 8% and 14% of the Honolulu square respectively. Both are flat, uniform and
// exact, which is what makes them safe to key on: in four million texels of
// photograph the mainland drapes contain not one pixel of either.
fn isNoData(t: &Texture, i: i64): bool {
    if t.pxu[i] == 0 as u8 && t.pxu[i + 1] == 0 as u8 && t.pxu[i + 2] == 0 as u8 {
        return true
    }
    return t.pxu[i] == 253 as u8 && t.pxu[i + 1] == 253 as u8 && t.pxu[i + 2] == 253 as u8
}

// Deeper than this counts as open sea for the purpose of colouring the hole.
// Not `< 0`: the reef and the lagoon are below sea level too, and they are
// turquoise. Filling the Pacific with reef colour is the concrete mistake again
// in a nicer shade.
let ORTHO_SEA_DEPTH: f64 = 0.0 - 25.0

fn fillNoData(city: &City, t: &mut Texture, n: i64) {
    let m = n / ORTHO_COARSE
    if m < 4 {
        return
    }
    var sumR: Vec<f64> = Vec.filled(m * m, 0.0)
    var sumG: Vec<f64> = Vec.filled(m * m, 0.0)
    var sumB: Vec<f64> = Vec.filled(m * m, 0.0)
    var cnt: Vec<i64> = Vec.filled(m * m, 0)
    var holes = 0
    for y in 0..n {
        let cy = y / ORTHO_COARSE
        for x in 0..n {
            let i = (y * n + x) * 3
            if isNoData(t, i) {
                holes = holes + 1
                continue
            }
            let c = cy * m + x / ORTHO_COARSE
            sumR[c] = sumR[c] + (t.pxu[i] as f64)
            sumG[c] = sumG[c] + (t.pxu[i + 1] as f64)
            sumB[c] = sumB[c] + (t.pxu[i + 2] as f64)
            cnt[c] = cnt[c] + 1
        }
    }
    if holes == 0 {
        return
    }
    // A coarse cell counts as known only if it is nearly all real texels. A cell
    // straddling the coverage boundary is half edge haze, and seeding the solve
    // with haze is exactly the mistake the row sweep made.
    let full = ORTHO_COARSE * ORTHO_COARSE
    var known: Vec<bool> = Vec.filled(m * m, false)
    var r: Vec<f64> = Vec.filled(m * m, 0.0)
    var g: Vec<f64> = Vec.filled(m * m, 0.0)
    var b: Vec<f64> = Vec.filled(m * m, 0.0)
    var anyKnown = false
    // The drape spans [-reach, +reach] on both axes, with v measured from the
    // north edge — the same mapping render3d uses for the terrain UVs.
    //
    // Three passes at widening thresholds, taking the first that finds enough to
    // solve from. Deep water is the honest boundary and the one that gives the
    // right colour, but not every gap is over an ocean: Manhattan's is over the
    // Hudson, which is fifteen metres deep, so a deep-water-only rule found
    // nothing, bailed, and left the river black. Sea level next, and failing that
    // anything fully covered at all — a fill from the wrong colour still beats a
    // hole in the picture.
    let span = city.reach * 2.0
    var tier = 0
    while tier < 3 && !anyKnown {
        var cut = ORTHO_SEA_DEPTH
        if tier == 1 {
            cut = 0.5
        }
        if tier == 2 {
            cut = 1.0e9
        }
        var found = 0
        for cy in 0..m {
            let wz = city.reach - (((cy as f64) + 0.5) / (m as f64)) * span
            for cx in 0..m {
                let cell = cy * m + cx
                // Every texel real: a cell straddling the coverage boundary is
                // part edge haze, and haze is what poisoned the first attempts.
                if cnt[cell] < full {
                    continue
                }
                let wx = (((cx as f64) + 0.5) / (m as f64)) * span - city.reach
                if cityHeightAt(city, wx, wz) > cut {
                    continue
                }
                known[cell] = true
                found = found + 1
                r[cell] = sumR[cell] / (cnt[cell] as f64)
                g[cell] = sumG[cell] / (cnt[cell] as f64)
                b[cell] = sumB[cell] / (cnt[cell] as f64)
            }
        }
        // A handful of cells is not a boundary, it is noise with a mean.
        if found >= 24 {
            anyKnown = true
        } else {
            for cell in 0..m * m {
                known[cell] = false
            }
        }
        tier = tier + 1
    }
    if !anyKnown {
        return
    }
    // Seed the unknown cells by growing inward from the known ones, so the
    // relaxation starts from something plausible instead of from black.
    var filled: Vec<bool> = Vec.filled(m * m, false)
    for c in 0..m * m {
        filled[c] = known[c]
    }
    // Seeded from a SNAPSHOT of what was filled at the start of each sweep. In
    // place, a cell marked filled early in the sweep lets its neighbour be marked
    // later in the same sweep, so the seed races along +x and +y and cells get
    // adopted before they have been given a value — leaving zeros, which read as
    // black holes in the middle of the fill.
    var nextFilled: Vec<bool> = Vec.filled(m * m, false)
    var growing = true
    while growing {
        growing = false
        for c in 0..m * m {
            nextFilled[c] = filled[c]
        }
        for y in 0..m {
            for x in 0..m {
                let c = y * m + x
                if filled[c] {
                    continue
                }
                var sr = 0.0
                var sg = 0.0
                var sb = 0.0
                var k = 0
                if x > 0 && filled[c - 1] {
                    sr = sr + r[c - 1]
                    sg = sg + g[c - 1]
                    sb = sb + b[c - 1]
                    k = k + 1
                }
                if x < m - 1 && filled[c + 1] {
                    sr = sr + r[c + 1]
                    sg = sg + g[c + 1]
                    sb = sb + b[c + 1]
                    k = k + 1
                }
                if y > 0 && filled[c - m] {
                    sr = sr + r[c - m]
                    sg = sg + g[c - m]
                    sb = sb + b[c - m]
                    k = k + 1
                }
                if y < m - 1 && filled[c + m] {
                    sr = sr + r[c + m]
                    sg = sg + g[c + m]
                    sb = sb + b[c + m]
                    k = k + 1
                }
                if k > 0 {
                    r[c] = sr / (k as f64)
                    g[c] = sg / (k as f64)
                    b[c] = sb / (k as f64)
                    growing = true
                }
            }
        }
        // one generation per sweep, so the seed spreads evenly rather than
        // racing across whichever axis the loop happens to walk first
        for y in 0..m {
            for x in 0..m {
                let c = y * m + x
                if filled[c] {
                    continue
                }
                if (x > 0 && filled[c - 1]) || (x < m - 1 && filled[c + 1]) || (y > 0 && filled[c - m]) || (y < m - 1 && filled[c + m]) {
                    nextFilled[c] = true
                }
            }
        }
        for c in 0..m * m {
            filled[c] = nextFilled[c]
        }
    }
    // Anything the growth could not reach — a pocket walled off by the grid's own
    // edges — takes the average of the sea, which is the best answer available and
    // beats the black it would otherwise keep.
    var mr = 0.0
    var mg = 0.0
    var mb = 0.0
    var mn = 0
    for c in 0..m * m {
        if known[c] {
            mr = mr + r[c]
            mg = mg + g[c]
            mb = mb + b[c]
            mn = mn + 1
        }
    }
    for c in 0..m * m {
        if !filled[c] {
            r[c] = mr / (mn as f64)
            g[c] = mg / (mn as f64)
            b[c] = mb / (mn as f64)
        }
    }
    // Relax the unknown cells toward the average of their neighbours, holding the
    // known ones fixed. Jacobi, not Gauss-Seidel: in place, the sweep direction
    // leaks into the answer and the gradient tilts the way the loop ran.
    var nr: Vec<f64> = Vec.filled(m * m, 0.0)
    var ng: Vec<f64> = Vec.filled(m * m, 0.0)
    var nb: Vec<f64> = Vec.filled(m * m, 0.0)
    for _pass in 0..ORTHO_RELAX {
        for y in 0..m {
            for x in 0..m {
                let c = y * m + x
                if known[c] {
                    nr[c] = r[c]
                    ng[c] = g[c]
                    nb[c] = b[c]
                    continue
                }
                var sr = 0.0
                var sg = 0.0
                var sb = 0.0
                var k = 0
                if x > 0 {
                    sr = sr + r[c - 1]
                    sg = sg + g[c - 1]
                    sb = sb + b[c - 1]
                    k = k + 1
                }
                if x < m - 1 {
                    sr = sr + r[c + 1]
                    sg = sg + g[c + 1]
                    sb = sb + b[c + 1]
                    k = k + 1
                }
                if y > 0 {
                    sr = sr + r[c - m]
                    sg = sg + g[c - m]
                    sb = sb + b[c - m]
                    k = k + 1
                }
                if y < m - 1 {
                    sr = sr + r[c + m]
                    sg = sg + g[c + m]
                    sb = sb + b[c + m]
                    k = k + 1
                }
                nr[c] = sr / (k as f64)
                ng[c] = sg / (k as f64)
                nb[c] = sb / (k as f64)
            }
        }
        for c in 0..m * m {
            r[c] = nr[c]
            g[c] = ng[c]
            b[c] = nb[c]
        }
    }
    // Bilinear back up, into the no-data texels only. Cell centres sit half a
    // coarse step in, which is what the -0.5 is: sampling from the corner shifts
    // the whole fill by four texels and puts a step at the coverage boundary.
    let inv = 1.0 / (ORTHO_COARSE as f64)
    for y in 0..n {
        let fy = ((y as f64) + 0.5) * inv - 0.5
        var y0 = Math.floor(fy) as i64
        if y0 < 0 {
            y0 = 0
        }
        if y0 > m - 2 {
            y0 = m - 2
        }
        let ty = Math.clampF64(fy - (y0 as f64), 0.0, 1.0)
        for x in 0..n {
            let i = (y * n + x) * 3
            if !isNoData(t, i) {
                continue
            }
            let fx = ((x as f64) + 0.5) * inv - 0.5
            var x0 = Math.floor(fx) as i64
            if x0 < 0 {
                x0 = 0
            }
            if x0 > m - 2 {
                x0 = m - 2
            }
            let tx = Math.clampF64(fx - (x0 as f64), 0.0, 1.0)
            let c00 = y0 * m + x0
            let c10 = c00 + 1
            let c01 = c00 + m
            let c11 = c01 + 1
            t.pxu[i] = lerpByte(r[c00], r[c10], r[c01], r[c11], tx, ty)
            t.pxu[i + 1] = lerpByte(g[c00], g[c10], g[c01], g[c11], tx, ty)
            t.pxu[i + 2] = lerpByte(b[c00], b[c10], b[c01], b[c11], tx, ty)
        }
    }
}

fn lerpByte(v00: f64, v10: f64, v01: f64, v11: f64, tx: f64, ty: f64): u8 {
    let a = v00 + (v10 - v00) * tx
    let b = v01 + (v11 - v01) * tx
    return Math.clampF64(a + (b - a) * ty, 0.0, 255.0) as u8
}

// ---------------------------------------------------------------- byte codec

// Everything on disk is a little-endian i32. Lengths are counts, coordinates and
// heights are centimetres — a fixed point rather than a float, so the format has
// no endianness or bit-layout question to get wrong and stays exact through a
// round trip.
pub fn putI32(out: &mut string, v: i64) {
    out.push((v & 0xff) as u8)
    out.push(((v >> 8) & 0xff) as u8)
    out.push(((v >> 16) & 0xff) as u8)
    out.push(((v >> 24) & 0xff) as u8)
}

pub fn getI32(src: &string, off: i64): i64 {
    var v = (src[off] as i64) | ((src[off + 1] as i64) << 8) | ((src[off + 2] as i64) << 16) | ((src[off + 3] as i64) << 24)
    if v >= 2147483648 {
        v = v - 4294967296
    }
    return v
}

pub fn putCm(out: &mut string, v: f64) {
    putI32(&mut out, Math.round(v * 100.0) as i64)
}

pub let MAGIC: string = "MILOCITY"

// 2 added the bridge section at the tail. A v1 asset still loads — it simply has
// no bridges — because everything before that section is byte-identical and the
// reader stops where the file does.
pub let VERSION: i64 = 3

// ------------------------------------------------------------------- loading

pub fn cityLoad(path: &string): Result<City, string> {
    let Result.Ok(src) = readFile(path) else {
        return Result.Err("cannot read " + path)
    }
    var c = cityParse(src)?
    // An aerial photograph sitting beside the asset, if someone built one. Its
    // absence is not an error — the palette path is still there — so a failure
    // to read is silence rather than a message about a file nobody asked for.
    match readFile(orthoPathFor(path)) {
        Result.Ok(png) => {
            let _ = cityAttachOrtho(&mut c, png)
        }
        Result.Err(_) => {
        }
    }
    return Result.Ok(c)
}

fn orthoPathFor(path: &string): string {
    var n = path.len
    if path.endsWith(".city") {
        n = n - 5
    }
    var base = ""
    for i in 0..n {
        base.push(path[i])
    }
    return base + ".ortho.png"
}

// True when `n` bytes are actually there. Every length in the file is read FROM
// the file, so each one has to be checked against what is left before it is used
// to index: `--city` is the one untrusted input this program has, and a
// truncated asset must come back as Result.Err, not as an out-of-bounds abort.
// The bounds check would catch it either way — that is the language doing its
// job — but a Result-returning parser that kills the process is a lie.
fn have(src: &string, off: i64, n: i64): bool {
    return n >= 0 && off >= 0 && off <= src.len - n
}

// Guards against a length field that is enormous rather than merely wrong: a
// count is only plausible if the bytes it claims are in the file.
fn plausible(src: &string, off: i64, count: i64, itemBytes: i64): bool {
    if count < 0 {
        return false
    }
    if count > (src.len - off) / itemBytes {
        return false
    }
    return true
}

// Parsing is split from reading so the same decoder serves a file on disk and an
// asset baked into the binary with @embedFile — the built-in city is not read at
// runtime at all.
pub fn cityParse(src: &string): Result<City, string> {
    if src.len < 16 {
        return Result.Err("truncated city file")
    }
    for i in 0..8 {
        if src[i] != MAGIC[i] {
            return Result.Err("not a .city file")
        }
    }
    var p = 8
    let ver = getI32(src, p)
    p = p + 4
    if ver < 1 || ver > VERSION {
        return Result.Err("city file version " + ver.toString() + ", expected 1 or " + VERSION.toString())
    }

    if !have(src, p, 4) {
        return Result.Err("truncated city file: no name")
    }
    let nameLen = getI32(src, p)
    p = p + 4
    if !plausible(src, p, nameLen, 1) {
        return Result.Err("truncated city file: name length " + nameLen.toString())
    }
    var name = ""
    for i in 0..nameLen {
        name.push(src[p + i])
    }
    p = p + nameLen

    var c = cityEmpty()
    c.name = name
    if !have(src, p, 12) {
        return Result.Err("truncated city file: no header")
    }
    c.originLat = (getI32(src, p) as f64) / 10000000.0
    p = p + 4
    c.originLon = (getI32(src, p) as f64) / 10000000.0
    p = p + 4
    c.reach = (getI32(src, p) as f64) / 100.0
    p = p + 4

    if !have(src, p, 16) {
        return Result.Err("truncated city file: no terrain header")
    }
    c.demN = getI32(src, p)
    p = p + 4
    c.demStep = (getI32(src, p) as f64) / 100.0
    p = p + 4
    c.demX0 = (getI32(src, p) as f64) / 100.0
    p = p + 4
    c.demZ0 = (getI32(src, p) as f64) / 100.0
    p = p + 4
    if c.demN < 0 || c.demN > 65535 {
        return Result.Err("city file terrain grid " + c.demN.toString())
    }
    let demCount = c.demN * c.demN
    if !plausible(src, p, demCount, 4) {
        return Result.Err("truncated city file: terrain grid " + c.demN.toString())
    }
    c.dem = Vec.filled(demCount, 0.0)
    for i in 0..demCount {
        c.dem[i] = (getI32(src, p) as f64) / 100.0
        p = p + 4
    }

    if !have(src, p, 16) {
        return Result.Err("truncated city file: no land-cover header")
    }
    c.coverN = getI32(src, p)
    p = p + 4
    c.coverStep = (getI32(src, p) as f64) / 100.0
    p = p + 4
    c.coverX0 = (getI32(src, p) as f64) / 100.0
    p = p + 4
    c.coverZ0 = (getI32(src, p) as f64) / 100.0
    p = p + 4
    if c.coverN < 0 || c.coverN > 65535 {
        return Result.Err("city file cover grid " + c.coverN.toString())
    }
    let coverCount = c.coverN * c.coverN
    if !plausible(src, p, coverCount, 1) {
        return Result.Err("truncated city file: cover grid " + c.coverN.toString())
    }
    c.cover = Vec.filled(coverCount, 0 as u8)
    for i in 0..coverCount {
        c.cover[i] = src[p + i]
    }
    p = p + coverCount

    if !have(src, p, 4) {
        return Result.Err("truncated city file: no building count")
    }
    let nb = getI32(src, p)
    p = p + 4
    // Eight bytes is the smallest a building can be (height + a zero point
    // count), so a count claiming more than that is not merely wrong, it cannot
    // be in the file at all.
    if !plausible(src, p, nb, 8) {
        return Result.Err("truncated city file: " + nb.toString() + " buildings")
    }
    c.bCount = nb
    for i in 0..nb {
        if !have(src, p, 8) {
            return Result.Err("truncated city file: building " + i.toString())
        }
        let h = (getI32(src, p) as f64) / 100.0
        p = p + 4
        let n = getI32(src, p)
        p = p + 4
        if !plausible(src, p, n, 8) {
            return Result.Err("truncated city file: building " + i.toString() + " has " + n.toString() + " points")
        }
        var minX = 1000000000.0
        var minZ = 1000000000.0
        var maxX = 0.0 - 1000000000.0
        var maxZ = 0.0 - 1000000000.0
        c.bHeight.push(h)
        c.bStart.push(c.bPtX.len)
        c.bLen.push(n)
        for k in 0..n {
            let x = (getI32(src, p) as f64) / 100.0
            p = p + 4
            let z = (getI32(src, p) as f64) / 100.0
            p = p + 4
            c.bPtX.push(x)
            c.bPtZ.push(z)
            if x < minX {
                minX = x
            }
            if x > maxX {
                maxX = x
            }
            if z < minZ {
                minZ = z
            }
            if z > maxZ {
                maxZ = z
            }
        }
        c.bMinX.push(minX)
        c.bMinZ.push(minZ)
        c.bMaxX.push(maxX)
        c.bMaxZ.push(maxZ)

        // Normalise the winding once, here, rather than testing it per frame.
        // OSM does not guarantee an orientation for a closed way, and the
        // rasteriser backface-culls: a clockwise footprint extrudes into a
        // building whose walls are all facing inwards, i.e. an invisible one.
        let start = c.bStart[i]
        var area = 0.0
        for k in 0..n {
            var k1 = k + 1
            if k1 == n {
                k1 = 0
            }
            area = area + c.bPtX[start + k] * c.bPtZ[start + k1] - c.bPtX[start + k1] * c.bPtZ[start + k]
        }
        if area < 0.0 {
            var lo = 0
            var hi = n - 1
            while lo < hi {
                let tx = c.bPtX[start + lo]
                let tz = c.bPtZ[start + lo]
                c.bPtX[start + lo] = c.bPtX[start + hi]
                c.bPtZ[start + lo] = c.bPtZ[start + hi]
                c.bPtX[start + hi] = tx
                c.bPtZ[start + hi] = tz
                lo = lo + 1
                hi = hi - 1
            }
        }
    }

    c.bodyEnd = p
    if ver >= 2 {
        p = parseBridges(&mut c, src, p)?
    }
    c.bridgeEnd = p
    // The roof section is optional even at version 3: a file may legitimately end
    // after the bridges (nothing in the map has a shaped roof, or the writer
    // predates the section), and a version number is a statement about layout,
    // not a promise that every layer is present. A section that IS there still
    // has to be complete and to match the building count.
    if ver >= 3 && have(src, p, 4) {
        parseRoofs(&mut c, src, p)?
    }

    c.loaded = true
    buildIndex(&mut c)
    deckProfile(&mut c)
    claimBridgeStructures(&mut c)
    computeTop(&mut c)
    return Result.Ok(c)
}

// Tallest terrain sample plus tallest building. An upper bound rather than the
// true highest roof — the tallest tower is not necessarily on the highest
// ground — which is what a ceiling wants: it can only ever be too generous.
fn computeTop(c: &mut City) {
    var top = 0.0
    for i in 0..c.dem.len {
        if c.dem[i] > top {
            top = c.dem[i]
        }
    }
    var tallest = 0.0
    for i in 0..c.bCount {
        if c.bHeight[i] > tallest {
            tallest = c.bHeight[i]
        }
    }
    for i in 0..c.brCount {
        if c.brTower[i] > tallest {
            tallest = c.brTower[i]
        }
    }
    c.topMax = top + tallest
}

// A bridge tower is often ALSO an OSM building polygon, standing in open water.
// Extruded by the building pass it is a black slab beside the tower the bridge
// layer drew — the two are the same structure described twice. The bridge owns it:
// any footprint whose centre is over water AND inside a deck's corridor is dropped.
//
// Both halves of that test are required. Over water alone would take piers and
// ferry terminals; inside the corridor alone would take the buildings a city road
// bridge runs between, and San Francisco has plenty of those.
fn claimBridgeStructures(c: &mut City) {
    c.bSkip = Vec.filled(c.bCount, false)
    if c.brCount == 0 {
        return
    }
    for b in 0..c.bCount {
        let mx = (c.bMinX[b] + c.bMaxX[b]) * 0.5
        let mz = (c.bMinZ[b] + c.bMaxZ[b]) * 0.5
        if cityHeightAt(c, mx, mz) > 2.0 {
            continue
        }
        if nearAnyDeck(c, mx, mz) {
            c.bSkip[b] = true
        }
    }
}

fn nearAnyDeck(c: &City, mx: f64, mz: f64): bool {
    for i in 0..c.brCount {
        let s0 = c.brStart[i]
        let n = c.brLen[i]
        let reachSq = (c.brHalfW[i] + 16.0) * (c.brHalfW[i] + 16.0)
        for k in 0..n - 1 {
            if segDistSq(mx, mz, c.brPtX[s0 + k], c.brPtZ[s0 + k], c.brPtX[s0 + k + 1], c.brPtZ[s0 + k + 1]) < reachSq {
                return true
            }
        }
    }
    return false
}

fn segDistSq(px: f64, pz: f64, ax: f64, az: f64, bx: f64, bz: f64): f64 {
    let ex = bx - ax
    let ez = bz - az
    let len2 = ex * ex + ez * ez
    var t = 0.0
    if len2 > 0.0 {
        t = ((px - ax) * ex + (pz - az) * ez) / len2
        if t < 0.0 {
            t = 0.0
        }
        if t > 1.0 {
            t = 1.0
        }
    }
    let dx = px - (ax + ex * t)
    let dz = pz - (az + ez * t)
    return dx * dx + dz * dz
}

// The bridge section: count, then per bridge a half-width, a structure code, a
// packed colour, a point count and that many (x,z) pairs. Open ways — the first
// point is not repeated at the end.
fn parseBridges(c: &mut City, src: &string, from: i64): Result<i64, string> {
    var p = from
    if !have(src, p, 4) {
        return Result.Err("truncated city file: no bridge count")
    }
    let n = getI32(src, p)
    p = p + 4
    // 20 bytes is the smallest a bridge can be (three i32 of header, a zero
    // point count, and two points is already more).
    if !plausible(src, p, n, 16) {
        return Result.Err("truncated city file: " + n.toString() + " bridges")
    }
    for i in 0..n {
        if !have(src, p, 16) {
            return Result.Err("truncated city file: bridge " + i.toString())
        }
        let halfW = (getI32(src, p) as f64) / 100.0
        p = p + 4
        let structure = getI32(src, p)
        p = p + 4
        let packed = getI32(src, p)
        p = p + 4
        let np = getI32(src, p)
        p = p + 4
        if !plausible(src, p, np, 8) {
            return Result.Err("truncated city file: bridge " + i.toString() + " has " + np.toString() + " points")
        }
        if np < 2 {
            p = p + np * 8
            continue
        }
        c.brHalfW.push(halfW)
        c.brStruct.push(structure)
        // sRGB bytes out of the asset, linear light in the renderer.
        c.brCol.push(rgb(srgbToLinear(((packed >> 16) & 255) as f64 / 255.0), srgbToLinear(((packed >> 8) & 255) as f64 / 255.0), srgbToLinear((packed & 255) as f64 / 255.0)))
        c.brStart.push(c.brPtX.len)
        c.brLen.push(np)
        for k in 0..np {
            c.brPtX.push((getI32(src, p) as f64) / 100.0)
            p = p + 4
            c.brPtZ.push((getI32(src, p) as f64) / 100.0)
            p = p + 4
        }
    }
    c.brCount = c.brHalfW.len
    return Result.Ok(p)
}

// Roof shapes, one per building, in the same order the body wrote them. A count
// that disagrees with the building count means the two sections came from
// different fetches, and a roof on the wrong building is worse than no roof.
fn parseRoofs(c: &mut City, src: &string, from: i64): Result<i64, string> {
    var p = from
    if !have(src, p, 4) {
        return Result.Err("truncated city file: no roof count")
    }
    let n = getI32(src, p)
    p = p + 4
    if n != c.bCount {
        return Result.Err("city file has " + n.toString() + " roofs for " + c.bCount.toString() + " buildings")
    }
    if !have(src, p, n * 9) {
        return Result.Err("truncated city file: " + n.toString() + " roofs")
    }
    c.bRoof = Vec.filled(n, 0 as u8)
    c.bRoofH = Vec.filled(n, 0.0)
    c.bBase = Vec.filled(n, 0.0)
    for i in 0..n {
        c.bRoof[i] = src[p]
        p = p + 1
        c.bRoofH[i] = (getI32(src, p) as f64) / 100.0
        p = p + 4
        c.bBase[i] = (getI32(src, p) as f64) / 100.0
        p = p + 4
    }
    return Result.Ok(p)
}

// Roof shape of a building, or flat on an asset with no roof section.
pub fn cityRoofKind(c: &City, b: i64): u8 {
    if b < 0 || b >= c.bRoof.len {
        return ROOF_FLAT
    }
    return c.bRoof[b]
}

pub fn cityRoofHeight(c: &City, b: i64): f64 {
    if b < 0 || b >= c.bRoofH.len {
        return 0.0
    }
    return c.bRoofH[b]
}

// How far above the ground this building starts. Non-zero only for the upper
// slabs of a building modelled as parts.
pub fn cityBase(c: &City, b: i64): f64 {
    if b < 0 || b >= c.bBase.len {
        return 0.0
    }
    return c.bBase[b]
}

// Roof shapes the renderer knows how to build. Everything OSM tags that is not
// one of these — skillion, sawtooth, the long tail — is read as flat: a wrong
// roof reads as a modelling error, a flat one reads as a building.
pub let ROOF_FLAT: u8 = 0

pub let ROOF_PYRAMIDAL: u8 = 1

pub let ROOF_DOME: u8 = 2

pub let ROOF_HIPPED: u8 = 3

pub let ROOF_GABLED: u8 = 4

fn srgbToLinear(v: f64): f64 {
    if v <= 0.04045 {
        return v / 12.92
    }
    return Math.pow((v + 0.055) / 1.055, 2.4)
}

// How far the roadway sits above whatever it crosses on land. A highway overpass
// is one deck plus clearance for the road underneath.
let DECK_ABOVE: f64 = 6.0

// Deck height for every bridge point, from this city's own terrain.
//
// OSM knows a bridge exists and knows nothing about how high it is: `layer=1`
// says "above the thing it crosses", not "67 metres above the water". So the
// height is a heuristic, and the only real input is the length of the water it
// crosses — which is exactly what a bridge engineer works from too, because
// clearance is set by the ships that have to pass under it. Long spans over
// navigable water are high; a hundred metres over a freeway is not.
//
//   deck(t) = land(t)·(1-a) + max(land(t), clearance)·a,   a = sin(pi·t)
//
// `land` is the straight run between the two ends' real ground heights, floored
// by the terrain directly beneath so the deck never sinks into a hill. `a` is a
// half-sine along the way, so the deck leaves each abutment at ground level and
// crowns in the middle — which is what a real deck profile looks like, and it
// costs one sine per point at load.
//
// Calibrated against the three bridges the game actually flies over: the Golden
// Gate comes out at 70 m (real 67), the Bay Bridge at 59 (real 58), the Brooklyn
// Bridge at 41 (real 41).
fn deckProfile(c: &mut City) {
    c.brPtY = Vec.filled(c.brPtX.len, 0.0)
    c.brTower = Vec.filled(c.brCount, 0.0)
    c.brTowerA = Vec.filled(c.brCount, 0.0)
    c.brTowerB = Vec.filled(c.brCount, 0.0)
    for b in 0..c.brCount {
        let s0 = c.brStart[b]
        let n = c.brLen[b]
        // arc length along the way, and the ground under each point
        var arc: Vec<f64> = Vec.filled(n, 0.0)
        var gnd: Vec<f64> = Vec.filled(n, 0.0)
        var total = 0.0
        for k in 0..n {
            if k > 0 {
                let dx = c.brPtX[s0 + k] - c.brPtX[s0 + k - 1]
                let dz = c.brPtZ[s0 + k] - c.brPtZ[s0 + k - 1]
                total = total + Math.sqrt(dx * dx + dz * dz)
            }
            arc[k] = total
            gnd[k] = cityHeightAt(c, c.brPtX[s0 + k], c.brPtZ[s0 + k])
        }
        if total <= 0.0 {
            total = 1.0
        }
        // The longest unbroken run of water, measured along the way. Water is the
        // DEM at or below sea level, which is exactly how SRTM records it.
        var bestLo = 0.0
        var bestHi = 0.0
        var runLo = 0.0
        var inWater = false
        for k in 0..n {
            let wet = gnd[k] <= 1.0
            if wet && !inWater {
                runLo = arc[k]
                inWater = true
            }
            if inWater && (!wet || k == n - 1) {
                let runHi = arc[k]
                if runHi - runLo > bestHi - bestLo {
                    bestLo = runLo
                    bestHi = runHi
                }
                inWater = wet
            }
        }
        // Clearance from the width of the water, on a square-root curve. Not a
        // straight line: clearance is set by the ships that have to pass under,
        // and ships stop getting taller a long time before crossings stop getting
        // wider. Fitted to the three the game flies over — the Brooklyn Bridge
        // comes out at 39 m against a real 41, the Golden Gate at 68 against 67.
        // The Bay Bridge hits the 70 m ceiling against a real 58, because what is
        // measured here is the whole crossing and half of that is low causeway.
        let waterSpan = bestHi - bestLo
        var clearance = 0.0
        if waterSpan > 0.0 {
            clearance = 5.0 + 1.9 * (Math.sqrt(waterSpan) - 7.75)
            if clearance < 0.0 {
                clearance = 0.0
            }
            if clearance > 70.0 {
                clearance = 70.0
            }
        }
        let g0 = Math.maxF64(gnd[0], 0.0)
        let gN = Math.maxF64(gnd[n - 1], 0.0)
        for k in 0..n {
            let t = arc[k] / total
            let a = Math.sin(3.14159265358979 * t)
            let land = Math.maxF64(g0 + (gN - g0) * t, gnd[k]) + DECK_ABOVE
            c.brPtY[s0 + k] = land * (1.0 - a) + Math.maxF64(land, clearance) * a
        }
        // Suspension and cable-stayed spans get towers, at the two ends of the
        // water they cross — which is where the real ones stand, because that is
        // where there is something to found them on.
        //
        // A long, high crossing with no `bridge:structure` at all is taken as a
        // suspension span. That tag is optional and often missing — the Bay
        // Bridge's west span carries none, and without this it drew as a three
        // kilometre grey ribbon seventy metres over the water with nothing
        // holding it up. Nothing but a suspension or cable-stayed bridge gets
        // built a kilometre long and that high, so the inference is safer than
        // the flat ribbon it replaces.
        let inferred = c.brStruct[b] == 0 && waterSpan > 900.0 && clearance > 45.0
        if (c.brStruct[b] == 1 || c.brStruct[b] == 2 || inferred) && clearance > 20.0 {
            // Real suspension towers stand about twice the deck's clearance
            // above it — the Golden Gate's deck is 67 m over the water and its
            // towers 227 m, and that proportion is what makes the silhouette
            // read as a suspension bridge rather than a road on stilts.
            c.brTower[b] = clearance * 2.0
            c.brTowerA[b] = bestLo / total
            c.brTowerB[b] = bestHi / total
        }
    }
}

// Two passes over the buildings: count per cell, prefix-sum, then scatter. No
// per-cell Vec, so the index is two flat arrays regardless of how uneven the
// density is — and downtown against parkland is very uneven.
//
// A building is filed under the cell holding its CENTRE, not under every cell
// its bounding box touches. Filing it once means the draw loop never has to
// remember what it has already emitted — no per-frame "seen" set over fifteen
// thousand buildings — at the cost of searching one ring of cells wider, which
// is what BUILDING_MARGIN below is for.
fn buildIndex(c: &mut City) {
    let span = c.reach + c.reach + c.gridStep * 2.0
    var n = (span / c.gridStep) as i64 + 1
    if n < 1 {
        n = 1
    }
    c.gridN = n
    c.gridX0 = 0.0 - c.reach - c.gridStep
    c.gridZ0 = 0.0 - c.reach - c.gridStep
    let cells = n * n
    var counts: Vec<i64> = Vec.filled(cells + 1, 0)

    for b in 0..c.bCount {
        let ci = cellIdxZ(c, (c.bMinZ[b] + c.bMaxZ[b]) * 0.5) * n + cellIdx(c, (c.bMinX[b] + c.bMaxX[b]) * 0.5)
        counts[ci] = counts[ci] + 1
    }
    c.cellStart = Vec.filled(cells + 1, 0)
    var acc = 0
    for i in 0..cells {
        c.cellStart[i] = acc
        acc = acc + counts[i]
    }
    c.cellStart[cells] = acc
    c.cellItems = Vec.filled(acc, 0)
    var cursor: Vec<i64> = Vec.filled(cells, 0)
    for i in 0..cells {
        cursor[i] = c.cellStart[i]
    }
    for b in 0..c.bCount {
        let ci = cellIdxZ(c, (c.bMinZ[b] + c.bMaxZ[b]) * 0.5) * n + cellIdx(c, (c.bMinX[b] + c.bMaxX[b]) * 0.5)
        c.cellItems[cursor[ci]] = b
        cursor[ci] = cursor[ci] + 1
    }
}

// How far outside the query rectangle to search, in metres. A footprint filed by
// its centre can still reach this far past it — a city block long enough to be
// one OSM way is about this size.
pub let BUILDING_MARGIN: f64 = 260.0

pub fn cityCellX(c: &City, x: f64): i64 {
    return cellIdx(c, x)
}

pub fn cityCellZ(c: &City, z: f64): i64 {
    return cellIdxZ(c, z)
}

fn cellIdx(c: &City, x: f64): i64 {
    var i = Math.floor((x - c.gridX0) / c.gridStep) as i64
    if i < 0 {
        i = 0
    }
    if i >= c.gridN {
        i = c.gridN - 1
    }
    return i
}

fn cellIdxZ(c: &City, z: f64): i64 {
    var i = Math.floor((z - c.gridZ0) / c.gridStep) as i64
    if i < 0 {
        i = 0
    }
    if i >= c.gridN {
        i = c.gridN - 1
    }
    return i
}

// ------------------------------------------------------------------ sampling

// Bilinear over the DEM. Past the mapped edge the ground fades to sea level over
// one grid step rather than smearing the boundary row out to the horizon — flying
// off the edge of the data should look like leaving the coast, not like a glitch.
pub fn cityHeightAt(c: &City, x: f64, z: f64): f64 {
    let fx = (x - c.demX0) / c.demStep
    let fz = (z - c.demZ0) / c.demStep
    let n = c.demN
    if fx < 0.0 || fz < 0.0 || fx > (n - 1) as f64 || fz > (n - 1) as f64 {
        return 0.0 - 6.0
    }
    let ix = Math.floor(fx) as i64
    let iz = Math.floor(fz) as i64
    var ix1 = ix + 1
    var iz1 = iz + 1
    if ix1 > n - 1 {
        ix1 = n - 1
    }
    if iz1 > n - 1 {
        iz1 = n - 1
    }
    let tx = fx - (ix as f64)
    let tz = fz - (iz as f64)
    let h00 = c.dem[iz * n + ix]
    let h10 = c.dem[iz * n + ix1]
    let h01 = c.dem[iz1 * n + ix]
    let h11 = c.dem[iz1 * n + ix1]
    let a = h00 + (h10 - h00) * tx
    let b = h01 + (h11 - h01) * tx
    let h = a + (b - a) * tz

    // Ease the last 400 m of the map down into the sea so the border is a shore.
    let edge = c.reach - 400.0
    let dx = Math.abs(x)
    let dz = Math.abs(z)
    var d = dx
    if dz > d {
        d = dz
    }
    if d > edge {
        var t = (d - edge) / 400.0
        if t > 1.0 {
            t = 1.0
        }
        return h * (1.0 - t) - 6.0 * t
    }
    return h
}

// No footprint here. Not zero and not sea level: callers take a max against the
// terrain, and any plausible height would win that max somewhere.
pub let NO_ROOF: f64 = 0.0 - 1.0e18

// Height of the tallest roof over (x, z), or NO_ROOF if the point is not over a
// building. `pad` widens every footprint, so a query can stand in for something
// with a span — an aircraft, a hoop — rather than a bare point.
//
// The footprint grid files a building under the cell holding its centre, so this
// searches out to BUILDING_MARGIN in each direction rather than one cell. The
// roof height matches what the renderer extrudes: one terrain sample at the
// footprint's centre plus the building's own height, so a query never disagrees
// with the box you can see.
pub fn cityRoofAt(c: &City, x: f64, z: f64, pad: f64): f64 {
    if c.bCount == 0 {
        return NO_ROOF
    }
    let reachCells = (BUILDING_MARGIN + pad) / c.gridStep
    var span = Math.ceil(reachCells) as i64
    if span < 1 {
        span = 1
    }
    let cx = cellIdx(c, x)
    let cz = cellIdxZ(c, z)
    var top = NO_ROOF
    var gz = cz - span
    while gz <= cz + span {
        if gz >= 0 && gz < c.gridN {
            var gx = cx - span
            while gx <= cx + span {
                if gx >= 0 && gx < c.gridN {
                    let ci = gz * c.gridN + gx
                    for slot in c.cellStart[ci]..c.cellStart[ci + 1] {
                        let b = c.cellItems[slot]
                        if x < c.bMinX[b] - pad || x > c.bMaxX[b] + pad || z < c.bMinZ[b] - pad || z > c.bMaxZ[b] + pad {
                            continue
                        }
                        let roof = cityHeightAt(c, (c.bMinX[b] + c.bMaxX[b]) * 0.5, (c.bMinZ[b] + c.bMaxZ[b]) * 0.5) + c.bHeight[b]
                        if roof <= top {
                            continue
                        }
                        if insideFootprint(c, b, x, z, pad) {
                            top = roof
                        }
                    }
                }
                gx = gx + 1
            }
        }
        gz = gz + 1
    }
    return top
}

// Crossing test on the footprint, then a distance test on its edges for `pad`.
// The two together are the polygon grown by `pad` — inside it, or within pad of
// an edge.
fn insideFootprint(c: &City, b: i64, x: f64, z: f64, pad: f64): bool {
    let start = c.bStart[b]
    let n = c.bLen[b]
    if n < 3 {
        return false
    }
    var inside = false
    var j = n - 1
    for i in 0..n {
        let xi = c.bPtX[start + i]
        let zi = c.bPtZ[start + i]
        let xj = c.bPtX[start + j]
        let zj = c.bPtZ[start + j]
        if (zi > z) != (zj > z) {
            if x < (xj - xi) * (z - zi) / (zj - zi) + xi {
                inside = !inside
            }
        }
        if pad > 0.0 && segDist(xi, zi, xj, zj, x, z) <= pad {
            return true
        }
        j = i
    }
    return inside
}

fn segDist(ax: f64, az: f64, bx: f64, bz: f64, px: f64, pz: f64): f64 {
    let dx = bx - ax
    let dz = bz - az
    let len2 = dx * dx + dz * dz
    var t = 0.0
    if len2 > 0.0 {
        t = Math.clampF64(((px - ax) * dx + (pz - az) * dz) / len2, 0.0, 1.0)
    }
    let qx = ax + dx * t - px
    let qz = az + dz * t - pz
    return Math.sqrt(qx * qx + qz * qz)
}

pub fn cityCoverAt(c: &City, x: f64, z: f64): u8 {
    if c.coverN == 0 {
        return COVER_URBAN
    }
    let ix = Math.floor((x - c.coverX0) / c.coverStep) as i64
    let iz = Math.floor((z - c.coverZ0) / c.coverStep) as i64
    if ix < 0 || iz < 0 || ix >= c.coverN || iz >= c.coverN {
        return COVER_URBAN
    }
    return c.cover[iz * c.coverN + ix]
}

// The aerial photograph sampled at a point, in the map's own local coordinates.
// Nearest texel: this feeds per-building colour, not per-pixel shading, so the
// bilinear tap would cost four fetches to move a roof's colour by nothing.
pub fn cityOrthoLocal(c: &City, lx: f64, lz: f64): Rgb {
    if !c.orthoLoaded {
        return rgb(0.5, 0.5, 0.5)
    }
    let n = c.ortho.w
    let inv = 1.0 / (c.reach * 2.0)
    var tx = (((lx + c.reach) * inv) * (n as f64)) as i64
    // From the NORTH edge — a PNG's first row is its top. See the drape UV in
    // render3d.drawWorld; the two have to agree or a roof takes its colour from
    // the wrong end of the city.
    var tz = (((c.reach - lz) * inv) * (n as f64)) as i64
    // Mirror onto the map, matching the drape and world3d.foldIn.
    tx = tx & (n * 2 - 1)
    tz = tz & (n * 2 - 1)
    if tx >= n {
        tx = n * 2 - 1 - tx
    }
    if tz >= n {
        tz = n * 2 - 1 - tz
    }
    let i = ((tz << c.ortho.shift) + tx) * 3
    return rgb(c.ortho.lut[c.ortho.pxu[i] as i64] as f64, c.ortho.lut[c.ortho.pxu[i + 1] as i64] as f64, c.ortho.lut[c.ortho.pxu[i + 2] as i64] as f64)
}

// Does this place have a sea? The DEM's zero IS sea level (see the note at the
// top of this file), so any terrain below it is underwater and the ocean plane
// belongs in the frame. Yosemite's valley floor sits at 1200 m and the Grand
// Canyon's rim higher still — for those the answer is no, and the GPU sea has
// to stay switched off or it appears past the mountains at the horizon.
pub fn cityHasSea(c: &City): bool {
    if !c.loaded {
        return false
    }
    for i in 0..c.dem.len {
        if c.dem[i] < 0.0 - 0.5 {
            return true
        }
    }
    return false
}

// The elevation grid as f32, for the GPU sea to sample.
//
// It has to be the DEM and not the land-cover grid: `COVER_WATER` is for OSM's
// inland lakes and rivers, and San Francisco's whole bay is 1196 cells of
// 641601 — 0.19%. The sea is defined by elevation here, exactly as
// render3d.cornerAt defines it.
pub fn demHeights(c: &City): Vec<f32> {
    if c.demN == 0 {
        return Vec.filled(1, 0.0)
    }
    var m: Vec<f32> = Vec.filled(c.demN * c.demN, 0.0)
    for i in 0..c.demN * c.demN {
        m[i] = c.dem[i] as f32
    }
    return m
}
