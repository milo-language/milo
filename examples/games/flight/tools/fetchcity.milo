// Builds a FLYBY `.city` asset for a real place.
//
//   milo run examples/games/flight/tools/fetchcity.milo -- \
//       --name "San Francisco" --lat 37.7897 --lon -122.4000 --radius 3000 \
//       -o examples/games/flight/cities/sf.city
//
// Two public sources, both free of an API key and both legal to redistribute:
//
//   terrain    NASA SRTM 1-arcsecond, via the AWS Open Data "terrain tiles"
//              bucket in Skadi layout (raw big-endian int16, 3601x3601 per
//              1-degree tile). Public domain.
//   buildings  OpenStreetMap via Overpass. Footprint geometry plus `height` /
//              `building:levels`. ODbL — attribution required, see cities/README.
//   land cover OSM parks, woods, beaches and inland water, rasterised into a
//              grid the renderer samples per terrain vertex.
//   bridges    OSM ways tagged `bridge=yes`, kept as open polylines. The terrain
//              grid cannot carry them — SRTM samples the water under a bridge,
//              not the deck over it — so they are their own layer.
//   imagery    The USGS National Map orthoimagery basemap, written beside the
//              asset as `<name>.ortho.png` and draped over the terrain. USGS
//              products are public domain. NAIP proper is the sharper source and
//              is what the mainland places use, but it is a USDA farm survey and
//              stops at the CONUS border — over Hawaii it returns an empty tile,
//              which is what the National Map service is here for.
//
// `--ortho <file.city>` refetches only the drape for an existing asset.
// `--update <file.city>` refetches ONLY the bridge layer and splices it onto an
// existing asset. Terrain, land cover and a hundred thousand building footprints
// are minutes of Overpass time and do not change between runs; a new trailing
// section does not need any of them re-downloaded.
//
// Google's data is deliberately not used: their terms forbid bulk download and
// redistribution of map, imagery or elevation data, so a checked-in asset built
// from it could not ship. SRTM+OSM is what real 3D city renderers use anyway.
//
// Downloads are cached under .cache/city/, so re-running to tweak the extent
// costs nothing but the reprojection.

from "std/png" import {
    Png, PngImage, encodePng
}
from "std/binary" import {
    Bytes
}
from "std/math" import {
    Math
}
from "std/fs" import {
    readFile, writeFile, pathExists, makeDir
}
from "std/fetch" import {
    fetchForm, urlEncode, fetch
}
from "std/inflate" import {
    Inflate
}
from "std/json" import {
    Json
}
from "std/strconv" import {
    parseFloat
}
from "std/args" import {
    args
}
from "std/time" import {
    sleepSecs
}
from "../city" import {
    putI32, putCm, MAGIC, VERSION, COVER_URBAN, COVER_PARK, COVER_SAND, COVER_WATER, cityParse,
    ROOF_FLAT, ROOF_PYRAMIDAL, ROOF_DOME, ROOF_HIPPED, ROOF_GABLED
}

let M_PER_DEG_LAT: f64 = 111320.0

let CACHE: string = ".cache/city"

// One arcsecond ~ 30 m, so resampling the DEM any finer than this invents
// detail that is not in the source.
let DEM_STEP: f64 = 30.0

let COVER_STEP: f64 = 20.0

let SRTM_N: i64 = 3601

// ------------------------------------------------------------------- SRTM

pub struct Tiles {
    names: Vec<string>,
    data: Vec<string>,
}

fn tileName(latDeg: i64, lonDeg: i64): string {
    var s = ""
    if latDeg >= 0 {
        s = s + "N" + pad2(latDeg)
    } else {
        s = s + "S" + pad2(0 - latDeg)
    }
    if lonDeg >= 0 {
        s = s + "E" + pad3(lonDeg)
    } else {
        s = s + "W" + pad3(0 - lonDeg)
    }
    return s
}

fn pad2(v: i64): string {
    if v < 10 {
        return "0" + v.toString()
    }
    return v.toString()
}

fn pad3(v: i64): string {
    if v < 10 {
        return "00" + v.toString()
    }
    if v < 100 {
        return "0" + v.toString()
    }
    return v.toString()
}

// Returns the index of the tile in the cache, or -1 if it could not be had. A
// missing tile is not fatal: SRTM has no coverage above 60 degrees north, and
// ocean-only tiles are simply absent from the bucket.
fn tileFor(t: &mut Tiles, latDeg: i64, lonDeg: i64): i64 {
    let name = tileName(latDeg, lonDeg)
    for i in 0..t.names.len {
        if t.names[i] == name {
            return i
        }
    }
    let latDir = if latDeg >= 0 {
        "N" + pad2(latDeg)
    } else {
        "S" + pad2(0 - latDeg)
    }
    let gzPath = CACHE + "/" + name.clone() + ".hgt.gz"
    var gz = ""
    if pathExists(gzPath) {
        let Ok(b) = readFile(gzPath) else {
            print("  cache read failed for " + name.clone())
            return -1
        }
        gz = b
    } else {
        let url = "https://s3.amazonaws.com/elevation-tiles-prod/skadi/" + latDir + "/" + name.clone() + ".hgt.gz"
        print("  downloading " + name.clone() + " ...")
        let Ok(resp) = fetch(url) else {
            print("  no SRTM tile " + name.clone() + " (treated as sea)")
            t.names.push(name.clone())
            t.data.push("")
            return t.names.len - 1
        }
        if !resp.ok() {
            print("  no SRTM tile " + name.clone() + " (treated as sea)")
            t.names.push(name.clone())
            t.data.push("")
            return t.names.len - 1
        }
        gz = resp.text()
        let _ = writeFile(gzPath, gz)
    }
    let Ok(raw) = Inflate.gzip(gz) else {
        print("  corrupt SRTM tile " + name.clone())
        return -1
    }
    if raw.len < SRTM_N * SRTM_N * 2 {
        print("  short SRTM tile " + name.clone())
        return -1
    }
    t.names.push(name.clone())
    t.data.push(raw)
    return t.names.len - 1
}

// Bilinear sample of the SRTM grid. Row 0 is the NORTH edge of the tile, which
// is the one detail that silently flips a city upside down if you get it wrong.
fn srtmAt(t: &mut Tiles, lat: f64, lon: f64): f64 {
    let latDeg = Math.floor(lat) as i64
    let lonDeg = Math.floor(lon) as i64
    let ti = tileFor(&mut t, latDeg, lonDeg)
    if ti < 0 {
        return 0.0
    }
    if t.data[ti].len == 0 {
        return 0.0
    }
    let fr = ((latDeg + 1) as f64 - lat) * 3600.0
    let fc = (lon - (lonDeg as f64)) * 3600.0
    var r0 = Math.floor(fr) as i64
    var c0 = Math.floor(fc) as i64
    if r0 < 0 {
        r0 = 0
    }
    if c0 < 0 {
        c0 = 0
    }
    if r0 > SRTM_N - 2 {
        r0 = SRTM_N - 2
    }
    if c0 > SRTM_N - 2 {
        c0 = SRTM_N - 2
    }
    let tr = fr - (r0 as f64)
    let tc = fc - (c0 as f64)
    let h00 = srtmRaw(t.data[ti], r0, c0)
    let h01 = srtmRaw(t.data[ti], r0, c0 + 1)
    let h10 = srtmRaw(t.data[ti], r0 + 1, c0)
    let h11 = srtmRaw(t.data[ti], r0 + 1, c0 + 1)
    let a = h00 + (h01 - h00) * tc
    let b = h10 + (h11 - h10) * tc
    return a + (b - a) * tr
}

fn srtmRaw(d: &string, r: i64, c: i64): f64 {
    let off = (r * SRTM_N + c) * 2
    var v = ((d[off] as i64) << 8) | (d[off + 1] as i64)
    if v >= 32768 {
        v -= 65536
    }
    // -32768 is SRTM's void marker, and it is what sits over open water.
    if v < -1000 {
        return 0.0
    }
    return v as f64
}

// ---------------------------------------------------------------- Overpass

// Cache file name for one Overpass query. The extent HAS to be in the key: the
// key was once a bare "cover"/"buildings", so the second place you built reused
// the first one's response and came out with another city's buildings on it —
// silently, because the asset is valid, just wrong.
fn cacheName(kind: &string, latMin: f64, lonMin: f64, latMax: f64, lonMax: f64): string {
    return kind + "-" + fmt7(latMin) + "_" + fmt7(lonMin) + "_" + fmt7(latMax) + "_" + fmt7(lonMax)
}

fn overpass(query: &string, cacheKey: &string): Result<string, string> {
    let path = CACHE + "/" + cacheKey + ".json"
    if pathExists(path) {
        let Ok(b) = readFile(path) else {
            return Err("cache read failed")
        }
        print("  using cached " + cacheKey.clone() + " (" + (b.len / 1024).toString() + " KiB)")
        return Ok(b)
    }
    print("  querying Overpass for " + cacheKey + " ...")
    // Overpass only accepts the query form-encoded.
    let encoded = "data=" + urlEncode(query)

    // The public instances shed load by refusing requests outright, and which
    // one is busy changes minute to minute. Rotate over the mirrors and back off
    // rather than failing the whole build on one crowded server.
    var mirrors: Vec<string> = Vec.new()
    mirrors.push("https://overpass-api.de/api/interpreter")
    mirrors.push("https://overpass.kumi.systems/api/interpreter")
    mirrors.push("https://overpass.private.coffee/api/interpreter")

    var attempt = 0
    while attempt < 6 {
        let url = mirrors[attempt % mirrors.len].clone()
        match fetchForm(url, encoded) {
            Ok(resp) => {
                let body = resp.text()
                if resp.ok() {
                    print("  got " + (body.len / 1024).toString() + " KiB")
                    let _ = writeFile(path, body)
                    return Ok(body)
                }
                print("  mirror " + (attempt % mirrors.len).toString() + " returned " + resp.status.toString())
            }
            Err(_e) => {
                print("  mirror " + (attempt % mirrors.len).toString() + " unreachable")
            }
        }
        attempt += 1
        if attempt < 6 {
            sleepSecs(4)
        }
    }
    return Err("every Overpass mirror refused the query")
}

fn bboxStr(latMin: f64, lonMin: f64, latMax: f64, lonMax: f64): string {
    return "(" + fmt7(latMin) + "," + fmt7(lonMin) + "," + fmt7(latMax) + "," + fmt7(lonMax) + ")"
}

// Overpass wants plain decimal; the default float formatting would happily emit
// an exponent for a small longitude and the server rejects that.
fn fmt7(v: f64): string {
    var x = v
    var sign = ""
    if x < 0.0 {
        sign = "-"
        x = 0.0 - x
    }
    let whole = Math.floor(x) as i64
    let frac = Math.round((x - (whole as f64)) * 10000000.0) as i64
    var fs = frac.toString()
    while fs.len < 7 {
        fs = "0" + fs
    }
    return sign + whole.toString() + "." + fs
}

// ------------------------------------------------------------------ polygons

// A scanline fill in cover-grid space. OSM polygons are closed ways in
// lat/lon order; after projection they are just rings in metres, and a
// crossing-parity fill is enough — self-intersecting rings do exist in OSM but
// they only mis-shade a few square metres of park.
fn fillPoly(cover: &mut Vec<u8>, n: i64, x0: f64, z0: f64, step: f64, px: &Vec<f64>, pz: &Vec<f64>, code: u8) {
    let m = px.len
    if m < 3 {
        return
    }
    var minZ = pz[0]
    var maxZ = pz[0]
    for i in 1..m {
        if pz[i] < minZ {
            minZ = pz[i]
        }
        if pz[i] > maxZ {
            maxZ = pz[i]
        }
    }
    var iz0 = Math.floor((minZ - z0) / step) as i64
    var iz1 = Math.ceil((maxZ - z0) / step) as i64
    if iz0 < 0 {
        iz0 = 0
    }
    if iz1 > n - 1 {
        iz1 = n - 1
    }
    var xs: Vec<f64> = Vec.new()
    for iz in iz0..(iz1 + 1) {
        let zc = z0 + (iz as f64) * step
        xs.clear()
        var j = m - 1
        for i in 0..m {
            let zi = pz[i]
            let zj = pz[j]
            if (zi > zc) != (zj > zc) {
                let t = (zc - zi) / (zj - zi)
                xs.push(px[i] + (px[j] - px[i]) * t)
            }
            j = i
        }
        if xs.len < 2 {
            continue
        }
        // insertion sort: a scanline through a building or a park crosses a
        // handful of edges, never enough to want anything cleverer
        for a in 1..xs.len {
            let v = xs[a]
            var b = a - 1
            while b >= 0 && xs[b] > v {
                xs[b + 1] = xs[b]
                b -= 1
            }
            xs[b + 1] = v
        }
        var k = 0
        while k + 1 < xs.len {
            var ix0 = Math.ceil((xs[k] - x0) / step) as i64
            var ix1 = Math.floor((xs[k + 1] - x0) / step) as i64
            if ix0 < 0 {
                ix0 = 0
            }
            if ix1 > n - 1 {
                ix1 = n - 1
            }
            for ix in ix0..(ix1 + 1) {
                cover[iz * n + ix] = code
            }
            k += 2
        }
    }
}

// --------------------------------------------------------------------- tags

fn tagStr(doc: &Json, tags: i64, key: &string): string {
    let c = doc.curField(tags, key)
    match doc.curStr(c) {
        Some(s) => {
            return s
        }
        None => {
            return ""
        }
    }
}

// OSM height values are metres but arrive as free text: "52", "52.5 m",
// "173'" and worse. Take the leading number and ignore the rest.
fn leadingNum(s: &string): f64 {
    var i = 0
    while i < s.len && (s[i] == 32 as u8) {
        i += 1
    }
    var out = ""
    while i < s.len {
        let ch = s[i]
        if (ch >= 48 as u8 && ch <= 57 as u8) || ch == 46 as u8 {
            out.push(ch)
            i += 1
        } else {
            break
        }
    }
    match parseFloat(out) {
        Some(v) => {
            return v
        }
        None => {
            return 0.0
        }
    }
}

let LEVEL_HEIGHT: f64 = 3.2

fn buildingHeight(doc: &Json, tags: i64): f64 {
    let h = leadingNum(tagStr(doc, tags, "height"))
    if h > 0.5 {
        return h
    }
    let lv = leadingNum(tagStr(doc, tags, "building:levels"))
    if lv > 0.0 {
        return lv * LEVEL_HEIGHT + 1.5
    }
    // Unlabelled buildings are overwhelmingly houses and low-rise shopfronts.
    return 7.0
}

// OSM's `roof:shape`, narrowed to the handful of shapes the renderer builds.
// Anything else — skillion, sawtooth, the long tail of one-offs — is flat: a
// wrong roof reads as a modelling error, a flat one reads as a building.
fn roofKindFor(doc: &Json, tags: i64): u8 {
    let shape = tagStr(doc, tags, "roof:shape")
    if shape == "pyramidal" || shape == "spire" || shape == "cone" || shape == "conical" || shape == "tented" {
        return ROOF_PYRAMIDAL
    }
    if shape == "dome" || shape == "onion" || shape == "round" {
        return ROOF_DOME
    }
    if shape == "hipped" || shape == "half-hipped" || shape == "mansard" || shape == "gambrel" {
        return ROOF_HIPPED
    }
    if shape == "gabled" || shape == "saltbox" || shape == "quadruple_saltbox" {
        return ROOF_GABLED
    }
    return ROOF_FLAT
}

// How much of the building's height the roof takes. Tagged where anyone has
// bothered — the Transamerica Pyramid carries `roof:height=260 m`, i.e. the
// whole tower — and otherwise a fraction that suits the shape. Never the entire
// height: a pyramid needs a few metres of wall under it or its lowest courses
// z-fight the ground it stands on.
fn roofHeightFor(doc: &Json, tags: i64, kind: u8, h: f64): f64 {
    var rh = leadingNum(tagStr(doc, tags, "roof:height"))
    if rh <= 0.1 {
        rh = leadingNum(tagStr(doc, tags, "roof:levels")) * LEVEL_HEIGHT
    }
    if rh <= 0.1 {
        if kind == ROOF_PYRAMIDAL {
            rh = h * 0.35
        } else if kind == ROOF_DOME {
            rh = h * 0.25
        } else {
            rh = Math.minF64(h * 0.35, 6.0)
        }
    }
    return Math.clampF64(rh, 0.0, h * 0.95)
}

fn coverCodeFor(doc: &Json, tags: i64): u8 {
    let leisure = tagStr(doc, tags, "leisure")
    if leisure == "park" || leisure == "garden" || leisure == "golf_course" || leisure == "pitch" {
        return COVER_PARK
    }
    let landuse = tagStr(doc, tags, "landuse")
    if landuse == "forest" || landuse == "grass" || landuse == "meadow" || landuse == "cemetery" || landuse == "recreation_ground" || landuse == "village_green" || landuse == "allotments" {
        return COVER_PARK
    }
    let natural = tagStr(doc, tags, "natural")
    if natural == "wood" || natural == "scrub" || natural == "grassland" || natural == "heath" {
        return COVER_PARK
    }
    if natural == "beach" || natural == "sand" {
        return COVER_SAND
    }
    if natural == "water" || natural == "wetland" {
        return COVER_WATER
    }
    if tagStr(doc, tags, "waterway") == "riverbank" {
        return COVER_WATER
    }
    return COVER_URBAN
}

// ------------------------------------------------------------------ bridges

// Everything the asset carries about one city's bridges, flat like the building
// arrays and for the same reason.
pub struct Bridges {
    halfW: Vec<f64>,
    structure: Vec<i64>,
    colour: Vec<i64>, // packed 0xRRGGBB, sRGB
    start: Vec<i64>,
    len: Vec<i64>,
    ptX: Vec<f64>,
    ptZ: Vec<f64>,
}

pub fn bridgesEmpty(): Bridges {
    return Bridges {
        halfW: Vec.new(), structure: Vec.new(), colour: Vec.new(),
        start: Vec.new(), len: Vec.new(), ptX: Vec.new(), ptZ: Vec.new(),
    }
}

// Which carriageways get a deck. Footways and cycleways are excluded on purpose:
// the Golden Gate is four parallel OSM ways — two motorway carriageways and two
// sidewalks — and drawing all four gives a bridge with four separate decks.
// Service roads and tracks are excluded because a city has hundreds of them and
// they are all four-metre culverts.
fn bridgeLanes(highway: &string, lanesTag: &string): f64 {
    let n = leadingNum(lanesTag.clone())
    if n >= 1.0 {
        return n
    }
    if highway == "motorway" || highway == "trunk" {
        return 3.0
    }
    if highway == "primary" || highway == "secondary" {
        return 2.0
    }
    return 2.0
}

fn bridgeKeep(highway: &string): bool {
    return highway == "motorway" || highway == "trunk" || highway == "primary"
    || highway == "secondary" || highway == "tertiary" || highway == "residential"
    || highway == "unclassified" || highway == "motorway_link" || highway == "trunk_link"
    || highway == "primary_link" || highway == "secondary_link"
}

fn structureCode(v: &string): i64 {
    if v == "suspension" {
        return 1
    }
    if v == "cable-stayed" {
        return 2
    }
    if v == "truss" {
        return 3
    }
    if v == "arch" || v == "tied-arch" || v == "arch-bridge" {
        return 4
    }
    return 0
}

fn hexNibble(ch: u8): i64 {
    let c = ch as i64
    if c >= 48 && c <= 57 {
        return c - 48
    }
    if c >= 97 && c <= 102 {
        return c - 87
    }
    if c >= 65 && c <= 70 {
        return c - 55
    }
    return -1
}

// OSM's `colour` is either a CSS name or a #rrggbb. Both appear on real bridges —
// the Golden Gate carries `colour=orange`, which is the whole reason the asset
// stores a colour at all instead of painting every deck concrete grey.
fn parseColour(v: &string): i64 {
    if v.len == 7 && v[0] == 35 as u8 {
        var acc = 0
        var ok = true
        for i in 1..7 {
            let d = hexNibble(v[i])
            if d < 0 {
                ok = false
            } else {
                acc = acc * 16 + d
            }
        }
        if ok {
            return acc
        }
    }
    if v == "orange" {
        return 0xC0552A // International Orange, which is what "orange" means here
    }
    if v == "red" {
        return 0xA33028
    }
    if v == "green" {
        return 0x3F6B4A
    }
    if v == "blue" {
        return 0x3A5A80
    }
    if v == "white" {
        return 0xD8D8D2
    }
    if v == "black" {
        return 0x3A3A3A
    }
    if v == "yellow" {
        return 0xC8AE3E
    }
    if v == "silver" || v == "grey" || v == "gray" {
        return 0x9A9A96
    }
    return 0x9A9A96 // weathered concrete
}

// Bridge ways in the bbox. Short ones are dropped: a city has hundreds of
// forty-metre culvert decks, none of which is visible from a plane, and each one
// costs eight triangles a frame forever.
// The building layer, decoded from one Overpass response into the flat arrays
// the asset stores. Shared by a full build and by `--roofs`, which re-derives
// only the roof section: the two MUST agree building for building, because the
// roof section is positional — a shape on the wrong index is a pyramid on an
// office block.
fn scanBuildings(bbox: &string, latMin: f64, lonMin: f64, latMax: f64, lonMax: f64, lat: f64, lon: f64, mPerLon: f64, bH: &mut Vec<f64>, bStart: &mut Vec<i64>, bLen: &mut Vec<i64>, bPtX: &mut Vec<f64>, bPtZ: &mut Vec<f64>, bRoof: &mut Vec<u8>, bRoofH: &mut Vec<f64>) {
    let bQ = "[out:json][timeout:180];way[\"building\"]" + bbox.clone() + ";out tags geom;"
    var tallest = 0.0
    var shaped = 0
    match overpass(bQ, cacheName("buildings", latMin, lonMin, latMax, lonMax)) {
        Ok(body) => {
            match Json.parse(body) {
                Ok(doc) => {
                    let els = doc.curField(doc.curRoot(), "elements")
                    let n = doc.curLen(els)
                    print("  " + n.toString() + " building ways")
                    for i in 0..n {
                        let el = doc.curChild(els, i)
                        let geom = doc.curField(el, "geometry")
                        var gn = doc.curLen(geom)
                        if gn < 4 {
                            continue
                        }
                        // A closed way repeats its first node last.
                        gn -= 1
                        // Footprints with dozens of nodes are curved facades and
                        // bay windows; at 150 m up and 190 m/s they are a
                        // rectangle. Decimate rather than drop.
                        var stride = 1
                        while gn / stride > 14 {
                            stride += 1
                        }
                        let tags = doc.curField(el, "tags")
                        let h = buildingHeight(doc, tags)
                        if h > tallest {
                            tallest = h
                        }
                        let start = bPtX.len
                        var count = 0
                        var k = 0
                        while k < gn {
                            let p = doc.curChild(geom, k)
                            let plat = floatOf(doc, doc.curField(p, "lat"))
                            let plon = floatOf(doc, doc.curField(p, "lon"))
                            bPtX.push((plon - lon) * mPerLon)
                            bPtZ.push((plat - lat) * M_PER_DEG_LAT)
                            count += 1
                            k += stride
                        }
                        if count < 3 {
                            bPtX.truncate(start)
                            bPtZ.truncate(start)
                            continue
                        }
                        let kind = roofKindFor(doc, tags)
                        if kind != ROOF_FLAT {
                            shaped += 1
                        }
                        bH.push(h)
                        bStart.push(start)
                        bLen.push(count)
                        bRoof.push(kind)
                        bRoofH.push(roofHeightFor(doc, tags, kind, h))
                    }
                }
                Err(_e) => {
                    print("  building JSON parse failed")
                }
            }
        }
        Err(e) => {
            print("  " + e)
        }
    }
    print("  kept " + bH.len.toString() + " buildings, tallest " + (tallest as i64).toString() + " m, " + shaped.toString() + " with a shaped roof")
}

// OSM's Simple 3D Buildings layer: `building:part` ways, each a slab of one
// building with its own footprint, `height` and `min_height`.
//
// This is the difference between a skyline and a row of boxes. The Empire State
// Building is one `building` way tagged 443 m — extruded on its own it is a
// featureless slab — and eight parts that are its actual setbacks, plus a
// pyramidal mast from 330 m up. Salesforce Tower's taper is a ring of parts.
// Neither shape exists anywhere else in the data.
fn scanParts(bbox: &string, latMin: f64, lonMin: f64, latMax: f64, lonMax: f64, lat: f64, lon: f64, mPerLon: f64, pH: &mut Vec<f64>, pBase: &mut Vec<f64>, pStart: &mut Vec<i64>, pLen: &mut Vec<i64>, pPtX: &mut Vec<f64>, pPtZ: &mut Vec<f64>, pRoof: &mut Vec<u8>, pRoofH: &mut Vec<f64>) {
    let q = "[out:json][timeout:180];way[\"building:part\"]" + bbox.clone() + ";out tags geom;"
    match overpass(q, cacheName("parts", latMin, lonMin, latMax, lonMax)) {
        Ok(body) => {
            match Json.parse(body) {
                Ok(doc) => {
                    let els = doc.curField(doc.curRoot(), "elements")
                    let n = doc.curLen(els)
                    print("  " + n.toString() + " building parts")
                    for i in 0..n {
                        let el = doc.curChild(els, i)
                        let geom = doc.curField(el, "geometry")
                        var gn = doc.curLen(geom)
                        if gn < 4 {
                            continue
                        }
                        gn -= 1
                        var stride = 1
                        while gn / stride > 14 {
                            stride += 1
                        }
                        let tags = doc.curField(el, "tags")
                        let h = buildingHeight(doc, tags)
                        var base = leadingNum(tagStr(doc, tags, "min_height"))
                        if base <= 0.01 {
                            base = leadingNum(tagStr(doc, tags, "building:min_level")) * LEVEL_HEIGHT
                        }
                        if base <= 0.01 {
                            base = leadingNum(tagStr(doc, tags, "min_level")) * LEVEL_HEIGHT
                        }
                        // A part that ends below where it starts is a tagging
                        // error, and extruding it downwards puts a slab through
                        // the street.
                        if h - base < 1.0 {
                            continue
                        }
                        let start = pPtX.len
                        var count = 0
                        var k = 0
                        while k < gn {
                            let pt = doc.curChild(geom, k)
                            pPtX.push((floatOf(doc, doc.curField(pt, "lon")) - lon) * mPerLon)
                            pPtZ.push((floatOf(doc, doc.curField(pt, "lat")) - lat) * M_PER_DEG_LAT)
                            count += 1
                            k += stride
                        }
                        if count < 3 {
                            pPtX.truncate(start)
                            pPtZ.truncate(start)
                            continue
                        }
                        let kind = roofKindFor(doc, tags)
                        pH.push(h)
                        pBase.push(base)
                        pStart.push(start)
                        pLen.push(count)
                        pRoof.push(kind)
                        pRoofH.push(roofHeightFor(doc, tags, kind, h - base))
                    }
                }
                Err(_e) => {
                    print("  building-part JSON parse failed")
                }
            }
        }
        Err(e) => {
            print("  " + e)
        }
    }
    print("  kept " + pH.len.toString() + " parts")
}

// Fetch the part layer and fold it into the building arrays: any plain footprint
// the parts stand in is dropped, and the parts are appended in its place.
//
// Dropped, because a `building` way and its `building:part` ways describe the
// SAME structure at two levels of detail. Keeping both leaves the coarse slab
// standing inside the detailed one, z-fighting its walls all the way up — and
// since the slab is tagged with the building's full height, it hides every
// setback the parts exist to show.
//
// The test is deliberately conservative: a part has to reach at least 80% of the
// footprint's height before that footprint is dropped. A dome or a chimney
// mapped as a part of a low building must not delete the building under it.
fn mergeParts(bbox: &string, latMin: f64, lonMin: f64, latMax: f64, lonMax: f64, lat: f64, lon: f64, mPerLon: f64, bH: &mut Vec<f64>, bBase: &mut Vec<f64>, bStart: &mut Vec<i64>, bLen: &mut Vec<i64>, bPtX: &mut Vec<f64>, bPtZ: &mut Vec<f64>, bRoof: &mut Vec<u8>, bRoofH: &mut Vec<f64>) {
    var pH: Vec<f64> = Vec.new()
    var pBase: Vec<f64> = Vec.new()
    var pStart: Vec<i64> = Vec.new()
    var pLen: Vec<i64> = Vec.new()
    var pPtX: Vec<f64> = Vec.new()
    var pPtZ: Vec<f64> = Vec.new()
    var pRoof: Vec<u8> = Vec.new()
    var pRoofH: Vec<f64> = Vec.new()
    scanParts(bbox, latMin, lonMin, latMax, lonMax, lat, lon, mPerLon, &mut pH, &mut pBase, &mut pStart, &mut pLen, &mut pPtX, &mut pPtZ, &mut pRoof, &mut pRoofH)
    if pH.len == 0 {
        return
    }

    let nb = bH.len
    // Footprint bounds, once. The suppression test is thousands of parts against
    // a hundred thousand buildings, so it goes through a coarse grid rather than
    // a scan: 500 m cells, and a part only ever looks at the nine around it.
    var minX: Vec<f64> = Vec.filled(nb, 0.0)
    var minZ: Vec<f64> = Vec.filled(nb, 0.0)
    var maxX: Vec<f64> = Vec.filled(nb, 0.0)
    var maxZ: Vec<f64> = Vec.filled(nb, 0.0)
    for b in 0..nb {
        var x0 = 1.0e18
        var z0 = 1.0e18
        var x1 = 0.0 - 1.0e18
        var z1 = 0.0 - 1.0e18
        for k in 0..bLen[b] {
            let x = bPtX[bStart[b] + k]
            let z = bPtZ[bStart[b] + k]
            if x < x0 {
                x0 = x
            }
            if x > x1 {
                x1 = x
            }
            if z < z0 {
                z0 = z
            }
            if z > z1 {
                z1 = z
            }
        }
        minX[b] = x0
        minZ[b] = z0
        maxX[b] = x1
        maxZ[b] = z1
    }
    let CELL = 500.0
    let side = ((latMax - latMin) * M_PER_DEG_LAT / CELL) as i64 + 4
    let half = side / 2
    var counts: Vec<i64> = Vec.filled(side * side + 1, 0)
    for b in 0..nb {
        counts[cellOf(minX[b], minZ[b], maxX[b], maxZ[b], CELL, side, half)] += 1
    }
    var cellStart: Vec<i64> = Vec.filled(side * side + 1, 0)
    var acc = 0
    for i in 0..side * side {
        cellStart[i] = acc
        acc += counts[i]
    }
    cellStart[side * side] = acc
    var items: Vec<i64> = Vec.filled(acc, 0)
    var cursor: Vec<i64> = Vec.filled(side * side, 0)
    for i in 0..side * side {
        cursor[i] = cellStart[i]
    }
    for b in 0..nb {
        let ci = cellOf(minX[b], minZ[b], maxX[b], maxZ[b], CELL, side, half)
        items[cursor[ci]] = b
        cursor[ci] += 1
    }

    var drop: Vec<bool> = Vec.filled(nb, false)
    var dropped = 0
    for i in 0..pH.len {
        var cx = 0.0
        var cz = 0.0
        for k in 0..pLen[i] {
            cx = cx + pPtX[pStart[i] + k]
            cz = cz + pPtZ[pStart[i] + k]
        }
        cx /= (pLen[i] as f64)
        cz /= (pLen[i] as f64)
        let gx = ((cx / CELL) as i64) + half
        let gz = ((cz / CELL) as i64) + half
        var dz = -1
        while dz <= 1 {
            var dx = -1
            while dx <= 1 {
                let ex = gx + dx
                let ez = gz + dz
                if ex >= 0 && ex < side && ez >= 0 && ez < side {
                    let ci = ez * side + ex
                    for slot in cellStart[ci]..cellStart[ci + 1] {
                        let b = items[slot]
                        if drop[b] {
                            continue
                        }
                        if cx < minX[b] || cx > maxX[b] || cz < minZ[b] || cz > maxZ[b] {
                            continue
                        }
                        if pH[i] < bH[b] * 0.8 {
                            continue
                        }
                        drop[b] = true
                        dropped += 1
                    }
                }
                dx += 1
            }
            dz += 1
        }
    }

    // Rebuild the arrays without the dropped footprints, then append the parts.
    var oH: Vec<f64> = Vec.new()
    var oBase: Vec<f64> = Vec.new()
    var oStart: Vec<i64> = Vec.new()
    var oLen: Vec<i64> = Vec.new()
    var oPtX: Vec<f64> = Vec.new()
    var oPtZ: Vec<f64> = Vec.new()
    var oRoof: Vec<u8> = Vec.new()
    var oRoofH: Vec<f64> = Vec.new()
    for b in 0..nb {
        if drop[b] {
            continue
        }
        let st = oPtX.len
        for k in 0..bLen[b] {
            oPtX.push(bPtX[bStart[b] + k])
            oPtZ.push(bPtZ[bStart[b] + k])
        }
        oH.push(bH[b])
        oBase.push(bBase[b])
        oStart.push(st)
        oLen.push(bLen[b])
        oRoof.push(bRoof[b])
        oRoofH.push(bRoofH[b])
    }
    for i in 0..pH.len {
        let st = oPtX.len
        for k in 0..pLen[i] {
            oPtX.push(pPtX[pStart[i] + k])
            oPtZ.push(pPtZ[pStart[i] + k])
        }
        oH.push(pH[i])
        oBase.push(pBase[i])
        oStart.push(st)
        oLen.push(pLen[i])
        oRoof.push(pRoof[i])
        oRoofH.push(pRoofH[i])
    }
    print("  parts replaced " + dropped.toString() + " footprints; " + bH.len.toString() + " -> " + oH.len.toString() + " buildings")
    replace(bH, oH)
    replace(bBase, oBase)
    replace(bStart, oStart)
    replace(bLen, oLen)
    replace(bPtX, oPtX)
    replace(bPtZ, oPtZ)
    replace(bRoof, oRoof)
    replace(bRoofH, oRoofH)
}

// Which grid cell a footprint's centre falls in, clamped into the grid.
fn cellOf(x0: f64, z0: f64, x1: f64, z1: f64, cell: f64, side: i64, half: i64): i64 {
    var gx = (((x0 + x1) * 0.5 / cell) as i64) + half
    var gz = (((z0 + z1) * 0.5 / cell) as i64) + half
    if gx < 0 {
        gx = 0
    }
    if gx >= side {
        gx = side - 1
    }
    if gz < 0 {
        gz = 0
    }
    if gz >= side {
        gz = side - 1
    }
    return gz * side + gx
}

fn putRoofs(buf: &mut string, bRoof: &Vec<u8>, bRoofH: &Vec<f64>, bBase: &Vec<f64>) {
    putI32(&mut buf, bRoof.len)
    for i in 0..bRoof.len {
        buf.push(bRoof[i])
        putCm(&mut buf, bRoofH[i])
        putCm(&mut buf, bBase[i])
    }
}

fn fetchBridges(bbox: &string, lat: f64, lon: f64, mPerLon: f64, cacheKey: &string): Bridges {
    var br = bridgesEmpty()
    let q = "[out:json][timeout:180];way[\"bridge\"][\"highway\"]" + bbox.clone() + ";out tags geom;"
    match overpass(q, cacheKey.clone()) {
        Ok(body) => {
            match Json.parse(body) {
                Ok(doc) => {
                    let els = doc.curField(doc.curRoot(), "elements")
                    let n = doc.curLen(els)
                    print("  " + n.toString() + " bridge ways")
                    for i in 0..n {
                        let el = doc.curChild(els, i)
                        let tags = doc.curField(el, "tags")
                        let highway = tagStr(doc, tags, "highway")
                        if !bridgeKeep(highway) {
                            continue
                        }
                        let geom = doc.curField(el, "geometry")
                        let gn = doc.curLen(geom)
                        if gn < 2 {
                            continue
                        }
                        // project first, so the length test is in metres
                        var wx: Vec<f64> = Vec.new()
                        var wz: Vec<f64> = Vec.new()
                        for k in 0..gn {
                            let p = doc.curChild(geom, k)
                            wx.push((floatOf(doc, doc.curField(p, "lon")) - lon) * mPerLon)
                            wz.push((floatOf(doc, doc.curField(p, "lat")) - lat) * M_PER_DEG_LAT)
                        }
                        var length = 0.0
                        for k in 1..gn {
                            let dx = wx[k] - wx[k - 1]
                            let dz = wz[k] - wz[k - 1]
                            length += Math.sqrt(dx * dx + dz * dz)
                        }
                        if length < 55.0 {
                            continue
                        }
                        // Resample at a uniform spacing rather than keeping the
                        // OSM nodes. This is not tidying: OSM digitises a bridge
                        // the way a surveyor walks it, so the Golden Gate's
                        // approach viaducts carry a node every fifteen metres and
                        // its 2.3 km main span carries NONE — the whole strait is
                        // one segment between two points on land. Every sampled
                        // point was therefore on dry ground, the deck-height pass
                        // found no water to clear, and the most famous bridge in
                        // the world came out as a flat road six metres above the
                        // sea. Even spacing puts points in the water, which is
                        // what the height heuristic reads, and gives the deck an
                        // even tessellation while it is there.
                        var spacing = 45.0
                        if length / spacing > 120.0 {
                            spacing = length / 120.0
                        }
                        let lanes = bridgeLanes(highway, tagStr(doc, tags, "lanes"))
                        let start = br.ptX.len
                        var count = 0
                        var walked = 0.0 // arc length of the next point to emit
                        var acc = 0.0 // arc length at wx[k-1]
                        var k = 1
                        br.ptX.push(wx[0])
                        br.ptZ.push(wz[0])
                        count = 1
                        walked = spacing
                        while k < gn {
                            let dx = wx[k] - wx[k - 1]
                            let dz = wz[k] - wz[k - 1]
                            let seg = Math.sqrt(dx * dx + dz * dz)
                            while seg > 0.0 && walked <= acc + seg {
                                let t = (walked - acc) / seg
                                br.ptX.push(wx[k - 1] + dx * t)
                                br.ptZ.push(wz[k - 1] + dz * t)
                                count += 1
                                walked += spacing
                            }
                            acc += seg
                            k += 1
                        }
                        // The last node always survives: a resampling that stops
                        // short leaves a gap at the abutment.
                        if walked - spacing < length - 0.5 {
                            br.ptX.push(wx[gn - 1])
                            br.ptZ.push(wz[gn - 1])
                            count += 1
                        }
                        // Half the carriageway plus a parapet.
                        var halfW = lanes * 3.65 * 0.5 + 1.5
                        // A dual carriageway is TWO OSM ways eight metres apart,
                        // and two overlapping decks at almost the same height
                        // z-fight into a dashed line. One deck wide enough to
                        // cover both is what the bridge actually looks like: the
                        // Golden Gate's two carriageways come out as one 22 m
                        // deck against a real 27 m.
                        let dup = twinOf(br, wx[0], wz[0], wx[gn - 1], wz[gn - 1])
                        if dup >= 0 {
                            let sep = midGap(br, dup, wx[0], wz[0], wx[gn - 1], wz[gn - 1])
                            br.halfW[dup] = Math.maxF64(br.halfW[dup], sep * 0.5 + halfW)
                            br.ptX.truncate(start)
                            br.ptZ.truncate(start)
                            continue
                        }
                        br.halfW.push(halfW)
                        br.structure.push(structureCode(tagStr(doc, tags, "bridge:structure")))
                        br.colour.push(parseColour(tagStr(doc, tags, "colour")))
                        br.start.push(start)
                        br.len.push(count)
                    }
                }
                Err(_e) => {
                    print("  bridge JSON parse failed")
                }
            }
        }
        Err(e) => {
            print("  " + e)
        }
    }
    print("  kept " + br.halfW.len.toString() + " bridges")
    return br
}

// The already-kept way this one is the other carriageway of, or -1. Same place,
// same length, either direction — which is exactly how OSM stores a divided road.
fn twinOf(br: &Bridges, ax: f64, az: f64, bx: f64, bz: f64): i64 {
    let mx = (ax + bx) * 0.5
    let mz = (az + bz) * 0.5
    for i in 0..br.halfW.len {
        let s = br.start[i]
        let e = s + br.len[i] - 1
        let omx = (br.ptX[s] + br.ptX[e]) * 0.5
        let omz = (br.ptZ[s] + br.ptZ[e]) * 0.5
        let dx = mx - omx
        let dz = mz - omz
        if dx * dx + dz * dz > 900.0 {
            continue
        }
        let ox = br.ptX[e] - br.ptX[s]
        let oz = br.ptZ[e] - br.ptZ[s]
        let olen = Math.sqrt(ox * ox + oz * oz)
        let span = Math.sqrt((bx - ax) * (bx - ax) + (bz - az) * (bz - az))
        if Math.abs(olen - span) < span * 0.25 + 20.0 {
            return i
        }
    }
    return -1
}

fn midGap(br: &Bridges, i: i64, ax: f64, az: f64, bx: f64, bz: f64): f64 {
    let s = br.start[i]
    let e = s + br.len[i] - 1
    let dx = (ax + bx) * 0.5 - (br.ptX[s] + br.ptX[e]) * 0.5
    let dz = (az + bz) * 0.5 - (br.ptZ[s] + br.ptZ[e]) * 0.5
    return Math.sqrt(dx * dx + dz * dz)
}

fn putBridges(buf: &mut string, br: &Bridges) {
    putI32(&mut buf, br.halfW.len)
    for i in 0..br.halfW.len {
        putCm(&mut buf, br.halfW[i])
        putI32(&mut buf, br.structure[i])
        putI32(&mut buf, br.colour[i])
        putI32(&mut buf, br.len[i])
        let s = br.start[i]
        for k in 0..br.len[i] {
            putCm(&mut buf, br.ptX[s + k])
            putCm(&mut buf, br.ptZ[s + k])
        }
    }
}

// ------------------------------------------------------------------ imagery

// Pixels per request. The service refuses to go higher: asking for 4096 returns
// a 500, which is why the drape is stitched from several requests rather than
// simply asked for at the size wanted.
let ORTHO_TILE_PX: i64 = 2048

// Requests per side. The finished drape is ORTHO_TILES * ORTHO_TILE_PX square.
//
// Two gives 4096 over a 16 km asset, which is 3.9 m a pixel against the 7.8 m a
// single request produced. The imagery underneath is NAIP at about a metre, so
// four would be better again and costs sixteen requests, a 200 MB texture and a
// download nobody asked for. Two is where the picture visibly improves and the
// asset stays a reasonable size.
let ORTHO_TILES: i64 = 2

fn orthoTileUrl(latMin: f64, lonMin: f64, latMax: f64, lonMax: f64): string {
    let bbox = fmt7(lonMin) + "," + fmt7(latMin) + "," + fmt7(lonMax) + "," + fmt7(latMax)
    return "https://basemap.nationalmap.gov/arcgis/rest/services/USGSImageryOnly/MapServer/export?bbox=" + bbox + "&bboxSR=4326&imageSR=4326&size=" + ORTHO_TILE_PX.toString() + "," + ORTHO_TILE_PX.toString() + "&format=png24&f=image"
}

// One request, decoded, or None.
fn fetchOrthoTile(latMin: f64, lonMin: f64, latMax: f64, lonMax: f64): Option<PngImage> {
    let url = orthoTileUrl(latMin, lonMin, latMax, lonMax)
    var attempt = 0
    while attempt < 3 {
        match fetch(url) {
            Ok(resp) => {
                let body = resp.text()
                // A PNG this small over a 2048-square extent is the service's
                // empty tile, not a photograph — that is how a place outside the
                // imagery's coverage announces itself, with a 200.
                if resp.ok() && body.len > 200000 {
                    match Png.decode(body) {
                        Ok(img) => {
                            if img.width == ORTHO_TILE_PX && img.height == ORTHO_TILE_PX {
                                return Some(img)
                            }
                            print("  tile came back " + img.width.toString() + "x" + img.height.toString())
                        }
                        Err(e) => {
                            print("  tile did not decode: " + e)
                        }
                    }
                } else {
                    print("  imagery service returned " + resp.status.toString() + ", " + (body.len / 1024).toString() + " KiB")
                }
            }
            Err(_e) => {
                print("  imagery service unreachable")
            }
        }
        attempt += 1
        if attempt < 3 {
            sleepSecs(4)
        }
    }
    return None
}

// A square aerial photograph of exactly the asset's extent, stitched from a grid
// of requests.
//
// It used to be one request written to disk byte for byte, which was the right
// shape while one request could cover the asset. It cannot: the service caps a
// single export at 2048 pixels, so the only way to a sharper drape is several
// exports and a seam-free join, and joining them means this function now decodes
// and re-encodes rather than passing bytes through.
//
// Assembled one BAND at a time — the row of tiles across, then the next row down
// — so only one band is ever decoded at once. Holding the whole grid would be
// four times the memory for no benefit, and the output has to be written in
// row order regardless.
fn fetchOrtho(latMin: f64, lonMin: f64, latMax: f64, lonMax: f64, out: &string): bool {
    if pathExists(out) {
        print("  drape already at " + out.clone())
        return true
    }
    let side = ORTHO_TILES * ORTHO_TILE_PX
    print("  fetching imagery: " + ORTHO_TILES.toString() + "x" + ORTHO_TILES.toString() + " requests -> " + side.toString() + " px")

    var pixels: string = ""
    for ty in 0..ORTHO_TILES {
        // Row 0 of a PNG is its NORTH edge, so the first band is the top of the
        // box and latitude counts DOWN as ty increases. Getting this backwards
        // flips the drape north-to-south, which over a city is unmistakable and
        // over open country is not.
        let latHi = latMax - (latMax - latMin) * (ty as f64) / (ORTHO_TILES as f64)
        let latLo = latMax - (latMax - latMin) * ((ty + 1) as f64) / (ORTHO_TILES as f64)

        var band: Vec<PngImage> = Vec.new()
        for tx in 0..ORTHO_TILES {
            let lonLo = lonMin + (lonMax - lonMin) * (tx as f64) / (ORTHO_TILES as f64)
            let lonHi = lonMin + (lonMax - lonMin) * ((tx + 1) as f64) / (ORTHO_TILES as f64)
            let Some(img) = fetchOrthoTile(latLo, lonLo, latHi, lonHi) else {
                print("  imagery tile " + tx.toString() + "," + ty.toString() + " failed; giving up")
                return false
            }
            print("    tile " + tx.toString() + "," + ty.toString() + " ok")
            band.push(img)
        }

        for row in 0..ORTHO_TILE_PX {
            for tx in 0..ORTHO_TILES {
                let ch = band[tx].channels
                let base = row * ORTHO_TILE_PX * ch
                for px in 0..ORTHO_TILE_PX {
                    let k = base + px * ch
                    Bytes.writeU8(&mut pixels, band[tx].pixels[k])
                    Bytes.writeU8(&mut pixels, band[tx].pixels[k + 1])
                    Bytes.writeU8(&mut pixels, band[tx].pixels[k + 2])
                }
            }
        }
    }

    match encodePng(pixels, side, side, 3) {
        Ok(enc) => {
            match writeFile(out.clone(), enc) {
                Ok(n) => {
                    print("  wrote " + out.clone() + " (" + (n / 1024).toString() + " KiB, " + side.toString() + "px)")
                    return true
                }
                Err(_e) => {
                    print("  could not write " + out.clone())
                    return false
                }
            }
        }
        Err(e) => {
            print("  could not encode drape: " + e)
            return false
        }
    }
}

// `foo.city` -> `foo.ortho.png`, the name cityLoad looks for beside an asset.
fn orthoPathOf(cityPath: &string): string {
    var n = cityPath.len
    if cityPath.endsWith(".city") {
        n -= 5
    }
    var base = ""
    for i in 0..n {
        base.push(cityPath[i])
    }
    return base + ".ortho.png"
}

fn updateOrtho(path: string) {
    let Ok(src) = readFile(path) else {
        print("cannot read " + path)
        return
    }
    let Ok(c) = cityParse(src) else {
        print("cannot parse " + path)
        return
    }
    print(c.name.clone() + ": " + fmt7(c.originLat) + ", " + fmt7(c.originLon) + "  radius " + (c.reach as i64).toString() + " m")
    let mPerLon = M_PER_DEG_LAT * Math.cos(c.originLat * 3.14159265358979 / 180.0)
    let _ = fetchOrtho(c.originLat - c.reach / M_PER_DEG_LAT, c.originLon - c.reach / mPerLon, c.originLat + c.reach / M_PER_DEG_LAT, c.originLon + c.reach / mPerLon, orthoPathOf(path))
}

// --------------------------------------------------------------------- main

fn flagOf(a: &Vec<string>, name: &string, dflt: string): string {
    for i in 0..a.len {
        if a[i] == name && i + 1 < a.len {
            return a[i + 1].clone()
        }
    }
    return dflt
}

fn main() {
    let a = args()
    let update = flagOf(a, "--update", "")
    if update != "" {
        updateBridges(update)
        return
    }
    let parts = flagOf(a, "--parts", "")
    if parts != "" {
        updateParts(parts)
        return
    }
    let orthoOnly = flagOf(a, "--ortho", "")
    if orthoOnly != "" {
        updateOrtho(orthoOnly)
        return
    }
    let name = flagOf(a, "--name", "City")
    let lat = leadingNumSigned(flagOf(a, "--lat", "37.7897"))
    let lon = leadingNumSigned(flagOf(a, "--lon", "-122.4000"))
    let radius = leadingNumSigned(flagOf(a, "--radius", "3000"))
    let out = flagOf(a, "-o", "examples/games/flight/cities/city.city")

    // .cache is a two-level path and makeDir is not recursive.
    let _ = makeDir(".cache", 493)
    let _ = makeDir(CACHE, 493)

    let mPerLon = M_PER_DEG_LAT * Math.cos(lat * 3.14159265358979 / 180.0)
    let latMin = lat - radius / M_PER_DEG_LAT
    let latMax = lat + radius / M_PER_DEG_LAT
    let lonMin = lon - radius / mPerLon
    let lonMax = lon + radius / mPerLon

    print(name + ": " + fmt7(lat) + ", " + fmt7(lon) + "  radius " + (radius as i64).toString() + " m")

    // ── terrain ──
    var tiles = Tiles {
        names: Vec.new(), data: Vec.new()
    }
    let demN = (2.0 * radius / DEM_STEP) as i64 + 1
    let demX0 = 0.0 - radius
    let demZ0 = 0.0 - radius
    print("terrain: " + demN.toString() + "x" + demN.toString() + " @ " + (DEM_STEP as i64).toString() + " m")
    var dem: Vec<f64> = Vec.filled(demN * demN, 0.0)
    var peak = 0.0
    for iz in 0..demN {
        let z = demZ0 + (iz as f64) * DEM_STEP
        let sLat = lat + z / M_PER_DEG_LAT
        for ix in 0..demN {
            let x = demX0 + (ix as f64) * DEM_STEP
            let sLon = lon + x / mPerLon
            let h = srtmAt(&mut tiles, sLat, sLon)
            dem[iz * demN + ix] = h
            if h > peak {
                peak = h
            }
        }
    }
    print("  highest point " + (peak as i64).toString() + " m")

    // ── land cover ──
    let coverN = (2.0 * radius / COVER_STEP) as i64 + 1
    let coverX0 = 0.0 - radius
    let coverZ0 = 0.0 - radius
    var cover: Vec<u8> = Vec.filled(coverN * coverN, COVER_URBAN)

    let bbox = bboxStr(latMin, lonMin, latMax, lonMax)
    // Narrow filters, not a bare key match: `way["natural"]` over a city bbox
    // drags in every tree and rock as its own way, and the public instances
    // shed that query rather than run it.
    let coverQ = "[out:json][timeout:180];(way[\"leisure\"~\"^(park|garden|golf_course|pitch|nature_reserve)$\"]" + bbox.clone() + ";way[\"landuse\"~\"^(forest|grass|meadow|cemetery|recreation_ground|village_green|allotments)$\"]" + bbox.clone() + ";way[\"natural\"~\"^(wood|scrub|grassland|heath|beach|sand|water|wetland)$\"]" + bbox.clone() + ";way[\"waterway\"=\"riverbank\"]" + bbox.clone() + ";);out tags geom;"
    var greens = 0
    match overpass(coverQ, cacheName("cover", latMin, lonMin, latMax, lonMax)) {
        Ok(body) => {
            match Json.parse(body) {
                Ok(doc) => {
                    let els = doc.curField(doc.curRoot(), "elements")
                    let n = doc.curLen(els)
                    print("  " + n.toString() + " land-cover ways")
                    var px: Vec<f64> = Vec.new()
                    var pz: Vec<f64> = Vec.new()
                    for i in 0..n {
                        let el = doc.curChild(els, i)
                        let code = coverCodeFor(doc, doc.curField(el, "tags"))
                        if code == COVER_URBAN {
                            continue
                        }
                        let geom = doc.curField(el, "geometry")
                        let gn = doc.curLen(geom)
                        if gn < 3 {
                            continue
                        }
                        px.clear()
                        pz.clear()
                        for k in 0..gn {
                            let p = doc.curChild(geom, k)
                            let plat = floatOf(doc, doc.curField(p, "lat"))
                            let plon = floatOf(doc, doc.curField(p, "lon"))
                            px.push((plon - lon) * mPerLon)
                            pz.push((plat - lat) * M_PER_DEG_LAT)
                        }
                        fillPoly(&mut cover, coverN, coverX0, coverZ0, COVER_STEP, px, pz, code)
                        greens += 1
                    }
                }
                Err(_e) => {
                    print("  land-cover JSON parse failed")
                }
            }
        }
        Err(e) => {
            print("  " + e)
        }
    }
    print("  filled " + greens.toString() + " cover polygons")

    // ── buildings ──
    var bH: Vec<f64> = Vec.new()
    var bStart: Vec<i64> = Vec.new()
    var bLen: Vec<i64> = Vec.new()
    var bPtX: Vec<f64> = Vec.new()
    var bPtZ: Vec<f64> = Vec.new()
    var bRoof: Vec<u8> = Vec.new()
    var bRoofH: Vec<f64> = Vec.new()
    var bBase: Vec<f64> = Vec.new()
    scanBuildings(bbox, latMin, lonMin, latMax, lonMax, lat, lon, mPerLon, &mut bH, &mut bStart, &mut bLen, &mut bPtX, &mut bPtZ, &mut bRoof, &mut bRoofH)
    for i in 0..bH.len {
        bBase.push(0.0)
    }
    mergeParts(bbox, latMin, lonMin, latMax, lonMax, lat, lon, mPerLon, &mut bH, &mut bBase, &mut bStart, &mut bLen, &mut bPtX, &mut bPtZ, &mut bRoof, &mut bRoofH)

    // ── bridges ──
    let br = fetchBridges(bbox, lat, lon, mPerLon, cacheName("bridges", latMin, lonMin, latMax, lonMax))

    // ── serialise ──
    var buf = ""
    for i in 0..8 {
        buf.push(MAGIC[i])
    }
    putI32(&mut buf, VERSION)
    putI32(&mut buf, name.len)
    for i in 0..name.len {
        buf.push(name[i])
    }
    putI32(&mut buf, Math.round(lat * 10000000.0) as i64)
    putI32(&mut buf, Math.round(lon * 10000000.0) as i64)
    putCm(&mut buf, radius)

    putI32(&mut buf, demN)
    putCm(&mut buf, DEM_STEP)
    putCm(&mut buf, demX0)
    putCm(&mut buf, demZ0)
    for i in 0..(demN * demN) {
        putCm(&mut buf, dem[i])
    }

    putI32(&mut buf, coverN)
    putCm(&mut buf, COVER_STEP)
    putCm(&mut buf, coverX0)
    putCm(&mut buf, coverZ0)
    for i in 0..(coverN * coverN) {
        buf.push(cover[i])
    }

    putI32(&mut buf, bH.len)
    for i in 0..bH.len {
        putCm(&mut buf, bH[i])
        putI32(&mut buf, bLen[i])
        let s = bStart[i]
        for k in 0..bLen[i] {
            putCm(&mut buf, bPtX[s + k])
            putCm(&mut buf, bPtZ[s + k])
        }
    }

    putBridges(&mut buf, br)
    putRoofs(&mut buf, bRoof, bRoofH, bBase)

    match writeFile(out.clone(), buf) {
        Ok(nbytes) => {
            print("wrote " + out.clone() + " (" + (nbytes / 1024).toString() + " KiB)")
            let _ = fetchOrtho(latMin, lonMin, latMax, lonMax, orthoPathOf(out))
        }
        Err(_e) => {
            print("could not write " + out)
        }
    }
}

// Refetch only the bridge layer and splice it onto an existing asset.
//
// Everything before the bridge section is byte-for-byte what it was, so the
// terrain, the land cover and the hundred thousand footprints are copied
// straight across — no Overpass call, no reprojection, and no chance of the
// expensive layers coming back subtly different because OSM moved underneath.
// Re-derive only the roof section and splice it onto an existing asset.
//
// The building layer is the expensive one and OSM moves under it, so rebuilding
// the whole asset to add a roof shape would quietly change a hundred thousand
// footprints too. This reads the same Overpass response the body was built from
// (cached, so usually no network at all), runs the same scan, and refuses to
// write if it does not come back with the same number of buildings — the
// section is positional and a mismatch would put roofs on the wrong ones.
// Rebuild the building layer of an existing asset from the cached OSM response
// plus a fresh part query, and splice it back in.
//
// A full refetch would be the obvious way to add the part layer, and it is the
// wrong one: it re-downloads eight megabytes of imagery and re-queries terrain,
// land cover and bridges, all of which are already correct and none of which OSM
// leaves alone between fetches. This rewrites exactly the bytes that change —
// the building section and the roof section after it — and copies everything
// else across untouched.
fn updateParts(path: string) {
    let Ok(src) = readFile(path) else {
        print("cannot read " + path)
        return
    }
    let Ok(c) = cityParse(src) else {
        print("cannot parse " + path)
        return
    }
    print(c.name.clone() + ": " + fmt7(c.originLat) + ", " + fmt7(c.originLon) + "  radius " + (c.reach as i64).toString() + " m")

    let _ = makeDir(".cache", 493)
    let _ = makeDir(CACHE, 493)
    let mPerLon = M_PER_DEG_LAT * Math.cos(c.originLat * 3.14159265358979 / 180.0)
    let latMin = c.originLat - c.reach / M_PER_DEG_LAT
    let latMax = c.originLat + c.reach / M_PER_DEG_LAT
    let lonMin = c.originLon - c.reach / mPerLon
    let lonMax = c.originLon + c.reach / mPerLon
    let bbox = bboxStr(latMin, lonMin, latMax, lonMax)

    var bH: Vec<f64> = Vec.new()
    var bStart: Vec<i64> = Vec.new()
    var bLen: Vec<i64> = Vec.new()
    var bPtX: Vec<f64> = Vec.new()
    var bPtZ: Vec<f64> = Vec.new()
    var bRoof: Vec<u8> = Vec.new()
    var bRoofH: Vec<f64> = Vec.new()
    var bBase: Vec<f64> = Vec.new()
    scanBuildings(bbox, latMin, lonMin, latMax, lonMax, c.originLat, c.originLon, mPerLon, &mut bH, &mut bStart, &mut bLen, &mut bPtX, &mut bPtZ, &mut bRoof, &mut bRoofH)
    // The rescan has to reproduce the section it is replacing before it is
    // allowed to add to it. A different count means OSM moved under the cache,
    // and the terrain and cover sections about to be copied across came from the
    // world as it was, not as it is.
    if bH.len != c.bCount {
        print("refusing to write: rescan found " + bH.len.toString() + " buildings, the asset holds " + c.bCount.toString())
        return
    }
    for i in 0..bH.len {
        bBase.push(0.0)
    }
    mergeParts(bbox, latMin, lonMin, latMax, lonMax, c.originLat, c.originLon, mPerLon, &mut bH, &mut bBase, &mut bStart, &mut bLen, &mut bPtX, &mut bPtZ, &mut bRoof, &mut bRoofH)

    // Where the building section starts: everything before it is fixed-size or
    // sized by a field already parsed.
    var head = 8 + 4 + 4 + c.name.len + 12
    head = head + 16 + c.demN * c.demN * 4
    head = head + 16 + c.coverN * c.coverN

    var buf = ""
    for i in 0..8 {
        buf.push(MAGIC[i])
    }
    putI32(&mut buf, VERSION)
    for i in 12..head {
        buf.push(src[i])
    }
    putI32(&mut buf, bH.len)
    for i in 0..bH.len {
        putCm(&mut buf, bH[i])
        putI32(&mut buf, bLen[i])
        let st = bStart[i]
        for k in 0..bLen[i] {
            putCm(&mut buf, bPtX[st + k])
            putCm(&mut buf, bPtZ[st + k])
        }
    }
    // Bridges, byte for byte.
    for i in c.bodyEnd..c.bridgeEnd {
        buf.push(src[i])
    }
    putRoofs(&mut buf, bRoof, bRoofH, bBase)
    match writeFile(path, buf) {
        Ok(nbytes) => {
            print("rewrote " + path + " (" + (nbytes / 1024).toString() + " KiB, version " + VERSION.toString() + ")")
        }
        Err(_e) => {
            print("could not write " + path)
        }
    }
}

fn updateBridges(path: string) {
    let Ok(src) = readFile(path) else {
        print("cannot read " + path)
        return
    }
    let Ok(c) = cityParse(src) else {
        print("cannot parse " + path)
        return
    }
    print(c.name.clone() + ": " + fmt7(c.originLat) + ", " + fmt7(c.originLon) + "  radius " + (c.reach as i64).toString() + " m")

    let _ = makeDir(".cache", 493)
    let _ = makeDir(CACHE, 493)
    let mPerLon = M_PER_DEG_LAT * Math.cos(c.originLat * 3.14159265358979 / 180.0)
    let latMin = c.originLat - c.reach / M_PER_DEG_LAT
    let latMax = c.originLat + c.reach / M_PER_DEG_LAT
    let lonMin = c.originLon - c.reach / mPerLon
    let lonMax = c.originLon + c.reach / mPerLon
    let bbox = bboxStr(latMin, lonMin, latMax, lonMax)
    let br = fetchBridges(bbox, c.originLat, c.originLon, mPerLon, cacheName("bridges", latMin, lonMin, latMax, lonMax))

    var buf = ""
    for i in 0..8 {
        buf.push(MAGIC[i])
    }
    putI32(&mut buf, VERSION)
    for i in 12..c.bodyEnd {
        buf.push(src[i])
    }
    putBridges(&mut buf, br)
    // The roof section sits after the bridges, so a new bridge section of a
    // different length moves it. Written back out from what was parsed rather
    // than copied byte-wise for that reason.
    putRoofs(&mut buf, c.bRoof, c.bRoofH, c.bBase)
    match writeFile(path, buf) {
        Ok(nbytes) => {
            print("rewrote " + path + " (" + (nbytes / 1024).toString() + " KiB, version " + VERSION.toString() + ")")
        }
        Err(_e) => {
            print("could not write " + path)
        }
    }
}

fn floatOf(doc: &Json, cur: i64): f64 {
    match doc.curFloat(cur) {
        Some(v) => {
            return v
        }
        None => {
            return 0.0
        }
    }
}

fn leadingNumSigned(s: string): f64 {
    var neg = false
    var body = s.clone()
    if body.len > 0 && body[0] == 45 as u8 {
        neg = true
        var t = ""
        for i in 1..body.len {
            t.push(body[i])
        }
        body = t
    }
    let v = leadingNum(body)
    if neg {
        return 0.0 - v
    }
    return v
}
