// The 3D pipeline: a perspective camera, and the vertex streams every triangle in
// the game is recorded into.
//
// Nothing here draws a pixel. A `triangle*` call appends three vertices to one of
// five streams, keyed by which texture the triangle wants; `gpuworld.drawStreams`
// then uploads each stream and issues one draw call for it. Depth, clipping and
// perspective division are the driver's.
//
// Recording rather than drawing is unchanged from when the rasteriser was a
// scanline loop on N threads — it is the reason two thousand lines of geometry in
// render3d.milo did not have to move. What changed is what a recorded triangle
// is: it used to be a set-up `Cmd` in camera space, clipped by hand against the
// near plane and filed under every horizontal band its bounding box touched. It
// is now ten floats per vertex in world space, and the hardware does the rest.

from "std/math" import {
    Math
}
from "./texture" import {
    SLOT_COUNT, SLOT_FALL, SLOT_NONE, Texture, Vtx, vtxC
}

pub struct Vec3 {
    x: f64,
    y: f64,
    z: f64,
}

// Vector math as operators and methods, not as loose scalars.
//
// Everything below used to be written out one component at a time, and the cost
// was not typing: a cross product spelled three times in three files is three
// chances to transpose an index, which is exactly what happened while this file
// was being written. `Vec3` is Copy, passed in registers, and every one of these
// inlines to the same code the by-hand version emitted — the safety is free.
impl Add for Vec3 {
    fn add(self: &Self, o: &Self): Self {
        return Vec3 {
            x: self.x + o.x, y: self.y + o.y, z: self.z + o.z
        }
    }
}

impl Sub for Vec3 {
    fn sub(self: &Self, o: &Self): Self {
        return Vec3 {
            x: self.x - o.x, y: self.y - o.y, z: self.z - o.z
        }
    }
}

// Componentwise, which is what `Mul` means for a vector type. Scaling by a
// scalar is `.scale(k)` — Milo's `Mul` trait fixes the right-hand side to `Self`,
// so `v * 2.0` is not expressible today (see docs/backlog.md, operator RHS).
impl Mul for Vec3 {
    fn mul(self: &Self, o: &Self): Self {
        return Vec3 {
            x: self.x * o.x, y: self.y * o.y, z: self.z * o.z
        }
    }
}

impl Vec3 {
    fn scale(self: &Self, k: f64): Vec3 {
        return Vec3 {
            x: self.x * k, y: self.y * k, z: self.z * k
        }
    }

    fn dot(self: &Self, o: &Vec3): f64 {
        return self.x * o.x + self.y * o.y + self.z * o.z
    }

    fn cross(self: &Self, o: &Vec3): Vec3 {
        return Vec3 {
            x: self.y * o.z - self.z * o.y,
            y: self.z * o.x - self.x * o.z,
            z: self.x * o.y - self.y * o.x,
        }
    }

    fn len(self: &Self): f64 {
        return Math.sqrt(self.dot(self))
    }

    // Guarded: a zero-length direction is a bug upstream, but returning NaN from
    // it turns that bug into a whole frame of black pixels a long way from the
    // cause.
    fn norm(self: &Self): Vec3 {
        let l = self.len()
        if l <= 0.0 {
            return Vec3 {
                x: 0.0, y: 0.0, z: 0.0
            }
        }
        return self.scale(1.0 / l)
    }

    fn lerp(self: &Self, o: &Vec3, t: f64): Vec3 {
        return Vec3 {
            x: self.x + (o.x - self.x) * t,
            y: self.y + (o.y - self.y) * t,
            z: self.z + (o.z - self.z) * t,
        }
    }
}

pub fn v3(x: f64, y: f64, z: f64): Vec3 {
    return Vec3 {
        x: x, y: y, z: z
    }
}

// A linear-light colour. Same story as Vec3: three loose f64 parameters at the
// end of every drawing call, in an order nothing but convention enforced.
pub struct Rgb {
    r: f64,
    g: f64,
    b: f64,
}

impl Add for Rgb {
    fn add(self: &Self, o: &Self): Self {
        return Rgb {
            r: self.r + o.r, g: self.g + o.g, b: self.b + o.b
        }
    }
}

impl Mul for Rgb {
    fn mul(self: &Self, o: &Self): Self {
        return Rgb {
            r: self.r * o.r, g: self.g * o.g, b: self.b * o.b
        }
    }
}

impl Rgb {
    fn scale(self: &Self, k: f64): Rgb {
        return Rgb {
            r: self.r * k, g: self.g * k, b: self.b * k
        }
    }

    fn lerp(self: &Self, o: &Rgb, t: f64): Rgb {
        return Rgb {
            r: self.r + (o.r - self.r) * t,
            g: self.g + (o.g - self.g) * t,
            b: self.b + (o.b - self.b) * t,
        }
    }
}

pub fn rgb(r: f64, g: f64, b: f64): Rgb {
    return Rgb {
        r: r, g: g, b: b
    }
}

pub struct Camera {
    x: f64,
    y: f64,
    z: f64,
    yaw: f64, // heading, radians
    pitch: f64,
    roll: f64,
    fov: f64, // vertical field of view, radians
    near: f64,
    far: f64,
}

pub struct Scene {
    w: i64,
    h: i64,
    // sun direction, normalised, pointing FROM the surface TOWARD the light
    sunX: f64,
    sunY: f64,
    sunZ: f64,
    // Where distance haze begins and ends, in metres. What the haze is COLOURED
    // is no longer here: it is `sky.skyColor` evaluated along the view ray, so a
    // ridge against the horizon and the same ridge against the zenith fade into
    // different colours. `fogR/G/B` used to be the third of three disagreeing
    // notions of what the sky looked like.
    fogStart: f64,
    fogEnd: f64,
    // The two dials the weather presets turn, both feeding sky.skyColor: how much
    // haze washes the blue out of the dome, and how much of it is cloud.
    turbidity: f64,
    cloud: f64,
    // Extinction per metre at sea level, which is what `sky.aerial` integrates
    // along the view ray. Roughly 3.9 / visibility-in-metres, so 1e-4 is a clear
    // 40 km day and 4e-4 is a thick one.
    haze: f64,
    // The cloud VOLUME, as opposed to `cloud` above, which is the projected deck
    // in the sky pass and covers everything above the volume's top. Both exist:
    // the deck is what a cirrus sheet at 9 km should be — far enough that
    // parallax over a 16 km map is nil — and the volume is what you can fly into.
    cloudBase: f64,
    cloudTopMax: f64,
    cloudReach: f64,
    cloudOn: f64,
    cloudDens: f64,
    cloudWindX: f64,
    cloudWindZ: f64,
    rainPeak: f64,
    tris: i64, // triangles recorded this frame
    // One vertex stream per texture slot, ten floats per vertex, three vertices
    // per triangle. Grown and never shrunk: a frame is within a few percent of
    // the last one, so after the first second of flying every frame reuses the
    // same allocation and recording does no heap work at all.
    streams: Vec<Vec<f32>>,
}

pub fn sceneNew(w: i64, h: i64): Scene {
    var streams: Vec<Vec<f32>> = Vec.new()
    for _ in 0..SLOT_COUNT {
        let empty: Vec<f32> = Vec.new()
        streams.push(empty)
    }
    return Scene {
        w: w,
        h: h,
        sunX: 0.44,
        sunY: 0.78,
        sunZ: 0.44,
        fogStart: 420.0,
        fogEnd: 1500.0,
        turbidity: 0.35,
        cloud: 0.30,
        haze: 0.00018,
        cloudBase: 900.0,
        cloudTopMax: 2200.0,
        cloudReach: 8000.0,
        cloudOn: 0.0,
        cloudDens: 1.0,
        cloudWindX: 6.0,
        cloudWindZ: 2.0,
        rainPeak: 0.0,
        tris: 0,
        streams: streams,
    }
}

pub fn sceneClear(s: &mut Scene) {
    s.tris = 0
    for k in 0..SLOT_COUNT {
        s.streams[k].clear()
    }
}

// ── camera transform ──────────────────────────────────────────────────────────

// An orientation as three axes. The trig block that builds these was written out
// three times — camera, aircraft model, wingtip contrails — and the three copies
// had drifted: two of them rolled about a slightly different axis than the
// camera did, so a banked, pitched aircraft was drawn tilted a few degrees off
// the frame it was actually flying in.
pub struct Frame {
    fwd: Vec3,
    right: Vec3,
    up: Vec3,
}

pub fn frameOf(yaw: f64, pitch: f64, roll: f64): Frame {
    let cy = Math.cos(yaw)
    let sy = Math.sin(yaw)
    let cp = Math.cos(pitch)
    let sp = Math.sin(pitch)
    let cr = Math.cos(roll)
    let sr = Math.sin(roll)
    let fwd = v3(sy * cp, sp, cy * cp)
    // right = the world-up-crossed heading; up follows from the other two
    let right = v3(cy, 0.0, 0.0 - sy)
    let up = fwd.cross(right)
    // Roll rotates right and up about forward, leaving forward alone. The signs
    // look backwards because this basis is left-handed — fwd × right is +up, not
    // -up — so the textbook `right·cos + up·sin` rolls the wrong way round the
    // heading: a right turn came out with the left wing down and the horizon
    // tilting away from the turn instead of into it.
    return Frame {
        fwd: fwd,
        right: right.scale(cr) - up.scale(sr),
        up: up.scale(cr) + right.scale(sr),
    }
}

pub struct View {
    // Rows of the world→camera rotation, precomputed once per frame. These were
    // twelve loose f64 fields (rx, ry, rz, ux, …) — the same three vectors, spelled
    // so that no function could take "the right vector" as one thing.
    right: Vec3,
    up: Vec3,
    fwd: Vec3,
    eye: Vec3,
    scale: f64, // vertical projection scale in pixels
    cx: f64,
    cy: f64,
    // Carried from the Camera rather than read off a global: the clip plane and
    // the draw distance are properties of the camera looking at the scene, and
    // a second camera (a mirror, a map inset) would need its own.
    near: f64,
    far: f64,
}

// Terrain tessellation, and therefore draw distance, as a function of altitude.
//
// A fixed quad size and a fixed ring count give a fixed 4.4 km of drawn world,
// which is ample at 300 m and absurd at 3 km: from up there the ground directly
// below is already 3 km away, so most of the view is past the edge of the terrain
// and looking at nothing. That is the grey band under the horizon in every
// high-altitude frame, and it became much more obvious once there were clouds
// worth climbing above.
//
// Scaling the quad with altitude buys the distance for FREE: the tile count, and
// so the triangle count, is unchanged. What it spends is near-field detail, which
// is precisely what stops mattering as you climb — at 3 km a 440 m quad subtends
// less on screen than a 110 m quad does at 750 m.
//
// Quantised to powers of two rather than varying continuously: a grid whose cell
// size changes every frame re-tessellates every frame and the whole landscape
// crawls. Stepping at discrete altitudes means it changes rarely, and since both
// tessellations sample the same heightfield the step is nearly invisible.
//
// These live here rather than beside TILE in world3d because `viewOf` needs them
// and world3d imports this file, not the other way round.
pub let TILE_BASE: f64 = 110.0

pub let VIEW_TILES_N: i64 = 40

pub fn altScale(camY: f64): f64 {
    var k = 1.0
    var lim = 900.0
    for _ in 0..3 {
        if camY > lim {
            k *= 2.0
            lim *= 2.0
        }
    }
    return k
}

pub fn farOf(camY: f64): f64 {
    return (VIEW_TILES_N as f64) * TILE_BASE * altScale(camY)
}

pub fn viewOf(c: &Camera, w: i64, h: i64): View {
    let f = frameOf(c.yaw, c.pitch, c.roll)
    let scale = (h as f64) * 0.5 / Math.tan(c.fov * 0.5)
    return View {
        right: f.right,
        up: f.up,
        fwd: f.fwd,
        eye: v3(c.x, c.y, c.z),
        scale: scale,
        cx: (w as f64) * 0.5,
        cy: (h as f64) * 0.5,
        near: c.near,
        // The far plane follows the terrain tessellation, which follows altitude.
        // Derived here rather than stored on the Camera so that every path that
        // builds a View — the game loop, the screenshot tool, the opening survey —
        // gets the same answer without having to remember to update a field.
        far: farOf(c.y),
    }
}

// World point → camera space. z is depth along the view direction. Three dot
// products, which is what this always was under the twelve field names.
pub fn toCameraV(v: &View, p: &Vec3): Vec3 {
    let d = p - v.eye
    return v3(d.dot(v.right), d.dot(v.up), d.dot(v.fwd))
}

pub fn toCamera(v: &View, x: f64, y: f64, z: f64): Vec3 {
    return toCameraV(v, v3(x, y, z))
}

// ── recording ─────────────────────────────────────────────────────────────────

// Append one vertex to a stream, in the layout `gpuworld.WORLD_VERT` declares.
//
// `tri` is the triangle's own tint, folded into the vertex tint here rather than
// carried as a uniform: it is constant across a triangle and the vertex tint is
// interpolated, so multiplying at record time gives exactly what the scanline
// rasteriser computed as `cmd.tr * vr` per pixel — and it means every triangle in
// a stream can go out in one draw call instead of one per tint.
fn push(out: &mut Vec<f32>, p: &Vtx, tr: f64, tg: f64, tb: f64, tw: f64) {
    out.push(p.x as f32)
    out.push(p.y as f32)
    out.push(p.z as f32)
    out.push(p.u as f32)
    out.push(p.v as f32)
    out.push(p.light as f32)
    out.push((p.r * tr) as f32)
    out.push((p.g * tg) as f32)
    out.push((p.b * tb) as f32)
    out.push(tw as f32)
}

// Wholly behind the camera? Then it cannot be seen and there is no reason to put
// it on the bus.
//
// This is the ONLY culling left. The near-plane clip that used to live here —
// Sutherland-Hodgman against one plane, re-emitting three or four vertices —
// is the hardware's job now, and doing it by hand was the single most delicate
// piece of code in the renderer: terrain directly under a low-flying aircraft
// straddles the camera plane on every frame, and a triangle that straddles it
// projects to garbage.
fn behind(v: &View, a: &Vtx, b: &Vtx, d: &Vtx): bool {
    let za = (v3(a.x, a.y, a.z) - v.eye).dot(v.fwd)
    if za > v.near {
        return false
    }
    let zb = (v3(b.x, b.y, b.z) - v.eye).dot(v.fwd)
    if zb > v.near {
        return false
    }
    let zd = (v3(d.x, d.y, d.z) - v.eye).dot(v.fwd)
    return zd <= v.near
}

// ── triangle entry points ─────────────────────────────────────────────────────

// A flat-shaded world-space triangle: the Gouraud case with one colour on all
// three vertices and no light term, which the interpolation reproduces exactly.
pub fn triangle(s: &mut Scene, v: &View, wa: &Vec3, wb: &Vec3, wd: &Vec3, col: &Rgb) {
    triangleG(&mut s, v, vtxC(wa.x, wa.y, wa.z, 0.0, 0.0, 1.0, col.r, col.g, col.b, 0.0), vtxC(wb.x, wb.y, wb.z, 0.0, 0.0, 1.0, col.r, col.g, col.b, 0.0), vtxC(wd.x, wd.y, wd.z, 0.0, 0.0, 1.0, col.r, col.g, col.b, 0.0), 1.0, 1.0, 1.0)
}

// A textured world-space triangle. The texture is named by the `&Texture` it was
// built from; `slot` is what turns that into a stream and, later, a binding.
pub fn triangleV(s: &mut Scene, view: &View, t: &Texture, wa: &Vtx, wb: &Vtx, wd: &Vtx, tr: f64, tg: f64, tb: f64) {
    if behind(view, wa, wb, wd) {
        return
    }
    let slot = t.slot
    push(&mut s.streams[slot], wa, tr, tg, tb, wa.tw)
    push(&mut s.streams[slot], wb, tr, tg, tb, wb.tw)
    push(&mut s.streams[slot], wd, tr, tg, tb, wd.tw)
    s.tris += 1
}

// A triangle of falling water.
//
// Same ten floats as everything else, but `gpuworld.fallFrag` reads them as a
// water parameterisation rather than as albedo and light — see the table on that
// function. Recorded into its own stream because it is drawn translucent, after
// all the opaque geometry, with a shader of its own.
pub fn triangleF(s: &mut Scene, view: &View, wa: &Vtx, wb: &Vtx, wd: &Vtx, width: f64, total: f64, spray: f64) {
    if behind(view, wa, wb, wd) {
        return
    }
    push(&mut s.streams[SLOT_FALL], wa, width, total, spray, wa.tw)
    push(&mut s.streams[SLOT_FALL], wb, width, total, spray, wb.tw)
    push(&mut s.streams[SLOT_FALL], wd, width, total, spray, wd.tw)
    s.tris += 1
}

// A Gouraud world-space triangle. u/v on the vertices are ignored, and so is tw:
// the untextured stream is bound to a single white texel, and a texture weight of
// zero is what keeps the shader from needing a second variant.
pub fn triangleG(s: &mut Scene, view: &View, wa: &Vtx, wb: &Vtx, wd: &Vtx, tr: f64, tg: f64, tb: f64) {
    if behind(view, wa, wb, wd) {
        return
    }
    push(&mut s.streams[SLOT_NONE], wa, tr, tg, tb, 0.0)
    push(&mut s.streams[SLOT_NONE], wb, tr, tg, tb, 0.0)
    push(&mut s.streams[SLOT_NONE], wd, tr, tg, tb, 0.0)
    s.tris += 1
}

// Lambert term for a triangle whose world-space normal is (nx,ny,nz).
pub fn shade(s: &Scene, nx: f64, ny: f64, nz: f64, ambient: f64): f64 {
    var d = nx * s.sunX + ny * s.sunY + nz * s.sunZ
    if d < 0.0 {
        d = 0.0
    }
    return ambient + (1.0 - ambient) * d
}
