// The real environment over a real place: what the sun is doing, and (as this
// grows) what the sky and the weather are doing.
//
// Everything here is keyed to a moment and a coordinate rather than to a mood.
// The region weather table in `render3d.milo` answers "what does a coast feel
// like"; this answers "what is it like over 37.77N 122.42W right now", which is
// a different question with a checkable answer.
//
// Time comes from the clock, unless `FLYBY_UTC` is set to an epoch-seconds
// value, in which case that instant is used forever. That override exists so a
// screenshot is reproducible: without it every frame grab lands under a slightly
// different sun and no two pictures can be compared.
//
// `FLYBY_TIMESCALE` multiplies elapsed time, so a day can be run in a minute to
// watch shadows sweep. It is a debugging dial, not a game feature.

from "std/env" import {
    Env
}
from "std/runtime" import {
    Task, schedulerExists, schedulerYield
}
from "std/sync" import {
    Channel
}
from "std/time" import {
    epochSecs
}
from "std/datetime" import {
    DateTime
}
from "std/strconv" import {
    parseInt, parseFloat
}
from "./solar" import {
    SunDir, sunAt
}
from "./cloud" import {
    CLOUD_N, CloudField, cloudEmpty, cloudSynthetic, cloudAddTestCell
}
from "./wx" import {
    Obs, obsEmpty, fetchObs, fetchIr, fetchRadar, lclMetres
}
from "std/math" import {
    Math
}

// How the environment was arrived at, so the HUD can say so rather than implying
// a live feed that is not there. A fabricated sky presented as the real one is
// the failure mode worth engineering against.
pub enum EnvSource: i32 {
    Synthetic = 0,
    Computed = 1,
    Live = 2,
}

// Everything one fetch produces, as one value.
//
// Split out from `LiveEnv` so the work can happen on a task that owns nothing
// else: a background fetch that reached into the environment would be writing
// fields the renderer reads on another stack, and the whole point of doing this
// off the frame path is that the frame never sees a half-updated sky.
pub struct WxSnapshot {
    ok: bool,
    // The place this was fetched FOR. A background fetch takes about a second and
    // a place change takes less, so a snapshot can outlive the city that asked for
    // it — and installing San Francisco's sky over Honolulu is exactly the class
    // of error this whole file exists to prevent. Checked on install; a mismatch
    // is dropped.
    forLat: f64,
    forLon: f64,
    clouds: CloudField,
    obs: Obs,
    hazeK: f64,
    rainPeak: f64,
    rainFrac: f64,
}

pub struct LiveEnv {
    lat: f64,
    lon: f64,

    // Sun direction in world axes (+x east, +z north, +y up).
    sunX: f64,
    sunY: f64,
    sunZ: f64,
    sunElevDeg: f64,
    sunAzDeg: f64,

    // The instant the fields above describe, epoch seconds UTC.
    epoch: i64,
    // Set once at construction from FLYBY_UTC; -1 means follow the clock.
    frozenEpoch: i64,
    timeScale: f64,
    // Epoch at construction, so a scaled clock has something to run from.
    baseEpoch: i64,

    sunSource: EnvSource,

    // Ground elevation the cloud base is measured from, metres above sea level.
    //
    // A reported ceiling is ABOVE GROUND, because that is the number a pilot
    // needs and the ceilometer points straight up. The renderer works in absolute
    // world height. At sea level the two agree and the difference is invisible;
    // over the Grand Canyon, whose rim is 2100 m up, treating an 980 m ceiling as
    // an absolute altitude buries the entire cloud layer inside the rock, which is
    // exactly what it did.
    groundM: f64,

    // Whether this run asked for the real sky. Sampled once at startup and then
    // carried, because a place change has to make the same choice the startup did
    // — otherwise only the FIRST city is live and every city after it silently
    // falls back to invented weather, which is the exact failure this whole file
    // is written to avoid.
    liveWanted: bool,
    // Epoch seconds of the last successful fetch, and whether one is in flight.
    lastFetchSec: i64,
    fetching: bool,

    // The sky over this place: coverage and cloud-top height on a grid, with one
    // base for the layer. Synthetic until a fetch replaces it, and honest about
    // which it is — see `cloudSource`.
    clouds: CloudField,
    cloudSource: EnvSource,
    // The observation the sky was built from, kept so the HUD can name the
    // station and the hour. A live sky that cannot say where its numbers came
    // from is indistinguishable from an invented one.
    obs: Obs,
    // Extinction per metre, from the reported visibility. Koschmieder: the
    // meteorological range is where contrast falls to 2%, which is an optical
    // depth of ln(1/0.02) = 3.912.
    hazeK: f64,
    // Peak radar reflectivity anywhere on the map, 0..1, which sets how hard it
    // is raining where it is raining.
    rainPeak: f64,
    // Fraction of the map under meaningful reflectivity. Kept separately because
    // "is it raining here" and "how hard" are different questions and one number
    // answers neither well: a single bright cell in a corner is a peak of 1.0 and
    // is not a rainy day.
    rainFrac: f64,
    // Set when the field has changed and the GPU copy is stale. The renderer
    // clears it after uploading; nothing else writes it.
    cloudsDirty: bool,
}

fn envI64(name: string, fallback: i64): i64 {
    match Env.get(name) {
        Option.Some(v) => {
            return parseInt(v) ?? fallback
        }
        Option.None => {
            return fallback
        }
    }
}

// Public because the screenshot tool needs the same "read a number from the
// environment or fall back" behaviour to place its camera, and two copies of
// this would drift.
pub fn envF64(name: string, fallback: f64): f64 {
    match Env.get(name) {
        Option.Some(v) => {
            return parseFloat(v) ?? fallback
        }
        Option.None => {
            return fallback
        }
    }
}

pub fn envNew(lat: f64, lon: f64, reach: f64, groundM: f64): LiveEnv {
    let frozen = envI64("FLYBY_UTC", 0 - 1)
    let scale = envF64("FLYBY_TIMESCALE", 1.0)
    let now = epochSecs()
    var e = LiveEnv {
        lat: lat,
        lon: lon,
        sunX: 0.44,
        sunY: 0.78,
        sunZ: 0.44,
        sunElevDeg: 51.0,
        sunAzDeg: 180.0,
        epoch: now,
        frozenEpoch: frozen,
        timeScale: scale,
        baseEpoch: now,
        sunSource: EnvSource.Synthetic,
        groundM: groundM,
        liveWanted: false,
        lastFetchSec: 0,
        fetching: false,
        clouds: cloudEmpty(),
        cloudSource: EnvSource.Synthetic,
        obs: obsEmpty(),
        hazeK: 0.00013,
        rainPeak: 0.0,
        rainFrac: 0.0,
        cloudsDirty: true,
    }
    envRetime(&mut e, 0.0)
    envSynthWeather(&mut e, reach)
    return e
}

// Invent a sky. Used until real data lands, and for any place no feed covers.
//
// The parameters are the ones a surface observation actually reports, so the
// same call signature serves both: coverage in eighths of sky, a ceiling in
// metres and a layer thickness. That is deliberate — when the fetch arrives it
// fills the same field the same way, and nothing downstream changes.
pub fn envSynthWeather(e: &mut LiveEnv, reachIn: f64) {
    // An empty place has no extent, and a zero reach divides by zero in the
    // shader's world-to-grid mapping.
    var reach = reachIn
    if reach < 1000.0 {
        reach = 8000.0
    }
    // Varies with the place rather than being one fixed sky everywhere: the seed
    // comes off the coordinates, so San Francisco and Honolulu get different
    // weather and each one gets the SAME weather every run.
    let seed = e.lat * 3.7 + e.lon * 1.9
    // 980 m ABOVE THE GROUND here, not above the sea.
    var f = cloudSynthetic(reach, 0.42, e.groundM + 980.0, 1150.0, seed)
    // Test hook: FLYBY_FAKE_RAIN puts one storm cell on the map so the shaft
    // renderer can be checked when nothing is raining over any real city.
    let fake = envF64("FLYBY_FAKE_RAIN", 0.0)
    if fake > 0.01 {
        cloudAddTestCell(&mut f, reach * 0.25, 0.0 - reach * 0.15, reach * 0.30, fake)
        e.rainPeak = fake
        e.rainFrac = 0.08
    }
    e.clouds = f
    e.cloudSource = EnvSource.Synthetic
    e.cloudsDirty = true
}

// Build the sky over this place from what is actually being measured over it.
//
// Composition rule, and the reason this is not just "draw the satellite image":
// the STATION sets the level and the SATELLITE sets the pattern. A METAR is a
// precise measurement of one point — it knows the sky is six eighths covered with
// a base at 300 m, and it has no idea which six eighths. An infrared image is the
// exact opposite: it resolves the shape of the field across the whole map and
// systematically under-reads low cloud. Using either alone gets one of those two
// halves wrong. Normalising the satellite field to unit mean and multiplying the
// station's coverage through it takes the half each one is good at.
//
// Returns false and changes nothing if the observation could not be fetched,
// which leaves whatever sky was there before rather than clearing it: a dropped
// request is not a report of clear skies.
// How often to go back to the network, in seconds. The radar mosaic updates
// about every five minutes and a surface observation about every hour, so asking
// faster than this gets the same bytes back.
let WX_REFRESH_SECS: i64 = 300

// The finished snapshot, handed from the fetching task to the render loop.
//
// A pair of globals rather than a channel, and that is sound here rather than
// sloppy: these are GREEN tasks, cooperatively scheduled onto one thread, so the
// task runs only while the loop is inside `schedulerYield` and there is no
// instant at which both are executing. The flag is set after the value is
// written, which is the only ordering that matters when nothing can interleave
// between the two statements.
var WX_SNAP: WxSnapshot = WxSnapshot {
    ok: false,
    forLat: 0.0,
    forLon: 0.0,
    clouds: cloudEmpty(),
    obs: obsEmpty(),
    hazeK: 0.00013,
    rainPeak: 0.0,
    rainFrac: 0.0,
}

var WX_READY: bool = false

fn snapshotEmpty(): WxSnapshot {
    return WxSnapshot {
        ok: false,
        forLat: 0.0,
        forLon: 0.0,
        clouds: cloudEmpty(),
        obs: obsEmpty(),
        hazeK: 0.00013,
        rainPeak: 0.0,
        rainFrac: 0.0,
    }
}

// Copy a finished snapshot into the environment. One place, so the synchronous
// path and the background one cannot install it differently.
fn envInstall(e: &mut LiveEnv, snap: WxSnapshot) {
    var s = snap
    e.clouds = replace(s.clouds, cloudEmpty())
    e.obs = replace(s.obs, obsEmpty())
    e.hazeK = s.hazeK
    e.rainPeak = s.rainPeak
    e.rainFrac = s.rainFrac
    e.cloudSource = EnvSource.Live
    e.cloudsDirty = true
}

// Fetch on this stack and install. Used at startup and at a place change, both
// of which are already pauses.
pub fn envFetchLive(e: &mut LiveEnv, reachIn: f64): bool {
    let snap = buildSnapshot(e.lat, e.lon, reachIn, e.groundM)
    if !snap.ok {
        return false
    }
    e.lastFetchSec = epochSecs()
    envInstall(&mut e, snap)
    return true
}

fn buildSnapshot(lat: f64, lon: f64, reachIn: f64, groundM: f64): WxSnapshot {
    var reach = reachIn
    if reach < 1000.0 {
        reach = 8000.0
    }
    let o = fetchObs(lat, lon)
    if !o.ok {
        return snapshotEmpty()
    }

    // Measured where reported, modelled where not. A station that sees cloud
    // reports its base; one that sees none reports no layers at all, and the
    // condensation level is then the honest guess at where cloud WOULD form.
    var base = o.baseM
    if base < 0.0 {
        base = lclMetres(o.tempC, o.dewC)
    }
    // A station reporting cloud but no base leaves only the condensation level,
    // and that goes to zero when the air is saturated. Zero is not a cloud base,
    // it is fog; the floor keeps a saturated night from putting the deck inside
    // the buildings.
    if base < 150.0 {
        base = 150.0
    }
    // The observation is above ground; the renderer is above sea level.
    base = base + groundM
    let coverage = o.coverOktas / 8.0

    var structure: Vec<f32> = Vec.filled(CLOUD_N * CLOUD_N, 1.0)
    var haveIr = false
    match fetchIr(lat, lon, reach, CLOUD_N) {
        Option.Some(g) => {
            structure = g
            haveIr = true
        }
        Option.None => {
        }
    }
    var rain: Vec<f32> = Vec.filled(CLOUD_N * CLOUD_N, 0.0)
    var peak = 0.0
    var wet = 0
    match fetchRadar(lat, lon, reach, CLOUD_N) {
        Option.Some(g) => {
            for i in 0..g.len {
                let v = g[i] as f64
                if v > peak {
                    peak = v
                }
                if v > 0.15 {
                    wet = wet + 1
                }
            }
            rain = g
        }
        Option.None => {
        }
    }
    let rainFrac = (wet as f64) / ((CLOUD_N * CLOUD_N) as f64)

    var f = cloudEmpty()
    f.reach = reach
    f.baseM = base
    f.valid = true

    // Wind moves the detail, and it moves it DOWNWIND: a meteorological wind
    // direction is where the wind is coming FROM, so the vector points the other
    // way. 270 degrees is a westerly, which blows toward the east, which is +x.
    let toRad = 3.14159265358979 / 180.0
    let dirTo = (o.windDirDeg + 180.0) * toRad
    f.windX = Math.sin(dirTo) * o.windMps
    f.windZ = Math.cos(dirTo) * o.windMps

    // Normalise the satellite field to unit mean so multiplying it through the
    // station's coverage preserves that coverage. Without this the absolute
    // brightness of the infrared composite — which depends on the season, the
    // hour and the ground temperature — would set how cloudy the game is.
    var mean = 0.0
    for i in 0..structure.len {
        mean = mean + (structure[i] as f64)
    }
    mean = mean / (structure.len as f64)
    if mean < 0.02 {
        mean = 0.02
    }

    // Thicker cloud where it is raining, and deeper cloud when the base is high.
    // A 120 m marine stratus deck is a few hundred metres thick; a raining cumulus
    // congestus is kilometres. Precipitation is the one observation that reports
    // on depth at all, so it is what separates them.
    var thickness = 260.0 + base * 0.55
    if peak > 0.02 {
        thickness = thickness + 1400.0 * peak
    }

    var topMax = base + 120.0
    let n = f.n
    for j in 0..n {
        for i in 0..n {
            let idx = j * n + i
            var rel = (structure[idx] as f64) / mean
            if !haveIr {
                rel = 1.0
            }
            // Centred on 1.0 and widened about that centre.
            //
            // The widening has to be symmetric around 1.0 or it changes the mean,
            // and the mean is the whole point: the station measured this sky at a
            // particular number of eighths and the satellite is only being asked
            // where to put it. A previous form multiplied by (0.30 + 0.70*rel*1.55),
            // whose mean is 1.385, which quietly reported every sky as 39% more
            // covered than the station said — a 3/8 scattered day rendered as
            // broken overcast.
            var c = coverage * (1.0 + 1.15 * (rel - 1.0))
            let r = rain[idx] as f64
            // It cannot be raining out of a clear patch — but the correction has
            // to be proportional to how hard it is raining. A flat floor of 0.55
            // applied to any echo at all turned a measured 3/8 sky into overcast
            // everywhere the radar saw drizzle, which is the station being
            // overruled by its own weakest evidence. Below light-rain reflectivity
            // the echo says nothing about sky cover and is ignored.
            if r > 0.15 {
                let floorC = 0.30 + 0.60 * r
                if c < floorC {
                    c = floorC
                }
            }
            if c < 0.0 {
                c = 0.0
            }
            if c > 1.0 {
                c = 1.0
            }
            let top = base + thickness * (0.45 + 0.55 * c) + 900.0 * r
            if top > topMax {
                topMax = top
            }
            let k = idx * 3
            f.texel[k] = c as f32
            f.texel[k + 1] = top as f32
            f.texel[k + 2] = r as f32
        }
    }
    f.topMaxM = topMax

    var hazeK = 0.00013
    // Koschmieder. A reported 16 km visibility is 2.4e-4 per metre, which is a
    // markedly hazier sky than the 1.3e-4 the renderer had hard-coded — and it is
    // the measurement, so it wins.
    if o.hasVis && o.visibilityM > 200.0 {
        hazeK = 3.912 / o.visibilityM
    }
    return WxSnapshot {
        ok: true,
        forLat: lat,
        forLon: lon,
        clouds: f,
        obs: o,
        hazeK: hazeK,
        rainPeak: peak,
        rainFrac: rainFrac,
    }
}

// Called once a frame. Advances a background fetch and installs its result.
//
// This is what makes the weather realtime rather than a snapshot taken at
// startup: a flight lasts longer than the weather does. The fetch cannot run on
// the frame path — it is seconds of network — so it runs on a green task, and
// this yields to the scheduler once per frame to let it move.
//
// Measured before building it: a fetch driven this way completes in about 400 ms
// of wall clock and the WORST single yield is 20 ms. That is one dropped frame,
// once, every five minutes. A blocking refetch on the same schedule would be a
// second-long freeze.
pub fn envWeatherTick(e: &mut LiveEnv, reachIn: f64) {
    if !e.liveWanted {
        return
    }
    // Give the fetching task its slice. Guarded because the scheduler only exists
    // once something has been spawned, and a run that never goes live never
    // spawns anything.
    if schedulerExists() {
        schedulerYield()
    }
    if e.fetching {
        if WX_READY {
            WX_READY = false
            let snap = replace(WX_SNAP, snapshotEmpty())
            e.fetching = false
            // Dropped if the aircraft has moved to another place since this was
            // asked for. Comparing coordinates rather than a sequence number
            // because the coordinates ARE the identity of the request.
            let sameLat = snap.forLat - e.lat < 0.0001 && e.lat - snap.forLat < 0.0001
            let sameLon = snap.forLon - e.lon < 0.0001 && e.lon - snap.forLon < 0.0001
            if snap.ok && sameLat && sameLon {
                e.lastFetchSec = epochSecs()
                envInstall(&mut e, snap)
                if envF64("FLYBY_DEBUG_WX", 0.0) > 0.5 {
                    print("weather refreshed: " + envWeatherLabel(e))
                }
            } else {
                // A failed refresh keeps the sky that is already there. Weather
                // that vanishes because a public API had a bad minute would be a
                // worse answer than weather that is five minutes stale.
                e.lastFetchSec = epochSecs()
            }
        }
        return
    }
    // Overridable so the refresh can actually be exercised: waiting five minutes
    // to find out whether a five-minute timer works is not a test.
    var every = WX_REFRESH_SECS
    let over = envF64("FLYBY_WX_SECS", 0.0)
    if over > 0.5 {
        every = over as i64
    }
    if epochSecs() - e.lastFetchSec < every {
        return
    }
    var reach = reachIn
    if reach < 1000.0 {
        reach = 8000.0
    }
    let lat = e.lat
    let lon = e.lon
    let ground = e.groundM
    e.fetching = true
    WX_READY = false
    let _ = Task.spawn(move(): void => {
        let snap = buildSnapshot(lat, lon, reach, ground)
        WX_SNAP = snap
        WX_READY = true
    }
    )
}

// Whether the player asked for the real sky. Off by default: it costs several
// network round trips at startup and it makes the game's appearance depend on
// something outside the machine, both of which should be opt-in.
pub fn envLiveRequested(): bool {
    return envF64("FLYBY_LIVE", 0.0) > 0.5
}

// Ask for the real sky here and at every place this run visits afterwards.
pub fn envGoLive(e: &mut LiveEnv, reach: f64): bool {
    e.liveWanted = true
    return envFetchLive(&mut e, reach)
}

// One line describing where the sky came from, for the HUD and the console.
pub fn envWeatherLabel(e: &LiveEnv): string {
    if (e.cloudSource as i32) == (EnvSource.Live as i32) {
        var s = "LIVE " + e.obs.station.clone()
        // "0/8" and "nobody told us" are different statements and only one of
        // them is a measurement. Hawaii is the live case: PHNL is the nearest
        // station and an airport, and its observation currently carries no
        // temperature and no layers at all, so nothing in the chain ever reported
        // a sky. Printing 0/8 there would be inventing a clear sky — and the radar
        // is simultaneously showing showers over Oahu, which is how it was caught.
        if e.obs.coverOktas <= 0.0 && e.obs.baseM < 0.0 {
            s = s + "  SKY UNREPORTED"
        } else {
            s = s + "  " + ((e.obs.coverOktas as i64)).toString() + "/8"
        }
        s = s + "  base " + ((e.clouds.baseM as i64)).toString() + "m"
        // One bright cell in a corner is not a rainy day. A fiftieth of the map
        // under a real echo is.
        if e.rainFrac > 0.02 {
            s = s + "  RAIN"
        }
        return s
    }
    return "SYNTHETIC SKY"
}

// Point the environment at a new place without losing the clock.
pub fn envSetPlace(e: &mut LiveEnv, lat: f64, lon: f64, reach: f64, groundM: f64) {
    e.lat = lat
    e.lon = lon
    e.groundM = groundM
    envRetime(&mut e, 0.0)
    // Synthetic first so the new place always has A sky, then the real one over
    // the top if it can be had. A fetch that fails on arrival leaves invented
    // weather rather than no weather, and the HUD says which it is.
    envSynthWeather(&mut e, reach)
    if e.liveWanted {
        let _ = envFetchLive(&mut e, reach)
    }
}

// Recompute everything time-dependent. `elapsed` is seconds of wall clock since
// the environment was created, and is only consulted when the clock is scaled or
// frozen — otherwise the real clock is the truth and drift cannot accumulate.
pub fn envRetime(e: &mut LiveEnv, elapsed: f64) {
    if e.frozenEpoch >= 0 {
        e.epoch = e.frozenEpoch + ((elapsed * e.timeScale) as i64)
    } else {
        if e.timeScale == 1.0 {
            e.epoch = epochSecs()
        } else {
            e.epoch = e.baseEpoch + ((elapsed * e.timeScale) as i64)
        }
    }
    let t = DateTime.fromEpoch(e.epoch)
    let s = sunAt(e.lat, e.lon, t)
    e.sunX = s.x
    e.sunY = s.y
    e.sunZ = s.z
    e.sunElevDeg = s.elevationDeg
    e.sunAzDeg = s.azimuthDeg
    e.sunSource = EnvSource.Computed
}

// UTC label for the HUD, e.g. "2026-08-17 06:12Z".
pub fn envStamp(e: &LiveEnv): string {
    let t = DateTime.fromEpoch(e.epoch)
    return t.format()
}
