// FLYBY — one frame of the GPU path, straight to a PNG.
//
//   milo run examples/games/flight/gpushot.milo --release -- /tmp/shot.png sf 240
//
// Opens a hidden GL window, flies the real simulation for a few hundred frames
// with the autopilot at the controls, and reads the finished frame back off the
// framebuffer.
//
// It exists because the alternative is asking a human to take a screenshot every
// time a constant in a shader changes, which is a slow way to tune water — and
// because since the renderer moved to the GPU there is no other way to see a
// frame at all: nothing on the host ever holds the finished picture.

from "std/fs" import {
    readFile, writeFile
}
from "gl" import {
    GlContext, Gpu, readPixelsRgba8
}
from "std/png" import {
    encodePng
}
from "std/strconv" import {
    formatFloat
}
from "std/time" import {
    epochMillis
}
from "std/args" import {
    args
}
from "std/math" import {
    Math
}
from "sdl" import {
    SDL_CreateWindow, SDL_GetError, SDL_Init, SDL_Quit,
    SDL_INIT_VIDEO, SDL_WINDOWPOS_CENTERED
}
from "sdl/glcontext" import {
    SDL_GL_CreateContext, SDL_GL_SetAttribute,
    SDL_GL_CONTEXT_MAJOR_VERSION, SDL_GL_CONTEXT_MINOR_VERSION,
    SDL_GL_CONTEXT_PROFILE_CORE, SDL_GL_CONTEXT_PROFILE_MASK, SDL_WINDOW_OPENGL
}
from "./gfx" import {
    Canvas, canvasClear, canvasNew
}
from "./gfx3d" import {
    sceneNew, viewOf
}
from "./gpupost" import {
    CoverGrid, postBeginWorld, postFinish, postFree, postNew, postBindWorld, postSetClouds
}
from "./gpuworld" import {
    drawSkyPass, drawStreams, gpuWorldFree, gpuWorldNew, setOrtho, uploadStreams, drawShadowPass, gpuWorldSetClouds
}
from "./city" import {
    City, cityAttachOrtho, cityEmpty, cityHasSea, cityLoad, demHeights
}
from "./world3d" import {
    World, heightAt, settleUnderCeiling
}
from "./live" import {
    envF64, envLiveRequested, envGoLive, envWeatherLabel, envWeatherTick
}
from "./world3d" import {
    marksFor, worldIn, worldUpdate, SEED
}
from "./textures" import {
    groundTexture, planeTexture, facadeTexture
}
from "./render3d" import {
    drawWorld, drawHud, drawGuide, drawMarkGuide, drawMarkBeam, drawSpeedLines,
    drawChecklist, drawFound, drawFence
}

pub let W: i64 = 1280

pub let H: i64 = 720

pub let HIDDEN: u32 = 0x8

fn loadPlace(name: &string): City {
    let base = "examples/games/flight/cities/" + name
    match cityLoad(base + ".city") {
        Result.Ok(city) => {
            var c = city
            match readFile(base + ".ortho.png") {
                Result.Ok(png) => {
                    match cityAttachOrtho(&mut c, png) {
                        Result.Ok(_) => {
                        }
                        Result.Err(e) => {
                            print("ortho: " + e)
                        }
                    }
                }
                Result.Err(_) => {
                }
            }
            return c
        }
        Result.Err(e) => {
            print($"city: {e}")
            return cityEmpty()
        }
    }
}

// ABGR8888 words, bottom-up as GL hands them over, into top-down RGB bytes.
fn toRgb(px: &Vec<u32>, w: i64, h: i64): string {
    var out = ""
    for y in 0..h {
        let row = (h - 1 - y) * w
        for x in 0..w {
            let p = px[row + x]
            out.push((p & 0xFF) as u8)
            out.push(((p >> 8) & 0xFF) as u8)
            out.push(((p >> 16) & 0xFF) as u8)
        }
    }
    return out
}

pub fn main(): i32 {
    let a = args()
    var out = "/tmp/flyby-gpu.png"
    var place = "sf"
    var frames = 240
    if a.len > 1 {
        out = a[1].clone()
    }
    if a.len > 2 {
        place = a[2].clone()
    }
    if a.len > 3 {
        frames = strToI64(a[3])
    }
    // Park the camera in front of landmark N instead of flying the autopilot.
    // Without this there is no way to photograph a specific thing: the autopilot
    // decides where the aircraft is, and tuning a waterfall by re-running the
    // flight until it happens to point at one is not a workflow.
    var mark = 0 - 1
    if a.len > 4 {
        mark = strToI64(a[4])
    }
    var dist = 900.0
    if a.len > 5 {
        dist = (strToI64(a[5])) as f64
    }

    if SDL_Init(SDL_INIT_VIDEO) != 0 {
        print("SDL_Init failed")
        return 1
    }
    unsafe {
        let _ = SDL_GL_SetAttribute(SDL_GL_CONTEXT_MAJOR_VERSION, 3)
        let _ = SDL_GL_SetAttribute(SDL_GL_CONTEXT_MINOR_VERSION, 3)
        let _ = SDL_GL_SetAttribute(SDL_GL_CONTEXT_PROFILE_MASK, SDL_GL_CONTEXT_PROFILE_CORE)
        let win = SDL_CreateWindow("gpushot", SDL_WINDOWPOS_CENTERED, SDL_WINDOWPOS_CENTERED, W as i32, H as i32, SDL_WINDOW_OPENGL | HIDDEN)
        if (win as i64) == 0 {
            print("window: " + _cstrToString(SDL_GetError()))
            return 2
        }
        if (SDL_GL_CreateContext(win) as i64) == 0 {
            print("context: " + _cstrToString(SDL_GetError()))
            return 3
        }
    }

    var c = canvasNew(W, H)
    var s = sceneNew(W, H)
    var places: Vec<City> = Vec.new()
    places.push(loadPlace(place))
    var w = worldIn(SEED, places, true)
    // Before the render loop, never inside it: this is several network round
    // trips and the frame path must not be able to block on a public API.
    if envLiveRequested() {
        if envGoLive(&mut w.env, w.city.reach) {
            print("weather: " + envWeatherLabel(w.env))
            settleUnderCeiling(&mut w)
        } else {
            print("weather: fetch failed, keeping synthetic sky")
        }
    }
    let groundTex = groundTexture()
    let skinTex = planeTexture()
    let facadeTex = facadeTexture()

    var gl = GlContext.new()
    var gw = match gpuWorldNew(&mut gl, groundTex, skinTex, facadeTex) {
        Result.Ok(x) => x
        Result.Err(e) => {
            print("gpu: " + e)
            return 4
        }
    }
    if w.city.orthoLoaded {
        setOrtho(&mut gl, &mut gw, w.city.ortho)
    }
    var p = match postNew(&mut gl, W, H, W, H) {
        Result.Ok(x) => x
        Result.Err(e) => {
            print("post: " + e)
            return 4
        }
    }
    let dem = demHeights(w.city)
    let grid = CoverGrid {
        n: w.city.demN, x0: w.city.demX0, z0: w.city.demZ0, step: w.city.demStep, reach: w.city.reach
    }
    print($"place {place} demN {w.city.demN} hasSea {cityHasSea(w.city)}")

    // Fly for a while so the camera is somewhere worth photographing, then shoot
    // the last frame. The autopilot steers on its own with no input at all.
    var first = true
    let WARMUP = 30
    var loopStart = epochMillis()
    for i in 0..frames {
        // Off the frame path in the sense that matters: this yields to the
        // fetching task and returns, it never waits on the network itself.
        envWeatherTick(&mut w.env, w.city.reach)
        // Timing starts after a warm-up so shader compiles, the first upload and
        // the driver's lazy setup are not charged to the steady-state frame cost.
        if i == WARMUP {
            loopStart = epochMillis()
        }
        worldUpdate(&mut w, 1.0 / 60.0, 0.0, 0.0, false)
        if mark >= 0 {
            aimAtMark(&mut w, place, mark, dist)
        }
        // Put the camera where the picture needs it.
        //
        // The autopilot decides the altitude, and the altitude is exactly what a
        // cloud layer has to be photographed against: the same sky is a ceiling
        // from below, a wall from inside it and a floor from above, and there is
        // no other way to see which one the renderer is producing.
        let shotAlt = envF64("FLYBY_SHOT_ALT", 0.0 - 1.0)
        if shotAlt > 0.0 {
            w.cam.y = shotAlt
            w.cam.pitch = envF64("FLYBY_SHOT_PITCH", 0.0 - 8.0) * 3.14159265358979 / 180.0
        }
        let view = viewOf(w.cam, c.w, c.h)
        postBeginWorld(p)
        drawWorld(&mut c, &mut s, w, groundTex, skinTex, facadeTex, view)
        // Record, upload once, then rasterise twice: from the sun, then from the
        // camera. The shadow pass binds its own framebuffer, so the scene target
        // has to be bound again before anything else is drawn.
        uploadStreams(&mut gw, &mut s)
        drawShadowPass(&mut gw, &mut s, view)
        postBindWorld(p)
        drawSkyPass(gw, s, view, W as f64, H as f64, w.time)
        drawStreams(&mut gw, &mut s, view, W as f64, H as f64, w.time)
        drawSpeedLines(&mut c, w)
        drawGuide(&mut c, w, view)
        drawFence(&mut c, w, view)
        drawMarkBeam(&mut c, w, view)
        drawMarkGuide(&mut c, w, view)
        drawChecklist(&mut c, w)
        drawFound(&mut c, w)
        drawHud(&mut c, w, s, 60)
        if w.env.cloudsDirty {
            postSetClouds(p, w.env.clouds)
            gpuWorldSetClouds(gw, w.env.clouds)
            w.env.cloudsDirty = false
        }
        postFinish(p, c, view, s, grid, dem, first, cityHasSea(w.city), w.time, 0.35, 1.0, W, H)
        first = false
        if i == frames - 1 {
            let px = readPixelsRgba8(W, H)
            match encodePng(toRgb(px, W, H), W, H, 3) {
                Result.Ok(bytes) => {
                    match writeFile(out, bytes) {
                        Result.Ok(_) => {
                            print($"wrote {out}  alt {w.cam.y as i64} m  err {Gpu.error()}")
                            if frames > WARMUP {
                                let ms = epochMillis() - loopStart
                                let n = (frames - WARMUP) as i64
                                print("render: " + ((ms / n) as i64).toString() + " ms/frame over " + n.toString() + " frames at " + W.toString() + "x" + H.toString())
                            }
                        }
                        Result.Err(e) => {
                            print($"write: {e}")
                        }
                    }
                }
                Result.Err(e) => {
                    print("png: " + e)
                }
            }
        }
        canvasClear(&mut c)
    }
    gpuWorldFree(&mut gl, gw)
    postFree(&mut gl, p)
    gl.free()
    SDL_Quit()
    return 0
}

// Stand off from a landmark and look at it, at an angle that shows a cliff face
// rather than the top of one.
fn aimAtMark(w: &mut World, _place: &string, i: i64, dist: f64) {
    let marks = marksFor(w.city.name)
    if marks.len == 0 || i >= marks.len {
        return
    }
    let mx = marks[i].x
    let mz = marks[i].z
    let lip = heightAt(w.city, mx, mz)
    let ang = 0.6
    w.cam.x = mx + Math.sin(ang) * dist
    w.cam.z = mz + Math.cos(ang) * dist
    // Above the ground UNDER THE CAMERA, not under the landmark: standing off a
    // cliff means standing over the valley floor, which is several hundred metres
    // lower, and offsetting from the lip put the camera inside the rock.
    // Partway DOWN the drop, not relative to whatever is under the camera: at any
    // useful standoff from a cliff the ground under the camera is another ridge,
    // and sitting above that puts the lens over the rim looking at the back of the
    // mountain. A fixed offset below the lip is in open air by construction.
    w.cam.y = lip - 260.0
    let target = lip - 240.0
    w.cam.yaw = Math.atan2(mx - w.cam.x, mz - w.cam.z)
    let dy = target - w.cam.y
    let flat = Math.sqrt((mx - w.cam.x) * (mx - w.cam.x) + (mz - w.cam.z) * (mz - w.cam.z))
    w.cam.pitch = Math.atan2(dy, flat)
    w.cam.roll = 0.0
}

fn strToI64(s: &string): i64 {
    var n = 0
    for i in 0..s.len {
        let d = (s[i] as i64) - 48
        if d >= 0 && d <= 9 {
            n = n * 10 + d
        }
    }
    return n
}
