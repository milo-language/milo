// Everything that happens to a frame after the geometry: the sea, the 2D overlay,
// bloom, and the tone map that turns unbounded linear light into a picture.
//
// The order matters and is worth stating once:
//
//   1. sky + geometry, into `world` — colour in rgb, camera depth in alpha
//   2. sea, reading `world`, writing `scene`
//   3. overlay, blended into `scene`
//   4. bright pass and four blurs, at quarter resolution
//   5. composite to the window, tone-mapped
//
// The sea is at 2 rather than after the bloom because it has to be a thing in the
// photograph, not a decal on top of one: the bloom has to see the sun glitter and
// the tone map has to see the water, or the brightest thing in the frame is the
// only thing that does not glow.
//
// The sea is still a screen-space raymarch rather than a mesh, and that is the
// right shape for it — a heightfield traced per pixel has no tessellation to run
// out of at the horizon, and the alpha channel of `world` gives it exact depth to
// occlude against. What changed is what it reflects: `sky.skyColor`, the same
// function the sky pass and the terrain haze call, instead of a flat fog colour.

from "std/math" import {
    Math
}
from "gl" import {
    GlContext, Gpu, Mesh, Shader, Target, Texture2D, bindScreen
}
from "./gfx" import {
    Canvas
}
from "./gfx3d" import {
    Scene, View
}
from "./sky" import {
    SKY_GLSL
}
from "./cloud" import {
    CLOUD_GLSL, CloudField, cloudEmpty, cloudUpload, cloudUpdate
}
from "./gpuworld" import {
    QUAD_VERT_LOCAL, projScale, skyUniforms
}

// Quarter resolution for the bloom chain.
pub let SHRINK: i64 = 4

// Reinhard saturates well before this.
pub let TONE_MAX: f64 = 8.0

// Only things brighter than white bloom. Mid-grey in linear light is about 0.21,
// so a lower threshold puts an entire aerial photograph above the line and the
// whole picture hazes over.
pub let BRIGHT_THRESHOLD: f64 = 0.90

// Side of the cover-mask texture. The largest shipped map is 19 km at a ~10 m
// cover step, so 2048 covers every place with room to spare.
pub let COVER_TEX: i64 = 2048

// Where the cover grid sits in the world. Separated from City so this file does
// not have to import the asset format.
pub struct CoverGrid {
    n: i64,
    x0: f64,
    z0: f64,
    step: f64,
    reach: f64,
}

pub fn coverGridNone(): CoverGrid {
    return CoverGrid {
        n: 0, x0: 0.0, z0: 0.0, step: 1.0, reach: 1.0
    }
}

pub struct Post {
    // Sky and geometry land here. Depth is a renderbuffer for the hardware test;
    // the alpha channel carries the same depth as a linear number the sea pass
    // can read, which is cheaper than attaching a depth texture and un-projecting.
    world: Target,
    scene: Target, // world with the sea and the overlay composited in
    a: Target, // quarter-res ping
    b: Target, // quarter-res pong
    overlay: Texture2D, // the 2D layer's linear light
    overlayCov: Texture2D, // and how much of the scene it hides
    cover: Texture2D, // the land-cover water mask, uploaded on a place change
    // Cloud coverage and cloud-top height over the map square, uploaded when the
    // weather changes rather than per frame — a forecast is minutes old at best.
    cloudTex: Texture2D,
    sea: Shader,
    over: Shader,
    bright: Shader,
    blur: Shader,
    comp: Shader,
    quad: Mesh,
    w: i64, // render resolution — the drawable, times the supersample factor
    h: i64,
    ow: i64, // the 2D overlay's own fixed resolution
    oh: i64,
    bw: i64,
    bh: i64,
}

pub fn postNew(gl: &mut GlContext, w: i64, h: i64, ow: i64, oh: i64): Result<Post, string> {
    let sea = Shader.compile(&mut gl, QUAD_VERT_LOCAL, seaFrag())?
    let over = Shader.compile(&mut gl, QUAD_VERT_LOCAL, OVERLAY_FRAG)?
    let bright = Shader.compile(&mut gl, QUAD_VERT_LOCAL, BRIGHT_FRAG)?
    let blur = Shader.compile(&mut gl, QUAD_VERT_LOCAL, BLUR_FRAG)?
    let comp = Shader.compile(&mut gl, QUAD_VERT_LOCAL, COMPOSITE_FRAG)?
    var p = Post {
        world: Target.new(&mut gl, 4, 4, true, false)?,
        scene: Target.new(&mut gl, 4, 4, false, false)?,
        a: Target.new(&mut gl, 4, 4, false, true)?,
        b: Target.new(&mut gl, 4, 4, false, true)?,
        // LINEAR, because the overlay is at a fixed resolution and the scene is
        // not: at anything but 1:1 a nearest-sampled HUD is a staircase.
        overlay: Texture2D.rgb32f(&mut gl, ow, oh, Vec.filled(ow * oh * 3, 0.0), true),
        overlayCov: Texture2D.r32f(&mut gl, ow, oh, Vec.filled(ow * oh, 0.0), true),
        // One fixed allocation, big enough for any shipped map's cover grid, so
        // changing place is a sub-image upload rather than a reallocation.
        // LINEAR: the grid is coarse, and a nearest-sampled shoreline is a
        // staircase of 10 m steps. Filtering makes it a soft waterline.
        cover: Texture2D.r32fEmpty(&mut gl, COVER_TEX, COVER_TEX, true),
        cloudTex: cloudUpload(&mut gl, cloudEmpty()),
        sea: sea,
        over: over,
        bright: bright,
        blur: blur,
        comp: comp,
        quad: Mesh.fullscreenQuad(&mut gl),
        w: 0,
        h: 0,
        ow: ow,
        oh: oh,
        bw: 1,
        bh: 1,
    }
    postResize(&mut gl, &mut p, w, h)?
    return Ok(p)
}

// Rebuild every full-resolution target for a new render size.
//
// This is what makes resolution a window property rather than a compile-time one:
// the frame is rendered at the drawable size (times the supersample factor), so
// dragging the window bigger genuinely draws more pixels instead of scaling up a
// fixed-size picture. Freeing first is not optional — a `Target` is @noCopy and
// `free` consumes it, so the old one has to come out of the field before the new
// one goes in.
pub fn postResize(gl: &mut GlContext, p: &mut Post, w: i64, h: i64): Result<i64, string> {
    if w == p.w && h == p.h {
        return Ok(0)
    }
    let bw = Math.maxI64(1, w / SHRINK)
    let bh = Math.maxI64(1, h / SHRINK)
    replace(p.world, Target.new(&mut gl, w, h, true, false)?).free(&mut gl)
    replace(p.scene, Target.new(&mut gl, w, h, false, false)?).free(&mut gl)
    replace(p.a, Target.new(&mut gl, bw, bh, false, true)?).free(&mut gl)
    replace(p.b, Target.new(&mut gl, bw, bh, false, true)?).free(&mut gl)
    p.w = w
    p.h = h
    p.bw = bw
    p.bh = bh
    return Ok(0)
}

// Point the driver at the world target and clear it. Everything the sky pass and
// the geometry passes draw goes here.
pub fn postBeginWorld(p: &Post) {
    p.world.bind()
    Gpu.clear(0.0, 0.0, 0.0, 0.0, true)
}

// Bind the scene target WITHOUT clearing it, for a caller returning from a pass
// that bound a framebuffer of its own.
pub fn postBindWorld(p: &Post) {
    p.world.bind()
}

// Push a new weather field to the GPU. Called when the field changes, which is
// on a place change or when a fetch lands — never per frame.
pub fn postSetClouds(p: &Post, f: &CloudField) {
    cloudUpdate(p.cloudTex, f)
}

// The sea, then the overlay, then bloom, then the window.
pub fn postFinish(p: &Post, c: &Canvas, v: &View, s: &Scene, cov: &CoverGrid, cover: &Vec<f32>, coverDirty: bool, hasSea: bool, time: f64, bloomGain: f64, exposure: f64, dw: i64, dh: i64) {
    // Only when the place changes: a 19 km grid is 14 MB and there is no reason
    // to push it down the bus sixty times a second for a map that never moves.
    if coverDirty && cov.n > 0 {
        p.cover.updateR32fRegion(cov.n, cov.n, cover)
    }

    Gpu.depthTest(false)
    Gpu.blendOff()

    p.scene.bind()
    p.sea.bind()
    p.world.bindTexture(0)
    p.cover.bind(1)
    p.sea.uniformI("uWorld", 0)
    p.sea.uniformI("uCover", 1)
    p.sea.uniform4F("uCover0", cov.x0, cov.z0, cov.step, cov.n as f64)
    p.sea.uniform2F("uCoverTex", COVER_TEX as f64, cov.reach)
    p.sea.uniform2F("uRes", p.w as f64, p.h as f64)
    p.sea.uniform3F("uEye", v.eye.x, v.eye.y, v.eye.z)
    p.sea.uniform3F("uRight", v.right.x, v.right.y, v.right.z)
    p.sea.uniform3F("uUp", v.up.x, v.up.y, v.up.z)
    p.sea.uniform3F("uFwd", v.fwd.x, v.fwd.y, v.fwd.z)
    let ps = projScale(v, p.w as f64, p.h as f64)
    p.sea.uniform2F("uProj", ps.x, ps.y)
    p.sea.uniform2F("uFogRange", s.fogStart, s.fogEnd)
    skyUniforms(p.sea, s, time)
    var on = 0.0
    if hasSea {
        on = 1.0
    }
    p.sea.uniformF("uSeaOn", on)
    // The cloud volume rides along in the sea pass because that pass already
    // owns the two things a march needs and nothing else in the chain has both:
    // the view ray, reconstructed from the same projection the geometry used, and
    // the scene depth the geometry wrote into alpha. Giving clouds a pass of
    // their own would mean a second full-resolution target and rebuilding both.
    p.cloudTex.bind(2)
    p.sea.uniformI("uCloudTex", 2)
    p.sea.uniformF("uCloudBase", s.cloudBase)
    p.sea.uniformF("uCloudTopMax", s.cloudTopMax)
    p.sea.uniformF("uCloudReach", s.cloudReach)
    p.sea.uniformF("uCloudOn", s.cloudOn)
    p.sea.uniformF("uCloudDensity", s.cloudDens)
    p.sea.uniform2F("uCloudWind", s.cloudWindX, s.cloudWindZ)
    p.sea.uniformF("uRainPeak", s.rainPeak)
    p.quad.draw()

    // The 2D layer, blended in. Premultiplied alpha: the shader emits the
    // overlay's own light in rgb and how much of the scene it hides in alpha, and
    // GL_ONE / GL_ONE_MINUS_SRC_ALPHA gives `overlay + scene * (1 - cov)`.
    p.overlay.updateRgb32f(c.hdr)
    p.overlayCov.updateR32f(c.cov)
    Gpu.blendPremultiplied()
    p.over.bind()
    p.overlay.bind(0)
    p.overlayCov.bind(1)
    p.over.uniformI("uOverlay", 0)
    p.over.uniformI("uCov", 1)
    p.quad.draw()
    Gpu.blendOff()

    p.a.bind()
    p.bright.bind()
    p.scene.bindTexture(0)
    p.bright.uniformI("uSrc", 0)
    p.bright.uniform2F("uTexel", 1.0 / (p.w as f64), 1.0 / (p.h as f64))
    p.bright.uniformF("uThreshold", BRIGHT_THRESHOLD)
    p.quad.draw()

    // Widening strides, [1,4,6,4,1]/16 each: a wide halo for twenty taps. Without
    // the widest pass the halo has a visible square edge.
    gpuBlurPass(p, 1)
    gpuBlurPass(p, 2)
    gpuBlurPass(p, 4)
    gpuBlurPass(p, 8)

    // Straight to the window with no letterbox: the scene was rendered at this
    // aspect, because it was rendered at this drawable's size. The old fixed
    // 1280x720 frame needed bars to avoid stretching circles on the HUD into
    // ellipses; a frame that is already the right shape does not.
    bindScreen(dw, dh)
    Gpu.clear(0.0, 0.0, 0.0, 1.0, false)

    p.comp.bind()
    p.scene.bindTexture(0)
    p.a.bindTexture(1)
    p.comp.uniformI("uHdr", 0)
    p.comp.uniformI("uBloom", 1)
    p.comp.uniformF("uGain", bloomGain * exposure)
    p.comp.uniformF("uExposure", exposure)
    p.comp.uniformF("uToneMax", TONE_MAX)
    p.quad.draw()
}

// Horizontal a -> b, then vertical b -> a, so the chain always leaves its result
// in `a` and the next stride can start from it.
fn gpuBlurPass(p: &Post, stride: i64) {
    let sx = (stride as f64) / (p.bw as f64)
    let sy = (stride as f64) / (p.bh as f64)

    p.b.bind()
    p.blur.bind()
    p.a.bindTexture(0)
    p.blur.uniformI("uSrc", 0)
    p.blur.uniform2F("uStep", sx, 0.0)
    p.quad.draw()

    p.a.bind()
    p.blur.bind()
    p.b.bindTexture(0)
    p.blur.uniformI("uSrc", 0)
    p.blur.uniform2F("uStep", 0.0, sy)
    p.quad.draw()
}

pub fn postFree(gl: &mut GlContext, p: Post) {
    p.world.free(&mut gl)
    p.scene.free(&mut gl)
    p.a.free(&mut gl)
    p.b.free(&mut gl)
    p.overlay.free(&mut gl)
    p.overlayCov.free(&mut gl)
    p.cover.free(&mut gl)
    p.sea.free(&mut gl)
    p.over.free(&mut gl)
    p.bright.free(&mut gl)
    p.blur.free(&mut gl)
    p.comp.free(&mut gl)
    p.quad.free(&mut gl)
}

// ── the sea ───────────────────────────────────────────────────────────────────

// A heightfield traced per pixel, occluded by the depth the geometry pass left in
// the alpha channel, reflecting the same sky everything else in the frame does.
//
// A function rather than a global, because the source pastes in `SKY_GLSL`.
pub fn seaFrag(): string {
    return "#version 330 core
in vec2 vUv;
out vec4 fragColor;

uniform sampler2D uWorld;   // rgb = the frame so far, a = camera depth (0 = sky)
uniform sampler2D uCover;
uniform vec4 uCover0;       // x0, z0, step, n
uniform vec2 uCoverTex;     // texture side, map reach
uniform vec2 uRes;
uniform vec3 uEye;
uniform vec3 uRight;
uniform vec3 uUp;
uniform vec3 uFwd;
uniform vec2 uProj;
uniform vec2 uFogRange;
uniform float uSeaOn;
"

    + SKY_GLSL + CLOUD_GLSL + "
const float SEA_LIFT = 0.80;
// Terrain at or under this is the DEM\'s water sheet, not land. Generous enough
// to swallow the noise flyby adds to terrain, tight enough that a real shore
// keeps its edge — SRTM posts are 30 m apart, so this is a sliver of a pixel.
// Something standing ON the water — a bridge deck, a tower, a ship — is this far
// above it or more, and keeps its pixel.
const float WATERLINE = 3.0;
const float WATERLINE_FADE = 12.0;

// Metres of sea covered by one pixel at this distance.
float footprint(float dist) {
    return dist * 2.0 / (uProj.y * uRes.y);
}

// Metres. A ~130 m primary swell with shorter waves across it, plus wind chop.
//
// The chop is not decoration. A sum of straight sines — however many octaves,
// however rotated — is a periodic field, and at a grazing angle it reads as
// corduroy: identical parallel ridges marching to the horizon. The noise term is
// what makes it a sea. Learned the hard way, on screen.
float seaHeight(vec2 p, float span) {
    vec2 p0 = p;
    float h = 0.0;
    float amp = 1.00;
    float freq = 0.135;
    vec2 dir = normalize(vec2(0.87, 0.49));
    for (int i = 0; i < 6; i++) {
        // Level of detail. `px` is how much sea one pixel covers here, and an
        // octave whose wavelength is under about two pixels cannot be resolved —
        // sampling it anyway is what produced the diagonal moiré hatching across
        // the middle distance. Fade it out instead of drawing it wrong.
        float wl = 6.2831853 / freq;
        float vis = smoothstep(1.0, 3.0, wl / max(span, 0.001));
        if (vis <= 0.001) { break; }
        // Deep-water phase speed, c = sqrt(g / k): the short waves travel
        // visibly slower than the swell instead of the field sliding as one.
        float speed = sqrt(9.81 / freq);
        float d = dot(p, dir) * freq + uTime * speed * freq;
        float s = sin(d);
        // Half sharpened crest, half plain sine. Pure exp(sin-1) on every octave
        // makes the primary swell so dominant that nothing else is visible.
        h += amp * vis * mix(s * 0.5 + 0.5, exp(s - 1.0), 0.55);
        p += dir * h * 0.9;
        amp *= 0.58;
        freq *= 1.87;
        // ~51 degrees per octave, so no two share a grain.
        dir = mat2(0.62, -0.78, 0.78, 0.62) * dir;
    }
    // Chop, in the ORIGINAL frame — the loop above has warped `p` a long way by
    // now and noise on that is smeared along the swell instead of across it.
    h += (skyFbm(p0 * 0.085 + vec2(uTime * 0.10, uTime * 0.07)) - 0.5) * 1.55 * smoothstep(24.0, 8.0, span);
    h += (skyFbm(p0 * 0.021 + vec2(uTime * 0.03, uTime * 0.05)) - 0.5) * 1.15;
    return h + SEA_LIFT;
}

// world3d.foldIn, in GLSL. The map is finite and the flight is not, so the
// world is MIRRORED at the edges rather than wrapped — and the sea has to fold
// exactly the way the terrain does or the coastline and the water disagree one
// map-width out.
float foldIn(float v, float reach) {
    float period = reach * 2.0;
    float k = floor((v + reach) / period);
    float r = v + reach - k * period;
    // Odd copies are the mirrored ones.
    return mod(k, 2.0) < 0.5 ? r - reach : reach - r;
}

// Terrain elevation at a world point, folded onto the map the way the renderer
// folds it. The grid sits in the bottom-left n x n of a fixed-size texture.
float demAt(vec2 xz) {
    float reach = uCoverTex.y;
    vec2 f = vec2(foldIn(xz.x, reach), foldIn(xz.y, reach));
    vec2 cell = (f - uCover0.xy) / uCover0.z;
    cell = clamp(cell, vec2(0.5), vec2(uCover0.w - 1.5));
    return texture(uCover, cell / uCoverTex.x).r;
}

// Is this open water? Judged on a NEIGHBOURHOOD average, not on the cell.
//
// SRTM is unreliable over water: San Francisco's DEM has 22370 cells sitting at
// 1.5-6 m scattered through a bay that is otherwise 148873 cells below -0.5 m.
// Read one cell at a time those spikes are land, and the renderer paints them as
// land — a rash of green islands across open water. Averaged against their
// neighbours they are what they actually are: noise on a seabed ten metres down.
float wetness(vec2 xz) {
    if (uCover0.w < 1.0) { return 0.0; }
    float r = 70.0;
    float h = demAt(xz) * 0.2
            + (demAt(xz + vec2(r, 0.0)) + demAt(xz - vec2(r, 0.0))
             + demAt(xz + vec2(0.0, r)) + demAt(xz - vec2(0.0, r))) * 0.2;
    // Water below zero, land above a couple of metres, a soft shore between.
    return 1.0 - smoothstep(-0.5, 2.5, h);
}


// The sea alone, returning rather than writing.
//
// It used to be `main` and it used to write `fragColor` from five places. Clouds
// have to composite over EVERY pixel — including the ones where there is no sea
// and the ones that are pure sky, which is most of them — so every one of those
// early exits had to become a value the caller can carry on working with.
vec4 seaShade(vec3 rd, vec3 base, float sceneZ) {
    if (uSeaOn < 0.5) {
        return vec4(base, sceneZ);
    }

    if (rd.y > -0.0008 || uEye.y <= 0.2) {
        return vec4(base, sceneZ);
    }
    float t = -uEye.y / rd.y;
    if (t <= 0.0 || t > uFogRange.y) {
        return vec4(base, sceneZ);
    }

    // Newton against the wave field. The flat plane is already within a couple of
    // metres of the answer, so three steps converge — a full march would cost
    // dozens of height evaluations to land in the same place.
    for (int i = 0; i < 3; i++) {
        vec3 q = uEye + rd * t;
        float f = q.y - seaHeight(q.xz, footprint(t));
        t += f / (-rd.y);
        if (t < 0.0) { t = 0.0; }
    }
    vec3 p = uEye + rd * t;
    float seaZ = dot(p - uEye, uFwd);

    // Where is the sea? Ask the map, not the geometry.
    //
    // Two earlier answers were wrong and both failed the same way. Racing the sea
    // against the depth buffer fails because SRTM writes 0 over water, so the
    // terrain across a bay is coplanar with the sea and float noise decides per
    // pixel. Thresholding the reconstructed world height fails because the DEM has
    // real noise over water — scattered cells lifted a few metres that the
    // renderer then paints as land, in the middle of a bay.
    float wet = wetness(p.xz);
    if (seaZ <= 0.0 || wet < 0.002) {
        return vec4(base, sceneZ);
    }
    // Anything standing on the water still occludes it — a bridge deck, a tower,
    // a ship. Judged by HEIGHT, not by depth: the DEM writes 0 over water, so the
    // terrain across a bay is coplanar with the sea and a depth comparison is
    // decided by float noise per pixel. Reconstructing what height the drawn
    // pixel is at and asking whether it is above the waterline has no such tie.
    bool isSky = sceneZ <= 0.0;
    if (!isSky) {
        float cosF = max(dot(rd, uFwd), 0.0001);
        float sceneY = uEye.y + rd.y * (sceneZ / cosF);
        wet *= 1.0 - smoothstep(WATERLINE, WATERLINE + WATERLINE_FADE, sceneY);
    }
    if (wet < 0.002) {
        return vec4(base, sceneZ);
    }

    // Normal, with the sample spacing set by how much world a pixel covers here.
    // A fixed epsilon makes the far water boil, because out there one pixel spans
    // several wavelengths and picks a different crest every frame.
    float span = footprint(seaZ);
    float e = max(0.30, span);
    float h0 = seaHeight(p.xz, span);
    float hx = seaHeight(p.xz + vec2(e, 0.0), span);
    float hz = seaHeight(p.xz + vec2(0.0, e), span);
    vec3 n = normalize(vec3(h0 - hx, e, h0 - hz));

    // The sky this water is under — the real one, with the sun in it.
    //
    // This single line is the difference between water and paint. It used to mix
    // two tints out of the flat fog colour, so the sea reflected a grey sheet and
    // looked like one. `skyColor` is the same function the sky pass draws with, so
    // what the water shows is what is actually above it: the horizon band, the
    // clouds, the sun, and all of it moving as the aircraft turns.
    vec3 refl = reflect(rd, n);
    refl.y = max(refl.y, 0.015);
    vec3 sky = skyColor(refl, true);

    // Capped, not physical. Schlick goes to 1.0 at a grazing angle, and a chase
    // camera looking flat across a bay is ALL grazing angle: taken literally every
    // pixel becomes sky colour and the sea disappears into the haze.
    float fres = 0.02 + 0.74 * pow(1.0 - max(dot(n, -rd), 0.0), 5.0);
    float day = clamp(uSun.y * 2.4 + 0.20, 0.0, 1.0);
    vec3 deep = mix(vec3(0.004, 0.012, 0.026), vec3(0.012, 0.055, 0.090), day);
    // Crests are thinner water and glow with what comes through from behind.
    float crest = clamp((h0 - SEA_LIFT) * 0.40, 0.0, 1.0);
    vec3 col = mix(deep + vec3(0.012, 0.070, 0.062) * crest * crest, sky, fres);

    // Two lobes: a tight specular for the glint itself and a broad one for the
    // sheen that spreads down-sun across a choppy surface. The tight one alone is
    // a dot nobody notices from a thousand feet up.
    float gl = max(dot(refl, uSun), 0.0);
    float sun = clamp(uSun.y + 0.25, 0.0, 1.0);
    col += vec3(2.2, 2.0, 1.7) * pow(gl, 900.0) * 5.0 * sun;
    col += vec3(1.6, 1.5, 1.25) * pow(gl, 14.0) * 0.55 * sun;

    // Foam: the tallest crests AND only where a slow noise field says the wind is
    // tearing them. Height alone put a white line on every crest of the primary
    // swell, which is what turned the sea into corduroy.
    float foamMask = skyFbm(p.xz * 0.028 + vec2(uTime * 0.03, 0.0));
    float foam = smoothstep(2.9, 3.8, h0) * smoothstep(0.52, 0.78, foamMask) * smoothstep(9.0, 2.5, span);
    col = mix(col, vec3(0.72, 0.80, 0.88), foam * 0.35);

    // The same aerial perspective the terrain got, toward the same sky.
    float fog = clamp((seaZ - uFogRange.x) / (uFogRange.y - uFogRange.x), 0.0, 1.0);
    col = mix(col, skyColor(rd, false), fog);

    // Fade the sea out over the last stretch rather than ending it on a line. By
    // then it is almost pure haze and so is what is behind it, so nothing shows.
    float edge = 1.0 - smoothstep(uFogRange.y * 0.75, uFogRange.y, t);
    float k = edge * wet;
    return vec4(mix(base, col, k), mix(sceneZ, seaZ, k));
}

void main() {
    vec4 world = texture(uWorld, vUv);
    vec3 base = world.rgb;
    float sceneZ = world.a;

    // Exactly the inverse of gpuworld.viewProj, which is why they share uProj:
    // a field of view reconstructed a fraction off is a sea that does not line up
    // with the coast it is lapping against.
    float a = (vUv.x * 2.0 - 1.0) / uProj.x;
    float b = (vUv.y * 2.0 - 1.0) / uProj.y;
    vec3 rd = normalize(uRight * a + uUp * b + uFwd);

    vec4 sea = seaShade(rd, base, sceneZ);
    vec3 col = sea.rgb;
    float depth = sea.a;

    // How far this ray may travel before something opaque stops it.
    //
    // `depth` is measured along the VIEW AXIS, which is what the geometry pass
    // wrote and what the sea pass wants; the march needs distance along THIS ray.
    // Dividing by the cosine between them is the whole conversion, and skipping
    // it clips cloud short toward the edges of the frame by up to the tangent of
    // half the field of view — a curved bite out of the sky that moves with the
    // camera.
    float cosF = max(dot(rd, uFwd), 0.0001);
    float maxT = 60000.0;
    if (depth > 0.0) { maxT = depth / cosF; }

    // Offset each ray a fraction of a step, so the layer boundaries do not all
    // land on the same planes across the frame. See `cloudDither` for why this is
    // interleaved gradient noise and not a hash.
    float jitter = cloudDither(gl_FragCoord.xy);
    vec4 cl = cloudMarch(uEye, rd, maxT, jitter);
    col = col * cl.a + cl.rgb;

    fragColor = vec4(col, depth);
}
"

}

// The 2D layer, in premultiplied-alpha form.
//
// rgb is the overlay\'s own light and alpha is how much of the scene it hides, so
// GL_ONE / GL_ONE_MINUS_SRC_ALPHA composites it as `overlay + scene * (1 - cov)`.
// The v flip is here: the canvas\'s row 0 is its top and GL\'s row 0 is the bottom.
pub let OVERLAY_FRAG: string = "#version 330 core
in vec2 vUv;
out vec4 fragColor;
uniform sampler2D uOverlay;
uniform sampler2D uCov;
void main() {
    vec2 uv = vec2(vUv.x, 1.0 - vUv.y);
    fragColor = vec4(texture(uOverlay, uv).rgb, texture(uCov, uv).r);
}
"

// The 4x4 box downsample and the bright pass in one, exactly as gfx.brightPass
// does them: average the block, take its luminance, and keep the fraction of the
// colour that sits above the threshold.
pub let BRIGHT_FRAG: string = "#version 330 core
in vec2 vUv;
out vec4 fragColor;
uniform sampler2D uSrc;
uniform vec2 uTexel;
uniform float uThreshold;
void main() {
    vec3 s = vec3(0.0);
    for (int dy = 0; dy < 4; dy++) {
        for (int dx = 0; dx < 4; dx++) {
            vec2 o = vec2(float(dx) - 1.5, float(dy) - 1.5) * uTexel;
            s += texture(uSrc, vUv + o).rgb;
        }
    }
    s *= 0.0625;
    float lum = dot(s, vec3(0.299, 0.587, 0.114));
    float keep = lum > uThreshold ? (lum - uThreshold) / lum : 0.0;
    fragColor = vec4(s * keep, 1.0);
}
"

pub let BLUR_FRAG: string = "#version 330 core
in vec2 vUv;
out vec4 fragColor;
uniform sampler2D uSrc;
uniform vec2 uStep;
void main() {
    vec3 s = texture(uSrc, vUv - 2.0 * uStep).rgb * 0.0625
           + texture(uSrc, vUv - uStep).rgb * 0.25
           + texture(uSrc, vUv).rgb * 0.375
           + texture(uSrc, vUv + uStep).rgb * 0.25
           + texture(uSrc, vUv + 2.0 * uStep).rgb * 0.0625;
    fragColor = vec4(s, 1.0);
}
"

// No v flip: the scene is rendered by the driver, so it is already in GL's
// orientation all the way through. The one thing that is not — the CPU's 2D
// overlay — is flipped where it is sampled, in OVERLAY_FRAG.
pub let COMPOSITE_FRAG: string = "#version 330 core
in vec2 vUv;
out vec4 fragColor;
uniform sampler2D uHdr;
uniform sampler2D uBloom;
uniform float uGain;
uniform float uExposure;
uniform float uToneMax;
void main() {
    vec3 lin = (texture(uHdr, vUv).rgb + texture(uBloom, vUv).rgb * uGain) * uExposure;
    lin = clamp(lin, 0.0, uToneMax);
    vec3 mapped = lin / (1.0 + lin);
    fragColor = vec4(pow(mapped, vec3(0.4545454545)), 1.0);
}
"
