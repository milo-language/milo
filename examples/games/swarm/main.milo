// SWARM: a twin-stick neon arena shooter.
//
//   milo run examples/games/swarm/main.milo --release                       # play
//   milo run examples/games/swarm/main.milo --release -- --bot              # watch the autopilot
//   milo run examples/games/swarm/main.milo --release -- --shot a.png --ticks 7200
//   milo run examples/games/swarm/main.milo --release -- --clip f --from 7200 --to 8200
//   milo run examples/games/swarm/main.milo --release -- --bench --enemies 10000
//   milo run examples/games/swarm/main.milo --release -- --bench --enemies 100 --particles 500000
//
// WASD or arrows move, the mouse aims and the gun fires itself, Space bombs, Esc
// pauses, Q quits. A gamepad works too: left stick moves, right stick aims, a
// shoulder button or B bombs.
//
// The simulation (world.milo) runs at a fixed 120 Hz, decoupled from the display, and
// the renderer (render.milo) draws the latest state: the warp grid, one instanced draw
// of the shape pipeline over an instance list built by draw.milo, and GPU particles,
// into an HDR target that is bloomed and tonemapped. The headless modes run the same
// World with the autopilot (bot.milo) at the controls into an offscreen texture:
// --shot writes the frame after N ticks, --clip writes every other tick between A and
// B (60 fps) for video, --bench times the simulation and the renderer with N enemies
// (and optionally N particles) alive.

from "./bot" import {
    newBot
}
from "./draw" import {
    Hud, Inst, MAX_INST, MAX_TOP, buildFrame, camera
}
from "./font" import {
    fontTable
}
from "./gpu" import {
    Fence, PRESENTMODE_MAILBOX, PRESENTMODE_VSYNC, TEXTUREFORMAT_R8G8B8A8_UNORM, TransferBuffer, createDevice
}
from "./input" import {
    newControls
}
from "./render" import {
    FrameIn, PARTICLE_CAP, newRenderer
}
from "./sdl3" import {
    Event, SCANCODE_ESCAPE, SCANCODE_P, SCANCODE_Q, SCANCODE_RETURN, SCANCODE_SPACE, initVideo, initVideoAndGamepad,
    openWindow, pollEvent, quit, ticksNs
}
from "./world" import {
    DT, Input, World, newWorld, rgb
}
from "std/math" import {
    Math
}
from "std/args" import {
    args
}
from "std/fmt" import {
    padLeft
}
from "std/fs" import {
    writeFile
}
from "std/png" import {
    encodePng
}
from "std/sort" import {
    sortI64
}
from "std/strconv" import {
    formatFloat, parseFloat, parseInt
}

let VIEW_W: i64 = 1600
let VIEW_H: i64 = 900
// Seconds of game over before the autopilot starts a new game.
let BOT_RESTART: f64 = 3.0
// Ticks rendered, unsaved, before a headless capture (see runHeadless).
let WARMUP: i64 = 240

struct Opts {
    seed: i64,
    bot: bool,
    vsync: bool,
    shot: string,
    ticks: i64,
    clip: string,
    from: i64,
    to: i64,
    bench: bool,
    enemies: i64,
    // Benchmark only: keep this many immortal particles in flight as well.
    particles: i64,
    scale: f64,
    seconds: f64,
}

fn parseOpts(): Result<Opts, string> {
    let argv = args()
    var o = Opts {
        seed: 1,
        bot: false,
        vsync: true,
        shot: "",
        ticks: 3600,
        clip: "",
        from: 0,
        to: 0,
        bench: false,
        enemies: 10000,
        particles: 0,
        scale: 1.0,
        seconds: 0.0,
    }
    var i: i64 = 1
    while i < argv.len {
        let a = argv[i].clone()
        if a == "--bot" || a == "--bench" || a == "--novsync" {
            if a == "--bot" {
                o.bot = true
            } else if a == "--bench" {
                o.bench = true
            } else {
                o.vsync = false
            }
            i += 1
            continue
        }
        if i + 1 >= argv.len {
            return Result.Err("missing value after " + a)
        }
        let v = argv[i + 1].clone()
        if a == "--seed" {
            o.seed = parseInt(v) ?? 1
        } else if a == "--shot" {
            o.shot = v
        } else if a == "--ticks" {
            o.ticks = parseInt(v) ?? 3600
        } else if a == "--clip" {
            o.clip = v
        } else if a == "--from" {
            o.from = parseInt(v) ?? 0
        } else if a == "--to" {
            o.to = parseInt(v) ?? 0
        } else if a == "--enemies" {
            o.enemies = parseInt(v) ?? 10000
        } else if a == "--particles" {
            o.particles = parseInt(v) ?? 0
        } else if a == "--scale" {
            o.scale = parseFloat(v) ?? 1.0
        } else if a == "--seconds" {
            o.seconds = parseFloat(v) ?? 0.0
        } else {
            return Result.Err("unknown flag " + a + " (flags: --bot, --seed N, --novsync, --shot out.png --ticks N, --clip prefix --from A --to B, --bench --enemies N --particles N, --scale S, --seconds S)")
        }
        i += 2
    }
    if o.clip.len > 0 && (o.to <= o.from || o.from < 0) {
        return Result.Err("--clip needs --from A --to B with 0 <= A < B")
    }
    if o.ticks <= 0 || o.enemies <= 0 || o.scale <= 0.0 {
        return Result.Err("--ticks, --enemies and --scale must be positive")
    }
    if o.particles < 0 || o.particles > PARTICLE_CAP {
        return Result.Err($"--particles must be in [0, {PARTICLE_CAP}]")
    }
    return Result.Ok(o)
}

fn ms(ns: i64): string {
    return formatFloat((ns as f64) / 1.0e6, 3)
}

fn worldDim(w: &World, paused: bool): f64 {
    if w.gameOver {
        let d = 1.0 - w.overT * 1.5
        return if d < 0.2 { 0.2 } else { d }
    }
    if paused {
        return 0.35
    }
    return 1.0
}

struct Stats {
    avg: i64,
    p99: i64,
    max: i64,
}

// Sorts `ns` in place.
fn stats(ns: &mut Vec<i64>): Stats {
    let n = ns.len
    if n == 0 {
        return Stats {
            avg: 0,
            p99: 0,
            max: 0,
        }
    }
    var total: i64 = 0
    for v in ns {
        total += v
    }
    sortI64(&mut ns)
    var idx = (n * 99) / 100
    if idx >= n {
        idx = n - 1
    }
    return Stats {
        avg: total / n,
        p99: ns[idx],
        max: ns[n - 1],
    }
}

// RGBA8 texels (R in the low byte) to a PNG file, alpha dropped.
fn writePng(path: &string, px: &Vec<u32>, w: i64, h: i64): Result<Unit, string> {
    var raw: string = ""
    for p in px {
        raw.push((p & 255) as u8)
        raw.push(((p >> 8) & 255) as u8)
        raw.push(((p >> 16) & 255) as u8)
    }
    let png = encodePng(raw, w, h, 3)?
    match writeFile(path, png) {
        Result.Ok(_) => {
            return Result.Ok(Unit {})
        }
        Result.Err(_) => {
            return Result.Err("could not write " + path)
        }
    }
}

fn hudFor(o: &Opts, clock: f64, paused: bool): Hud {
    return Hud {
        paused: paused,
        bot: o.bot,
        clock: clock,
    }
}

// The particle benchmark's load: bursts of immortal particles across the view, no drag,
// queued a few hundred thousand a frame until `n` are in flight. Returns how many have
// been queued so far.
fn feedParticles(w: &mut World, n: i64, queued: i64): i64 {
    var q = queued
    var k: i64 = 0
    while q < n && k < 40 {
        let m = Math.minI64(5000, n - q)
        let x = ((k * 7 + q / 5000 * 3) % 13) as f64 * 120.0 - 720.0
        let y = ((k * 5 + q / 5000) % 7) as f64 * 120.0 - 360.0
        w.spray(w.camX + x, w.camY + y, 1.0, 0.0, 3.2, 60.0, 700.0, 0.0, 0.0, rgb(0.6, 0.5, 1.0), m, 100000.0, 2.2)
        q += m
        k += 1
    }
    return q
}

// Headless: the autopilot plays into an offscreen texture. Frames are paced by fences
// two deep, as a swapchain would pace them; see Device.releaseFence for why a fence is
// held for one more submit after its wait.
fn runHeadless(o: &Opts): Result<Unit, string> {
    let w = ((VIEW_W as f64) * o.scale) as i64
    let h = ((VIEW_H as f64) * o.scale) as i64
    var dev = createDevice(false)?
    let tex = dev.createTargetTexture(w, h, TEXTUREFORMAT_R8G8B8A8_UNORM)?
    var ren = newRenderer(&mut dev, w, h, TEXTUREFORMAT_R8G8B8A8_UNORM)?
    let capture = !o.bench
    var down = TransferBuffer {
        id: 0,
        size: 0,
    }
    if capture {
        down = dev.createTransferBuffer(true, w * h * 4)?
    }
    let font = fontTable()
    var world = newWorld(o.seed as u64)
    var bot = newBot()
    var restarts: i64 = 0
    if o.bench {
        world.populate(o.enemies)
        if o.particles > 0 {
            ren.pinned = o.particles
            ren.look.drag = 0.0
        }
    }
    let clip = o.clip.len > 0
    var total = o.ticks
    if clip {
        total = o.to
    } else if o.bench {
        total = 1200
    }
    // Particles live on the GPU and move only when a frame is rendered, so a capture
    // also renders (without saving) the WARMUP ticks before its first saved frame:
    // longer than any particle lives. Bursts from ticks before that are never drawn.
    let first = if clip { o.from } else { total }
    var firstRender: i64 = 2
    if !o.bench {
        firstRender = first - 2 * Math.minI64(WARMUP / 2, (first - 1) / 2)
    }
    var inst: Vec<Inst> = Vec.withCapacity(MAX_INST)
    var top: Vec<Inst> = Vec.withCapacity(MAX_TOP)
    var px: Vec<u32> = Vec.new()
    var simNs: Vec<i64> = Vec.withCapacity(total + 1)
    var renderNs: Vec<i64> = Vec.withCapacity(total + 1)
    var instTotal: i64 = 0
    var saved: i64 = 0
    var rendered: i64 = 0
    var lastRender: i64 = 0
    var fed: i64 = 0
    var waited: Option<Fence> = Option.None
    var older: Option<Fence> = Option.None
    var newer: Option<Fence> = Option.None
    let wall0 = ticksNs()
    for tick in 1..total + 1 {
        let inp = bot.think(world)
        let livesBefore = world.lives
        let bombsBefore = world.bombs
        let t0 = ticksNs()
        world.step(inp)
        simNs.push(ticksNs() - t0)
        if world.lives < livesBefore {
            print($"tick {tick}: life lost at {formatFloat(world.time, 1)} s, {world.enemyCount()} enemies")
        } else if world.bombs < bombsBefore && !o.bench {
            print($"tick {tick}: bomb at {formatFloat(world.time, 1)} s")
        }
        if world.gameOver && world.overT >= BOT_RESTART {
            restarts += 1
            print($"tick {tick}: game over at {formatFloat(world.time, 1)} s, score {world.score}; restarting")
            world = newWorld((o.seed + restarts * 7919) as u64)
            bot = newBot()
        }

        let render = tick >= firstRender && (tick - firstRender) % 2 == 0
        if !render {
            if tick < firstRender - 2 {
                world.bursts.clear()
            }
            continue
        }
        if o.particles > 0 {
            fed = feedParticles(&mut world, o.particles, fed)
        }
        let save = capture && ((clip && tick >= o.from) || (!clip && tick == total))
        let r0 = ticksNs()
        let cam = camera(world)
        buildFrame(&mut inst, &mut top, world, cam, font, hudFor(o, (tick as f64) * DT, false))
        instTotal += inst.len
        let steps = if lastRender == 0 { 2 } else { tick - lastRender }
        lastRender = tick
        let fin = FrameIn {
            cam: cam,
            time: (tick as f64) * DT,
            dt: (steps as f64) * DT,
            worldDim: worldDim(world, false),
        }
        var cmd = dev.begin()?
        ren.frame(&mut cmd, dev, inst, top, world, fin, dev.textureTarget(tex))?
        world.bursts.clear()
        let fence = cmd.submitFenced()?
        match waited {
            Option.Some(x) => dev.releaseFence(x),
            Option.None => {}
        }
        waited = Option.None
        match older {
            Option.Some(x) => {
                dev.waitFor(x)
                waited = Option.Some(x)
            }
            Option.None => {}
        }
        older = newer
        newer = Option.Some(fence)
        renderNs.push(ticksNs() - r0)
        rendered += 1
        if save {
            dev.readTexture(tex, down, &mut px)?
            var path = o.shot.clone()
            if clip {
                path = o.clip + "-" + padLeft($"{saved}", 5, 48) + ".png"
            }
            writePng(path, px, w, h)?
            saved += 1
        }
    }
    dev.waitIdle()
    let wallNs = ticksNs() - wall0
    match waited {
        Option.Some(x) => dev.releaseFence(x),
        Option.None => {}
    }
    match older {
        Option.Some(x) => dev.releaseFence(x),
        Option.None => {}
    }
    match newer {
        Option.Some(x) => dev.releaseFence(x),
        Option.None => {}
    }

    let summary = $"t={formatFloat(world.time, 1)} s  score {world.score}  x{world.multiplier()}  lives {world.lives}  enemies {world.enemyCount()}  particles {ren.window}  kills {world.kills}"
    if o.bench {
        // The grid is stepped inside every sim tick; time it on its own as well.
        let g0 = ticksNs()
        for _k in 0..1000 {
            world.grid.step()
        }
        let gridNs = (ticksNs() - g0) / 1000
        let s = stats(&mut simNs)
        let r = stats(&mut renderNs)
        print($"bench: {o.enemies} enemies, {o.particles} particles, {total} ticks, {rendered} frames at {w}x{h}, avg {instTotal / rendered} instances/frame")
        print($"  sim tick   avg {ms(s.avg)} ms  p99 {ms(s.p99)} ms  max {ms(s.max)} ms  (grid step {ms(gridNs)} ms of it)")
        print($"  render     avg {ms(r.avg)} ms  p99 {ms(r.p99)} ms  (build + upload + submit, paced two frames deep)")
        print($"  wall       {ms(wallNs / rendered)} ms per frame (sim for two ticks included)")
        print("  " + summary)
    } else if clip {
        print($"{saved} frames -> {o.clip}-00000.png ..  {summary}")
    } else {
        print($"{o.shot}: {summary}")
    }
    return Result.Ok(Unit {})
}

fn runWindow(o: &Opts): Result<Unit, string> {
    let win = openWindow("SWARM", VIEW_W, VIEW_H, false)?
    let size = win.pixelSize()
    var dev = createDevice(false)?
    dev.claim(win)?
    if o.vsync || !dev.supportsPresentMode(PRESENTMODE_MAILBOX) {
        dev.setPresentMode(PRESENTMODE_VSYNC)
    } else {
        dev.setPresentMode(PRESENTMODE_MAILBOX)
    }
    var ren = newRenderer(&mut dev, size.w, size.h, dev.swapchainFormat())?
    let font = fontTable()
    var world = newWorld(o.seed as u64)
    var games: i64 = 1
    var bot = newBot()
    var controls = newControls()
    var inst: Vec<Inst> = Vec.withCapacity(MAX_INST)
    var top: Vec<Inst> = Vec.withCapacity(MAX_TOP)
    var paused = false
    var running = true
    var acc: f64 = 0.0
    let start = ticksNs()
    var last = start
    var frames: i64 = 0
    var best: i64 = 0
    while running {
        var restart = false
        while true {
            match pollEvent() {
                Event.Empty => {
                    break
                }
                Event.Quit => {
                    running = false
                }
                Event.KeyDown(sc) => {
                    if sc == SCANCODE_Q {
                        running = false
                    } else if sc == SCANCODE_ESCAPE || sc == SCANCODE_P {
                        if world.gameOver && sc == SCANCODE_ESCAPE {
                            running = false
                        } else {
                            paused = !paused
                        }
                    } else if sc == SCANCODE_SPACE || sc == SCANCODE_RETURN {
                        if world.gameOver {
                            restart = world.overT > 0.8
                        } else if sc == SCANCODE_SPACE && !paused {
                            controls.queueBomb()
                        }
                    }
                }
                Event.GamepadAdded(id) => controls.padAdded(id),
                Event.GamepadRemoved(id) => controls.padRemoved(id),
                Event.Other => {}
            }
        }
        if !running {
            break
        }
        if world.gameOver && world.overT > 0.8 && controls.padRestart() {
            restart = true
        }
        if world.gameOver && o.bot && world.overT >= BOT_RESTART {
            restart = true
        }
        if restart {
            if world.score > best {
                best = world.score
            }
            games += 1
            world = newWorld((o.seed + games * 7919) as u64)
            bot = newBot()
            acc = 0.0
        }

        let now = ticksNs()
        var dt = ((now - last) as f64) / 1.0e9
        last = now
        if dt > 0.1 {
            dt = 0.1
        }
        // Read the devices every frame even when the bot drives, so a bomb press is
        // consumed rather than saved up for later.
        var inp: Input = controls.read(world)
        if !paused {
            acc += dt
            var steps: i64 = 0
            while acc >= DT && steps < 8 {
                if o.bot {
                    inp = bot.think(world)
                }
                world.step(inp)
                inp.bomb = false
                acc -= DT
                steps += 1
            }
            // A long hitch (a dragged window, a debugger stop) is dropped, not replayed
            // at 8x speed.
            if steps == 8 {
                acc = 0.0
            }
        }

        let cam = camera(world)
        let clock = ((now - start) as f64) / 1.0e9
        buildFrame(&mut inst, &mut top, world, cam, font, hudFor(o, clock, paused))
        let fin = FrameIn {
            cam: cam,
            time: clock,
            dt: if paused { 0.0 } else { dt },
            worldDim: worldDim(world, paused),
        }
        var cmd = dev.begin()?
        match cmd.acquireSwapchain(dev) {
            Option.Some(target) => {
                ren.frame(&mut cmd, dev, inst, top, world, fin, target)?
                world.bursts.clear()
            }
            Option.None => {}
        }
        cmd.submit()?
        frames += 1
        if o.seconds > 0.0 && clock >= o.seconds {
            running = false
        }
    }
    if world.score > best {
        best = world.score
    }
    let secs = ((ticksNs() - start) as f64) / 1.0e9
    print($"SWARM: best score {best} over {games} game(s), {formatFloat((frames as f64) / secs, 1)} fps average")
    return Result.Ok(Unit {})
}

pub fn main(): i32 {
    let o = match parseOpts() {
        Result.Ok(v) => v,
        Result.Err(e) => {
            print("swarm: " + e)
            return 2
        }
    }
    let headless = o.shot.len > 0 || o.clip.len > 0 || o.bench
    let init = if headless { initVideo() } else { initVideoAndGamepad() }
    match init {
        Result.Ok(_) => {}
        Result.Err(e) => {
            print("swarm: " + e)
            return 1
        }
    }
    var r: Result<Unit, string> = Result.Ok(Unit {})
    if headless {
        r = runHeadless(o)
    } else {
        r = runWindow(o)
    }
    quit()
    match r {
        Result.Ok(_) => {
            return 0
        }
        Result.Err(e) => {
            print("swarm: " + e)
            return 1
        }
    }
}
