// Turns a World into the instance list the shape pipeline draws (see GAME_VS in
// shaders.milo for the layout and the shapes). The list is cleared and refilled each
// frame, never reallocated once it has grown to its peak.
//
// Additive blending makes draw order irrelevant, so the list is filled in whatever
// order is convenient, with enemies last: if a frame ever exceeds MAX_INST (only a
// benchmark gets near it), it is enemies that go undrawn, never a ship or the HUD.
// Sparks are GPU particles (render.milo) and the grid has its own pipeline.
//
// Colours are display values (the shader linearises them). It already makes a rim's
// core white-hot; alpha above 1 is how something is made to bloom harder than the rest.

from "./world" import {
    ARENA_HH, ARENA_HW, COMBO_TIME, DT, INVULN, MINI, Rgb, SCREEN_HH, SCREEN_HW, SEEKER, SPLITTER, TELEGRAPH,
    VIEW_HH, VIEW_HW, WANDERER, World, enemyColor, enemyRadius, rgb
}
from "std/math" import {
    Math
}

pub let MAX_INST: i64 = 200000

pub let INST_BYTES: i64 = 48

let DOT: f32 = 0.0
let RING: f32 = 1.0
let CHEVRON: f32 = 2.0
let LINE: f32 = 3.0
let BOX: f32 = 4.0
// The enemies, each a filled silhouette with its inner mark in one instance.
let WANDERER_SHAPE: f32 = 5.0
let SEEKER_SHAPE: f32 = 6.0
let SPLITTER_SHAPE: f32 = 7.0
// The player: a filled chevron, drawn last and opaque (see GAME_FS).
let SHIP_SHAPE: f32 = 8.0

// Room for the player's instances, which have a list of their own.
pub let MAX_TOP: i64 = 16

pub let SHIP_HX: f64 = 27.0

pub let SHIP_HY: f64 = 20.0
// Added to a shape id: the instance is in screen units (origin at the centre, y up),
// untouched by the camera and the shake.
let SCREEN: f32 = 16.0

// 48 bytes, matching the shader's `struct Inst { float4 a; float4 b; float4 c; }`.
pub struct Inst {
    x: f32,
    y: f32,
    hx: f32,
    hy: f32,
    c: f32,
    s: f32,
    shape: f32,
    width: f32,
    r: f32,
    g: f32,
    b: f32,
    a: f32,
}

// What the HUD should say beyond the World itself.
pub struct Hud {
    paused: bool,
    bot: bool,
    // Real seconds since start, for blinking prompts while the World is frozen.
    clock: f64,
}

fn put(out: &mut Vec<Inst>, x: f64, y: f64, hx: f64, hy: f64, c: f64, s: f64, shape: f32, width: f64, col: Rgb, a: f64) {
    if out.len >= MAX_INST {
        return
    }
    out.push(Inst {
        x: x as f32,
        y: y as f32,
        hx: hx as f32,
        hy: hy as f32,
        c: c as f32,
        s: s as f32,
        shape: shape,
        width: width as f32,
        r: col.r as f32,
        g: col.g as f32,
        b: col.b as f32,
        a: a as f32,
    })
}

// The camera centre for this frame, screen shake included. The shake is a pair of
// incommensurate sines of the tick, so it is deterministic and never repeats a beat.
pub struct Cam {
    x: f64,
    y: f64,
}

pub fn camera(w: &World): Cam {
    let t = (w.tick as f64) * DT
    let mag = w.shake * w.shake * 34.0
    return Cam {
        x: w.camX + mag * Math.sin(t * 91.0),
        y: w.camY + mag * Math.cos(t * 73.0 + 1.3),
    }
}

fn white(c: Rgb, k: f64): Rgb {
    return rgb(c.r + (1.0 - c.r) * k, c.g + (1.0 - c.g) * k, c.b + (1.0 - c.b) * k)
}

fn drawArena(out: &mut Vec<Inst>, w: &World) {
    // The wall glows brighter the closer the player is to it.
    let wall = rgb(0.3, 0.5, 1.0)
    let nearX = 1.0 - Math.minF64((ARENA_HW - Math.abs(w.px)) / 300.0, 1.0)
    let nearY = 1.0 - Math.minF64((ARENA_HH - Math.abs(w.py)) / 300.0, 1.0)
    let side = if w.px > 0.0 { 1.0 } else { -1.0 }
    let vert = if w.py > 0.0 { 1.0 } else { -1.0 }
    put(&mut out, -ARENA_HW, 0.0, ARENA_HH, 0.0, 0.0, 1.0, LINE, 2.2, wall, 0.8 + (if side < 0.0 { nearX } else { 0.0 }) * 0.8)
    put(&mut out, ARENA_HW, 0.0, ARENA_HH, 0.0, 0.0, 1.0, LINE, 2.2, wall, 0.8 + (if side > 0.0 { nearX } else { 0.0 }) * 0.8)
    put(&mut out, 0.0, -ARENA_HH, ARENA_HW, 0.0, 1.0, 0.0, LINE, 2.2, wall, 0.8 + (if vert < 0.0 { nearY } else { 0.0 }) * 0.8)
    put(&mut out, 0.0, ARENA_HH, ARENA_HW, 0.0, 1.0, 0.0, LINE, 2.2, wall, 0.8 + (if vert > 0.0 { nearY } else { 0.0 }) * 0.8)
}

fn drawEnemies(out: &mut Vec<Inst>, w: &World, cam: &Cam) {
    // Enemies well off screen still cost a draw; skip them. The margin covers the
    // largest shape plus its glow.
    let vx0 = cam.x - VIEW_HW - 60.0
    let vx1 = cam.x + VIEW_HW + 60.0
    let vy0 = cam.y - VIEW_HH - 60.0
    let vy1 = cam.y + VIEW_HH + 60.0
    for i in 0..w.cache.len {
        if w.cache[i].hp <= 0 {
            continue
        }
        let e = w.cache[i]
        if e.x < vx0 || e.x > vx1 || e.y < vy0 || e.y > vy1 {
            continue
        }
        let base = enemyColor(e.kind)
        let r = enemyRadius(e.kind)
        if e.spawn > 0.0 {
            // Telegraph: a ring that closes onto the spawn point and flickers, warming
            // up as it closes, but never as bright as a live enemy.
            let f = e.spawn / TELEGRAPH
            let blink = if Math.sin(e.age * 40.0) > 0.0 { 1.0 } else { 0.45 }
            let tr = r * 0.8 + 16.0 * Math.minF64(f, 1.2)
            let heat = 0.45 + 0.55 * (1.0 - Math.minF64(f, 1.0))
            put(&mut out, e.x, e.y, tr, tr, 1.0, 0.0, RING, 1.2, base, 0.7 * blink * heat)
            let dot = 3.0 + 4.0 * (1.0 - Math.minF64(f, 1.0))
            put(&mut out, e.x, e.y, dot, dot, 1.0, 0.0, DOT, 0.0, base, 0.8 * blink * heat)
            continue
        }
        var col = base
        var a: f64 = 1.0
        if e.flash > 0.0 {
            col = white(base, 0.8)
            a = 1.8
        }
        if e.kind == WANDERER {
            put(&mut out, e.x, e.y, r * 0.8, r * 0.8, Math.cos(e.rot), Math.sin(e.rot), WANDERER_SHAPE, 2.0, col, a)
        } else if e.kind == SEEKER || e.kind == MINI {
            // Pointed along its heading, so you can see which way it is coming.
            put(&mut out, e.x, e.y, r * 1.2, r * 0.75, e.dirX, e.dirY, SEEKER_SHAPE, 2.0, col, a)
        } else if e.kind == SPLITTER {
            put(&mut out, e.x, e.y, r, r, Math.cos(e.rot), Math.sin(e.rot), SPLITTER_SHAPE, 2.3, col, a)
        }
    }
}

// Where a pack of chasers (or a swarm still telegraphing) is closing in from off
// screen: a small arrow on the screen edge per direction, brighter the more are
// coming. Directions are 32 sectors around the camera centre; one or two stragglers
// show nothing.
fn drawThreats(out: &mut Vec<Inst>, w: &World, cam: &Cam) {
    var sectors: [i64; 32] = [0; 32]
    var any = false
    for i in 0..w.cache.len {
        let e = w.cache[i]
        if e.hp <= 0 || (e.kind != SEEKER && e.kind != MINI && e.spawn <= 0.0) {
            continue
        }
        let dx = e.x - cam.x
        let dy = e.y - cam.y
        if Math.abs(dx) < VIEW_HW && Math.abs(dy) < VIEW_HH {
            continue
        }
        if dx * dx + dy * dy > 1100.0 * 1100.0 {
            continue
        }
        let a = Math.atan2(dy, dx)
        var s = ((a + 3.14159265) / 6.2831853 * 32.0) as i64
        if s >= 32 {
            s = 0
        }
        sectors[s] += 1
        any = true
    }
    if !any {
        return
    }
    let col = rgb(0.1, 0.8, 1.0)
    let pulse = 0.75 + 0.25 * Math.sin((w.tick as f64) * 0.2)
    for s in 0..32 {
        let n = sectors[s]
        if n < 3 {
            continue
        }
        let a = ((s as f64) + 0.5) / 32.0 * 6.2831853 - 3.14159265
        let c = Math.cos(a)
        let sn = Math.sin(a)
        // Onto the edge of the screen, inset so the whole marker shows and, at the top,
        // clear of the HUD. A seeker's dart pointing outward: "they come from there".
        let ex = (SCREEN_HW - 30.0) / Math.maxF64(Math.abs(c), 0.001)
        let ey = (SCREEN_HH - 70.0) / Math.maxF64(Math.abs(sn), 0.001)
        let d = Math.minF64(ex, ey)
        let k = Math.minF64((n as f64) / 12.0, 1.0)
        put(&mut out, c * d, sn * d, 14.0, 7.0, c, sn, SEEKER_SHAPE + SCREEN, 1.6, col, (0.6 + 0.9 * k) * pulse)
    }
}

// Bomb and death shockwaves (a respawn clears a smaller circle without one).
fn drawWaves(out: &mut Vec<Inst>, w: &World) {
    if w.waveOn && w.waveMax >= 600.0 {
        let f = w.waveR / w.waveMax
        put(&mut out, w.waveX, w.waveY, w.waveR, w.waveR, 1.0, 0.0, RING, 5.0, rgb(0.55, 0.8, 1.0), 1.2 * (1.0 - f * 0.8))
    }
}

// The ship goes in a list of its own, drawn after everything else and opaque.
fn drawPlayer(out: &mut Vec<Inst>, top: &mut Vec<Inst>, w: &World) {
    if !w.alive || w.gameOver {
        return
    }
    // Blink while invulnerable, faster as it runs out.
    if w.invuln > 0.0 {
        let rate = 8.0 + (INVULN - w.invuln) * 6.0
        if Math.sin(w.invuln * rate * 6.2831853) < -0.2 {
            return
        }
        put(&mut out, w.px, w.py, SHIP_HX * 1.7, SHIP_HX * 1.7, 1.0, 0.0, RING, 1.2, rgb(0.9, 0.95, 1.0), 0.6)
    }
    let gold = rgb(1.0, 0.78, 0.3)
    // Engine flame out of the tail, longer the faster it goes, under the ship.
    let sp = Math.sqrt(w.pvx * w.pvx + w.pvy * w.pvy)
    if sp > 40.0 {
        let k = Math.minF64(sp / 520.0, 1.0)
        let flick = 0.8 + 0.2 * Math.sin((w.tick as f64) * 1.9)
        let len = (12.0 + 16.0 * k) * flick
        let back = SHIP_HX * 0.55 + len * 0.7
        put(&mut out, w.px - w.faceX * back, w.py - w.faceY * back, len, 6.0, w.faceX, w.faceY, DOT, 0.0, rgb(1.0, 0.55, 0.2), 2.4 * k * flick)
    }
    put(&mut top, w.px, w.py, SHIP_HX, SHIP_HY, w.faceX, w.faceY, SHIP_SHAPE, 2.4, gold, 1.0)
}

fn drawBullets(out: &mut Vec<Inst>, w: &World) {
    let core = rgb(1.0, 0.95, 0.75)
    let trail = rgb(1.0, 0.7, 0.3)
    for i in 0..w.bullets.len {
        let b = w.bullets[i]
        let inv = 1.0 / Math.sqrt(b.vx * b.vx + b.vy * b.vy)
        let dx = b.vx * inv
        let dy = b.vy * inv
        // A white-hot slug with a short trail.
        put(&mut out, b.x - dx * 20.0, b.y - dy * 20.0, 24.0, 2.2, dx, dy, DOT, 0.0, trail, 0.45)
        put(&mut out, b.x, b.y, 14.0, 3.2, dx, dy, DOT, 0.0, core, 2.2)
    }
}

fn drawFx(out: &mut Vec<Inst>, w: &World) {
    for i in 0..w.fx.len {
        let f = w.fx[i]
        let k = f.life / f.max
        put(&mut out, f.x, f.y, f.rad, f.rad, 1.0, 0.0, RING, f.width * (0.4 + 0.6 * k), rgb(f.r, f.g, f.b), k)
    }
}

// ── HUD ─────────────────────────────────────────────────────────────────────────────

// One 5x7 glyph as filled boxes, top-left at (x, y), `px` units per font pixel.
fn glyph(out: &mut Vec<Inst>, font: &Vec<i64>, ch: i64, x: f64, y: f64, px: f64, col: Rgb, a: f64) {
    if ch < 0 || ch >= font.len {
        return
    }
    let bits = font[ch]
    if bits == 0 {
        return
    }
    let half = px * 0.4
    for row in 0..7 {
        for colx in 0..5 {
            if ((bits >> (row * 5 + colx)) & 1) != 0 {
                put(&mut out, x + (colx as f64) * px + px * 0.5, y - (row as f64) * px - px * 0.5, half, half, 1.0, 0.0, BOX + SCREEN, 0.0, col, a)
            }
        }
    }
}

// align: 0 = left edge at x, 1 = centred on x, 2 = right edge at x.
fn text(out: &mut Vec<Inst>, font: &Vec<i64>, s: &string, x: f64, y: f64, px: f64, align: i64, col: Rgb, a: f64) {
    let adv = px * 6.0
    let wid = (s.len as f64) * adv - px
    var x0 = x
    if align == 1 {
        x0 = x - wid * 0.5
    } else if align == 2 {
        x0 = x - wid
    }
    for i in 0..s.len {
        var ch = s[i] as i64
        if ch >= 97 && ch <= 122 && ch != 120 {
            ch -= 32
        }
        glyph(&mut out, font, ch, x0 + (i as f64) * adv, y, px, col, a)
    }
}

// A non-negative integer, without building a string (the HUD redraws every frame).
fn number(out: &mut Vec<Inst>, font: &Vec<i64>, n: i64, x: f64, y: f64, px: f64, align: i64, col: Rgb, a: f64) {
    var digits: [i64; 20] = [0; 20]
    var count: i64 = 0
    var v = if n < 0 { 0 } else { n }
    while true {
        digits[count] = v % 10
        count += 1
        v = v / 10
        if v == 0 || count >= 20 {
            break
        }
    }
    let adv = px * 6.0
    let wid = (count as f64) * adv - px
    var x0 = x
    if align == 1 {
        x0 = x - wid * 0.5
    } else if align == 2 {
        x0 = x - wid
    }
    for i in 0..count {
        glyph(&mut out, font, 48 + digits[count - 1 - i], x0 + (i as f64) * adv, y, px, col, a)
    }
}

fn drawHud(out: &mut Vec<Inst>, w: &World, font: &Vec<i64>, hud: &Hud) {
    let dimCol = rgb(0.45, 0.6, 1.0)
    let scoreCol = rgb(0.85, 0.95, 1.0)
    text(&mut out, font, "SCORE", -770.0, 432.0, 2.4, 0, dimCol, 0.9)
    number(&mut out, font, w.score, -770.0, 410.0, 4.4, 0, scoreCol, 1.0)

    // Multiplier, and under it the time left before it starts to drain.
    let mult = w.multiplier()
    let gold = rgb(1.0, 0.8, 0.3)
    if mult > 1 {
        text(&mut out, font, "x", -8.0, 424.0, 4.0, 2, gold, 1.0)
        number(&mut out, font, mult, -2.0, 432.0, 5.0, 0, gold, 1.0)
        let f = Math.minF64(w.comboT / COMBO_TIME, 1.0)
        put(&mut out, 0.0, 388.0, 70.0 * f, 2.0, 1.0, 0.0, BOX + SCREEN, 0.0, gold, 0.7)
    }

    // Lives as little ships, bombs as rings, top right.
    let shipCol = rgb(1.0, 0.95, 0.72)
    for i in 0..w.lives {
        put(&mut out, 760.0 - (i as f64) * 34.0, 418.0, 11.0, 8.0, 0.0, 1.0, CHEVRON + SCREEN, 1.3, shipCol, 0.9)
    }
    let bombCol = rgb(0.55, 0.8, 1.0)
    for i in 0..w.bombs {
        put(&mut out, 762.0 - (i as f64) * 28.0, 384.0, 8.0, 8.0, 1.0, 0.0, RING + SCREEN, 1.4, bombCol, 0.9)
    }

    // Elapsed time, bottom left.
    let secs = w.time as i64
    let tx = -770.0
    number(&mut out, font, secs / 60, tx, -420.0, 2.6, 0, dimCol, 0.7)
    let mw = if secs / 60 >= 10 { 2.0 } else { 1.0 }
    text(&mut out, font, ":", tx + mw * 15.6, -420.0, 2.6, 0, dimCol, 0.7)
    let s2 = secs % 60
    let sx = tx + mw * 15.6 + 12.0
    number(&mut out, font, s2 / 10, sx, -420.0, 2.6, 0, dimCol, 0.7)
    number(&mut out, font, s2 % 10, sx + 15.6, -420.0, 2.6, 0, dimCol, 0.7)
    if hud.bot {
        text(&mut out, font, "AUTOPILOT", 770.0, -420.0, 2.6, 2, dimCol, 0.6)
    }

    let blink = if Math.sin(hud.clock * 5.0) > -0.3 { 1.0 } else { 0.25 }
    if w.gameOver {
        let red = rgb(1.0, 0.3, 0.45)
        let fade = Math.minF64(w.overT / 0.6, 1.0)
        text(&mut out, font, "GAME OVER", 0.0, 120.0, 12.0, 1, red, fade)
        text(&mut out, font, "SCORE", 0.0, 10.0, 3.0, 1, dimCol, fade)
        number(&mut out, font, w.score, 0.0, -18.0, 7.0, 1, scoreCol, fade)
        text(&mut out, font, "PRESS SPACE TO PLAY AGAIN", 0.0, -120.0, 3.4, 1, gold, fade * blink)
    } else if hud.paused {
        text(&mut out, font, "PAUSED", 0.0, 60.0, 10.0, 1, scoreCol, 1.0)
        text(&mut out, font, "ESC TO RESUME   Q TO QUIT", 0.0, -40.0, 3.0, 1, dimCol, blink)
    } else if w.time < 3.0 && !hud.bot {
        let a = Math.minF64(3.0 - w.time, 1.0)
        text(&mut out, font, "SWARM", 0.0, 150.0, 12.0, 1, rgb(0.4, 0.8, 1.0), a)
        text(&mut out, font, "MOVE WASD   AIM MOUSE   BOMB SPACE", 0.0, -130.0, 2.8, 1, dimCol, a)
    }
}

// The whole frame. `cam` must be the camera the uniforms use this frame.
// `out` is drawn additively; `top`, the player's ship, after it and opaque.
pub fn buildFrame(out: &mut Vec<Inst>, top: &mut Vec<Inst>, w: &World, cam: &Cam, font: &Vec<i64>, hud: &Hud) {
    out.clear()
    top.clear()
    drawHud(&mut out, w, font, hud)
    drawPlayer(&mut out, &mut top, w)
    drawBullets(&mut out, w)
    drawWaves(&mut out, w)
    drawFx(&mut out, w)
    drawArena(&mut out, w)
    drawThreats(&mut out, w, cam)
    drawEnemies(&mut out, w, cam)
}
