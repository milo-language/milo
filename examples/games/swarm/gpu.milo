@cValue("SDL_GPU_PRESENTMODE_IMMEDIATE", "SDL3/SDL.h")
pub let PRESENTMODE_IMMEDIATE: u32 = 1

@cValue("SDL_GPU_PRESENTMODE_MAILBOX", "SDL3/SDL.h")
pub let PRESENTMODE_MAILBOX: u32 = 2

// ── Safe API ─────────────────────────────────────────────────────────────────────────

pub struct Pipeline {
    id: i64,
}

pub struct Buffer {
    id: i64,
    size: i64,
}

pub struct TransferBuffer {
    id: i64,
    size: i64,
}

pub struct Texture {
    id: i64,
    w: i64,
    h: i64,
}

pub struct Sampler {
    id: i64,
}

pub struct ComputePipeline {
    id: i64,
    // Threads per group along x, as compiled into the pipeline: dispatches round up to it.
    group: i64,
}

pub struct Device {
    raw: *SDL_GPUDevice,
    // The window this device presents to, if any. Its own Drop (SDL_DestroyWindow) runs
    // after Device's Drop below, which has already released it from the device and
    // destroyed the device: fields drop after the struct's Drop.
    window: Option<Window>,
    windowRaw: *SDL_Window,
    pipelines: Vec<*SDL_GPUGraphicsPipeline>,
    computes: Vec<*SDL_GPUComputePipeline>,
    buffers: Vec<*SDL_GPUBuffer>,
    transfers: Vec<*SDL_GPUTransferBuffer>,
    textures: Vec<*SDL_GPUTexture>,
    samplers: Vec<*SDL_GPUSampler>,
}

impl Drop for Device {
    fn drop(self: &mut Self) {
        unsafe {
            // Releasing a resource a submitted command buffer still reads is undefined.
            SDL_WaitForGPUIdle(self.raw)
            for p in self.pipelines {
                SDL_ReleaseGPUGraphicsPipeline(self.raw, p)
            }
            for p in self.computes {
                SDL_ReleaseGPUComputePipeline(self.raw, p)
            }
            for s in self.samplers {
                SDL_ReleaseGPUSampler(self.raw, s)
            }
            for b in self.buffers {
                SDL_ReleaseGPUBuffer(self.raw, b)
            }
            for t in self.transfers {
                SDL_ReleaseGPUTransferBuffer(self.raw, t)
            }
            for t in self.textures {
                SDL_ReleaseGPUTexture(self.raw, t)
            }
            if self.windowRaw as i64 != 0 {
                SDL_ReleaseWindowFromGPUDevice(self.raw, self.windowRaw)
            }
            SDL_DestroyGPUDevice(self.raw)
        }
    }
}

// A Metal device that accepts MSL source. `debug` turns on SDL's validation layer.
pub fn createDevice(debug: bool): Result<Device, string> {
    unsafe {
        let raw = SDL_CreateGPUDevice(SHADERFORMAT_MSL, debug, 0 as *u8)
        if raw as i64 == 0 {
            return Result.Err("SDL_CreateGPUDevice: " + sdlError())
        }
        return Result.Ok(Device {
            raw: raw,
            window: Option.None,
            windowRaw: 0 as *SDL_Window,
            pipelines: Vec.new(),
            computes: Vec.new(),
            buffers: Vec.new(),
            transfers: Vec.new(),
            textures: Vec.new(),
            samplers: Vec.new(),
        })
    }
}

// Everything needed to build SWARM's one kind of graphics pipeline: a draw with no
// vertex buffers (the vertex shader pulls from storage, or makes a full-screen
// triangle from the vertex id), one color target, optional blending, and
// fragment-stage samplers and uniforms for the post-processing passes.
pub struct PipelineDesc {
    vsSource: string,
    vsEntry: string,
    fsSource: string,
    fsEntry: string,
    vsUniformBuffers: u32,
    vsStorageBuffers: u32,
    fsUniformBuffers: u32,
    fsSamplers: u32,
    format: u32,
    // BLEND_NONE, BLEND_ADD or BLEND_OVER.
    blend: i64,
    // Triangle strip (4-vertex quads) instead of a triangle list.
    strip: bool,
}

// Replace the target's colour.
pub let BLEND_NONE: i64 = 0
// Add to it (ONE, ONE): the output is the light a draw contributes.
pub let BLEND_ADD: i64 = 1
// Premultiplied "over" (ONE, ONE_MINUS_SRC_ALPHA): alpha is how much of what is
// underneath the draw covers, and the colour is added on top.
pub let BLEND_OVER: i64 = 2

// A compute kernel reading `readonly` storage buffers and writing `readwrite` ones,
// `group` threads per threadgroup along x (the MSL kernel must agree).
pub struct ComputeDesc {
    source: string,
    entry: string,
    uniformBuffers: u32,
    readonly: u32,
    readwrite: u32,
    group: i64,
}

// Shaders are MSL SOURCE text: SDL_GPU's Metal backend compiles it at load. The C
// strings are NUL-terminated by `cstr`, and code_size excludes the terminator.
fn makeShader(dev: *SDL_GPUDevice, src: &string, entry: &string, stage: u32, uniforms: u32, storage: u32, samplers: u32): *SDL_GPUShader {
    var info = ShaderCreateInfo {
        code_size: src.len as u64,
        code: src.cstr(),
        entrypoint: entry.cstr(),
        format: SHADERFORMAT_MSL,
        stage: stage,
        num_samplers: samplers,
        num_storage_textures: 0,
        num_storage_buffers: storage,
        num_uniform_buffers: uniforms,
        props: 0,
    }
    unsafe {
        return SDL_CreateGPUShader(dev, info.addrOf())
    }
}

impl Device {
    fn driver(self: &Self): string {
        unsafe {
            return _cstrToString(SDL_GetGPUDeviceDriver(self.raw))
        }
    }

    // Take the window for presenting. The device owns it from here on.
    fn claim(self: &mut Self, win: Window): Result<Unit, string> {
        let wr = win.handle()
        if !SDL_ClaimWindowForGPUDevice(self.raw, wr) {
            return Result.Err("SDL_ClaimWindowForGPUDevice: " + sdlError())
        }
        self.windowRaw = wr
        self.window = Option.Some(win)
        return Result.Ok(Unit {})
    }

    fn swapchainFormat(self: &Self): u32 {
        return SDL_GetGPUSwapchainTextureFormat(self.raw, self.windowRaw)
    }

    fn supportsPresentMode(self: &Self, mode: u32): bool {
        return SDL_WindowSupportsGPUPresentMode(self.raw, self.windowRaw, mode)
    }

    fn setPresentMode(self: &mut Self, mode: u32): bool {
        return SDL_SetGPUSwapchainParameters(self.raw, self.windowRaw, SWAPCHAINCOMPOSITION_SDR, mode)
    }

    fn setFramesInFlight(self: &mut Self, n: u32): bool {
        return SDL_SetGPUAllowedFramesInFlight(self.raw, n)
    }

    fn createPipeline(self: &mut Self, d: &PipelineDesc): Result<Pipeline, string> {
        let vs = makeShader(self.raw, d.vsSource, d.vsEntry, SHADERSTAGE_VERTEX, d.vsUniformBuffers, d.vsStorageBuffers, 0)
        if vs as i64 == 0 {
            return Result.Err("vertex shader " + d.vsEntry + ": " + sdlError())
        }
        let fs = makeShader(self.raw, d.fsSource, d.fsEntry, SHADERSTAGE_FRAGMENT, d.fsUniformBuffers, 0, d.fsSamplers)
        if fs as i64 == 0 {
            unsafe {
                SDL_ReleaseGPUShader(self.raw, vs)
            }
            return Result.Err("fragment shader " + d.fsEntry + ": " + sdlError())
        }
        let over = d.blend == BLEND_OVER
        let dst = if over { BLENDFACTOR_ONE_MINUS_SRC_ALPHA } else { BLENDFACTOR_ONE }
        var target = ColorTargetDescription {
            format: d.format,
            blend_state: ColorTargetBlendState {
                src_color_blendfactor: BLENDFACTOR_ONE,
                dst_color_blendfactor: dst,
                color_blend_op: BLENDOP_ADD,
                src_alpha_blendfactor: BLENDFACTOR_ONE,
                dst_alpha_blendfactor: dst,
                alpha_blend_op: BLENDOP_ADD,
                color_write_mask: 0,
                enable_blend: d.blend != BLEND_NONE,
                enable_color_write_mask: false,
                padding1: 0,
                padding2: 0,
            },
        }
        unsafe {
            var info = GraphicsPipelineCreateInfo {
                vertex_shader: vs,
                fragment_shader: fs,
                vertex_input_state: VertexInputState {
                    vertex_buffer_descriptions: 0 as *u8,
                    num_vertex_buffers: 0,
                    vertex_attributes: 0 as *u8,
                    num_vertex_attributes: 0,
                },
                primitive_type: if d.strip { PRIMITIVETYPE_TRIANGLESTRIP } else { PRIMITIVETYPE_TRIANGLELIST },
                rasterizer_state: RasterizerState {
                    fill_mode: 0,
                    cull_mode: 0,
                    front_face: 0,
                    depth_bias_constant_factor: 0.0,
                    depth_bias_clamp: 0.0,
                    depth_bias_slope_factor: 0.0,
                    enable_depth_bias: false,
                    enable_depth_clip: false,
                    padding1: 0,
                    padding2: 0,
                },
                multisample_state: MultisampleState {
                    sample_count: 0,
                    sample_mask: 0,
                    enable_mask: false,
                    enable_alpha_to_coverage: false,
                    padding2: 0,
                    padding3: 0,
                },
                depth_stencil_state: DepthStencilState {
                    compare_op: 0,
                    back_stencil_state: StencilOpState {
                        fail_op: 0,
                        pass_op: 0,
                        depth_fail_op: 0,
                        compare_op: 0,
                    },
                    front_stencil_state: StencilOpState {
                        fail_op: 0,
                        pass_op: 0,
                        depth_fail_op: 0,
                        compare_op: 0,
                    },
                    compare_mask: 0,
                    write_mask: 0,
                    enable_depth_test: false,
                    enable_depth_write: false,
                    enable_stencil_test: false,
                    padding1: 0,
                    padding2: 0,
                    padding3: 0,
                },
                target_info: GraphicsPipelineTargetInfo {
                    color_target_descriptions: target.addrOf(),
                    num_color_targets: 1,
                    depth_stencil_format: TEXTUREFORMAT_INVALID,
                    has_depth_stencil_target: false,
                    padding1: 0,
                    padding2: 0,
                    padding3: 0,
                },
                props: 0,
            }
            let p = SDL_CreateGPUGraphicsPipeline(self.raw, info.addrOf())
            // The pipeline keeps what it needs; the shader objects are ours to drop.
            SDL_ReleaseGPUShader(self.raw, vs)
            SDL_ReleaseGPUShader(self.raw, fs)
            if p as i64 == 0 {
                return Result.Err("SDL_CreateGPUGraphicsPipeline: " + sdlError())
            }
            self.pipelines.push(p)
        }
        return Result.Ok(Pipeline {
            id: self.pipelines.len - 1,
        })
    }

    fn createBuffer(self: &mut Self, usage: u32, size: i64): Result<Buffer, string> {
        var info = BufferCreateInfo {
            usage: usage,
            size: size as u32,
            props: 0,
        }
        unsafe {
            let b = SDL_CreateGPUBuffer(self.raw, info.addrOf())
            if b as i64 == 0 {
                return Result.Err("SDL_CreateGPUBuffer: " + sdlError())
            }
            self.buffers.push(b)
        }
        return Result.Ok(Buffer {
            id: self.buffers.len - 1,
            size: size,
        })
    }

    fn createTransferBuffer(self: &mut Self, download: bool, size: i64): Result<TransferBuffer, string> {
        var usage = TRANSFERBUFFERUSAGE_UPLOAD
        if download {
            usage = TRANSFERBUFFERUSAGE_DOWNLOAD
        }
        var info = TransferBufferCreateInfo {
            usage: usage,
            size: size as u32,
            props: 0,
        }
        unsafe {
            let t = SDL_CreateGPUTransferBuffer(self.raw, info.addrOf())
            if t as i64 == 0 {
                return Result.Err("SDL_CreateGPUTransferBuffer: " + sdlError())
            }
            self.transfers.push(t)
        }
        return Result.Ok(TransferBuffer {
            id: self.transfers.len - 1,
            size: size,
        })
    }

    // An offscreen color target that can also be sampled (the bloom chain will).
    fn createTargetTexture(self: &mut Self, w: i64, h: i64, format: u32): Result<Texture, string> {
        var info = TextureCreateInfo {
            kind: TEXTURETYPE_2D,
            format: format,
            usage: TEXTUREUSAGE_COLOR_TARGET | TEXTUREUSAGE_SAMPLER,
            width: w as u32,
            height: h as u32,
            layer_count_or_depth: 1,
            num_levels: 1,
            sample_count: 0,
            props: 0,
        }
        unsafe {
            let t = SDL_CreateGPUTexture(self.raw, info.addrOf())
            if t as i64 == 0 {
                return Result.Err("SDL_CreateGPUTexture: " + sdlError())
            }
            self.textures.push(t)
        }
        return Result.Ok(Texture {
            id: self.textures.len - 1,
            w: w,
            h: h,
        })
    }

    // Bilinear, clamped at the edges: what the bloom chain's filters are written for.
    fn createLinearSampler(self: &mut Self): Result<Sampler, string> {
        var info = SamplerCreateInfo {
            min_filter: FILTER_LINEAR,
            mag_filter: FILTER_LINEAR,
            mipmap_mode: SAMPLERMIPMAPMODE_NEAREST,
            address_mode_u: SAMPLERADDRESSMODE_CLAMP_TO_EDGE,
            address_mode_v: SAMPLERADDRESSMODE_CLAMP_TO_EDGE,
            address_mode_w: SAMPLERADDRESSMODE_CLAMP_TO_EDGE,
            mip_lod_bias: 0.0,
            max_anisotropy: 1.0,
            compare_op: 0,
            min_lod: 0.0,
            max_lod: 0.0,
            enable_anisotropy: false,
            enable_compare: false,
            padding1: 0,
            padding2: 0,
            props: 0,
        }
        unsafe {
            let s = SDL_CreateGPUSampler(self.raw, info.addrOf())
            if s as i64 == 0 {
                return Result.Err("SDL_CreateGPUSampler: " + sdlError())
            }
            self.samplers.push(s)
        }
        return Result.Ok(Sampler {
            id: self.samplers.len - 1,
        })
    }

    fn createComputePipeline(self: &mut Self, d: &ComputeDesc): Result<ComputePipeline, string> {
        var info = ComputePipelineCreateInfo {
            code_size: d.source.len as u64,
            code: d.source.cstr(),
            entrypoint: d.entry.cstr(),
            format: SHADERFORMAT_MSL,
            num_samplers: 0,
            num_readonly_storage_textures: 0,
            num_readonly_storage_buffers: d.readonly,
            num_readwrite_storage_textures: 0,
            num_readwrite_storage_buffers: d.readwrite,
            num_uniform_buffers: d.uniformBuffers,
            threadcount_x: d.group as u32,
            threadcount_y: 1,
            threadcount_z: 1,
            props: 0,
        }
        unsafe {
            let p = SDL_CreateGPUComputePipeline(self.raw, info.addrOf())
            if p as i64 == 0 {
                return Result.Err("compute " + d.entry + ": " + sdlError())
            }
            self.computes.push(p)
        }
        return Result.Ok(ComputePipeline {
            id: self.computes.len - 1,
            group: d.group,
        })
    }

    fn begin(self: &Self): Result<Commands, string> {
        unsafe {
            let c = SDL_AcquireGPUCommandBuffer(self.raw)
            if c as i64 == 0 {
                return Result.Err("SDL_AcquireGPUCommandBuffer: " + sdlError())
            }
            return Result.Ok(Commands {
                raw: c,
            })
        }
    }

    fn textureTarget(self: &Self, t: Texture): Target {
        return Target {
            raw: self.textures[t.id],
            w: t.w,
            h: t.h,
        }
    }

    // Copy `data` into the transfer buffer. `cycle` hands back a fresh backing
    // allocation when the GPU may still be reading the previous one, so a per-frame
    // upload never stalls on, or scribbles over, the frame in flight.
    fn write<T>(self: &Self, dst: TransferBuffer, data: &Vec<T>, cycle: bool) {
        let bytes = data.len * sizeOf<T>()
        assert(bytes <= dst.size, "gpu write: data larger than the transfer buffer")
        unsafe {
            let t = self.transfers[dst.id]
            let p = SDL_MapGPUTransferBuffer(self.raw, t, cycle)
            memcpy(p, data.ptr() as *u8, bytes)
            SDL_UnmapGPUTransferBuffer(self.raw, t)
        }
    }

    // Read `tex` back to the CPU into `out` (resized to w*h packed pixels in the
    // texture's own byte order): one command buffer, then wait for the GPU to go idle.
    // `xfer` is a download transfer buffer of at least w*h*4 bytes that the caller
    // keeps: making one per call would grow the Device's resource list per frame.
    fn readTexture(self: &Self, tex: Texture, xfer: TransferBuffer, out: &mut Vec<u32>): Result<Unit, string> {
        let bytes = tex.w * tex.h * 4
        assert(bytes <= xfer.size, "gpu readTexture: transfer buffer too small")
        while out.len < tex.w * tex.h {
            out.push(0)
        }
        out.truncate(tex.w * tex.h)
        unsafe {
            let c = SDL_AcquireGPUCommandBuffer(self.raw)
            if c as i64 == 0 {
                return Result.Err("SDL_AcquireGPUCommandBuffer: " + sdlError())
            }
            let cp = SDL_BeginGPUCopyPass(c)
            var src = TextureRegion {
                texture: self.textures[tex.id],
                mip_level: 0,
                layer: 0,
                x: 0,
                y: 0,
                z: 0,
                w: tex.w as u32,
                h: tex.h as u32,
                d: 1,
            }
            var dst = TextureTransferInfo {
                transfer_buffer: self.transfers[xfer.id],
                offset: 0,
                pixels_per_row: 0,
                rows_per_layer: 0,
            }
            SDL_DownloadFromGPUTexture(cp, src.addrOf(), dst.addrOf())
            SDL_EndGPUCopyPass(cp)
            if !SDL_SubmitGPUCommandBuffer(c) {
                return Result.Err("SDL_SubmitGPUCommandBuffer: " + sdlError())
            }
            SDL_WaitForGPUIdle(self.raw)
            let p = SDL_MapGPUTransferBuffer(self.raw, self.transfers[xfer.id], false)
            memcpy(out.ptr() as *u8, p, bytes)
            SDL_UnmapGPUTransferBuffer(self.raw, self.transfers[xfer.id])
        }
        return Result.Ok(Unit {})
    }
}

// A texture a render pass can draw into: either this frame's swapchain image or an
// offscreen texture. Move-only, and consumed by `beginPass`, so a swapchain image
// cannot be carried past the command buffer that acquired it.
pub struct Target {
    raw: *SDL_GPUTexture,
    w: i64,
    h: i64,
}

// One command buffer. Consumed by `submit` (or `cancel`).
pub struct Commands {
    raw: *SDL_GPUCommandBuffer,
}

impl Commands {
    // Copy a transfer buffer's first `bytes` into a GPU buffer. `cycle` as in write.
    fn upload(self: &mut Self, dev: &Device, src: TransferBuffer, dst: Buffer, bytes: i64, cycle: bool) {
        assert(bytes <= src.size && bytes <= dst.size, "gpu upload: region larger than a buffer")
        if bytes <= 0 {
            return
        }
        unsafe {
            let cp = SDL_BeginGPUCopyPass(self.raw)
            var from = TransferBufferLocation {
                transfer_buffer: dev.transfers[src.id],
                offset: 0,
            }
            var to = BufferRegion {
                buffer: dev.buffers[dst.id],
                offset: 0,
                size: bytes as u32,
            }
            SDL_UploadToGPUBuffer(cp, from.addrOf(), to.addrOf(), cycle)
            SDL_EndGPUCopyPass(cp)
        }
    }

    // Block until the window's next swapchain image is free. None when there is none to
    // draw into (a minimized window); the frame should then submit without drawing.
    fn acquireSwapchain(self: &mut Self, dev: &Device): Option<Target> {
        var tex = 0 as *SDL_GPUTexture
        var w: u32 = 0
        var h: u32 = 0
        unsafe {
            if !SDL_WaitAndAcquireGPUSwapchainTexture(self.raw, dev.windowRaw, tex.addrOf(), w.addrOf(), h.addrOf()) {
                return Option.None
            }
        }
        if tex as i64 == 0 {
            return Option.None
        }
        return Option.Some(Target {
            raw: tex,
            w: w as i64,
            h: h as i64,
        })
    }

    // 8 floats of vertex-stage uniforms, visible to MSL as `constant T& [[buffer(slot)]]`.
    fn pushVertexUniforms(self: &mut Self, slot: u32, data: [f32; 8]) {
        unsafe {
            SDL_PushGPUVertexUniformData(self.raw, slot, data, 32)
        }
    }

    // 16 floats (64 bytes) per stage: the post-processing and particle passes need more
    // than the shape pipeline's 8.
    fn pushVertexUniforms16(self: &mut Self, slot: u32, data: [f32; 16]) {
        unsafe {
            SDL_PushGPUVertexUniformData(self.raw, slot, data, 64)
        }
    }

    fn pushFragmentUniforms(self: &mut Self, slot: u32, data: [f32; 16]) {
        unsafe {
            SDL_PushGPUFragmentUniformData(self.raw, slot, data, 64)
        }
    }

    fn pushComputeUniforms(self: &mut Self, slot: u32, data: [f32; 16]) {
        unsafe {
            SDL_PushGPUComputeUniformData(self.raw, slot, data, 64)
        }
    }

    // A compute pass that may write `rw` (bound to read-write storage slot 0). Never
    // cycled: the buffer's contents carry over from frame to frame.
    fn beginCompute(self: &mut Self, dev: &Device, rw: Buffer): Result<ComputePass, string> {
        var binding = StorageBufferReadWriteBinding {
            buffer: dev.buffers[rw.id],
            cycle: false,
            padding1: 0,
            padding2: 0,
            padding3: 0,
        }
        unsafe {
            let p = SDL_BeginGPUComputePass(self.raw, 0 as *u8, 0, binding.addrOf(), 1)
            if p as i64 == 0 {
                return Result.Err("SDL_BeginGPUComputePass: " + sdlError())
            }
            return Result.Ok(ComputePass {
                raw: p,
            })
        }
    }

    fn beginPass(self: &mut Self, target: Target, clear: FColor): Result<Pass, string> {
        return self.beginPassWith(target, clear, LOADOP_CLEAR)
    }

    // Draw on top of what the target already holds (the bloom chain's upsample passes
    // add into the level below).
    fn beginPassKeep(self: &mut Self, target: Target): Result<Pass, string> {
        let none = FColor {
            r: 0.0,
            g: 0.0,
            b: 0.0,
            a: 0.0,
        }
        return self.beginPassWith(target, none, LOADOP_LOAD)
    }

    fn beginPassWith(self: &mut Self, target: Target, clear: FColor, load: u32): Result<Pass, string> {
        var info = ColorTargetInfo {
            texture: target.raw,
            mip_level: 0,
            layer_or_depth_plane: 0,
            clear_color: clear,
            load_op: load,
            store_op: STOREOP_STORE,
            resolve_texture: 0 as *SDL_GPUTexture,
            resolve_mip_level: 0,
            resolve_layer: 0,
            cycle: false,
            cycle_resolve_texture: false,
            padding1: 0,
            padding2: 0,
        }
        unsafe {
            let p = SDL_BeginGPURenderPass(self.raw, info.addrOf(), 1, 0 as *u8)
            if p as i64 == 0 {
                return Result.Err("SDL_BeginGPURenderPass: " + sdlError())
            }
            return Result.Ok(Pass {
                raw: p,
            })
        }
    }

    fn submit(self: Self): Result<Unit, string> {
        if !SDL_SubmitGPUCommandBuffer(self.raw) {
            return Result.Err("SDL_SubmitGPUCommandBuffer: " + sdlError())
        }
        return Result.Ok(Unit {})
    }

    // Submit, and get a fence that signals when the GPU has finished this buffer. Pacing
    // offscreen frames needs it: with no swapchain to block on, nothing else stops the
    // CPU queueing frames (and cycling transfer buffers) without bound.
    fn submitFenced(self: Self): Result<Fence, string> {
        unsafe {
            let f = SDL_SubmitGPUCommandBufferAndAcquireFence(self.raw)
            if f as i64 == 0 {
                return Result.Err("SDL_SubmitGPUCommandBufferAndAcquireFence: " + sdlError())
            }
            return Result.Ok(Fence {
                raw: f,
            })
        }
    }
}

// A submitted command buffer's completion signal. Consumed by `Device.wait`.
pub struct Fence {
    raw: *SDL_GPUFence,
}

impl Device {
    fn waitIdle(self: &Self) {
        SDL_WaitForGPUIdle(self.raw)
    }

    fn waitFor(self: &Self, f: &Fence) {
        var raw = f.raw
        unsafe {
            SDL_WaitForGPUFences(self.raw, true, raw.addrOf(), 1)
        }
    }

    // Release a fence only after at least one LATER submit. The leak below is measured;
    // the mechanism is inferred, not read from SDL's source: SDL's Metal backend (3.4.x)
    // appears to retire a finished command buffer, and drops its references to the buffers it
    // used, during the next submit, by checking that buffer's fence. A fence released
    // before that check goes back to SDL's pool and is handed out again unsignalled, so
    // the old command buffer is never retired, and every buffer it touched stays
    // "in use": each cycled upload then allocates a fresh one, about 1.6 MB a frame at
    // 100k particles. Measured: release right after the wait grew to 1.1 GB in 300
    // frames; release one submit later stays flat at 85 MB over 2000.
    fn releaseFence(self: &Self, f: Fence) {
        SDL_ReleaseGPUFence(self.raw, f.raw)
    }
}

// One render pass. Consumed by `end`.
pub struct Pass {
    raw: *SDL_GPURenderPass,
}

impl Pass {
    fn bindPipeline(self: &mut Self, dev: &Device, p: Pipeline) {
        SDL_BindGPUGraphicsPipeline(self.raw, dev.pipelines[p.id])
    }

    fn bindVertexStorage(self: &mut Self, dev: &Device, slot: u32, b: Buffer) {
        var raw = dev.buffers[b.id]
        unsafe {
            SDL_BindGPUVertexStorageBuffers(self.raw, slot, raw.addrOf(), 1)
        }
    }

    // `tex` for the fragment stage's [[texture(slot)]], read through [[sampler(slot)]].
    fn bindFragmentTexture(self: &mut Self, dev: &Device, slot: u32, tex: Texture, s: Sampler) {
        var b = TextureSamplerBinding {
            texture: dev.textures[tex.id],
            sampler: dev.samplers[s.id],
        }
        unsafe {
            SDL_BindGPUFragmentSamplers(self.raw, slot, b.addrOf(), 1)
        }
    }

    fn draw(self: &mut Self, vertices: i64, instances: i64) {
        SDL_DrawGPUPrimitives(self.raw, vertices as u32, instances as u32, 0, 0)
    }
    fn end(self: Self) {
        SDL_EndGPURenderPass(self.raw)
    }
}

// One compute pass. Consumed by `end`. Dispatches inside one pass run in order, each
// seeing the writes of the one before (SDL's Metal backend encodes them serially).
pub struct ComputePass {
    raw: *SDL_GPUComputePass,
}

impl ComputePass {
    fn bindPipeline(self: &mut Self, dev: &Device, p: ComputePipeline) {
        SDL_BindGPUComputePipeline(self.raw, dev.computes[p.id])
    }

    // A read-only storage buffer, at read-only slot `slot`.
    fn bindStorage(self: &mut Self, dev: &Device, slot: u32, b: Buffer) {
        var raw = dev.buffers[b.id]
        unsafe {
            SDL_BindGPUComputeStorageBuffers(self.raw, slot, raw.addrOf(), 1)
        }
    }

    // Enough groups of the pipeline's width to cover `threads`; the kernel bounds-checks.
    fn dispatch(self: &mut Self, p: ComputePipeline, threads: i64) {
        if threads <= 0 {
            return
        }
        let groups = (threads + p.group - 1) / p.group
        SDL_DispatchGPUCompute(self.raw, groups as u32, 1, 1)
    }

    fn end(self: Self) {
        SDL_EndGPUComputePass(self.raw)
    }
}
