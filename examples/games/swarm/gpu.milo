// SWARM's SDL_GPU layer: the C bindings SWARM needs, and a small safe API over them.
//
// Every create-info struct below is passed to SDL by pointer, so its layout IS the
// contract, and each one carries @cLayout: a field at the wrong offset fails the build
// instead of handing Metal a garbage pipeline. Every extern carries @cSig and every
// constant @cValue, for the same reason.
//
// Ownership model. The `Device` owns every resource it creates (pipelines, buffers,
// transfer buffers, textures) and the window it claimed, and releases them all when it
// drops, window last. The game holds plain index handles (`Buffer`, `Pipeline`, ...),
// which are Copy and cannot dangle: a handle only resolves through the Device that
// made it, and nothing is released while that Device is alive. Transient objects
// (command buffers, passes, swapchain textures) are move-only structs consumed by the
// call that ends them.

from "./sdl3" import {
    SDL_Window, Window, sdlError
}
from "std/os" import {
    memcpy
}

pub extern type SDL_GPUDevice

pub extern type SDL_GPUShader

pub extern type SDL_GPUGraphicsPipeline

pub extern type SDL_GPUBuffer

pub extern type SDL_GPUTransferBuffer

pub extern type SDL_GPUTexture

pub extern type SDL_GPUCommandBuffer

pub extern type SDL_GPUCopyPass

pub extern type SDL_GPURenderPass

pub extern type SDL_GPUFence

pub extern type SDL_GPUSampler

pub extern type SDL_GPUComputePipeline

pub extern type SDL_GPUComputePass

// ── Layout-verified create-info structs ──────────────────────────────────────────────

@cLayout("SDL_GPUShaderCreateInfo", "SDL3/SDL.h")
extern struct ShaderCreateInfo {
    code_size: u64,
    code: *u8,
    entrypoint: *u8,
    format: u32,
    stage: u32,
    num_samplers: u32,
    num_storage_textures: u32,
    num_storage_buffers: u32,
    num_uniform_buffers: u32,
    props: u32,
}

@cLayout("SDL_GPUColorTargetBlendState", "SDL3/SDL.h")
extern struct ColorTargetBlendState {
    src_color_blendfactor: u32,
    dst_color_blendfactor: u32,
    color_blend_op: u32,
    src_alpha_blendfactor: u32,
    dst_alpha_blendfactor: u32,
    alpha_blend_op: u32,
    color_write_mask: u8,
    enable_blend: bool,
    enable_color_write_mask: bool,
    padding1: u8,
    padding2: u8,
}

@cLayout("SDL_GPUColorTargetDescription", "SDL3/SDL.h")
extern struct ColorTargetDescription {
    format: u32,
    blend_state: ColorTargetBlendState,
}

@cLayout("SDL_GPUVertexInputState", "SDL3/SDL.h")
extern struct VertexInputState {
    // SDL_GPUVertexBufferDescription / SDL_GPUVertexAttribute arrays. SWARM pulls its
    // instances from a storage buffer, so these stay null and are typed as bytes.
    vertex_buffer_descriptions: *u8,
    num_vertex_buffers: u32,
    vertex_attributes: *u8,
    num_vertex_attributes: u32,
}

@cLayout("SDL_GPURasterizerState", "SDL3/SDL.h")
extern struct RasterizerState {
    fill_mode: u32,
    cull_mode: u32,
    front_face: u32,
    depth_bias_constant_factor: f32,
    depth_bias_clamp: f32,
    depth_bias_slope_factor: f32,
    enable_depth_bias: bool,
    enable_depth_clip: bool,
    padding1: u8,
    padding2: u8,
}

@cLayout("SDL_GPUMultisampleState", "SDL3/SDL.h")
extern struct MultisampleState {
    sample_count: u32,
    sample_mask: u32,
    enable_mask: bool,
    enable_alpha_to_coverage: bool,
    padding2: u8,
    padding3: u8,
}

@cLayout("SDL_GPUStencilOpState", "SDL3/SDL.h")
extern struct StencilOpState {
    fail_op: u32,
    pass_op: u32,
    depth_fail_op: u32,
    compare_op: u32,
}

@cLayout("SDL_GPUDepthStencilState", "SDL3/SDL.h")
extern struct DepthStencilState {
    compare_op: u32,
    back_stencil_state: StencilOpState,
    front_stencil_state: StencilOpState,
    compare_mask: u8,
    write_mask: u8,
    enable_depth_test: bool,
    enable_depth_write: bool,
    enable_stencil_test: bool,
    padding1: u8,
    padding2: u8,
    padding3: u8,
}

@cLayout("SDL_GPUGraphicsPipelineTargetInfo", "SDL3/SDL.h")
extern struct GraphicsPipelineTargetInfo {
    color_target_descriptions: *ColorTargetDescription,
    num_color_targets: u32,
    depth_stencil_format: u32,
    has_depth_stencil_target: bool,
    padding1: u8,
    padding2: u8,
    padding3: u8,
}

@cLayout("SDL_GPUGraphicsPipelineCreateInfo", "SDL3/SDL.h")
extern struct GraphicsPipelineCreateInfo {
    vertex_shader: *SDL_GPUShader,
    fragment_shader: *SDL_GPUShader,
    vertex_input_state: VertexInputState,
    primitive_type: u32,
    rasterizer_state: RasterizerState,
    multisample_state: MultisampleState,
    depth_stencil_state: DepthStencilState,
    target_info: GraphicsPipelineTargetInfo,
    props: u32,
}

@cLayout("SDL_GPUBufferCreateInfo", "SDL3/SDL.h")
extern struct BufferCreateInfo {
    usage: u32,
    size: u32,
    props: u32,
}

@cLayout("SDL_GPUTransferBufferCreateInfo", "SDL3/SDL.h")
extern struct TransferBufferCreateInfo {
    usage: u32,
    size: u32,
    props: u32,
}

@cLayout("SDL_GPUTransferBufferLocation", "SDL3/SDL.h")
extern struct TransferBufferLocation {
    transfer_buffer: *SDL_GPUTransferBuffer,
    offset: u32,
}

@cLayout("SDL_GPUBufferRegion", "SDL3/SDL.h")
extern struct BufferRegion {
    buffer: *SDL_GPUBuffer,
    offset: u32,
    size: u32,
}

@cLayout("SDL_FColor", "SDL3/SDL.h")
pub extern struct FColor {
    r: f32,
    g: f32,
    b: f32,
    a: f32,
}

@cLayout("SDL_GPUColorTargetInfo", "SDL3/SDL.h")
extern struct ColorTargetInfo {
    texture: *SDL_GPUTexture,
    mip_level: u32,
    layer_or_depth_plane: u32,
    clear_color: FColor,
    load_op: u32,
    store_op: u32,
    resolve_texture: *SDL_GPUTexture,
    resolve_mip_level: u32,
    resolve_layer: u32,
    cycle: bool,
    cycle_resolve_texture: bool,
    padding1: u8,
    padding2: u8,
}

// C's first field is `type`, a Milo keyword: declared @cOpaque, so the build still
// checks every field after it (and the total size) but not its name.
@cLayout("SDL_GPUTextureCreateInfo", "SDL3/SDL.h")
extern struct TextureCreateInfo {
    @cOpaque kind: u32,
    format: u32,
    usage: u32,
    width: u32,
    height: u32,
    layer_count_or_depth: u32,
    num_levels: u32,
    sample_count: u32,
    props: u32,
}

@cLayout("SDL_GPUTextureRegion", "SDL3/SDL.h")
extern struct TextureRegion {
    texture: *SDL_GPUTexture,
    mip_level: u32,
    layer: u32,
    x: u32,
    y: u32,
    z: u32,
    w: u32,
    h: u32,
    d: u32,
}

@cLayout("SDL_GPUTextureTransferInfo", "SDL3/SDL.h")
extern struct TextureTransferInfo {
    transfer_buffer: *SDL_GPUTransferBuffer,
    offset: u32,
    pixels_per_row: u32,
    rows_per_layer: u32,
}

@cLayout("SDL_GPUSamplerCreateInfo", "SDL3/SDL.h")
extern struct SamplerCreateInfo {
    min_filter: u32,
    mag_filter: u32,
    mipmap_mode: u32,
    address_mode_u: u32,
    address_mode_v: u32,
    address_mode_w: u32,
    mip_lod_bias: f32,
    max_anisotropy: f32,
    compare_op: u32,
    min_lod: f32,
    max_lod: f32,
    enable_anisotropy: bool,
    enable_compare: bool,
    padding1: u8,
    padding2: u8,
    props: u32,
}

@cLayout("SDL_GPUTextureSamplerBinding", "SDL3/SDL.h")
extern struct TextureSamplerBinding {
    texture: *SDL_GPUTexture,
    sampler: *SDL_GPUSampler,
}

@cLayout("SDL_GPUComputePipelineCreateInfo", "SDL3/SDL.h")
extern struct ComputePipelineCreateInfo {
    code_size: u64,
    code: *u8,
    entrypoint: *u8,
    format: u32,
    num_samplers: u32,
    num_readonly_storage_textures: u32,
    num_readonly_storage_buffers: u32,
    num_readwrite_storage_textures: u32,
    num_readwrite_storage_buffers: u32,
    num_uniform_buffers: u32,
    threadcount_x: u32,
    threadcount_y: u32,
    threadcount_z: u32,
    props: u32,
}

@cLayout("SDL_GPUStorageBufferReadWriteBinding", "SDL3/SDL.h")
extern struct StorageBufferReadWriteBinding {
    buffer: *SDL_GPUBuffer,
    cycle: bool,
    padding1: u8,
    padding2: u8,
    padding3: u8,
}

