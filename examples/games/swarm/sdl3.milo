@cValue("SDL_GAMEPAD_BUTTON_RIGHT_SHOULDER", "SDL3/SDL.h")
pub let PAD_RIGHT_SHOULDER: i32 = 10

// SDL_Event is a 128-byte union. Milo has no unions, so it is declared as its tag plus
// opaque filler (C's first member is named `type`, a Milo keyword, hence @cOpaque), and
// a variant is read by viewing the same bytes as that variant's struct, whose own
// layout is verified field by field below.
@cLayout("SDL_Event", "SDL3/SDL.h")
extern struct SdlEvent {
    @cOpaque kind: u32,
    @cOpaque rest: [u8; 124],
}

@cLayout("SDL_KeyboardEvent", "SDL3/SDL.h")
extern struct SdlKeyboardEvent {
    @cOpaque kind: u32,
    reserved: u32,
    timestamp: u64,
    windowID: u32,
    which: u32,
    scancode: u32,
    key: u32,
    mod: u16,
    raw: u16,
    down: bool,
    repeat: bool,
}

@cLayout("SDL_GamepadDeviceEvent", "SDL3/SDL.h")
extern struct SdlGamepadDeviceEvent {
    @cOpaque kind: u32,
    reserved: u32,
    timestamp: u64,
    which: u32,
}

// SDL's last error message, copied into a Milo string.
pub fn sdlError(): string {
    unsafe {
        return _cstrToString(SDL_GetError())
    }
}

// Brings up the video subsystem (which implies events). Pair with `quit`.
pub fn initVideo(): Result<Unit, string> {
    if !SDL_Init(SDL_INIT_VIDEO) {
        return Result.Err("SDL_Init: " + sdlError())
    }
    return Result.Ok(Unit {})
}

// Video plus gamepads. Pads already plugged in arrive as GamepadAdded events on the
// first polls, so opening them is the event loop's job, not this function's.
pub fn initVideoAndGamepad(): Result<Unit, string> {
    if !SDL_Init(SDL_INIT_VIDEO | SDL_INIT_GAMEPAD) {
        return Result.Err("SDL_Init: " + sdlError())
    }
    return Result.Ok(Unit {})
}

pub fn quit() {
    SDL_Quit()
}

// Nanoseconds since SDL_Init. Monotonic.
pub fn ticksNs(): i64 {
    return SDL_GetTicksNS() as i64
}

pub struct PixelSize {
    w: i64,
    h: i64,
}

pub struct Mouse {
    x: f32,
    y: f32,
    buttons: u32,
}

// Mouse position in window points, and the button bitmask.
pub fn mouseState(): Mouse {
    var x: f32 = 0.0
    var y: f32 = 0.0
    var b: u32 = 0
    unsafe {
        b = SDL_GetMouseState(x.addrOf(), y.addrOf())
    }
    return Mouse {
        x: x,
        y: y,
        buttons: b,
    }
}

// One SDL window, destroyed when dropped. The pointer field makes it move-only, so a
// second owner (and a double destroy) cannot be written.
pub struct Window {
    raw: *SDL_Window,
}

impl Drop for Window {
    fn drop(self: &mut Self) {
        unsafe {
            if self.raw as i64 != 0 {
                SDL_DestroyWindow(self.raw)
            }
        }
    }
}

// A window `w` x `h` in points. HiDPI-aware: on a Retina display the drawable is
// larger than the point size, and `pixelSize` reports the real one.
pub fn openWindow(title: string, w: i64, h: i64, hidden: bool): Result<Window, string> {
    var flags = SDL_WINDOW_HIGH_PIXEL_DENSITY
    if hidden {
        flags = flags | SDL_WINDOW_HIDDEN
    }
    unsafe {
        let raw = SDL_CreateWindow(title.cstr(), w as i32, h as i32, flags)
        if raw as i64 == 0 {
            return Result.Err("SDL_CreateWindow: " + sdlError())
        }
        return Result.Ok(Window {
            raw: raw,
        })
    }
}

impl Window {
    fn pixelSize(self: &Self): PixelSize {
        var w: i32 = 0
        var h: i32 = 0
        unsafe {
            SDL_GetWindowSizeInPixels(self.raw, w.addrOf(), h.addrOf())
        }
        return PixelSize {
            w: w as i64,
            h: h as i64,
        }
    }

    // For gpu.milo only: the device claims the window by its C handle.
    fn handle(self: &Self): *SDL_Window {
        return self.raw
    }
}

pub enum Event {
    Empty,
    Quit,
    KeyDown(u32),
    GamepadAdded(u32),
    GamepadRemoved(u32),
    Other,
}

// The next pending event, or Empty when the queue is drained. The 128-byte event lives
// on the stack, so polling never allocates.
pub fn pollEvent(): Event {
    var ev = SdlEvent {
        kind: 0,
        rest: [0; 124],
    }
    unsafe {
        if !SDL_PollEvent(ev.addrOf()) {
            return Event.Empty
        }
        if ev.kind == SDL_EVENT_QUIT || ev.kind == SDL_EVENT_WINDOW_CLOSE_REQUESTED {
            return Event.Quit
        }
        if ev.kind == SDL_EVENT_KEY_DOWN {
            let k = ev.addrOf() as *SdlKeyboardEvent
            let k2 = *k
            if k2.repeat {
                return Event.Other
            }
            return Event.KeyDown(k2.scancode)
        }
        if ev.kind == SDL_EVENT_GAMEPAD_ADDED || ev.kind == SDL_EVENT_GAMEPAD_REMOVED {
            let g = ev.addrOf() as *SdlGamepadDeviceEvent
            let which = (*g).which
            if ev.kind == SDL_EVENT_GAMEPAD_ADDED {
                return Event.GamepadAdded(which)
            }
            return Event.GamepadRemoved(which)
        }
    }
    return Event.Other
}

// Whether a key (by scancode) is held right now. SDL owns the state array for the
// life of the program and updates it as events are pumped, so read it after polling.
pub fn keyDown(sc: u32): bool {
    unsafe {
        let ks = SDL_GetKeyboardState(0 as *i32)
        return ks[sc as i64]
    }
}

// One open gamepad, closed when dropped.
pub struct Gamepad {
    raw: *SDL_Gamepad,
}

impl Drop for Gamepad {
    fn drop(self: &mut Self) {
        unsafe {
            if self.raw as i64 != 0 {
                SDL_CloseGamepad(self.raw)
            }
        }
    }
}

pub fn openGamepad(id: u32): Option<Gamepad> {
    unsafe {
        let raw = SDL_OpenGamepad(id)
        if raw as i64 == 0 {
            return Option.None
        }
        return Option.Some(Gamepad {
            raw: raw,
        })
    }
}

impl Gamepad {
    fn id(self: &Self): u32 {
        return SDL_GetGamepadID(self.raw)
    }

    // An axis in [-1, 1] (triggers in [0, 1]). SDL's y axes are positive DOWN.
    fn axis(self: &Self, a: i32): f64 {
        let v = SDL_GetGamepadAxis(self.raw, a) as f64
        return v / 32767.0
    }

    fn button(self: &Self, b: i32): bool {
        return SDL_GetGamepadButton(self.raw, b)
    }
}
