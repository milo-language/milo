// 5x7 bitmap font (the same table as neon/font.milo). Each glyph is 35 bits: row r occupies bits
// [r*5 .. r*5+4], bit 0 = leftmost column. Index the table by ASCII code.

pub fn fontTable(): Vec<i64> {
    var t: Vec<i64> = Vec.filled(128, 0)
    t[48] = 0x3A33AE62E // '0'
    t[49] = 0x3884210C4 // '1'
    t[50] = 0x7C444422E // '2'
    t[51] = 0x3A304111F // '3'
    t[52] = 0x211F4A988 // '4'
    t[53] = 0x3A3083C3F // '5'
    t[54] = 0x3A317844C // '6'
    t[55] = 0x08422221F // '7'
    t[56] = 0x3A317462E // '8'
    t[57] = 0x1910F462E // '9'
    t[65] = 0x4631FC62E // 'A'
    t[66] = 0x3E317C62F // 'B'
    t[67] = 0x3A210862E // 'C'
    t[68] = 0x1D318C527 // 'D'
    t[69] = 0x7C217843F // 'E'
    t[70] = 0x04217843F // 'F'
    t[71] = 0x7A31E862E // 'G'
    t[72] = 0x4631FC631 // 'H'
    t[73] = 0x38842108E // 'I'
    t[74] = 0x19284211C // 'J'
    t[75] = 0x452519531 // 'K'
    t[76] = 0x7C2108421 // 'L'
    t[77] = 0x4631AD771 // 'M'
    t[78] = 0x4631CD671 // 'N'
    t[79] = 0x3A318C62E // 'O'
    t[80] = 0x04217C62F // 'P'
    t[81] = 0x59358C62E // 'Q'
    t[82] = 0x45257C62F // 'R'
    t[83] = 0x3E107043E // 'S'
    t[84] = 0x10842109F // 'T'
    t[85] = 0x3A318C631 // 'U'
    t[86] = 0x11518C631 // 'V'
    t[87] = 0x4775AC631 // 'W'
    t[88] = 0x462A22A31 // 'X'
    t[89] = 0x108422A31 // 'Y'
    t[90] = 0x7C222221F // 'Z'
    t[58] = 0x008401080 // ':'
    t[46] = 0x18C000000 // '.'
    t[45] = 0x0000F8000 // '-'
    t[33] = 0x100421084 // '!'
    t[43] = 0x0084F9080 // '+'
    t[120] = 0x022A22A20 // 'x'
    t[47] = 0x044222110 // '/'
    t[37] = 0x674222173 // '%'
    t[40] = 0x208210888 // '('
    t[41] = 0x088842082 // ')'
    t[39] = 0x000000084 // "'"
    t[44] = 0x08C600000 // ','
    return t
}
