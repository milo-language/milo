// The window, the GL 3.3 core context, and one frame of input.
//
// Nothing above this file touches a pointer or an SDL constant: `pollInput`
// snapshots the keyboard and the mouse into a plain struct once per frame, and
// every key is edge-triggered unless holding it down is the point.
//
// The SDL declarations themselves live in the `sdl` package, header-verified and
// written once; what is left here is this game's window setup and control scheme.

from "sdl" import {
    SDL_BUTTON_LMASK, SDL_INIT_VIDEO, SDL_WINDOW_ALLOW_HIGHDPI, SDL_WINDOW_RESIZABLE, SDL_WINDOW_SHOWN
}
from "sdl/glcontext" import {
    SDL_GL_CONTEXT_MAJOR_VERSION, SDL_GL_CONTEXT_MINOR_VERSION, SDL_GL_CONTEXT_PROFILE_CORE, SDL_GL_CONTEXT_PROFILE_MASK, SDL_WINDOW_OPENGL
}
from "../../shared/sdlkit" import {
    Sdl, Window, SdlGlContext, glSetAttribute, glSetSwapInterval, pollEvents, keyboard, mouse
}
from "sdl/keys" import {
    SC_0, SC_1, SC_A, SC_D, SC_DOWN, SC_ESCAPE, SC_F, SC_H, SC_L, SC_LEFT,
    SC_LEFTBRACKET, SC_Q, SC_R, SC_RETURN, SC_RIGHT, SC_RIGHTBRACKET, SC_S,
    SC_SPACE, SC_TAB, SC_UP, SC_W
}

// One frame of input, in window pixels. The 3D scene is projected with the live
// drawable size and the HUD is laid out in the same space, so unlike a
// letterboxed fixed-resolution game there is no second coordinate system here.
pub struct Input {
    quit: bool,
    mx: f64,
    my: f64,
    dragX: f64,
    dragY: f64,
    down: bool,
    clicked: bool, // edge: the frame the button is released without a drag
    dragged: bool, // the pointer moved far enough that this is a drag, not a click
    wheel: f64,
    orbitX: f64, // held arrow keys, for players without a mouse
    orbitY: f64,
    zoom: f64,
    prevWorld: bool,
    nextWorld: bool,
    toggleLevel: bool,
    toggleHelp: bool,
    toggleSpin: bool,
    fullscreen: bool,
    deselect: bool,
    digit: i64, // 1..9 pressed this frame, or 0
    prevHeld: bool,
    nextHeld: bool,
    levelHeld: bool,
    helpHeld: bool,
    spinHeld: bool,
    fullHeld: bool,
    escHeld: bool,
    digitHeld: bool,
    pressX: f64,
    pressY: f64,
}

pub fn inputNew(): Input {
    return Input {
        quit: false, mx: 0.0, my: 0.0, dragX: 0.0, dragY: 0.0,
        down: false, clicked: false, dragged: false, wheel: 0.0,
        orbitX: 0.0, orbitY: 0.0, zoom: 0.0,
        prevWorld: false, nextWorld: false, toggleLevel: false,
        toggleHelp: false, toggleSpin: false, fullscreen: false,
        deselect: false, digit: 0,
        prevHeld: false, nextHeld: false, levelHeld: false, helpHeld: false,
        spinHeld: false, fullHeld: false, escHeld: false, digitHeld: false,
        pressX: 0.0, pressY: 0.0,
    }
}

fn edge(now: bool, held: &mut bool): bool {
    let fired = now && !held
    held = now
    return fired
}

// A press that travels further than this is a camera drag, and releasing it must
// not also count as a click on whatever landmark happens to be under the pointer.
pub let DRAG_SLOP: f64 = 5.0

// `scale` converts SDL's window-space mouse position into drawable pixels; it is
// 2.0 on a Retina display and 1.0 everywhere else. Getting it wrong puts every
// click at half the distance from the top-left that the player aimed at.
pub fn pollInput(inp: &mut Input, scale: f64) {
    inp.wheel = 0.0
    inp.clicked = false
    inp.dragX = 0.0
    inp.dragY = 0.0
    let evs = pollEvents()
    if evs.quit {
        inp.quit = true
    }
    inp.wheel += evs.wheel
    let ms = mouse()
    let buttons = ms.buttons
    let nx = (ms.x as f64) * scale
    let ny = (ms.y as f64) * scale
    let downNow = (buttons & SDL_BUTTON_LMASK) != 0
    if downNow && !inp.down {
        inp.pressX = nx
        inp.pressY = ny
        inp.dragged = false
    }
    if downNow && inp.down {
        inp.dragX = nx - inp.mx
        inp.dragY = ny - inp.my
        let tx = nx - inp.pressX
        let ty = ny - inp.pressY
        if tx * tx + ty * ty > DRAG_SLOP * DRAG_SLOP {
            inp.dragged = true
        }
    }
    if !downNow && inp.down && !inp.dragged {
        inp.clicked = true
    }
    inp.down = downNow
    inp.mx = nx
    inp.my = ny

    let ks = keyboard()
    inp.deselect = edge(ks.down(SC_ESCAPE), &mut inp.escHeld)
    if ks.down(SC_Q) {
        inp.quit = true
    }
    inp.prevWorld = edge(ks.down(SC_LEFTBRACKET), &mut inp.prevHeld)
    inp.nextWorld = edge(ks.down(SC_RIGHTBRACKET), &mut inp.nextHeld)
    inp.toggleLevel = edge(ks.down(SC_L), &mut inp.levelHeld)
    inp.toggleHelp = edge(ks.down(SC_H), &mut inp.helpHeld)
    inp.toggleSpin = edge(ks.down(SC_SPACE), &mut inp.spinHeld)
    inp.fullscreen = edge(ks.down(SC_F), &mut inp.fullHeld)

    inp.orbitX = 0.0
    inp.orbitY = 0.0
    inp.zoom = 0.0
    if ks.down(SC_LEFT) || ks.down(SC_A) {
        inp.orbitX -= 1.0
    }
    if ks.down(SC_RIGHT) || ks.down(SC_D) {
        inp.orbitX += 1.0
    }
    if ks.down(SC_UP) {
        inp.orbitY -= 1.0
    }
    if ks.down(SC_DOWN) {
        inp.orbitY += 1.0
    }
    if ks.down(SC_W) {
        inp.zoom -= 1.0
    }
    if ks.down(SC_S) {
        inp.zoom += 1.0
    }

    // The number row picks a world directly. One `digitHeld` for all ten
    // keys is deliberate: pressing two at once should pick one world, not
    // race between them.
    var pressed = 0
    var i = 0
    while i < 9 {
        if ks.down(SC_1 + i) {
            pressed = i + 1
        }
        i += 1
    }
    if ks.down(SC_0) {
        pressed = 10
    }
    inp.digit = 0
    if edge(pressed != 0, &mut inp.digitHeld) {
        inp.digit = pressed
    }
}

// The window and its GL 3.3 core context. An Err means this machine cannot run the
// game and the caller should say so and stop.
pub struct Host {
    // Field order is teardown order reversed: the context goes first, then the
    // window, then SDL itself.
    _sdl: Sdl,
    win: Window,
    _ctx: SdlGlContext,
}

pub fn hostNew(title: &string, w: i64, h: i64): Result<Host, string> {
    let sdl = Sdl.init(SDL_INIT_VIDEO)?
    // Set before the window exists: SDL reads these when it picks the pixel format
    // and ignores them afterwards.
    let _ = glSetAttribute(SDL_GL_CONTEXT_MAJOR_VERSION, 3)
    let _ = glSetAttribute(SDL_GL_CONTEXT_MINOR_VERSION, 3)
    let _ = glSetAttribute(SDL_GL_CONTEXT_PROFILE_MASK, SDL_GL_CONTEXT_PROFILE_CORE)
    let win = Window.create(title, w, h, SDL_WINDOW_SHOWN | SDL_WINDOW_RESIZABLE | SDL_WINDOW_OPENGL | SDL_WINDOW_ALLOW_HIGHDPI)?
    let ctx = match SdlGlContext.create(win) {
        Ok(c) => c,
        Err(e) => {
            return Result.Err("no GL 3.3 core context: " + e)
        }
    }
    let _ = glSetSwapInterval(1)
    return Result.Ok(Host { _sdl: sdl, win: win, _ctx: ctx })
}

pub struct Size {
    w: i64,
    h: i64,
}

// The drawable size in real pixels, which on a Retina display is twice the
// window size the user dragged. Every layout in the game is expressed in these
// pixels, so the HUD is crisp instead of upscaled — which is also why
// `pollInput` has to be told the window-to-drawable ratio.
pub fn drawableSize(win: &Window): Size {
    let d = win.drawableSize()
    return Size {
        w: d.w, h: d.h
    }
}

// Drawable pixels per window point. Asked of SDL rather than assumed to be 2.0,
// because it is 1.0 on most Linux setups and 1.5 or 3.0 on some displays.
pub fn pixelScale(win: &Window): f64 {
    let points = win.size()
    if points.w <= 0 {
        return 1.0
    }
    let d = win.drawableSize()
    return (d.w as f64) / (points.w as f64)
}
