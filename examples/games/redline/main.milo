// REDLINE, a neon street race.
//
//   milo run examples/games/redline/main.milo --release
//
// Arrows or WASD drive, SHIFT is nitrous, SPACE is the handbrake, F is
// fullscreen and ESC quits.
//
// `--shot out.png` renders one frame to a file and exits, which is how every
// change to the lighting in this game was actually checked. `--s` puts the car
// somewhere else on the lap for that capture, `--speed` gives it speed so the
// camera sits where it would sit at pace, and `--warmup` runs the world forward
// first.

from "std/math" import {
    Math
}
from "std/args" import {
    args
}
from "std/fs" import {
    writeFile
}
from "std/png" import {
    encodePng
}
from "gl" import {
    GlContext, Texture2D, Wrap, readPixelsRgba8
}
from "sdl" import {
    SDL_CreateWindow, SDL_DestroyWindow, SDL_GetError, SDL_GetKeyboardState,
    SDL_GetTicks, SDL_Init, SDL_PollEvent, SDL_Quit, SDL_SetWindowFullscreen,
    SDL_ShowCursor, SDL_INIT_VIDEO, SDL_QUIT, SDL_WINDOWPOS_CENTERED,
    SDL_WINDOW_ALLOW_HIGHDPI, SDL_WINDOW_FULLSCREEN_DESKTOP, SDL_WINDOW_HIDDEN,
    SDL_WINDOW_RESIZABLE, SDL_WINDOW_SHOWN
}
from "sdl/glcontext" import {
    SDL_GL_CreateContext, SDL_GL_DeleteContext, SDL_GL_GetDrawableSize,
    SDL_GL_SetAttribute, SDL_GL_SetSwapInterval, SDL_GL_SwapWindow,
    SDL_GL_CONTEXT_MAJOR_VERSION, SDL_GL_CONTEXT_MINOR_VERSION,
    SDL_GL_CONTEXT_PROFILE_CORE, SDL_GL_CONTEXT_PROFILE_MASK, SDL_GL_DEPTH_SIZE,
    SDL_WINDOW_OPENGL
}
from "sdl/keys" import {
    SC_A, SC_D, SC_DOWN, SC_ESCAPE, SC_F, SC_LEFT, SC_LSHIFT, SC_RIGHT, SC_S,
    SC_SPACE, SC_UP, SC_W
}
from "./camera" import {
    Chase, newChase
}
from "./car" import {
    Car, buildCarModel, flameMaterial, glassMaterial, lampMaterial, newCar,
    paintMaterial, trimMaterial, wheelMaterial
}
from "./hud" import {
    ATLAS, Hud, buildAtlas, newHud
}
from "./mat4" import {
    identity, invertViewProj, multiply, scaleXyz, translation
}
from "./rain" import {
    buildRain, rainMaterial, sprayMaterial, sprayMatrix, tileMatrix
}
from "./render" import {
    newGfx, sceneAttrs
}
from "./sky" import {
    buildSky
}
from "./textures" import {
    TEX_SIZE, makeTextures
}
from "./track" import {
    HALF_WIDTH, WALL, buildTrack
}
from "./vec3" import {
    v3
}
from "./world" import {
    B_PAD, BUCKETS, PAD_FLOATS, buildWorld
}

fn argValue(name: &string, fallback: &string): string {
    let a = args()
    for i in 0..a.len {
        if a[i] == name && i + 1 < a.len {
            return a[i + 1].clone()
        }
    }
    return fallback.clone()
}

fn argPresent(name: &string): bool {
    let a = args()
    for i in 0..a.len {
        if a[i] == name {
            return true
        }
    }
    return false
}

// GL hands back rows bottom-up and ABGR; a PNG wants top-down RGB.
fn toRgb(px: &Vec<u32>, w: i64, h: i64): string {
    var out = ""
    for y in 0..h {
        let row = (h - 1 - y) * w
        for x in 0..w {
            let p = px[row + x]
            out.push((p & 0xFF) as u8)
            out.push(((p >> 8) & 0xFF) as u8)
            out.push(((p >> 16) & 0xFF) as u8)
        }
    }
    return out
}

// Metres per second to the number on the dial.
fn mph(v: f64): i64 {
    return (Math.abs(v) * 2.23694) as i64
}

pub fn main(): i32 {
    let shot = argValue("--shot", "")
    let headless = shot.len > 0
    var winW: i64 = 1440
    var winH: i64 = 900
    let skyLight = argValue("--sky", "1").parseF64() ?? 1.0
    let scalePct = argValue("--scale", "100").parseF64() ?? 100.0
    let skipBucket = argValue("--skip", "-1").parseInt() ?? -1

    if SDL_Init(SDL_INIT_VIDEO) != 0 {
        print("SDL_Init failed")
        return 1
    }
    var win: *u8 = 0 as *u8
    var ctx: *u8 = 0 as *u8
    unsafe {
        let _ = SDL_GL_SetAttribute(SDL_GL_CONTEXT_MAJOR_VERSION, 3)
        let _ = SDL_GL_SetAttribute(SDL_GL_CONTEXT_MINOR_VERSION, 3)
        let _ = SDL_GL_SetAttribute(SDL_GL_CONTEXT_PROFILE_MASK, SDL_GL_CONTEXT_PROFILE_CORE)
        let _ = SDL_GL_SetAttribute(SDL_GL_DEPTH_SIZE, 24)
        var flags = SDL_WINDOW_OPENGL | SDL_WINDOW_ALLOW_HIGHDPI
        if headless {
            flags = flags | SDL_WINDOW_HIDDEN
        } else {
            flags = flags | SDL_WINDOW_SHOWN | SDL_WINDOW_RESIZABLE
        }
        win = SDL_CreateWindow("REDLINE", SDL_WINDOWPOS_CENTERED, SDL_WINDOWPOS_CENTERED, winW as i32, winH as i32, flags)
        if (win as i64) == 0 {
            print("window: " + _cstrToString(SDL_GetError()))
            return 2
        }
        ctx = SDL_GL_CreateContext(win)
        if (ctx as i64) == 0 {
            print("no GL 3.3 core context: " + _cstrToString(SDL_GetError()))
            return 3
        }
        let _ = SDL_GL_SetSwapInterval(if headless {
            0
        } else {
            1
        }
        )
        if !headless {
            let _ = SDL_ShowCursor(0)
        }
    }

    var dw: i32 = 0
    var dh: i32 = 0
    unsafe {
        SDL_GL_GetDrawableSize(win, dw.addrOf(), dh.addrOf())
    }
    if headless {
        dw = winW as i32
        dh = winH as i32
    }
    var rw = ((dw as f64) * scalePct / 100.0) as i64
    var rh = ((dh as f64) * scalePct / 100.0) as i64
    // Every pass is per-pixel and a retina panel hands back four times the
    // pixels of the display it is showing, so the scene has its own resolution
    // cap; the HUD is drawn afterwards at the real size.
    let cap = 4600000.0
    if ((rw * rh) as f64) > cap {
        let k = Math.sqrt(cap / ((rw * rh) as f64))
        rw = ((rw as f64) * k) as i64
        rh = ((rh as f64) * k) as i64
    }

    var gl = GlContext.new()
    let sky = buildSky(skyLight)
    var gfx = match newGfx(gl, rw, rh, sky, buildAtlas(), ATLAS) {
        Result.Ok(g) => g
        Result.Err(e) => {
            print("gfx: " + e)
            return 4
        }
    }
    // Albedo and surface for each material, uploaded in the order textures.milo
    // declares them; the TEX_* constants index this list, so the order is a
    // contract.
    let texes = makeTextures()
    for t in texes {
        let a = Texture2D.rgba8(gl, TEX_SIZE, TEX_SIZE, t.albedo.clone(), true)
        // REPEAT, not the default clamp. Every one of these is tiled across
        // hundreds of metres of road, and on clamp only the first repeat has any
        // content at all.
        a.setWrap(Wrap.Repeat)
        a.generateMipmaps()
        a.setAnisotropy(16.0)
        let s = Texture2D.rgba8(gl, TEX_SIZE, TEX_SIZE, t.surf.clone(), true)
        s.setWrap(Wrap.Repeat)
        s.generateMipmaps()
        s.setAnisotropy(16.0)
        let _ = gfx.addTexture(a)
        let _ = gfx.addTexture(s)
    }
    gfx.debug = argValue("--debug", "0").parseF64() ?? 0.0

    let track = buildTrack()
    if !track.validate() {
        print("track failed validation, see above")
        return 5
    }
    print($"circuit: {(track.length as i64)} m over {track.n} samples")

    var world = buildWorld(gl, track)
    var rain = buildRain(gl)
    // How hard it is raining, 0 to 1. A constant for now: the wet road, the
    // reflections and the spray are all keyed off it, so turning it down is the
    // one knob that makes the night dry again.
    let rainAmount = argValue("--rain", "1").parseF64() ?? 1.0
    let carModel = buildCarModel(gl)
    let trimMat = trimMaterial()
    let glassMat = glassMaterial()
    let wheelMat = wheelMaterial()
    let lampMat = lampMaterial()

    var player = newCar(v3(0.95, 0.16, 0.10))
    let playerPaint = paintMaterial(0.95, 0.16, 0.10)
    let startS = argValue("--s", "0").parseF64() ?? 0.0
    player.placeOn(track, startS, argValue("--lat", "0").parseF64() ?? 0.0)
    // A capture wants the camera where it sits at pace, not where it sits
    // parked, and the two are several metres apart.
    let poseSpeed = argValue("--speed", "0").parseF64() ?? 0.0
    let poseSteer = argValue("--steer", "0").parseF64() ?? 0.0
    if poseSpeed > 0.0 {
        player.vel = player.forward().scale(poseSpeed)
    }

    var cam = newChase()
    var hud = newHud()

    var quit = false
    var ev: [u8; 64] = [0; 64]
    var last = SDL_GetTicks()
    var prevF = false
    var fullscreen = false
    var raceTime = 0.0
    // Stops one pad firing on several consecutive frames while the car is
    // still on top of it.
    var padCooldown = 0.0
    var warmup = argValue("--warmup", "0").parseInt() ?? 0
    let poseBoost = argPresent("--boost")
    let orbitDeg = argValue("--orbit", "-999").parseF64() ?? -999.0
    let orbitElev = argValue("--elev", "12").parseF64() ?? 12.0
    let orbitDist = argValue("--dist", "6.5").parseF64() ?? 6.5
    // Which parts of the car to draw, as a bit mask: 1 body, 2 trim, 4 glass,
    // 8 wheels, 16 lamps. Only ever used from a capture, and the only way to
    // tell a badly shaped shell from a shell hidden behind its own trim.
    let parts = argValue("--parts", "31").parseInt() ?? 31

    while !quit {
        let now = SDL_GetTicks()
        var dt = ((now - last) as f64) / 1000.0
        last = now
        if dt > 0.05 {
            dt = 0.05
        }
        if headless {
            dt = 0.016
        }
        gfx.time = gfx.time + dt

        var throttle = 0.0
        var brake = 0.0
        var steer = 0.0
        var nitro = false
        var handbrake = false
        if !headless {
            unsafe {
                while SDL_PollEvent(ev) != 0 {
                    let evType: u32 = (ev[0] as u32) | ((ev[1] as u32) << 8) | ((ev[2] as u32) << 16) | ((ev[3] as u32) << 24)
                    if evType == SDL_QUIT {
                        quit = true
                    }
                }
                let keys = SDL_GetKeyboardState(0 as *i32)
                if keys[SC_ESCAPE] != 0 {
                    quit = true
                }
                let fDown = keys[SC_F] != 0
                if fDown && !prevF {
                    fullscreen = !fullscreen
                    let _ = SDL_SetWindowFullscreen(win, if fullscreen {
                        SDL_WINDOW_FULLSCREEN_DESKTOP
                    } else {
                        0
                    }
                    )
                }
                prevF = fDown
                if keys[SC_UP] != 0 || keys[SC_W] != 0 {
                    throttle = 1.0
                }
                if keys[SC_DOWN] != 0 || keys[SC_S] != 0 {
                    brake = 1.0
                }
                if keys[SC_LEFT] != 0 || keys[SC_A] != 0 {
                    steer = steer - 1.0
                }
                if keys[SC_RIGHT] != 0 || keys[SC_D] != 0 {
                    steer = steer + 1.0
                }
                // Space is the turbo, because it is the button a player's thumb
                // is already on, and the one they will hit in a panic.
                nitro = keys[SC_SPACE] != 0
                handbrake = keys[SC_LSHIFT] != 0
            }
        } else {
            // A capture of a parked car on an empty grid is a capture of a car
            // park, so the headless path drives. `--steer` holds a steering
            // input, which is the only way to check on a still that the car
            // turns the way the arrow key asked and leans out of the corner.
            throttle = 1.0
            steer = poseSteer
            nitro = poseBoost
        }

        // ── simulate ──────────────────────────────────────────────────────────
        player.drive(dt, throttle, brake, steer, handbrake, nitro, track)
        raceTime = raceTime + dt
        if player.scraping {
            cam.kick(0.55)
        } else if player.offTrack {
            cam.kick(dt * 1.4)
        }
        cam.follow(player, dt)
        // Boost pads. Tested against the car's own (s, lateral) rather than in
        // world space: the pads were placed in those coordinates, and comparing
        // arc lengths is one subtract where a world-space overlap test is a
        // search. The wrap guard matters because a pad a few metres past the
        // line is nearly a full lap away in raw `s`.
        var pi = 0
        while pi + PAD_FLOATS <= world.pads.len {
            var ds = player.s - world.pads[pi]
            if ds > track.length * 0.5 {
                ds = ds - track.length
            } else if ds < -track.length * 0.5 {
                ds = ds + track.length
            }
            if Math.abs(ds) < world.pads[pi + 2] && Math.abs(player.lateral - world.pads[pi + 1]) < world.pads[pi + 3] {
                if padCooldown <= 0.0 {
                    // No screen flash. A white frame is the arcade reflex and it
                    // is the wrong tool here: it says "something happened" for
                    // one sixtieth of a second and then the road looks exactly
                    // as it did before. What the pad is worth has to be visible
                    // for as long as the pad is worth it, which is what the
                    // streak and the lens do below.
                    player.padSurge()
                    cam.kick(0.30)
                    padCooldown = 0.40
                }
            }
            pi = pi + PAD_FLOATS
        }
        padCooldown = Math.maxF64(0.0, padCooldown - dt)

        // The pads pulse. One sine on the material's emissive is the whole
        // animation: the geometry is static and the tint in it already carries
        // the per-chevron brightness ramp.
        let pulse = 0.72 + 0.46 * Math.sin(gfx.time * 7.0)
        world.mats[B_PAD].emissive = v3(pulse, pulse, pulse)

        // The frame-streak amount. It starts at two thirds of top speed rather
        // than at zero, because a blur that is always on is not a speed cue, it
        // is a dirty lens: what the eye reads is the frame CHANGING, so the
        // effect has to be absent for most of the speed range and arrive
        // suddenly near the top of it. The bottle then doubles it.
        let sp01 = Math.clampF64(Math.abs(player.forwardSpeed()) / 95.0, 0.0, 1.4)
        let rushWant = Math.maxF64(0.0, (sp01 - 0.62) / 0.38) + 1.15 * player.boost + 0.85 * player.padLevel()
        gfx.rush = gfx.rush + (Math.minF64(rushWant, 1.7) - gfx.rush) * (1.0 - Math.exp(-7.0 * dt))
        // A capture-only orbit, for looking at the car itself rather than at the
        // race: the chase camera is the wrong tool for judging bodywork.
        if orbitDeg > -900.0 {
            let a = orbitDeg * Math.pi() / 180.0
            let el = orbitElev * Math.pi() / 180.0
            let d = orbitDist
            cam.eye = player.pos + v3(Math.sin(a) * Math.cos(el) * d, Math.sin(el) * d + 0.7, Math.cos(a) * Math.cos(el) * d)
            cam.target = player.pos + v3(0.0, 0.62, 0.0)
            cam.shake = 0.0
        }

        // ── draw ──────────────────────────────────────────────────────────────
        unsafe {
            SDL_GL_GetDrawableSize(win, dw.addrOf(), dh.addrOf())
        }
        if headless {
            dw = winW as i32
            dh = winH as i32
        }

        // The circuit has about a hundred lights and the shader takes sixteen,
        // so they are chosen every frame by distance. Rebuilt rather than
        // patched: a stale light left switched on is the kind of bug that only
        // ever shows up as "the road is green now".
        gfx.lights.clear()
        let eye = cam.shakenEye()
        world.nearestLights(gfx.lights, eye, 14)
        // The player's own lamps, which are the only lights that move.
        gfx.addLight(player.nose(), 5.5, 5.2, 4.4, 26.0)
        gfx.addLight(player.tail(), 3.4, 0.30, 0.18, 9.0)
        if player.boost > 0.02 {
            gfx.addLight(player.tail(), 9.0 * player.boost, 3.4 * player.boost, 0.7 * player.boost, 16.0)
        }

        let aspect = (rw as f64) / (rh as f64)
        // The circuit is already in world space. Handing it the car's matrix is
        // an easy mistake to make and a strange one to read back: the whole city
        // rotates with the steering and the road is nowhere in frame.
        let worldModel = identity()
        let model = player.modelMatrix()

        // Depth and normals first: the scene pass samples the AO they produce.
        gfx.prepassBegin(cam.viewM(), cam.projM(aspect))
        for i in 0..BUCKETS {
            if i == skipBucket {
                continue
            }
            gfx.prepassDraw(world.meshes[i], worldModel)
        }
        gfx.prepassDraw(carModel.body, model)
        gfx.prepassDraw(carModel.trim, model)
        gfx.prepassDraw(carModel.glass, model)
        for w in 0..4 {
            gfx.prepassDraw(carModel.wheel, player.wheelMatrix(w))
        }
        gfx.aoResolve(cam.tanHalfX(), cam.tanHalfX() / aspect)

        // Centred ahead of the car rather than on it: the shadow map covers a
        // fixed box, and putting the car in the middle of it wastes half the
        // resolution on road the player has already driven over.
        let fwd = player.forward()
        let shadowAt = player.pos + fwd.scale(18.0)
        gfx.shadowBegin(v3(shadowAt.x, 0.0, shadowAt.z), 52.0, 320.0)
        for i in 0..BUCKETS {
            gfx.shadowDraw(world.meshes[i], worldModel)
        }
        gfx.shadowDraw(carModel.body, model)
        gfx.shadowDraw(carModel.trim, model)
        for w in 0..4 {
            gfx.shadowDraw(carModel.wheel, player.wheelMatrix(w))
        }

        let vp = cam.viewProj(aspect)
        let inv = invertViewProj(vp)
        gfx.sceneBegin(vp, inv, eye)
        for i in 0..BUCKETS {
            if i == skipBucket {
                continue
            }
            gfx.sceneDraw(world.meshes[i], worldModel, world.mats[i])
        }
        if (parts & 1) != 0 {
            gfx.sceneDraw(carModel.body, model, playerPaint)
        }
        if (parts & 2) != 0 {
            gfx.sceneDraw(carModel.trim, model, trimMat)
        }
        if (parts & 16) != 0 {
            gfx.sceneDraw(carModel.lamps, model, lampMat)
        }
        if (parts & 4) != 0 {
            gfx.sceneDraw(carModel.glass, model, glassMat)
        }
        if (parts & 8) != 0 {
            for w in 0..4 {
                gfx.sceneDraw(carModel.wheel, player.wheelMatrix(w), wheelMat)
            }
        }
        // Rain, and the water the back tyres throw out of it. Both are drawn
        // last and blended, after every opaque surface has laid down depth, so
        // the curtain is occluded by the city rather than painted over it.
        if rainAmount > 0.0 {
            gfx.sceneBlendOn()
            let rainM = rainMaterial(rainAmount * 1.05)
            // Three cells on a side, not two: two only ever guarantees rain on
            // one side of the camera. See tileMatrix.
            var ti = 0
            while ti < 3 {
                var tj = 0
                while tj < 3 {
                    var tl = 0
                    while tl < 3 {
                        gfx.sceneDraw(rain.tile, tileMatrix(eye, player.vel, gfx.time, ti, tj, tl), rainM)
                        tl = tl + 1
                    }
                    tj = tj + 1
                }
                ti = ti + 1
            }
            // Spray needs the car to actually be rolling. Below walking pace a
            // stationary rooster tail reads as the car leaking.
            let wet = Math.clampF64((Math.abs(player.forwardSpeed()) - 6.0) / 60.0, 0.0, 1.0)
            if wet > 0.02 {
                let sprayM = sprayMaterial(rainAmount * wet * 0.55)
                gfx.sceneDraw(rain.spray, sprayMatrix(model, -0.85, -1.22, wet), sprayM)
                gfx.sceneDraw(rain.spray, sprayMatrix(model, 0.85, -1.22, wet), sprayM)
                gfx.sceneDraw(rain.spray, sprayMatrix(model, -0.85, 1.22, wet * 0.55), sprayM)
                gfx.sceneDraw(rain.spray, sprayMatrix(model, 0.85, 1.22, wet * 0.55), sprayM)
            }
            gfx.sceneBlendOff()
        }

        // The plume. Stretched along its own axis by the boost and flickered by
        // brightness, which is cheaper and steadier than rebuilding it.
        if player.boost > 0.02 {
            let flick = 0.80 + 0.20 * Math.sin(gfx.time * 47.0) + 0.12 * Math.sin(gfx.time * 111.0)
            let len = (0.45 + 0.95 * player.boost) * flick
            let flameM = multiply(model, multiply(translation(v3(0.0, 0.44, -2.44)), scaleXyz(1.0, 1.0, len)))
            gfx.sceneDraw(carModel.flame, flameM, flameMaterial(player.boost * flick))
        }

        gfx.present(dw as i64, dh as i64)

        hud.clear()
        drawHud(hud, dw as f64, dh as f64, player, raceTime, track.length, 0.5 + 0.5 * Math.sin(gfx.time * 6.0))
        gfx.drawHud(hud.verts, dw as i64, dh as i64)

        if headless && warmup > 0 {
            warmup = warmup - 1
            SDL_GL_SwapWindow(win)
            continue
        }
        if headless {
            let px = readPixelsRgba8(dw as i64, dh as i64)
            match encodePng(toRgb(px, dw as i64, dh as i64), dw as i64, dh as i64, 3) {
                Result.Ok(bytes) => {
                    match writeFile(shot, bytes) {
                        Result.Ok(_v) => {
                            print($"wrote {shot}")
                        }
                        Result.Err(e) => {
                            print($"write: {e}")
                        }
                    }
                }
                Result.Err(e) => {
                    print("png: " + e)
                }
            }
            quit = true
        }

        SDL_GL_SwapWindow(win)
    }

    carModel.free(gl)
    world.free(gl)
    gfx.free(gl)
    gl.free()
    SDL_GL_DeleteContext(ctx)
    SDL_DestroyWindow(win)
    SDL_Quit()
    return 0
}

// Two digits, zero padded. A clock that reads 0:5.7 is a clock nobody can read
// at a glance, and at 180 mph a glance is all it gets.
fn pad2(n: i64): string {
    if n < 10 {
        return $"0{n}"
    }
    return $"{n}"
}

// The dial sweeps from lower left, over the top, to lower right: 240 degrees
// with the gap at the bottom, which is where every rev counter has put it since
// they were mechanical.
let DIAL_A0: f64 = 2.6179938779914944

let DIAL_SWEEP: f64 = 4.188790204786391

fn drawHud(hud: &mut Hud, dw: f64, dh: f64, car: &Car, raceTime: f64, lapLength: f64, boostFlash: f64) {
    let s = Math.maxF64(dh / 900.0, 0.6)
    let speed = mph(car.forwardSpeed())

    // ── the dial, bottom right ────────────────────────────────────────────────
    //
    // The speed is the only reading a driver uses moment to moment, so it is the
    // biggest number on the screen and it sits inside a gauge rather than in a
    // box: an arc that fills is readable out of the corner of an eye at a
    // hundred and eighty, and four digits of text are not.
    let rad = 118.0 * s
    let cx = dw - rad - 108.0 * s
    let cy = dh - rad - 34.0 * s
    let frac = Math.clampF64((speed as f64) / 220.0, 0.0, 1.0)

    // Body, bezel, and the dark channel the arc runs in.
    hud.ring(cx, cy, 0.0, rad, 0.0, 2.0 * Math.pi(), 44, 0.05, 0.05, 0.09, 0.88)
    hud.ring(cx, cy, rad - 7.0 * s, rad, 0.0, 2.0 * Math.pi(), 44, 0.55, 0.57, 0.66, 0.95)
    hud.ring(cx, cy, rad - 30.0 * s, rad - 9.0 * s, DIAL_A0, DIAL_A0 + DIAL_SWEEP, 40, 0.10, 0.10, 0.16, 0.95)

    // The arc itself, coloured along its length: blue at the bottom of the
    // range, magenta through the middle, red at the top. Drawn segment by
    // segment because the colour has to be a function of the reading, not of
    // the fill.
    let segs = 40
    for i in 0..segs {
        let t0 = (i as f64) / (segs as f64)
        if t0 > frac {
            continue
        }
        let a0 = DIAL_A0 + DIAL_SWEEP * t0
        let a1 = DIAL_A0 + DIAL_SWEEP * ((i + 1) as f64) / (segs as f64)
        var r = 0.30 + 1.30 * t0
        var g = 0.55 - 0.45 * t0
        var b = 1.30 - 0.55 * t0
        if t0 > 0.82 {
            r = 1.60
            g = 0.16
            b = 0.14
        }
        hud.ring(cx, cy, rad - 29.0 * s, rad - 10.0 * s, a0, a1, 2, r, g, b, 0.98)
    }

    // Ticks. Every eighth is long, the rest short, and the last three are red:
    // a gauge with no marks on it is a progress bar.
    for i in 0..25 {
        let t = (i as f64) / 24.0
        let a = DIAL_A0 + DIAL_SWEEP * t
        let major = i % 3 == 0
        let len = if major {
            17.0 * s
        } else {
            9.0 * s
        }
        var r = 0.92
        var g = 0.94
        var b = 1.0
        if t > 0.86 {
            r = 1.0
            g = 0.30
            b = 0.24
        }
        hud.spoke(cx, cy, rad - 30.0 * s - len, rad - 32.0 * s, a, if major {
            2.4 * s
        } else {
            1.4 * s
        }
        , r, g, b, 0.85)
    }

    // The needle, and the hub it turns on.
    let na = DIAL_A0 + DIAL_SWEEP * frac
    hud.spoke(cx, cy, -10.0 * s, rad - 34.0 * s, na, 3.4 * s, 1.0, 0.22, 0.16, 0.95)
    hud.ring(cx, cy, 0.0, 8.0 * s, 0.0, 2.0 * Math.pi(), 14, 0.85, 0.87, 0.94, 1.0)

    // The reading, in the middle, in the yellow every arcade cabinet has used
    // for the number that matters.
    hud.textCentred($"{speed}", cx, cy - 46.0 * s, 5.0 * s, 1.0, 0.86, 0.22, 1.0)
    hud.textCentred("MPH", cx, cy + 20.0 * s, 1.7 * s, 0.86, 0.88, 0.95, 0.9)

    // The gear, in its own box on the outside of the dial. Six speeds spread
    // over the range, so the box changes often enough to be worth looking at.
    let gear = Math.clampI64(1 + ((frac * 6.4) as i64), 1, 6)
    let gx = cx + rad - 26.0 * s
    let gy = cy - 8.0 * s
    hud.slab(gx, gy, 62.0 * s, 62.0 * s, 8.0 * s, 0.06, 0.06, 0.10, 0.92)
    hud.slab(gx, gy, 62.0 * s, 5.0 * s, 8.0 * s, 0.95, 0.24, 0.18, 0.95)
    hud.textCentred($"{gear}", gx + 33.0 * s, gy + 12.0 * s, 3.4 * s, 1.0, 1.0, 1.0, 1.0)

    // ── the bottle, bottom left ───────────────────────────────────────────────
    //
    // Five segments rather than a smooth bar: what a player needs to know is how
    // many more shots are in it, and a continuous bar answers a question nobody
    // is asking.
    let bw = 62.0 * s
    let bh = 168.0 * s
    let bx = 44.0 * s
    let by = dh - bh - 46.0 * s
    hud.rect(bx - 5.0 * s, by - 22.0 * s, bw + 10.0 * s, bh + 30.0 * s, 0.05, 0.05, 0.09, 0.86)
    // The cap and neck, so it reads as a bottle and not as a battery.
    hud.rect(bx + bw * 0.30, by - 20.0 * s, bw * 0.40, 12.0 * s, 0.55, 0.58, 0.66, 0.95)
    let cells = 5
    for i in 0..cells {
        let t0 = (i as f64) / (cells as f64)
        let y = by + bh - (t0 + 1.0 / (cells as f64)) * bh + 3.0 * s
        let h = bh / (cells as f64) - 6.0 * s
        let full = car.tank > t0 + 0.02
        if full {
            // Lit segments run cyan to white as the bottle fills, and the top
            // one pulses when it is ready, which is the whole notification.
            let k = 0.55 + 0.45 * t0
            var r = 0.30 * k
            var g = 1.5 * k
            var bl = 1.9 * k
            if car.tank > 0.985 {
                r = r + 0.5 * boostFlash
                g = g + 0.5 * boostFlash
                bl = bl + 0.4 * boostFlash
            }
            hud.rect(bx, y, bw, h, r, g, bl, 0.97)
        } else {
            hud.rect(bx, y, bw, h, 0.12, 0.14, 0.20, 0.80)
        }
    }
    hud.textCentred("TURBO", bx + bw * 0.5, dh - 40.0 * s, 1.5 * s, 0.60, 0.92, 1.0, 0.9)
    hud.textCentred("SPACE", bx + bw * 0.5, dh - 22.0 * s, 1.2 * s, 0.70, 0.75, 0.85, 0.7)

    // ── the clock, top right ──────────────────────────────────────────────────
    let secs = raceTime as i64
    let cs = ((raceTime - (secs as f64)) * 100.0) as i64
    let tw = 250.0 * s
    let tx = dw - tw - 34.0 * s
    hud.slab(tx, 26.0 * s, tw, 34.0 * s, 10.0 * s, 0.72, 0.10, 0.10, 0.92)
    hud.slab(tx, 60.0 * s, tw, 52.0 * s, 6.0 * s, 0.05, 0.05, 0.09, 0.90)
    let _ = hud.text("TIME", tx + 22.0 * s, 32.0 * s, 1.7 * s, 1.0, 0.94, 0.90, 0.95)
    hud.textCentred($"{secs / 60}:{pad2(secs % 60)}.{pad2(cs)}", tx + tw * 0.5, 68.0 * s, 2.9 * s, 1.0, 0.96, 0.80, 1.0)
    // The three slashes an arcade racer always puts beside its clock.
    for i in 0..3 {
        hud.slab(tx - 22.0 * s + (i as f64) * 9.0 * s, 26.0 * s, 5.0 * s, 34.0 * s, 10.0 * s, 0.95, 0.20, 0.16, 0.95)
    }

    // ── the lap, top left ─────────────────────────────────────────────────────
    hud.slab(34.0 * s, 26.0 * s, 210.0 * s, 30.0 * s, 8.0 * s, 0.05, 0.05, 0.09, 0.90)
    let _ = hud.text($"LAP {car.lap + 1}", 52.0 * s, 30.0 * s, 2.0 * s, 1.0, 0.90, 0.30, 1.0)
    // How far round the lap, as a bar under it. Standing in for a minimap until
    // there is a field of cars to put on one.
    let pw = 210.0 * s
    hud.rect(34.0 * s, 66.0 * s, pw, 9.0 * s, 0.06, 0.05, 0.10, 0.85)
    let lapFrac = Math.clampF64(car.s / lapLength, 0.0, 1.0)
    hud.rect(34.0 * s, 66.0 * s, pw * lapFrac, 9.0 * s, 0.95, 0.35, 0.85, 0.95)

    // Speed lines, on the boost only. They are drawn from the middle of the
    // screen outward and start well outside the car, so they read as air going
    // past rather than as scratches on the lens.
    if car.boost > 0.05 {
        let mx = dw * 0.5
        let my = dh * 0.52
        let diag = Math.sqrt(dw * dw + dh * dh) * 0.5
        for i in 0..26 {
            let a = 2.0 * Math.pi() * (((i * 37) % 26) as f64) / 26.0 + boostFlash * 0.2
            let jitter = 0.66 + 0.30 * Math.abs(Math.sin((i as f64) * 12.9898))
            let r0 = diag * jitter
            let r1 = r0 + diag * (0.05 + 0.09 * car.boost)
            hud.spoke(mx, my, r0, r1, a, 1.6 * s, 1.0, 0.95, 0.88, 0.20 * car.boost)
        }
    }

    // Off the road, say so. The grip change is felt but a driver at speed needs
    // to be told why.
    if car.offTrack {
        hud.textCentred("OFF TRACK", dw * 0.5, dh * 0.62, 2.6 * s, 1.0, 0.55, 0.20, 0.85)
    }
    let _ = HALF_WIDTH
}
