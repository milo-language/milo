// Everything that is not a car: the road surface, what edges it, what lights it,
// and the city it runs through.
//
// It is all built once, on the CPU, into nine meshes split by material. Nine
// draw calls put the entire circuit on screen, and the split is by material
// rather than by object because that is the only thing the GPU cares about: a
// barrier and a building are the same draw if they are both concrete.
//
// **The neon is one bucket.** Its material has a near-black albedo and a white
// emissive, and the shader multiplies emissive by the vertex tint, so a single
// draw paints every tube, every window, every pole head and every gantry strip
// in whatever colour and at whatever brightness the geometry asked for. Adding a
// new glowing thing anywhere in this file costs nothing.
//
// **The lights are a pool, not a list.** There are about a hundred places in the
// circuit that should cast real light and the shader takes sixteen. So every
// candidate goes into `lightPool` at build time and the frame loop picks the
// nearest few to the camera. Picking at build time instead would mean the tube
// you are driving under is dark because a tube on the far side of the lap got
// there first.

from "std/math" import {
    Math
}
from "gl" import {
    GlContext, Mesh
}
from "./mesh" import {
    Builder, builder
}
from "./render" import {
    Material, material, sceneAttrs
}
from "./rng" import {
    Rand, rand
}
from "./textures" import {
    TEX_FACADE,
    TEX_ASPHALT, TEX_CONCRETE, TEX_GLASS, TEX_PAINT, TEX_STEEL
}
from "./track" import {
    HALF_WIDTH, Track, WALL
}
from "./vec3" import {
    Vec3, v3
}

pub let B_ROAD: i64 = 0

pub let B_MARK: i64 = 1

pub let B_CURB: i64 = 2

pub let B_WALL: i64 = 3

pub let B_STEEL: i64 = 4

pub let B_NEON: i64 = 5

pub let B_CITY: i64 = 6

pub let B_GLASS: i64 = 7

pub let B_GROUND: i64 = 8

// The boost pads get their own bucket only so the frame loop can pulse one
// material's emissive. Folding them into the neon bucket would mean pulsing
// every tube on the circuit with them.
pub let B_PAD: i64 = 9

pub let BUCKETS: i64 = 10

// Height of the barrier wall, and where its neon cap sits.
let WALL_H: f64 = 1.45

// Seven floats per light: position, colour, range. Same packing the renderer
// wants, so the frame loop can copy a slice of this straight across.
let LIGHT_FLOATS: i64 = 7

// Four floats per pad: arc length along the circuit, lateral offset, half
// length and half width. The geometry is in the mesh; this is the only copy the
// frame loop needs to test the car against.
pub let PAD_FLOATS: i64 = 4

pub struct World {
    meshes: Vec<Mesh>,
    mats: Vec<Material>,
    pads: Vec<f64>,
    // Every light the circuit could cast, in build order. Far more than the
    // shader can take; see `nearestLights`.
    lightPool: Vec<f64>,
}

// ---------------------------------------------------------------------------
// The road
// ---------------------------------------------------------------------------

// The racing surface. Built with explicit uv rather than through `quad` because
// the v coordinate has to be the distance along the lap: `quad` restarts uv at
// zero for every primitive, which on a road means the asphalt pattern resets
// every 2.5 m and the whole track reads as a ladder.
fn addRoad(b: &mut Builder, track: &Track) {
    let up = v3(0.0, 1.0, 0.0)
    let n = track.n
    let step = track.length / (n as f64)
    // One texture repeat every six metres. Larger and the aggregate smears at
    // the grazing angle the camera actually sees the road at.
    b.setUvScale(1.0 / 6.0)
    b.setTint(1.0, 1.0, 1.0)
    b.setAo(1.0)
    let w = HALF_WIDTH
    for i in 0..n {
        let s0 = (i as f64) * step
        let s1 = ((i + 1) as f64) * step
        let a = track.pointAt(s0, -w)
        let c = track.pointAt(s0, w)
        let d = track.pointAt(s1, w)
        let e = track.pointAt(s1, -w)
        b.push(a, up, 0.0, s0)
        b.push(c, up, 2.0 * w, s0)
        b.push(d, up, 2.0 * w, s1)
        b.push(a, up, 0.0, s0)
        b.push(d, up, 2.0 * w, s1)
        b.push(e, up, 0.0, s1)
    }
}

// Two triangles with an explicit shading normal, and a winding that can be
// reversed.
//
// `flip` is not a detail. Every surface on this circuit is built twice, once per
// side, from the same corner order, and mirroring a polygon reverses its
// winding: the order that faces the road on the left barrier faces away from it
// on the right. Back faces are culled in both the depth and the scene pass, so
// the symptom is not a dark wall, it is no wall at all on one side of the track.
fn pushQuadN(b: &mut Builder, p0: &Vec3, p1: &Vec3, p2: &Vec3, p3: &Vec3, nrm: &Vec3, u0: f64, v0: f64, u1: f64, v1: f64, flip: bool) {
    if flip {
        b.push(p0, nrm, u0, v0)
        b.push(p3, nrm, u0, v1)
        b.push(p2, nrm, u1, v1)
        b.push(p0, nrm, u0, v0)
        b.push(p2, nrm, u1, v1)
        b.push(p1, nrm, u1, v0)
        return
    }
    b.push(p0, nrm, u0, v0)
    b.push(p1, nrm, u1, v0)
    b.push(p2, nrm, u1, v1)
    b.push(p0, nrm, u0, v0)
    b.push(p2, nrm, u1, v1)
    b.push(p3, nrm, u0, v1)
}

// A painted stripe running along the road at a fixed offset, optionally dashed.
// Everything painted on this circuit goes through here.
fn addStripe(b: &mut Builder, track: &Track, off: f64, halfWidth: f64, dashOn: f64, dashOff: f64, r: f64, g: f64, bl: f64) {
    let up = v3(0.0, 1.0, 0.0)
    let n = track.n
    let step = track.length / (n as f64)
    b.setUvScale(0.5)
    b.setTint(r, g, bl)
    b.setAo(1.0)
    // Paint sits a centimetre and a half proud of the asphalt. Coplanar with it
    // and the depth buffer picks a winner per pixel, which is the shimmering
    // mess usually called z-fighting.
    let y = 0.015
    for i in 0..n {
        let s0 = (i as f64) * step
        if dashOff > 0.0 {
            let phase = s0 % (dashOn + dashOff)
            if phase > dashOn {
                continue
            }
        }
        let s1 = s0 + step
        let a = track.pointAt(s0, off - halfWidth)
        let c = track.pointAt(s0, off + halfWidth)
        let d = track.pointAt(s1, off + halfWidth)
        let e = track.pointAt(s1, off - halfWidth)
        b.push(v3(a.x, y, a.z), up, 0.0, 0.0)
        b.push(v3(c.x, y, c.z), up, 1.0, 0.0)
        b.push(v3(d.x, y, d.z), up, 1.0, 1.0)
        b.push(v3(a.x, y, a.z), up, 0.0, 0.0)
        b.push(v3(d.x, y, d.z), up, 1.0, 1.0)
        b.push(v3(e.x, y, e.z), up, 0.0, 1.0)
    }
}

fn addMarkings(b: &mut Builder, track: &Track) {
    // Solid edge lines, then two dashed lane dividers splitting the road in
    // three. Three lanes is what makes a ten-car pack legible: cars queue up in
    // lanes rather than smearing across twenty-two metres of tarmac.
    addStripe(b, track, -(HALF_WIDTH - 0.55), 0.14, 0.0, 0.0, 0.95, 0.95, 0.98)
    addStripe(b, track, HALF_WIDTH - 0.55, 0.14, 0.0, 0.0, 0.95, 0.95, 0.98)
    addStripe(b, track, -HALF_WIDTH / 3.0, 0.12, 4.0, 5.0, 0.90, 0.90, 0.95)
    addStripe(b, track, HALF_WIDTH / 3.0, 0.12, 4.0, 5.0, 0.90, 0.90, 0.95)
    // The double yellow down the middle. It is the one marking that says "public
    // road" rather than "circuit", and on a dark surface at night it is also the
    // only thing besides the kerbs telling you where the middle is.
    addStripe(b, track, -0.30, 0.13, 0.0, 0.0, 0.92, 0.68, 0.06)
    addStripe(b, track, 0.30, 0.13, 0.0, 0.0, 0.92, 0.68, 0.06)
}

// Rumble strips down both edges, alternating red and white every three metres.
// They are the one piece of the circuit that tells you where the limit is
// without a HUD element, and the alternation has to be in world distance rather
// than per sample or the block length changes with the corner radius.
fn addCurbs(b: &mut Builder, track: &Track) {
    let up = v3(0.0, 1.0, 0.0)
    let n = track.n
    let step = track.length / (n as f64)
    b.setUvScale(0.6)
    b.setAo(0.85)
    let h = 0.11
    let width = 1.15
    var side = -1.0
    while side < 2.0 {
        for i in 0..n {
            let s0 = (i as f64) * step
            let s1 = s0 + step
            let band = ((s0 / 3.0) as i64) % 2
            if band == 0 {
                b.setTint(0.95, 0.14, 0.12)
            } else {
                b.setTint(0.94, 0.94, 0.96)
            }
            let inner = HALF_WIDTH * side
            let outer = (HALF_WIDTH + width) * side
            let a = track.pointAt(s0, inner)
            let c = track.pointAt(s0, outer)
            let d = track.pointAt(s1, outer)
            let e = track.pointAt(s1, inner)
            // Top face. Its corners run across the road, so it is the right-hand
            // curb whose winding comes out inverted.
            pushQuadN(b, v3(a.x, h, a.z), v3(c.x, h, c.z), v3(d.x, h, d.z), v3(e.x, h, e.z), up, 0.0, 0.0, 1.0, 1.0, side < 0.0)
            // Inner face, so the strip has visible thickness from the road. Its
            // corners run along the road, so it is the other side that flips.
            let nrm = track.normalAt(s0).scale(-side)
            pushQuadN(b, v3(a.x, 0.0, a.z), v3(e.x, 0.0, e.z), v3(e.x, h, e.z), v3(a.x, h, a.z), nrm, 0.0, 0.0, 1.0, 1.0, side > 0.0)
        }
        side = side + 2.0
    }
}

// The barrier: a concrete wall with a neon cap running the whole lap.
//
// The cap is the single most important piece of geometry in the game for the
// look. It is a continuous line of light that follows every corner, so the shape
// of the road ahead is legible at night from half a lap away, and it is what
// the wet asphalt reflects.
fn addBarriers(wall: &mut Builder, neon: &mut Builder, track: &Track, pool: &mut Vec<f64>) {
    let n = track.n
    let step = track.length / (n as f64)
    let thick = 0.55
    var side = -1.0
    while side < 2.0 {
        for i in 0..n {
            let s0 = (i as f64) * step
            let s1 = s0 + step
            let inner = WALL * side
            let outer = (WALL + thick) * side
            let a = track.pointAt(s0, inner)
            let c = track.pointAt(s1, inner)
            let d = track.pointAt(s1, outer)
            let e = track.pointAt(s0, outer)
            // The face that gets hit and the face that is seen. It has to look
            // back at the road, which is the normal opposite the side it is on.
            let nrm = track.normalAt(s0).scale(-side)
            let up = v3(0.0, 1.0, 0.0)

            wall.setUvScale(0.35)
            wall.setTint(0.62, 0.62, 0.70)
            wall.setAo(0.9)
            pushQuadN(wall, v3(a.x, 0.0, a.z), v3(c.x, 0.0, c.z), v3(c.x, WALL_H, c.z), v3(a.x, WALL_H, a.z), nrm, s0, 0.0, s1, WALL_H, side > 0.0)
            pushQuadN(wall, v3(a.x, WALL_H, a.z), v3(c.x, WALL_H, c.z), v3(d.x, WALL_H, d.z), v3(e.x, WALL_H, e.z), up, s0, 0.0, s1, thick, side > 0.0)

            // A thin lit strip along the top edge, and nothing else.
            //
            // This used to be a 54 cm panel down the inner face running a cyan-
            // to-magenta ramp along the lap, out of phase on the two sides. As a
            // way of telling the two barriers apart it worked; as a thing to look
            // at for a whole lap it was a coloured bar the height of the car
            // pinned to each side of the frame, and once the city behind it was
            // solid there was no room left for it. The barrier's job at night is
            // to say where the edge of the road is, and a strip does that. What
            // reads as neon now is the shopfronts and the signs, which are on the
            // buildings, where a city keeps its lights.
            neon.setTint(1.55, 1.32, 1.05)
            neon.setUvScale(1.0)
            neon.setAo(1.0)
            let nx = nrm.scale(0.06)
            emitBand(neon, a, c, nx, nrm, WALL_H - 0.10, WALL_H + 0.02, side > 0.0)

            // A light every twelve metres or so along each barrier. Dense
            // enough that the road under the cap is lit continuously once the
            // frame loop picks the nearest ones.
            if i % 5 == 0 {
                let p = track.pointAt(s0, inner * 0.94)
                pushLight(pool, v3(p.x, WALL_H + 0.35, p.z), 1.5, 1.28, 1.00, 17.0)
            }
        }
        side = side + 2.0
    }
}

// One lit band on the inner face of the barrier, between two heights.
fn emitBand(neon: &mut Builder, a: &Vec3, c: &Vec3, nx: &Vec3, nrm: &Vec3, y0: f64, y1: f64, flip: bool) {
    pushQuadN(neon, v3(a.x + nx.x, y0, a.z + nx.z), v3(c.x + nx.x, y0, c.z + nx.z), v3(c.x + nx.x, y1, c.z + nx.z), v3(a.x + nx.x, y1, a.z + nx.z), nrm, 0.0, 0.0, 1.0, 1.0, flip)
}

fn pushLight(pool: &mut Vec<f64>, p: Vec3, r: f64, g: f64, b: f64, range: f64) {
    pool.push(p.x)
    pool.push(p.y)
    pool.push(p.z)
    pool.push(r)
    pool.push(g)
    pool.push(b)
    pool.push(range)
}

// Lamp posts down both sides, and an arch over the road every so often. Both
// exist to break the barrier's continuous line into a rhythm: a corridor of two
// unbroken glowing rails has no sense of speed because nothing passes you.
fn addFurniture(steel: &mut Builder, neon: &mut Builder, track: &Track, pool: &mut Vec<f64>) {
    // Lamp posts, alternating sides every 38 m.
    var s = 0.0
    var flip = false
    while s < track.length {
        let side = if flip {
            1.0
        } else {
            -1.0
        }
        let base = track.pointAt(s, (WALL + 1.1) * side)
        steel.setUvScale(1.2)
        steel.setTint(0.34, 0.35, 0.42)
        steel.setAo(0.8)
        steel.resetXform()
        steel.cylinder(v3(base.x, 0.0, base.z), 0.16, 7.2, 8, false)
        // The head leans out over the road, which is what a street lamp does and
        // what puts its light where the cars are.
        let nrm = track.normalAt(s).scale(side)
        let head = v3(base.x - nrm.x * 2.2, 7.2, base.z - nrm.z * 2.2)
        steel.boxSpan(v3(Math.minF64(base.x, head.x) - 0.09, 7.0, Math.minF64(base.z, head.z) - 0.09), v3(Math.maxF64(base.x, head.x) + 0.09, 7.2, Math.maxF64(base.z, head.z) + 0.09))
        // Warm white, not neon. At night these are the only thing lighting the
        // pavement and the bottom of the facades, and a magenta street lamp
        // leaves the buildings the same black they were with none: the tubes on
        // the barrier already own the colour, and what the city needs from these
        // is plain light with enough reach to actually land on a wall.
        neon.setTint(2.30, 1.95, 1.40)
        neon.setUvScale(1.0)
        neon.setAo(1.0)
        neon.box(v3(head.x, 6.86, head.z), 0.42, 0.09, 0.42)
        pushLight(pool, v3(head.x, 6.5, head.z), 5.4, 4.4, 3.0, 34.0)
        s = s + 25.0
        flip = !flip
    }

}

// Pavement cafes. Four a lap, alternating sides.
//
// They are the only thing in the game at human scale, and that is the whole
// point of them: a street lined with nothing but buildings has no way to tell
// you how big the buildings are. A chair is a metre of known height parked
// against a forty-metre facade, so putting four of them on the pavement does
// more for the sense of scale than another twenty storeys does.
fn addPatios(city: &mut Builder, steel: &mut Builder, neon: &mut Builder, track: &Track, pool: &mut Vec<f64>) {
    var rg = rand(0xca7e01)
    let spots = 4
    var i = 0
    while i < spots {
        let s = 90.0 + (i as f64) * (track.length / (spots as f64))
        let side = if i % 2 == 0 {
            1.0
        } else {
            -1.0
        }
        // Down the middle of the pavement, so the chairs clear the barrier on
        // one side and the shopfronts on the other.
        let lat = (WALL + PAVEMENT * 0.52) * side
        let shade = awningColor((rg.f() * 6.0) as i64)

        var k = 0
        while k < 4 {
            let c = track.pointAt(s + (k as f64) * 3.1, lat)
            cafeTable(city, steel, c, shade, k % 2 == 0)
            k = k + 1
        }

        // A planter at each end, which is what a real pavement cafe is fenced
        // off from the traffic with.
        var e = -1.0
        while e < 2.0 {
            let p = track.pointAt(s + 1.55 + e * 6.6, lat)
            city.resetXform()
            city.setUvScale(0.5)
            city.setAo(0.8)
            city.setTint(0.34, 0.30, 0.27)
            city.box(v3(p.x, 0.30, p.z), 0.42, 0.30, 0.42)
            city.setTint(0.10, 0.30, 0.11)
            city.box(v3(p.x, 0.78, p.z), 0.36, 0.24, 0.36)
            e = e + 2.0
        }

        // One warm lamp over the whole set. Four table lights would be four of
        // the sixteen the shader has.
        let mid = track.pointAt(s + 4.6, lat)
        pushLight(pool, v3(mid.x, 2.6, mid.z), 2.6, 1.85, 1.05, 13.0)
        neon.setUvScale(1.0)
        neon.setAo(1.0)
        neon.setTint(1.9, 1.35, 0.72)
        neon.box(v3(mid.x, 2.42, mid.z), 0.16, 0.10, 0.16)
        i = i + 1
    }
}

// One table, its chairs, and every other one an umbrella. The umbrella is what
// carries the colour; a bare table at this distance is a grey smudge.
fn cafeTable(city: &mut Builder, steel: &mut Builder, c: &Vec3, shade: &Vec3, umbrella: bool) {
    steel.resetXform()
    steel.setUvScale(1.0)
    steel.setAo(0.75)
    steel.setTint(0.24, 0.24, 0.27)
    steel.cylinder(v3(c.x, 0.0, c.z), 0.055, 0.70, 8, false)
    steel.setTint(0.86, 0.84, 0.80)
    steel.cylinder(v3(c.x, 0.70, c.z), 0.40, 0.05, 12, true)

    // Two chairs, on the road side and the shop side of the table.
    var d = -1.0
    while d < 2.0 {
        let cx = c.x + d * 0.78
        steel.setTint(0.22, 0.22, 0.25)
        steel.boxSpan(v3(cx - 0.20, 0.42, c.z - 0.20), v3(cx + 0.20, 0.47, c.z + 0.20))
        steel.boxSpan(v3(cx + d * 0.15, 0.47, c.z - 0.19), v3(cx + d * 0.20, 0.86, c.z + 0.19))
        // Legs as one block rather than four: at a metre tall and thirty metres
        // away, four 3 cm posts are the same pixel as one dark mass under the
        // seat, and they cost sixteen times the triangles to say it.
        steel.setTint(0.16, 0.16, 0.19)
        steel.boxSpan(v3(cx - 0.16, 0.0, c.z - 0.16), v3(cx + 0.16, 0.42, c.z + 0.16))
        d = d + 2.0
    }

    if umbrella {
        steel.setTint(0.70, 0.70, 0.72)
        steel.cylinder(v3(c.x, 0.75, c.z), 0.035, 1.55, 6, false)
        city.resetXform()
        city.setUvScale(0.4)
        city.setAo(0.9)
        city.setTint(shade.x, shade.y, shade.z)
        city.box(v3(c.x, 2.26, c.z), 1.05, 0.05, 1.05)
        city.setTint(shade.x * 1.2, shade.y * 1.2, shade.z * 1.2)
        city.box(v3(c.x, 2.14, c.z), 1.08, 0.07, 1.08)
    }
}

// The start line: a chequered band across the road and a gantry over it.
fn addStartLine(mark: &mut Builder, steel: &mut Builder, neon: &mut Builder, track: &Track, pool: &mut Vec<f64>) {
    let up = v3(0.0, 1.0, 0.0)
    mark.setUvScale(0.5)
    mark.setAo(1.0)
    // Two rows of squares, offset, which is what makes a chequer read as a
    // chequer rather than as a dashed line.
    let squares = 22
    var row = 0
    while row < 2 {
        let s0 = 2.0 + (row as f64) * 1.1
        let s1 = s0 + 1.1
        for k in 0..squares {
            if (k + row) % 2 == 1 {
                continue
            }
            let o0 = -HALF_WIDTH + (2.0 * HALF_WIDTH) * (k as f64) / (squares as f64)
            let o1 = -HALF_WIDTH + (2.0 * HALF_WIDTH) * ((k + 1) as f64) / (squares as f64)
            mark.setTint(0.96, 0.96, 0.98)
            let a = track.pointAt(s0, o0)
            let c = track.pointAt(s0, o1)
            let d = track.pointAt(s1, o1)
            let e = track.pointAt(s1, o0)
            let y = 0.018
            mark.push(v3(a.x, y, a.z), up, 0.0, 0.0)
            mark.push(v3(c.x, y, c.z), up, 1.0, 0.0)
            mark.push(v3(d.x, y, d.z), up, 1.0, 1.0)
            mark.push(v3(a.x, y, a.z), up, 0.0, 0.0)
            mark.push(v3(d.x, y, d.z), up, 1.0, 1.0)
            mark.push(v3(e.x, y, e.z), up, 0.0, 1.0)
        }
        row = row + 1
    }

    // The gantry, taller and heavier than the plain arches so the start of the
    // lap is somewhere you recognise at speed.
    let l = track.pointAt(3.0, WALL + 2.2)
    let r = track.pointAt(3.0, -(WALL + 2.2))
    let top = 11.6
    steel.setUvScale(0.7)
    steel.setTint(0.22, 0.23, 0.29)
    steel.setAo(0.85)
    steel.resetXform()
    steel.cylinder(v3(l.x, 0.0, l.z), 0.42, top, 10, false)
    steel.cylinder(v3(r.x, 0.0, r.z), 0.42, top, 10, false)
    let lo = v3(Math.minF64(l.x, r.x) - 0.5, top, Math.minF64(l.z, r.z) - 0.5)
    let hi = v3(Math.maxF64(l.x, r.x) + 0.5, top + 2.2, Math.maxF64(l.z, r.z) + 0.5)
    steel.boxSpan(lo, hi)
    neon.setTint(2.50, 1.90, 0.35)
    neon.boxSpan(v3(lo.x + 0.1, top - 0.22, lo.z + 0.1), v3(hi.x - 0.1, top - 0.04, hi.z - 0.1))
    let mid = track.pointAt(3.0, 0.0)
    pushLight(pool, v3(mid.x, top - 1.0, mid.z), 7.0, 5.0, 1.6, 38.0)
}

// ---------------------------------------------------------------------------
// The city
// ---------------------------------------------------------------------------

// Buildings lining the circuit, with lit windows.
//
// They are placed off the track normal rather than on a grid, so the circuit
// reads as a street closed for a race rather than as a ribbon dropped on a city.
// Every candidate is then checked back against the whole track: the loop passes
// near itself in two places, and a tower placed forty metres off one straight
// can land squarely on another.
fn addCity(city: &mut Builder, neon: &mut Builder, steel: &mut Builder, track: &Track, pool: &mut Vec<f64>) {
    var rg = rand(0x5eed1234)

    // The front row is a CONTINUOUS wall, walked separately per side and stepped
    // by each block's own length so the next one starts where the last one
    // ended. Placing it on the same fixed grid the towers use leaves a gap
    // wherever a block is narrower than the step, and one gap in a street wall
    // is worth more than all the buildings around it: the eye goes straight to
    // the hole and reads the whole row as scenery standing in a field.
    //
    // Consecutive blocks are deliberately overlapped a little. On a curve the
    // road turns between one block and the next while the boxes stay
    // world-axis-aligned, so two that merely touch on the straight open a wedge
    // of daylight between them on the corner.
    var side = -1.0
    while side < 2.0 {
        var s = 0.0
        while s < track.length {
            let halfZ = rg.range(6.5, 11.0)
            let halfX = rg.range(5.0, 9.0)
            // Height is the only thing left to vary, and it carries the whole
            // silhouette now that the plan is a solid run.
            // Nothing short. The front row's job is to be the side of the
            // frame, and a 24 m block on a 15 m street tops out barely above the
            // camera: the eye goes over it, finds the haze behind, and reads the
            // whole wall as a fence with a view. The shortest thing here is
            // thirty-six metres, about twelve storeys.
            var height = rg.range(36.0, 58.0)
            let tall = rg.f()
            if tall > 0.78 {
                height = rg.range(92.0, 150.0)
            } else if tall > 0.48 {
                height = rg.range(62.0, 90.0)
            }
            let off = (WALL + PAVEMENT + halfX) * side
            let _ = tryBuilding(city, neon, steel, pool, track, off, s + halfZ, halfX, halfZ, height, rg)
            // Step by arc length ON THE FACADE, not on the centreline.
            //
            // The blocks stand thirteen metres out, so on a corner of radius R
            // the outside of the road covers (R+13)/R metres of facade for every
            // metre of centreline. Stepping by centreline arc pulls the outer row
            // apart by exactly that factor, which on a hairpin is a third again
            // and opens a hole on the outside of every corner while the inside
            // piles up. Measuring the offset curve directly costs two lookups and
            // is right for any radius, including the straights where it is 1.
            let a = track.pointAt(s, off)
            let b = track.pointAt(s + 8.0, off)
            let dxs = b.x - a.x
            let dzs = b.z - a.z
            let stretch = Math.clampF64(Math.sqrt(dxs * dxs + dzs * dzs) / 8.0, 0.45, 2.4)
            s = s + halfZ * 1.62 / stretch
        }
        side = side + 2.0
    }

    // The back row: towers, far enough behind the front wall that anything seen
    // over the top of it is a city rather than the ground plane.
    var t = 0.0
    while t < track.length {
        var bside = -1.0
        while bside < 2.0 {
            if rg.f() > 0.12 {
                let halfX = rg.range(9.0, 18.0)
                let halfZ = rg.range(9.0, 18.0)
                var height = rg.range(70.0, 130.0)
                if rg.f() > 0.60 {
                    height = rg.range(135.0, 210.0)
                }
                let off = (WALL + 24.0 + rg.range(0.0, 44.0) + Math.maxF64(halfX, halfZ)) * bside
                let _ = tryBuilding(city, neon, steel, pool, track, off, t + rg.jitter(12.0), halfX, halfZ, height, rg)
            }
            bside = bside + 2.0
        }
        t = t + 19.0
    }
}

// Place one building if it clears every part of the lap. The loop passes near
// itself in two places, so a block placed off one straight can land squarely on
// another: `locate` with a cold hint scans the whole table, which is exactly
// what is wanted at build time and costs nothing there.
fn tryBuilding(city: &mut Builder, neon: &mut Builder, steel: &mut Builder, pool: &mut Vec<f64>, track: &Track, off: f64, s: f64, halfX: f64, halfZ: f64, height: f64, rg: &mut Rand): bool {
    // Try the block, and if it will not fit, try a thinner one before giving up.
    //
    // The circuit passes close to itself in two places, and in that strip a
    // full-depth block reaches across into the other carriageway, so the test
    // below rejects it and the front row simply stops - which is where the holes
    // that opened onto the ground plane were coming from. But a wall does not
    // have to be deep to be a wall: what the frame needs is something standing on
    // the pavement, and a slab a couple of metres thick reads from the road
    // exactly like a building forty metres deep. Shrinking toward the pavement is
    // strictly better than the alternative, which is nothing at all.
    // Shrink BOTH ways, and mostly along the road. Thinning the block only
    // toward the pavement does nothing about the thing that actually fails: the
    // corners that reach furthest into the other carriageway are the ones at the
    // ENDS, swung out by half the block's length, so a long slab stays rejected
    // however thin it gets. Six steps down to a fifth of the original in each
    // direction, which at the tightest pinch is a two-metre kiosk - still a wall.
    var shrink = 0
    while shrink < 6 {
        let k = 1.0 - (shrink as f64) * 0.16
        let hx = halfX * k
        let hz = halfZ * (1.0 - (shrink as f64) * 0.15)
        // Keep the near face on the pavement as it thins, so the wall stays a
        // straight line and only its back edge moves in.
        let sgn = if off > 0.0 {
            1.0
        } else {
            -1.0
        }
        let o = off - sgn * (halfX - hx)
        if placeBuilding(city, neon, steel, pool, track, o, s, hx, hz, height, rg) {
            return true
        }
        shrink = shrink + 1
    }
    return false
}

// Place one building if its footprint clears every part of the lap. Returns
// whether it went down.
fn placeBuilding(city: &mut Builder, neon: &mut Builder, steel: &mut Builder, pool: &mut Vec<f64>, track: &Track, off: f64, s: f64, halfX: f64, halfZ: f64, height: f64, rg: &mut Rand): bool {
    let c = track.pointAt(s, off)

    // Test the FOOTPRINT, not the centre minus a bounding radius.
    //
    // The old test asked whether `|lateral| - max(halfX, halfZ)` cleared the
    // wall, which is the distance to the corner of a circle drawn round the
    // block. For the back row, parked forty metres out, that is harmlessly
    // conservative. For the front row it is fatal: a block deliberately placed
    // with its near face on the pavement sits about thirteen metres out, and a
    // radius of eleven demands twenty-two, so most of the wall was silently
    // thrown away and what came back was the row of holes it was written to
    // avoid. Checking the four corners is exact, and the only real question it
    // asks is whether some corner reaches a DIFFERENT pass of the lap.
    var i = 0
    while i < 4 {
        let sx = if i % 2 == 0 {
            -1.0
        } else {
            1.0
        }
        let sz = if i < 2 {
            -1.0
        } else {
            1.0
        }
        let p = track.locate(c.x + sx * halfX, c.z + sz * halfZ, 0)
        if Math.abs(p.lateral) < WALL + 0.9 {
            return false
        }
        i = i + 1
    }

    // Which way the road is from here, as one of the four world-axis faces. The
    // shopfronts go on that face only: a plinth wearing awnings and blade signs
    // on all four sides puts a band of lit boxes down the back of every building
    // in the city, which from the road reads as a striped ribbon threaded
    // between the towers rather than as a street.
    let onRoad = track.pointAt(s, 0.0)
    let dx = onRoad.x - c.x
    let dz = onRoad.z - c.z
    var face = 0
    if Math.abs(dx) > Math.abs(dz) {
        face = if dx > 0.0 {
            0
        } else {
            1
        }
    } else {
        face = if dz > 0.0 {
            2
        } else {
            3
        }
    }
    addBuilding(city, neon, steel, pool, c, halfX, halfZ, height, face, rg)
    return true
}

// One building: a plinth, a shaft that steps back as it rises, a cornice at
// every step, a parapet on top and whatever machinery the roof carries.
//
// The stepping is the whole difference between a city and a row of boxes. A
// single extruded rectangle has one silhouette from every angle and no scale
// cues at all; a tower that loses a few metres of plan at two heights reads as
// having floors, and the cornice line that comes with each step is what catches
// the sun.
fn addBuilding(city: &mut Builder, neon: &mut Builder, steel: &mut Builder, pool: &mut Vec<f64>, c: &Vec3, halfX: f64, halfZ: f64, height: f64, roadFace: i64, rg: &mut Rand) {
    // Six facade stocks. A real skyline is not one material at six
    // brightnesses: the cream block next to the brick one next to the teal
    // curtain wall is what says "these were built by different people in
    // different decades", and it is the only cue at this distance that the
    // silhouette is a city rather than a ridge. The saturation matters as much
    // as the value, because ACES rolls everything toward white at the top end
    // and a facade that started grey ends the frame as grey.
    let hue = rg.f()
    var tr = 0.86
    var tg = 0.79
    var tb = 0.66
    if hue > 0.84 {
        // Teal curtain wall.
        tr = 0.19
        tg = 0.46
        tb = 0.45
    } else if hue > 0.68 {
        // Blue-black glass tower.
        tr = 0.15
        tg = 0.21
        tb = 0.33
    } else if hue > 0.50 {
        // Terracotta / red brick.
        tr = 0.74
        tg = 0.31
        tb = 0.23
    } else if hue > 0.34 {
        // Warm sandstone.
        tr = 0.84
        tg = 0.63
        tb = 0.37
    } else if hue > 0.17 {
        // Cool precast concrete.
        tr = 0.62
        tg = 0.67
        tb = 0.72
    }
    city.setUvScale(1.0 / 12.0)
    city.setAo(0.80)
    city.resetXform()

    // The plinth: two storeys, a little wider than the shaft, darker. It is what
    // the street actually sees.
    let plinthH = Math.minF64(7.0, height * 0.35)
    city.setTint(tr * 0.80, tg * 0.80, tb * 0.82)
    city.box(v3(c.x, plinthH * 0.5, c.z), halfX + 0.45, plinthH * 0.5, halfZ + 0.45)
    // Its cornice, standing proud all the way round.
    city.setTint(tr * 1.10, tg * 1.10, tb * 1.10)
    city.box(v3(c.x, plinthH + 0.22, c.z), halfX + 0.80, 0.22, halfZ + 0.80)

    // The shaft, in up to three setbacks.
    var y = plinthH + 0.44
    var hx = halfX
    var hz = halfZ
    var tier = 0
    while tier < 3 && y < height - 1.0 {
        // Each tier takes a share of what is left, so a tall building steps
        // several times and a low one does not step at all.
        var top = height
        if tier < 2 && height - y > 22.0 {
            top = y + (height - y) * rg.range(0.45, 0.72)
        }
        let h = top - y
        if h < 2.0 {
            tier = 3
            continue
        }
        city.setTint(tr, tg, tb)
        city.box(v3(c.x, y + h * 0.5, c.z), hx, h * 0.5, hz)
        // Pilasters: thin fins up the corners of the tier. Two per corner, so
        // the edge of the building is a line of light and shadow rather than a
        // hard join between two flat greys.
        city.setTint(tr * 1.14, tg * 1.14, tb * 1.14)
        var sx = -1.0
        while sx < 2.0 {
            var sz = -1.0
            while sz < 2.0 {
                city.box(v3(c.x + sx * hx, y + h * 0.5, c.z + sz * (hz - 0.9)), 0.22, h * 0.5, 0.32)
                city.box(v3(c.x + sx * (hx - 0.9), y + h * 0.5, c.z + sz * hz), 0.32, h * 0.5, 0.22)
                sz = sz + 2.0
            }
            sx = sx + 2.0
        }
        addWindows(neon, c, hx, hz, y, top, rg)
        // The cornice that caps this tier.
        city.setTint(tr * 1.12, tg * 1.12, tb * 1.12)
        city.box(v3(c.x, top + 0.20, c.z), hx + 0.55, 0.20, hz + 0.55)
        y = top + 0.40
        hx = hx * rg.range(0.72, 0.88)
        hz = hz * rg.range(0.72, 0.88)
        tier = tier + 1
    }

    // Parapet: a low wall round the roof, so the top of the building is an edge
    // and not a lid.
    city.setTint(tr * 0.92, tg * 0.92, tb * 0.92)
    let rh = y
    city.box(v3(c.x, rh + 0.55, c.z - hz), hx, 0.55, 0.18)
    city.box(v3(c.x, rh + 0.55, c.z + hz), hx, 0.55, 0.18)
    city.box(v3(c.x - hx, rh + 0.55, c.z), 0.18, 0.55, hz)
    city.box(v3(c.x + hx, rh + 0.55, c.z), 0.18, 0.55, hz)

    addRoofKit(steel, neon, pool, c, hx, hz, rh, rg)

    // Signage. Every third building carries a lit sign on one face, and it is
    // the single cheapest thing in this game that says "city": a coloured
    // rectangle of light at forty metres up, reflected in the road.
    if rg.f() < 0.34 {
        let sr = rg.f()
        var r = 2.6
        var g = 0.5
        var b = 1.9
        if sr > 0.66 {
            r = 0.4
            g = 2.2
            b = 2.6
        } else if sr > 0.33 {
            r = 2.8
            g = 1.5
            b = 0.3
        }
        let sy = Math.minF64(rh - 3.0, plinthH + 6.0 + rg.range(2.0, 26.0))
        if sy > plinthH + 2.0 {
            let along = rg.f() < 0.5
            let w = rg.range(2.6, 5.2)
            neon.setUvScale(1.0)
            neon.setAo(1.0)
            neon.setTint(r, g, b)
            city.setTint(0.10, 0.10, 0.12)
            if along {
                neon.box(v3(c.x, sy, c.z + halfZ + 0.36), w, w * 0.62, 0.10)
                city.box(v3(c.x, sy, c.z + halfZ + 0.20), w + 0.30, w * 0.62 + 0.30, 0.16)
            } else {
                neon.box(v3(c.x + halfX + 0.36, sy, c.z), 0.10, w * 0.62, w)
                city.box(v3(c.x + halfX + 0.20, sy, c.z), 0.16, w * 0.62 + 0.30, w + 0.30)
            }
            pushLight(pool, v3(c.x, sy, c.z), r * 0.9, g * 0.9, b * 0.9, 26.0)
        }
    }

    // Street level. This is the only part of a building anybody driving past
    // actually reads, and a bare plinth is what makes a dense city still feel
    // empty: at eye height the reference is nothing but awnings, lit windows
    // and signs hung out over the pavement, and none of that is in the
    // silhouette a box gives you.
    let face = roadFace
    let alongX = face > 1
    let dir = if face % 2 == 0 {
        1.0
    } else {
        -1.0
    }
    let span = if alongX {
        halfX
    } else {
        halfZ
    }
    let depth = if alongX {
        halfZ
    } else {
        halfX
    }
    addShopRow(city, neon, pool, c, span, depth, alongX, dir, rg)
}

// One saturated awning colour. Primaries, not tints: the shopfronts are the
// only thing in the frame at the driver's own eye height, so they are what sets
// how colourful the street reads, and a row of tasteful muted canopies reads as
// no canopies at all.
fn awningColor(k: i64): Vec3 {
    if k == 0 {
        return v3(0.52, 0.13, 0.12)
    }
    if k == 1 {
        return v3(0.11, 0.32, 0.19)
    }
    if k == 2 {
        return v3(0.11, 0.20, 0.42)
    }
    if k == 3 {
        return v3(0.60, 0.46, 0.11)
    }
    if k == 4 {
        return v3(0.52, 0.26, 0.09)
    }
    return v3(0.40, 0.12, 0.32)
}

// A row of two to four shop units along one face of a plinth: lit window, awning
// over it, a signboard above the awning, and on some of them a blade sign hung
// out perpendicular to the wall.
//
// `span` is the half length of the face and `depth` the half extent of the
// building the other way, so one body of code serves the X faces and the Z
// faces; `place` is what maps a (along, out) pair back into world space.
fn addShopRow(city: &mut Builder, neon: &mut Builder, pool: &mut Vec<f64>, c: &Vec3, span: f64, depth: f64, alongX: bool, dir: f64, rg: &mut Rand) {
    let units = 2 + (rg.f() * 3.0) as i64
    let w = (span * 2.0) / (units as f64)
    var i = 0
    while i < units {
        let mid = -span + w * ((i as f64) + 0.5)
        // A real gap between units. At 0.42 of the bay the awnings of adjacent
        // shops all but touched, and a row of touching canopies is not a row of
        // canopies: it is one painted stripe running the length of the building,
        // which is what these read as from the road.
        let hw = w * 0.34
        let col = awningColor((rg.f() * 6.0) as i64)

        // The window: a wide band of warm interior light behind the glass. Its
        // own emissive is what puts a pool of light on the pavement, which is
        // most of why a lit shop reads as occupied rather than as a decal.
        // Interior light, not a lightbox. An emissive above about 1.0 on a
        // surface this large clips through the tone map and the whole unit
        // comes back as a white slab with no colour left in it: the shopfronts
        // have to sit UNDER the neon tubes in brightness or they eat the street.
        let glow = rg.f()
        var gr = 1.55
        var gg = 1.18
        var gb = 0.70
        if glow > 0.72 {
            gr = 0.34
            gg = 1.24
            gb = 1.55
        } else if glow > 0.48 {
            gr = 1.70
            gg = 0.52
            gb = 1.10
        }
        neon.setUvScale(1.0)
        neon.setAo(1.0)
        neon.setTint(gr, gg, gb)
        shopBox(neon, c, alongX, dir, depth, mid, hw, 0.95, 2.80, 0.10, 0.18)

        // The awning, as three steps that fall away from the wall. A single
        // slab with a tall valance hanging off it presents the road a flat
        // coloured rectangle a metre high and the width of the shop, and a row
        // of those is a stripe. Stepping it down costs two extra boxes and makes
        // it read as something sticking out over the pavement, which is the only
        // reason it is there.
        city.setUvScale(0.5)
        city.setAo(0.72)
        var st = 0
        while st < 3 {
            let t = (st as f64)
            let k = if st % 2 == 0 {
                1.0
            } else {
                1.18
            }
            city.setTint(col.x * k, col.y * k, col.z * k)
            shopBox(city, c, alongX, dir, depth, mid, hw + 0.10, 3.30 - t * 0.17, 3.44 - t * 0.17, 0.15 + t * 0.42, 0.60 + t * 0.42)
            st = st + 1
        }
        // The valance is now a lip, not a curtain.
        city.setTint(col.x * 0.82, col.y * 0.82, col.z * 0.82)
        shopBox(city, c, alongX, dir, depth, mid, hw + 0.10, 2.72, 2.96, 1.29, 1.44)

        // The signboard over the awning, dark surround with a lit face. Narrower
        // than the shop so the building shows between one board and the next.
        city.setTint(0.10, 0.10, 0.13)
        shopBox(city, c, alongX, dir, depth, mid, hw * 0.80, 3.66, 4.66, 0.05, 0.26)
        neon.setTint(gr * 1.15 + 0.18, gg * 1.15 + 0.18, gb * 1.15 + 0.18)
        shopBox(neon, c, alongX, dir, depth, mid, hw * 0.64, 3.82, 4.50, 0.24, 0.33)

        // A blade sign on some units: a tall panel hung out square to the wall,
        // which is the one piece of street furniture that breaks the facade
        // plane and so the one that makes the row read as depth.
        if rg.f() < 0.42 {
            let by = 5.4 + rg.range(0.0, 3.4)
            let bh = rg.range(2.2, 3.6)
            let bc = awningColor((rg.f() * 6.0) as i64)
            neon.setTint(bc.x * 3.4 + 0.25, bc.y * 3.4 + 0.25, bc.z * 3.4 + 0.25)
            bladeSign(neon, c, alongX, dir, depth, mid, by, by + bh)
            pushLight(pool, shopPoint(c, alongX, dir, depth, mid, by + bh * 0.5, 1.5), bc.x * 2.2 + 0.2, bc.y * 2.2 + 0.2, bc.z * 2.2 + 0.2, 15.0)
        }

        pushLight(pool, shopPoint(c, alongX, dir, depth, mid, 2.4, 2.2), gr * 2.4, gg * 2.4, gb * 2.4, 17.0)
        i = i + 1
    }
}

// A point on the shop face: `along` runs across the face, `out` stands off it.
fn shopPoint(c: &Vec3, alongX: bool, dir: f64, depth: f64, along: f64, y: f64, out: f64): Vec3 {
    if alongX {
        return v3(c.x + along, y, c.z + dir * (depth + out))
    }
    return v3(c.x + dir * (depth + out), y, c.z + along)
}

// A box on the shop face, given its half length across the face, its vertical
// span, and how far its near and far walls stand off the facade.
fn shopBox(b: &mut Builder, c: &Vec3, alongX: bool, dir: f64, depth: f64, along: f64, hw: f64, y0: f64, y1: f64, out0: f64, out1: f64) {
    b.resetXform()
    let lo = shopPoint(c, alongX, dir, depth, along - hw, y0, out0)
    let hi = shopPoint(c, alongX, dir, depth, along + hw, y1, out1)
    b.boxSpan(lo, hi)
}

// A blade sign: a thin panel square to the wall, so it is read edge-on by the
// facade and face-on by anybody coming down the street.
fn bladeSign(b: &mut Builder, c: &Vec3, alongX: bool, dir: f64, depth: f64, along: f64, y0: f64, y1: f64) {
    b.resetXform()
    if alongX {
        b.boxSpan(v3(c.x + along - 0.07, y0, c.z + dir * (depth + 0.25)), v3(c.x + along + 0.07, y1, c.z + dir * (depth + 1.50)))
    } else {
        b.boxSpan(v3(c.x + dir * (depth + 0.25), y0, c.z + along - 0.07), v3(c.x + dir * (depth + 1.50), y1, c.z + along + 0.07))
    }
}

// Water tanks, plant rooms, a mast and an aircraft beacon. A flat roof with
// nothing on it is the tell that a building is scenery: everything real up there
// exists because the building needs it, and the silhouette it makes is what a
// skyline actually is.
fn addRoofKit(steel: &mut Builder, neon: &mut Builder, pool: &mut Vec<f64>, c: &Vec3, hx: f64, hz: f64, rh: f64, rg: &mut Rand) {
    steel.setUvScale(0.9)
    steel.setAo(0.8)
    steel.resetXform()
    // Plant rooms: two or three low boxes, off centre.
    let boxes = 2 + ((rg.f() * 2.0) as i64)
    for i in 0..boxes {
        let bx = c.x + rg.jitter(hx * 0.55)
        let bz = c.z + rg.jitter(hz * 0.55)
        let bh = rg.range(1.2, 2.6)
        steel.setTint(0.34, 0.35, 0.40)
        steel.box(v3(bx, rh + bh * 0.5, bz), rg.range(0.9, 2.2), bh * 0.5, rg.range(0.9, 2.2))
        let _ = i
    }
    // A water tank on legs, on the taller ones.
    if hx > 6.0 && rg.f() < 0.55 {
        let tx = c.x + rg.jitter(hx * 0.4)
        let tz = c.z + rg.jitter(hz * 0.4)
        steel.setTint(0.30, 0.26, 0.24)
        var leg = 0
        while leg < 4 {
            let lx = if leg % 2 == 0 {
                -1.0
            } else {
                1.0
            }
            let lz = if leg < 2 {
                -1.0
            } else {
                1.0
            }
            steel.cylinder(v3(tx + lx * 1.0, rh, tz + lz * 1.0), 0.11, 2.2, 6, false)
            leg = leg + 1
        }
        steel.setTint(0.40, 0.31, 0.26)
        steel.cylinder(v3(tx, rh + 2.2, tz), 1.45, 3.0, 12, true)
    }
    // The mast, and the red light on it that every tall building in the world
    // carries.
    if rh > 45.0 {
        let mh = rg.range(6.0, 16.0)
        steel.setTint(0.28, 0.29, 0.34)
        steel.cylinder(v3(c.x, rh, c.z), 0.14, mh, 6, false)
        neon.setUvScale(1.0)
        neon.setAo(1.0)
        neon.setTint(3.4, 0.16, 0.10)
        neon.box(v3(c.x, rh + mh + 0.3, c.z), 0.34, 0.34, 0.34)
        pushLight(pool, v3(c.x, rh + mh + 0.3, c.z), 2.6, 0.2, 0.15, 30.0)
    }
}

// The lit windows on one tier. Everything unlit is in the facade texture; these
// are only the rooms with somebody in them, and they are geometry because they
// have to actually glow and light the street.
//
// The grid matches the texture: four floors and six bays to a twelve-metre
// repeat, so a lit pane lands exactly in an opening rather than across a mullion.
fn addWindows(neon: &mut Builder, c: &Vec3, halfX: f64, halfZ: f64, y0: f64, y1: f64, rg: &mut Rand) {
    let floorH = 3.0
    let bayW = 2.0
    let e = 0.10
    var face = 0
    while face < 4 {
        let alongX = face < 2
        let dir = if face % 2 == 0 {
            1.0
        } else {
            -1.0
        }
        let span = if alongX {
            halfX
        } else {
            halfZ
        }
        let depth = if alongX {
            halfZ
        } else {
            halfX
        }
        let cols = Math.maxI64(1, ((2.0 * span - 1.2) / bayW) as i64)
        let floors = Math.maxI64(1, ((y1 - y0 - 1.0) / floorH) as i64)
        for fl in 0..floors {
            let yb = y0 + 0.9 + (fl as f64) * floorH
            if yb + 1.7 > y1 {
                continue
            }
            for col in 0..cols {
                // Two thirds of the building is asleep. A tower with every
                // window lit reads as a light box, not as a building.
                if rg.f() < 0.62 {
                    continue
                }
                let t0 = -span + 0.6 + (col as f64) * bayW + 0.36
                let t1 = t0 + bayW * 0.64
                let warm = rg.f()
                var r = 1.35
                var g = 1.05
                var b = 0.66
                if warm > 0.80 {
                    r = 0.42
                    g = 1.20
                    b = 1.55
                } else if warm > 0.64 {
                    r = 1.45
                    g = 0.55
                    b = 1.10
                }
                let k = rg.range(0.40, 1.0)
                neon.setTint(r * k, g * k, b * k)
                neon.setUvScale(1.0)
                neon.setAo(1.0)
                let ya = yb
                let yc = yb + 1.7
                if alongX {
                    let z = c.z + dir * (depth + e)
                    let nrm = v3(0.0, 0.0, dir)
                    neon.push(v3(c.x + t0, ya, z), nrm, 0.0, 0.0)
                    neon.push(v3(c.x + t1, ya, z), nrm, 1.0, 0.0)
                    neon.push(v3(c.x + t1, yc, z), nrm, 1.0, 1.0)
                    neon.push(v3(c.x + t0, ya, z), nrm, 0.0, 0.0)
                    neon.push(v3(c.x + t1, yc, z), nrm, 1.0, 1.0)
                    neon.push(v3(c.x + t0, yc, z), nrm, 0.0, 1.0)
                } else {
                    let x = c.x + dir * (depth + e)
                    let nrm = v3(dir, 0.0, 0.0)
                    neon.push(v3(x, ya, c.z + t0), nrm, 0.0, 0.0)
                    neon.push(v3(x, ya, c.z + t1), nrm, 1.0, 0.0)
                    neon.push(v3(x, yc, c.z + t1), nrm, 1.0, 1.0)
                    neon.push(v3(x, ya, c.z + t0), nrm, 0.0, 0.0)
                    neon.push(v3(x, yc, c.z + t1), nrm, 1.0, 1.0)
                    neon.push(v3(x, yc, c.z + t0), nrm, 0.0, 1.0)
                }
            }
        }
        face = face + 1
    }
}

// The ground the whole circuit sits on. One quad, big enough that its edge is
// never in frame, dark enough that it never competes with the road.
fn addGround(b: &mut Builder, track: &Track) {
    // Centred on the circuit rather than on the origin: the loop is not centred
    // on the origin and a ground plane that is leaves a visible edge on one side.
    var cx = 0.0
    var cz = 0.0
    for i in 0..track.n {
        cx = cx + track.xs[i]
        cz = cz + track.zs[i]
    }
    cx = cx / (track.n as f64)
    cz = cz / (track.n as f64)
    let r = 4200.0
    let up = v3(0.0, 1.0, 0.0)
    b.setUvScale(1.0 / 14.0)
    b.setTint(0.12, 0.11, 0.17)
    b.setAo(0.7)
    let y = -0.05
    b.push(v3(cx - r, y, cz - r), up, 0.0, 0.0)
    b.push(v3(cx + r, y, cz - r), up, 2.0 * r, 0.0)
    b.push(v3(cx + r, y, cz + r), up, 2.0 * r, 2.0 * r)
    b.push(v3(cx - r, y, cz - r), up, 0.0, 0.0)
    b.push(v3(cx + r, y, cz + r), up, 2.0 * r, 2.0 * r)
    b.push(v3(cx - r, y, cz + r), up, 0.0, 2.0 * r)
}

// ---------------------------------------------------------------------------
// Boost pads
// ---------------------------------------------------------------------------

// Half the length of a pad along the road, and half its width across it. Wide
// enough that hitting one is a small steering decision rather than a shot at a
// target, because a pad you can miss at 200 mph is a pad that only punishes.
// How much pavement there is between the barrier and the front row of
// buildings. Wide enough to stand a cafe table on, which is the only reason it
// is not simply zero.
pub let PAVEMENT: f64 = 3.4

pub let PAD_HALF_LEN: f64 = 5.5

pub let PAD_HALF_W: f64 = 2.3

// Chevrons painted flat on the road, three per pad, pointing the way you are
// going. They sit 3 cm proud: co-planar with the tarmac they z-fight, and the
// fight is worse the further away they are, which is exactly where the player
// needs to see them.
fn addBoostPads(b: &mut Builder, pads: &mut Vec<f64>, track: &Track) {
    b.setUvScale(1.0)
    b.setAo(1.0)
    var rg = rand(0xb0057)
    // Five a lap on a 2.8 km circuit: better than five hundred metres between
    // them. A bonus you meet every few seconds is not a bonus, it is the road
    // surface with extra lights on it, and the only thing that makes one worth
    // steering for is that the next one is a long way off.
    let count = 5
    var i = 0
    while i < count {
        // Jittered along the lap rather than evenly divided, so they do not land
        // in the same place on every corner.
        let s = 60.0 + (i as f64) * (track.length / (count as f64)) + rg.range(-60.0, 60.0)
        // Anywhere across the road, not one of three lanes. Snapping them to
        // lanes puts most of them on the racing line, where taking one is free;
        // off the line, taking one is a decision.
        let lane = rg.range(-HALF_WIDTH * 0.60, HALF_WIDTH * 0.60)
        pads.push(s)
        pads.push(lane)
        pads.push(PAD_HALF_LEN)
        pads.push(PAD_HALF_W)

        var k = 0
        while k < 3 {
            // Front to back, brightest at the far end so the pad reads as an
            // arrow pointing away from you rather than as three stripes.
            let t = (k as f64) / 2.0
            let cs = s - PAD_HALF_LEN + 0.9 + (k as f64) * 2.7
            let glow = 1.5 + t * 2.6
            chevron(b, track, cs, lane, 0.55 + t * 0.35, glow)
            k = k + 1
        }
        i = i + 1
    }
}

// One chevron: two arms meeting on the centre of the lane, built out of six
// quads laid on the road. Every corner comes from `track.pointAt`, so a pad on a
// curve bends with the road instead of standing off it as a flat card.
fn chevron(b: &mut Builder, track: &Track, s: f64, lane: f64, cyan: f64, glow: f64) {
    let up = v3(0.0, 1.0, 0.0)
    let y = 0.03
    // Cyan through white: the tip is nearly white and the tails keep the colour,
    // which is what makes it read as hot rather than as painted.
    b.setTint(glow * (1.0 - cyan * 0.72), glow, glow * (1.0 + cyan * 0.12))
    // A long, narrow chevron. At the wide angle a short one gives, the arms are
    // nearly across the road and the shape reads as a bar with a kink in it
    // rather than as something pointing anywhere.
    let tip = 3.4
    let back = 0.0
    let thick = 0.85
    var side = -1.0
    while side < 2.0 {
        let xo = lane
        // Outer edge of this arm, and the inner edge parallel to it.
        let a = track.pointAt(s + back, xo + side * PAD_HALF_W)
        let c = track.pointAt(s + tip, xo)
        let a2 = track.pointAt(s + back + thick, xo + side * PAD_HALF_W)
        let c2 = track.pointAt(s + tip + thick, xo)
        pushQuadN(b, v3(a.x, y, a.z), v3(c.x, y, c.z), v3(c2.x, y, c2.z), v3(a2.x, y, a2.z), up, 0.0, 0.0, 1.0, 1.0, side > 0.0)
        side = side + 2.0
    }
}

// ---------------------------------------------------------------------------

pub fn buildWorld(gl: &mut GlContext, track: &Track): World {
    var builders: Vec<Builder> = Vec.new()
    for _i in 0..BUCKETS {
        builders.push(builder())
    }
    var pool: Vec<f64> = Vec.new()

    addRoad(builders[B_ROAD], track)
    addMarkings(builders[B_MARK], track)
    addCurbs(builders[B_CURB], track)
    addBarriers(builders[B_WALL], builders[B_NEON], track, pool)
    addFurniture(builders[B_STEEL], builders[B_NEON], track, pool)
    addStartLine(builders[B_MARK], builders[B_STEEL], builders[B_NEON], track, pool)
    addCity(builders[B_CITY], builders[B_NEON], builders[B_STEEL], track, pool)
    addPatios(builders[B_CITY], builders[B_STEEL], builders[B_NEON], track, pool)
    addGround(builders[B_GROUND], track)
    var pads: Vec<f64> = Vec.new()
    addBoostPads(builders[B_PAD], pads, track)

    var meshes: Vec<Mesh> = Vec.new()
    for i in 0..BUCKETS {
        var m = Mesh.new(gl, sceneAttrs())
        m.upload(builders[i].data.clone())
        meshes.push(m)
    }

    var mats: Vec<Material> = Vec.new()

    // Road. Dark, rough, and barely metallic: the wet look comes from the
    // roughness variation baked into the surface map, not from metalness.
    // Glossier than daytime asphalt on purpose. At night the road is lit almost
    // entirely by things beside it, and a rough surface returns that as a dull
    // even grey; dropping the roughness lets the barrier tubes, the shopfronts
    // and the car's own lamps streak down it, which is most of what makes a wet
    // city street read as a wet city street rather than as grey paper.
    var road = material(TEX_ASPHALT, 0.145, 0.145, 0.150, 0.44, 0.06)
    road.normalStrength = 0.7
    // A second copy of the aggregate at a quarter the size. The road runs from
    // under the bumper to four hundred metres away and one texture scale cannot
    // be right for both.
    road.detail = 4.0
    mats.push(road)

    var mark = material(TEX_ASPHALT, 0.90, 0.90, 0.94, 0.62, 0.0)
    mark.normalStrength = 0.4
    mats.push(mark)

    var curb = material(TEX_CONCRETE, 0.90, 0.90, 0.94, 0.70, 0.0)
    curb.normalStrength = 0.9
    // Self-lit, faintly. A red rumble strip lit only by moonlight is black, and
    // the edge of the road is the one thing a driver has to be able to see at
    // every point on the lap. The shader multiplies emissive by the vertex tint,
    // so the red blocks glow red and the white ones white out of one material.
    curb.emissive = v3(0.55, 0.55, 0.55)
    mats.push(curb)

    var wall = material(TEX_CONCRETE, 0.55, 0.56, 0.64, 0.80, 0.0)
    wall.normalStrength = 1.1
    mats.push(wall)

    var steel = material(TEX_STEEL, 0.42, 0.44, 0.52, 0.38, 0.85)
    steel.normalStrength = 1.2
    mats.push(steel)

    // The one emissive bucket. Black albedo so it contributes nothing to the
    // lit term, white emissive so the vertex tint is the whole colour.
    var neon = material(TEX_PAINT, 0.02, 0.02, 0.02, 0.40, 0.0)
    neon.emissive = v3(1.0, 1.0, 1.0)
    mats.push(neon)

    // The facade texture carries the floor lines, the mullions and every unlit
    // window, so the albedo here is white and the tint on each building is what
    // colours it.
    var cityM = material(TEX_FACADE, 1.0, 1.0, 1.0, 0.80, 0.04)
    cityM.normalStrength = 1.0
    mats.push(cityM)

    var glassM = material(TEX_GLASS, 0.05, 0.06, 0.09, 0.10, 0.40)
    mats.push(glassM)

    var ground = material(TEX_ASPHALT, 0.145, 0.140, 0.135, 0.94, 0.0)
    ground.normalStrength = 0.5
    mats.push(ground)

    // The boost pads. Black albedo and a white emissive so the vertex tint is
    // the whole colour, the same trick the neon bucket uses; the frame loop
    // rewrites `emissive` every frame to make them pulse.
    var pad = material(TEX_PAINT, 0.02, 0.02, 0.02, 0.45, 0.0)
    pad.emissive = v3(1.0, 1.0, 1.0)
    mats.push(pad)

    return World {
        meshes: meshes, mats: mats, pads: pads, lightPool: pool,
    }
}

impl World {
    fn free(self: Self, gl: &mut GlContext) {
        // Popped rather than iterated: `free` consumes the mesh, and `for m in`
        // binds by reference, so the loop cannot hand it over.
        var meshes = self.meshes
        while meshes.len > 0 {
            let m = meshes.pop()!
            m.free(gl)
        }
    }

    // The `max` lights nearest `at`, appended to `out` in the renderer's
    // packing. A full sort would be tidier; a partial selection over a hundred
    // candidates is a hundred distance tests and no allocation, and it runs
    // every frame.
    fn nearestLights(self: &Self, out: &mut Vec<f64>, at: &Vec3, max: i64) {
        let count = self.lightPool.len / LIGHT_FLOATS
        // Distance to each candidate, and a running set of the best `max`.
        var chosen: Vec<i64> = Vec.new()
        var chosenD: Vec<f64> = Vec.new()
        for i in 0..count {
            let o = i * LIGHT_FLOATS
            let dx = self.lightPool[o] - at.x
            let dy = self.lightPool[o + 1] - at.y
            let dz = self.lightPool[o + 2] - at.z
            let d = dx * dx + dy * dy + dz * dz
            // Past its own range it cannot contribute, so it is not a candidate
            // at all. This is what stops a lamp on the far side of the lap
            // taking a slot from the one overhead.
            let range = self.lightPool[o + 6]
            if d > range * range {
                continue
            }
            if chosen.len < max {
                chosen.push(i)
                chosenD.push(d)
                continue
            }
            // Replace the worst of the current set, if this beats it.
            var worst = 0
            var worstD = chosenD[0]
            for k in 1..chosen.len {
                if chosenD[k] > worstD {
                    worstD = chosenD[k]
                    worst = k
                }
            }
            if d < worstD {
                chosen[worst] = i
                chosenD[worst] = d
            }
        }
        for k in 0..chosen.len {
            let o = chosen[k] * LIGHT_FLOATS
            for f in 0..LIGHT_FLOATS {
                out.push(self.lightPool[o + f])
            }
        }
    }
}
