// The car: one lofted shell every car in the race shares, and the handling
// model underneath it.
//
// **One mesh, ten colours.** The body is built once and drawn ten times with ten
// `Material` values that differ only in albedo. Ten meshes would be ten uploads
// of the same eight hundred triangles, and the paint is a material property, not
// a shape property. The wheels are one wheel drawn four times with four
// matrices, which is also where the steering and the wheel spin live.
//
// **The handling is arcade, deliberately.** It is a forward/lateral split of the
// velocity in the car's own frame: the engine pushes along forward, the tyres
// eat lateral, and steering turns the *heading* while the velocity follows it at
// a rate set by grip. Lower the grip and the velocity lags the heading, which is
// a drift, and it comes out of the same three lines rather than out of a slip
// curve nobody can tune. A real tyre model is not more fun at 180 mph on a
// neon boulevard, it is just harder to steer with a keyboard.
//
// The car never leaves the ground plane. `y` is a constant and there is no
// suspension travel; the pitch and roll the body shows are cosmetic, driven by
// acceleration and yaw rate, because a chassis that stays rigid under braking
// reads as a prop being slid around rather than as a car.

from "std/math" import {
    Math
}
from "gl" import {
    GlContext, Mesh
}
from "./mesh" import {
    Builder, builder
}
from "./mat4" import {
    identity, multiply, rotationX, rotationY, rotationZ, translation
}
from "./render" import {
    Material, material, sceneAttrs
}
from "./textures" import {
    TEX_GLASS, TEX_PAINT, TEX_STEEL
}
from "./track" import {
    HALF_WIDTH, Track, WALL
}
from "./vec3" import {
    Vec3, v3
}

// Metres. The shell is the classic mid-engined wedge: 4.14 m long, 2.00 m wide
// and 1.07 m tall on a 2.45 m wheelbase, which is a car that is nearly twice as
// wide as it is high. Those are the real proportions of the reference and they
// are most of why it reads as that car and not as a generic supercar: get the
// height wrong by ten centimetres and the whole thing turns into a coupe.
pub let WHEELBASE: f64 = 2.45

// Wider than the sill, so the tyres stand proud of the bodywork under the
// arches. A car whose wheels are inside its own silhouette reads as a slot car:
// the gap between the tyre and the arch lip is most of what says "vehicle".
pub let TRACK_WIDTH: f64 = 1.70

pub let WHEEL_R: f64 = 0.345

let WHEEL_W: f64 = 0.36

// Flat-out on the long straight, in metres per second. 108 m/s is 242 mph.
//
// Raising this number is the least of what makes the game feel fast, and on its
// own it does almost nothing: a car that takes eight seconds to reach 240 spends
// the whole straight in the middle of its range, where nothing on screen is
// changing. What sells speed is the RATE - how hard the engine pulls, how fast
// the lens opens, how suddenly the frame starts to streak - so the acceleration
// below went up much further than this did.
let TOP_SPEED: f64 = 108.0

// Nitrous adds this fraction on top.
let BOOST_GAIN: f64 = 0.52

// A boost pad, and how long it lasts. Three and a half seconds at 100 m/s is
// three hundred and fifty metres, better than a tenth of the lap: long enough
// that the car is visibly travelling faster down a stretch of road rather than
// jumping and settling.
let PAD_TIME: f64 = 3.5

let PAD_GAIN: f64 = 0.40

// Thrust the pad adds on top of the engine, in m/s^2. Bigger than the bottle's:
// the bottle is a resource you spend and the pad is a reward you drove over, so
// the pad has to be the one you can feel arrive.
let PAD_PUSH: f64 = 34.0

let BOOST_DRAIN: f64 = 0.26

let BOOST_REGEN: f64 = 0.105

// Metres per second per second at a standstill, falling off as the car
// approaches its top speed. High: this is an arcade racer and the punch out of a
// hairpin is the thing you feel, not the terminal velocity you reach afterwards.
let ENGINE: f64 = 64.0

let BRAKE: f64 = 56.0

// Quadratic drag, tuned so coasting from top speed bleeds off believably rather
// than stopping the car dead.
let DRAG: f64 = 0.0016

let ROLL_RESIST: f64 = 0.34

// Radians of steering at the road wheel, before the speed falloff below.
let STEER_MAX: f64 = 0.70

// How hard the tyres pull the velocity back in line with the heading, per
// second. This one number is the whole difference between a kart and a boat.
let GRIP_ROAD: f64 = 9.4

let GRIP_DIRT: f64 = 3.6

let GRIP_HANDBRAKE: f64 = 2.1

// How much of the speed heading into a barrier comes back out of it. Small: a
// barrier that returns most of the energy is a pinball bumper and throws the car
// across the road, and one that returns none pins it to the wall.
let WALL_BOUNCE: f64 = 0.28

// ---------------------------------------------------------------------------
// The shell
// ---------------------------------------------------------------------------

// A car is five meshes because it is five materials, not because it is five
// objects. Splitting by material is what lets the glass be glass, the carbon be
// carbon and the lamps be emissive without a per-pixel branch in the shader.
pub struct CarModel {
    body: Mesh,
    // The exhaust plume, built pointing down -Z from the origin and placed by
    // the matrix at draw time. It is the only part of the car that is not there
    // every frame.
    flame: Mesh,
    // Everything that is not painted the car's colour: splitter, skirts, wing,
    // mirrors, vents, exhausts and the stripes over the roof. Its material has a
    // white albedo and the colour is carried per vertex, so one draw paints
    // carbon black and racing white at once.
    trim: Mesh,
    glass: Mesh,
    wheel: Mesh,
    // Head and tail lamps, and the underglow. Emissive, with the colour carried
    // per vertex so one material paints white at the front and red at the back.
    lamps: Mesh,
}

// A cross-section of the shell, at one station along the car:
//
//   z   distance from the centre of the car, positive forward
//   hw  half width at the shoulder, the widest point of the section
//   yb  floor
//   yt  roof
//   ys  shoulder height, where the section is at its widest
//   rw  half width at the roof line
//   bw  half width at the floor
//
// The loft between consecutive stations is the whole silhouette; these numbers
// are the car. Read down the `hw` column and you can see the two arches bulge
// out over the wheels and the waist pull in between them, which is what a mid
// engined car actually does and what a box with a wedge on it never does.
fn stations(): Vec<f64> {
    return [
    // z,     hw,    yb,    yt,    ys,    rw,    bw
    // Nose: 44 cm off the road at the leading edge. The single straight line
    // from here up to the base of the screen is the wedge, and it is the one
    // measurement that cannot be fudged.
    2.07, 0.60, 0.22, 0.44, 0.36, 0.46, 0.44, 1.85, 0.75, 0.20, 0.50, 0.40, 0.60, 0.55, 1.55, 0.87, 0.17, 0.56, 0.45, 0.74, 0.62,
    // Front arch. It bulges, but nothing like the rear one: this car carries
    // its width at the back.
    1.22, 0.95, 0.16, 0.62, 0.50, 0.84, 0.66, 0.95, 0.94, 0.16, 0.66, 0.54, 0.82, 0.66,
    // Cowl. From here the roof line climbs 40 cm in 80 cm of length, which is
    // the near-vertical screen rake the reference is known for.
    //
    // `ys` climbs with it. The shoulder is where the section is widest and so
    // where the flank stops being vertical, and through the cabin it belongs up
    // at door-top height: put it back down at mid-door and the sides start
    // tumbling inward from the middle of the body, which hollows the greenhouse
    // out and turns the whole car into an open buggy with a headrest.
    0.72, 0.93, 0.16, 0.80, 0.62, 0.72, 0.66, 0.42, 0.93, 0.17, 0.96, 0.70, 0.60, 0.66,
    // Roof, flat and short. Only 36 cm of it.
    0.14, 0.93, 0.18, 1.07, 0.76, 0.55, 0.66, -0.22, 0.94, 0.19, 1.07, 0.78, 0.55, 0.66,
    // Rear screen, then the engine deck, which stays high all the way back.
    -0.52, 0.97, 0.20, 1.02, 0.78, 0.66, 0.66, -0.86, 1.00, 0.21, 0.97, 0.76, 0.80, 0.66,
    // Rear haunch: the widest point of the car, over the back axle.
    -1.20, 1.00, 0.22, 0.95, 0.74, 0.88, 0.64, -1.55, 1.00, 0.24, 0.94, 0.72, 0.90, 0.60, -1.85, 0.98, 0.28, 0.93, 0.70, 0.90, 0.54,
    // The tail is cut off square rather than tapered. A Kamm tail is a shape
    // the loft gets for free by keeping the last section nearly full width and
    // letting `capEnd` close it flat; taper it and the car turns into a teardrop.
    -2.07, 0.95, 0.34, 0.92, 0.68, 0.88, 0.48,]
}

// The wheel well: how far up and along the flank the arch opening reaches, and
// how far in the wall behind the tyre sits.
let WELL_R: f64 = 0.455

let WELL_X: f64 = 0.70

let STATION_FLOATS: i64 = 7

// Points around one cross-section. Enough that the shoulder line is a curve
// rather than a chamfer: at eight the car is a gem, at twenty-eight it is a
// body, and the whole shell is still under five thousand triangles.
let RING: i64 = 28

// How boxy a section is. 2 would be an ellipse and the car would read as a
// lozenge. This car is folded out of flat planes with hard creases between
// them, so it wants to be nearly a rectangle: 6.2 gives a flat roof, a flat
// floor and flanks that are genuinely vertical, with only a small radius left
// at the shoulder and the sill.
let SECTION_N: f64 = 6.2

fn spow(x: f64, e: f64): f64 {
    let a = Math.pow(Math.abs(x), e)
    if x < 0.0 {
        return -a
    }
    return a
}

// One point on the outline of a section, `k` running counter-clockwise seen from
// the front and starting at the right-hand shoulder. The section is a
// superellipse whose half width is then pulled in toward the roof width above
// the shoulder and toward the floor width below it, which is what gives a
// tumblehome and a tucked sill out of one expression.
fn ringAt(hw: f64, yb: f64, yt: f64, ys: f64, rw: f64, bw: f64, k: i64): Vec3 {
    let a = 2.0 * Math.pi() * (k as f64) / (RING as f64)
    let c = Math.cos(a)
    let sn = Math.sin(a)
    let e = 2.0 / SECTION_N
    let up = sn >= 0.0
    let h = if up {
        yt - ys
    } else {
        ys - yb
    }
    let target = if up {
        rw
    } else {
        bw
    }
    let t = Math.pow(Math.abs(spow(sn, e)), 1.35)
    let width = hw + (target - hw) * t
    return v3(spow(c, e) * width, ys + spow(sn, e) * h, 0.0)
}

// The lofted shell, with normals from the surface rather than from the winding.
// Flat-shaded quads on a body this curved read as a faceted gem: the highlight
// that runs down the flank of a car is a single continuous band, and it only
// exists if the normals vary continuously along the section.
fn bodyGeometry(b: &mut Builder) {
    let st = stations()
    let count = st.len / STATION_FLOATS

    // The whole grid first, because a normal needs its neighbours on both axes.
    var pts: Vec<Vec3> = Vec.new()
    for i in 0..count {
        let o = i * STATION_FLOATS
        for k in 0..RING {
            var p = ringAt(st[o + 1], st[o + 2], st[o + 3], st[o + 4], st[o + 5], st[o + 6], k)
            p.z = st[o]
            pts.push(p)
        }
    }
    // Cut the wheel wells. Clamping the flank inward inside a circle around
    // each axle turns the solid side into an opening with a wall behind it, and
    // the loft's own edge along that circle IS the arch lip. Modelling the lip
    // as a separate ring instead leaves the tyre standing in front of an unbroken
    // flank, which is what makes a car read as a toy with wheels stuck on.
    for i in 0..count {
        for k in 0..RING {
            let idx = i * RING + k
            let p = pts[idx]
            if Math.abs(p.x) <= WELL_X {
                continue
            }
            var zw = WHEELBASE * 0.5
            if p.z < 0.0 {
                zw = -WHEELBASE * 0.5
            }
            let dz = p.z - zw
            let dy = Math.maxF64(p.y - WHEEL_R, 0.0)
            if Math.sqrt(dz * dz + dy * dy) >= WELL_R {
                continue
            }
            let sign = if p.x > 0.0 {
                1.0
            } else {
                -1.0
            }
            pts[idx].x = sign * WELL_X
        }
    }

    var nrm: Vec<Vec3> = Vec.new()
    for i in 0..count {
        for k in 0..RING {
            let kp = (k + 1) % RING
            let km = (k + RING - 1) % RING
            let along = pts[i * RING + kp] - pts[i * RING + km]
            let ia = Math.maxI64(0, i - 1)
            let ib = Math.minI64(count - 1, i + 1)
            let ahead = pts[ib * RING + k] - pts[ia * RING + k]
            // Ring tangent crossed with the lengthwise tangent, which points out
            // of the shell for a ring wound counter-clockwise from the front.
            var n = along.cross(ahead)
            if n.len2() < 1e-9 {
                n = v3(pts[i * RING + k].x, 0.2, 0.0)
            }
            nrm.push(n.norm())
        }
    }

    b.setUvScale(0.75)
    b.setAo(1.0)
    var i = 0
    while i + 1 < count {
        for k in 0..RING {
            let k2 = (k + 1) % RING
            let a = i * RING + k
            let bIdx = i * RING + k2
            let c = (i + 1) * RING + k2
            let d = (i + 1) * RING + k
            let u0 = (k as f64) / (RING as f64) * 3.0
            let u1 = ((k + 1) as f64) / (RING as f64) * 3.0
            let v0 = pts[a].z
            let v1 = pts[d].z
            b.push(pts[a], nrm[a], u0, v0)
            b.push(pts[bIdx], nrm[bIdx], u1, v0)
            b.push(pts[c], nrm[c], u1, v1)
            b.push(pts[a], nrm[a], u0, v0)
            b.push(pts[c], nrm[c], u1, v1)
            b.push(pts[d], nrm[d], u0, v1)
        }
        i = i + 1
    }

    // Nose and tail caps, as fans onto the centre of the end section. They are
    // nearly edge-on from the chase camera and exist mostly so the shell is
    // watertight for the shadow pass.
    capEnd(&mut b, pts, 0, true)
    capEnd(&mut b, pts, count - 1, false)

}

// A flat cap across one end section, so the loft is closed.
fn capEnd(b: &mut Builder, pts: &Vec<Vec3>, idx: i64, front: bool) {
    let base = idx * RING
    var centre = v3(0.0, 0.0, pts[base].z)
    var sum = 0.0
    for k in 0..RING {
        sum = sum + pts[base + k].y
    }
    centre.y = sum / (RING as f64)
    let n = if front {
        v3(0.0, 0.0, 1.0)
    } else {
        v3(0.0, 0.0, -1.0)
    }
    for k in 0..RING {
        let k2 = (k + 1) % RING
        let pa = pts[base + k]
        let pd = pts[base + k2]
        if front {
            b.push(centre, n, 0.5, 0.5)
            b.push(pd, n, 1.0, 0.0)
            b.push(pa, n, 0.0, 0.0)
        } else {
            b.push(centre, n, 0.5, 0.5)
            b.push(pa, n, 0.0, 0.0)
            b.push(pd, n, 1.0, 0.0)
        }
    }
}

// Everything that is not the paint. The tint carries the colour, so carbon,
// polished metal and the racing stripes come out of one material and one draw.
let CARBON_R: f64 = 0.055
let CARBON_G: f64 = 0.055
let CARBON_B: f64 = 0.065

fn carbon(b: &mut Builder) {
    b.setTint(CARBON_R, CARBON_G, CARBON_B)
}

fn trimGeometry(b: &mut Builder) {
    b.setUvScale(1.2)
    b.setAo(0.95)

    // Front spoiler: one wide low lip under the nose, not a race splitter with
    // dive planes. This car's front end is a plain folded plane and hanging
    // aero off it is what turns it into a generic modern supercar.
    carbon(&mut b)
    b.boxSpan(v3(-0.92, 0.10, 1.82), v3(0.92, 0.19, 2.14))
    b.boxSpan(v3(-0.96, 0.19, 1.90), v3(-0.66, 0.30, 2.10))
    b.boxSpan(v3(0.66, 0.19, 1.90), v3(0.96, 0.30, 2.10))

    // The nose vents: a slot each side of the badge panel, sunk into the wedge.
    b.boxSpan(v3(-0.60, 0.30, 1.98), v3(-0.22, 0.40, 2.05))
    b.boxSpan(v3(0.22, 0.30, 1.98), v3(0.60, 0.40, 2.05))

    // Pop-up headlamp pods, down. Their shut lines across the top of the wedge
    // are the whole front-end detail when the lamps are stowed, and stowed is
    // how this car is shaped: raise them and the nose stops being a wedge.
    b.boxSpan(v3(-0.80, 0.52, 1.44), v3(-0.34, 0.56, 1.74))
    b.boxSpan(v3(0.34, 0.52, 1.44), v3(0.80, 0.56, 1.74))

    // The shut line down the middle of the bonnet, and the wiper.
    b.boxSpan(v3(-0.03, 0.56, 0.98), v3(0.03, 0.60, 1.80))
    b.boxSpan(v3(-0.34, 0.66, 0.86), v3(0.30, 0.70, 0.92))

    // Sills, running between the arches under the doors.
    b.boxSpan(v3(-0.99, 0.13, -1.10), v3(-0.84, 0.32, 1.02))
    b.boxSpan(v3(0.84, 0.13, -1.10), v3(0.99, 0.32, 1.02))

    // The NACA duct in each door: a shallow scoop let into the flat of the
    // flank, widening toward its rear edge.
    naca(&mut b, -1.0)
    naca(&mut b, 1.0)

    // The ear scoops behind the doors. Two boxes standing proud of the shoulder,
    // one per side, feeding the engine bay. On the reference these are the
    // single most recognisable thing about the car from behind, and the flank is
    // a slab without them.
    carbon(&mut b)
    var side = -1.0
    while side < 2.0 {
        let x = side * 0.94
        b.boxSpan(v3(x - 0.075, 0.74, -0.86), v3(x + 0.075, 0.90, -0.40))
        b.boxSpan(v3(x - 0.085, 0.72, -0.90), v3(x + 0.085, 0.78, -0.80))
        side = side + 2.0
    }

    // Mirrors, on stalks.
    side = -1.0
    while side < 2.0 {
        let x = side * 0.95
        b.boxSpan(v3(x - 0.04, 0.84, 0.62), v3(x + 0.18 * side + 0.04, 0.88, 0.74))
        b.boxSpan(v3(x + 0.13 * side - 0.09, 0.82, 0.56), v3(x + 0.13 * side + 0.09, 0.97, 0.70))
        side = side + 2.0
    }

    // The rear screen is a slatted grille, not glass. Eight louvres laid over
    // the opening at the same rake as the screen behind them, which is why you
    // cannot see into this car from behind and why the deck reads as engine
    // rather than as a parcel shelf.
    for i in 0..8 {
        let t = (i as f64) / 7.0
        let z = -0.34 - t * 0.50
        // Ride the roof line down from the back of the cabin to the deck. These
        // sit ON the shell: run them along a straight ramp instead and the back
        // half of the set stands off the bodywork as a row of fins.
        let y = 1.045 - t * t * 0.075 - t * 0.015
        b.boxSpan(v3(-0.60, y, z), v3(0.60, y + 0.030, z + 0.040))
    }

    // Engine cover: two grille panels either side of a raised spine.
    b.boxSpan(v3(-0.70, 0.955, -1.44), v3(-0.10, 0.985, -0.94))
    b.boxSpan(v3(0.10, 0.955, -1.44), v3(0.70, 0.985, -0.94))
    b.boxSpan(v3(-0.07, 0.96, -1.48), v3(0.07, 1.00, -0.90))

    // The rear wing: a single wide blade on two uprights, sitting just above the
    // deck and overhanging the tail. Flat and thin, the way the factory one is,
    // rather than a swan-neck race wing.
    b.boxSpan(v3(-0.47, 0.94, -1.98), v3(-0.39, 1.14, -1.84))
    b.boxSpan(v3(0.39, 0.94, -1.98), v3(0.47, 1.14, -1.84))
    b.boxSpan(v3(-0.80, 1.14, -2.04), v3(0.80, 1.175, -1.78))
    b.boxSpan(v3(-0.82, 1.11, -2.05), v3(-0.77, 1.21, -1.77))
    b.boxSpan(v3(0.77, 1.11, -2.05), v3(0.82, 1.21, -1.77))

    // The rear valance below the lamps, with the number plate recess in it.
    b.boxSpan(v3(-0.82, 0.28, -2.11), v3(0.82, 0.44, -2.03))
    b.setTint(0.55, 0.56, 0.58)
    b.boxSpan(v3(-0.15, 0.31, -2.118), v3(0.15, 0.42, -2.112))
    // A black surround behind each lamp cluster, NOT one panel across the tail.
    // Spanning it blacks out the whole rear face, and the rear face of this car
    // is mostly body colour with the lamps let into it: paint over that and from
    // the chase camera the car has no colour at all where you look at it most.
    carbon(&mut b)
    b.boxSpan(v3(-0.76, 0.60, -2.09), v3(-0.28, 0.79, -2.065))
    b.boxSpan(v3(0.28, 0.60, -2.09), v3(0.76, 0.79, -2.065))

    // Quad exhausts in the centre of the valance, close together the way they
    // are on the real car rather than spread across the whole tail.
    // Quad exhausts, recessed into a black cutout in the valance rather than
    // standing out on the end of it. Sticking the pipes out past the bodywork is
    // what turns a tail into a plumbing rack.
    carbon(&mut b)
    b.boxSpan(v3(-0.23, 0.33, -2.10), v3(0.23, 0.47, -2.055))
    b.setTint(0.72, 0.74, 0.80)
    b.resetXform()
    var e = 0
    while e < 4 {
        let x = -0.165 + (e as f64) * 0.11
        b.cylinderZ(v3(x, 0.40, -2.11), 0.038, 0.055, 8, true)
        e = e + 1
    }

    // No racing stripes. They used to run the length of the shell, sampled from
    // the station table through `topAt`, which inverts the section's width blend
    // numerically. That inversion is only as good as the section is round: with
    // the flanks flattened out to the near-rectangle this body wants, whole
    // stretches of it solve to the wrong height and the stripe lifts off the
    // paint as a rod floating over the car. The reference car is plain anyway.
}

// The NACA duct in a door: a shallow trough sunk into the flank, narrow at its
// front and opening out at the back. Three tapering slabs is enough for
// something read at thirty degrees off and forty miles an hour.
fn naca(b: &mut Builder, side: f64) {
    carbon(&mut b)
    let x = side * 0.945
    var i = 0
    while i < 3 {
        let t = (i as f64) / 3.0
        let z = 0.52 - t * 0.62
        let h = 0.035 + t * 0.075
        b.boxSpan(v3(x - 0.03, 0.55 - h, z - 0.22), v3(x + 0.03, 0.55 + h, z))
        i = i + 1
    }
}

// Windscreen, side glass and rear window, sitting proud of the shell so they
// never z-fight with the panel behind them.
fn glassGeometry(b: &mut Builder) {
    b.setTint(1.0, 1.0, 1.0)
    b.setUvScale(0.6)
    let e = 0.016
    // Windscreen. It climbs from the cowl at 0.66 to the roof at 1.07 in 80 cm,
    // which is a rake of about 27 degrees off horizontal: this is the one panel
    // that makes the profile read as the reference rather than as a coupe.
    b.quad(v3(-0.78 - e, 0.68 + e, 0.90), v3(0.78 + e, 0.68 + e, 0.90), v3(0.56 + e, 1.07 + e, 0.16), v3(-0.56 - e, 1.07 + e, 0.16), 1.0, 1.0)
    // Side glass. Small and shallow: this car has almost no greenhouse, and
    // giving it a normal one is the fastest way to lose the silhouette.
    b.quad(v3(-0.93, 0.72, 0.78), v3(-0.90, 1.02, 0.20), v3(-0.93, 1.02, -0.26), v3(-0.97, 0.80, -0.42), 1.0, 1.0)
    b.quad(v3(0.97, 0.80, -0.42), v3(0.93, 1.02, -0.26), v3(0.90, 1.02, 0.20), v3(0.93, 0.72, 0.78), 1.0, 1.0)
}

// The lamps. Tint carries the colour because one emissive material paints all of
// them: white at the nose, red at the tail, and cold blue under the sills.
fn lampGeometry(b: &mut Builder) {
    b.setUvScale(1.0)
    b.setAo(1.0)
    // Front. The main lamps are stowed in their pods, so what is lit at the nose
    // is the pair of driving lights in the spoiler and the indicator each side.
    b.setTint(1.8, 1.72, 1.50)
    b.boxSpan(v3(-0.54, 0.22, 2.11), v3(-0.32, 0.29, 2.14))
    b.boxSpan(v3(0.32, 0.22, 2.11), v3(0.54, 0.29, 2.14))
    b.setTint(1.5, 0.62, 0.10)
    b.boxSpan(v3(-0.88, 0.34, 2.00), v3(-0.66, 0.42, 2.05))
    b.boxSpan(v3(0.66, 0.34, 2.00), v3(0.88, 0.42, 2.05))

    // Tail: two clusters, one each side, sunk into the black rear panel. A
    // single full-width bar is a modern car's signature and reads as the wrong
    // decade; the gap between the clusters is what the reference actually shows.
    // Two rectangles per side inside each surround: the brake/tail pair inboard
    // and the indicator outboard. Rectangles rather than the discs that were
    // here before, because a 6 cm disc at chase-camera distance is two pixels
    // and all of them bloomed into one blob in the middle of the car.
    var side = -1.0
    while side < 2.0 {
        b.setTint(2.05, 0.070, 0.032)
        b.boxSpan(v3(side * 0.32 - 0.005, 0.635, -2.10), v3(side * 0.70 + 0.005, 0.755, -2.078))
        // The brake element, brighter and inboard, so a car braking ahead of you
        // changes shape as well as brightness.
        b.setTint(3.30, 0.115, 0.05)
        b.boxSpan(v3(side * 0.34 - 0.004, 0.665, -2.102), v3(side * 0.52 + 0.004, 0.730, -2.082))
        b.setTint(2.10, 0.68, 0.05)
        b.boxSpan(v3(side * 0.56 - 0.004, 0.665, -2.102), v3(side * 0.68 + 0.004, 0.730, -2.082))
        side = side + 2.0
    }
    // Reversing lamps, small and low in the valance either side of the pipes.
    b.setTint(0.95, 0.95, 0.90)
    b.boxSpan(v3(-0.40, 0.33, -2.115), v3(-0.31, 0.39, -2.108))
    b.boxSpan(v3(0.31, 0.33, -2.115), v3(0.40, 0.39, -2.108))

    // Underglow. Nothing on a real car does this and every car in an arcade
    // racer does: it is what puts the machine on the road at night, and it is
    // the cheapest reflection in the game.
    b.setTint(0.14, 0.80, 1.10)
    b.boxSpan(v3(-0.90, 0.10, -1.50), v3(-0.78, 0.14, 1.40))
    b.boxSpan(v3(0.78, 0.10, -1.50), v3(0.90, 0.14, 1.40))
    b.boxSpan(v3(-0.78, 0.10, -1.62), v3(0.78, 0.14, -1.50))
    b.boxSpan(v3(-0.78, 0.10, 1.40), v3(0.78, 0.14, 1.52))
}

// The exhaust plume: four nested cones per pipe, hottest and thinnest in the
// middle. Built around the origin pointing down -Z so the frame loop can stretch
// it with a scale on one axis and leave the pipes where they are.
fn flameGeometry(b: &mut Builder) {
    b.setUvScale(1.0)
    b.setAo(1.0)
    var e = 0
    while e < 4 {
        let x = -0.26 + (e as f64) * 0.173
        // Core, mid and outer: three cones, each longer and dimmer than the one
        // inside it. A single cone reads as a traffic cone; the nesting is what
        // makes it read as combustion.
        cone(&mut b, x, 0.055, 0.55, 9.0, 8.4, 6.0)
        cone(&mut b, x, 0.085, 1.00, 7.0, 2.60, 0.45)
        cone(&mut b, x, 0.115, 1.55, 3.4, 0.55, 0.12)
        e = e + 1
    }
}

fn cone(b: &mut Builder, x: f64, radius: f64, length: f64, r: f64, g: f64, bl: f64) {
    b.setTint(r, g, bl)
    let segs = 10
    let tip = v3(x, 0.0, -length)
    for i in 0..segs {
        let a0 = 2.0 * Math.pi() * (i as f64) / (segs as f64)
        let a1 = 2.0 * Math.pi() * ((i + 1) as f64) / (segs as f64)
        let p0 = v3(x + Math.cos(a0) * radius, Math.sin(a0) * radius, 0.0)
        let p1 = v3(x + Math.cos(a1) * radius, Math.sin(a1) * radius, 0.0)
        let n0 = v3(Math.cos(a0), Math.sin(a0), 0.0)
        let n1 = v3(Math.cos(a1), Math.sin(a1), 0.0)
        b.push(p0, n0, 0.0, 0.0)
        b.push(p1, n1, 1.0, 0.0)
        b.push(tip, n0, 0.5, 1.0)
        // Both windings, so the plume is solid seen from any side with back-face
        // culling on.
        b.push(p1, n1, 1.0, 0.0)
        b.push(p0, n0, 0.0, 0.0)
        b.push(tip, n1, 0.5, 1.0)
    }
}

// One wheel, axle along X, centred on the origin. Tyre, dished rim with five
// spokes, a drilled disc behind it and a caliper over that, all in one mesh: the
// tint does the work, so a wheel is one draw and not four.
fn wheelGeometry(b: &mut Builder) {
    let segs = 26
    let hw = WHEEL_W * 0.5
    let rimR = WHEEL_R * 0.66
    b.setUvScale(1.0)
    for i in 0..segs {
        let a0 = 2.0 * Math.pi() * (i as f64) / (segs as f64)
        let a1 = 2.0 * Math.pi() * ((i + 1) as f64) / (segs as f64)
        let c0 = Math.cos(a0)
        let s0 = Math.sin(a0)
        let c1 = Math.cos(a1)
        let s1 = Math.sin(a1)
        // Tread band, with a shoulder radius either side so the tyre is round in
        // section and not a cylinder with square edges.
        b.setTint(0.085, 0.085, 0.095)
        let sh = 0.055
        let rSh = WHEEL_R - 0.035
        let p0 = v3(-hw + sh, c0 * WHEEL_R, s0 * WHEEL_R)
        let p1 = v3(-hw + sh, c1 * WHEEL_R, s1 * WHEEL_R)
        let p2 = v3(hw - sh, c1 * WHEEL_R, s1 * WHEEL_R)
        let p3 = v3(hw - sh, c0 * WHEEL_R, s0 * WHEEL_R)
        b.push(p0, v3(0.0, c0, s0), 0.0, 0.0)
        b.push(p1, v3(0.0, c1, s1), 0.6, 0.0)
        b.push(p2, v3(0.0, c1, s1), 0.6, 0.4)
        b.push(p0, v3(0.0, c0, s0), 0.0, 0.0)
        b.push(p2, v3(0.0, c1, s1), 0.6, 0.4)
        b.push(p3, v3(0.0, c0, s0), 0.0, 0.4)
        // Shoulders.
        let q0 = v3(-hw, c0 * rSh, s0 * rSh)
        let q1 = v3(-hw, c1 * rSh, s1 * rSh)
        let n0 = v3(-0.6, c0 * 0.8, s0 * 0.8).norm()
        let n1 = v3(-0.6, c1 * 0.8, s1 * 0.8).norm()
        b.push(p0, n0, 0.0, 0.0)
        b.push(q0, n0, 0.2, 0.0)
        b.push(q1, n1, 0.2, 0.2)
        b.push(p0, n0, 0.0, 0.0)
        b.push(q1, n1, 0.2, 0.2)
        b.push(p1, n1, 0.0, 0.2)
        let r0 = v3(hw, c0 * rSh, s0 * rSh)
        let r1 = v3(hw, c1 * rSh, s1 * rSh)
        let m0 = v3(0.6, c0 * 0.8, s0 * 0.8).norm()
        let m1 = v3(0.6, c1 * 0.8, s1 * 0.8).norm()
        b.push(p3, m0, 0.0, 0.0)
        b.push(r1, m1, 0.2, 0.2)
        b.push(r0, m0, 0.2, 0.0)
        b.push(p3, m0, 0.0, 0.0)
        b.push(p2, m1, 0.0, 0.2)
        b.push(r1, m1, 0.2, 0.2)
        // Sidewalls, in to the rim lip.
        b.setTint(0.11, 0.11, 0.12)
        let w0 = v3(-hw + 0.02, c0 * rimR, s0 * rimR)
        let w1 = v3(-hw + 0.02, c1 * rimR, s1 * rimR)
        let outN = v3(-1.0, 0.0, 0.0)
        b.push(q1, outN, 0.0, 0.0)
        b.push(q0, outN, 0.4, 0.0)
        b.push(w0, outN, 0.4, 0.4)
        b.push(q1, outN, 0.0, 0.0)
        b.push(w0, outN, 0.4, 0.4)
        b.push(w1, outN, 0.0, 0.4)
        let x0 = v3(hw - 0.02, c0 * rimR, s0 * rimR)
        let x1 = v3(hw - 0.02, c1 * rimR, s1 * rimR)
        let inN = v3(1.0, 0.0, 0.0)
        b.push(r0, inN, 0.0, 0.0)
        b.push(r1, inN, 0.4, 0.0)
        b.push(x1, inN, 0.4, 0.4)
        b.push(r0, inN, 0.0, 0.0)
        b.push(x1, inN, 0.4, 0.4)
        b.push(x0, inN, 0.0, 0.4)
        // Rim barrel, bright.
        b.setTint(0.80, 0.83, 0.90)
        b.push(w0, v3(0.0, c0, s0), 0.0, 0.0)
        b.push(x0, v3(0.0, c0, s0), 0.3, 0.0)
        b.push(x1, v3(0.0, c1, s1), 0.3, 0.3)
        b.push(w0, v3(0.0, c0, s0), 0.0, 0.0)
        b.push(x1, v3(0.0, c1, s1), 0.3, 0.3)
        b.push(w1, v3(0.0, c1, s1), 0.0, 0.3)
    }

    // Five spokes and a hub on the outer face. The wheel is the part of the car
    // nearest the camera in every cornering shot, and a flat disc there is the
    // single most obvious piece of missing modelling on a car.
    let face = -WHEEL_W * 0.5 + 0.01
    let outN = v3(-1.0, 0.0, 0.0)
    for i in 0..5 {
        let a = 2.0 * Math.pi() * (i as f64) / 5.0
        let ca = Math.cos(a)
        let sa = Math.sin(a)
        let pa = Math.cos(a + 0.30)
        let sb = Math.sin(a + 0.30)
        let pb = Math.cos(a - 0.30)
        let sc = Math.sin(a - 0.30)
        b.setTint(0.74, 0.77, 0.86)
        // A tapered spoke: wide at the rim, narrow at the hub.
        b.push(v3(face, ca * 0.09, sa * 0.09), outN, 0.5, 0.5)
        b.push(v3(face, pa * rimR * 0.96, sb * rimR * 0.96), outN, 1.0, 0.0)
        b.push(v3(face, pb * rimR * 0.96, sc * rimR * 0.96), outN, 0.0, 0.0)
    }
    b.setTint(0.55, 0.57, 0.64)
    b.resetXform()
    b.cylinderX(v3(face - 0.02, 0.0, 0.0), 0.075, 0.05, 12, true)

    // The disc behind the spokes, and a caliper over it. Both are only ever seen
    // through the gaps, which is exactly why they have to be there.
    b.setTint(0.22, 0.23, 0.26)
    b.resetXform()
    b.cylinderX(v3(-0.02, 0.0, 0.0), WHEEL_R * 0.60, 0.04, 20, true)
    b.setTint(1.20, 0.20, 0.10)
    b.boxSpan(v3(-0.05, 0.10, -WHEEL_R * 0.62), v3(0.06, WHEEL_R * 0.62, -WHEEL_R * 0.30))
}

pub fn buildCarModel(gl: &mut GlContext): CarModel {
    var bb = builder()
    bodyGeometry(&mut bb)
    var body = Mesh.new(&mut gl, sceneAttrs())
    body.upload(bb.data.clone())

    var tb = builder()
    trimGeometry(&mut tb)
    var trim = Mesh.new(&mut gl, sceneAttrs())
    trim.upload(tb.data.clone())

    var gb = builder()
    glassGeometry(&mut gb)
    var glass = Mesh.new(&mut gl, sceneAttrs())
    glass.upload(gb.data.clone())

    var wb = builder()
    wheelGeometry(&mut wb)
    var wheel = Mesh.new(&mut gl, sceneAttrs())
    wheel.upload(wb.data.clone())

    var fb = builder()
    flameGeometry(&mut fb)
    var flame = Mesh.new(&mut gl, sceneAttrs())
    flame.upload(fb.data.clone())

    var lb = builder()
    lampGeometry(&mut lb)
    var lamps = Mesh.new(&mut gl, sceneAttrs())
    lamps.upload(lb.data.clone())

    return CarModel {
        body: body, flame: flame, trim: trim, glass: glass, wheel: wheel, lamps: lamps,
    }
}

impl CarModel {
    fn free(self: Self, gl: &mut GlContext) {
        self.body.free(&mut gl)
        self.flame.free(&mut gl)
        self.trim.free(&mut gl)
        self.glass.free(&mut gl)
        self.wheel.free(&mut gl)
        self.lamps.free(&mut gl)
    }
}

// Paint for one car. Only the albedo differs between the ten, which is the
// whole reason there is one body mesh. Low roughness and a little metalness is
// clearcoat: it is what makes the sunset run down the flank as a band rather
// than sit on it as a wash.
pub fn paintMaterial(r: f64, g: f64, b: f64): Material {
    var m = material(TEX_PAINT, r, g, b, 0.22, 0.10)
    m.normalStrength = 0.4
    return m
}

// The trim: white albedo, colour from the vertex tint, so carbon and polished
// metal and a racing stripe are one draw.
pub fn trimMaterial(): Material {
    var m = material(TEX_PAINT, 1.0, 1.0, 1.0, 0.34, 0.55)
    m.normalStrength = 0.6
    return m
}

// Glass. The albedo is dark because glass is, but not black: at 0.04 with a
// mirror roughness the cabin returns only whatever happens to be reflected in
// it, and on a street at dusk that is nothing, so the greenhouse comes out as a
// hole cut in the car. Lifting the albedo and roughening it slightly gives the
// screen a body of its own to sit on top of the reflection.
pub fn glassMaterial(): Material {
    var m = material(TEX_GLASS, 0.10, 0.115, 0.145, 0.11, 0.30)
    m.normalStrength = 0.3
    return m
}

pub fn wheelMaterial(): Material {
    var m = material(TEX_STEEL, 1.0, 1.0, 1.0, 0.38, 0.55)
    m.normalStrength = 0.8
    return m
}

// Emissive white, masked by nothing: the tint in the mesh is what colours each
// lamp, so the head lamps and the tail lamps come out of one draw.
// The plume. Emissive like the lamps, and the one material in the game whose
// emissive is changed per frame: the flame flickers by brightness rather than by
// rebuilding its geometry.
pub fn flameMaterial(k: f64): Material {
    var m = material(TEX_PAINT, 0.0, 0.0, 0.0, 0.5, 0.0)
    m.emissive = v3(k, k, k)
    return m
}

pub fn lampMaterial(): Material {
    var m = material(TEX_PAINT, 0.02, 0.02, 0.02, 0.35, 0.0)
    m.emissive = v3(1.0, 1.0, 1.0)
    return m
}

// ---------------------------------------------------------------------------
// The car
// ---------------------------------------------------------------------------

pub struct Car {
    pos: Vec3,
    // Heading. 0 looks down +Z, and it grows turning to the right, which is the
    // same convention the camera uses.
    yaw: f64,
    vel: Vec3,

    // Cosmetic only. The chassis does not move relative to the wheels.
    roll: f64,
    pitch: f64,
    steerVis: f64,
    wheelSpin: f64,

    // Where the car is on the circuit. `hint` is the sample `locate` starts its
    // search from, and keeping it per car is what makes that search a window
    // instead of a scan.
    hint: i64,
    s: f64,
    lateral: f64,
    lap: i64,
    // The lap counter only advances when `s` wraps forward past the line, and
    // this is what remembers which side of it the car was on last frame.
    prevS: f64,
    // Set for the frame the car is outside the road proper. Drives the grip
    // model and the dust the renderer draws.
    offTrack: bool,
    // Set for the frame the car is put back by the barrier.
    scraping: bool,
    // How much of the bottle is lit right now, 0 to 1, and how much is left in
    // it. Two numbers rather than one: the gauge has to fall while the boost is
    // held and refill while it is not, and the thrust has to ramp in and out
    // faster than either of those.
    boost: f64,
    tank: f64,
    // Seconds of boost-pad thrust left. A pad is a sustained push, not an
    // impulse: adding the speed in one frame is over before the eye can read it
    // and the drag has eaten it back within a second, so what the player gets is
    // a bang and no journey. Held open instead, the pad is a stretch of road you
    // are visibly travelling faster down.
    pad: f64,
    colour: Vec3,
}

pub fn newCar(colour: Vec3): Car {
    return Car {
        pos: v3(0.0, 0.0, 0.0),
        yaw: 0.0,
        vel: v3(0.0, 0.0, 0.0),
        roll: 0.0,
        pitch: 0.0,
        steerVis: 0.0,
        wheelSpin: 0.0,
        hint: 0,
        s: 0.0,
        lateral: 0.0,
        lap: 0,
        prevS: 0.0,
        offTrack: false,
        scraping: false,
        boost: 0.0,
        tank: 1.0,
        pad: 0.0,
        colour: colour,
    }
}

impl Car {
    fn forward(self: &Self): Vec3 {
        return v3(Math.sin(self.yaw), 0.0, Math.cos(self.yaw))
    }

    // Up cross forward. Positive yaw turns toward +X, so this is the car's own
    // right-hand side.
    fn right(self: &Self): Vec3 {
        return v3(Math.cos(self.yaw), 0.0, -Math.sin(self.yaw))
    }

    fn speed(self: &Self): f64 {
        return self.vel.len()
    }

    // Signed forward speed, which is what the speedometer wants: a car sliding
    // sideways at 40 m/s is not doing 40 mph down the road.
    // A boost pad. It adds speed directly rather than topping the bottle up and
    // leaving the player to press the button: the pad is a thing you drove over,
    // so the payoff has to be immediate or it reads as a pickup rather than as a
    // ramp. It also part-fills the tank, which is what stops a lap being one
    // long straight with the turbo empty.
    fn padSurge(self: &mut Self) {
        // Open the window rather than adding speed here. Overlapping pads
        // refresh it instead of stacking, so a run of them is one long push and
        // not an unsteerable car.
        self.pad = Math.maxF64(self.pad, PAD_TIME)
        self.tank = Math.minF64(1.0, self.tank + 0.22)
    }

    // 0 to 1 over the life of a pad push, for anything cosmetic that wants to
    // ramp with it. Full for most of the window and easing out at the end, so
    // the car does not fall off the boost in one frame.
    fn padLevel(self: &Self): f64 {
        if self.pad <= 0.0 {
            return 0.0
        }
        return Math.minF64(1.0, self.pad / 0.55)
    }

    fn forwardSpeed(self: &Self): f64 {
        return self.vel.dot(self.forward())
    }

    // Place the car on the grid, or back on the road after a reset.
    fn placeOn(self: &mut Self, track: &Track, s: f64, off: f64) {
        let p = track.pointAt(s, off)
        let t = track.tangentAt(s)
        self.pos = v3(p.x, 0.0, p.z)
        self.yaw = Math.atan2(t.x, t.z)
        self.vel = v3(0.0, 0.0, 0.0)
        self.s = s
        self.prevS = s
        self.lateral = off
        self.hint = track.idxAt(s)
    }

    // One step of the handling model.
    //
    // `steerIn` is -1 (left) to +1 (right), `throttle` and `brake` are 0 to 1,
    // and `nitro` is whether the bottle is open this frame.
    fn drive(self: &mut Self, dt: f64, throttle: f64, brake: f64, steerIn: f64, handbrake: bool, nitro: bool, track: &Track) {
        let fwd = self.forward()
        let rgt = self.right()
        var vf = self.vel.dot(fwd)
        var vr = self.vel.dot(rgt)

        // The bottle. It empties in about three and a half seconds held down and
        // takes about eleven to come back, which is what makes it a decision
        // rather than a second accelerator.
        let lit = nitro && self.tank > 0.015
        if lit {
            self.tank = Math.maxF64(0.0, self.tank - dt * BOOST_DRAIN)
        } else {
            self.tank = Math.minF64(1.0, self.tank + dt * BOOST_REGEN)
        }
        self.boost = if lit {
            Math.minF64(1.0, self.boost + dt * 5.0)
        } else {
            Math.maxF64(0.0, self.boost - dt * 2.4)
        }

        // Engine. The falloff toward the top speed is what makes the last twenty
        // mph take the length of a straight to find.
        // The pad window runs down whatever else is happening: it is a stretch
        // of road, not a button.
        self.pad = Math.maxF64(0.0, self.pad - dt)
        let pk = self.padLevel()
        let top = TOP_SPEED * (1.0 + BOOST_GAIN * self.boost + PAD_GAIN * pk)
        if throttle > 0.0 {
            let head = 1.0 - Math.clampF64(vf / top, 0.0, 1.0)
            vf = vf + ENGINE * throttle * head * dt
        }
        // The boost pushes on its own, so pressing it at speed is felt as a
        // shove rather than only as a slightly higher ceiling that takes the
        // length of a straight to reach.
        vf = vf + 26.0 * self.boost * dt
        // The pad pushes the same way the bottle does, and harder, so hitting
        // one at speed is felt rather than read off the gauge.
        vf = vf + PAD_PUSH * pk * dt
        // Brakes stop the car and then reverse it, slowly. A racer with no
        // reverse is a racer where facing the wrong way ends the run.
        if brake > 0.0 {
            if vf > 0.0 {
                vf = Math.maxF64(0.0, vf - BRAKE * brake * dt)
            } else {
                vf = Math.maxF64(-12.0, vf - 9.0 * brake * dt)
            }
        }
        vf = vf - (DRAG * vf * Math.abs(vf) + ROLL_RESIST * vf) * dt

        // Steering authority falls with speed. Without this the car is
        // uncontrollable flat out and numb in a hairpin, which is the single
        // most common way an arcade handling model feels wrong.
        let sp = Math.abs(vf)
        let auth = STEER_MAX / (1.0 + sp * 0.030)
        // No steering at a standstill: the yaw rate is a consequence of rolling,
        // not of turning the wheel.
        let roll = Math.clampF64(sp / 6.0, 0.0, 1.0)
        let dir = if vf < 0.0 {
            -1.0
        } else {
            1.0
        }
        // Negated, and this is the whole steering convention in one line.
        // `lookAt` builds its right vector as forward x up, which at yaw 0 puts
        // screen-right at -X, while increasing yaw swings the nose toward +X.
        // So growing yaw turns the car LEFT on screen, and a positive steering
        // input (the right arrow) has to shrink it. Everything cosmetic below is
        // expressed in terms of `yawRate` so that it follows this one sign.
        let yawRate = -steerIn * auth * roll * dir * 3.6
        self.yaw = self.yaw + yawRate * dt

        // Turning the heading throws the body sideways, and the tyres eat it.
        // Turning right (positive yaw rate) pushes the mass to the car's left,
        // hence the sign.
        vr = vr - yawRate * vf * dt
        var grip = if self.offTrack {
            GRIP_DIRT
        } else {
            GRIP_ROAD
        }
        if handbrake {
            grip = GRIP_HANDBRAKE
        }
        vr = vr * Math.exp(-grip * dt)
        // Off the road the car also simply will not go, which is most of what
        // stops a player cutting the hairpin across the infield.
        if self.offTrack {
            vf = vf - vf * 1.5 * dt
        }

        // Rebuild the velocity in the NEW heading's frame. Rebuilding rather
        // than rotating is what keeps a drift from quietly gaining energy.
        let nf = self.forward()
        let nr = self.right()
        self.vel = nf.scale(vf) + nr.scale(vr)
        self.pos = self.pos + self.vel.scale(dt)
        self.pos.y = 0.0

        // Cosmetics. The body leans out of the corner and squats under power.
        // The body leans OUT of the corner: turning right throws the mass left,
        // so the left side drops. The sign was checked on a still with the wheel
        // held over, not derived: it depends on the roll matrix convention and
        // on which way the shell's local +X ends up pointing once the yaw
        // rotation is applied, and getting either backwards leans the car into
        // the corner like a motorcycle.
        let wantRoll = Math.clampF64(-yawRate * vf * 0.016, -0.14, 0.14)
        self.roll = self.roll + (wantRoll - self.roll) * Math.minF64(1.0, dt * 6.0)
        let wantPitch = Math.clampF64((brake * 0.055) - (throttle * 0.030), -0.05, 0.07)
        self.pitch = self.pitch + (wantPitch - self.pitch) * Math.minF64(1.0, dt * 5.0)
        // The front wheels point where the driver asked, which under the yaw
        // convention above is the negative direction.
        self.steerVis = self.steerVis + (-steerIn * 0.45 - self.steerVis) * Math.minF64(1.0, dt * 10.0)
        self.wheelSpin = self.wheelSpin + (vf / WHEEL_R) * dt

        self.followTrack(track)
    }

    // Update where the car is on the circuit, count the lap, and apply what the
    // road does back to the car: dirt outside the racing surface, and a barrier
    // outside that.
    fn followTrack(self: &mut Self, track: &Track) {
        let loc = track.locateNear(self.pos.x, self.pos.z, self.hint)
        self.hint = loc.idx
        self.lateral = loc.lateral
        self.offTrack = Math.abs(loc.lateral) > HALF_WIDTH

        // A lap counts when the car crosses the line going forwards. Comparing
        // `s` to zero is not enough: a car nudged backwards over the line would
        // score a lap every frame it wobbled there.
        let step = track.delta(self.prevS, loc.s)
        if self.prevS > track.length * 0.75 && loc.s < track.length * 0.25 && step > 0.0 {
            self.lap = self.lap + 1
        }
        self.prevS = loc.s
        self.s = loc.s

        self.scraping = false
        if Math.abs(loc.lateral) > WALL {
            self.scraping = true
            let sign = if loc.lateral > 0.0 {
                1.0
            } else {
                -1.0
            }
            // Put the car back exactly on the barrier line rather than pushing
            // it with a force. A spring here oscillates: the car bounces off the
            // wall, comes back, and bounces again, which reads as the game
            // fighting the player.
            // Put the car back just INSIDE the barrier line rather than exactly
            // on it, or it re-triggers every frame and sits there buzzing.
            let onWall = track.pointAt(loc.s, sign * (WALL - 0.18))
            self.pos = v3(onWall.x, 0.0, onWall.z)

            let nrm = track.normalAt(loc.s).scale(sign)
            let into = self.vel.dot(nrm)
            if into > 0.0 {
                // Reflect a little rather than merely cancelling. Cancelling the
                // inward component exactly leaves the car travelling parallel to
                // the wall and touching it, so it stays pinned there for as long
                // as the player holds the same steering, which reads as being
                // stuck to the barrier rather than as hitting it. A small
                // restitution pushes it back onto the road. This is an impulse at
                // the boundary, not a positional spring, so it does not
                // oscillate the way a penalty force does.
                self.vel = self.vel - nrm.scale(into * (1.0 + WALL_BOUNCE))
            }

            // Redirect the HEADING too, which is the part that was missing.
            // Killing only the velocity leaves the car still pointing into the
            // wall with the player still steering into it, so it grinds along
            // nose-first and every attempt to recover drives it back in. Turning
            // the nose toward where the car is actually going is what makes a
            // hit read as a deflection. Scaled by how hard the hit was, so a
            // graze barely moves it and a real crash swings it straight.
            let spd = self.vel.len()
            if spd > 2.0 {
                let dirv = self.vel.scale(1.0 / spd)
                let wantYaw = Math.atan2(dirv.x, dirv.z)
                var dyaw = wantYaw - self.yaw
                // Shortest way round, or a hit near the seam spins the car.
                while dyaw > Math.pi() {
                    dyaw = dyaw - 2.0 * Math.pi()
                }
                while dyaw < -Math.pi() {
                    dyaw = dyaw + 2.0 * Math.pi()
                }
                let hard = Math.clampF64(into / 22.0, 0.0, 1.0)
                self.yaw = self.yaw + dyaw * (0.16 + 0.55 * hard)
            }
            self.vel = self.vel.scale(0.965)
        }
    }

    // Body transform: yaw, then the cosmetic lean, then out to where the car is.
    fn modelMatrix(self: &Self): Vec<f32> {
        let t = translation(self.pos)
        let ry = rotationY(self.yaw)
        let rz = rotationZ(self.roll)
        let rx = rotationX(self.pitch)
        return multiply(multiply(t, ry), multiply(rz, rx))
    }

    // One wheel. `i` is 0 front-left, 1 front-right, 2 rear-left, 3 rear-right.
    // The fronts steer; all four spin.
    fn wheelMatrix(self: &Self, i: i64): Vec<f32> {
        let front = i < 2
        let left = (i % 2) == 0
        let x = if left {
            -TRACK_WIDTH * 0.5
        } else {
            TRACK_WIDTH * 0.5
        }
        let z = if front {
            WHEELBASE * 0.5
        } else {
            -WHEELBASE * 0.5
        }
        let local = translation(v3(x, WHEEL_R, z))
        let steer = if front {
            rotationY(self.steerVis)
        } else {
            identity()
        }
        // The wheel mesh has its axle along X, so the spin is about X.
        let spin = rotationX(self.wheelSpin)
        return multiply(self.modelMatrix(), multiply(local, multiply(steer, spin)))
    }

    // Where the head lamps throw light from, in world space. The renderer hangs
    // a point light here for the player's car.
    fn nose(self: &Self): Vec3 {
        return self.pos + self.forward().scale(2.3) + v3(0.0, 0.5, 0.0)
    }

    fn tail(self: &Self): Vec3 {
        return self.pos - self.forward().scale(2.3) + v3(0.0, 0.62, 0.0)
    }
}
