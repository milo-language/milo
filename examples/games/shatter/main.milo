// SHATTER — a brick breaker written in Milo.
//
//   milo build examples/games/shatter/main.milo -o /tmp/shatter --release && /tmp/shatter
//
//   ARROW KEYS / A D / MOUSE   move the paddle
//   SPACE / ENTER              launch the ball (and restart after a game over)
//   ESC                        quit
//
// One control. Where the ball lands on the paddle sets the outgoing angle, so
// every bounce is a decision. Breaking bricks without touching the paddle builds
// a combo, and the combo is the score.
//
// Same engine as ../neon: the HDR canvas with bloom in gfx.milo and the
// mass-spring background lattice in grid.milo. Nothing here is `unsafe` except
// the SDL calls in sdl.milo and the texture upload below.

from "std/math" import {
    Math
}
from "sdl" import {
    SDL_Init, SDL_CreateWindow, SDL_CreateRenderer, SDL_CreateTexture,
    SDL_UpdateTexture, SDL_RenderClear, SDL_RenderCopy, SDL_RenderPresent,
    SDL_ShowCursor, SDL_GetTicks, SDL_DestroyWindow, SDL_Quit,
    SDL_INIT_VIDEO, SDL_WINDOWPOS_CENTERED, SDL_WINDOW_SHOWN,
    SDL_TEXTUREACCESS_STREAMING, SDL_PIXELFORMAT_ABGR8888,
    SDL_RENDERER_ACCELERATED, SDL_RENDERER_PRESENTVSYNC,
}
from "./input" import {
    Input, inputNew, pollInput
}
from "./gfx" import {
    Canvas, canvasNew, present, text, textWidth
}
from "./game" import {
    Game, gameNew, gameUpdate, gameReset
}
from "./render" import {
    drawGame, drawHud
}
from "std/random" import {
    Random
}

pub let W: i64 = 1280

pub let H: i64 = 720

pub fn main(): i32 {
    if SDL_Init(SDL_INIT_VIDEO) != 0 {
        print("SDL_Init failed")
        return 1
    }
    var win: *u8 = 0 as *u8
    var ren: *u8 = 0 as *u8
    var tex: *u8 = 0 as *u8
    var ok = true
    unsafe {
        let title = "SHATTER — written in Milo"
        win = SDL_CreateWindow(title, SDL_WINDOWPOS_CENTERED, SDL_WINDOWPOS_CENTERED, W as i32, H as i32, SDL_WINDOW_SHOWN)
        ren = SDL_CreateRenderer(win, 0 - 1, SDL_RENDERER_ACCELERATED | SDL_RENDERER_PRESENTVSYNC)
        tex = SDL_CreateTexture(ren, SDL_PIXELFORMAT_ABGR8888, SDL_TEXTUREACCESS_STREAMING, W as i32, H as i32)
        if (win as i64) == 0 || (ren as i64) == 0 || (tex as i64) == 0 {
            ok = false
        }
        let _ = SDL_ShowCursor(0)
    }
    if !ok {
        print("SDL setup failed")
        return 2
    }

    var c = canvasNew(W, H)
    var g = gameNew(W as f64, H as f64)
    var inp = inputNew()
    var ev: [u8; 64] = [0; 64]

    var last = SDL_GetTicks()
    var keyX = (W as f64) * 0.5
    var lastMouseX: f64 = 0.0
    var mouseIdle: f64 = 99.0
    var restartHeld = false
    var fpsAccum: f64 = 0.0
    var fpsFrames: i64 = 0
    var fpsShown: i64 = 0

    while !inp.quit {
        let now = SDL_GetTicks()
        var dt = ((now - last) as f64) / 1000.0
        last = now
        if dt > 0.05 {
            dt = 0.05
        }
        if dt < 0.0005 {
            dt = 0.0005
        }

        pollInput(&mut inp, &mut ev, 1.0)

        // Keyboard and mouse both drive the same target: whichever moved last wins,
        // so there is nothing to configure and nothing to discover.
        let mdx = inp.mouseX - lastMouseX
        if mdx * mdx > 4.0 {
            mouseIdle = 0.0
        } else {
            mouseIdle += dt
        }
        lastMouseX = inp.mouseX
        keyX = keyX + inp.moveX * 900.0 * dt
        keyX = Math.clampF64(keyX, 0.0, W as f64)
        var wantX = keyX
        if mouseIdle < 1.5 {
            wantX = inp.mouseX
            keyX = inp.mouseX
        }

        let wantLaunch = inp.bomb || inp.restart

        if (g.gameOver || g.won) && inp.restart && !restartHeld {
            gameReset(&mut g)
        }
        restartHeld = inp.restart

        gameUpdate(&mut g, dt, wantX, wantLaunch)

        var ox = 0.0
        var oy = 0.0
        if g.shake > 0.2 {
            ox = Random.floatRange(0.0 - g.shake, g.shake)
            oy = Random.floatRange(0.0 - g.shake, g.shake)
        }

        drawGame(&mut c, g, ox, oy)
        drawHud(&mut c, g)

        fpsAccum += dt
        fpsFrames += 1
        if fpsAccum > 0.5 {
            fpsShown = ((fpsFrames as f64) / fpsAccum) as i64
            fpsAccum = 0.0
            fpsFrames = 0
        }
        text(&mut c, 24, H - 30, fpsShown.toString() + " FPS", 2, 0.16, 0.26, 0.34)
        let help = "MOVE THE PADDLE    SPACE LAUNCHES    ESC QUITS"
        text(&mut c, W - 24 - textWidth(help, 2), H - 30, help, 2, 0.16, 0.26, 0.34)

        var exposure = 1.0
        if g.flash > 0.0 {
            exposure = 1.0 + g.flash * 1.8
        }
        present(&mut c, 0.6, exposure)

        unsafe {
            SDL_UpdateTexture(tex, 0 as *u8, c.fb[0].addrOf() as *u8, (W * 4) as i32)
            SDL_RenderClear(ren)
            SDL_RenderCopy(ren, tex, 0 as *u8, 0 as *u8)
            SDL_RenderPresent(ren)
        }
    }

    SDL_DestroyWindow(win)
    SDL_Quit()
    return 0
}
