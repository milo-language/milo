// The overlay: crosshair, score, timer, and the words between rounds.
//
// It is built as one list of screen-space quads and drawn in a single call at
// the real drawable size, so text stays sharp however low the scene's own
// resolution is set. The alternative — a CPU canvas uploaded per frame — is
// several megabytes a frame to say "SCORE 40".
//
// The screen font is stroked, not a bitmap. Every glyph is a handful of
// polylines in an 8x8 design box, and the atlas is filled once at startup by
// measuring, for each texel, its distance to the nearest stroke: inside the pen
// width is opaque, and the half texel either side of the edge is the coverage
// that makes the curve read as a curve. A 5x7 bitmap has no half texel, which is
// why the old title read as a QR code at 64 px.
//
// Cell (0,0) is a solid white block for untextured rectangles, and every other
// cell is one glyph.

from "std/math" import {
    Math
}

pub let ATLAS: i64 = 768

pub let CELL: i64 = 48

// The design box a glyph is drawn in, in units. Cap top and baseline leave a
// margin the pen and its antialiasing fit inside, so no glyph can bleed into the
// cell next door under a bilinear tap.
let UNITS: f64 = 8.0

let CAP: f64 = 0.7

let BASE: f64 = 7.3

let MID: f64 = 4.0

// Half the pen width, in the same units. About a tenth of the cap height, which
// is where a geometric sans sits.
let PEN: f64 = 0.34

// 5x7 bitmap font. Row r occupies bits [r*5 .. r*5+4], bit 0 = leftmost column.
// This one is not the screen font: it is what `signs.milo` stamps into the
// painted signboards and the WANTED poster, where a blocky letter is the point.
pub fn fontTable(): Vec<i64> {
    var t: Vec<i64> = Vec.filled(128, 0)
    t[48] = 0x3A33AE62E // 0
    t[49] = 0x3884210C4 // 1
    t[50] = 0x7C444422E // 2
    t[51] = 0x3A304111F // 3
    t[52] = 0x211F4A988 // 4
    t[53] = 0x3A3083C3F // 5
    t[54] = 0x3A317844C // 6
    t[55] = 0x08422221F // 7
    t[56] = 0x3A317462E // 8
    t[57] = 0x1910F462E // 9
    t[65] = 0x4631FC62E // A
    t[66] = 0x3E317C62F // B
    t[67] = 0x3A210862E // C
    t[68] = 0x1D318C527 // D
    t[69] = 0x7C217843F // E
    t[70] = 0x04217843F // F
    t[71] = 0x7A31E862E // G
    t[72] = 0x4631FC631 // H
    t[73] = 0x38842108E // I
    t[74] = 0x19284211C // J
    t[75] = 0x452519531 // K
    t[76] = 0x7C2108421 // L
    t[77] = 0x4631AD771 // M
    t[78] = 0x4631CD671 // N
    t[79] = 0x3A318C62E // O
    t[80] = 0x04217C62F // P
    t[81] = 0x59358C62E // Q
    t[82] = 0x45257C62F // R
    t[83] = 0x3E107043E // S
    t[84] = 0x10842109F // T
    t[85] = 0x3A318C631 // U
    t[86] = 0x11518C631 // V
    t[87] = 0x4775AC631 // W
    t[88] = 0x462A22A31 // X
    t[89] = 0x108422A31 // Y
    t[90] = 0x7C222221F // Z
    t[58] = 0x008401080 // :
    t[46] = 0x18C000000 // .
    t[45] = 0x0000F8000 // -
    t[33] = 0x100421084 // !
    t[43] = 0x0084F9080 // +
    t[47] = 0x044222110 // /
    t[37] = 0x674222173 // %
    t[40] = 0x208210888 // (
    t[41] = 0x088842082 // )
    t[39] = 0x000000084 // '
    t[44] = 0x08C600000 // ,
    t[63] = 0x008421006 // ?
    t[42] = 0x000A44A00 // *
    t[120] = 0x022A22A20 // x
    return t
}

// ── the stroked screen font ───────────────────────────────────────────────────

// A stroke list is flat: four numbers per segment, x0 y0 x1 y1. Joins are round
// because a stroke is drawn as the set of points within the pen width of a
// segment, and the ends of two segments that meet overlap in a disc.
fn seg(s: &mut Vec<f64>, x0: f64, y0: f64, x1: f64, y1: f64) {
    s.push(x0)
    s.push(y0)
    s.push(x1)
    s.push(y1)
}

// A polyline through a flat x,y list.
fn poly(s: &mut Vec<f64>, p: &Vec<f64>) {
    var i = 0
    while i + 3 < p.len {
        seg(&mut s, p[i], p[i + 1], p[i + 2], p[i + 3])
        i = i + 2
    }
}

// An elliptical arc, sampled. Angles are degrees, measured with y running down
// the page: 0 is the right of the ellipse, 90 the bottom, 180 the left.
fn arc(s: &mut Vec<f64>, cx: f64, cy: f64, rx: f64, ry: f64, a0: f64, a1: f64, steps: i64) {
    let k = 3.14159265358979 / 180.0
    var prevX = cx + rx * Math.cos(a0 * k)
    var prevY = cy + ry * Math.sin(a0 * k)
    for i in 1..(steps + 1) {
        let a = (a0 + (a1 - a0) * ((i as f64) / (steps as f64))) * k
        let x = cx + rx * Math.cos(a)
        let y = cy + ry * Math.sin(a)
        seg(&mut s, prevX, prevY, x, y)
        prevX = x
        prevY = y
    }
}

// A dot: a zero-length segment, which the pen renders as a disc.
fn dot(s: &mut Vec<f64>, x: f64, y: f64) {
    seg(&mut s, x, y, x, y)
}

// How far the pen moves after each glyph, in design units. Proportional, because
// a monospaced I in a line of prose is the other thing that reads as a computer
// terminal from 1982.
pub fn advanceTable(): Vec<f64> {
    var a: Vec<f64> = Vec.filled(128, 0.0)
    let wide = 6.6
    let norm = 6.0
    for c in 65..91 {
        a[c] = norm
    }
    a[73] = 2.6 // I
    a[74] = 5.6 // J
    a[77] = 7.5 // M
    a[87] = 7.6 // W
    for c in 48..58 {
        a[c] = 5.8
    }
    a[49] = 4.4 // 1
    a[32] = 3.2 // space
    a[46] = 2.6 // .
    a[44] = 2.6 // ,
    a[58] = 2.6 // :
    a[33] = 2.6 // !
    a[39] = 2.4 // '
    a[45] = 4.6 // -
    a[43] = 5.2 // +
    a[47] = 4.8 // /
    a[63] = 5.2 // ?
    a[42] = 5.0 // *
    a[37] = wide // %
    a[40] = 3.4 // (
    a[41] = 3.4 // )
    a[120] = norm // x, drawn as X
    return a
}

// The shapes. Coordinates are design units with y down: CAP is the top of a
// capital, BASE the baseline, MID the crossbar height.
fn glyphStrokes(code: i64): Vec<f64> {
    var s: Vec<f64> = Vec.new()
    let T = CAP
    let B = BASE
    let M = MID
    let H = B - T
    if code == 65 {
        // A
        seg(&mut s, 0.1, B, 2.6, T)
        seg(&mut s, 2.6, T, 5.1, B)
        seg(&mut s, 1.05, B - 2.1, 4.15, B - 2.1)
    } else if code == 66 {
        seg(&mut s, 0.3, T, 0.3, B)
        arc(&mut s, 0.3, (T + M) / 2.0, 3.9, (M - T) / 2.0, -90.0, 90.0, 8)
        arc(&mut s, 0.3, (M + B) / 2.0, 4.3, (B - M) / 2.0, -90.0, 90.0, 8)
    } else if code == 67 {
        arc(&mut s, 2.8, (T + B) / 2.0, 2.5, H / 2.0, 55.0, 305.0, 18)
    } else if code == 68 {
        seg(&mut s, 0.3, T, 0.3, B)
        arc(&mut s, 0.3, (T + B) / 2.0, 4.5, H / 2.0, -90.0, 90.0, 14)
    } else if code == 69 {
        seg(&mut s, 0.4, T, 0.4, B)
        seg(&mut s, 0.4, T, 4.6, T)
        seg(&mut s, 0.4, M, 4.0, M)
        seg(&mut s, 0.4, B, 4.6, B)
    } else if code == 70 {
        seg(&mut s, 0.4, T, 0.4, B)
        seg(&mut s, 0.4, T, 4.6, T)
        seg(&mut s, 0.4, M, 4.0, M)
    } else if code == 71 {
        arc(&mut s, 2.8, (T + B) / 2.0, 2.5, H / 2.0, 0.0, 305.0, 20)
        seg(&mut s, 5.3, (T + B) / 2.0, 5.3, M + 0.35)
        seg(&mut s, 3.1, M + 0.35, 5.3, M + 0.35)
    } else if code == 72 {
        seg(&mut s, 0.4, T, 0.4, B)
        seg(&mut s, 4.9, T, 4.9, B)
        seg(&mut s, 0.4, M, 4.9, M)
    } else if code == 73 {
        seg(&mut s, 1.0, T, 1.0, B)
    } else if code == 74 {
        seg(&mut s, 4.4, T, 4.4, B - 1.5)
        arc(&mut s, 2.4, B - 1.5, 2.0, 1.5, 0.0, 175.0, 10)
    } else if code == 75 {
        seg(&mut s, 0.4, T, 0.4, B)
        seg(&mut s, 0.4, M + 0.5, 4.7, T)
        seg(&mut s, 1.6, M - 0.35, 5.0, B)
    } else if code == 76 {
        seg(&mut s, 0.5, T, 0.5, B)
        seg(&mut s, 0.5, B, 4.6, B)
    } else if code == 77 {
        seg(&mut s, 0.4, B, 0.4, T)
        seg(&mut s, 0.4, T, 3.3, M + 0.9)
        seg(&mut s, 3.3, M + 0.9, 6.2, T)
        seg(&mut s, 6.2, T, 6.2, B)
    } else if code == 78 {
        seg(&mut s, 0.4, B, 0.4, T)
        seg(&mut s, 0.4, T, 4.9, B)
        seg(&mut s, 4.9, B, 4.9, T)
    } else if code == 79 {
        arc(&mut s, 2.7, (T + B) / 2.0, 2.5, H / 2.0, 0.0, 360.0, 24)
    } else if code == 80 {
        seg(&mut s, 0.4, T, 0.4, B)
        arc(&mut s, 0.4, (T + M + 0.3) / 2.0, 4.2, (M + 0.3 - T) / 2.0, -90.0, 90.0, 10)
    } else if code == 81 {
        arc(&mut s, 2.7, (T + B) / 2.0, 2.5, H / 2.0, 0.0, 360.0, 24)
        seg(&mut s, 3.3, B - 1.4, 5.2, B + 0.35)
    } else if code == 82 {
        seg(&mut s, 0.4, T, 0.4, B)
        arc(&mut s, 0.4, (T + M + 0.3) / 2.0, 4.0, (M + 0.3 - T) / 2.0, -90.0, 90.0, 10)
        seg(&mut s, 2.4, M + 0.3, 4.9, B)
    } else if code == 83 {
        var p: Vec<f64> = [4.7, T + 1.2, 4.2, T + 0.4, 3.1, T + 0.05, 1.8, T + 0.1, 0.7, T + 0.8, 0.55, T + 1.7, 1.2, M + 0.1, 2.8, M + 0.4, 4.2, M + 0.9, 4.7, B - 1.5, 4.4, B - 0.6, 3.3, B - 0.05, 1.7, B - 0.1, 0.5, B - 0.9,]
        poly(&mut s, p)
    } else if code == 84 {
        seg(&mut s, 0.2, T, 5.0, T)
        seg(&mut s, 2.6, T, 2.6, B)
    } else if code == 85 {
        seg(&mut s, 0.4, T, 0.4, B - 1.7)
        seg(&mut s, 5.0, T, 5.0, B - 1.7)
        arc(&mut s, 2.7, B - 1.7, 2.3, 1.7, 0.0, 180.0, 12)
    } else if code == 86 {
        seg(&mut s, 0.2, T, 2.6, B)
        seg(&mut s, 2.6, B, 5.0, T)
    } else if code == 87 {
        seg(&mut s, 0.2, T, 1.7, B)
        seg(&mut s, 1.7, B, 3.2, T + 1.4)
        seg(&mut s, 3.2, T + 1.4, 4.7, B)
        seg(&mut s, 4.7, B, 6.3, T)
    } else if code == 88 || code == 120 {
        seg(&mut s, 0.3, T, 4.9, B)
        seg(&mut s, 4.9, T, 0.3, B)
    } else if code == 89 {
        seg(&mut s, 0.3, T, 2.6, M + 0.2)
        seg(&mut s, 4.9, T, 2.6, M + 0.2)
        seg(&mut s, 2.6, M + 0.2, 2.6, B)
    } else if code == 90 {
        seg(&mut s, 0.3, T, 4.9, T)
        seg(&mut s, 4.9, T, 0.3, B)
        seg(&mut s, 0.3, B, 4.9, B)
    } else if code == 48 {
        arc(&mut s, 2.5, (T + B) / 2.0, 2.2, H / 2.0, 0.0, 360.0, 24)
    } else if code == 49 {
        seg(&mut s, 0.7, T + 1.3, 2.4, T)
        seg(&mut s, 2.4, T, 2.4, B)
    } else if code == 50 {
        var p: Vec<f64> = [0.4, T + 1.5, 0.9, T + 0.5, 2.2, T + 0.05, 3.6, T + 0.35, 4.4, T + 1.4, 4.0, T + 2.9, 0.4, B, 4.7, B,]
        poly(&mut s, p)
    } else if code == 51 {
        var p: Vec<f64> = [0.5, T + 1.1, 1.6, T + 0.1, 3.2, T + 0.15, 4.4, T + 1.1, 3.9, M - 0.1, 2.3, M + 0.2,]
        poly(&mut s, p)
        var q: Vec<f64> = [2.9, M + 0.1, 4.3, M + 1.0, 4.4, B - 1.2, 3.3, B - 0.05, 1.5, B - 0.1, 0.4, B - 1.1,]
        poly(&mut s, q)
    } else if code == 52 {
        seg(&mut s, 3.7, T, 0.3, B - 1.9)
        seg(&mut s, 0.3, B - 1.9, 4.9, B - 1.9)
        seg(&mut s, 3.7, T, 3.7, B)
    } else if code == 53 {
        seg(&mut s, 4.3, T, 1.2, T)
        seg(&mut s, 1.2, T, 0.9, M - 0.3)
        var p: Vec<f64> = [0.9, M - 0.3, 2.4, M - 0.7, 3.9, M - 0.1, 4.5, M + 1.3, 3.9, B - 0.5, 2.3, B - 0.02, 0.7, B - 0.7,]
        poly(&mut s, p)
    } else if code == 54 {
        arc(&mut s, 2.5, B - 1.6, 2.2, 1.6, 0.0, 360.0, 18)
        var p: Vec<f64> = [4.3, T + 0.5, 2.6, T + 0.05, 1.1, T + 1.2, 0.4, M + 0.6, 0.3, B - 1.6,]
        poly(&mut s, p)
    } else if code == 55 {
        seg(&mut s, 0.3, T, 4.9, T)
        seg(&mut s, 4.9, T, 1.9, B)
    } else if code == 56 {
        arc(&mut s, 2.5, T + 1.5, 2.0, 1.5, 0.0, 360.0, 18)
        arc(&mut s, 2.5, B - 1.7, 2.3, 1.7, 0.0, 360.0, 18)
    } else if code == 57 {
        arc(&mut s, 2.5, T + 1.6, 2.2, 1.6, 0.0, 360.0, 18)
        var p: Vec<f64> = [4.7, T + 1.6, 4.6, M + 1.0, 3.9, B - 0.6, 2.4, B - 0.02, 0.8, B - 0.5,]
        poly(&mut s, p)
    } else if code == 46 {
        dot(&mut s, 0.9, B)
    } else if code == 44 {
        seg(&mut s, 1.0, B - 0.1, 0.55, B + 0.85)
    } else if code == 58 {
        dot(&mut s, 0.9, M - 0.6)
        dot(&mut s, 0.9, B)
    } else if code == 33 {
        seg(&mut s, 0.9, T, 0.9, B - 1.5)
        dot(&mut s, 0.9, B)
    } else if code == 39 {
        seg(&mut s, 0.8, T, 0.8, T + 1.3)
    } else if code == 45 {
        seg(&mut s, 0.4, M, 3.7, M)
    } else if code == 43 {
        seg(&mut s, 0.4, M, 4.4, M)
        seg(&mut s, 2.4, M - 2.0, 2.4, M + 2.0)
    } else if code == 47 {
        seg(&mut s, 0.4, B, 4.0, T)
    } else if code == 63 {
        var p: Vec<f64> = [0.5, T + 1.2, 1.3, T + 0.2, 2.8, T + 0.05, 4.0, T + 0.9, 3.8, T + 2.1, 2.3, M + 0.9, 2.3, M + 1.6,]
        poly(&mut s, p)
        dot(&mut s, 2.3, B)
    } else if code == 42 {
        seg(&mut s, 2.2, T + 0.2, 2.2, T + 2.6)
        seg(&mut s, 1.1, T + 0.6, 3.3, T + 2.2)
        seg(&mut s, 3.3, T + 0.6, 1.1, T + 2.2)
    } else if code == 37 {
        arc(&mut s, 1.5, T + 1.2, 1.1, 1.1, 0.0, 360.0, 12)
        arc(&mut s, 4.6, B - 1.2, 1.1, 1.1, 0.0, 360.0, 12)
        seg(&mut s, 5.4, T + 0.2, 0.7, B - 0.2)
    } else if code == 40 {
        arc(&mut s, 2.9, (T + B) / 2.0, 2.3, H / 2.0 + 0.2, 110.0, 250.0, 10)
    } else if code == 41 {
        arc(&mut s, 0.3, (T + B) / 2.0, 2.3, H / 2.0 + 0.2, -70.0, 70.0, 10)
    }
    return s
}

// Distance from a point to a segment, which is what the pen width is compared
// against.
fn segDist(px: f64, py: f64, x0: f64, y0: f64, x1: f64, y1: f64): f64 {
    let vx = x1 - x0
    let vy = y1 - y0
    let wx = px - x0
    let wy = py - y0
    let len2 = vx * vx + vy * vy
    var t = 0.0
    if len2 > 1.0e-12 {
        t = Math.clampF64((wx * vx + wy * vy) / len2, 0.0, 1.0)
    }
    let dx = wx - vx * t
    let dy = wy - vy * t
    return Math.sqrt(dx * dx + dy * dy)
}

// The atlas as packed 0xAABBGGRR. Only the red channel is read by the shader, so
// coverage goes there and the rest is padding.
pub fn buildAtlas(): Vec<u32> {
    var px: Vec<u32> = Vec.filled(ATLAS * ATLAS, 0)
    // The white block, inset by one texel so a bilinear tap at the edge of a
    // rectangle cannot pull in the transparent cell next door.
    for y in 0..CELL {
        for x in 0..CELL {
            px[y * ATLAS + x] = 0xFFFFFFFF
        }
    }
    let per = (CELL as f64) / UNITS
    for code in 32..128 {
        // Cell 0 is the white block, and codes below 32 have no glyph, so
        // nothing can land on it.
        let strokes = glyphStrokes(code)
        if strokes.len == 0 {
            continue
        }
        let ox = (code % 16) * CELL
        let oy = (code / 16) * CELL
        for row in 0..CELL {
            for col in 0..CELL {
                let u = ((col as f64) + 0.5) / per
                let v = ((row as f64) + 0.5) / per
                var d = 1.0e18
                var i = 0
                while i + 3 < strokes.len {
                    let dd = segDist(u, v, strokes[i], strokes[i + 1], strokes[i + 2], strokes[i + 3])
                    if dd < d {
                        d = dd
                    }
                    i = i + 4
                }
                // Opaque inside the pen, and one texel of ramp across the edge:
                // the ramp is the whole difference between this and a bitmap.
                let cov = Math.clampF64(0.5 + (PEN - d) * per, 0.0, 1.0)
                if cov > 0.004 {
                    let r = (cov * 255.0) as u32
                    px[(oy + row) * ATLAS + ox + col] = 0xFF000000 | r
                }
            }
        }
    }
    return px
}

pub struct Hud {
    verts: Vec<f32>,
    adv: Vec<f64>,
}

pub fn newHud(): Hud {
    return Hud {
        verts: Vec.new(), adv: advanceTable()
    }
}

impl Hud {
    fn clear(self: &mut Self) {
        self.verts.clear()
    }

    fn corner(self: &mut Self, x: f64, y: f64, u: f64, v: f64, r: f64, g: f64, b: f64, a: f64) {
        self.verts.push(x as f32)
        self.verts.push(y as f32)
        self.verts.push(u as f32)
        self.verts.push(v as f32)
        self.verts.push(r as f32)
        self.verts.push(g as f32)
        self.verts.push(b as f32)
        self.verts.push(a as f32)
    }

    fn quad(self: &mut Self, x: f64, y: f64, w: f64, h: f64, u0: f64, v0: f64, u1: f64, v1: f64, r: f64, g: f64, b: f64, a: f64) {
        self.corner(x, y, u0, v0, r, g, b, a)
        self.corner(x + w, y, u1, v0, r, g, b, a)
        self.corner(x + w, y + h, u1, v1, r, g, b, a)
        self.corner(x, y, u0, v0, r, g, b, a)
        self.corner(x + w, y + h, u1, v1, r, g, b, a)
        self.corner(x, y + h, u0, v1, r, g, b, a)
    }

    // Solid colour, from the middle of the white cell so no mip level can drift
    // off it.
    fn rect(self: &mut Self, x: f64, y: f64, w: f64, h: f64, r: f64, g: f64, b: f64, a: f64) {
        let c = ((CELL / 2) as f64) / (ATLAS as f64)
        self.quad(x, y, w, h, c, c, c, c, r, g, b, a)
    }

    // One glyph. `s` is the size of a design unit in pixels, so the cell is
    // 8 units square and a capital is 6.6 of them tall.
    fn glyph(self: &mut Self, code: i64, x: f64, y: f64, s: f64, r: f64, g: f64, b: f64, a: f64) {
        if code <= 32 || code >= 128 {
            return
        }
        let cx = ((code % 16) * CELL) as f64
        let cy = ((code / 16) * CELL) as f64
        let inv = 1.0 / (ATLAS as f64)
        let c = CELL as f64
        self.quad(x, y, UNITS * s, UNITS * s, cx * inv, cy * inv, (cx + c) * inv, (cy + c) * inv, r, g, b, a)
    }

    // Returns the width drawn, so a caller can centre or right-align without
    // measuring the string twice.
    fn text(self: &mut Self, msg: &string, x: f64, y: f64, s: f64, r: f64, g: f64, b: f64, a: f64): f64 {
        var pen = x
        for cp in msg.codePoints() {
            let c = upper(cp as i64)
            self.glyph(c, pen, y, s, r, g, b, a)
            pen = pen + self.advance(c) * s
        }
        return pen - x
    }

    fn advance(self: &Self, code: i64): f64 {
        if code < 0 || code >= 128 {
            return 0.0
        }
        let a = self.adv[code]
        // Anything the font has no width for still has to move the pen, or a
        // typo turns into a pile of letters on one spot.
        if a <= 0.0 {
            return 3.2
        }
        return a
    }

    fn textWidth(self: &Self, msg: &string, s: f64): f64 {
        var w = 0.0
        for cp in msg.codePoints() {
            w = w + self.advance(upper(cp as i64)) * s
        }
        return w
    }

    fn textCentred(self: &mut Self, msg: &string, cx: f64, y: f64, s: f64, r: f64, g: f64, b: f64, a: f64) {
        let w = self.textWidth(msg, s)
        // A drop shadow, because white text over a bright sky is otherwise
        // unreadable exactly when the sky is doing its best work.
        let _ = self.text(msg, cx - w * 0.5 + 1.6 * s, y + 1.6 * s, s, 0.0, 0.0, 0.0, a * 0.55)
        let _ = self.text(msg, cx - w * 0.5, y, s, r, g, b, a)
    }
}

// The font is capitals only, so a lowercase letter is drawn as its capital
// rather than as a blank.
fn upper(code: i64): i64 {
    if code >= 97 && code <= 122 {
        return code - 32
    }
    return code
}
