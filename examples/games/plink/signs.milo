// The printed things: the marquee over the stage, the banners down the walls,
// and the faces of the targets themselves.
//
// These are the only textures in the game that carry words or a device, so they
// are built here rather than in textures.milo, they need the HUD's font table,
// they are not square, they are not tiled, and there is exactly one of each.
//
// Everything here is drawn to be *glowed*: the materials that use these
// textures set `emissiveMap`, which multiplies the emissive by the albedo. So
// what is bright in the pixels is what throws light in the room, and the board
// behind the lettering stays a board.

from "std/math" import {
    Math
}
from "./hud" import {
    fontTable
}

pub let MARQUEE_W: i64 = 512

pub let MARQUEE_H: i64 = 128

pub let BANNER_W: i64 = 256

pub let BANNER_H: i64 = 128

// One texture holds every target face, in a 3x3 grid of 128 px cells. The
// alternative is one texture and one material per kind, for discs that differ
// only in what is printed on them.
pub let FACE_SIZE: i64 = 384

pub let FACE_CELL: i64 = 128

pub let FACE_COLS: i64 = 3

// The mega bonus, as printed on the marquee and as paid by the gold target the
// drone drops. One constant so the sign cannot promise a number the game does
// not pay.
pub let MEGA_BONUS: i64 = 10000

@wrapping
fn noiseHash(x: i64, y: i64, salt: i64): f64 {
    var h = (((x & 0xFFF) as u64) * 0x9E3779B1) & 0xFFFFFFFF
    h = (h + ((((y & 0xFFF) as u64) * 0x85EBCA77) & 0xFFFFFFFF)) & 0xFFFFFFFF
    h = (h + ((((salt & 0xFFF) as u64) * 0xC2B2AE35) & 0xFFFFFFFF)) & 0xFFFFFFFF
    h = h ^ (h >> 15)
    h = (h * 0x2545F491) & 0xFFFFFFFF
    h = h ^ (h >> 13)
    return ((h & 0xFFFFFF) as f64) / 16777216.0
}

fn smoothNoise(x: f64, y: f64, salt: i64): f64 {
    let fx = Math.floor(x)
    let fy = Math.floor(y)
    var tx = x - fx
    var ty = y - fy
    tx = tx * tx * (3.0 - 2.0 * tx)
    ty = ty * ty * (3.0 - 2.0 * ty)
    let ix = fx as i64
    let iy = fy as i64
    let a = noiseHash(ix, iy, salt)
    let b = noiseHash(ix + 1, iy, salt)
    let c = noiseHash(ix, iy + 1, salt)
    let d = noiseHash(ix + 1, iy + 1, salt)
    let top = a + (b - a) * tx
    let bot = c + (d - c) * tx
    return top + (bot - top) * ty
}

fn pack(r: f64, g: f64, b: f64): u32 {
    let rr = (Math.clampF64(r, 0.0, 1.0) * 255.0) as u32
    let gg = (Math.clampF64(g, 0.0, 1.0) * 255.0) as u32
    let bb = (Math.clampF64(b, 0.0, 1.0) * 255.0) as u32
    return 0xFF000000 | (bb << 16) | (gg << 8) | rr
}

// Stamp one 5x7 glyph at `scale`, in ink that is not quite black and not quite
// even, printed on a press, on paper, a century ago.
fn stampGlyph(px: &mut Vec<u32>, w: i64, h: i64, table: &Vec<i64>, code: i64, x0: i64, y0: i64, scale: i64, r: f64, g: f64, b: f64) {
    if code <= 0 || code >= 128 {
        return
    }
    let bits = table[code]
    if bits == 0 {
        return
    }
    for row in 0..7 {
        for col in 0..5 {
            if ((bits >> (row * 5 + col)) & 1) != 1 {
                continue
            }
            for dy in 0..scale {
                for dx in 0..scale {
                    let x = x0 + col * scale + dx
                    let y = y0 + row * scale + dy
                    if x < 0 || y < 0 || x >= w || y >= h {
                        continue
                    }
                    let fade = 0.72 + 0.5 * noiseHash(x, y, 7)
                    px[y * w + x] = pack(r * fade, g * fade, b * fade)
                }
            }
        }
    }
}

fn stampText(px: &mut Vec<u32>, w: i64, h: i64, table: &Vec<i64>, msg: &string, cx: i64, y0: i64, scale: i64, r: f64, g: f64, b: f64) {
    var n = 0
    for _c in msg.codePoints() {
        n = n + 1
    }
    let width = n * 6 * scale - scale
    var x = cx - width / 2
    for cp in msg.codePoints() {
        let code = cp as i64
        if code != 32 {
            stampGlyph(&mut px, w, h, table, code, x, y0, scale, r, g, b)
        }
        x = x + 6 * scale
    }
}

// Milo, side on, ears up. Digits index the palette in `dogInk`; a dot is paper.

// ── the marquee ───────────────────────────────────────────────────────────────

// The bonus board. Dark ground, a cyan strapline, and the number in amber at the
// size that makes it the thing you read from the firing line.
pub fn marqueePixels(): Vec<u32> {
    let w = MARQUEE_W
    let h = MARQUEE_H
    var px: Vec<u32> = Vec.filled(w * h, 0)
    for y in 0..h {
        for x in 0..w {
            let fx = x as f64
            let fy = y as f64
            let mottle = smoothNoise(fx * 0.05, fy * 0.05, 61) * 0.05
            var r = 0.020 + mottle
            var g = 0.024 + mottle
            var b = 0.055 + mottle * 1.6
            // An inset border, drawn as two rectangles of distance from the edge.
            let ex = Math.minF64(fx, (w - 1) as f64 - fx)
            let ey = Math.minF64(fy, (h - 1) as f64 - fy)
            let e = Math.minF64(ex, ey)
            if e > 5.0 && e < 9.0 {
                r = 0.90
                g = 0.30
                b = 0.10
            }
            px[y * w + x] = pack(r, g, b)
        }
    }
    let table = fontTable()
    stampText(&mut px, w, h, table, "MEGA BONUS", w / 2, 18, 3, 0.35, 1.0, 1.0)
    stampText(&mut px, w, h, table, "10,000", w / 2, 50, 9, 1.0, 0.72, 0.16)
    return px
}

// ── the banners ───────────────────────────────────────────────────────────────

// Cloth on a frame, down both walls over the stage. Chevrons, because a banner
// needs a direction and the direction wants to be towards the targets.
pub fn bannerPixels(): Vec<u32> {
    let w = BANNER_W
    let h = BANNER_H
    var px: Vec<u32> = Vec.filled(w * h, 0)
    for y in 0..h {
        for x in 0..w {
            let fx = x as f64
            let fy = y as f64
            let weave = smoothNoise(fx * 0.8, fy * 0.8, 71) * 0.10
            // A chevron field: fold y about the middle, then band on x plus the
            // folded y, which is one expression for a repeating arrow.
            let fold = Math.abs(fy - (h as f64) * 0.5)
            let band = Math.abs(((fx + fold) / 34.0) - Math.floor((fx + fold) / 34.0) - 0.5)
            var r = 0.05 + weave
            var g = 0.05 + weave
            var b = 0.12 + weave
            if band < 0.24 {
                r = 0.72
                g = 0.10
                b = 0.45
            }
            // Top and bottom hems.
            if fy < 7.0 || fy > (h as f64) - 8.0 {
                r = 0.20
                g = 0.55
                b = 0.75
            }
            px[y * w + x] = pack(r, g, b)
        }
    }
    let table = fontTable()
    stampText(&mut px, w, h, table, "PLINK", w / 2, h / 2 - 22, 7, 1.0, 0.92, 0.45)
    return px
}

// ── the target faces ──────────────────────────────────────────────────────────

// One cell of the face atlas: a white ground, one bold ring near the rim, a
// thin inner ring, and the number as large as fits between them.
//
// The old face had three rings of equal weight and a small number, and at
// eleven metres through a bloom pass that reads as a pink blob. What a target
// needs is one strong edge to find and one legible number inside it.
fn drawFace(px: &mut Vec<u32>, cell: i64, msg: &string, gr: f64, gg: f64, gb: f64, rr: f64, rg: f64, rb: f64) {
    let table = fontTable()
    let c = FACE_CELL
    let cx = (cell % FACE_COLS) * c
    let cy = (cell / FACE_COLS) * c
    let mid = ((c - 1) as f64) * 0.5
    for y in 0..c {
        for x in 0..c {
            let dx = (x as f64) - mid
            let dy = (y as f64) - mid
            let d = Math.sqrt(dx * dx + dy * dy) / mid
            var r = gr
            var g = gg
            var b = gb
            // The rim, the bold ring, and a hairline inside it. Every band is
            // wide enough to survive the mip chain: a one-texel ring on a target
            // seen from twelve metres is a ring that is not there.
            if d > 0.955 {
                r = rr * 0.45
                g = rg * 0.45
                b = rb * 0.45
            } else if d > 0.68 {
                r = rr
                g = rg
                b = rb
            } else if d > 0.62 && d < 0.68 {
                r = rr
                g = rg
                b = rb
            }
            let sheen = smoothNoise((x as f64) * 0.06, (y as f64) * 0.06, 83) * 0.06
            px[(cy + y) * FACE_SIZE + (cx + x)] = pack(r + sheen, g + sheen, b + sheen)
        }
    }
    // The number, as big as fits inside the inner ring. The glyph cell is 5x7
    // design units, the pen advances 6, and the last glyph does not advance, 
    // so a string of n is 6n-1 units wide and 7 tall, and both have to clear the
    // ring at 0.62 of the radius, which is 78 px across.
    var n = 0
    for _ch in msg.codePoints() {
        n = n + 1
    }
    var scale = 12
    while scale > 2 && (n * 6 - 1) * scale > 82 {
        scale = scale - 1
    }
    let w = (n * 6 - 1) * scale
    let h = 7 * scale
    stampText(&mut px, FACE_SIZE, FACE_SIZE, table, msg, cx + c / 2, cy + (c - h) / 2, scale, rr, rg, rb)
    let _ = w
}

// The faces, in the order targets.milo's KIND_* constants expect. The ladder is
// colour-coded and the code is the contract with the player: red is cheap, blue
// is next, magenta is worth going for, and the two that glow, orange and hot
// magenta, are the ones at the back that you have to reach for.
//
//   0   100, red on white
//   1   250, blue on white
//   2   500, magenta on white
//   3  1000, orange, and lit from inside
//   4  5000, magenta, and lit harder still
//   5 BONUS, gold, and only ever seen when the drone has dropped one
pub fn facePixels(): Vec<u32> {
    var px: Vec<u32> = Vec.filled(FACE_SIZE * FACE_SIZE, 0)
    drawFace(&mut px, 0, "100", 0.96, 0.96, 0.93, 1.00, 0.11, 0.08)
    drawFace(&mut px, 1, "250", 0.94, 0.97, 1.00, 0.07, 0.32, 1.00)
    drawFace(&mut px, 2, "500", 0.99, 0.93, 0.99, 0.95, 0.06, 0.80)
    // The two that glow are drawn dark: their emissive comes from the print, so
    // a white ground would glow harder than the number on it.
    drawFace(&mut px, 3, "1000", 0.42, 0.20, 0.03, 1.00, 0.62, 0.10)
    drawFace(&mut px, 4, "5000", 0.36, 0.05, 0.30, 1.00, 0.18, 0.90)
    drawFace(&mut px, 5, "BONUS", 1.00, 0.86, 0.30, 0.55, 0.10, 0.00)
    return px
}

// ── the dog ───────────────────────────────────────────────────────────────────

pub let LOGO_W: i64 = 192

pub let LOGO_H: i64 = 224

// Milo, side on, ears up: the chihuahua from the other games in this directory.
// Digits index the palette in `dogInk`; a dot is background.
fn dogArt(): Vec<string> {
    var a: Vec<string> = Vec.new()
    a.push("..............030..030........")
    a.push("..............0300.0300.......")
    a.push("..............0330003300......")
    a.push("..............0353003530......")
    a.push("..............03533333500.....")
    a.push("..............033333333300....")
    a.push("...000.......00333333333300...")
    a.push("...0200......033333333333300..")
    a.push("...002000...003333373333300...")
    a.push("....0022000.03333377333333000.")
    a.push(".....002220000333333334447770.")
    a.push("......00220222333333444447770.")
    a.push("......00222222233333444447770.")
    a.push(".....002222228883333444444400.")
    a.push(".....02222222888433333555500..")
    a.push(".....0222222289844442000000...")
    a.push(".....02222222244444440........")
    a.push(".....00222222224444400........")
    a.push("......022222222444400.........")
    a.push(".....002220222224000..........")
    a.push(".....04444400444440...........")
    a.push(".....04444400444440...........")
    a.push(".....00000000000000...........")
    return a
}

// Lit in neon rather than printed in ink: the plaque is a light box, so the
// palette runs from a dark outline up to a hot cyan-white highlight.
fn dogInk(c: i64): Vec<f64> {
    var v: Vec<f64> = Vec.new()
    let tones: Vec<f64> = [0.02, 0.05, 0.08, 0.10, 0.55, 0.70, 0.20, 0.85, 1.00, 0.55, 1.00, 1.00, 0.14, 0.70, 0.90, 0.35, 0.95, 1.00, 0.06, 0.30, 0.45, 0.90, 1.00, 1.00, 0.02, 0.04, 0.06, 0.80, 0.95, 1.00,]
    var i = c
    if i < 0 || i > 9 {
        i = 0
    }
    v.push(tones[i * 3])
    v.push(tones[i * 3 + 1])
    v.push(tones[i * 3 + 2])
    return v
}

// The plaque that hangs down both walls: Milo in a lit box with his name under
// him. Every other picture in the room is a number, and a room of numbers has
// nobody in it.
pub fn logoPixels(): Vec<u32> {
    let w = LOGO_W
    let h = LOGO_H
    var px: Vec<u32> = Vec.filled(w * h, 0)
    for y in 0..h {
        for x in 0..w {
            let fx = x as f64
            let fy = y as f64
            let mottle = smoothNoise(fx * 0.05, fy * 0.05, 91) * 0.04
            var r = 0.015 + mottle
            var g = 0.030 + mottle
            var b = 0.070 + mottle * 1.4
            let ex = Math.minF64(fx, (w - 1) as f64 - fx)
            let ey = Math.minF64(fy, (h - 1) as f64 - fy)
            let e = Math.minF64(ex, ey)
            if e > 4.0 && e < 8.0 {
                r = 0.20
                g = 0.95
                b = 1.00
            }
            px[y * w + x] = pack(r, g, b)
        }
    }
    let art = dogArt()
    let scale = 6
    let aw = 29 * scale
    let x0 = (w - aw) / 2
    let y0 = 16
    var row = 0
    for line in art {
        var col = 0
        for cp in line.codePoints() {
            let ch = cp as i64
            if ch != 46 {
                let ink = dogInk(ch - 48)
                for dy in 0..scale {
                    for dx in 0..scale {
                        let x = x0 + col * scale + dx
                        let y = y0 + row * scale + dy
                        if x >= 0 && y >= 0 && x < w && y < h {
                            px[y * w + x] = pack(ink[0], ink[1], ink[2])
                        }
                    }
                }
            }
            col = col + 1
        }
        row = row + 1
    }
    let table = fontTable()
    stampText(&mut px, w, h, table, "MILO", w / 2, h - 46, 5, 1.0, 0.80, 0.25)
    return px
}
