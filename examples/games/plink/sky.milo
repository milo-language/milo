// The room's own light, tabulated once at startup.
//
// This game is indoors, so there is no sky to integrate: what the reflection
// lookup and the ambient term need is the radiance of the *arcade* in every
// direction, a dark vault overhead, a lit floor underfoot, and a ring of neon
// around the walls. It is stored in exactly the layout the atmospheric table
// used (lat-long, u = azimuth, v = zenith angle) so the shader side is unchanged.
//
// Two things come out of it and both matter:
//
//   - a lat-long radiance table, sampled for the backdrop and for rough
//     reflections. Chrome posts and glossy plastic are most of this scene and
//     nearly all of what you see on them is this table.
//   - the irradiance it delivers to an up-facing and a down-facing surface,
//     which IS the ambient term. Ambient picked by eye is what makes a render
//     look like a render.
//
// The table is sampled with the v coordinate clamped half a texel off each pole
// (`skyLookup` in the shader), because the wrap mode has to be REPEAT for the
// azimuth seam and REPEAT at the poles would blend the zenith into the nadir.

from "std/math" import {
    Math
}
from "./vec3" import {
    Vec3, v3
}

pub let SKY_W: i64 = 256

pub let SKY_H: i64 = 128

pub struct Sky {
    // SKY_W * SKY_H * 3 floats of linear radiance, u = azimuth, v = zenith angle.
    table: Vec<f32>,
    sun: Vec3,
    // The house light: the one directional source, hung high and behind the
    // firing line so the faces you shoot at are the faces it reaches. It is
    // deliberately weak, the neon does the work, but it is what puts a
    // shadow under the rigs, and a scene with no shadow at all reads as flat
    // no matter how much of it glows.
    sunColor: Vec3,
    // Irradiance from the room alone, on an up-facing and a down-facing
    // surface. `ambientIrradiance(n)` in the shader interpolates between them.
    skyUp: Vec3,
    skyDown: Vec3,
}

// Smooth pulse, 1 at `c` and 0 more than `w` away.
fn lobe(x: f64, c: f64, w: f64): f64 {
    let d = Math.abs(x - c) / w
    if d >= 1.0 {
        return 0.0
    }
    let t = 1.0 - d
    return t * t * (3.0 - 2.0 * t)
}

// Same, wrapped in azimuth so a lobe centred on the seam does not tear.
fn lobeAz(a: f64, c: f64, w: f64): f64 {
    var d = a - c
    while d > Math.pi() {
        d = d - 2.0 * Math.pi()
    }
    while d < -Math.pi() {
        d = d + 2.0 * Math.pi()
    }
    return lobe(Math.abs(d), 0.0, w)
}

// The radiance of the room in one direction. Everything here is hand-placed
// rather than traced: the room is a tube, and a tube seen from inside is three
// bands (vault, wall, floor) with the light sources on known bearings.
fn roomRadiance(dir: &Vec3): Vec3 {
    let up = Math.clampF64(dir.y, -1.0, 1.0)
    // Azimuth measured the way the world is laid out: 0 is straight down +Z,
    // which is the way the player faces and where the whole target field is.
    let az = Math.atan2(dir.x, dir.z)

    // The vault: near-black navy at the apex, warming to violet at the springline.
    var col = v3(0.012, 0.016, 0.040)
    let toWall = 1.0 - Math.clampF64(Math.abs(up), 0.0, 1.0)
    col = col + v3(0.030, 0.014, 0.055).scale(toWall * toWall)

    // The floor, which is carpet and takes more light than it gives back, plus
    // the light strips let into it.
    if up < 0.0 {
        let d = -up
        col = v3(0.055, 0.020, 0.070).scale(0.35 + 0.65 * d)
        col = col + v3(0.10, 0.16, 0.42).scale(lobe(d, 0.30, 0.22))
    }

    // Neon running the length of both walls, a little below eye level. This is
    // the ring that puts a cyan edge on every chrome post in the room.
    let wallBand = lobe(up, -0.06, 0.30)
    col = col + v3(0.10, 0.52, 0.72).scale(wallBand * lobeAz(az, 1.5708, 1.15))
    col = col + v3(0.62, 0.10, 0.52).scale(wallBand * lobeAz(az, -1.5708, 1.15))

    // The target field and the marquee above it: the bright end of the room, and
    // the reason a post facing the player has a hot side and a dark side.
    let ahead = lobeAz(az, 0.0, 1.5)
    col = col + v3(0.34, 0.44, 0.62).scale(ahead * lobe(up, 0.06, 0.34))
    col = col + v3(0.55, 0.42, 0.14).scale(ahead * lobe(up, 0.30, 0.13))

    // Ribs of light along the vault, crossing overhead front to back.
    if up > 0.15 {
        let ribs = lobeAz(az, 1.5708, 0.55) + lobeAz(az, -1.5708, 0.55)
        col = col + v3(0.16, 0.22, 0.40).scale(ribs * lobe(up, 0.55, 0.40))
    }

    // Behind you is the arcade you walked in from: dim, and warm rather than
    // cold, so a chrome post is not the same colour on both sides.
    col = col + v3(0.10, 0.06, 0.03).scale(lobeAz(az, 3.14159, 1.4) * lobe(up, 0.0, 0.5))

    return col
}

fn dirFromLatLong(u: f64, v: f64): Vec3 {
    let theta = v * Math.pi()
    let phi = (u - 0.25) * 2.0 * Math.pi()
    let st = Math.sin(theta)
    return v3(st * Math.cos(phi), Math.cos(theta), st * Math.sin(phi))
}

// `intensity` scales the whole room, which is the one knob worth having: the
// bloom threshold is fixed, so brightening the room and brightening the neon
// are not the same operation and only one of them changes what glows.
pub fn buildRoom(intensity: f64): Sky {
    // Hung high, in front of the firing line and a little to the left, so it
    // rakes the faces of the target discs instead of their tops.
    let sun = v3(-0.26, 0.90, 0.35).norm()

    var table: Vec<f32> = Vec.filled(SKY_W * SKY_H * 3, 0.0)
    // Cosine-weighted sums over the whole sphere, split by which side of the
    // horizon the direction is on, so one pass yields both hemispheres.
    var upR = 0.0
    var upG = 0.0
    var upB = 0.0
    var downR = 0.0
    var downG = 0.0
    var downB = 0.0
    var upW = 0.0
    var downW = 0.0
    for j in 0..SKY_H {
        let v = ((j as f64) + 0.5) / (SKY_H as f64)
        let theta = v * Math.pi()
        // Solid angle of this ring, for the irradiance sums.
        let dOmega = Math.sin(theta) * (Math.pi() / (SKY_H as f64)) * (2.0 * Math.pi() / (SKY_W as f64))
        for i in 0..SKY_W {
            let u = ((i as f64) + 0.5) / (SKY_W as f64)
            let dir = dirFromLatLong(u, v)
            let rad = roomRadiance(dir).scale(intensity)
            let o = (j * SKY_W + i) * 3
            table[o] = rad.x as f32
            table[o + 1] = rad.y as f32
            table[o + 2] = rad.z as f32
            let cosT = dir.y
            if cosT > 0.0 {
                let w = cosT * dOmega
                upR = upR + rad.x * w
                upG = upG + rad.y * w
                upB = upB + rad.z * w
                upW += w
            } else {
                let w = -cosT * dOmega
                downR = downR + rad.x * w
                downG = downG + rad.y * w
                downB = downB + rad.z * w
                downW += w
            }
        }
    }
    if upW <= 0.0 {
        upW = 1.0
    }
    if downW <= 0.0 {
        downW = 1.0
    }
    // Irradiance, not average radiance: the pi is the integral of the cosine
    // over the hemisphere, and dropping it is the classic way a render comes out
    // three times too dark in shadow.
    let skyUp = v3(upR, upG, upB).scale(Math.pi() / upW)
    let below = v3(downR, downG, downB).scale(Math.pi() / downW)
    let sunC = v3(0.62, 0.66, 0.86).scale(intensity)
    // What the carpet throws back up. It is dark and it is purple, and a face
    // pointing down in here picking up violet is most of what says "indoors".
    let bounce = below.scale(0.9) + v3(0.030, 0.012, 0.048).scale(intensity)
    return Sky {
        table: table, sun: sun, sunColor: sunC, skyUp: skyUp, skyDown: bounce
    }
}
