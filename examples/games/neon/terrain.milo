// The cave the stage flies through.
//
// Two height fields — ceiling and floor — sampled on a fixed column pitch and
// scrolled left one whole column at a time, so nothing has to be resampled per
// frame. The generator walks toward a randomly chosen aperture instead of
// jittering, which is what makes the tunnel read as a place rather than noise.

from "std/math" import {
    Math
}
from "std/random" import {
    Random
}
from "./gfx" import {
    Canvas, line, fillRect, spot
}

pub struct Terrain {
    top: Vec<f64>, // ceiling y per column
    bot: Vec<f64>, // floor y per column
    cols: i64,
    pitch: f64,
    offset: f64, // 0..pitch — how far column 0 has slid past the left edge
    h: f64,
    curTop: f64,
    curBot: f64,
    tgtTop: f64,
    tgtBot: f64,
    hold: i64, // columns until the next aperture is drawn
    gap: f64, // aperture the generator aims for; the stage tightens it
    calm: i64, // columns of forced wide-open — the boss needs a room, not a duct
    gen: i64, // total columns ever generated: the seed the rock texture rides on
}

pub fn terrainNew(w: f64, h: f64, pitch: f64): Terrain {
    let cols = (w / pitch) as i64 + 3
    let openTop = 8.0
    let openBot = h - 8.0
    return Terrain {
        top: Vec.filled(cols, openTop),
        bot: Vec.filled(cols, openBot),
        cols: cols,
        pitch: pitch,
        offset: 0.0,
        h: h,
        curTop: openTop,
        curBot: openBot,
        tgtTop: openTop,
        tgtBot: openBot,
        hold: 40,
        gap: h * 0.92,
        calm: 60,
        gen: 0,
    }
}

pub fn terrainReset(t: &mut Terrain) {
    let openTop = 8.0
    let openBot = t.h - 8.0
    for i in 0..t.cols {
        t.top[i] = openTop
        t.bot[i] = openBot
    }
    t.offset = 0.0
    t.curTop = openTop
    t.curBot = openBot
    t.tgtTop = openTop
    t.tgtBot = openBot
    t.hold = 40
    t.gap = t.h * 0.92
    t.calm = 60
    t.gen = 0
}

// Wide open for `cols` columns — used to clear a boss arena, and to guarantee
// the player is never spawned back into a wall after dying.
pub fn terrainOpen(t: &mut Terrain, cols: i64) {
    if t.calm < cols {
        t.calm = cols
    }
    t.hold = 0
}

fn approach(cur: f64, tgt: f64, step: f64): f64 {
    let d = tgt - cur
    if d > step {
        return cur + step
    }
    if d < 0.0 - step {
        return cur - step
    }
    return tgt
}

fn nextTarget(t: &mut Terrain) {
    if t.calm > 0 {
        t.tgtTop = 8.0
        t.tgtBot = t.h - 8.0
        t.hold = 4
        return
    }
    let margin = 6.0
    var gap = t.gap * Random.floatRange(0.82, 1.3)
    gap = Math.clampF64(gap, 190.0, t.h - margin * 2.0)
    let span = t.h - margin * 2.0 - gap
    var lo = margin
    if span > 1.0 {
        lo = margin + Random.floatRange(0.0, span)
    }
    t.tgtTop = lo
    t.tgtBot = lo + gap
    t.hold = Random.range(7, 30)
}

fn stepColumn(t: &mut Terrain) {
    t.gen = t.gen + 1
    t.hold = t.hold - 1
    if t.hold <= 0 {
        nextTarget(&mut t)
    }
    if t.calm > 0 {
        t.calm = t.calm - 1
    }
    // Cap the vertical change per column: a wall you cannot fly around is a
    // dead end, not a challenge.
    let slope = t.pitch * 0.95
    t.curTop = approach(t.curTop, t.tgtTop, slope)
    t.curBot = approach(t.curBot, t.tgtBot, slope)
    let last = t.cols - 1
    for i in 0..last {
        t.top[i] = t.top[i + 1]
        t.bot[i] = t.bot[i + 1]
    }
    t.top[last] = t.curTop
    t.bot[last] = t.curBot
}

pub fn terrainAdvance(t: &mut Terrain, dx: f64) {
    t.offset = t.offset + dx
    var guard: i64 = 0
    while t.offset >= t.pitch && guard < 64 {
        t.offset = t.offset - t.pitch
        stepColumn(&mut t)
        guard = guard + 1
    }
}

// Tightening the aperture is the whole difficulty curve of the terrain.
pub fn terrainSetGap(t: &mut Terrain, gap: f64) {
    t.gap = Math.clampF64(gap, 200.0, t.h)
}

fn colAt(t: &Terrain, x: f64): f64 {
    return (x + t.offset) / t.pitch
}

pub fn topAt(t: &Terrain, x: f64): f64 {
    let f = colAt(t, x)
    var i = f as i64
    if i < 0 {
        i = 0
    }
    if i > t.cols - 2 {
        i = t.cols - 2
    }
    let u = Math.clampF64(f - (i as f64), 0.0, 1.0)
    return t.top[i] + (t.top[i + 1] - t.top[i]) * u
}

pub fn botAt(t: &Terrain, x: f64): f64 {
    let f = colAt(t, x)
    var i = f as i64
    if i < 0 {
        i = 0
    }
    if i > t.cols - 2 {
        i = t.cols - 2
    }
    let u = Math.clampF64(f - (i as f64), 0.0, 1.0)
    return t.bot[i] + (t.bot[i + 1] - t.bot[i]) * u
}

// Three samples across the body, so a steep slope cannot slip between columns.
pub fn terrainHit(t: &Terrain, x: f64, y: f64, r: f64): bool {
    for k in 0..3 {
        let sx = x + ((k as f64) - 1.0) * r
        if y - r < topAt(t, sx) {
            return true
        }
        if y + r > botAt(t, sx) {
            return true
        }
    }
    return false
}

// Deterministic per-world-column noise. It is keyed on `gen` rather than on the
// array index so the texture belongs to the rock and scrolls with it, instead of
// crawling in place while the rock moves underneath.
fn colHash(t: &Terrain, i: i64, salt: i64): f64 {
    let world = t.gen + i
    let v = Math.sin((world as f64) * 12.9898 + (salt as f64) * 78.233) * 43758.5453
    return v - Math.floor(v)
}

// The rock is solid — filled with `fillRect`, which writes rather than adds, so
// it occludes the parallax behind it. A purely additive canvas cannot do this at
// all, which is why `gfx.milo` grew a blend path for this rewrite.
// `ox`/`oy` are the camera shake. The rock has to take the same offset as the
// ship does or the two disagree about where the wall is, and you crash into
// nothing — which is exactly what happened when this drew unshaken.
pub fn terrainDraw(c: &mut Canvas, t: &Terrain) {
    let last = t.cols - 1
    let h = t.h
    for i in 0..last {
        let x0 = (i as f64) * t.pitch - t.offset
        let x1 = x0 + t.pitch
        if x1 < 0.0 || x0 > (c.w as f64) {
            continue
        }
        let ty = t.top[i]
        let by = t.bot[i]

        // body — over-drawn past the frame so a shake never opens a gap
        fillRect(&mut c, x0, 0.0 - 60.0, x1, ty, 0.008, 0.007, 0.009, 1.0)
        fillRect(&mut c, x0, by, x1, h + 60.0, 0.008, 0.007, 0.009, 1.0)

        // Bulbous nodules pressed into the surface: two per column at hashed
        // depths, which is enough to stop the rock reading as a flat bar.
        for k in 0..2 {
            let d0 = 6.0 + colHash(t, i, k * 7 + 1) * 46.0
            let sz = 3.0 + colHash(t, i, k * 7 + 2) * 5.0
            let lit = 0.020 + colHash(t, i, k * 7 + 3) * 0.030
            fillRect(&mut c, x0, ty - d0 - sz, x1, ty - d0, lit, lit * 0.92, lit * 0.80, 1.0)
            let d1 = 6.0 + colHash(t, i, k * 7 + 4) * 46.0
            let s1 = 3.0 + colHash(t, i, k * 7 + 5) * 5.0
            let l1 = 0.020 + colHash(t, i, k * 7 + 6) * 0.030
            fillRect(&mut c, x0, by + d1, x1, by + d1 + s1, l1, l1 * 0.92, l1 * 0.80, 1.0)
        }

        // The lip: a band of pale bone right at the edge, then the wet rim.
        fillRect(&mut c, x0, ty - 7.0, x1, ty, 0.34, 0.31, 0.24, 1.0)
        fillRect(&mut c, x0, by, x1, by + 7.0, 0.34, 0.31, 0.24, 1.0)
        fillRect(&mut c, x0, ty - 3.0, x1, ty, 1.05, 0.98, 0.78, 1.0)
        fillRect(&mut c, x0, by, x1, by + 3.0, 1.05, 0.98, 0.78, 1.0)
        line(&mut c, x0, ty, x1, t.top[i + 1], 0.30, 0.55, 0.62)
        line(&mut c, x0, by, x1, t.bot[i + 1], 0.30, 0.55, 0.62)

        // Every so often the wall has something alive in it. It is deliberately
        // cold and unlit: red glow that pulses is the language this game uses for
        // "this will kill you", and scenery must not speak it.
        if (t.gen + i) % 23 == 0 {
            fillRect(&mut c, x0 + 4.0, ty - 16.0, x1 - 4.0, ty - 8.0, 0.05, 0.13, 0.15, 1.0)
        }
        if (t.gen + i) % 31 == 0 {
            fillRect(&mut c, x0 + 4.0, by + 8.0, x1 - 4.0, by + 16.0, 0.05, 0.13, 0.15, 1.0)
        }
    }
}
