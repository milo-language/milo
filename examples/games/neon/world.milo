// Game state: the scrolling stage, its entities, the weapons, and the pickups
// that rewrite what your gun does while you are still holding it down.
//
// This file exists to answer one objection: "handles are fine for data-oriented
// numeric systems, show me messy gameplay code." So the interactions here are
// deliberately tangled — objects hold links to other objects that can die
// underneath them, deaths mutate their killer, their squad and their parent, and
// a pickup rewrites firing and hitting at runtime with no pause and no menu.
//
// The rule Milo enforces is that no `&T` is ever stored. Every cross-object link
// is a generational `Handle`, so a link to a dead object reads back as "gone"
// instead of a dangling pointer. Nothing here needs a lifetime annotation and
// nothing here is `unsafe`.

from "std/math" import {
    Math
}
from "std/random" import {
    Random
}
from "./grid" import {
    Grid, gridNew, gridUpdate, gridImpulse, gridReset
}
from "./director" import {
    pickSquad, unlockedSquads
}
from "./terrain" import {
    Terrain, terrainNew, terrainReset, terrainAdvance, terrainOpen, terrainSetGap,
    terrainHit, topAt, botAt
}

pub let TAU: f64 = 6.283185307179586

pub let PI: f64 = 3.14159265358979

// Which weapon made a bullet. The renderer picks a sprite from this, so every
// projectile on screen is a distinct object rather than a differently-coloured
// smear of light.
pub let SRC_GUN: i64 = 0

pub let SRC_POD: i64 = 1

pub let SRC_MISSILE: i64 = 2

pub let SRC_BEAM: i64 = 3

pub let SRC_HOSTILE: i64 = 4

// ── handles ───────────────────────────────────────────────────────────────────

// A generational index. Copy, storable anywhere, and never dangling: the slot's
// generation is bumped on death, so an old handle simply stops resolving.
pub struct Handle {
    slot: i64,
    gen: i64,
}

pub fn nullHandle(): Handle {
    return Handle {
        slot: 0 - 1, gen: 0
    }
}

pub fn handleIsNull(h: &Handle): bool {
    return h.slot < 0
}

// ── entities ──────────────────────────────────────────────────────────────────

pub enum Kind {
    Drone, // holds formation, fires backwards down the lane
    Weaver, // rides a sine wave across the screen
    Swooper, // lines up on your altitude, then commits
    Carrier, // fat, escorted, always drops a pickup
    Mine, // drifts, bursts into a radial volley
    Turret, // bolted to the cave, rides the terrain, tracks you
    SnakeHead, // leads a chain of segments
    SnakeSeg, // follows the segment ahead of it
    Healer, // repairs a wounded squadmate over a visible beam
    Core, // boss core
    Plate, // boss armour, orbits its core
    Orb, // the glowing thing you pick up
    Pod, // yours: trails you, shoots on its own, eats what is shot at you
}

pub struct Ent {
    alive: bool,
    gen: i64,
    kind: Kind,
    x: f64,
    y: f64,
    vx: f64,
    vy: f64,
    ang: f64,
    spin: f64,
    radius: f64,
    hp: f64,
    maxHp: f64,
    age: f64,
    phase: f64,
    spawnT: f64, // >0 while materialising: no collision, drawn as a warning ring
    tier: i64, // orb type / plate index / turret mount side
    value: i64, // score
    fireT: f64,
    cr: f64,
    cg: f64,
    cb: f64,
    // status effects — set by one system, ticked by another, read by the renderer
    burn: f64,
    flash: f64,
    // cross-entity links. These are the whole point of the file.
    squad: i64, // formation id, or -1: clearing a whole squad drops a pickup
    leader: Handle, // segment ahead of me / my boss core
    follower: Handle, // segment behind me
    target: Handle, // healer's patient, turret's mark, pod's mark
}

fn blankEnt(): Ent {
    return Ent {
        alive: false, gen: 0, kind: Kind.Orb,
        x: 0.0, y: 0.0, vx: 0.0, vy: 0.0, ang: 0.0, spin: 0.0,
        radius: 8.0, hp: 1.0, maxHp: 1.0, age: 0.0, phase: 0.0, spawnT: 0.0,
        tier: 0, value: 0, fireT: 0.0, cr: 1.0, cg: 1.0, cb: 1.0,
        burn: 0.0, flash: 0.0, squad: 0 - 1,
        leader: nullHandle(), follower: nullHandle(), target: nullHandle(),
    }
}

pub struct Bullet {
    alive: bool,
    x: f64,
    y: f64,
    vx: f64,
    vy: f64,
    px: f64, // previous position — bullets are drawn as streaks
    py: f64,
    life: f64,
    dmg: f64,
    size: f64,
    pierce: i64,
    homing: f64,
    hostile: bool, // shot at you, not by you
    src: i64, // which weapon made it — the renderer picks a sprite from this
    beam: bool, // a released charge: wide, and it clears its own lane
    target: Handle, // may die mid-flight; the missile re-acquires
    cr: f64,
    cg: f64,
    cb: f64,
}

pub struct Particle {
    x: f64,
    y: f64,
    vx: f64,
    vy: f64,
    life: f64,
    maxLife: f64,
    drag: f64,
    size: f64,
    cr: f64,
    cg: f64,
    cb: f64,
}

// A lightning arc, queued by the pod overcharge and drawn for a few frames.
pub struct Arc {
    x0: f64,
    y0: f64,
    x1: f64,
    y1: f64,
    life: f64,
    seed: i64,
}

// Parallax dust. Nothing reads it but the renderer; it exists so the stage
// obviously moves even where the cave is wide open.
pub struct Star {
    x: f64,
    y: f64,
    z: f64,
}

// ── pickups ───────────────────────────────────────────────────────────────────
//
// There is no upgrade screen. An orb is a glowing thing that drifts out of
// something you killed; touching it makes the ship better immediately, and the
// only decision is whether you can reach it.

pub let ORB_POWER: i64 = 0

pub let ORB_POD: i64 = 1

pub let ORB_MISSILE: i64 = 2

pub let ORB_SHIELD: i64 = 3

pub let ORB_SPEED: i64 = 4

pub fn orbName(t: i64): string {
    if t == ORB_POWER {
        return "POWER UP"
    }
    if t == ORB_POD {
        return "POD ONLINE"
    }
    if t == ORB_MISSILE {
        return "MISSILES"
    }
    if t == ORB_SHIELD {
        return "SHIELD UP"
    }
    return "THRUSTERS"
}

pub struct Player {
    x: f64,
    y: f64,
    vx: f64,
    vy: f64,
    alive: bool,
    lives: i64,
    respawn: f64,
    invuln: f64,
    cooldown: f64,
    power: i64, // 1..5 — shot count and rate
    speed: i64, // 0..3 — thruster upgrades
    missiles: i64, // 0..2 — homing racks
    missileT: f64,
    shield: f64, // >0: the next hit is eaten instead of fatal
    shieldT: f64, // countdown to the hull re-plating itself after a hit
    charge: f64, // 0..1 while the fire key is held
    charging: bool,
    beamFlash: f64,
    pods: i64,
}

pub struct World {
    ents: Vec<Ent>,
    free: Vec<i64>,
    bullets: Vec<Bullet>,
    parts: Vec<Particle>,
    arcs: Vec<Arc>,
    stars: Vec<Star>,
    grid: Grid,
    terrain: Terrain,
    player: Player,
    w: f64,
    h: f64,
    time: f64,
    score: i64,
    mult: i64,
    chain: i64, // kills without being hit — feeds the multiplier
    scroll: f64, // px/s the stage moves left
    dist: f64, // how far into the stage we are
    stage: i64,
    stageLen: f64,
    bossUp: bool,
    boss: Handle,
    nextSpawn: f64, // distance at which the next squad enters
    intro: i64, // scripted opening squads left: the first minute is taught, not rolled
    gaveGift: bool, // the free pod that opens a run has been handed over
    squadLive: Vec<i64>, // survivors per formation id; 0 by your hand pays out
    shake: f64,
    slowmo: f64,
    flash: f64,
    gameOver: bool,
    banner: f64,
    hurt: f64, // red edge vignette after taking a hit
    pickupCode: i64, // last orb collected, for the floating label
    pickupT: f64,
    pickupX: f64,
    pickupY: f64,
    // uniform spatial hash over enemies, rebuilt each frame:
    // `hashHead[cell]` is the first entity index, `hashNext[i]` the next one.
    hashHead: Vec<i64>,
    hashNext: Vec<i64>,
    hashCols: i64,
    hashRows: i64,
}

pub let CELL: f64 = 96.0

pub fn worldNew(w: f64, h: f64): World {
    let cols = (w / CELL) as i64 + 2
    let rows = (h / CELL) as i64 + 2
    var stars: Vec<Star> = Vec.new()
    for i in 0..220 {
        stars.push(Star {
            x: Random.floatRange(0.0, w),
            y: Random.floatRange(0.0, h),
            z: Random.floatRange(0.15, 1.0),
        }
        )
    }
    return World {
        ents: Vec.new(),
        free: Vec.new(),
        bullets: Vec.new(),
        parts: Vec.new(),
        arcs: Vec.new(),
        stars: stars,
        grid: gridNew(w, h, 48.0),
        terrain: terrainNew(w, h, 16.0),
        player: Player {
            x: w * 0.22, y: h * 0.5, vx: 0.0, vy: 0.0,
            alive: true, lives: 5, respawn: 0.0, invuln: 3.5,
            cooldown: 0.0, power: 1, speed: 0, missiles: 0, missileT: 0.0,
            shield: 1.0, shieldT: 0.0, charge: 0.0, charging: false, beamFlash: 0.0, pods: 0,
        }
        ,
        w: w,
        h: h,
        time: 0.0,
        score: 0,
        mult: 1,
        chain: 0,
        scroll: 170.0,
        dist: 0.0,
        stage: 1,
        stageLen: 5200.0,
        bossUp: false,
        boss: nullHandle(),
        nextSpawn: 950.0,
        intro: 3,
        gaveGift: false,
        squadLive: Vec.new(),
        shake: 0.0,
        slowmo: 0.0,
        flash: 0.0,
        gameOver: false,
        banner: 2.6,
        hurt: 0.0,
        pickupCode: 0 - 1,
        pickupT: 0.0,
        pickupX: 0.0,
        pickupY: 0.0,
        hashHead: Vec.filled(cols * rows, 0 - 1),
        hashNext: Vec.new(),
        hashCols: cols,
        hashRows: rows,
    }
}

// ── slot table ────────────────────────────────────────────────────────────────

pub fn spawn(w: &mut World, e: Ent): Handle {
    var slot: i64 = 0 - 1
    if w.free.len > 0 {
        slot = w.free.pop() ?? (0 - 1)
    }
    if slot < 0 {
        slot = w.ents.len
        var fresh = e
        fresh.alive = true
        fresh.gen = 1
        w.ents.push(fresh)
        w.hashNext.push(0 - 1)
        return Handle {
            slot: slot, gen: 1
        }
    }
    let g = w.ents[slot].gen + 1
    var reused = e
    reused.alive = true
    reused.gen = g
    w.ents[slot] = reused
    return Handle {
        slot: slot, gen: g
    }
}

// Bumping the generation is what makes every outstanding handle to this slot go
// stale. No other system has to be told the entity died.
pub fn kill(w: &mut World, slot: i64) {
    if slot < 0 || slot >= w.ents.len {
        return
    }
    if !w.ents[slot].alive {
        return
    }
    w.ents[slot].alive = false
    w.ents[slot].gen += 1
    w.free.push(slot)
}

pub fn alive(w: &World, h: &Handle): bool {
    if h.slot < 0 || h.slot >= w.ents.len {
        return false
    }
    return w.ents[h.slot].alive && w.ents[h.slot].gen == h.gen
}

// ── effects ───────────────────────────────────────────────────────────────────

pub fn burst(w: &mut World, x: f64, y: f64, n: i64, speed: f64, cr: f64, cg: f64, cb: f64, size: f64) {
    for i in 0..n {
        let a = Random.floatRange(0.0, TAU)
        let s = Random.floatRange(speed * 0.15, speed)
        let life = Random.floatRange(0.35, 1.1)
        w.parts.push(Particle {
            x: x, y: y,
            vx: Math.cos(a) * s - w.scroll * 0.35, vy: Math.sin(a) * s,
            life: life, maxLife: life, drag: 1.9, size: size,
            cr: cr, cg: cg, cb: cb,
        }
        )
    }
}

pub fn addArc(w: &mut World, x0: f64, y0: f64, x1: f64, y1: f64) {
    w.arcs.push(Arc {
        x0: x0, y0: y0, x1: x1, y1: y1, life: 0.14, seed: Random.range(0, 100000)
    }
    )
}

// ── spawning ──────────────────────────────────────────────────────────────────

pub fn makeEnemy(kind: Kind, x: f64, y: f64): Ent {
    var e = blankEnt()
    e.kind = kind
    e.x = x
    e.y = y
    e.phase = Random.floatRange(0.0, TAU)
    match kind {
        Kind.Drone => {
            e.radius = 15.0
            e.hp = 2.0
            e.value = 20
            e.spin = 1.6
            e.vx = 0.0 - 130.0
            e.fireT = Random.floatRange(2.4, 4.0)
            e.cr = 2.2
            e.cg = 0.06
            e.cb = 0.85
        }
        Kind.Weaver => {
            e.radius = 14.0
            e.hp = 2.0
            e.value = 25
            e.spin = 3.2
            e.vx = 0.0 - 175.0
            e.fireT = Random.floatRange(2.6, 4.2)
            e.cr = 2.2
            e.cg = 1.5
            e.cb = 0.02
        }
        Kind.Swooper => {
            e.radius = 13.0
            e.hp = 2.0
            e.value = 35
            e.spin = 4.5
            e.vx = 0.0 - 90.0
            e.cr = 0.06
            e.cg = 0.9
            e.cb = 2.4
        }
        Kind.Carrier => {
            e.radius = 26.0
            e.hp = 16.0
            e.value = 150
            e.spin = 0.6
            e.vx = 0.0 - 70.0
            e.fireT = 1.4
            e.cr = 2.3
            e.cg = 0.9
            e.cb = 0.05
        }
        Kind.Mine => {
            e.radius = 13.0
            e.hp = 1.0
            e.value = 15
            e.spin = 1.2
            e.vx = 0.0 - 20.0
            // Hard red and nothing else: no pickup is ever red, so a mine can
            // never read as something you want to touch.
            e.cr = 2.4
            e.cg = 0.05
            e.cb = 0.12
        }
        Kind.Turret => {
            e.radius = 15.0
            e.hp = 5.0
            e.value = 45
            e.spin = 0.0
            e.fireT = Random.floatRange(2.6, 4.0)
            e.cr = 1.5
            e.cg = 0.6
            e.cb = 2.0
        }
        Kind.SnakeHead => {
            e.radius = 14.0
            e.hp = 6.0
            e.value = 60
            e.spin = 0.0
            e.vx = 0.0 - 120.0
            e.cr = 1.5
            e.cg = 1.9
            e.cb = 0.05
        }
        Kind.SnakeSeg => {
            e.radius = 11.0
            e.hp = 3.0
            e.value = 15
            e.cr = 1.1
            e.cg = 1.5
            e.cb = 0.03
        }
        Kind.Healer => {
            e.radius = 13.0
            e.hp = 6.0
            e.value = 90
            e.spin = 1.1
            e.vx = 0.0 - 60.0
            e.cr = 0.15
            e.cg = 1.5
            e.cb = 1.6
        }
        Kind.Core => {
            e.radius = 46.0
            e.hp = 150.0
            e.value = 2000
            e.spin = 0.3
            e.fireT = 1.4
            e.cr = 1.8
            e.cg = 0.5
            e.cb = 0.15
            e.spawnT = 1.6
        }
        Kind.Plate => {
            e.radius = 17.0
            e.hp = 22.0
            e.value = 150
            e.spin = 2.0
            e.cr = 1.8
            e.cg = 0.9
            e.cb = 0.2
            e.spawnT = 1.6
        }
        Kind.Orb => {
            e.radius = 13.0
            e.hp = 1.0
            e.value = 0
            e.spin = 1.4
            e.vx = 0.0 - 40.0
            e.cr = 0.2
            e.cg = 2.2
            e.cb = 2.4
        }
        Kind.Pod => {
            e.radius = 12.0
            e.hp = 1.0
            e.value = 0
            e.spin = 5.0
            e.cr = 2.4
            e.cg = 0.5
            e.cb = 2.2
        }
    }
    e.maxHp = e.hp
    return e
}

pub fn isEnemy(k: Kind): bool {
    match k {
        Kind.Orb => {
            return false
        }
        Kind.Pod => {
            return false
        }
        _ => {
            return true
        }
    }
}

// An orb is never a dud: the drop looks at what the ship is missing and picks
// the thing that helps most. A pickup you already have is a punishment for
// getting to it.
fn pickOrbType(w: &World): i64 {
    if w.player.pods == 0 {
        return ORB_POD
    }
    if w.player.shield <= 0.0 && Random.range(0, 3) == 0 {
        return ORB_SHIELD
    }
    if w.player.power < 5 && Random.range(0, 5) < 3 {
        return ORB_POWER
    }
    if w.player.missiles < 2 {
        return ORB_MISSILE
    }
    if w.player.speed < 3 {
        return ORB_SPEED
    }
    if w.player.pods < 2 {
        return ORB_POD
    }
    return ORB_POWER
}

fn orbColour(t: i64, e: &mut Ent) {
    if t == ORB_POWER {
        e.cr = 0.15
        e.cg = 2.0
        e.cb = 2.6
        return
    }
    if t == ORB_POD {
        e.cr = 2.6
        e.cg = 0.25
        e.cb = 2.2
        return
    }
    if t == ORB_MISSILE {
        e.cr = 2.6
        e.cg = 1.3
        e.cb = 0.15
        return
    }
    if t == ORB_SHIELD {
        e.cr = 0.2
        e.cg = 2.6
        e.cb = 0.9
        return
    }
    e.cr = 2.2
    e.cg = 2.2
    e.cb = 2.4
}

pub fn dropOrb(w: &mut World, x: f64, y: f64) {
    let t = pickOrbType(w)
    var e = makeEnemy(Kind.Orb, x, y)
    e.tier = t
    e.vy = Random.floatRange(0.0 - 40.0, 40.0)
    orbColour(t, &mut e)
    let cr = e.cr
    let cg = e.cg
    let cb = e.cb
    let _ = spawn(&mut w, e)
    burst(&mut w, x, y, 14, 180.0, cr * 0.4, cg * 0.4, cb * 0.4, 2.0)
}

// A squad is a formation that pays out only if you clear all of it. The counter
// lives in the world, the id lives on the entity, and nothing holds a reference
// to anything.
pub fn newSquad(w: &mut World, n: i64): i64 {
    w.squadLive.push(n)
    return w.squadLive.len - 1
}

// A snake is a doubly linked chain of entities. Killing a middle segment has to
// splice the chain back together, in both directions.
pub fn spawnSnake(w: &mut World, x: f64, y: f64, len: i64) {
    let head = spawn(&mut w, makeEnemy(Kind.SnakeHead, x, y))
    var prev = head
    for i in 0..len {
        var seg = makeEnemy(Kind.SnakeSeg, x + (i as f64 + 1.0) * 20.0, y)
        seg.leader = prev
        seg.radius = 12.0 - (i as f64) * 0.2
        let h = spawn(&mut w, seg)
        w.ents[prev.slot].follower = h
        prev = h
    }
}

// The boss carries six armour plates that orbit it. Each plate holds a handle to
// the core and the core counts its plates; a plate's death mutates the core, and
// the core's death takes every plate that points at it.
pub fn spawnBoss(w: &mut World, x: f64, y: f64) {
    let core = spawn(&mut w, makeEnemy(Kind.Core, x, y))
    w.ents[core.slot].hp = 110.0 + (w.stage as f64) * 40.0
    w.ents[core.slot].maxHp = w.ents[core.slot].hp
    for i in 0..6 {
        var p = makeEnemy(Kind.Plate, x, y)
        p.leader = core
        p.tier = i
        p.phase = (i as f64) * TAU / 6.0
        let h = spawn(&mut w, p)
        if i == 0 {
            w.ents[core.slot].follower = h
        }
    }
    w.ents[core.slot].tier = 6 // plates remaining
    w.boss = core
    w.bossUp = true
    w.shake = 8.0
    w.banner = 2.4
}

// ── damage and death ──────────────────────────────────────────────────────────

pub fn addScore(w: &mut World, n: i64) {
    w.score = w.score + n * w.mult
}

// Deaths are where the tangle lives: one entity dying rewrites its neighbours'
// links, mutates its parent, decrements a squad counter it does not own, and
// pushes on the background lattice — all through handles, none of it holding a
// reference.
pub fn onDeath(w: &mut World, slot: i64, byPlayer: bool) {
    let e = w.ents[slot]
    let kind = e.kind

    burst(&mut w, e.x, e.y, 24, 300.0, e.cr, e.cg, e.cb, 2.4)
    gridImpulse(&mut w.grid, e.x, e.y, 220.0, 80.0)
    w.shake = Math.maxF64(w.shake, 2.2)

    if byPlayer {
        addScore(&mut w, e.value)
        w.chain += 1
        w.mult = Math.minI64(1 + w.chain / 12, 8)
    }

    match kind {
        Kind.SnakeHead => {
            spliceChain(&mut w, slot)
        }
        Kind.SnakeSeg => {
            spliceChain(&mut w, slot)
        }
        Kind.Mine => {
            // A mine is a trade: killing it at range is free, killing it in your
            // face is not.
            for i in 0..7 {
                let a = (i as f64) * TAU / 7.0 + Random.floatRange(0.0, 0.3)
                fireHostile(&mut w, e.x, e.y, a, 150.0, 1.0)
            }
            burst(&mut w, e.x, e.y, 40, 380.0, 2.0, 0.6, 0.1, 2.8)
            w.shake = Math.maxF64(w.shake, 5.0)
        }
        Kind.Carrier => {
            dropOrb(&mut w, e.x, e.y)
            burst(&mut w, e.x, e.y, 90, 480.0, 2.2, 0.9, 0.1, 3.0)
            w.shake = Math.maxF64(w.shake, 8.0)
        }
        Kind.Plate => {
            // Tell the core it lost a plate. The core may already be gone, in
            // which case the handle simply does not resolve.
            let core = e.leader
            if alive(w, core) {
                w.ents[core.slot].tier -= 1
                w.ents[core.slot].spin *= 1.3
                w.ents[core.slot].flash = 0.3
                w.ents[core.slot].fireT *= 0.86
            }
        }
        Kind.Core => {
            // Core dies, plates go with it.
            for i in 0..w.ents.len {
                if w.ents[i].alive {
                    match w.ents[i].kind {
                        Kind.Plate => {
                            if w.ents[i].leader.slot == slot {
                                burst(&mut w, w.ents[i].x, w.ents[i].y, 40, 420.0, 1.8, 0.9, 0.2, 2.6)
                                kill(&mut w, i)
                            }
                        }
                        _ => {
                        }
                    }
                }
            }
            burst(&mut w, e.x, e.y, 300, 820.0, 1.9, 0.6, 0.15, 3.4)
            gridImpulse(&mut w.grid, e.x, e.y, 700.0, 260.0)
            w.shake = 18.0
            w.flash = 0.9
            w.bossUp = false
            w.boss = nullHandle()
            for i in 0..3 {
                dropOrb(&mut w, e.x + (i as f64) * 40.0 - 40.0, e.y)
            }
            nextStage(&mut w)
        }
        _ => {
        }
    }

    // Squad payout: the counter belongs to the world, the id to the entity, and
    // the last one to die by your hand is the one that pays.
    if e.squad >= 0 && e.squad < w.squadLive.len {
        w.squadLive[e.squad] -= 1
        if w.squadLive[e.squad] == 0 && byPlayer {
            dropOrb(&mut w, e.x, e.y)
        }
    }

    kill(&mut w, slot)
}

// Splice a dead link out of a snake, in both directions. If the head died, the
// next segment is promoted.
fn spliceChain(w: &mut World, slot: i64) {
    let ld = w.ents[slot].leader
    let fo = w.ents[slot].follower
    if alive(w, ld) {
        w.ents[ld.slot].follower = fo
    }
    if alive(w, fo) {
        w.ents[fo.slot].leader = ld
        if !alive(w, ld) {
            w.ents[fo.slot].kind = Kind.SnakeHead
            w.ents[fo.slot].cr = 1.5
            w.ents[fo.slot].cg = 1.9
            w.ents[fo.slot].cb = 0.05
            w.ents[fo.slot].value = 40
        }
    }
}

pub fn damage(w: &mut World, slot: i64, dmg: f64, byPlayer: bool) {
    if slot < 0 || slot >= w.ents.len {
        return
    }
    if !w.ents[slot].alive || w.ents[slot].spawnT > 0.0 {
        return
    }
    match w.ents[slot].kind {
        Kind.Core => {
            // An armoured core is invulnerable while any plate survives.
            if w.ents[slot].tier > 0 {
                w.ents[slot].flash = 0.12
                return
            }
        }
        Kind.Pod => {
            return
        }
        Kind.Orb => {
            return
        }
        _ => {
        }
    }
    w.ents[slot].hp -= dmg
    w.ents[slot].flash = 0.18
    if w.ents[slot].hp <= 0.0 {
        onDeath(&mut w, slot, byPlayer)
    }
}

// ── spatial hash ──────────────────────────────────────────────────────────────
//
// Rebuilt every frame as an intrusive singly-linked list per cell, stored as two
// parallel index arrays. No node allocation, no references — `hashNext[i]` is the
// next entity index in the same cell, or -1.

fn cellOf(w: &World, x: f64, y: f64): i64 {
    var cx = (x / CELL) as i64
    var cy = (y / CELL) as i64
    cx = Math.clampI64(cx, 0, w.hashCols - 1)
    cy = Math.clampI64(cy, 0, w.hashRows - 1)
    return cy * w.hashCols + cx
}

fn rehash(w: &mut World) {
    for i in 0..w.hashHead.len {
        w.hashHead[i] = 0 - 1
    }
    while w.hashNext.len < w.ents.len {
        w.hashNext.push(0 - 1)
    }
    for i in 0..w.ents.len {
        w.hashNext[i] = 0 - 1
        if w.ents[i].alive && w.ents[i].spawnT <= 0.0 && isEnemy(w.ents[i].kind) {
            let c = cellOf(w, w.ents[i].x, w.ents[i].y)
            w.hashNext[i] = w.hashHead[c]
            w.hashHead[c] = i
        }
    }
}

// ── targeting ─────────────────────────────────────────────────────────────────

pub fn nearestEnemy(w: &World, x: f64, y: f64, maxDist: f64, skip: i64): Handle {
    var best: i64 = 0 - 1
    var bestD = maxDist * maxDist
    for i in 0..w.ents.len {
        if w.ents[i].alive && i != skip && w.ents[i].spawnT <= 0.0 && isEnemy(w.ents[i].kind) {
            let dx = w.ents[i].x - x
            let dy = w.ents[i].y - y
            let d2 = dx * dx + dy * dy
            if d2 < bestD {
                bestD = d2
                best = i
            }
        }
    }
    if best < 0 {
        return nullHandle()
    }
    return Handle {
        slot: best, gen: w.ents[best].gen
    }
}

// ── weapons ───────────────────────────────────────────────────────────────────

fn firePlayer(w: &mut World, x: f64, y: f64, ang: f64, speed: f64, dmg: f64, src: i64, cr: f64, cg: f64, cb: f64) {
    w.bullets.push(Bullet {
        alive: true,
        x: x, y: y,
        vx: Math.cos(ang) * speed, vy: Math.sin(ang) * speed,
        px: x, py: y,
        life: 1.4, dmg: dmg, size: 5.0,
        pierce: 0, homing: 0.0,
        hostile: false, beam: false, src: src,
        target: nullHandle(),
        cr: cr, cg: cg, cb: cb,
    }
    )
}

pub fn fireHostile(w: &mut World, x: f64, y: f64, ang: f64, speed: f64, dmg: f64) {
    w.bullets.push(Bullet {
        alive: true,
        x: x, y: y,
        vx: Math.cos(ang) * speed - w.scroll * 0.25, vy: Math.sin(ang) * speed,
        px: x, py: y,
        life: 6.0, dmg: dmg, size: 7.0,
        pierce: 0, homing: 0.0,
        hostile: true, beam: false, src: SRC_HOSTILE,
        target: nullHandle(),
        cr: 2.2, cg: 0.5, cb: 0.15,
    }
    )
}

// Aim where the ship will be, not where it is — a shot at the current position
// is free to ignore.
fn fireAtPlayer(w: &mut World, x: f64, y: f64, speed: f64, dmg: f64) {
    if !w.player.alive {
        return
    }
    let dx = w.player.x - x
    let dy = w.player.y - y
    let d = Math.sqrt(dx * dx + dy * dy) + 0.0001
    let lead = d / speed * 0.6
    let a = Math.atan2(dy + w.player.vy * lead, dx + w.player.vx * lead)
    fireHostile(&mut w, x, y, a, speed, dmg)
}

fn fireMissile(w: &mut World, x: f64, y: f64, up: bool) {
    var vy = 0.0 - 220.0
    if !up {
        vy = 220.0
    }
    w.bullets.push(Bullet {
        alive: true,
        x: x, y: y,
        vx: 180.0, vy: vy,
        px: x, py: y,
        life: 2.8, dmg: 3.2, size: 11.0,
        pierce: 0, homing: 4.2,
        hostile: false, beam: false, src: SRC_MISSILE,
        target: nearestEnemy(w, x, y, 900.0, 0 - 1),
        cr: 2.6, cg: 1.5, cb: 0.35,
    }
    )
}

// The released charge: wide, piercing, and it burns return fire out of its own
// lane, which is what makes holding the key for a second worth doing.
fn fireBeam(w: &mut World, x: f64, y: f64, charge: f64) {
    let p = Math.clampF64(charge, 0.0, 1.0)
    w.bullets.push(Bullet {
        alive: true,
        x: x, y: y,
        vx: 1450.0, vy: 0.0,
        px: x, py: y,
        life: 1.4, dmg: 3.0 + p * 16.0, size: 18.0 + p * 44.0,
        pierce: 999, homing: 0.0,
        hostile: false, beam: true, src: SRC_BEAM,
        target: nullHandle(),
        cr: 1.6, cg: 2.4, cb: 2.6,
    }
    )
    w.player.beamFlash = 0.3
    w.shake = Math.maxF64(w.shake, 3.0 + p * 5.0)
    gridImpulse(&mut w.grid, x, y, 260.0, 0.0 - 90.0)
    burst(&mut w, x + 20.0, y, 26, 260.0, 1.2, 2.0, 2.4, 2.4)
}

fn playerFire(w: &mut World) {
    let px = w.player.x + 22.0
    let py = w.player.y
    let p = w.player.power
    let dmg = 1.0 + (p as f64) * 0.25
    // Straight barrels first: the shot that matters is the one on your line.
    var straight = 1
    if p >= 2 {
        straight = 2
    }
    if p >= 4 {
        straight = 3
    }
    for i in 0..straight {
        let off = ((i as f64) - ((straight - 1) as f64) * 0.5) * 11.0
        firePlayer(&mut w, px, py + off, 0.0, 1120.0, dmg, SRC_GUN, 1.5, 1.9, 0.6)
    }
    if p >= 3 {
        firePlayer(&mut w, px, py, 0.0 - 0.20, 1060.0, dmg * 0.8, SRC_GUN, 1.6, 1.2, 0.4)
        firePlayer(&mut w, px, py, 0.20, 1060.0, dmg * 0.8, SRC_GUN, 1.6, 1.2, 0.4)
    }
    if p >= 5 {
        firePlayer(&mut w, px, py, 0.0 - 0.42, 1000.0, dmg * 0.7, SRC_GUN, 1.7, 0.9, 0.3)
        firePlayer(&mut w, px, py, 0.42, 1000.0, dmg * 0.7, SRC_GUN, 1.7, 0.9, 0.3)
    }
    gridImpulse(&mut w.grid, px, py, 80.0, 12.0)
}

// A hit is where a pickup gets to rewrite what hitting means.
fn onBulletHit(w: &mut World, bi: i64, slot: i64) {
    let bx = w.bullets[bi].x
    let by = w.bullets[bi].y
    let dmg = w.bullets[bi].dmg
    burst(&mut w, bx, by, 4, 170.0, w.bullets[bi].cr, w.bullets[bi].cg, w.bullets[bi].cb, 1.5)

    // Two pods overcharge: hits arc to a second target. The hop resolves through
    // the slot table, so anything that died earlier in this same frame is
    // simply skipped.
    if w.player.pods >= 2 && Random.range(0, 3) == 0 {
        let sx = w.ents[slot].x
        let sy = w.ents[slot].y
        let h = nearestEnemy(w, sx, sy, 190.0, slot)
        if !handleIsNull(h) {
            addArc(&mut w, sx, sy, w.ents[h.slot].x, w.ents[h.slot].y)
            damage(&mut w, h.slot, dmg * 0.6, true)
        }
    }

    damage(&mut w, slot, dmg, true)
    w.bullets[bi].pierce -= 1
    if w.bullets[bi].pierce < 0 {
        w.bullets[bi].alive = false
    }
}

// ── collecting ────────────────────────────────────────────────────────────────

fn addPod(w: &mut World) {
    if w.player.pods >= 2 {
        w.player.power = Math.minI64(w.player.power + 1, 5)
        return
    }
    var p = makeEnemy(Kind.Pod, w.player.x, w.player.y)
    p.tier = w.player.pods
    p.phase = (w.player.pods as f64) * PI
    let _ = spawn(&mut w, p)
    w.player.pods += 1
}

fn collectOrb(w: &mut World, slot: i64) {
    let t = w.ents[slot].tier
    let x = w.ents[slot].x
    let y = w.ents[slot].y
    let cr = w.ents[slot].cr
    let cg = w.ents[slot].cg
    let cb = w.ents[slot].cb
    if t == ORB_POWER {
        if w.player.power < 5 {
            w.player.power += 1
        } else {
            w.score += 500
        }
    } else if t == ORB_POD {
        addPod(&mut w)
    } else if t == ORB_MISSILE {
        if w.player.missiles < 2 {
            w.player.missiles += 1
        } else {
            w.score += 500
        }
    } else if t == ORB_SHIELD {
        w.player.shield = 1.0
    } else {
        if w.player.speed < 3 {
            w.player.speed += 1
        } else {
            w.score += 500
        }
    }
    w.score += 100
    w.pickupCode = t
    w.pickupT = 1.7
    w.pickupX = x
    w.pickupY = y
    w.flash = Math.maxF64(w.flash, 0.28)
    kill(&mut w, slot)
    burst(&mut w, x, y, 40, 340.0, cr, cg, cb, 2.6)
    gridImpulse(&mut w.grid, x, y, 320.0, 90.0)
}

// ── entity behaviour ──────────────────────────────────────────────────────────

fn steer(w: &mut World, i: i64, tx: f64, ty: f64, accel: f64, maxSpeed: f64, dt: f64) {
    let dx = tx - w.ents[i].x
    let dy = ty - w.ents[i].y
    let d = Math.sqrt(dx * dx + dy * dy) + 0.0001
    w.ents[i].vx = w.ents[i].vx + dx / d * accel * dt
    w.ents[i].vy = w.ents[i].vy + dy / d * accel * dt
    let sp = Math.sqrt(w.ents[i].vx * w.ents[i].vx + w.ents[i].vy * w.ents[i].vy)
    if sp > maxSpeed {
        let k = maxSpeed / sp
        w.ents[i].vx *= k
        w.ents[i].vy *= k
    }
}

fn updateEnts(w: &mut World, dt: f64) {
    let px = w.player.x
    let py = w.player.y
    let n = w.ents.len
    for i in 0..n {
        if !w.ents[i].alive {
            continue
        }
        w.ents[i].age += dt
        if w.ents[i].spawnT > 0.0 {
            w.ents[i].spawnT -= dt
            continue
        }
        if w.ents[i].flash > 0.0 {
            w.ents[i].flash -= dt
        }
        // Burn ticks damage over time; it was applied by a completely different
        // system and can kill without anything shooting.
        if w.ents[i].burn > 0.0 {
            w.ents[i].burn -= dt
            damage(&mut w, i, 2.4 * dt, true)
            if !w.ents[i].alive {
                continue
            }
        }

        w.ents[i].ang = w.ents[i].ang + w.ents[i].spin * dt

        match w.ents[i].kind {
            Kind.Drone => {
                w.ents[i].phase = w.ents[i].phase + dt * 2.0
                w.ents[i].vy = Math.sin(w.ents[i].phase) * 46.0
                w.ents[i].fireT -= dt
                if w.ents[i].fireT <= 0.0 && w.ents[i].x < w.w - 20.0 {
                    w.ents[i].fireT = Random.floatRange(2.2, 4.0)
                    fireHostile(&mut w, w.ents[i].x - 16.0, w.ents[i].y, PI, 300.0, 1.0)
                }
            }
            Kind.Weaver => {
                w.ents[i].phase = w.ents[i].phase + dt * 3.1
                w.ents[i].vy = Math.sin(w.ents[i].phase) * 300.0
                w.ents[i].fireT -= dt
                if w.ents[i].fireT <= 0.0 && w.ents[i].x < w.w - 20.0 {
                    w.ents[i].fireT = Random.floatRange(2.4, 4.4)
                    fireAtPlayer(&mut w, w.ents[i].x, w.ents[i].y, 265.0, 1.0)
                }
            }
            Kind.Swooper => {
                // Line up on your altitude, then commit and leave.
                if w.ents[i].age < 1.6 {
                    let want = Math.clampF64(py - w.ents[i].y, 0.0 - 300.0, 300.0)
                    w.ents[i].vy = w.ents[i].vy + want * 2.4 * dt
                    w.ents[i].vy *= Math.pow(0.06, dt)
                } else {
                    w.ents[i].vx = w.ents[i].vx - 700.0 * dt
                }
                w.ents[i].vx = Math.maxF64(w.ents[i].vx, 0.0 - 640.0)
            }
            Kind.Carrier => {
                w.ents[i].phase = w.ents[i].phase + dt * 0.9
                w.ents[i].vy = Math.sin(w.ents[i].phase) * 70.0
                if w.ents[i].x < w.w * 0.72 {
                    w.ents[i].vx *= Math.pow(0.1, dt)
                }
                w.ents[i].fireT -= dt
                if w.ents[i].fireT <= 0.0 && w.ents[i].x < w.w - 20.0 {
                    w.ents[i].fireT = 2.8
                    for k in 0..3 {
                        let a = PI + ((k as f64) - 1.0) * 0.30
                        fireHostile(&mut w, w.ents[i].x - 24.0, w.ents[i].y, a, 300.0, 1.0)
                    }
                }
            }
            Kind.Mine => {
                w.ents[i].vy = Math.sin(w.ents[i].age * 1.7 + w.ents[i].phase) * 22.0
                let mdx = px - w.ents[i].x
                let mdy = py - w.ents[i].y
                if mdx * mdx + mdy * mdy < 56.0 * 56.0 && w.player.alive {
                    onDeath(&mut w, i, false)
                    continue
                }
            }
            Kind.Turret => {
                // Bolted to the cave: it rides whatever the terrain does under
                // it, and it does not care that the terrain is generated.
                w.ents[i].vx = 0.0 - w.scroll
                w.ents[i].vy = 0.0
                if w.ents[i].tier == 0 {
                    w.ents[i].y = botAt(w.terrain, w.ents[i].x) - w.ents[i].radius * 0.7
                } else {
                    w.ents[i].y = topAt(w.terrain, w.ents[i].x) + w.ents[i].radius * 0.7
                }
                if w.player.alive {
                    w.ents[i].ang = Math.atan2(py - w.ents[i].y, px - w.ents[i].x)
                }
                w.ents[i].fireT -= dt
                if w.ents[i].fireT <= 0.0 && w.ents[i].x < w.w - 10.0 && w.ents[i].x > 0.0 {
                    w.ents[i].fireT = Random.floatRange(2.3, 3.8)
                    fireAtPlayer(&mut w, w.ents[i].x, w.ents[i].y, 275.0, 1.0)
                }
            }
            Kind.SnakeHead => {
                w.ents[i].phase = w.ents[i].phase + dt * 2.2
                w.ents[i].vy = Math.sin(w.ents[i].phase) * 210.0
                w.ents[i].ang = Math.atan2(w.ents[i].vy, w.ents[i].vx)
            }
            Kind.SnakeSeg => {
                // Read the segment ahead, write myself. The leader may have died
                // this very frame; `alive` says so and the chain was already
                // spliced, so the handle now points at whoever is ahead.
                let ld = w.ents[i].leader
                if alive(w, ld) {
                    let lx = w.ents[ld.slot].x
                    let ly = w.ents[ld.slot].y
                    let sdx = lx - w.ents[i].x
                    let sdy = ly - w.ents[i].y
                    let sd = Math.sqrt(sdx * sdx + sdy * sdy) + 0.0001
                    let want = w.ents[i].radius + w.ents[ld.slot].radius + 4.0
                    let pull = (sd - want) * 14.0
                    w.ents[i].vx = sdx / sd * pull
                    w.ents[i].vy = sdy / sd * pull
                    w.ents[i].ang = Math.atan2(sdy, sdx)
                } else {
                    w.ents[i].vx = 0.0 - 150.0
                    w.ents[i].vy *= Math.pow(0.4, dt)
                }
            }
            Kind.Healer => {
                // Pick a patient, keep station near it, mend it. When it dies the
                // handle stops resolving and the healer picks someone else.
                let t = w.ents[i].target
                var haveTarget = alive(w, t)
                if haveTarget {
                    if w.ents[t.slot].hp >= w.ents[t.slot].maxHp || t.slot == i {
                        haveTarget = false
                    }
                }
                if !haveTarget {
                    w.ents[i].target = pickPatient(w, i)
                }
                let t2 = w.ents[i].target
                if alive(w, t2) {
                    let tx = w.ents[t2.slot].x
                    let ty = w.ents[t2.slot].y
                    steer(&mut w, i, tx + 60.0, ty, 320.0, 200.0, dt)
                    let hdx = tx - w.ents[i].x
                    let hdy = ty - w.ents[i].y
                    if hdx * hdx + hdy * hdy < 280.0 * 280.0 {
                        let mx = w.ents[t2.slot].maxHp
                        w.ents[t2.slot].hp = Math.minF64(w.ents[t2.slot].hp + 2.6 * dt, mx)
                    }
                } else {
                    w.ents[i].vx = 0.0 - 90.0
                    w.ents[i].vy = Math.sin(w.ents[i].age * 1.4) * 60.0
                }
            }
            Kind.Core => {
                // Holds station on the right and patrols vertically.
                let holdX = w.w * 0.76
                w.ents[i].vx = (holdX - w.ents[i].x) * 1.4
                w.ents[i].phase = w.ents[i].phase + dt * 0.7
                w.ents[i].vy = Math.sin(w.ents[i].phase) * 150.0
                w.ents[i].fireT -= dt
                if w.ents[i].fireT <= 0.0 {
                    w.ents[i].fireT = 1.5
                    if w.ents[i].tier > 0 {
                        for k in 0..5 {
                            let a = PI + ((k as f64) - 2.0) * 0.26
                            fireHostile(&mut w, w.ents[i].x - 40.0, w.ents[i].y, a, 300.0, 1.0)
                        }
                    } else {
                        // Stripped: it stops being careful.
                        for k in 0..14 {
                            let a = (k as f64) * TAU / 14.0 + w.ents[i].age
                            fireHostile(&mut w, w.ents[i].x, w.ents[i].y, a, 250.0, 1.0)
                        }
                        var d = makeEnemy(Kind.Swooper, w.ents[i].x, w.ents[i].y)
                        d.spawnT = 0.3
                        let _ = spawn(&mut w, d)
                    }
                    w.ents[i].flash = 0.2
                }
            }
            Kind.Plate => {
                // Position is derived from the core every frame — a parent-child
                // attachment with no stored pointer either way.
                let core = w.ents[i].leader
                if alive(w, core) {
                    w.ents[i].phase = w.ents[i].phase + dt * 1.3
                    let orbit = w.ents[core.slot].radius + 34.0
                    w.ents[i].x = w.ents[core.slot].x + Math.cos(w.ents[i].phase) * orbit
                    w.ents[i].y = w.ents[core.slot].y + Math.sin(w.ents[i].phase) * orbit * 0.85
                    w.ents[i].vx = 0.0
                    w.ents[i].vy = 0.0
                } else {
                    w.ents[i].vx = 0.0 - 200.0
                }
            }
            Kind.Orb => {
                // The magnet is the whole design: you never have to line up on a
                // pickup, you only have to get near it.
                let odx = px - w.ents[i].x
                let ody = py - w.ents[i].y
                let od2 = odx * odx + ody * ody
                if od2 < 200.0 * 200.0 && w.player.alive {
                    let od = Math.sqrt(od2) + 0.0001
                    w.ents[i].vx = w.ents[i].vx + odx / od * 2000.0 * dt
                    w.ents[i].vy = w.ents[i].vy + ody / od * 2000.0 * dt
                } else {
                    w.ents[i].vx = w.ents[i].vx + (0.0 - 40.0 - w.ents[i].vx) * dt
                }
                w.ents[i].vx *= Math.pow(0.45, dt)
                w.ents[i].vy *= Math.pow(0.45, dt)
                if w.ents[i].age > 16.0 {
                    burst(&mut w, w.ents[i].x, w.ents[i].y, 10, 120.0, w.ents[i].cr * 0.4, w.ents[i].cg * 0.4, w.ents[i].cb * 0.4, 1.6)
                    kill(&mut w, i)
                    continue
                }
            }
            Kind.Pod => {
                podUpdate(&mut w, i, dt)
            }
        }

        w.ents[i].x = w.ents[i].x + w.ents[i].vx * dt
        w.ents[i].y = w.ents[i].y + w.ents[i].vy * dt

        // Vertical bounds. Turrets are already pinned to the rock; everything
        // else stays inside the frame so nothing hides behind the wall.
        match w.ents[i].kind {
            Kind.Turret => {
            }
            Kind.Pod => {
            }
            _ => {
                let r = w.ents[i].radius
                if w.ents[i].y < r {
                    w.ents[i].y = r
                    w.ents[i].vy = Math.abs(w.ents[i].vy)
                }
                if w.ents[i].y > w.h - r {
                    w.ents[i].y = w.h - r
                    w.ents[i].vy = 0.0 - Math.abs(w.ents[i].vy)
                }
            }
        }

        // Off the left edge is gone, not dead: no score, no drop.
        if w.ents[i].x < 0.0 - 90.0 {
            match w.ents[i].kind {
                Kind.Pod => {
                }
                _ => {
                    kill(&mut w, i)
                    continue
                }
            }
        }

        if isEnemy(w.ents[i].kind) {
            gridImpulse(&mut w.grid, w.ents[i].x, w.ents[i].y, w.ents[i].radius * 4.0, 0.0 - 12.0)
        }
    }
}

// The pod: it trails you, it shoots without being told to, and it is the only
// thing on screen that cannot be destroyed. Two of them bracket the ship.
fn podUpdate(w: &mut World, i: i64, dt: f64) {
    var offY = 0.0 - 34.0
    if w.ents[i].tier == 1 {
        offY = 34.0
    }
    w.ents[i].phase = w.ents[i].phase + dt * 2.4
    let tx = w.player.x + 26.0 + Math.sin(w.ents[i].phase) * 5.0
    let ty = w.player.y + offY + Math.cos(w.ents[i].phase * 1.3) * 5.0
    // Spring toward the station instead of snapping to it, so the pods lag and
    // swing when you move — the movement is most of the character.
    w.ents[i].vx = w.ents[i].vx + (tx - w.ents[i].x) * 42.0 * dt
    w.ents[i].vy = w.ents[i].vy + (ty - w.ents[i].y) * 42.0 * dt
    w.ents[i].vx *= Math.pow(0.0009, dt)
    w.ents[i].vy *= Math.pow(0.0009, dt)

    let t = w.ents[i].target
    if !alive(w, t) {
        w.ents[i].target = nearestEnemy(w, w.ents[i].x, w.ents[i].y, 620.0, 0 - 1)
    }
    w.ents[i].fireT -= dt
    if w.ents[i].fireT <= 0.0 {
        w.ents[i].fireT = 0.26
        let t2 = w.ents[i].target
        var a = 0.0
        if alive(w, t2) {
            a = Math.atan2(w.ents[t2.slot].y - w.ents[i].y, w.ents[t2.slot].x - w.ents[i].x)
            // Never shoot backwards: a pod firing left reads as a bug.
            a = Math.clampF64(a, 0.0 - 1.0, 1.0)
        }
        firePlayer(&mut w, w.ents[i].x + 10.0, w.ents[i].y, a, 940.0, 0.9, SRC_POD, 2.2, 0.7, 2.2)
    }
    if Random.range(0, 3) == 0 {
        w.parts.push(Particle {
            x: w.ents[i].x, y: w.ents[i].y,
            vx: Random.floatRange(0.0 - 60.0, 20.0), vy: Random.floatRange(0.0 - 40.0, 40.0),
            life: 0.3, maxLife: 0.3, drag: 2.4, size: 1.8,
            cr: 1.6, cg: 0.3, cb: 1.6,
        }
        )
    }
}

fn pickPatient(w: &World, self: i64): Handle {
    var best: i64 = 0 - 1
    var bestScore = 0.0
    for i in 0..w.ents.len {
        if w.ents[i].alive && i != self && isEnemy(w.ents[i].kind) && w.ents[i].spawnT <= 0.0 {
            let missing = w.ents[i].maxHp - w.ents[i].hp
            if missing > 0.05 {
                let dx = w.ents[i].x - w.ents[self].x
                let dy = w.ents[i].y - w.ents[self].y
                let s = missing * 4000.0 / (dx * dx + dy * dy + 100.0)
                if s > bestScore {
                    bestScore = s
                    best = i
                }
            }
        }
    }
    if best < 0 {
        return nullHandle()
    }
    return Handle {
        slot: best, gen: w.ents[best].gen
    }
}

// ── bullets ───────────────────────────────────────────────────────────────────

// A released charge burns return fire out of its own lane.
fn beamSweep(w: &mut World, bi: i64) {
    let bx = w.bullets[bi].x
    let by = w.bullets[bi].y
    let rad = w.bullets[bi].size * 0.5
    for k in 0..w.bullets.len {
        if k != bi && w.bullets[k].alive && w.bullets[k].hostile {
            let dx = w.bullets[k].x - bx
            let dy = w.bullets[k].y - by
            if dx * dx < 5000.0 && dy * dy < rad * rad {
                w.bullets[k].alive = false
                burst(&mut w, w.bullets[k].x, w.bullets[k].y, 3, 120.0, 1.4, 2.0, 2.2, 1.4)
            }
        }
    }
}

fn hitPlayerBullet(w: &mut World, bi: i64): bool {
    if !w.player.alive || w.player.invuln > 0.0 {
        return false
    }
    let dx = w.bullets[bi].x - w.player.x
    let dy = w.bullets[bi].y - w.player.y
    let rr = w.bullets[bi].size * 0.5 + 10.0
    if dx * dx + dy * dy < rr * rr {
        w.bullets[bi].alive = false
        hurtPlayer(&mut w)
        return true
    }
    return false
}

// Pods eat what is shot at you. This is why a pod is worth more than a gun.
fn hitPodBullet(w: &mut World, bi: i64): bool {
    for i in 0..w.ents.len {
        if w.ents[i].alive {
            match w.ents[i].kind {
                Kind.Pod => {
                    let dx = w.bullets[bi].x - w.ents[i].x
                    let dy = w.bullets[bi].y - w.ents[i].y
                    let rr = w.bullets[bi].size * 0.5 + w.ents[i].radius
                    if dx * dx + dy * dy < rr * rr {
                        w.bullets[bi].alive = false
                        burst(&mut w, w.bullets[bi].x, w.bullets[bi].y, 8, 200.0, 2.0, 0.6, 2.0, 1.8)
                        return true
                    }
                }
                _ => {
                }
            }
        }
    }
    return false
}

fn updateBullets(w: &mut World, dt: f64) {
    let n = w.bullets.len
    for i in 0..n {
        if !w.bullets[i].alive {
            continue
        }
        w.bullets[i].life -= dt
        if w.bullets[i].life <= 0.0 {
            w.bullets[i].alive = false
            continue
        }
        if w.bullets[i].homing > 0.0 {
            let t = w.bullets[i].target
            if !alive(w, t) {
                // The mark died; find a new one. This is the case that a raw
                // pointer would get wrong and a generational handle gets right.
                w.bullets[i].target = nearestEnemy(w, w.bullets[i].x, w.bullets[i].y, 700.0, 0 - 1)
            }
            let t2 = w.bullets[i].target
            if alive(w, t2) {
                let dx = w.ents[t2.slot].x - w.bullets[i].x
                let dy = w.ents[t2.slot].y - w.bullets[i].y
                let d = Math.sqrt(dx * dx + dy * dy) + 0.0001
                let sp = Math.sqrt(w.bullets[i].vx * w.bullets[i].vx + w.bullets[i].vy * w.bullets[i].vy)
                w.bullets[i].vx = w.bullets[i].vx + dx / d * sp * w.bullets[i].homing * dt
                w.bullets[i].vy = w.bullets[i].vy + dy / d * sp * w.bullets[i].homing * dt
                let s2 = Math.sqrt(w.bullets[i].vx * w.bullets[i].vx + w.bullets[i].vy * w.bullets[i].vy)
                w.bullets[i].vx = w.bullets[i].vx * sp / s2
                w.bullets[i].vy = w.bullets[i].vy * sp / s2
            } else {
                // Nothing to chase: flatten out and fly on down the lane.
                w.bullets[i].vy *= Math.pow(0.02, dt)
                w.bullets[i].vx = w.bullets[i].vx + 400.0 * dt
            }
            if Random.range(0, 2) == 0 {
                w.parts.push(Particle {
                    x: w.bullets[i].x, y: w.bullets[i].y,
                    vx: Random.floatRange(0.0 - 60.0, 20.0), vy: Random.floatRange(0.0 - 30.0, 30.0),
                    life: 0.26, maxLife: 0.26, drag: 2.6, size: 1.9,
                    cr: 1.9, cg: 0.8, cb: 0.15,
                }
                )
            }
        }
        w.bullets[i].px = w.bullets[i].x
        w.bullets[i].py = w.bullets[i].y
        w.bullets[i].x = w.bullets[i].x + w.bullets[i].vx * dt
        w.bullets[i].y = w.bullets[i].y + w.bullets[i].vy * dt

        if w.bullets[i].x < 0.0 - 40.0 || w.bullets[i].x > w.w + 60.0 || w.bullets[i].y < 0.0 - 40.0 || w.bullets[i].y > w.h + 40.0 {
            w.bullets[i].alive = false
            continue
        }

        // The cave stops bullets. A beam does not care.
        if !w.bullets[i].beam {
            if terrainHit(w.terrain, w.bullets[i].x, w.bullets[i].y, 2.0) {
                burst(&mut w, w.bullets[i].x, w.bullets[i].y, 4, 150.0, w.bullets[i].cr * 0.7, w.bullets[i].cg * 0.7, w.bullets[i].cb * 0.7, 1.5)
                gridImpulse(&mut w.grid, w.bullets[i].x, w.bullets[i].y, 60.0, 8.0)
                w.bullets[i].alive = false
                continue
            }
        }

        if w.bullets[i].hostile {
            if hitPodBullet(&mut w, i) {
                continue
            }
            let _ = hitPlayerBullet(&mut w, i)
            continue
        }

        if w.bullets[i].beam {
            beamSweep(&mut w, i)
        }
        gridImpulse(&mut w.grid, w.bullets[i].x, w.bullets[i].y, 50.0, 6.0)

        // hash lookup: own cell plus the ring around it
        let bx = w.bullets[i].x
        let by = w.bullets[i].y
        let cx = (bx / CELL) as i64
        let cy = (by / CELL) as i64
        var span = 1
        if w.bullets[i].size > 40.0 {
            span = 2
        }
        for oy in 0 - span..span + 1 {
            for ox in 0 - span..span + 1 {
                let gx = cx + ox
                let gy = cy + oy
                if gx < 0 || gy < 0 || gx >= w.hashCols || gy >= w.hashRows {
                    continue
                }
                var e = w.hashHead[gy * w.hashCols + gx]
                while e >= 0 {
                    let nxt = w.hashNext[e]
                    if w.ents[e].alive && w.bullets[i].alive {
                        let dx = w.ents[e].x - bx
                        let dy = w.ents[e].y - by
                        let rr = w.ents[e].radius + w.bullets[i].size * 0.5
                        if dx * dx + dy * dy < rr * rr {
                            onBulletHit(&mut w, i, e)
                        }
                    }
                    e = nxt
                }
            }
        }
    }

    // compact
    var k: i64 = 0
    while k < w.bullets.len {
        if w.bullets[k].alive {
            k += 1
        } else {
            let last = w.bullets.len - 1
            w.bullets[k] = w.bullets[last]
            let _ = w.bullets.pop()
        }
    }
}

// ── player ────────────────────────────────────────────────────────────────────

// A hit with a shield up costs the shield and nothing else. Without one it costs
// a life and a power level — enough to sting, not enough to end the run.
fn hurtPlayer(w: &mut World) {
    if !w.player.alive || w.player.invuln > 0.0 {
        return
    }
    if w.player.shield > 0.0 {
        w.player.shield = 0.0
        w.player.shieldT = 13.0
        w.player.invuln = 1.4
        w.hurt = 0.5
        w.shake = 7.0
        w.flash = 0.4
        burst(&mut w, w.player.x, w.player.y, 70, 420.0, 0.3, 2.2, 1.0, 2.6)
        gridImpulse(&mut w.grid, w.player.x, w.player.y, 340.0, 130.0)
        return
    }
    killPlayer(&mut w)
}

fn killPlayer(w: &mut World) {
    if !w.player.alive || w.player.invuln > 0.0 {
        return
    }
    w.player.alive = false
    w.hurt = 1.2
    w.player.lives -= 1
    w.player.respawn = 1.7
    w.player.shieldT = 6.0 // come back bare, but not for long
    w.player.charge = 0.0
    w.player.charging = false
    w.player.power = Math.maxI64(1, w.player.power - 1)
    w.chain = 0
    w.mult = 1
    w.shake = 18.0
    w.flash = 0.9
    w.slowmo = 0.8
    burst(&mut w, w.player.x, w.player.y, 280, 720.0, 1.6, 1.6, 1.9, 3.2)
    gridImpulse(&mut w.grid, w.player.x, w.player.y, 640.0, 280.0)
    // Clear the lane you are about to come back into.
    for i in 0..w.bullets.len {
        if w.bullets[i].hostile {
            w.bullets[i].alive = false
        }
    }
    terrainOpen(&mut w.terrain, 90)
    if w.player.lives <= 0 {
        w.gameOver = true
    }
}

fn updatePlayer(w: &mut World, dt: f64, mx: f64, my: f64, holdFire: bool) {
    if !w.player.alive {
        w.player.respawn -= dt
        if w.player.respawn <= 0.0 && !w.gameOver {
            w.player.alive = true
            w.player.x = w.w * 0.22
            // Come back in the middle of whatever aperture is actually there.
            // terrainOpen only affects columns generated from now on, so the
            // rock you died in is still on screen.
            w.player.y = (topAt(w.terrain, w.player.x) + botAt(w.terrain, w.player.x)) * 0.5
            w.player.vx = 0.0
            w.player.vy = 0.0
            w.player.invuln = 3.4
            gridImpulse(&mut w.grid, w.player.x, w.player.y, 400.0, 110.0)
        }
        return
    }
    if w.player.invuln > 0.0 {
        w.player.invuln -= dt
    }
    if w.player.beamFlash > 0.0 {
        w.player.beamFlash -= dt
    }
    // The hull re-plates itself if you stay clean for a while. A shooter where a
    // single mistake compounds into the next one is not hard, it is brittle.
    if w.player.shield <= 0.0 {
        w.player.shieldT -= dt
        if w.player.shieldT <= 0.0 {
            w.player.shield = 1.0
            w.flash = Math.maxF64(w.flash, 0.2)
            burst(&mut w, w.player.x, w.player.y, 18, 180.0, 0.2, 1.6, 0.8, 2.0)
        }
    }

    let accel = 3900.0 + (w.player.speed as f64) * 900.0
    let maxSpd = 480.0 + (w.player.speed as f64) * 110.0
    var dx = mx
    var dy = my
    let m = Math.sqrt(dx * dx + dy * dy)
    if m > 0.0001 {
        dx /= m
        dy /= m
        w.player.vx = w.player.vx + dx * accel * dt
        w.player.vy = w.player.vy + dy * accel * dt
    }
    let drag = Math.pow(0.0016, dt)
    w.player.vx *= drag
    w.player.vy *= drag
    let sp = Math.sqrt(w.player.vx * w.player.vx + w.player.vy * w.player.vy)
    if sp > maxSpd {
        w.player.vx = w.player.vx * maxSpd / sp
        w.player.vy = w.player.vy * maxSpd / sp
    }
    w.player.x = w.player.x + w.player.vx * dt
    w.player.y = w.player.y + w.player.vy * dt
    // The ship lives in the left two-thirds: the right third is where you read
    // what is coming.
    w.player.x = Math.clampF64(w.player.x, 22.0, w.w * 0.70)
    w.player.y = Math.clampF64(w.player.y, 14.0, w.h - 14.0)

    // engine plume — always on, because the stage is always moving
    w.parts.push(Particle {
        x: w.player.x - 18.0, y: w.player.y + Random.floatRange(0.0 - 3.0, 3.0),
        vx: 0.0 - 340.0 + w.player.vx * 0.4, vy: w.player.vy * 0.4 + Random.floatRange(0.0 - 40.0, 40.0),
        life: 0.26, maxLife: 0.26, drag: 3.0, size: 2.4,
        cr: 0.5, cg: 1.2, cb: 1.9,
    }
    )

    gridImpulse(&mut w.grid, w.player.x, w.player.y, 140.0, 0.0 - 30.0)

    // Flying into the rock is fatal. It is also the only thing in the game that
    // kills you without shooting at you.
    if terrainHit(w.terrain, w.player.x, w.player.y, 8.0) {
        killPlayer(&mut w)
        return
    }

    // Charging: hold to build, release to spend. One key, no mode to discover.
    if holdFire {
        w.player.charging = true
        w.player.charge = Math.minF64(w.player.charge + dt * 0.85, 1.0)
        if Random.range(0, 2) == 0 && w.player.charge > 0.12 {
            let a = Random.floatRange(0.0, TAU)
            let r = 40.0 * (1.0 - w.player.charge) + 12.0
            w.parts.push(Particle {
                x: w.player.x + 22.0 + Math.cos(a) * r, y: w.player.y + Math.sin(a) * r,
                vx: 0.0 - Math.cos(a) * r * 3.0, vy: 0.0 - Math.sin(a) * r * 3.0,
                life: 0.22, maxLife: 0.22, drag: 0.4, size: 2.0,
                cr: 1.0 + w.player.charge, cg: 1.8, cb: 2.2,
            }
            )
        }
    } else {
        if w.player.charging {
            w.player.charging = false
            if w.player.charge > 0.22 {
                fireBeam(&mut w, w.player.x + 26.0, w.player.y, w.player.charge)
            }
            w.player.charge = 0.0
        }
    }

    // The gun never stops. Holding a key to shoot adds nothing here — the key is
    // for the charge.
    w.player.cooldown -= dt
    if w.player.cooldown <= 0.0 {
        w.player.cooldown = 0.165 - (w.player.power as f64) * 0.013
        playerFire(&mut w)
    }

    if w.player.missiles > 0 {
        w.player.missileT -= dt
        if w.player.missileT <= 0.0 {
            w.player.missileT = 0.75
            fireMissile(&mut w, w.player.x + 6.0, w.player.y - 10.0, true)
            if w.player.missiles > 1 {
                fireMissile(&mut w, w.player.x + 6.0, w.player.y + 10.0, false)
            }
        }
    }

    // touch: enemies hurt, orbs help
    for i in 0..w.ents.len {
        if !w.ents[i].alive || w.ents[i].spawnT > 0.0 {
            continue
        }
        let tdx = w.ents[i].x - w.player.x
        let tdy = w.ents[i].y - w.player.y
        let rr = w.ents[i].radius + 11.0
        if tdx * tdx + tdy * tdy < rr * rr {
            match w.ents[i].kind {
                Kind.Orb => {
                    collectOrb(&mut w, i)
                }
                Kind.Pod => {
                }
                _ => {
                    hurtPlayer(&mut w)
                    if !w.player.alive {
                        return
                    }
                }
            }
        }
    }
}

// ── particles, arcs, stars ────────────────────────────────────────────────────

fn updateParticles(w: &mut World, dt: f64) {
    var k: i64 = 0
    while k < w.parts.len {
        w.parts[k].life -= dt
        if w.parts[k].life <= 0.0 {
            let last = w.parts.len - 1
            w.parts[k] = w.parts[last]
            let _ = w.parts.pop()
        } else {
            let d = Math.pow(0.0001, w.parts[k].drag * dt)
            w.parts[k].vx *= d
            w.parts[k].vy *= d
            w.parts[k].x = w.parts[k].x + w.parts[k].vx * dt
            w.parts[k].y = w.parts[k].y + w.parts[k].vy * dt
            k += 1
        }
    }
    var a: i64 = 0
    while a < w.arcs.len {
        w.arcs[a].life -= dt
        if w.arcs[a].life <= 0.0 {
            let last = w.arcs.len - 1
            w.arcs[a] = w.arcs[last]
            let _ = w.arcs.pop()
        } else {
            a += 1
        }
    }
}

fn updateStars(w: &mut World, dt: f64) {
    for i in 0..w.stars.len {
        w.stars[i].x = w.stars[i].x - w.scroll * w.stars[i].z * 1.7 * dt
        if w.stars[i].x < 0.0 - 4.0 {
            w.stars[i].x = w.w + Random.floatRange(0.0, 40.0)
            w.stars[i].y = Random.floatRange(0.0, w.h)
            w.stars[i].z = Random.floatRange(0.15, 1.0)
        }
    }
}

// ── the stage director ────────────────────────────────────────────────────────

fn spawnY(w: &World, pad: f64): f64 {
    let x = w.w + 60.0
    let lo = topAt(w.terrain, x) + pad
    let hi = botAt(w.terrain, x) - pad
    if hi <= lo {
        return (lo + hi) * 0.5
    }
    return Random.floatRange(lo, hi)
}

fn squadDrones(w: &mut World) {
    let n = 4 + Random.range(0, 3)
    let id = newSquad(&mut w, n)
    let y0 = spawnY(w, 90.0)
    for i in 0..n {
        var e = makeEnemy(Kind.Drone, w.w + 60.0 + (i as f64) * 46.0, y0 + (i as f64) * 26.0 - (n as f64) * 13.0)
        e.squad = id
        e.y = Math.clampF64(e.y, 30.0, w.h - 30.0)
        let _ = spawn(&mut w, e)
    }
}

// The teaching wave: a plain line of grunts, no escort, entering slowly and
// holding their fire long enough for you to shoot first.
fn introSquad(w: &mut World, n: i64) {
    let id = newSquad(&mut w, n)
    let y0 = spawnY(w, 110.0)
    for i in 0..n {
        var e = makeEnemy(Kind.Drone, w.w + 60.0 + (i as f64) * 58.0, y0 + ((i as f64) - ((n - 1) as f64) * 0.5) * 40.0)
        e.squad = id
        e.vx = 0.0 - 95.0
        e.fireT = 3.4 + (i as f64) * 0.5
        e.y = Math.clampF64(e.y, 40.0, w.h - 40.0)
        let _ = spawn(&mut w, e)
    }
}

fn squadWeavers(w: &mut World) {
    let n = 3 + Random.range(0, 3)
    let id = newSquad(&mut w, n)
    for i in 0..n {
        var e = makeEnemy(Kind.Weaver, w.w + 60.0 + (i as f64) * 70.0, w.h * 0.5)
        e.squad = id
        e.phase = (i as f64) * 0.7
        let _ = spawn(&mut w, e)
    }
}

fn squadSwoopers(w: &mut World) {
    let id = newSquad(&mut w, 3)
    for i in 0..3 {
        var e = makeEnemy(Kind.Swooper, w.w + 60.0 + (i as f64) * 90.0, spawnY(w, 70.0))
        e.squad = id
        let _ = spawn(&mut w, e)
    }
}

fn squadCarrier(w: &mut World) {
    var c = makeEnemy(Kind.Carrier, w.w + 90.0, spawnY(w, 120.0))
    c.hp = 16.0 + (w.stage as f64) * 5.0
    c.maxHp = c.hp
    let cy = c.y
    let _ = spawn(&mut w, c)
    for i in 0..3 {
        var e = makeEnemy(Kind.Drone, w.w + 160.0 + (i as f64) * 40.0, cy + ((i as f64) - 1.0) * 60.0)
        e.y = Math.clampF64(e.y, 30.0, w.h - 30.0)
        let _ = spawn(&mut w, e)
    }
}

fn squadMines(w: &mut World) {
    for i in 0..7 {
        let _ = spawn(&mut w, makeEnemy(Kind.Mine, w.w + 60.0 + Random.floatRange(0.0, 380.0), spawnY(w, 40.0)))
    }
}

fn squadTurrets(w: &mut World) {
    let n = 2 + Random.range(0, 2)
    for i in 0..n {
        let x = w.w + 60.0 + (i as f64) * 190.0
        var e = makeEnemy(Kind.Turret, x, 0.0)
        if Random.range(0, 2) == 0 {
            e.tier = 1
            e.y = topAt(w.terrain, w.w + 60.0)
        } else {
            e.tier = 0
            e.y = botAt(w.terrain, w.w + 60.0)
        }
        let _ = spawn(&mut w, e)
    }
}

fn squadSnake(w: &mut World) {
    spawnSnake(&mut w, w.w + 80.0, spawnY(w, 120.0), 5 + Math.minI64(w.stage * 2, 8))
}

fn squadHealer(w: &mut World) {
    let n = 4
    let id = newSquad(&mut w, n + 1)
    let y0 = spawnY(w, 110.0)
    var hl = makeEnemy(Kind.Healer, w.w + 200.0, y0)
    hl.squad = id
    let _ = spawn(&mut w, hl)
    for i in 0..n {
        var e = makeEnemy(Kind.Drone, w.w + 60.0 + (i as f64) * 44.0, y0 + ((i as f64) - 1.5) * 44.0)
        e.squad = id
        e.hp = 4.0
        e.maxHp = 4.0
        e.y = Math.clampF64(e.y, 30.0, w.h - 30.0)
        let _ = spawn(&mut w, e)
    }
}

pub fn squadName(id: i64): string {
    if id == 0 {
        return "INTERCEPTORS"
    }
    if id == 1 {
        return "WEAVERS"
    }
    if id == 2 {
        return "DIVERS"
    }
    if id == 3 {
        return "WALL GUNS"
    }
    if id == 4 {
        return "MINEFIELD"
    }
    if id == 5 {
        return "CARRIER"
    }
    if id == 6 {
        return "SERPENT"
    }
    return "MEDIC WING"
}

fn runSquad(w: &mut World, id: i64) {
    if id == 0 {
        squadDrones(&mut w)
        return
    }
    if id == 1 {
        squadWeavers(&mut w)
        return
    }
    if id == 2 {
        squadSwoopers(&mut w)
        return
    }
    if id == 3 {
        squadTurrets(&mut w)
        return
    }
    if id == 4 {
        squadMines(&mut w)
        return
    }
    if id == 5 {
        squadCarrier(&mut w)
        return
    }
    if id == 6 {
        squadSnake(&mut w)
        return
    }
    squadHealer(&mut w)
}

fn nextStage(w: &mut World) {
    w.stage += 1
    w.dist = 0.0
    w.stageLen = 5200.0 + (w.stage as f64) * 900.0
    w.scroll = Math.minF64(170.0 + (w.stage as f64) * 18.0, 280.0)
    w.nextSpawn = 900.0
    w.intro = 1
    w.banner = 2.6
    w.player.lives = Math.minI64(w.player.lives + 1, 5)
    terrainSetGap(&mut w.terrain, Math.maxF64(w.h * 0.92 - (w.stage as f64) * 24.0, w.h * 0.60))
    terrainOpen(&mut w.terrain, 60)
}

fn updateStage(w: &mut World, dt: f64) {
    if w.bossUp {
        // The boss fight happens in a clear room, and the stage waits for it.
        terrainOpen(&mut w.terrain, 30)
        if !alive(w, w.boss) {
            w.bossUp = false
        }
        return
    }
    w.dist = w.dist + w.scroll * dt
    if w.dist > w.stageLen {
        spawnBoss(&mut w, w.w + 140.0, w.h * 0.5)
        return
    }
    // The free pod. A run that opens with the weakest gun and nothing helping you
    // is a run that teaches nothing in its first ten seconds.
    if !w.gaveGift && w.dist > 220.0 {
        w.gaveGift = true
        dropOrb(&mut w, w.w + 30.0, w.h * 0.5)
    }

    if w.dist > w.nextSpawn {
        // A scripted opening: the first squads are always the plain grunt, and
        // they arrive three, then four, then five. Rolling wall-guns or divers as
        // the very first thing you ever see is not difficulty, it is an ambush at
        // the point where you do not yet know what the game is.
        if w.intro > 0 {
            introSquad(&mut w, 6 - w.intro)
            w.intro -= 1
            w.nextSpawn = w.dist + 640.0
            return
        }
        let unlocked = unlockedSquads(w.stage)
        // The newest squad type is rarer than the staples, so a stage still reads
        // mostly like the one before it. This is taste, so it stays here; the
        // rules worth proving live in `pickSquad`.
        var roll = Random.range(0, unlocked)
        if unlocked > 4 && roll == unlocked - 1 && Random.range(0, 3) != 0 {
            roll = Random.range(0, unlocked - 1)
        }
        // The rolls are drawn here; the decision itself is a pure function with a
        // contract, so the pacing rules are checked rather than believed.
        let pick = pickSquad(w.intro, unlocked, roll)
        runSquad(&mut w, pick)
        w.nextSpawn = w.dist + Math.maxF64(260.0, Random.floatRange(560.0, 880.0) - (w.stage as f64) * 22.0)
    }
}

// ── top-level tick ────────────────────────────────────────────────────────────

pub fn worldUpdate(w: &mut World, dtIn: f64, mx: f64, my: f64, holdFire: bool) {
    var dt = dtIn
    if w.slowmo > 0.0 {
        w.slowmo -= dtIn
        dt = dtIn * 0.32
    }
    w.time += dt

    if w.shake > 0.0 {
        w.shake *= Math.pow(0.02, dt)
    }
    if w.flash > 0.0 {
        w.flash = w.flash - dt * 2.2
    }
    if w.banner > 0.0 {
        w.banner -= dt
    }
    if w.hurt > 0.0 {
        w.hurt -= dt
    }
    if w.pickupT > 0.0 {
        w.pickupT -= dt
        w.pickupY = w.pickupY - 34.0 * dt
    }

    // Game over freezes the stage but keeps the background alive, so the lattice
    // keeps rippling behind the text.
    if w.gameOver {
        updateParticles(&mut w, dt)
        updateStars(&mut w, dt)
        gridUpdate(&mut w.grid, dt)
        return
    }

    terrainAdvance(&mut w.terrain, w.scroll * dt)
    updateStars(&mut w, dt)
    rehash(&mut w)
    updatePlayer(&mut w, dt, mx, my, holdFire)
    updateEnts(&mut w, dt)
    updateBullets(&mut w, dt)
    updateParticles(&mut w, dt)
    updateStage(&mut w, dt)
    gridUpdate(&mut w.grid, dt)
}

pub fn worldReset(w: &mut World) {
    // clear() keeps the storage a run has already grown into, so a restart does
    // not re-allocate everything from scratch mid-session.
    w.ents.clear()
    w.free.clear()
    w.bullets.clear()
    w.parts.clear()
    w.arcs.clear()
    w.hashNext.clear()
    w.squadLive.clear()
    w.player.x = w.w * 0.22
    w.player.y = w.h * 0.5
    w.player.vx = 0.0
    w.player.vy = 0.0
    w.player.alive = true
    w.player.lives = 5
    w.player.power = 1
    w.player.speed = 0
    w.player.missiles = 0
    w.player.missileT = 0.0
    w.player.shield = 1.0
    w.player.shieldT = 0.0
    w.player.charge = 0.0
    w.player.charging = false
    w.player.beamFlash = 0.0
    w.player.pods = 0
    w.player.invuln = 3.0
    w.player.respawn = 0.0
    w.score = 0
    w.mult = 1
    w.chain = 0
    w.scroll = 170.0
    w.dist = 0.0
    w.stage = 1
    w.stageLen = 5200.0
    w.bossUp = false
    w.boss = nullHandle()
    w.nextSpawn = 950.0
    w.intro = 3
    w.gaveGift = false
    w.shake = 0.0
    w.flash = 0.0
    w.slowmo = 0.0
    w.gameOver = false
    w.banner = 2.6
    w.hurt = 0.0
    w.pickupT = 0.0
    w.pickupCode = 0 - 1
    gridReset(&mut w.grid)
    terrainReset(&mut w.terrain)
}
