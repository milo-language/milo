// @run: /tmp/milo-shot-neon 1
// Absolute /tmp prefix on purpose: the example harnesses run from the repo root,
// so a bare prefix would drop .ppm frames into the working tree.
// Headless capture tool: runs the game with a scripted pilot and dumps frames as
// binary PPM. Used to check the look without a display, and as a deterministic
// smoke test for the whole simulation.
//
//   milo run examples/games/neon/shot.milo --release -- /tmp/neon 240 60 120 180

from "std/math" import {
    Math
}
from "std/args" import {
    args
}
from "./gfx" import {
    Canvas, canvasNew, present
}
from "./terrain" import {
    topAt, botAt
}
from "./world" import {
    World, worldNew, worldUpdate, spawnSnake, spawnBoss, makeEnemy, spawn, Kind,
    dropOrb, nearestEnemy, alive
}
from "./sprites" import {
    Sprites, spritesNew
}
from "./render" import {
    drawWorld, drawHud
}

pub extern fn fopen(path: *u8, mode: *u8): *u8

pub extern fn fwrite(ptr: *u8, size: i64, count: i64, stream: *u8): i64

pub extern fn fclose(stream: *u8): i32

pub let W: i64 = 1280

pub let H: i64 = 720

fn writePpm(path: &string, c: &Canvas) {
    var rgb: Vec<u8> = Vec.filled(W * H * 3, 0)
    for i in 0..W * H {
        let px = c.fb[i]
        rgb[i * 3] = (px & 0xFF) as u8
        rgb[i * 3 + 1] = ((px >> 8) & 0xFF) as u8
        rgb[i * 3 + 2] = ((px >> 16) & 0xFF) as u8
    }
    let header = "P6\n" + W.toString() + " " + H.toString() + "\n255\n"
    unsafe {
        let f = fopen(path.cstr(), "wb".cstr())
        if (f as i64) == 0 {
            print("cannot open " + path)
            return
        }
        let _ = fwrite(header.cstr(), 1, header.len, f)
        let _ = fwrite(rgb.ptr() as *u8, 1, W * H * 3, f)
        let _ = fclose(f)
    }
}

pub fn main(): i32 {
    let argv = args()
    var prefix = "/tmp/neon"
    if argv.len > 1 {
        prefix = argv[1]
    }
    var shots: Vec<i64> = Vec.new()
    for i in 2..argv.len {
        let Option.Some(frame) = argv[i].parseInt() else {
            continue
        }
        shots.push(frame)
    }
    if shots.len == 0 {
        shots.push(120)
        shots.push(300)
        shots.push(600)
    }
    var maxFrame: i64 = 0
    for i in 0..shots.len {
        maxFrame = Math.maxI64(maxFrame, shots[i])
    }

    var c = canvasNew(W, H)
    var world = worldNew(W as f64, H as f64)
    let shapes = spritesNew()

    // stack the deck so a capture shows a fully kitted ship
    for i in 0..6 {
        dropOrb(&mut world, world.player.x + 30.0, world.player.y)
        worldUpdate(&mut world, 1.0 / 60.0, 0.0, 0.0, false)
    }

    let dt = 1.0 / 60.0
    for frame in 0..maxFrame + 1 {
        if frame == 40 {
            spawnSnake(&mut world, 1200.0, 300.0, 8)
            for i in 0..6 {
                let _ = spawn(&mut world, makeEnemy(Kind.Drone, 900.0 + (i as f64) * 60.0, 160.0 + (i as f64) * 44.0))
            }
            let _ = spawn(&mut world, makeEnemy(Kind.Carrier, 1150.0, 520.0))
            let _ = spawn(&mut world, makeEnemy(Kind.Healer, 1000.0, 600.0))
        }
        if frame == 700 {
            spawnBoss(&mut world, 1000.0, 360.0)
        }

        // scripted pilot: stay centred in the cave, drift toward the nearest
        // threat, and lean on the charge every couple of seconds
        let t = (frame as f64) * dt
        let ceil = topAt(world.terrain, world.player.x)
        let floor = botAt(world.terrain, world.player.x)
        let mid = (ceil + floor) * 0.5
        var mvy = (mid - world.player.y) * 0.010 + Math.sin(t * 1.3) * 0.5
        var mvx = Math.cos(t * 0.9) * 0.4
        let h = nearestEnemy(world, world.player.x, world.player.y, 3000.0, 0 - 1)
        if alive(world, h) {
            mvy = mvy + Math.clampF64((world.ents[h.slot].y - world.player.y) * 0.01, 0.0 - 0.8, 0.8)
        }
        let charging = (frame % 150) < 90
        worldUpdate(&mut world, dt, mvx, mvy, charging)

        var want = false
        for i in 0..shots.len {
            if shots[i] == frame {
                want = true
            }
        }
        if want {
            drawWorld(&mut c, world, shapes, 0.0, 0.0)
            drawHud(&mut c, world)
            present(&mut c, 1.0, 1.0)
            writePpm(prefix + "-" + frame.toString() + ".ppm", c)
            print("wrote " + prefix + "-" + frame.toString() + ".ppm")
        }
    }
    print("entity slots used: " + world.ents.len.toString())
    print("score: " + world.score.toString())
    print("stage: " + world.stage.toString())
    return 0
}
