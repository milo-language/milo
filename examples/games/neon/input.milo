// One frame of input, snapshotted out of SDL so the rest of the game never touches
// a pointer. The bindings themselves come from the `sdl` package; what is here is
// this game's control scheme, which is not something a bindings package can hold.

from "sdl" import {
    SDL_BUTTON_LMASK
}
from "../../shared/sdlkit" import {
    pollEvents, keyboard, mouse
}
from "sdl/keys" import {
    SC_A, SC_D, SC_DOWN, SC_ESCAPE, SC_LEFT, SC_P, SC_R, SC_RETURN,
    SC_RIGHT, SC_S, SC_SPACE, SC_UP, SC_W
}

pub struct Input {
    moveX: f64,
    moveY: f64,
    mouseX: f64,
    mouseY: f64,
    fire: bool,
    charge: bool, // held: build the beam. released: fire it.
    restart: bool,
    pause: bool,
    quit: bool,
}

pub fn inputNew(): Input {
    return Input {
        moveX: 0.0, moveY: 0.0,
        mouseX: 0.0, mouseY: 0.0,
        fire: false, charge: false, restart: false, pause: false, quit: false,
    }
}

// Poll SDL and fill `inp`. `scale` converts window pixels to canvas pixels.
pub fn pollInput(inp: &mut Input, scale: f64) {
    inp.moveX = 0.0
    inp.moveY = 0.0
    inp.fire = false
    inp.charge = false
    inp.restart = false
    inp.pause = false

    if pollEvents().quit {
        inp.quit = true
    }
    let ks = keyboard()
    if ks.down(SC_ESCAPE) {
        inp.quit = true
    }
    if ks.down(SC_A) {
        inp.moveX -= 1.0
    }
    if ks.down(SC_D) {
        inp.moveX += 1.0
    }
    if ks.down(SC_W) {
        inp.moveY -= 1.0
    }
    if ks.down(SC_S) {
        inp.moveY += 1.0
    }
    // Arrows move too. There is nothing to aim: the ship shoots right.
    if ks.down(SC_LEFT) {
        inp.moveX -= 1.0
    }
    if ks.down(SC_RIGHT) {
        inp.moveX += 1.0
    }
    if ks.down(SC_UP) {
        inp.moveY -= 1.0
    }
    if ks.down(SC_DOWN) {
        inp.moveY += 1.0
    }
    if ks.down(SC_SPACE) {
        inp.charge = true
    }
    if ks.down(SC_R) {
        inp.restart = true
    }
    if ks.down(SC_P) {
        inp.pause = true
    }
    if ks.down(SC_RETURN) {
        inp.restart = true
    }
    let ms = mouse()
    let btn = ms.buttons
    inp.mouseX = (ms.x as f64) * scale
    inp.mouseY = (ms.y as f64) * scale
    if (btn & SDL_BUTTON_LMASK) != 0 {
        inp.fire = true
        inp.charge = true
    }
}
