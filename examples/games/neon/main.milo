// NEON — a horizontal shooter written in Milo.
//
// Build and play:
//   milo run examples/games/neon/main.milo --release
//
//   ARROW KEYS / WASD   fly
//   SPACE (hold)        charge; let go to fire the beam
//   ENTER               restart after a game over
//   ESC                 quit
//
// The gun fires by itself and it fires right. Pickups are glowing orbs that come
// to you and take effect on contact — there is no menu anywhere in this game.
//
// The point of this example is the code, not the score: see README.md for what
// each system is meant to prove about second-class references.

from "std/random" import {
    Random
}
from "sdl" import {
    SDL_INIT_VIDEO, SDL_WINDOW_SHOWN, SDL_RENDERER_ACCELERATED, SDL_RENDERER_PRESENTVSYNC
}
from "../../shared/sdlkit" import {
    Sdl, Window, Presenter, setCursorVisible, ticks
}
from "./input" import {
    Input, inputNew, pollInput
}
from "./gfx" import {
    Canvas, canvasNew, present, text, textCentered, textWidth
}
from "./world" import {
    World, worldNew, worldUpdate, worldReset
}
from "./sprites" import {
    Sprites, spritesNew
}
from "./render" import {
    drawWorld, drawHud
}

pub let W: i64 = 1280

pub let H: i64 = 720

pub fn main(): i32 {
    // Declared in teardown's reverse: the presenter goes first, then the window, then
    // SDL itself.
    let _sdl = match Sdl.init(SDL_INIT_VIDEO) {
        Ok(v) => v,
        Err(e) => {
            print(e)
            return 1
        }
    }
    let win = match Window.create("NEON — written in Milo", W, H, SDL_WINDOW_SHOWN) {
        Ok(v) => v,
        Err(e) => {
            print(e)
            return 2
        }
    }
    let screen = match Presenter.create(win, W, H, SDL_RENDERER_ACCELERATED | SDL_RENDERER_PRESENTVSYNC) {
        Ok(v) => v,
        Err(e) => {
            print(e)
            return 2
        }
    }
    setCursorVisible(false)

    var c = canvasNew(W, H)
    var world = worldNew(W as f64, H as f64)
    let shapes = spritesNew()
    var inp = inputNew()

    var last = ticks()
    var fpsAccum: f64 = 0.0
    var fpsFrames: i64 = 0
    var fpsShown: i64 = 0
    var titleTimer = 5.0
    var restartHeld = false

    while !inp.quit {
        let now = ticks()
        var dt = ((now - last) as f64) / 1000.0
        last = now
        if dt > 0.05 {
            dt = 0.05 // a long stall must not teleport anything through a wall
        }
        if dt < 0.0005 {
            dt = 0.0005
        }

        pollInput(&mut inp, 1.0)

        if world.gameOver && inp.restart && !restartHeld {
            worldReset(&mut world)
            titleTimer = 0.0
        }
        restartHeld = inp.restart

        worldUpdate(&mut world, dt, inp.moveX, inp.moveY, inp.charge)

        // screen shake
        var ox = 0.0
        var oy = 0.0
        if world.shake > 0.2 {
            ox = Random.floatRange(0.0 - world.shake, world.shake)
            oy = Random.floatRange(0.0 - world.shake, world.shake)
        }

        drawWorld(&mut c, world, shapes, ox, oy)
        drawHud(&mut c, world)

        fpsAccum += dt
        fpsFrames += 1
        if fpsAccum > 0.5 {
            fpsShown = ((fpsFrames as f64) / fpsAccum) as i64
            fpsAccum = 0.0
            fpsFrames = 0
        }
        text(&mut c, 24, H - 30, fpsShown.toString() + " FPS", 2, 0.18, 0.30, 0.38)
        // Control strip stays up permanently — cheap, and there is nowhere else
        // to find this out.
        let help = "ARROWS FLY    HOLD SPACE TO CHARGE    ORBS ARE GOOD    ESC QUIT"
        text(&mut c, W - 24 - textWidth(help, 2), H - 30, help, 2, 0.18, 0.30, 0.38)

        if titleTimer > 0.0 {
            titleTimer -= dt
            var f = 1.0
            if titleTimer < 1.0 {
                f = titleTimer
            }
            textCentered(&mut c, W / 2, 150, "NEON", 12, 0.6 * f, 1.4 * f, 2.0 * f)
            textCentered(&mut c, W / 2, 250, "WRITTEN IN MILO", 3, 1.4 * f, 1.0 * f, 0.4 * f)
        }

        var exposure = 1.0
        if world.flash > 0.0 {
            exposure = 1.0 + world.flash * 2.2
        }
        present(&mut c, 1.0, exposure)

        screen.present(c.fb)
    }

    return 0
}
