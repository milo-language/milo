// NEON — a horizontal shooter written in Milo.
//
// Build and play:
//   milo run examples/games/neon/main.milo --release
//
//   ARROW KEYS / WASD   fly
//   SPACE (hold)        charge; let go to fire the beam
//   ENTER               restart after a game over
//   ESC                 quit
//
// The gun fires by itself and it fires right. Pickups are glowing orbs that come
// to you and take effect on contact — there is no menu anywhere in this game.
//
// The point of this example is the code, not the score: see README.md for what
// each system is meant to prove about second-class references.

from "std/random" import {
    Random
}
from "sdl" import {
    SDL_Init, SDL_CreateWindow, SDL_CreateRenderer, SDL_CreateTexture,
    SDL_UpdateTexture, SDL_RenderClear, SDL_RenderCopy, SDL_RenderPresent,
    SDL_ShowCursor, SDL_GetTicks, SDL_DestroyWindow, SDL_Quit,
    SDL_INIT_VIDEO, SDL_WINDOWPOS_CENTERED, SDL_WINDOW_SHOWN,
    SDL_TEXTUREACCESS_STREAMING, SDL_PIXELFORMAT_ABGR8888,
    SDL_RENDERER_ACCELERATED, SDL_RENDERER_PRESENTVSYNC,
}
from "./input" import {
    Input, inputNew, pollInput
}
from "./gfx" import {
    Canvas, canvasNew, present, text, textCentered, textWidth
}
from "./world" import {
    World, worldNew, worldUpdate, worldReset
}
from "./sprites" import {
    Sprites, spritesNew
}
from "./render" import {
    drawWorld, drawHud
}

pub let W: i64 = 1280

pub let H: i64 = 720

pub fn main(): i32 {
    if SDL_Init(SDL_INIT_VIDEO) != 0 {
        print("SDL_Init failed")
        return 1
    }
    var win: *u8 = 0 as *u8
    var ren: *u8 = 0 as *u8
    var tex: *u8 = 0 as *u8
    var ok = true
    unsafe {
        let title = "NEON — written in Milo"
        win = SDL_CreateWindow(title, SDL_WINDOWPOS_CENTERED, SDL_WINDOWPOS_CENTERED, W as i32, H as i32, SDL_WINDOW_SHOWN)
        ren = SDL_CreateRenderer(win, 0 - 1, SDL_RENDERER_ACCELERATED | SDL_RENDERER_PRESENTVSYNC)
        tex = SDL_CreateTexture(ren, SDL_PIXELFORMAT_ABGR8888, SDL_TEXTUREACCESS_STREAMING, W as i32, H as i32)
        if (win as i64) == 0 || (ren as i64) == 0 || (tex as i64) == 0 {
            ok = false
        }
        let _ = SDL_ShowCursor(0)
    }
    if !ok {
        print("SDL setup failed")
        return 2
    }

    var c = canvasNew(W, H)
    var world = worldNew(W as f64, H as f64)
    let shapes = spritesNew()
    var inp = inputNew()
    var ev: [u8; 64] = [0; 64]

    var last = SDL_GetTicks()
    var fpsAccum: f64 = 0.0
    var fpsFrames: i64 = 0
    var fpsShown: i64 = 0
    var titleTimer = 5.0
    var restartHeld = false

    while !inp.quit {
        let now = SDL_GetTicks()
        var dt = ((now - last) as f64) / 1000.0
        last = now
        if dt > 0.05 {
            dt = 0.05 // a long stall must not teleport anything through a wall
        }
        if dt < 0.0005 {
            dt = 0.0005
        }

        pollInput(&mut inp, &mut ev, 1.0)

        if world.gameOver && inp.restart && !restartHeld {
            worldReset(&mut world)
            titleTimer = 0.0
        }
        restartHeld = inp.restart

        worldUpdate(&mut world, dt, inp.moveX, inp.moveY, inp.charge)

        // screen shake
        var ox = 0.0
        var oy = 0.0
        if world.shake > 0.2 {
            ox = Random.floatRange(0.0 - world.shake, world.shake)
            oy = Random.floatRange(0.0 - world.shake, world.shake)
        }

        drawWorld(&mut c, world, shapes, ox, oy)
        drawHud(&mut c, world)

        fpsAccum += dt
        fpsFrames += 1
        if fpsAccum > 0.5 {
            fpsShown = ((fpsFrames as f64) / fpsAccum) as i64
            fpsAccum = 0.0
            fpsFrames = 0
        }
        text(&mut c, 24, H - 30, fpsShown.toString() + " FPS", 2, 0.18, 0.30, 0.38)
        // Control strip stays up permanently — cheap, and there is nowhere else
        // to find this out.
        let help = "ARROWS FLY    HOLD SPACE TO CHARGE    ORBS ARE GOOD    ESC QUIT"
        text(&mut c, W - 24 - textWidth(help, 2), H - 30, help, 2, 0.18, 0.30, 0.38)

        if titleTimer > 0.0 {
            titleTimer -= dt
            var f = 1.0
            if titleTimer < 1.0 {
                f = titleTimer
            }
            textCentered(&mut c, W / 2, 150, "NEON", 12, 0.6 * f, 1.4 * f, 2.0 * f)
            textCentered(&mut c, W / 2, 250, "WRITTEN IN MILO", 3, 1.4 * f, 1.0 * f, 0.4 * f)
        }

        var exposure = 1.0
        if world.flash > 0.0 {
            exposure = 1.0 + world.flash * 2.2
        }
        present(&mut c, 1.0, exposure)

        unsafe {
            SDL_UpdateTexture(tex, 0 as *u8, c.fb[0].addrOf() as *u8, (W * 4) as i32)
            SDL_RenderClear(ren)
            SDL_RenderCopy(ren, tex, 0 as *u8, 0 as *u8)
            SDL_RenderPresent(ren)
        }
    }

    SDL_DestroyWindow(win)
    SDL_Quit()
    return 0
}
