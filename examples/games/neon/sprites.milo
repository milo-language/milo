// Every sprite in the game, built at startup. There is no asset directory and no
// loader: the art is pixel art written as strings, and the pickups are generated
// from their own geometry.
//
// A palette entry is three floats of linear light, and values run past 1.0 on
// purpose — an eye at 2.6 clears the bloom threshold and glows, the carapace at
// 0.3 beside it does not. That contrast is the whole look, and it is why the art
// is authored in linear light rather than in 8-bit colour.
//
// The bestiary is biomechanical: bone-ivory plating over fleshy dark bodies, gold
// ornament on the things that outrank you, and a wet red eye on everything that
// wants you dead. The ship is the one clean machine on screen.

from "std/math" import {
    Math
}
from "./gfx" import {
    Sprite, spriteNew, spriteSet
}

// ── string art ────────────────────────────────────────────────────────────────
//
// One character per pixel: '.' is transparent, '0'-'9' index the palette. Rows
// need not be padded — anything short is transparent to the right — so a frame
// only spells out the pixels it actually uses.

fn palAdd(p: &mut Vec<f64>, r: f64, g: f64, b: f64) {
    p.push(r)
    p.push(g)
    p.push(b)
}

fn charAt(rows: &Vec<string>, r: i64, c: i64): i64 {
    if c >= rows[r].len {
        return 46 // '.'
    }
    return rows[r][c] as i64
}

fn widest(rows: &Vec<string>): i64 {
    var w = 0
    for r in rows {
        if r.len > w {
            w = r.len
        }
    }
    return w
}

fn spriteFrom(rows: &Vec<string>, pal: &Vec<f64>): Sprite {
    let w = widest(rows)
    let h = rows.len
    var s = spriteNew(w, h)
    for y in 0..h {
        for x in 0..w {
            let ch = charAt(rows, y, x)
            if ch >= 48 && ch <= 57 {
                let i = (ch - 48) * 3
                if i + 2 < pal.len {
                    spriteSet(&mut s, x, y, pal[i], pal[i + 1], pal[i + 2], 1.0)
                }
            }
        }
    }
    return s
}

// ── the ship ──────────────────────────────────────────────────────────────────

// Deliberately not organic: white composite, gold trim, a teal canopy. It is the
// only manufactured thing in the level and it should look like it does not
// belong here.
pub fn shipSprite(): Sprite {
    var pal: Vec<f64> = Vec.new()
    palAdd(&mut pal, 0.03, 0.03, 0.05) // 0 outline
    palAdd(&mut pal, 0.22, 0.24, 0.30) // 1 hull shadow
    palAdd(&mut pal, 0.52, 0.55, 0.62) // 2 hull mid
    palAdd(&mut pal, 0.88, 0.91, 0.98) // 3 hull light
    palAdd(&mut pal, 1.35, 1.38, 1.48) // 4 hull white
    palAdd(&mut pal, 0.16, 0.14, 0.42) // 5 capsule shadow
    palAdd(&mut pal, 0.38, 0.34, 0.95) // 6 capsule body
    palAdd(&mut pal, 0.80, 0.76, 1.60) // 7 capsule light
    palAdd(&mut pal, 0.28, 1.80, 2.30) // 8 canopy
    palAdd(&mut pal, 2.30, 1.10, 0.28) // 9 engine / trim
    // The R-9 silhouette is one big smooth coloured capsule slung under a grey
    // mechanical hull, with a swept fin and a gun barrel out front. The capsule
    // is the thing that reads at 40 pixels — it is the only large smooth mass on
    // a ship that is otherwise all greebles.
    var rows: Vec<string> = Vec.new()
    rows.push(".......04440")
    rows.push("......0433340")
    rows.push(".....04333330")
    rows.push("....043333330")
    rows.push("...0433333330")
    rows.push("..04333333330000")
    rows.push("..0333333333333330000")
    rows.push("9.03333222222222333330000")
    rows.push("90233332888822222222333333000")
    rows.push("902333328888222222222222233334440")
    rows.push("9023333288882222222222222222334444440")
    rows.push("90233332222222222222222222222233444440")
    rows.push("902333222222222222222222222333333000")
    rows.push("90033322222222222222222233330000")
    rows.push("055666666666666666666666663330")
    rows.push("05666777777777777777777766330")
    rows.push("05667777777777777777777776630")
    rows.push("05666777777777777777777766330")
    rows.push("055666666666666666666666663330")
    rows.push(".00333222222222222222233000")
    rows.push("...0332222222222223300")
    rows.push("....03222222222330")
    rows.push(".....099999900")
    return spriteFrom(rows, pal)
}

// ── shots ─────────────────────────────────────────────────────────────────────
//
// Every projectile is a sprite rather than a glow, because a glow lives in the
// same visual channel as the bloom coming off the scenery and you cannot tell
// them apart. A sprite has a dark rim, occludes what is behind it, and reads as
// an object at a glance.

// Yours: a flat lance of light, wider than it is tall, so a wall of them still
// reads as horizontal motion.
pub fn shotSprite(): Sprite {
    var pal: Vec<f64> = Vec.new()
    palAdd(&mut pal, 0.05, 0.04, 0.02) // 0 rim
    palAdd(&mut pal, 1.30, 0.95, 0.20) // 1 body
    palAdd(&mut pal, 2.60, 2.20, 0.90) // 2 core
    var rows: Vec<string> = Vec.new()
    rows.push("..000000000")
    rows.push(".011111111 0")
    rows.push("01222222211")
    rows.push(".011111111 0")
    rows.push("..000000000")
    return spriteFrom(rows, pal)
}

// The pods': same shape, different colour, so two friendly weapons never have to
// be told apart under pressure.
pub fn podShotSprite(): Sprite {
    var pal: Vec<f64> = Vec.new()
    palAdd(&mut pal, 0.05, 0.02, 0.05) // 0 rim
    palAdd(&mut pal, 1.30, 0.30, 1.20) // 1 body
    palAdd(&mut pal, 2.40, 1.40, 2.40) // 2 core
    var rows: Vec<string> = Vec.new()
    rows.push(".0000000")
    rows.push("01111110")
    rows.push("01222110")
    rows.push("01111110")
    rows.push(".0000000")
    return spriteFrom(rows, pal)
}

// Theirs: a round, hard-edged bead with a black rim and a white-hot centre. Round
// versus flat is the read — you never have to resolve the colour.
pub fn hostileShotSprite(): Sprite {
    var pal: Vec<f64> = Vec.new()
    palAdd(&mut pal, 0.02, 0.01, 0.01) // 0 rim
    palAdd(&mut pal, 0.70, 0.05, 0.06) // 1 shell
    palAdd(&mut pal, 2.20, 0.18, 0.12) // 2 body
    palAdd(&mut pal, 2.90, 1.60, 1.30) // 3 core
    var rows: Vec<string> = Vec.new()
    rows.push("..00000")
    rows.push(".0011100")
    rows.push("001223100")
    rows.push("012233210")
    rows.push("012333210")
    rows.push("012233210")
    rows.push("001223100")
    rows.push(".0011100")
    rows.push("..00000")
    return spriteFrom(rows, pal)
}

// A missile is a machine, so it gets a body, a nose and fins.
pub fn missileSprite(): Sprite {
    var pal: Vec<f64> = Vec.new()
    palAdd(&mut pal, 0.04, 0.03, 0.02) // 0 outline
    palAdd(&mut pal, 0.35, 0.32, 0.28) // 1 casing dark
    palAdd(&mut pal, 0.85, 0.80, 0.70) // 2 casing
    palAdd(&mut pal, 1.40, 1.34, 1.18) // 3 casing light
    palAdd(&mut pal, 2.60, 1.20, 0.20) // 4 warhead
    palAdd(&mut pal, 2.80, 1.90, 0.60) // 5 flame
    var rows: Vec<string> = Vec.new()
    rows.push("...0110")
    rows.push("50112223300")
    rows.push("501223333444440")
    rows.push("50112223300")
    rows.push("...0110")
    return spriteFrom(rows, pal)
}

// The Force: a captured piece of the enemy, welded into a shell that obeys you.
pub fn podSprite(): Sprite {
    var pal: Vec<f64> = Vec.new()
    palAdd(&mut pal, 0.06, 0.04, 0.03) // 0 outline
    palAdd(&mut pal, 0.45, 0.18, 0.03) // 1 dark
    palAdd(&mut pal, 1.20, 0.50, 0.06) // 2 orange
    palAdd(&mut pal, 2.20, 1.00, 0.15) // 3 hot
    palAdd(&mut pal, 2.90, 2.40, 1.30) // 4 core
    palAdd(&mut pal, 1.55, 1.10, 0.30) // 5 gold nub
    var rows: Vec<string> = Vec.new()
    rows.push(".....0000")
    rows.push("...00122100")
    rows.push("..0122333210")
    rows.push(".01233443321")
    rows.push("5012334444321")
    rows.push("5012344444432")
    rows.push("50123444444325")
    rows.push("50123444444325")
    rows.push("5012344444432")
    rows.push("5012334444321")
    rows.push(".01233443321")
    rows.push("..0122333210")
    rows.push("...00122100")
    rows.push(".....0000")
    return spriteFrom(rows, pal)
}

// ── the bestiary ──────────────────────────────────────────────────────────────

// Shared flesh-and-bone palette. Every grunt is the same organism at a different
// size, which is the point of a hive.
fn bioPal(): Vec<f64> {
    var pal: Vec<f64> = Vec.new()
    palAdd(&mut pal, 0.04, 0.03, 0.04) // 0 outline
    palAdd(&mut pal, 0.20, 0.08, 0.09) // 1 shell rim
    palAdd(&mut pal, 0.38, 0.14, 0.16) // 2 shell dark
    palAdd(&mut pal, 0.68, 0.27, 0.28) // 3 shell mid
    palAdd(&mut pal, 1.00, 0.47, 0.44) // 4 shell lit
    palAdd(&mut pal, 0.88, 0.83, 0.68) // 5 bone
    palAdd(&mut pal, 0.40, 0.37, 0.30) // 6 bone dark
    palAdd(&mut pal, 2.60, 0.25, 0.15) // 7 eye
    palAdd(&mut pal, 0.55, 0.07, 0.06) // 8 eye socket
    palAdd(&mut pal, 1.35, 1.30, 1.15) // 9 bone white
    return pal
}

// The grunt: two bone mandibles out front, a wet eye between them, ribbed shell
// behind. The mandibles are the whole point — they give it a facing.
pub fn droneSprite(): Sprite {
    var rows: Vec<string> = Vec.new()
    rows.push("....00.....0333330")
    rows.push("...0590...033222330")
    rows.push("..05590..03322222330")
    rows.push(".05590..0332255223330")
    rows.push("0559.0.03322555222330")
    rows.push("0870..033225555222233")
    rows.push("0870..033225555222233")
    rows.push("0559.0.03322555222330")
    rows.push(".05590..0332255223330")
    rows.push("..05590..03322222330")
    rows.push("...0590...033222330")
    rows.push("....00.....0333330")
    return spriteFrom(rows, bioPal())
}

