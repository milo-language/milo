// ── pickups ───────────────────────────────────────────────────────────────────
//
// Generated rather than drawn: a capsule in the pickup's own colour with a mark
// stamped into it, so a new pickup type is a switch arm and not a new grid of
// characters. The mark is what you read at a glance; the colour is what you read
// out of the corner of your eye.

fn markPixel(kind: i64, x: i64, y: i64): bool {
    // Coordinates are relative to a 16x16 capsule, mark area x 4..11, y 4..11.
    if kind == 0 {
        // POWER: a fat upward bolt
        return (y >= 4 && y <= 7 && x >= 7 && x <= 9) || (y >= 8 && y <= 11 && x >= 6 && x <= 8)
    }
    if kind == 1 {
        // POD: a ring
        let dx = x - 7
        let dy = y - 7
        let d2 = dx * dx + dy * dy
        return d2 <= 12 && d2 >= 3
    }
    if kind == 2 {
        // MISSILE: an arrowhead pointing right
        return x >= 4 && x <= 11 && Math.absI64(y - 7) <= (11 - x) / 2 && Math.absI64(y - 7) <= 3
    }
    if kind == 3 {
        // SHIELD: a closed arc
        let dx = x - 7
        let dy = y - 7
        let d2 = dx * dx + dy * dy
        return (d2 <= 16 && d2 >= 8) || (y == 11 && x >= 4 && x <= 10)
    }
    // SPEED: two chevrons
    return Math.absI64(Math.absI64(y - 7) - (x - 3)) <= 1 && x >= 4 && x <= 7 || Math.absI64(Math.absI64(y - 7) - (x - 7)) <= 1 && x >= 8 && x <= 11
}

pub fn orbSprite(kind: i64, r: f64, g: f64, b: f64): Sprite {
    let n = 16
    var s = spriteNew(n, n)
    let c = 7.5
    for y in 0..n {
        for x in 0..n {
            let dx = (x as f64) + 0.5 - c
            let dy = (y as f64) + 0.5 - c
            let d = Math.sqrt(dx * dx + dy * dy)
            if d > 7.6 {
                continue
            }
            if d > 6.4 {
                // dark rim, so the capsule keeps an edge against a bright wall
                spriteSet(&mut s, x, y, r * 0.10, g * 0.10, b * 0.10, 1.0)
            } else if d > 5.2 {
                spriteSet(&mut s, x, y, r * 1.30, g * 1.30, b * 1.30, 1.0)
            } else if markPixel(kind, x, y) {
                spriteSet(&mut s, x, y, 2.60, 2.55, 2.40, 1.0)
            } else {
                // body, brighter toward the top-left so it reads as a solid
                let f = 0.55 + 0.35 * (1.0 - d / 5.2) - dy * 0.04
                spriteSet(&mut s, x, y, r * f, g * f, b * f, 1.0)
            }
        }
    }
    return s
}

// ── the table ─────────────────────────────────────────────────────────────────

pub struct Sprites {
    ship: Sprite,
    pod: Sprite,
    drone: Sprite,
    weaver: Sprite,
    swooper: Sprite,
    carrier: Sprite,
    mine: Sprite,
    turret: Sprite,
    snakeHead: Sprite,
    snakeSeg: Sprite,
    healer: Sprite,
    core: Sprite,
    plate: Sprite,
    orbs: Vec<Sprite>,
    shot: Sprite,
    podShot: Sprite,
    hostileShot: Sprite,
    missile: Sprite,
}

pub fn spritesNew(): Sprites {
    var orbs: Vec<Sprite> = Vec.new()
    orbs.push(orbSprite(0, 0.20, 1.30, 1.80)) // POWER   — cyan
    orbs.push(orbSprite(1, 1.70, 0.30, 1.40)) // POD     — magenta
    orbs.push(orbSprite(2, 1.80, 0.90, 0.15)) // MISSILE — amber
    orbs.push(orbSprite(3, 0.25, 1.70, 0.70)) // SHIELD  — green
    orbs.push(orbSprite(4, 1.50, 1.50, 1.70)) // SPEED   — white
    return Sprites {
        ship: shipSprite(),
        pod: podSprite(),
        drone: droneSprite(),
        weaver: weaverSprite(),
        swooper: swooperSprite(),
        carrier: carrierSprite(),
        mine: mineSprite(),
        turret: turretSprite(),
        snakeHead: snakeHeadSprite(),
        snakeSeg: snakeSegSprite(),
        healer: healerSprite(),
        core: coreSprite(),
        plate: plateSprite(),
        orbs: orbs,
        shot: shotSprite(),
        podShot: podShotSprite(),
        hostileShot: hostileShotSprite(),
        missile: missileSprite(),
    }
}
