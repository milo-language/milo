    rows.push("940122334455667766554433221100")
    rows.push("94012233445677776654433221100")
    rows.push("9401223344567777665443322110")
    rows.push("940122334455667766554433221100")
    rows.push("4011223344556666554433221100")
    rows.push("40112233445555555544332211")
    rows.push("..0112233444555554443322110")
    rows.push("...011223334555553334221100")
