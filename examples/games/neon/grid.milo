// The warping background lattice.
//
// A mass-spring grid: every node is tied to its rest position by a soft spring
// and to its four neighbours by stiffer ones. Explosions, black holes, bullets
// and the player's wake all push on it, and the ripples travel through the
// springs. It is the piece of state every other system in the game writes to.

from "std/math" import {
    Math
}
from "./gfx" import {
    Canvas, line
}

pub struct Node {
    x: f64,
    y: f64,
    vx: f64,
    vy: f64,
    ax: f64, // anchor (rest) position
    ay: f64,
    invMass: f64, // 0 pins the node — the border is pinned so the sheet has edges
}

pub struct Grid {
    nodes: Vec<Node>,
    cols: i64,
    rows: i64,
    spacing: f64,
}

pub fn gridNew(w: f64, h: f64, spacing: f64): Grid {
    let cols = (w / spacing) as i64 + 1
    let rows = (h / spacing) as i64 + 1
    var nodes: Vec<Node> = Vec.new()
    for r in 0..rows {
        for c in 0..cols {
            let x = (c as f64) * spacing
            let y = (r as f64) * spacing
            var im = 1.0
            if c == 0 || r == 0 || c == cols - 1 || r == rows - 1 {
                im = 0.0
            }
            nodes.push(Node {
                x: x, y: y, vx: 0.0, vy: 0.0, ax: x, ay: y, invMass: im
            }
            )
        }
    }
    return Grid {
        nodes: nodes, cols: cols, rows: rows, spacing: spacing
    }
}

pub fn gridReset(g: &mut Grid) {
    for i in 0..g.nodes.len {
        g.nodes[i].x = g.nodes[i].ax
        g.nodes[i].y = g.nodes[i].ay
        g.nodes[i].vx = 0.0
        g.nodes[i].vy = 0.0
    }
}

// One neighbour spring, applying equal and opposite impulses to two nodes of the
// same Vec. Indices, not two `&mut` into one container — which is exactly how a
// second-class-reference language wants you to write it.
fn springPair(g: &mut Grid, a: i64, b: i64, rest: f64, k: f64, dt: f64) {
    let dx = g.nodes[b].x - g.nodes[a].x
    let dy = g.nodes[b].y - g.nodes[a].y
    let d2 = dx * dx + dy * dy
    if d2 < 0.0001 {
        return
    }
    let d = Math.sqrt(d2)
    let f = (d - rest) * k * dt / d
    let ima = g.nodes[a].invMass
    let imb = g.nodes[b].invMass
    g.nodes[a].vx = g.nodes[a].vx + dx * f * ima
    g.nodes[a].vy = g.nodes[a].vy + dy * f * ima
    g.nodes[b].vx = g.nodes[b].vx - dx * f * imb
    g.nodes[b].vy = g.nodes[b].vy - dy * f * imb
}

pub fn gridUpdate(g: &mut Grid, dt: f64) {
    let k = 300.0 // neighbour stiffness
    let anchorK = 9.0 // pull back to rest
    let damp = 0.965
    let rest = g.spacing
    let cols = g.cols
    let rows = g.rows

    for r in 0..rows {
        for c in 0..cols {
            let i = r * cols + c
            if c + 1 < cols {
                springPair(&mut g, i, i + 1, rest, k, dt)
            }
            if r + 1 < rows {
                springPair(&mut g, i, i + cols, rest, k, dt)
            }
        }
    }

    // Explicit Euler on a stiff spring sheet is only conditionally stable, and
    // this sheet is driven by every bullet, every explosion and every black-hole
    // pull in the game. Given enough simultaneous impulses it runs away, the
    // positions reach infinity, and the renderer then casts a non-finite float
    // to i64 — which the overflow check turns into an abort mid-game.
    //
    // Rather than tune the energy budget and hope, the sheet is made
    // unconditionally bounded: a node may not outrun `vlim`, may not stray more
    // than `lim` from its anchor, and anything that has already gone non-finite
    // is reset. A cloth that cannot stretch past two and a half cells is also
    // what it should look like.
    let lim = g.spacing * 2.5
    let vlim = 4000.0
    for i in 0..g.nodes.len {
        if g.nodes[i].invMass > 0.0 {
            let dx = g.nodes[i].ax - g.nodes[i].x
            let dy = g.nodes[i].ay - g.nodes[i].y
            var vx = (g.nodes[i].vx + dx * anchorK * dt) * damp
            var vy = (g.nodes[i].vy + dy * anchorK * dt) * damp
            // NaN fails every comparison, so this catches it as well as infinity
            if !(vx > 0.0 - vlim && vx < vlim) {
                vx = Math.clampF64(vx, 0.0 - vlim, vlim)
                if vx != vx {
                    vx = 0.0
                }
            }
            if !(vy > 0.0 - vlim && vy < vlim) {
                vy = Math.clampF64(vy, 0.0 - vlim, vlim)
                if vy != vy {
                    vy = 0.0
                }
            }
            var nx = g.nodes[i].x + vx * dt
            var ny = g.nodes[i].y + vy * dt
            if nx != nx {
                nx = g.nodes[i].ax
                vx = 0.0
            }
            if ny != ny {
                ny = g.nodes[i].ay
                vy = 0.0
            }
            g.nodes[i].vx = vx
            g.nodes[i].vy = vy
            g.nodes[i].x = Math.clampF64(nx, g.nodes[i].ax - lim, g.nodes[i].ax + lim)
            g.nodes[i].y = Math.clampF64(ny, g.nodes[i].ay - lim, g.nodes[i].ay + lim)
        }
    }
}

// Radial impulse — positive `strength` shoves outward, negative sucks inward.
pub fn gridImpulse(g: &mut Grid, cx: f64, cy: f64, radius: f64, strength: f64) {
    let r2 = radius * radius
    for i in 0..g.nodes.len {
        if g.nodes[i].invMass > 0.0 {
            let dx = g.nodes[i].x - cx
            let dy = g.nodes[i].y - cy
            let d2 = dx * dx + dy * dy
            if d2 < r2 && d2 > 0.01 {
                let d = Math.sqrt(d2)
                let fall = 1.0 - d / radius
                let f = strength * fall * fall / d
                g.nodes[i].vx = g.nodes[i].vx + dx * f
                g.nodes[i].vy = g.nodes[i].vy + dy * f
            }
        }
    }
}

// Continuous inward pull with a swirl component — black holes drag the sheet
// into a visible vortex.
pub fn gridVortex(g: &mut Grid, cx: f64, cy: f64, radius: f64, pull: f64, swirl: f64, dt: f64) {
    let r2 = radius * radius
    for i in 0..g.nodes.len {
        if g.nodes[i].invMass > 0.0 {
            let dx = g.nodes[i].x - cx
            let dy = g.nodes[i].y - cy
            let d2 = dx * dx + dy * dy
            if d2 < r2 && d2 > 4.0 {
                let d = Math.sqrt(d2)
                let fall = 1.0 - d / radius
                let f = pull * fall * dt / d
                let sw = swirl * fall * dt / d
                g.nodes[i].vx = g.nodes[i].vx - dx * f - dy * sw
                g.nodes[i].vy = g.nodes[i].vy - dy * f + dx * sw
            }
        }
    }
}

// Shockwave-only draw: a spring is invisible until something disturbs it, so a
// quiet screen shows nothing at all and an explosion shows the ripple travelling
// out through the sheet. Drawing the whole lattice all the time — which is what
// this used to do — turned the background into a permanent blue graph.
pub fn gridDrawShock(c: &mut Canvas, g: &Grid, r: f64, gg: f64, b: f64) {
    let cols = g.cols
    let rows = g.rows
    let cut = 1.6 // px of stretch below which a spring is not worth drawing
    for row in 0..rows {
        for col in 0..cols {
            let i = row * cols + col
            if col + 1 < cols {
                let j = i + 1
                let dx = g.nodes[j].x - g.nodes[i].x
                let dy = g.nodes[j].y - g.nodes[i].y
                let t = Math.abs(Math.sqrt(dx * dx + dy * dy) - g.spacing)
                if t > cut {
                    let m = Math.minF64((t - cut) * 0.30, 2.4)
                    line(&mut c, g.nodes[i].x, g.nodes[i].y, g.nodes[j].x, g.nodes[j].y, r * m, gg * m, b * m)
                }
            }
            if row + 1 < rows {
                let j = i + cols
                let dx = g.nodes[j].x - g.nodes[i].x
                let dy = g.nodes[j].y - g.nodes[i].y
                let t = Math.abs(Math.sqrt(dx * dx + dy * dy) - g.spacing)
                if t > cut {
                    let m = Math.minF64((t - cut) * 0.30, 2.4)
                    line(&mut c, g.nodes[i].x, g.nodes[i].y, g.nodes[j].x, g.nodes[j].y, r * m, gg * m, b * m)
                }
            }
        }
    }
}
