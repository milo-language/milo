// @run:
// Dependency graph with topological sort, the classic arena use case. Nodes name
// each other by Handle, not by pointer or stored &T; the graph owns the arena and
// every walk goes through it. A node also carries its own position in `nodes`, so
// Kahn's algorithm indexes its in-degree table by that instead of searching handles.
from "std/arena" import { Arena, Handle }

pub struct Node {
    id: i64,
    name: string,
    deps: Vec<Handle<Node>>,
    dependents: Vec<Handle<Node>>,
}

pub struct DepGraph {
    arena: Arena<Node>,
    nodes: Vec<Handle<Node>>,
}

pub fn newGraph(): DepGraph {
    return DepGraph { arena: Arena<Node>.new(), nodes: Vec.new() }
}

pub fn addNode(g: &mut DepGraph, name: string): Handle<Node> {
    let h = g.arena.alloc(Node { id: g.nodes.len, name: name, deps: Vec.new(), dependents: Vec.new() })
    g.nodes.push(h)
    return h
}

pub fn addEdge(g: &mut DepGraph, src: Handle<Node>, dst: Handle<Node>) {
    let _ = g.arena.modifyMut(src, (n: &mut Node) => { n.deps.push(dst) })
    let _ = g.arena.modifyMut(dst, (n: &mut Node) => { n.dependents.push(src) })
}

// Reads the name by borrow: `with` hands the closure a `&Node` and returns only
// what it computes, so the node's two Vecs are never copied.
pub fn nodeName(g: &DepGraph, h: Handle<Node>): string {
    return g.arena.with(h, (n: &Node): string => n.name.clone()) ?? "<invalid>"
}

// Kahn's algorithm
pub fn topoSort(g: &DepGraph): Vec<string> {
    var order: Vec<string> = Vec.new()
    let n = g.nodes.len

    var inDeg: Vec<i64> = Vec.new()
    for h in g.nodes {
        inDeg.push(g.arena.with(h, (node: &Node): i64 => node.deps.len) ?? 0)
    }

    var queue: Vec<i64> = Vec.new()
    for i, d in inDeg {
        if d == 0 { queue.push(i) }
    }

    var qi: i64 = 0
    while qi < queue.len {
        let h = g.nodes[queue[qi]]
        order.push(nodeName(g, h))
        let dependents = g.arena.with(h, (node: &Node): Vec<Handle<Node>> => node.dependents.clone()) ?? []
        for dh in dependents {
            let Some(j) = g.arena.with(dh, (d: &Node): i64 => d.id) else { continue }
            inDeg[j] -= 1
            if inDeg[j] == 0 { queue.push(j) }
        }
        qi += 1
    }

    if order.len != n {
        print("error: cycle detected!")
    }
    return order
}

pub fn main(): i32 {
    var g = newGraph()

    let libc = addNode(&mut g, "libc")
    let net = addNode(&mut g, "net")
    let json = addNode(&mut g, "json")
    let http = addNode(&mut g, "http")
    let db = addNode(&mut g, "db")
    let app = addNode(&mut g, "app")

    addEdge(&mut g, net, libc)
    addEdge(&mut g, json, libc)
    addEdge(&mut g, http, net)
    addEdge(&mut g, http, json)
    addEdge(&mut g, db, net)
    addEdge(&mut g, app, http)
    addEdge(&mut g, app, db)

    print("build order:")
    for item in topoSort(g) {
        print("  ", item)
    }

    return 0
}
