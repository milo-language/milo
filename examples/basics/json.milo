// @run:
// JSON in Milo: derive a codec for a struct, build ad-hoc shapes, read untyped documents
from "std/json" import {
    Json
}

@derive(Json)
pub struct User {
    name: string,
    age: i64,
    active: bool,
    email: string?, // None encodes as null
}

fn describe(text: &string): string {
    let Ok(u) = User.fromJson(text) else { return "not a user" }
    return $"{u.name} is {u.age}"
}

pub fn main(): i32 {
    // 1. A struct to JSON and back
    let alice = User { name: "Alice", age: 30, active: true, email: None }
    let text = alice.toJson()
    print(text)
    print(describe(text))

    // 2. A shape with no struct: the builder escapes every value
    let bob = User { name: "Bob \"the builder\"", age: 25, active: false, email: Some("bob@example.com") }
    let page = Json.obj()
        .int("count", 2)
        .arr("users", Json.arr().raw(alice.toJson()).raw(bob.toJson()))
        .build()
    print(page)

    // 3. Untyped reads: index, then a typed read; a missing step reads as None
    let doc = Json.parse(page)!
    print(doc["users"][1]["name"].str() ?? "?")
    print(doc["users"][5]["name"].str() ?? "no such user")

    // 4. Errors name the field that was wrong
    match User.fromJson("{\"name\":\"x\",\"age\":\"old\",\"active\":true,\"email\":null}") {
        Ok(_) => print("unexpected")
        Err(e) => print($"decode error: {e.message()}")
    }
    if let Err(e) = Json.parse("not json") {
        print($"parse error: {e}")
    }
    return 0
}
