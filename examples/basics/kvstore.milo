// @run:
// kvstore — a mini page-based key-value store, the last of the five rewrite
// probes (sled-lite / buffer-pool pattern). Stresses the iterator/cursor story:
// in Rust a scan returns Iterator<Item = (&K, &V)> borrowing the pages; Milo's
// no-stored-refs model forbids a cursor that *holds* a borrow of the store, so
// the cursor is a plain position value and every step passes the store
// explicitly: `scanNext(&store, &mut cursor)`. Values are copied out (clone on
// read), never borrowed out. See docs/rewrite-findings-html5ever.md.
//
// Layout: fixed-capacity sorted pages in a Vec (a toy B-tree leaf level).
// put: binary-search page, insert sorted, split when full.
// get: binary-search page then key. scan: cursor walks (page, slot) pairs.
//
// The contracts are the page math a reader would otherwise have to check by hand:
// `pageFor` always names a live page, `put` grows the store by at most one key, and
// the split loop never drains a page below the half it keeps. A debug build asserts
// them at runtime; `milo prove` reports them unknown, not refuted, because its SMT
// translation has no model for Vec length or indexing.

pub let PAGE_CAP: i64 = 4

pub struct Entry {
    key: string,
    value: string,
}

pub struct Page {
    entries: Vec<Entry>,
}

pub struct Store {
    pages: Vec<Page>,
    count: i64,
}

pub fn storeNew(): Store {
    var pages: Vec<Page> = Vec.new()
    pages.push(Page { entries: Vec.new() })
    return Store { pages: pages, count: 0 }
}

// Index of the page whose key range should contain `key`: the last page whose
// first key is <= key (or page 0).
pub fn pageFor(s: &Store, key: &string): i64
requires s.pages.len() > 0
ensures result >= 0 && result < s.pages.len()
{
    var lo: i64 = 0
    for i, page in s.pages {
        if page.entries.len() > 0 && page.entries[0].key <= key { lo = i }
    }
    return lo
}

// Slot of `key` in page `p`, if present.
pub fn slotIn(s: &Store, p: i64, key: &string): Option<i64>
requires p >= 0 && p < s.pages.len()
{
    for i, e in s.pages[p].entries {
        if e.key == key { return Some(i) }
    }
    return None
}

pub fn get(s: &Store, key: &string): Option<string> {
    let p = pageFor(s, key)
    let Some(slot) = slotIn(s, p, key) else { return None }
    // copy-out, never a borrow into the page
    return Some(s.pages[p].entries[slot].value.clone())
}

pub fn put(s: &mut Store, key: string, value: string)
requires s.pages.len() > 0
ensures s.count == old(s.count) || s.count == old(s.count) + 1
ensures s.pages.len() >= old(s.pages.len())
{
    let p = pageFor(s, key)
    if let Some(slot) = slotIn(s, p, key) {
        s.pages[p].entries[slot].value = value
        return
    }
    // sorted insert position
    var pos: i64 = 0
    while pos < s.pages[p].entries.len() && s.pages[p].entries[pos].key < key {
        pos += 1
    }
    s.pages[p].entries.insert(pos, Entry { key: key, value: value })
    s.count += 1

    // split when over capacity: move the upper half into a new page after p
    if s.pages[p].entries.len() > PAGE_CAP {
        let half = s.pages[p].entries.len() / 2
        var upper: Vec<Entry> = Vec.new()
        while s.pages[p].entries.len() > half
        invariant s.pages[p].entries.len() >= half
        {
            upper.push(s.pages[p].entries.remove(half))
        }
        s.pages.insert(p + 1, Page { entries: upper })
    }
}

// ── Scan: cursor is a plain position; the store is passed per step ──

pub struct Cursor {
    page: i64,
    slot: i64,
}

pub fn scanStart(): Cursor {
    return Cursor { page: 0, slot: 0 }
}

// Advance the cursor and copy out the next entry, or None when exhausted.
// (The Rust shape, an Iterator borrowing pages, needs a stored ref; this is
// the no-stored-refs equivalent: cursor by value, store by param.)
pub fn scanNext(s: &Store, c: &mut Cursor): Option<Entry>
requires c.page >= 0 && c.slot >= 0
ensures c.page >= old(c.page)
{
    while c.page < s.pages.len() {
        if c.slot < s.pages[c.page].entries.len() {
            let e = Entry {
                key: s.pages[c.page].entries[c.slot].key.clone(),
                value: s.pages[c.page].entries[c.slot].value.clone(),
            }
            c.slot += 1
            return Some(e)
        }
        c.page += 1
        c.slot = 0
    }
    return None
}

pub fn main(): i32 {
    var s = storeNew()

    // inserts that force splits (PAGE_CAP = 4)
    put(&mut s, "delta", "4")
    put(&mut s, "alpha", "1")
    put(&mut s, "echo", "5")
    put(&mut s, "bravo", "2")
    put(&mut s, "golf", "7")
    put(&mut s, "charlie", "3")
    put(&mut s, "foxtrot", "6")
    put(&mut s, "hotel", "8")

    print(s.count) // 8
    print(s.pages.len()) // >1: splits happened

    // point reads
    print(get(s, "charlie") ?? "missing") // 3
    print(get(s, "zulu") ?? "missing") // missing

    // overwrite
    put(&mut s, "alpha", "one")
    print(get(s, "alpha") ?? "missing") // one
    print(s.count) // still 8

    // full ordered scan
    var c = scanStart()
    var keys = String.withCapacity(64)
    while let Some(e) = scanNext(s, &mut c) {
        keys.pushStr(e.key)
        keys.push(32)
    }
    print(keys) // alpha bravo charlie delta echo foxtrot golf hotel

    return 0
}
