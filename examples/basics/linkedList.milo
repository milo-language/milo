// @run:
// Doubly-linked list on an arena. The list owns every node; a node names its
// neighbours by Handle, a copyable token the arena resolves, so no stored reference
// is needed and a walk is a chain of handle lookups.
from "std/arena" import { Arena, Handle }

pub struct DLNode {
    value: i64,
    prev: Option<Handle<DLNode>>,
    next: Option<Handle<DLNode>>,
}

pub struct DLList {
    arena: Arena<DLNode>,
    head: Option<Handle<DLNode>>,
    tail: Option<Handle<DLNode>>,
    len: i64,
}

pub fn newList(): DLList {
    return DLList { arena: Arena<DLNode>.new(), head: None, tail: None, len: 0 }
}

pub fn pushBack(list: &mut DLList, value: i64) {
    let h = list.arena.alloc(DLNode { value: value, prev: list.tail, next: None })
    if let Some(tailH) = list.tail {
        let _ = list.arena.modifyMut(tailH, (n: &mut DLNode) => { n.next = Some(h) })
    } else {
        list.head = Some(h)
    }
    list.tail = Some(h)
    list.len += 1
}

pub fn pushFront(list: &mut DLList, value: i64) {
    let h = list.arena.alloc(DLNode { value: value, prev: None, next: list.head })
    if let Some(headH) = list.head {
        let _ = list.arena.modifyMut(headH, (n: &mut DLNode) => { n.prev = Some(h) })
    } else {
        list.tail = Some(h)
    }
    list.head = Some(h)
    list.len += 1
}

// Joins the values from `start`, following `next` links forward or `prev` links back.
fn render(list: &DLList, start: Option<Handle<DLNode>>, forward: bool): string {
    var out = ""
    var cur = start
    while let Some(h) = cur {
        let node = list.arena.get(h)!
        if out.len > 0 { out.pushStr(" <-> ") }
        out.pushStr(node.value.toString())
        cur = if forward { node.next } else { node.prev }
    }
    return out
}

pub fn printForward(list: &DLList) { print(render(list, list.head, true)) }

pub fn printBackward(list: &DLList) { print(render(list, list.tail, false)) }

pub fn main(): i32 {
    var list = newList()

    pushBack(&mut list, 10)
    pushBack(&mut list, 20)
    pushBack(&mut list, 30)
    pushFront(&mut list, 5)
    pushFront(&mut list, 1)

    print("forward:")
    printForward(list)

    print("backward:")
    printBackward(list)

    print("len: ", list.len)

    return 0
}
