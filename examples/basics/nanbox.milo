// NaN-boxing: numbers and strings sharing one 8-byte slot.
//
// A 64-bit float has 2^52 bit patterns that all mean NaN, and arithmetic only
// ever produces one of them. The rest are free real estate. So: store a number
// as itself, and hide anything that is not a number inside a NaN payload.
//
// What that buys is an array of mixed values where each element is 8 bytes and
// still knows what it is. The alternative is an enum:
//
//     enum Value { Num(f64), Str(Handle<string>) }
//
// which LLVM lowers to `{ i32, [2 x i64] }` — 24 bytes, because the tag cannot
// overlap the widest payload. Nan-boxing folds the tag into bits the payload
// was never using, so it is 8.
//
// One thing here is not like the C version of this trick. C packs a raw pointer
// into the payload, so a stale box is a use-after-free. This packs a
// generational arena handle, so a stale box is a caught None. See the last two
// sections of main.
//
// @run:
from "std/binary" import {
    Bytes
}
from "std/arena" import {
    Arena, Handle, arenaWith
}

// Bits 62..50 all set marks a non-number. Hardware NaN from 0.0/0.0 is
// 0x7ff8_0000_0000_0000, which leaves bit 50 clear, so real NaN and both
// infinities survive as numbers. Only this one encoding is spent.
let QNAN: u64 = 0x7ffc000000000000
// The sign bit on top of that marks a string.
let SIGN: u64 = 0x8000000000000000

pub struct Value {
    bits: u64,
}

impl Value {
    fn num(d: f64): Value {
        return Value {
            bits: Bytes.f64ToBits(d)
        }
    }

    // 50 payload bits: 24 of slot index, 26 of generation. Both limits are
    // asserted rather than masked — a generation truncated to fit would let a
    // recycled slot alias an old handle back into validity, which is the one
    // thing the generation counter exists to prevent.
    fn str(h: Handle<string>): Value {
        assert(h.index >= 0 && h.index <= 16777215, "nanbox: index exceeds 24-bit payload")
        assert(h.generation >= 0 && h.generation <= 67108863, "nanbox: generation exceeds 26-bit payload")
        return Value {
            bits: SIGN | QNAN | ((h.generation as u64) << 24) | (h.index as u64)
        }
    }

    fn isNum(self: &Self): bool {
        return (self.bits & QNAN) != QNAN
    }
    fn asNum(self: &Self): f64 {
        return Bytes.f64FromBits(self.bits)
    }
    fn index(self: &Self): i32 {
        return (self.bits & 0xffffff) as i32
    }
    fn generation(self: &Self): i32 {
        return ((self.bits >> 24) & 0x3ffffff) as i32
    }

    // A Value never holds an address — only a slot number in this arena and the
    // generation that slot had when the box was made. The arena's own id is
    // read off the arena, never out of the box, so a value cannot even name a
    // different arena.
    fn handle(self: &Self, strings: &Arena<string>): Handle<string> {
        return Handle {
            arenaId: strings.id, index: self.index(), generation: self.generation()
        }
    }

    // Ask a value what it is and render it. This is the whole "it knows how to
    // print itself": one mask test, then either a bitcast or a checked arena
    // lookup. `get` checks four things before it touches memory — arena id,
    // index sign, index bounds, slot generation — and returns None if any fail,
    // which is why a stale or forged box becomes "<dangling>" instead of a read
    // of freed memory.
    //
    // It takes the arena rather than owning one on purpose. A Value is 8 bytes
    // and means nothing without the arena its handle indexes; a wrapper type
    // holding both would hide exactly the coupling this file exists to show.
    fn show(self: &Self, strings: &Arena<string>): string {
        if self.isNum() {
            return self.asNum().toString()
        }
        return strings.get(self.handle(strings)) ?? "<dangling>"
    }
}

// The counterpart to `show`. `show` returns an owned string, so `get` copies one
// out of the arena — right for printing, wrong for a hot loop. `arenaWith` hands
// the closure a borrow instead, so this walks every string and copies none.
//
// That is the whole Milo/Rust trade. Rust's `get` returns `Option<&String>` and
// makes you write `.cloned()` when you want to own it; Milo's returns `Option<T>`
// and makes you reach for `arenaWith` when you don't. Same two operations, and
// each language picks a different one to be the short spelling.
fn totalStringBytes(strings: &Arena<string>, arr: &Vec<Value>): i64 {
    var total: i64 = 0
    for v in arr {
        if v.isNum() {
            continue
        }
        total = total + (arenaWith(strings, v.handle(strings), (s: &string): i64 => {
            return s.len
        }
        ) ?? 0)
    }
    return total
}

fn main() {
    // The strings live here, and nowhere else. Every string Value is an index
    // into this arena plus a generation.
    var strings: Arena<string> = Arena<string>.new()

    // ── an array of mixed values, 8 bytes each ──
    var arr: Vec<Value> = Vec.new()
    arr.push(Value.num(4.0))
    arr.push(Value.str(strings.alloc("boo")))
    arr.push(Value.num(3.5))
    arr.push(Value.str(strings.alloc("and a string")))
    for v in arr {
        print(v.show(strings))
    }

    // ── reading without copying ──
    print("string bytes, none of them copied: " + totalStringBytes(strings, arr).toString())

    // ── real NaN and infinity are still numbers, not tags ──
    var zero: f64 = 0.0
    print("NaN is a number: " + Value.num(zero / zero).isNum().toString() + ", inf is a number: " + Value.num(1.0 / zero).isNum().toString())

    // ── a freed string is caught, not dereferenced ──
    let h = strings.alloc("about to be freed")
    let doomed = Value.str(h)
    print("before free: " + doomed.show(strings))
    let _ = strings.free(h)
    print("after free:  " + doomed.show(strings))

    // ── no 64-bit pattern reaches memory ──
    // In C the payload is an address, so a forged box is an arbitrary read.
    // Bun shipped exactly that in `bun:ffi` (upstream 179978a6f9): a C function
    // returning a double could hand JavaScript a forged pointer.
    var st: u64 = 0x9e3779b97f4a7c15
    var i: i64 = 0
    var reached: i64 = 0
    while i < 1000000 {
        st ^= (st << 13)
        st ^= (st >> 7)
        st ^= (st << 17)
        let forged = Value {
            bits: SIGN | QNAN | (st & 0x3ffffffffffff)
        }
        if forged.show(strings) != "<dangling>" {
            reached += 1
        }
        i += 1
    }
    print("forged 1000000 string references, dereferenced " + reached.toString())
}
