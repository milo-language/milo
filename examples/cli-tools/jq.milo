// @run: .
// @stdin: {"a":1}
// jq — minimal JSON query tool (field access, array iteration, array indexing).
// The document is parsed once by std/json; each filter step maps every current
// value to its children with `get`, `at` and the array length, and the output
// is the value's own source text (`rawStr`), so numbers and nested values print
// exactly as they came in.
from "std/fs" import { readFile }
from "std/argparse" import { ArgParser }
from "std/io" import { readStdin }
from "std/json" import { Json }

enum Step {
    Field(string),
    Iterate,
    Index(i64),
}

// parse ".foo.bar[].baz[0]" into steps: [Field("foo"), Field("bar"), Iterate, Field("baz"), Index(0)]
pub fn parseFilter(filter: &string): Vec<Step> {
    var steps: Vec<Step> = Vec.new()
    var name = ""
    var index = ""
    var inBracket = false
    for ch in filter {
        if inBracket {
            if ch == ']' {
                steps.push(if index.len == 0 { Step.Iterate } else { Step.Index(index.parseInt() ?? 0) })
                index = ""
                inBracket = false
            } else {
                index.push(ch)
            }
            continue
        }
        if ch == '.' || ch == '[' {
            if name.len > 0 { steps.push(Step.Field(name)) }
            name = ""
            inBracket = ch == '['
        } else {
            name.push(ch)
        }
    }
    if name.len > 0 { steps.push(Step.Field(name)) }
    return steps
}

fn jsonNull(): Json {
    return Json.parse("null")!
}

pub fn applyStep(values: &Vec<Json>, step: &Step): Vec<Json> {
    var next: Vec<Json> = Vec.new()
    for v in values {
        match step {
            Step.Field(name) => {
                if !v.isObject() { print($"jq: expected object for field '.{name}'") }
                next.push(v.get(name) ?? jsonNull())
            }
            Step.Iterate => {
                if v.isArray() {
                    for i in 0..v.len() { next.push(v.at(i)!) }
                } else {
                    print("jq: expected array for '[]'")
                }
            }
            Step.Index(i) => {
                if !v.isArray() { print("jq: expected array for indexing") }
                next.push(v.at(i) ?? jsonNull())
            }
        }
    }
    return next
}

pub fn outputValue(val: &Json, raw: bool): void {
    if raw {
        print(val.asStr() ?? val.rawStr())
    } else {
        print(val.rawStr())
    }
}

pub fn main(): i32 {
    var parser = ArgParser.new("jq", "a minimal JSON query tool")
    parser.addPositional("filter", "jq filter expression (e.g. .foo.bar)")
    parser.addOptionalPositional("file", "JSON file (default: stdin)")
    parser.addBool("raw-output", "r", "output raw strings without quotes")
    let args = parser.parse()

    let filter = args.getString("filter") ?? ""
    let raw = args.getBool("raw-output")

    let content = if args.has("file") {
        match readFile(args.getString("file") ?? "") {
            Ok(data) => data
            Err(e) => { print($"jq: {e}") return 1 }
        }
    } else {
        readStdin()
    }
    let input = content.trim()
    if input.len == 0 {
        print("jq: empty input")
        return 1
    }
    let doc = match Json.parse(input) {
        Ok(d) => d
        Err(e) => { print($"jq: {e}") return 1 }
    }

    var values: Vec<Json> = [doc]
    for step in parseFilter(filter) {
        values = applyStep(values, step)
    }
    for val in values {
        outputValue(val, raw)
    }
    return 0
}
