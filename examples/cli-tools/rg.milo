// @run: fn examples/hello.milo
// rg — ripgrep-lite: regex-powered recursive search

from "std/argparse" import {
    ArgParser
}

from "std/fs" import {
    isDir, isFile, readDir, readFile
}
from "std/path" import {
    Path
}
from "std/regex" import {
    Regex, RegexMatch
}
from "std/color" import {
    Color
}
from "std/runtime" import {
    Promise
}
from "std/string" import {
    strContainsIgnoreCase, strIndexOfFromIgnoreCase
}
from "std/os" import {
    isatty
}
from "std/env" import {
    Env
}
from "std/strconv" import {
    parseInt
}
from "./rgignore" import {
    IgnoreSet, inGitRepo, loadIgnoreSet, stackIgnores
}
from "./rgliteral" import {
    requiredLiteral
}
from "./rgwalk" import {
    Walker, matchesType, shouldSkipDir
}

// ── helpers ──

pub fn isWordChar(ch: u8): bool {
    return (ch >= 'a' && ch <= 'z') || (ch >= 'A' && ch <= 'Z') || (ch >= '0' && ch <= '9') || ch == '_'
}

// ── options ──

pub struct RgOpts {
    countOnly: bool,
    filesOnly: bool,
    invert: bool,
    wordBound: bool,
    noColor: bool,
    noLineNum: bool,
    noHeading: bool,
    searchHidden: bool,
    maxCount: i64,
    afterCtx: i64,
    beforeCtx: i64,
    fileType: string,
    totalMatches: i64,
    needsSeparator: bool,
    // The pattern, plus whether it is a plain substring. Kept on the options so
    // the whole-file reject below does not recompute it per file.
    pattern: string,
    literal: bool,
    // A substring every match must contain, or "" when none could be proven. For a
    // plain literal it is the pattern itself; for a regex it comes from
    // `requiredLiteral`. Everything downstream keys off this rather than off
    // `literal`, which is what lets a regex search use the same whole-file reject and
    // the same parallel prescan the literal path has always had — the regex engine
    // then only ever runs on files that could possibly match.
    prefilter: string,
    // -i has to reach the literal matcher, not just the regex flags. It used to stop
    // at the flags, so `rg -i foo` prefiltered case-SENSITIVELY and silently dropped
    // every match that differed in case — a wrong answer, not a slow one.
    //
    // Folding happens inside the search (std/string's case-insensitive memchr
    // scan), not by lowercasing a copy of every file — that copy cost more than the
    // search it fed.
    ignoreCase: bool,
    // Honour .gitignore/.ignore during the walk. Not honouring them is not just a
    // different result set — on a checkout with build directories it is most of the
    // work: `rg clang .` over llvm-project reads 3.9 GB of object files nothing asked
    // for, and prints ten times the matches real rg does.
    useIgnore: bool,
    // Split from useIgnore because .ignore and .gitignore have different scopes: rg
    // applies a .gitignore only inside a git checkout (its --require-git default),
    // while a .ignore file is honoured anywhere. Searching a plain directory that
    // happens to contain a .gitignore must not silently drop files from the results.
    useGitIgnore: bool,
}

// Next occurrence of the literal at or after `from`, honouring -i.
pub fn literalFrom(content: &string, opts: &RgOpts, from: i64): Option<i64> {
    if opts.ignoreCase {
        let at = strIndexOfFromIgnoreCase(content, opts.pattern, from)
        if at < 0 {
            return None
        }
        return Some(at)
    }
    return content.indexOfFrom(opts.pattern, from)
}

pub fn literalIn(content: &string, needle: &string, ci: bool): bool {
    if ci {
        return strContainsIgnoreCase(content, needle)
    }
    return content.contains(needle)
}

// ── match helpers ──

pub fn filterWordBounds(line: &string, matches: Vec<RegexMatch>): Vec<RegexMatch> {
    var result: Vec<RegexMatch> = Vec.new()
    for i in 0..matches.len {
        var ok = true
        if matches[i].start > 0 {
            if isWordChar(line[matches[i].start - 1]) {
                ok = false
            }
        }
        if ok && matches[i].end < line.len {
            if isWordChar(line[matches[i].end]) {
                ok = false
            }
        }
        if ok {
            result.push(RegexMatch {
                start: matches[i].start, end: matches[i].end
            })
        }
    }
    return result
}

// A pattern with no regex metacharacters is just a substring search, and
// `contains` bottoms out in memchr + memcmp. Running the regex engine over every
// line of every file to find "uint256" is most of what made a tree-wide search
// slow — ripgrep's equivalent is its literal prefilter.
pub fn isPlainLiteral(pat: &string): bool {
    if pat.len == 0 {
        return false
    }
    for byte in pat {
        // . * + ? [ ] ( ) { } | ^ $ \
        if byte == '.' || byte == '*' || byte == '+' || byte == '?' {
            return false
        }
        if byte == '[' || byte == ']' || byte == '(' || byte == ')' {
            return false
        }
        if byte == '{' || byte == '}' || byte == '|' || byte == '^' {
            return false
        }
        if byte == '$' || byte == '\\' {
            return false
        }
        // A newline in the pattern would let a whole-buffer match straddle two lines,
        // which the literal path's "one match per line" bookkeeping cannot express.
        // The regex path cannot match it either — it searches line by line.
        if byte == '\n' {
            return false
        }
    }
    return true
}

// A NUL byte means the buffer is not text. ripgrep skips such a file silently on a
// recursive search; without this, one walk into a build directory printed megabytes
// of object-file and archive garbage — and paid to read and scan it first.
//
// The check is one memchr over the whole buffer, ahead of the literal search rather
// than after it, so a 40 MB `.a` costs a memchr instead of a memmem.
pub fn isBinary(content: &string): bool {
    if let Some(_) = content.indexOf("\0") {
        return true
    }
    return false
}

pub fn getMatches(re: &mut Regex, line: &string, wordBound: bool): Vec<RegexMatch> {
    if wordBound {
        return filterWordBounds(line, re.findAll(line))
    }
    return re.findAll(line)
}

pub fn highlightLine(line: &string, matches: &Vec<RegexMatch>, noColor: bool): string {
    if noColor || matches.len == 0 {
        return line.clone()
    }
    var result: string = ""
    var pos: i64 = 0
    for i in 0..matches.len {
        if matches[i].start > pos {
            result += line.substr(pos, matches[i].start)
        }
        let m = line.substr(matches[i].start, matches[i].end)
        result = result + Color.bold(Color.red(m))
        pos = matches[i].end
    }
    if pos < line.len {
        result += line.substr(pos, line.len)
    }
    return result
}

// ── output formatting ──

pub fn formatLine(content: &string, lineNum: i64, isMatch: bool, filePath: &string, multiFile: bool, opts: &RgOpts): string {
    // grep's convention, which rg follows: a matched line is delimited by ":", a
    // context line by "-". That applies to the path delimiter as well as the line
    // number one — with line numbers off (the default when piped) the path delimiter
    // is the only thing distinguishing a -A/-B context line from a hit.
    var delim = ":"
    if !isMatch {
        delim = "-"
    }
    var out: string = ""
    if multiFile && opts.noHeading {
        if opts.noColor {
            out += filePath
        } else {
            out += Color.magenta(filePath)
        }
        out += delim
    }
    if !opts.noLineNum {
        let num = (lineNum + 1).toString()
        if opts.noColor {
            out += num
        } else {
            out += Color.green(num)
        }
        out += delim
    }
    out += content
    return out
}

// ── file search ──

// What separates this file's output from the previous file's. Which one applies is a
// property of the *run*, not of the file — the first file to produce output gets none —
// so the choice is made here and applied by the printer, which is the only thing that
// knows what came before it.
pub enum LeadSep {
    None,
    Blank,
    Dashes,
}

// One file's finished output: the exact lines to write, and nothing that still needs
// deciding. Producing this is all of the per-match work — the regex, the word-boundary
// filter, the highlight escapes, the line reconstruction, the path/line-number prefix —
// and none of it touches shared state, which is what lets it run on a worker thread
// while the main thread is busy writing some earlier file's lines.
pub struct FileResult {
    lines: Vec<string>,
    matchCount: i64,
    leadSep: LeadSep,
}

pub fn emptyResult(): FileResult {
    return FileResult {
        lines: Vec.new(), matchCount: 0, leadSep: LeadSep.None
    }
}

// Write a finished result. The only ordering-sensitive step in the whole search, and
// the only one that has to happen on one thread.
pub fn emitResult(res: &FileResult, opts: &mut RgOpts): void {
    match res.leadSep {
        LeadSep.None => {
        }
        LeadSep.Blank => {
            if opts.needsSeparator {
                print("")
            }
            opts.needsSeparator = true
        }
        LeadSep.Dashes => {
            if opts.needsSeparator {
                print("--")
            }
            opts.needsSeparator = true
        }
    }
    for i in 0..res.lines.len {
        print(res.lines[i])
    }
    opts.totalMatches += res.matchCount
}

pub fn searchFile(filePath: &string, re: &mut Regex, opts: &mut RgOpts, multiFile: bool): void {
    if !matchesType(filePath, opts.fileType) {
        return
    }

    let content = match readFile(filePath) {
        Ok(data) => data
        Err(_) => {
            return
        }
    }
    let res = searchContent(content, filePath, &mut re, opts, multiFile, false)
    emitResult(res, &mut opts)
}

// `knownMatch` is set by the parallel path, which already proved the literal is in
// this buffer — re-running the whole-file reject there would scan every matching
// file twice for an answer it has.
//
// Returns the file's output rather than printing it: on the parallel path this runs on
// a worker thread, where printing would both interleave with other workers and put the
// formatting cost back on the critical path it was moved off of.
pub fn searchContent(content: &string, filePath: &string, re: &mut Regex, opts: &RgOpts, multiFile: bool, knownMatch: bool): FileResult {
    var res = emptyResult()
    if !knownMatch && isBinary(content) {
        return res
    }
    // Whole-file reject: if every match must contain `prefilter` and the file does not
    // contain it anywhere, there is nothing to split, allocate or scan line by line.
    // One memmem pass over the buffer replaces N regex runs. -v is excluded because a
    // non-matching line can sit in a file the prefilter never appears in.
    if !knownMatch && !opts.invert && opts.prefilter.len > 0 && !literalIn(content, opts.prefilter, opts.ignoreCase) {
        return res
    }

    if workerCanFormat(opts) {
        return searchLiteral(content, filePath, opts, multiFile)
    }

    return searchWithRegex(content, filePath, &mut re, opts, multiFile)
}

// The half of the search that never touches the regex engine, split out so a worker
// thread can run it — see workerCanFormat for why that split has to exist.
pub fn searchLiteral(content: &string, filePath: &string, opts: &RgOpts, multiFile: bool): FileResult {
    var res = emptyResult()

    // -l asks only "does this file match at all", which the whole-file reject — or the
    // parallel prescan, when it set knownMatch — has already answered. Falling through
    // to the line-by-line regex loop to rediscover it made `-l` 3x slower than the
    // search that prints every match.
    if opts.filesOnly {
        res.lines.push(filePath.clone())
        res.matchCount = 1
        return res
    }

    // Literal pattern, no context to print: search the file buffer, not its lines.
    //
    // Visiting every line to ask "does it match" costs a scan and a `Vec` per line —
    // 200k of each on this tree — to reject ~99% of them. Searching the whole buffer
    // instead means one memchr walk that lands directly on the next match and never
    // touches the bytes of a line that has none. Lines are only reconstructed around
    // the matches that survive, which is what makes this a scan of the ~1% rather
    // than a scan of everything.
    //
    // `isPlainLiteral` rejects a pattern containing a newline, so a match is always
    // contained in one line and `lineEnd` below is always past it.
    if opts.literal && !opts.invert && opts.beforeCtx == 0 && opts.afterCtx == 0 && !opts.filesOnly {
        var matchCountF: i64 = 0
        var headerPrintedF: bool = false
        // Counting lines means touching every newline in the file up to the last match,
        // which is a scan of the whole file — the one thing the buffer search exists to
        // avoid. Only a printed line *number* actually needs the count; the line's own
        // text needs nothing but its start, and that is a backward scan bounded by the
        // length of one line. -c needs neither.
        let needLineNo = !opts.countOnly && !opts.noLineNum
        let needLineText = !opts.countOnly
        var lineNo: i64 = 0
        var lineStart: i64 = 0
        var pos: i64 = 0
        let plen = opts.pattern.len
        while true {
            let Some(at) = literalFrom(content, opts, pos) else {
                break
            }
            // Walk forward to the line holding this match. lineStart never moves
            // backwards, so across the whole file this visits each newline once.
            if needLineNo {
                while true {
                    let Some(nl) = content.indexOfFrom("\n", lineStart) else {
                        break
                    }
                    if nl >= at {
                        break
                    }
                    lineStart = nl + 1
                    lineNo += 1
                }
            } else if needLineText {
                lineStart = 0
                var b = at
                while b > 0 {
                    if content[b - 1] == '\n' {
                        lineStart = b
                        break
                    }
                    b -= 1
                }
            }
            var lineEnd = content.len
            if let Some(nl) = content.indexOfFrom("\n", at) {
                lineEnd = nl
            }

            matchCountF += 1
            if !opts.countOnly {
                if !headerPrintedF && multiFile && !opts.noHeading {
                    res.leadSep = LeadSep.Blank
                    if opts.noColor {
                        res.lines.push(filePath.clone())
                    } else {
                        res.lines.push(Color.magenta(filePath))
                    }
                    headerPrintedF = true
                }
                // Every occurrence on this line, as offsets within the line.
                var lineMatches: Vec<RegexMatch> = Vec.new()
                var m = at
                while m + plen <= lineEnd {
                    let Some(mm) = literalFrom(content, opts, m) else {
                        break
                    }
                    if mm + plen > lineEnd {
                        break
                    }
                    lineMatches.push(RegexMatch {
                        start: mm - lineStart, end: mm + plen - lineStart
                    })
                    m = mm + plen
                }
                let lineText = content.substr(lineStart, lineEnd)
                let hlF = highlightLine(lineText, lineMatches, opts.noColor || opts.invert)
                res.lines.push(formatLine(hlF, lineNo, true, filePath, multiFile, opts))
            }
            if opts.maxCount > 0 && matchCountF >= opts.maxCount {
                break
            }
            // One match per line: resume past this line entirely.
            pos = lineEnd + 1
            if pos > content.len {
                break
            }
        }
        if opts.countOnly && matchCountF > 0 {
            if multiFile {
                res.lines.push(filePath + ":" + matchCountF.toString())
            } else {
                res.lines.push(matchCountF.toString())
            }
        }
        res.matchCount = matchCountF
        return res
    }
    return res
}

// The line-by-line path: everything the buffer walk above cannot express — a real
// regex, -w, -v, or context lines. Main-thread only, because regexec is not
// thread-safe on macOS (see workerCanFormat).
pub fn searchWithRegex(content: &string, filePath: &string, re: &mut Regex, opts: &RgOpts, multiFile: bool): FileResult {
    var res = emptyResult()

    let lines = content.split("\n")
    var numLines = lines.len
    if numLines > 0 && lines[numLines - 1].len == 0 {
        numLines -= 1
    }

    var matchCount: i64 = 0
    var lastPrinted: i64 = -1 as i64
    var afterRemaining: i64 = 0
    var headerPrinted: bool = false

    for i in 0..numLines {
        let matches = getMatches(&mut re, lines[i], opts.wordBound)
        var isMatch = matches.len > 0
        if opts.invert {
            isMatch = matches.len == 0
        }

        if isMatch {
            matchCount += 1

            let hasCtx = opts.beforeCtx > 0 || opts.afterCtx > 0

            if !opts.countOnly && !opts.filesOnly {
                // file header for grouped output
                if !headerPrinted && multiFile && !opts.noHeading {
                    res.leadSep = LeadSep.Blank
                    if opts.noColor {
                        res.lines.push(filePath.clone())
                    } else {
                        res.lines.push(Color.magenta(filePath))
                    }
                    headerPrinted = true
                }
                // Grouped output separates files with a blank line; ungrouped output
                // separates them the same way it separates context groups, with "--".
                // The separator carries across files, so the very first group of the
                // whole run is not preceded by one — which is why the choice is recorded
                // here and applied by emitResult, the only place that knows the run's
                // history.
                if hasCtx && multiFile && opts.noHeading && !headerPrinted {
                    res.leadSep = LeadSep.Dashes
                    headerPrinted = true
                }

                // before-context lines
                var ctxStart: i64 = i - opts.beforeCtx
                if ctxStart < 0 {
                    ctxStart = 0
                }
                if ctxStart <= lastPrinted {
                    ctxStart = lastPrinted + 1
                }

                // "--" separates context *groups*. With no -A/-B/-C there are no
                // groups to separate, and emitting it between any two non-adjacent
                // matching lines put thousands of stray "--" lines into the output of
                // an ordinary regex search — 55 lines where ripgrep prints 31.
                if hasCtx && lastPrinted >= 0 && ctxStart > lastPrinted + 1 {
                    res.lines.push("--")
                }

                for j in ctxStart..i {
                    res.lines.push(formatLine(lines[j], j, false, filePath, multiFile, opts))
                }

                // match line with highlighting
                let hl = highlightLine(lines[i], matches, opts.noColor || opts.invert)
                res.lines.push(formatLine(hl, i, true, filePath, multiFile, opts))
                lastPrinted = i
                afterRemaining = opts.afterCtx
            }

            if opts.maxCount > 0 && matchCount >= opts.maxCount {
                break
            }
        } else if afterRemaining > 0 {
            res.lines.push(formatLine(lines[i], i, false, filePath, multiFile, opts))
            lastPrinted = i
            afterRemaining -= 1
        }
    }

    if opts.countOnly && matchCount > 0 {
        if multiFile {
            res.lines.push($"{filePath}:{matchCount}")
        } else {
            res.lines.push(matchCount.toString())
        }
    }

    if opts.filesOnly && matchCount > 0 {
        res.lines.push(filePath.clone())
    }

    res.matchCount = matchCount
    return res
}

// ── directory search ──

// A file that survived the prescan, carrying the bytes the prescan already read.
// Read these files and produce their finished output.
//
// Everything here is per-file and touches no shared state, which is what makes it safe
// on an OS thread: the read, the binary check, the whole-file literal reject, and — the
// part that used to be the main thread's problem — the regex, the highlighting and the
// line formatting. Only the writing is left for the caller.
//
// Formatting on this side also means the file's *bytes* die here. Handing back a 40 MB
// buffer so the main thread could format 3 lines out of it was the reason peak RSS
// tracked the size of the matching set rather than the size of the output.
//
// The prescan and the matcher must agree on case, or the prescan silently drops files
// the matcher would have printed — so both go through literalIn/literalFrom.
// Can a worker turn this file's bytes into finished output by itself, or does that
// need the regex engine?
//
// It matters because **POSIX regexec is not thread-safe on macOS**. Not "not safe on a
// shared regex_t" — not safe at all: four threads each running regexec on a regex_t
// they compiled themselves, over the same corpus, disagree on the match count, and
// regcomp itself intermittently fails. Reproduced in plain C with no Milo involved
// (scratchpad/regprobe.c), so this is a libc property, not something rg or std/regex
// can be restructured around. The symptom is silently *missing* matches — a wrong
// answer, not a crash — which is the worst possible way for it to show up.
//
// So the regex stays on one thread. What can move is every pattern that never reaches
// the engine: a plain literal with no context lines, which is the common case and the
// expensive one.
pub fn workerCanFormat(opts: &RgOpts): bool {
    if !opts.literal || opts.invert {
        return false
    }
    if opts.filesOnly {
        return true
    }
    return opts.beforeCtx == 0 && opts.afterCtx == 0
}

// One file that survived the prescan. Either the worker formatted it outright, or the
// pattern needs the regex and the bytes come back for the main thread to handle.
pub struct ChunkItem {
    path: string,
    result: FileResult,
    content: string,
    formatted: bool,
}

pub fn scanChunk(paths: Vec<string>, opts: RgOpts): Vec<ChunkItem> {
    var out: Vec<ChunkItem> = Vec.new()
    let canFormat = workerCanFormat(opts)
    for i in 0..paths.len {
        match readFile(paths[i]) {
            Ok(data) => {
                if !isBinary(data) && literalIn(data, opts.prefilter, opts.ignoreCase) {
                    if canFormat {
                        let res = searchLiteral(data, paths[i], opts, true)
                        if res.lines.len > 0 || res.matchCount > 0 {
                            out.push(ChunkItem {
                                path: paths[i].clone(), result: res, content: "", formatted: true
                            })
                        }
                    } else {
                        out.push(ChunkItem {
                            path: paths[i].clone(), result: emptyResult(), content: data, formatted: false
                        })
                    }
                }
            }
            Err(_) => {
            }
        }
    }
    return out
}

// How many prescan chunks are read concurrently.
//
// Fewer than you would guess. The old code ran one worker per logical core (10) and
// the search got *faster* on the way down to 4: past that point the readers are
// competing for the same page cache and memory bandwidth rather than overlapping
// anything, and a big-core machine with slow little cores (4 performance + 6
// efficiency here) also stops adding useful throughput once the performance cores are
// busy. Measured on llvm-project, `rg clang .`: 16→3.3s, 8→2.9s, 4→2.5s, 3→2.5s,
// 2→3.0s. It is a shallow basin, so 4 is picked over 3 for margin on a machine with
// more cores, not because the two differ.
//
// This also stopped mattering as much as it used to: with chunks awaited in dispatch
// order and refilled one at a time, a slow chunk no longer stalls the other workers,
// so throughput no longer needs oversubscription to hide stragglers.
pub fn maxInflight(): i64 {
    return inflightSetting()
}

// The knob exists so the basin above can be re-measured without a rebuild — the
// optimum moves whenever the amount of work a worker does changes.
pub fn inflightSetting(): i64 {
    let raw = Env.getOr("MILO_RG_THREADS", "")
    if raw.len == 0 {
        return 4
    }
    match parseInt(raw) {
        Some(n) => {
            if n > 0 {
                return n
            }
            return 4
        }
        None => {
            return 4
        }
    }
}

// Files per chunk, once the pipeline is up to speed. Chunks start far smaller (see
// `firstChunk`) so the first result does not wait on a full one.
pub fn chunkCap(): i64 {
    return 128
}

// The first chunks are tiny on purpose: time-to-first-line is what a human watching a
// tree-wide search actually feels, and it is bounded by the *first* chunk to finish,
// not by throughput. 4 files is a few milliseconds; doubling up to chunkCap() gets the
// steady-state chunk size back within the first dozen dispatches.
pub fn firstChunk(): i64 {
    return 4
}

// The worker needs the whole option set, not just the needle, now that it formats. It
// gets a copy: the live `opts` carries the run's running totals and separator state,
// which belong to the printing thread and must not be touched from here.
pub fn cloneOpts(o: &RgOpts): RgOpts {
    return RgOpts {
        countOnly: o.countOnly,
        filesOnly: o.filesOnly,
        invert: o.invert,
        wordBound: o.wordBound,
        noColor: o.noColor,
        noLineNum: o.noLineNum,
        noHeading: o.noHeading,
        searchHidden: o.searchHidden,
        maxCount: o.maxCount,
        afterCtx: o.afterCtx,
        beforeCtx: o.beforeCtx,
        fileType: o.fileType.clone(),
        totalMatches: 0,
        needsSeparator: false,
        pattern: o.pattern.clone(),
        literal: o.literal,
        prefilter: o.prefilter.clone(),
        ignoreCase: o.ignoreCase,
        useIgnore: o.useIgnore,
        useGitIgnore: o.useGitIgnore,
    }
}

fn spawnChunk(chunk: Vec<string>, opts: &RgOpts): Promise<Vec<ChunkItem>> {
    let mine = cloneOpts(opts)
    return Promise<Vec<ChunkItem>>.blocking(move(): Vec<ChunkItem> => {
        return scanChunk(chunk, mine)
    })
}

// Literal search over a directory, pipelined.
//
// Only the "which files contain this at all" pass runs on threads — it is the whole
// cost on a tree (most files do not match) and it produces no output, so there is
// nothing to order. Printing happens on this thread over the surviving files in walk
// order, so output order is the walk's, not the threads'.
//
// The shape is a sliding window rather than rounds with a barrier: chunks are awaited
// in dispatch order, and each completed chunk immediately dispatches another. Nothing
// waits for a whole round to drain, so one slow chunk delays only its own position in
// the output instead of stalling every worker. The walk runs on this thread in the
// gaps between awaits, which is also what overlaps it with the reads it feeds.
//
// Live memory is bounded the way rounds bounded it — at most maxInflight() * chunkCap()
// files' worth of matching bytes — which is what keeps a tree whose matching files
// total 4.6 GB from paging the machine.
pub fn searchDirParallel(dirPath: &string, re: &mut Regex, opts: &mut RgOpts): void {
    var walker = Walker.new(dirPath, opts.searchHidden, opts.useIgnore, opts.useGitIgnore, opts.fileType.clone())

    var inflight: Vec<Promise<Vec<ChunkItem>>> = Vec.new()
    var chunkSize = firstChunk()

    while inflight.len < maxInflight() {
        let batch = walker.nextBatch(chunkSize)
        if batch.len == 0 {
            break
        }
        inflight.push(spawnChunk(batch, opts))
        chunkSize *= 2
        if chunkSize > chunkCap() {
            chunkSize = chunkCap()
        }
    }

    var head: i64 = 0
    while head < inflight.len {
        let done = inflight[head].await()!
        head += 1

        // Refill before writing, not after: the workers should be reading and
        // formatting the next chunk while this thread writes the current one.
        let batch = walker.nextBatch(chunkSize)
        if batch.len > 0 {
            inflight.push(spawnChunk(batch, opts))
            chunkSize *= 2
            if chunkSize > chunkCap() {
                chunkSize = chunkCap()
            }
        }

        for j in 0..done.len {
            if done[j].formatted {
                emitResult(done[j].result, &mut opts)
            } else {
                // The worker read it but could not format it — a regex pattern, and the
                // engine only runs here. Same work as before, just no longer the whole
                // job for every search.
                let res = searchWithRegex(done[j].content, done[j].path, &mut re, opts, true)
                emitResult(res, &mut opts)
            }
        }
    }
}

pub fn searchDir(dirPath: &string, re: &mut Regex, opts: &mut RgOpts, sets: &mut Vec<IgnoreSet>): void {
    let Ok(entries) = readDir(dirPath) else {
        return
    }
    var pushed = false
    if opts.useIgnore {
        if let Some(set) = loadIgnoreSet(dirPath, opts.useGitIgnore) {
            sets.push(set)
            pushed = true
        }
    }
    for i in 0..entries.len {
        let name = entries[i].name.clone()
        let entryIsDir = entries[i].isDir
        let entryIsFile = entries[i].isFile

        if !opts.searchHidden && name.len > 0 && name[0] == '.' {
            continue
        }

        let fullPath = Path.join(dirPath, name)
        if entryIsDir {
            if !shouldSkipDir(name) && !stackIgnores(sets, fullPath, name, true) {
                searchDir(fullPath, &mut re, &mut opts, &mut sets)
            }
        } else if entryIsFile {
            if !stackIgnores(sets, fullPath, name, false) {
                searchFile(fullPath, &mut re, &mut opts, true)
            }
        }
    }
    if pushed {
        let _ = sets.pop()
    }
}

// True when the search ran; false when `path` does not exist. The distinction has to
// reach main: "I searched and found nothing" and "you named a path that isn't there"
// are different outcomes, and collapsing both onto exit 1 means no script can tell
// them apart. rg uses 2 for the second, and puts the message on stderr.
pub fn searchPath(path: &string, re: &mut Regex, opts: &mut RgOpts): bool {
    if isDir(path) {
        // The prescan asks "does this file contain the prefilter", which is a sound
        // question for a regex too — so a regex with a provable required substring
        // gets the parallel walk, not just a plain literal.
        if opts.prefilter.len > 0 && !opts.invert {
            searchDirParallel(path, &mut re, &mut opts)
        } else {
            var sets: Vec<IgnoreSet> = Vec.new()
            searchDir(path, &mut re, &mut opts, &mut sets)
        }
    } else if isFile(path) {
        searchFile(path, &mut re, &mut opts, false)
    } else {
        eprint($"rg: {path}: no such file or directory")
        return false
    }
    return true
}

// ── main ──

pub fn main(): i32 {
    var parser = ArgParser.new("rg", "ripgrep-lite: regex-powered recursive search")
    parser.addPositional("pattern", "regex pattern to search for")
    parser.addOptionalPositional("path", "file or directory (default: .)")
    parser.addBool("ignore-case", "i", "case-insensitive search")
    parser.addBool("count", "c", "only print count of matches per file")
    parser.addBool("files-with-matches", "l", "only print filenames that match")
    parser.addBool("invert-match", "v", "select non-matching lines")
    parser.addBool("word-regexp", "w", "match whole words only")
    parser.addBool("no-color", "p", "disable colored output")
    parser.addBool("no-line-number", "N", "hide line numbers")
    parser.addBool("line-number", "n", "show line numbers even when output is not a terminal")
    parser.addBool("no-heading", "g", "grep-style output (no file grouping)")
    parser.addBool("hidden", "H", "search hidden files and directories")
    parser.addBool("no-ignore", "u", "do not respect .gitignore/.ignore files")
    parser.addBool("color", "k", "force color even when output is not a terminal")
    parser.addI64("after-context", "A", "lines to show after match", 0)
    parser.addI64("before-context", "B", "lines to show before match", 0)
    parser.addI64("context", "C", "lines to show before and after match", 0)
    parser.addI64("max-count", "m", "max matches per file", 0)
    parser.addString("type", "t", "filter by file extension (e.g. milo)", "")
    let args = parser.parse()

    let pattern = args.getString("pattern") ?? ""
    let ignoreCase = args.getBool("ignore-case")

    // REG_EXTENDED=1, REG_ICASE=2
    var flags: i32 = 1
    if ignoreCase {
        flags = 3
    }

    // let-else binds directly, so there's no placeholder to pre-size. The old form built
    // a dummy `Regex { _preg: [0; 128] }` just to satisfy definite-initialization, which
    // hardcoded the darwin regex_t size into an app — glibc's is 64, so this file could
    // not compile on Linux at all.
    let Ok(compiled) = Regex.compileFlags(pattern.clone(), flags) else {
        print($"rg: invalid regex: {pattern}")
        return 2
    }
    var re = compiled // the search chain takes &mut Regex

    // -C sets both; -A/-B override if non-zero
    let ctxVal = args.getI64("context")
    let afterVal = args.getI64("after-context")
    let beforeVal = args.getI64("before-context")
    var afterCtx: i64 = ctxVal
    var beforeCtx: i64 = ctxVal
    if afterVal > 0 {
        afterCtx = afterVal
    }
    if beforeVal > 0 {
        beforeCtx = beforeVal
    }

    // Colour codes, per-file heading blocks and line numbers are for a human at a terminal. Piped
    // into a file or another program they are noise the consumer has to strip — and
    // on a big search they are also bytes we spend the whole run building. All three
    // default to off when stdout is not a tty, which is what real rg does; -k/-n force
    // them back on, -p/-g/-N pin them off.
    let interactive = isatty(1) != 0
    let forceColor = args.getBool("color")

    // -w narrows a literal to whole words, which the buffer-walk print path cannot
    // express — so the pattern stops being "plain" for that path. It stays a perfectly
    // good *prefilter* though, which is why the two are computed separately.
    // requiredLiteral has a minimum length below which a prefilter costs more than it
    // saves, but a whole pattern that is already a literal is exact rather than a
    // heuristic — take it at any length.
    let plainLiteral = isPlainLiteral(pattern) && !args.getBool("word-regexp")
    var prefilter = requiredLiteral(pattern)
    if isPlainLiteral(pattern) {
        prefilter = pattern.clone()
    }

    var target = args.getString("path") ?? ""
    if target.len == 0 {
        target = "."
    }

    var opts = RgOpts {
        countOnly: args.getBool("count"),
        filesOnly: args.getBool("files-with-matches"),
        invert: args.getBool("invert-match"),
        wordBound: args.getBool("word-regexp"),
        noColor: args.getBool("no-color") || (!interactive && !forceColor),
        noLineNum: args.getBool("no-line-number") || (!interactive && !args.getBool("line-number")),
        noHeading: args.getBool("no-heading") || !interactive,
        searchHidden: args.getBool("hidden"),
        maxCount: args.getI64("max-count"),
        afterCtx: afterCtx,
        beforeCtx: beforeCtx,
        fileType: (args.getString("type") ?? ""),
        totalMatches: 0,
        needsSeparator: false,
        pattern: pattern.clone(),
        literal: plainLiteral,
        prefilter: prefilter,
        ignoreCase: ignoreCase,
        useIgnore:!args.getBool("no-ignore"),
        useGitIgnore:!args.getBool("no-ignore") && inGitRepo(target),
    }

    if !searchPath(target, &mut re, &mut opts) {
        return 2
    }

    if opts.totalMatches == 0 {
        return 1
    }
    return 0
}
