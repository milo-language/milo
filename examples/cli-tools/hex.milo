// @run: examples/hello.milo
// hex — hex dump viewer
from "std/fs" import {
    readFile
}
from "std/argparse" import {
    ArgParser
}

pub fn byteToHex(b: u8): string {
    let hex = "0123456789abcdef"
    var result: string = ""
    let hi = (b / 16) as i64
    let lo = (b % 16) as i64
    result.push(hex[hi])
    result.push(hex[lo])
    return result
}

pub fn offsetToHex(n: i64): string {
    let hex = "0123456789abcdef"
    var result: string = ""
    var val: i64 = n
    for i in 0..8 {
        var chBuf: string = ""
        chBuf.push(hex[val % 16])
        result = chBuf + result
        val /= 16
    }
    return result
}

pub fn isPrintable(b: u8): bool {
    return b >= 32 && b < 127
}

pub fn main(): i32 {
    var parser = ArgParser.new("hex", "hex dump viewer")
    parser.addPositional("file", "file to dump")
    parser.addI64("length", "n", "number of bytes to display", 0)
    parser.addI64("skip", "s", "skip N bytes from start", 0)
    parser.addBool("plain", "p", "no ASCII column, just hex")
    let args = parser.parse()

    let plain = args.getBool("plain")
    let cols: i64 = 16

    var maxLength: i64 = args.getI64("length")
    var skipBytes: i64 = args.getI64("skip")

    let content = match readFile(args.getString("file") ?? "") {
        Result.Ok(data) => data
        Result.Err(e) => {
            print("hex: ", e)
            return 1
        }
    }

    var start: i64 = skipBytes
    var end: i64 = content.len
    if maxLength > 0 && start + maxLength < end {
        end = start + maxLength
    }

    var offset: i64 = start
    while offset < end {
        var hexPart: string = ""
        var asciiPart: string = ""
        var col: i64 = 0

        while col < cols && offset + col < end {
            let b = content[offset + col]
            hexPart = hexPart + byteToHex(b) + " "

            if col == 7 {
                hexPart += " "
            }

            if !plain {
                if isPrintable(b) {
                    var ch: string = ""
                    ch.push(b)
                    asciiPart += ch
                } else {
                    asciiPart += "."
                }
            }

            col += 1
        }

        // pad remaining columns
        while col < cols {
            hexPart += "   "
            if col == 7 {
                hexPart += " "
            }
            col += 1
        }

        var line: string = offsetToHex(offset) + ": " + hexPart

        if !plain {
            line = line + " |" + asciiPart + "|"
        }

        print(line)
        offset += cols
    }

    return 0
}
