// @run: examples/embedded
// tree — display directory tree
from "std/argparse" import { ArgParser }
from "std/fs" import { readDir }
from "std/path" import { Path }

pub struct Counts {
    dirs: i64,
    files: i64,
}

pub fn printTree(dirPath: &string, prefix: &string, depth: i64, maxLevel: i64, counts: &mut Counts): void {
    if maxLevel > 0 && depth >= maxLevel {
        return
    }

    let entries = readDir(dirPath)!
    for idx, entry in entries {
        let isLast = idx == entries.len - 1
        // ASCII tree characters
        let connector = if isLast { "`-- " } else { "|-- " }
        let extension = if isLast { "    " } else { "|   " }

        print(prefix, connector, entry.name)

        if entry.isDir {
            counts.dirs += 1
            printTree(Path.join(dirPath, entry.name), prefix + extension, depth + 1, maxLevel, &mut counts)
        } else {
            counts.files += 1
        }
    }
}

pub fn main(): i32 {
    var parser = ArgParser.new("tree", "display directory tree")
    parser.addOptionalPositional("dir", "directory to display (default: .)")
    parser.addI64("level", "L", "max display depth", 0)
    let args = parser.parse()

    let root: string = args.getString("dir") ?? "."
    let maxLevel = args.getI64("level")

    print(root)
    var counts = Counts { dirs: 1, files: 0 }
    printTree(root, "", 0, maxLevel, &mut counts)

    let dirWord = if counts.dirs == 1 { "directory" } else { "directories" }
    let fileWord = if counts.files == 1 { "file" } else { "files" }
    print($"\n{counts.dirs} {dirWord}, {counts.files} {fileWord}")

    return 0
}
