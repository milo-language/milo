// @run:
// @stdin: a b c
// wc — count lines, words, and characters
from "std/fs" import {
    readFile
}
from "std/argparse" import {
    ArgParser
}
from "std/io" import {
    readStdin
}

pub fn pad(n: i64): string {
    let s = n.toString()
    var result: string = ""
    for p in 0..8 - s.len {
        result.pushStr(" ")
    }
    return result + s
}

pub fn main(): i32 {
    var parser = ArgParser.new("wc", "count lines, words, and characters")
    parser.addOptionalPositional("file", "file to count (default: stdin)")
    parser.addBool("lines", "l", "only show line count")
    parser.addBool("words", "w", "only show word count")
    parser.addBool("chars", "c", "only show character count")
    let args = parser.parse()

    let showLines = args.getBool("lines")
    let showWords = args.getBool("words")
    let showChars = args.getBool("chars")
    let showAll = !showLines && !showWords && !showChars

    var content: string = ""
    var label: string = ""

    if args.has("file") {
        label = args.getString("file") ?? ""
        content = match readFile(args.getString("file") ?? "") {
            Ok(data) => data
            Err(e) => {
                print($"wc: {e}")
                return 1
            }
        }
    } else {
        content = readStdin()
    }

    // count lines
    var lines: i64 = 0
    for ch in content {
        if ch == '\n' {
            lines += 1
        }
    }

    // count words
    var words: i64 = 0
    var inWord: bool = false
    for ch in content {
        if ch == ' ' || ch == '\n' || ch == '\t' || ch == '\r' {
            if inWord {
                words += 1
                inWord = false
            }
        } else {
            inWord = true
        }
    }
    if inWord {
        words += 1
    }

    let chars = content.len

    if showAll {
        print($"{pad(lines)}{pad(words)}{pad(chars)} {label}")
    } else {
        var output: string = ""
        if showLines {
            output += pad(lines)
        }
        if showWords {
            output += pad(words)
        }
        if showChars {
            output += pad(chars)
        }
        print($"{output} {label}")
    }

    return 0
}
