// Headless validation of the LBM core against the canonical CFD benchmark:
// lid-driven cavity flow, compared to the tabulated centreline velocities in
//
//   U. Ghia, K.N. Ghia, C.T. Shin, "High-Re solutions for incompressible flow
//   using the Navier-Stokes equations and a multigrid method",
//   J. Comput. Phys. 48(3), 1982, pp. 387-411.
//
// No graphics — this is the correctness gate the wind tunnel renderer sits on top
// of. A pretty vortex proves nothing; matching Ghia's numbers does.
//
// Run:  milo run examples/simulation/windtunnel/cavity.milo --release
//       milo run examples/simulation/windtunnel/cavity.milo --release -- full
//       milo run examples/simulation/windtunnel/cavity.milo --release -- 1000 256
//
// No args     Re=100 on 64^2, ~2s. The CI gate.
// `full`      Re=100/400/1000 on 128^2, several minutes. The reported result.
// <re> [n]    One case, verbose: prints every station against the table.
//
// Exits non-zero if any case misses its tolerance or fails to reach steady state.
// -O3 matters here; the debug build is roughly 10x slower.
//
// Measured at 128^2 (worst |error| in lid-velocity units, over both centrelines):
//   Re=100   0.0055     Re=400   0.0082     Re=1000   0.0121
//
// @run:

from "std/math" import {
    Math
}
from "std/strconv" import {
    formatFloat, parseInt
}
from "std/args" import {
    args
}
from "./lbm" import {
    lbmIdx, lbmInit, lbmStep, lbmMacro, lbmMaxDelta, lbmSample, lbmTau, lbmBuildInterior
}

// --- Ghia et al. 1982 reference data ------------------------------------------
//
// Table I (u along the vertical centreline x=0.5) and Table II (v along the
// horizontal centreline y=0.5), for Re = 100, 400, 1000. Velocities are normalised
// by the lid speed. The sample points are the original non-uniform grid stations,
// which is why they cluster near the walls.

pub fn ghiaY(k: i64): f64 {
    let t: Vec<f64> = [1.0000, 0.9766, 0.9688, 0.9609, 0.9531, 0.8516, 0.7344, 0.6172, 0.5000, 0.4531, 0.2813, 0.1719, 0.1016, 0.0703, 0.0625, 0.0547, 0.0000]
    return t[k]
}

pub fn ghiaU(re: i64, k: i64): f64 {
    if re == 100 {
        let t: Vec<f64> = [1.00000, 0.84123, 0.78871, 0.73722, 0.68717, 0.23151, 0.00332, -0.13641, -0.20581, -0.21090, -0.15662, -0.10150, -0.06434, -0.04775, -0.04192, -0.03717, 0.00000]
        return t[k]
    }
    if re == 400 {
        let t: Vec<f64> = [1.00000, 0.75837, 0.68439, 0.61756, 0.55892, 0.29093, 0.16256, 0.02135, -0.11477, -0.17119, -0.32726, -0.24299, -0.14612, -0.10338, -0.09266, -0.08186, 0.00000]
        return t[k]
    }
    let t: Vec<f64> = [1.00000, 0.65928, 0.57492, 0.51117, 0.46604, 0.33304, 0.18719, 0.05702, -0.06080, -0.10648, -0.27805, -0.38289, -0.29730, -0.22220, -0.20196, -0.18109, 0.00000]
    return t[k]
}

pub fn ghiaX(k: i64): f64 {
    let t: Vec<f64> = [1.0000, 0.9688, 0.9609, 0.9531, 0.9453, 0.9063, 0.8594, 0.8047, 0.5000, 0.2344, 0.2266, 0.1563, 0.0938, 0.0781, 0.0703, 0.0625, 0.0000]
    return t[k]
}

pub fn ghiaV(re: i64, k: i64): f64 {
    if re == 100 {
        let t: Vec<f64> = [0.00000, -0.05906, -0.07391, -0.08864, -0.10313, -0.16914, -0.22445, -0.24533, 0.05454, 0.17527, 0.17507, 0.16077, 0.12317, 0.10890, 0.10091, 0.09233, 0.00000]
        return t[k]
    }
    if re == 400 {
        let t: Vec<f64> = [0.00000, -0.12146, -0.15663, -0.19254, -0.22847, -0.23827, -0.44993, -0.38598, 0.05186, 0.30174, 0.30203, 0.28124, 0.22965, 0.20920, 0.19713, 0.18360, 0.00000]
        return t[k]
    }
    let t: Vec<f64> = [0.00000, -0.21388, -0.27669, -0.33714, -0.39188, -0.51500, -0.42665, -0.31966, 0.02526, 0.32235, 0.33075, 0.37095, 0.32627, 0.30353, 0.29012, 0.27485, 0.00000]
    return t[k]
}

// Points excluded from the error metric, and why:
//
//  k=0 and k=16 are the walls themselves. There the tabulated value IS the imposed
//  boundary condition (0 at a static wall, 1 at the lid), so comparing against it
//  would be measuring our own input back and would flatter the result.
//
//  (Re=400, x=0.9063, v=-0.23827) in Table II is a known bad entry: its neighbours
//  run -0.22847 at x=0.9453 and -0.44993 at x=0.8594, so a monotone profile wants
//  roughly -0.33 there. The value also survives into most republications of the
//  table unchanged. Excluded rather than silently inflating our reported error.
pub fn skipU(k: i64): bool {
    return k == 0 || k == 16
}

pub fn skipV(re: i64, k: i64): bool {
    if k == 0 || k == 16 {
        return true
    }
    return re == 400 && k == 5
}

pub struct CavityResult {
    re: i64
    n: i64
    iters: i64
    maxErrU: f64
    maxErrV: f64
    rmsErr: f64
    converged: bool
}

// Drive the cavity to steady state and score it against Ghia.
pub fn runCavity(re: i64, n: i64, tolSteady: f64, maxIters: i64, verbose: bool): CavityResult {
    let uLid = 0.1
    let tau = lbmTau(re as f64, uLid, n as f64)

    var f: Vec<f64> = Vec.new()
    var g: Vec<f64> = Vec.new()
    lbmInit(&mut f, n, n)
    lbmInit(&mut g, n, n)

    var solid: Vec<bool> = Vec.new()
    var interior: Vec<bool> = Vec.new()
    var rho: Vec<f64> = Vec.new()
    var ux: Vec<f64> = Vec.new()
    var uy: Vec<f64> = Vec.new()
    var pux: Vec<f64> = Vec.new()
    var puy: Vec<f64> = Vec.new()
    var c = 0
    while c < n * n {
        solid.push(false)
        interior.push(false)
        rho.push(1.0)
        ux.push(0.0)
        uy.push(0.0)
        pux.push(0.0)
        puy.push(0.0)
        c += 1
    }

    // Force accumulator, unused here: the cavity has no immersed obstacle, so this
    // stays zero. It exists only to satisfy lbmStep, which the wind tunnel shares.
    var fw: Vec<f64> = [0.0, 0.0]
    lbmBuildInterior(solid, n, n, &mut interior)

    // Steady state is detected on the velocity field, so it is only worth sampling
    // every `checkEvery` steps — the residual moves far slower than one lattice step.
    let checkEvery: i64 = 500
    var iters: i64 = 0
    var converged = false
    while iters < maxIters {
        // Two half-steps per pass keeps the ping-pong buffers in phase without
        // ever moving a Vec out of a slot: f -> g, then g -> f.
        lbmStep(f, &mut g, solid, interior, n, n, tau, uLid, false, &mut fw)
        lbmStep(g, &mut f, solid, interior, n, n, tau, uLid, false, &mut fw)
        iters += 2

        if iters % checkEvery == 0 {
            lbmMacro(f, solid, n, n, &mut rho, &mut ux, &mut uy)
            let delta = lbmMaxDelta(ux, uy, pux, puy, uLid)
            var i = 0
            while i < n * n {
                pux[i] = ux[i]
                puy[i] = uy[i]
                i += 1
            }
            if verbose {
                print($"    iter {iters}  residual {formatFloat(delta, 8)}")
            }
            // The first sample has nothing to compare against, so never trust it.
            if delta < tolSteady && iters > checkEvery {
                converged = true
                break
            }
        }
    }

    lbmMacro(f, solid, n, n, &mut rho, &mut ux, &mut uy)

    var maxErrU = 0.0
    var maxErrV = 0.0
    var sumSq = 0.0
    var count = 0

    if verbose {
        print("      y        u(ghia)     u(milo)     err")
    }
    var k = 0
    while k < 17 {
        if !skipU(k) {
            let got = lbmSample(ux, n, n, 0.5, ghiaY(k)) / uLid
            let want = ghiaU(re, k)
            let e = Math.abs(got - want)
            if e > maxErrU {
                maxErrU = e
            }
            sumSq = sumSq + e * e
            count += 1
            if verbose {
                print($"   {formatFloat(ghiaY(k), 4)}   {formatFloat(want, 5)}   {formatFloat(got, 5)}   {formatFloat(e, 5)}")
            }
        }
        k += 1
    }

    if verbose {
        print("      x        v(ghia)     v(milo)     err")
    }
    k = 0
    while k < 17 {
        if !skipV(re, k) {
            let got = lbmSample(uy, n, n, ghiaX(k), 0.5) / uLid
            let want = ghiaV(re, k)
            let e = Math.abs(got - want)
            if e > maxErrV {
                maxErrV = e
            }
            sumSq = sumSq + e * e
            count += 1
            if verbose {
                print($"   {formatFloat(ghiaX(k), 4)}   {formatFloat(want, 5)}   {formatFloat(got, 5)}   {formatFloat(e, 5)}")
            }
        }
        k += 1
    }

    let rms = Math.sqrt(sumSq / (count as f64))
    return CavityResult {
        re: re, n: n, iters: iters, maxErrU: maxErrU, maxErrV: maxErrV, rmsErr: rms, converged: converged
    }
}

// Regression ceiling on the worst centreline error, per Reynolds number, at the
// grid each mode uses. These are not physics constants — they are the measured
// errors (0.0055 / 0.0082 / 0.0121 at 128^2) rounded up for headroom. Accuracy
// degrades with Re because tau falls toward the 0.5 stability floor and the wall
// boundary layer thins faster than the grid resolves it, so the ceiling widens
// with Re on purpose. Tighten them if the solver improves.
pub fn tolerance(re: i64): f64 {
    if re == 100 {
        return 0.010
    }
    if re == 400 {
        return 0.015
    }
    return 0.020
}

pub fn main(): i32 {
    let argv = args()

    // Default is the quick gate: one Reynolds number on a coarse grid, ~2s, still a
    // real comparison against the published table. `full` is the paper-grade sweep
    // and takes minutes — too slow for the examples harness, which caps at 60s.
    var reList: Vec<i64> = [100]
    var n: i64 = 64
    var verbose = false

    if argv.len() > 1 && argv[1] == "full" {
        reList = [100, 400, 1000]
        n = 128
    } else {
        if argv.len() > 1 {
            reList = [parseInt(argv[1]) ?? 100]
            n = 128
            verbose = true
        }
        if argv.len() > 2 {
            n = parseInt(argv[2]) ?? 128
        }
    }

    print("lid-driven cavity vs Ghia, Ghia & Shin 1982")
    print($"grid {n}x{n}, D2Q9 BGK, lid velocity 0.1 (lattice units)")
    print("")

    var worst = 0.0
    var failed = false
    var r = 0
    while r < reList.len() {
        let re = reList[r]
        let tau = lbmTau(re as f64, 0.1, n as f64)
        print($"Re = {re}   tau = {formatFloat(tau, 4)}")
        if tau <= 0.51 {
            print($"  WARNING: tau {formatFloat(tau, 4)} is near the 0.5 stability floor — raise the grid size")
        }
        let res = runCavity(re, n, 0.000001, 4000000, verbose)
        if !res.converged {
            print($"  FAIL: did NOT reach steady state in {res.iters} iterations")
            failed = true
        }
        var e = res.maxErrU
        if res.maxErrV > e {
            e = res.maxErrV
        }
        let tol = tolerance(re)
        var verdict = "ok"
        if e > tol {
            verdict = "FAIL"
            failed = true
        }
        print($"  iterations {res.iters}   max|du| {formatFloat(res.maxErrU, 4)}   max|dv| {formatFloat(res.maxErrV, 4)}   rms {formatFloat(res.rmsErr, 4)}   tol {formatFloat(tol, 3)}  {verdict}")
        print("")
        if e > worst {
            worst = e
        }
        r += 1
    }

    print($"worst centreline error across all Re: {formatFloat(worst, 4)}")
    if failed {
        print("FAIL")
        return 1
    }
    print("PASS — solver reproduces Ghia et al. 1982 within tolerance")
    return 0
}
