// Real-time 2D wind tunnel — D2Q9 lattice-Boltzmann flow past a cylinder or a
// NACA 4-digit airfoil, with live drag and lift read off the surface by momentum
// exchange. Pure CPU, 60fps, no GPU.
//
// The solver behind this (lbm.milo) is the same one validated against the Ghia,
// Ghia & Shin 1982 lid-driven cavity table by cavity.milo — run that first if you
// want the numbers before the pictures.
//
// Controls:
//   1 / 2 / 3    cylinder / NACA airfoil / car
//   UP / DOWN    angle of attack -+ (airfoil, car rake)
//   LEFT/RIGHT   Reynolds number -+
//   V            cycle view: vorticity / speed / pressure
//   SPACE        pause      R  reset flow      ESC  quit
//
// Build/run (SDL2 auto-linked via @link — no -- flags needed):
//   milo run examples/simulation/windtunnel/windtunnel.milo --release
//
// -O3 matters: the debug build will not hold 60fps.

from "std/math" import {
    Math
}
from "std/strconv" import {
    formatFloat
}
from "./lbm" import {
    lbmInit, lbmStep, lbmMacro, lbmInlet, lbmOutlet, lbmVorticity, lbmTau, lbmBuildInterior
}

@link("SDL2")
pub extern fn SDL_Init(flags: u32): i32

pub extern fn SDL_CreateWindow(title: *u8, x: i32, y: i32, w: i32, h: i32, flags: u32): *u8

pub extern fn SDL_CreateRenderer(win: *u8, index: i32, flags: u32): *u8

pub extern fn SDL_CreateTexture(ren: *u8, format: u32, access: i32, w: i32, h: i32): *u8

pub extern fn SDL_UpdateTexture(tex: *u8, rect: *u8, pixels: *u8, pitch: i32): i32

pub extern fn SDL_RenderClear(ren: *u8): i32

pub extern fn SDL_RenderCopy(ren: *u8, tex: *u8, src: *u8, dst: *u8): i32

pub extern fn SDL_RenderPresent(ren: *u8): void

pub extern fn SDL_PollEvent(event: *u8): i32

pub extern fn SDL_GetKeyboardState(numkeys: *i32): *u8

pub extern fn SDL_GetTicks(): u32

pub extern fn SDL_Delay(ms: u32): void

pub extern fn SDL_DestroyWindow(win: *u8): void

pub extern fn SDL_Quit(): void

pub let SDL_INIT_VIDEO: u32 = 0x20

pub let SDL_WINDOWPOS_CENTERED: i32 = 0x2FFF0000

pub let SDL_WINDOW_SHOWN: u32 = 0x4

pub let SDL_TEXTUREACCESS_STREAMING: i32 = 1

pub let SDL_PIXELFORMAT_ABGR8888: u32 = 0x16762004

pub let SDL_QUIT: u32 = 0x100

// Tunnel geometry in lattice units. The obstacle sits one quarter along so there is
// a long wake to watch. NY is chosen so the obstacle blocks ~12% of the channel:
// enough headroom that the walls do not dominate, small enough to stay real-time.
pub let NX: i64 = 700

pub let NY: i64 = 260

pub let SCALE: i64 = 2

// Inflow speed in lattice units. Must stay well under the lattice sound speed
// 1/sqrt(3); 0.08 keeps the weakly-compressible error small while still advecting
// the wake across the screen fast enough to look alive.
pub let U_IN: f64 = 0.08

// Characteristic length for the Reynolds number: cylinder diameter / airfoil chord.
pub let D_CHAR: f64 = 34.0

pub let SHAPE_CYLINDER: i64 = 0

pub let SHAPE_AIRFOIL: i64 = 1

pub let SHAPE_CAR: i64 = 2

pub let VIEW_VORTICITY: i64 = 0

pub let VIEW_SPEED: i64 = 1

pub let VIEW_PRESSURE: i64 = 2

// --- geometry -----------------------------------------------------------------

// NACA 4-digit half-thickness at chord fraction xc, for thickness ratio t (0.12 for
// a NACA 0012). The standard polynomial; the trailing edge is left open by the
// -0.1015 term, which is harmless on a lattice this coarse.
pub fn nacaThickness(xc: f64, t: f64): f64 {
    if xc < 0.0 || xc > 1.0 {
        return 0.0
    }
    return 5.0 * t * (0.2969 * Math.sqrt(xc) - 0.1260 * xc - 0.3516 * xc * xc + 0.2843 * xc * xc * xc - 0.1015 * xc * xc * xc * xc)
}

// Rebuild the obstacle mask. Lattice y points up, x points downstream; the airfoil
// pivots about its quarter-chord, which is the conventional aerodynamic reference
// point and keeps the shape from wandering as the angle of attack changes.
pub fn buildSolid(solid: &mut Vec<bool>, shape: i64, aoaDeg: f64) {
    let cxo = (NX as f64) * 0.28
    let cyo = (NY as f64) * 0.5
    let a = aoaDeg * Math.pi() / 180.0
    let ca = Math.cos(a)
    let sa = Math.sin(a)
    let chord = D_CHAR * 2.2
    let radius = D_CHAR * 0.5

    var y = 0
    while y < NY {
        var x = 0
        while x < NX {
            let c = y * NX + x
            var hit = false
            let dx = (x as f64) - cxo
            let dy = (y as f64) - cyo

            if shape == SHAPE_CYLINDER {
                hit = dx * dx + dy * dy <= radius * radius
            } else if shape == SHAPE_CAR {
                let len = D_CHAR * 3.2
                hit = carHit(dx, dy + len * 0.10, len)
            } else {
                // Into the airfoil's own frame: undo the angle of attack.
                let xr = dx * ca + dy * sa
                let yr = 0.0 - dx * sa + dy * ca
                let xc = xr / chord + 0.25
                if xc >= 0.0 && xc <= 1.0 {
                    let half = nacaThickness(xc, 0.12) * chord
                    hit = Math.abs(yr) <= half
                }
            }
            solid[c] = hit
            x = x + 1
        }
        y = y + 1
    }
}

// Car silhouette, as an upper-surface height profile over the normalised length
// xc in [0,1] plus two wheels. Heights are fractions of the overall length, which
// is roughly how real side profiles scale. This is a bluff body: unlike the
// airfoil it separates hard off the tail, so the wake is wide and unsteady.
pub fn carTop(xc: f64): f64 {
    if xc < 0.10 {
        return 0.16 * Math.sqrt(xc / 0.10)
    }
    if xc < 0.30 {
        return 0.16 + 0.04 * (xc - 0.10) / 0.20
    }
    if xc < 0.42 {
        return 0.20 + 0.18 * (xc - 0.30) / 0.12
    }
    if xc < 0.68 {
        return 0.38
    }
    if xc < 0.88 {
        return 0.38 - 0.16 * (xc - 0.68) / 0.20
    }
    let e = (xc - 0.88) / 0.12
    return 0.22 - 0.22 * e * e
}

pub fn carHit(xr: f64, yr: f64, len: f64): bool {
    let xc = xr / len + 0.5
    let yc = yr / len
    if xc >= 0.0 && xc <= 1.0 {
        if yc >= 0.06 && yc <= carTop(xc) {
            return true
        }
    }
    // Wheels, drawn proud of the floor line so the ground clearance gap is open
    // and the underbody flow is visible.
    let r = 0.075
    let w1x = xc - 0.24
    let w1y = yc - 0.075
    if w1x * w1x + w1y * w1y <= r * r {
        return true
    }
    let w2x = xc - 0.78
    let w2y = yc - 0.075
    if w2x * w2x + w2y * w2y <= r * r {
        return true
    }
    return false
}

// --- colour -------------------------------------------------------------------

pub fn clamp01(v: f64): f64 {
    if v < 0.0 {
        return 0.0
    }
    if v > 1.0 {
        return 1.0
    }
    return v
}

pub fn rgb(r: f64, g: f64, b: f64): u32 {
    let ri = (clamp01(r) * 255.0) as u32
    let gi = (clamp01(g) * 255.0) as u32
    let bi = (clamp01(b) * 255.0) as u32
    return ri | (gi << 8) | (bi << 16) | (0xFF << 24)
}

// Diverging map for signed fields: counter-clockwise vorticity warm, clockwise
// cool, near-zero near-black so the wake structure reads against the background.
pub fn diverging(t: f64): u32 {
    let v = clamp01(Math.abs(t))
    if t >= 0.0 {
        return rgb(0.06 + 0.94 * v, 0.06 + 0.38 * v * v, 0.10 + 0.05 * v)
    }
    return rgb(0.05 + 0.10 * v, 0.07 + 0.45 * v * v, 0.12 + 0.88 * v)
}

// Sequential map for unsigned fields (speed, pressure): black -> teal -> white.
pub fn sequential(t: f64): u32 {
    let v = clamp01(t)
    return rgb(v * v * 1.15, 0.25 * v + 0.75 * v * v * v, 0.55 * v + 0.45 * v * v)
}

// --- HUD ----------------------------------------------------------------------

// 3x5 bitmap font: digits, A-Z, and the punctuation the readouts need. Each glyph
// row is a 3-bit pattern, bit 2 leftmost.
pub fn glyphRow(ch: u8, row: i64): i64 {
    let digits: [i64; 50] = [7, 5, 5, 5, 7, 2, 2, 2, 2, 2, 7, 1, 7, 4, 7, 7, 1, 7, 1, 7, 5, 5, 7, 1, 1, 7, 4, 7, 1, 7, 7, 4, 7, 5, 7, 7, 1, 1, 1, 1, 7, 5, 7, 5, 7, 7, 5, 7, 1, 7,]
    let letters: [i64; 130] = [2, 5, 7, 5, 5, 6, 5, 6, 5, 6, 3, 4, 4, 4, 3, 6, 5, 5, 5, 6, 7, 4, 6, 4, 7, // A B C D E
    7, 4, 6, 4, 4, 3, 4, 5, 5, 3, 5, 5, 7, 5, 5, 7, 2, 2, 2, 7, 1, 1, 1, 5, 2, // F G H I J
    5, 6, 4, 6, 5, 4, 4, 4, 4, 7, 5, 7, 7, 5, 5, 5, 7, 7, 7, 5, 2, 5, 5, 5, 2, // K L M N O
    6, 5, 6, 4, 4, 2, 5, 5, 6, 3, 6, 5, 6, 5, 5, 3, 4, 2, 1, 6, 7, 2, 2, 2, 2, // P Q R S T
    5, 5, 5, 5, 7, 5, 5, 5, 5, 2, 5, 5, 7, 7, 5, 5, 5, 2, 5, 5, 5, 5, 2, 2, 2, // U V W X Y
    7, 1, 2, 4, 7, // Z
    ]
    let punct: [i64; 20] = [0, 0, 0, 0, 2, // .
    0, 0, 7, 0, 0, // -
    0, 2, 0, 2, 0, // :
    1, 1, 2, 4, 4, // /
    ]
    let c = ch as i64
    if c >= 48 && c <= 57 {
        return digits[(c - 48) * 5 + row]
    }
    if c >= 65 && c <= 90 {
        return letters[(c - 65) * 5 + row]
    }
    if c >= 97 && c <= 122 {
        return letters[(c - 97) * 5 + row]
    }
    if c == 46 {
        return punct[row]
    }
    if c == 45 {
        return punct[5 + row]
    }
    if c == 58 {
        return punct[10 + row]
    }
    if c == 47 {
        return punct[15 + row]
    }
    return 0
}

pub fn drawChar(fb: &mut Vec<u32>, x0: i64, y0: i64, ch: u8, scale: i64, col: u32) {
    var row = 0
    while row < 5 {
        let pat = glyphRow(ch, row)
        var cc = 0
        while cc < 3 {
            if (pat & (1 << (2 - cc))) != 0 {
                var yy = 0
                while yy < scale {
                    var xx = 0
                    while xx < scale {
                        let px = x0 + cc * scale + xx
                        let py = y0 + row * scale + yy
                        if px >= 0 && px < NX && py >= 0 && py < NY {
                            fb[py * NX + px] = col
                        }
                        xx = xx + 1
                    }
                    yy = yy + 1
                }
            }
            cc = cc + 1
        }
        row = row + 1
    }
}

pub fn drawText(fb: &mut Vec<u32>, x0: i64, y0: i64, s: string, scale: i64, col: u32) {
    var cx = x0
    var i = 0
    while i < s.len {
        drawChar(&mut fb, cx, y0, s[i], scale, col)
        cx = cx + 4 * scale
        i = i + 1
    }
}

pub fn main(): i32 {
    if SDL_Init(SDL_INIT_VIDEO) != 0 {
        print("SDL_Init failed")
        return 1
    }

    var win: *u8 = 0 as *u8
    var ren: *u8 = 0 as *u8
    var tex: *u8 = 0 as *u8
    var ok = true
    unsafe {
        let title = "Milo — lattice-Boltzmann wind tunnel"
        win = SDL_CreateWindow(title, SDL_WINDOWPOS_CENTERED, SDL_WINDOWPOS_CENTERED, (NX * SCALE) as i32, (NY * SCALE) as i32, SDL_WINDOW_SHOWN)
        ren = SDL_CreateRenderer(win, -1, 0)
        tex = SDL_CreateTexture(ren, SDL_PIXELFORMAT_ABGR8888, SDL_TEXTUREACCESS_STREAMING, NX as i32, NY as i32)
        if (win as i64) == 0 || (ren as i64) == 0 || (tex as i64) == 0 {
            ok = false
        }
    }
    if !ok {
        print("SDL setup failed: win/ren/tex NULL")
        return 2
    }

    var f: Vec<f64> = Vec.new()
    var g: Vec<f64> = Vec.new()
    lbmInit(&mut f, NX, NY)
    lbmInit(&mut g, NX, NY)

    var solid: Vec<bool> = Vec.new()
    var interior: Vec<bool> = Vec.new()
    var rho: Vec<f64> = Vec.new()
    var ux: Vec<f64> = Vec.new()
    var uy: Vec<f64> = Vec.new()
    var vort: Vec<f64> = Vec.new()
    var fb: Vec<u32> = Vec.new()
    var c = 0
    while c < NX * NY {
        solid.push(false)
        interior.push(false)
        rho.push(1.0)
        ux.push(0.0)
        uy.push(0.0)
        vort.push(0.0)
        fb.push(0)
        c = c + 1
    }
    var force: Vec<f64> = [0.0, 0.0]

    var shape = SHAPE_CYLINDER
    var view = VIEW_VORTICITY
    var aoa = 0.0
    var re = 150.0
    buildSolid(&mut solid, shape, aoa)
    lbmBuildInterior(solid, NX, NY, &mut interior)
    lbmBuildInterior(solid, NX, NY, &mut interior)

    var paused = false
    var quit = false
    var ev: [u8; 64] = [0; 64]
    var lastTicks = SDL_GetTicks()
    var fpsAvg = 0.0

    // Edge-detect latches: SDL_GetKeyboardState reports level, not transition, so
    // without these a single tap would fire on every frame it is held.
    var prevKeys: Vec<bool> = [false, false, false, false, false, false, false]

    // Smoothed coefficients — the raw per-step momentum exchange is noisy at this
    // resolution, and an unfiltered number is unreadable on screen.
    var cdS = 0.0
    var clS = 0.0

    // Strouhal measurement. St = f*D/U, read off the lift signal: successive
    // upward zero crossings of Cl are one shedding period apart. Averaged over
    // however many periods have been seen since the last reset.
    var step: i64 = 0
    var prevCl = 0.0
    var lastCross: i64 = 0
    var stSum = 0.0
    var stCount: i64 = 0

    while !quit {
        var wantReset = false
        unsafe {
            while SDL_PollEvent(ev) != 0 {
                let evType: u32 = (ev[0] as u32) | ((ev[1] as u32) << 8) | ((ev[2] as u32) << 16) | ((ev[3] as u32) << 24)
                if evType == SDL_QUIT {
                    quit = true
                }
            }
            let ks = SDL_GetKeyboardState(0 as *i32)
            if ks[41] != 0 {
                quit = true
            }
            // SPACE 44, R 21, V 25, 1 30, 2 31, RIGHT 79, LEFT 80, DOWN 81, UP 82
            let kSpace = ks[44] != 0
            if kSpace && !prevKeys[0] {
                paused = !paused
            }
            prevKeys[0] = kSpace

            let kR = ks[21] != 0
            if kR && !prevKeys[1] {
                wantReset = true
            }
            prevKeys[1] = kR

            let kV = ks[25] != 0
            if kV && !prevKeys[2] {
                view = (view + 1) % 3
            }
            prevKeys[2] = kV

            let k1 = ks[30] != 0
            if k1 && !prevKeys[3] && shape != SHAPE_CYLINDER {
                shape = SHAPE_CYLINDER
                buildSolid(&mut solid, shape, aoa)
                lbmBuildInterior(solid, NX, NY, &mut interior)
                wantReset = true
            }
            prevKeys[3] = k1

            let k2 = ks[31] != 0
            if k2 && !prevKeys[4] && shape != SHAPE_AIRFOIL {
                shape = SHAPE_AIRFOIL
                buildSolid(&mut solid, shape, aoa)
                lbmBuildInterior(solid, NX, NY, &mut interior)
                wantReset = true
            }
            prevKeys[4] = k2

            let k3 = ks[32] != 0
            if k3 && !prevKeys[5] && shape != SHAPE_CAR {
                shape = SHAPE_CAR
                buildSolid(&mut solid, shape, aoa)
                lbmBuildInterior(solid, NX, NY, &mut interior)
                wantReset = true
            }
            prevKeys[5] = k3

            // Angle of attack and Reynolds are held, not tapped — they ramp.
            if ks[82] != 0 && shape != SHAPE_CYLINDER {
                aoa = aoa + 0.4
                if aoa > 30.0 {
                    aoa = 30.0
                }
                buildSolid(&mut solid, shape, aoa)
                lbmBuildInterior(solid, NX, NY, &mut interior)
            }
            if ks[81] != 0 && shape != SHAPE_CYLINDER {
                aoa = aoa - 0.4
                if aoa < -30.0 {
                    aoa = -30.0
                }
                buildSolid(&mut solid, shape, aoa)
                lbmBuildInterior(solid, NX, NY, &mut interior)
            }
            if ks[79] != 0 {
                re = re * 1.02
                if re > 3000.0 {
                    re = 3000.0
                }
            }
            if ks[80] != 0 {
                re = re / 1.02
                if re < 20.0 {
                    re = 20.0
                }
            }
        }

        if wantReset {
            lbmInit(&mut f, NX, NY)
            lbmInit(&mut g, NX, NY)
            cdS = 0.0
            clS = 0.0
            step = 0
            stCount = 0
            stSum = 0.0
            lastCross = 0
            prevCl = 0.0
        }

        var tau = lbmTau(re, U_IN, D_CHAR)
        // Below ~0.51 the BGK scheme goes unstable and the screen fills with NaN.
        // Clamping trades the requested Reynolds number for staying alive, which is
        // the right call in an interactive demo; the HUD shows the tau actually used.
        if tau < 0.51 {
            tau = 0.51
        }

        if !paused {
            var s = 0
            while s < 5 {
                // Kick the inlet sideways briefly at startup. A perfectly symmetric
                // lattice can sit on the unstable steady wake for tens of thousands
                // of steps before round-off breaks the tie; this makes the shedding
                // start in about a second instead, without changing where it lands.
                var vIn = 0.0
                if step > 200 && step < 500 {
                    vIn = 0.06 * U_IN
                }

                lbmStep(f, &mut g, solid, interior, NX, NY, tau, 0.0, true, &mut force)
                lbmInlet(&mut g, NX, NY, U_IN, vIn)
                lbmOutlet(&mut g, NX, NY)
                lbmStep(g, &mut f, solid, interior, NX, NY, tau, 0.0, true, &mut force)
                lbmInlet(&mut f, NX, NY, U_IN, vIn)
                lbmOutlet(&mut f, NX, NY)
                step = step + 2

                // Momentum-exchange force -> coefficients. Reference area in 2D is
                // just the characteristic length, and rho ~ 1 in lattice units.
                let q = 0.5 * U_IN * U_IN * D_CHAR
                cdS = cdS * 0.99 + 0.01 * (force[0] / q)
                clS = clS * 0.99 + 0.01 * (force[1] / q)

                // Ignore the startup transient: the perturbation itself would
                // otherwise register as a spurious first "period".
                if step > 3000 && prevCl <= 0.0 && clS > 0.0 {
                    if lastCross > 0 {
                        let period = (step - lastCross) as f64
                        stSum = stSum + D_CHAR / (period * U_IN)
                        stCount = stCount + 1
                    }
                    lastCross = step
                }
                prevCl = clS
                s = s + 1
            }
        }

        lbmMacro(f, solid, NX, NY, &mut rho, &mut ux, &mut uy)
        lbmVorticity(ux, uy, solid, NX, NY, &mut vort)

        // Render. Lattice y is up, framebuffer row 0 is the top, so flip.
        let vScale = 12.0 / D_CHAR
        var y = 0
        while y < NY {
            var x = 0
            while x < NX {
                let cell = y * NX + x
                let dst = (NY - 1 - y) * NX + x
                if solid[cell] {
                    fb[dst] = rgb(0.85, 0.85, 0.88)
                } else {
                    if view == VIEW_VORTICITY {
                        fb[dst] = diverging(vort[cell] / (U_IN * vScale))
                    } else {
                        if view == VIEW_SPEED {
                            let sp = Math.sqrt(ux[cell] * ux[cell] + uy[cell] * uy[cell])
                            fb[dst] = sequential(sp / (U_IN * 1.8))
                        } else {
                            fb[dst] = sequential(0.5 + (rho[cell] - 1.0) * 12.0)
                        }
                    }
                }
                x = x + 1
            }
            y = y + 1
        }

        let now = SDL_GetTicks()
        var dtMs = (now - lastTicks) as f64
        lastTicks = now
        if dtMs < 1.0 {
            dtMs = 1.0
        }
        fpsAvg = fpsAvg * 0.9 + 0.1 * (1000.0 / dtMs)

        var shapeName = "cylinder"
        if shape == SHAPE_AIRFOIL {
            shapeName = "naca 0012"
        }
        if shape == SHAPE_CAR {
            shapeName = "car"
        }
        var viewName = "vorticity"
        if view == VIEW_SPEED {
            viewName = "speed"
        }
        if view == VIEW_PRESSURE {
            viewName = "pressure"
        }
        drawText(&mut fb, 4, 4, shapeName, 2, rgb(1.0, 1.0, 1.0))
        drawText(&mut fb, 4, 18, $"re {formatFloat(re, 0)}  tau {formatFloat(tau, 3)}", 2, rgb(0.75, 0.85, 0.95))
        drawText(&mut fb, 4, 32, $"cd {formatFloat(cdS, 3)}  cl {formatFloat(clS, 3)}", 2, rgb(0.95, 0.85, 0.6))
        if shape != SHAPE_CYLINDER {
            drawText(&mut fb, 4, 46, $"aoa {formatFloat(aoa, 1)}", 2, rgb(0.95, 0.85, 0.6))
        }
        // Strouhal only means something once the wake is periodic, so show it only
        // after at least two full shedding cycles have been timed.
        if stCount > 1 {
            let st = stSum / (stCount as f64)
            drawText(&mut fb, 4, 60, $"st {formatFloat(st, 3)}", 2, rgb(0.7, 0.95, 0.75))
        }
        drawText(&mut fb, 4, NY - 16, $"{viewName}  fps {formatFloat(fpsAvg, 0)}  1 cyl 2 foil 3 car", 2, rgb(0.55, 0.55, 0.6))
        if paused {
            drawText(&mut fb, NX - 60, 4, "paused", 2, rgb(1.0, 0.5, 0.4))
        }

        unsafe {
            SDL_UpdateTexture(tex, 0 as *u8, fb[0].addrOf() as *u8, (NX * 4) as i32)
            SDL_RenderClear(ren)
            SDL_RenderCopy(ren, tex, 0 as *u8, 0 as *u8)
            SDL_RenderPresent(ren)
        }
        SDL_Delay(1)
    }

    SDL_DestroyWindow(win)
    SDL_Quit()
    return 0
}
