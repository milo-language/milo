// tetris — event-driven terminal Tetris, no polling.
//
// The whole game is one green task that parks on a Select with two arms:
//   arm 0  onRead(0)      — stdin became readable (a keypress)
//   arm 1  onTimeout(ms)  — gravity deadline reached
// The task sleeps in the scheduler until one fires; there is no busy loop and
// no sleepMs. Gravity uses an ABSOLUTE deadline (nextDrop) so that input events
// waking the task early never reset the fall clock.
//
// Build and run:
//   bun run src/main.ts run examples/terminal/tetris.milo
//   milo build examples/terminal/tetris.milo -o tetris && ./tetris

from "std/term" import {
    enableRawMode, restoreTerminal, readKey,
    KEY_NONE, KEY_UP, KEY_DOWN, KEY_LEFT, KEY_RIGHT, KEY_QUIT, KEY_SPACE
}
from "std/io" import {
    writeStdout
}
from "std/time" import {
    epochMillis
}
from "std/random" import {
    Random
}
from "std/runtime" import {
    Task
}
from "std/select" import {
    Select
}
from "std/ansi" import {
    Ansi
}
from "std/color" import {
    Color
}

pub let W: i64 = 10

pub let H: i64 = 20

// the well, row-major, W*H cells
pub type Board = [i32; 200]

// tetromino kinds
pub let KIND_I: i64 = 0

pub let KIND_O: i64 = 1

pub let KIND_T: i64 = 2

pub let KIND_S: i64 = 3

pub let KIND_Z: i64 = 4

pub let KIND_J: i64 = 5

pub let KIND_L: i64 = 6

pub let NUM_KINDS: i64 = 7

// column a fresh piece spawns at (top of the well)
pub let SPAWN_X: i64 = 3

// Select arm indices — the two events the game task parks on. Order matches the
// arm order in the loop: onRead(0) is armed first, onTimeout second.
pub let ARM_KEY: i64 = 0

pub let ARM_TICK: i64 = 1

// ── buffer helpers (single writeStdout per frame → no flicker) ──

pub fn emit(buf: &mut string, s: &string): void {
    for i in 0..s.len {
        buf.push(s[i])
    }
}

pub fn cursor(buf: &mut string, row: i64, col: i64): void {
    emit(&mut buf, Ansi.cursorTo(row, col))
}

// a solid 2-wide cell in the piece's color
pub fn blockStr(code: i64): string {
    return Ansi.fg256(code) + "██" + Ansi.reset()
}

// ── tetromino geometry ──
//
// Each piece is 4 cells in an NxN box; rotation is (x,y) -> (N-1-y, x) applied
// `rot` times, which is exact on the integer grid for every piece (O maps onto
// itself). N is 4 for I, 2 for O, 3 for the rest.
pub fn pieceN(kind: i64): i64 {
    if kind == KIND_I {
        return 4
    }
    if kind == KIND_O {
        return 2
    }
    return 3
}

// distinct rotation states: O looks the same in all 4, so it has just 1
pub fn pieceRots(kind: i64): i64 {
    if kind == KIND_O {
        return 1
    }
    return 4
}

// xterm-256 color per piece (classic Tetris palette)
pub fn pieceColor(kind: i64): i64 {
    if kind == KIND_I {
        return 51
    }
    if kind == KIND_O {
        return 226
    }
    if kind == KIND_T {
        return 201
    }
    if kind == KIND_S {
        return 46
    }
    if kind == KIND_Z {
        return 196
    }
    if kind == KIND_J {
        return 33
    }
    return 208
}

pub fn setCells(out: &mut [i64; 8], a: i64, b: i64, c: i64, d: i64, e: i64, f: i64, g: i64, h: i64): void {
    out[0] = a
    out[1] = b
    out[2] = c
    out[3] = d
    out[4] = e
    out[5] = f
    out[6] = g
    out[7] = h
}

// spawn-state cells (x,y pairs) within the piece's NxN box
pub fn spawnCells(kind: i64, out: &mut [i64; 8]): void {
    if kind == KIND_I {
        setCells(&mut out, 0, 1, 1, 1, 2, 1, 3, 1)
    } else if kind == KIND_O {
        setCells(&mut out, 0, 0, 1, 0, 0, 1, 1, 1)
    } else if kind == KIND_T {
        setCells(&mut out, 1, 0, 0, 1, 1, 1, 2, 1)
    } else if kind == KIND_S {
        setCells(&mut out, 1, 0, 2, 0, 0, 1, 1, 1)
    } else if kind == KIND_Z {
        setCells(&mut out, 0, 0, 1, 0, 1, 1, 2, 1)
    } else if kind == KIND_J {
        setCells(&mut out, 0, 0, 0, 1, 1, 1, 2, 1)
    } else {
        setCells(&mut out, 2, 0, 0, 1, 1, 1, 2, 1)
    }
}

pub fn pieceCells(kind: i64, rot: i64, out: &mut [i64; 8]): void {
    spawnCells(kind, &mut out)
    let n = pieceN(kind)
    var r: i64 = 0
    while r < rot {
        for i in 0..4 {
            let x = out[i * 2]
            let y = out[i * 2 + 1]
            out[i * 2] = n - 1 - y
            out[i * 2 + 1] = x
        }
        r += 1
    }
}

// true if piece at (px,py) is off-board or overlaps a settled cell
pub fn collides(board: &Board, kind: i64, rot: i64, px: i64, py: i64): bool {
    var cells: [i64; 8] = [0; 8]
    pieceCells(kind, rot, &mut cells)
    for i in 0..4 {
        let bx = px + cells[i * 2]
        let by = py + cells[i * 2 + 1]
        if bx < 0 || bx >= W || by >= H {
            return true
        }
        if by >= 0 && board[by * W + bx] != 0 {
            return true
        }
    }
    return false
}

pub fn lockPiece(board: &mut Board, kind: i64, rot: i64, px: i64, py: i64): void {
    var cells: [i64; 8] = [0; 8]
    pieceCells(kind, rot, &mut cells)
    let color = pieceColor(kind)
    for i in 0..4 {
        let bx = px + cells[i * 2]
        let by = py + cells[i * 2 + 1]
        if by >= 0 && by < H && bx >= 0 && bx < W {
            board[by * W + bx] = color as i32
        }
    }
}

// compact full rows downward; return count cleared
pub fn clearLines(board: &mut Board): i64 {
    var write: i64 = H - 1
    var read: i64 = H - 1
    var cleared: i64 = 0
    while read >= 0 {
        var full = true
        for x in 0..W {
            if board[read * W + x] == 0 {
                full = false
            }
        }
        if full {
            cleared += 1
        } else {
            if write != read {
                for x in 0..W {
                    board[write * W + x] = board[read * W + x]
                }
            }
            write -= 1
        }
        read -= 1
    }
    // zero the rows above the compacted stack
    while write >= 0 {
        for x in 0..W {
            board[write * W + x] = 0 as i32
        }
        write -= 1
    }
    return cleared
}

pub fn scoreFor(n: i64): i64 {
    if n == 1 {
        return 100
    }
    if n == 2 {
        return 300
    }
    if n == 3 {
        return 500
    }
    if n >= 4 {
        return 800
    }
    return 0
}

// gravity interval shrinks as lines pile up
pub fn dropInterval(lines: i64): i64 {
    var ms = 600 - (lines / 10) * 70
    if ms < 120 {
        ms = 120
    }
    return ms
}

// ── rendering ──

pub fn renderNext(buf: &mut string, kind: i64, row: i64, col: i64): void {
    var cells: [i64; 8] = [0; 8]
    pieceCells(kind, 0, &mut cells)
    for ry in 0..2 {
        cursor(&mut buf, row + (ry as i64), col)
        for rx in 0..4 {
            var hit = false
            for i in 0..4 {
                if cells[i * 2] == (rx as i64) && cells[i * 2 + 1] == (ry as i64) {
                    hit = true
                }
            }
            if hit {
                emit(&mut buf, blockStr(pieceColor(kind)))
            } else {
                emit(&mut buf, "  ")
            }
        }
    }
}

pub fn render(buf: &mut string, board: &Board, kind: i64, rot: i64, px: i64, py: i64, score: i64, lines: i64, nextKind: i64): void {
    var cells: [i64; 8] = [0; 8]
    pieceCells(kind, rot, &mut cells)
    var pcx: [i64; 4] = [0; 4]
    var pcy: [i64; 4] = [0; 4]
    for i in 0..4 {
        pcx[i] = px + cells[i * 2]
        pcy[i] = py + cells[i * 2 + 1]
    }

    // top / bottom borders — build the run of box chars, then dim it once
    var top = "┌"
    var bottom = "└"
    for x in 0..W {
        top.pushStr("──")
        bottom.pushStr("──")
    }
    top += "┐"
    bottom += "┘"

    cursor(&mut buf, 1, 2)
    emit(&mut buf, Color.gray(top))

    let bar = Color.gray("│")
    for y in 0..H {
        cursor(&mut buf, 2 + y, 2)
        emit(&mut buf, bar)
        for x in 0..W {
            var c: i64 = board[y * W + x] as i64
            var hit = false
            if c == 0 {
                for i in 0..4 {
                    if pcx[i] == x && pcy[i] == y {
                        hit = true
                        c = pieceColor(kind)
                    }
                }
            }
            if c == 0 && !hit {
                emit(&mut buf, "  ")
            } else {
                emit(&mut buf, blockStr(c))
            }
        }
        emit(&mut buf, bar)
    }

    cursor(&mut buf, 2 + H, 2)
    emit(&mut buf, Color.gray(bottom))

    // sidebar
    let sx = 2 + W * 2 + 5
    cursor(&mut buf, 1, sx)
    emit(&mut buf, Color.bold(Color.cyan("MILO TETRIS")))
    cursor(&mut buf, 2, sx)
    emit(&mut buf, Color.gray("a tetris written in Milo"))
    cursor(&mut buf, 3, sx)
    emit(&mut buf, "score  " + Color.bold($"{score}") + "   ")
    cursor(&mut buf, 4, sx)
    emit(&mut buf, "lines  " + Color.bold($"{lines}") + "   ")
    cursor(&mut buf, 6, sx)
    emit(&mut buf, "next")
    renderNext(&mut buf, nextKind, 7, sx)
    cursor(&mut buf, 11, sx)
    emit(&mut buf, Color.gray("<- ->  move"))
    cursor(&mut buf, 12, sx)
    emit(&mut buf, Color.gray("  ^    rotate"))
    cursor(&mut buf, 13, sx)
    emit(&mut buf, Color.gray("  v    soft drop"))
    cursor(&mut buf, 14, sx)
    emit(&mut buf, Color.gray("space  hard drop"))
    cursor(&mut buf, 15, sx)
    emit(&mut buf, Color.gray("q/^C   quit"))

    // pitch: this is a real program in a real systems language, not a toy
    cursor(&mut buf, 18, sx)
    emit(&mut buf, Color.bold(Color.cyan("memory-safe systems lang")))
    cursor(&mut buf, 19, sx)
    emit(&mut buf, Color.gray("native via LLVM · no GC · no"))
    cursor(&mut buf, 20, sx)
    emit(&mut buf, Color.gray("polling — one green task on"))
    cursor(&mut buf, 21, sx)
    emit(&mut buf, Color.gray("select(keys, gravity timer)"))
    cursor(&mut buf, 23, sx)
    emit(&mut buf, Color.bold(Color.yellow("★ github.com/milo-language/milo")))
}

pub fn drawFrame(board: &Board, kind: i64, rot: i64, px: i64, py: i64, score: i64, lines: i64, nextKind: i64): void {
    var buf = ""
    render(&mut buf, board, kind, rot, px, py, score, lines, nextKind)
    writeStdout(buf)
}

// keep GAME OVER on screen until the player presses q (still event-driven)
pub fn waitForQuit(): void {
    var done = false
    while !done {
        var sel = Select.new()
        sel.onRead(0)
        sel.wait()
        sel.destroy()
        var k = readKey()
        while k != KEY_NONE {
            if k == KEY_QUIT {
                done = true
            }
            k = readKey()
        }
    }
}

pub fn runGame(): void {
    var board: Board = [0; 200]
    var kind = Random.int(NUM_KINDS)
    var nextKind = Random.int(NUM_KINDS)
    var rot: i64 = 0
    var px: i64 = SPAWN_X
    var py: i64 = 0
    var score: i64 = 0
    var lines: i64 = 0
    var gameOver = false
    var quit = false
    var nextDrop = epochMillis() + dropInterval(lines)

    drawFrame(board, kind, rot, px, py, score, lines, nextKind)

    while !gameOver && !quit {
        let now = epochMillis()
        var waitMs = nextDrop - now
        if waitMs < 0 {
            waitMs = 0
        }

        var sel = Select.new()
        sel.onRead(0)
        sel.onTimeout(waitMs)
        let winner = sel.wait()
        sel.destroy()

        var doLock = false

        if winner == ARM_KEY {
            // drain every buffered key this wakeup delivered
            var k = readKey()
            while k != KEY_NONE {
                if k == KEY_QUIT {
                    quit = true
                } else if k == KEY_LEFT {
                    if !collides(board, kind, rot, px - 1, py) {
                        px -= 1
                    }
                } else if k == KEY_RIGHT {
                    if !collides(board, kind, rot, px + 1, py) {
                        px += 1
                    }
                } else if k == KEY_UP {
                    var nr = rot + 1
                    if nr >= pieceRots(kind) {
                        nr = 0
                    }
                    if !collides(board, kind, nr, px, py) {
                        rot = nr
                    }
                } else if k == KEY_DOWN {
                    // soft drop: one row, or lock if already resting
                    if !collides(board, kind, rot, px, py + 1) {
                        py += 1
                        score += 1
                    } else {
                        doLock = true
                    }
                    nextDrop = epochMillis() + dropInterval(lines)
                } else if k == KEY_SPACE {
                    // hard drop: fall until resting, then lock
                    while !collides(board, kind, rot, px, py + 1) {
                        py += 1
                        score += 2
                    }
                    doLock = true
                }
                k = readKey()
            }
        } else {
            // ARM_TICK: gravity — fall one row, or lock if resting on the stack
            if !collides(board, kind, rot, px, py + 1) {
                py += 1
            } else {
                doLock = true
            }
            nextDrop = epochMillis() + dropInterval(lines)
        }

        if quit {
            break
        }

        if doLock {
            lockPiece(&mut board, kind, rot, px, py)
            let cleared = clearLines(&mut board)
            lines += cleared
            score += scoreFor(cleared)
            kind = nextKind
            nextKind = Random.int(NUM_KINDS)
            rot = 0
            px = SPAWN_X
            py = 0
            nextDrop = epochMillis() + dropInterval(lines)
            if collides(board, kind, rot, px, py) {
                gameOver = true
            }
        }

        drawFrame(board, kind, rot, px, py, score, lines, nextKind)
    }

    if gameOver {
        var buf = ""
        cursor(&mut buf, 10, 6)
        emit(&mut buf, Color.bold(Color.red(" GAME OVER ")))
        cursor(&mut buf, 11, 6)
        emit(&mut buf, Color.bold($" score {score} "))
        cursor(&mut buf, 12, 6)
        emit(&mut buf, Color.gray(" press q "))
        writeStdout(buf)
        waitForQuit()
    }
}

pub fn main(): i32 {
    let termState = enableRawMode()
    writeStdout(Ansi.hideCursor() + Ansi.clearScreen())

    // select() needs the green scheduler, so the game runs as a task; join()
    // blocks main here and drives the scheduler until it finishes. (Go-style:
    // like `go run()` + wait — no manual scheduler pumping.)
    Task.spawn(runGame).join()

    writeStdout(Ansi.showCursor() + Ansi.clearScreen() + Ansi.cursorHome() + Ansi.reset())
    restoreTerminal(termState)
    print("thanks for playing milo tetris ♥")
    print("built with milo, docs: https://milo-language.github.io/milo/")
    return 0
}
