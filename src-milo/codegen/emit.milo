// Top-level codegen: function emission, program registration, IR assembly
from "src-milo/target.milo" import {
    getHostTarget
}
from "src-milo/ast.milo" import {
    ExprNode, Expr, StructLitField, Function
}
from "src-milo/hir.milo" import {
    HIRModule, HFunction, HExpr, hexprAbort
}
from "src-milo/checker/types.milo" import {
    TypeKind
}

// Constant initializer text for a module-global's value expression. Globals must
// be compile-time constants (int/bool/float/char literals, optionally negated).
// Aggregate constant `%Struct { <f0>, <f1>, … }` for a struct literal whose fields
// are all const scalars (int/float/bool). Returns "" if the value isn't such a
// struct literal, or any field is non-scalar (String/Vec/nested struct).
pub fn structLitConst(cg: &Cgen, gllTy: &string, value: &ExprNode): string {
    if !(gllTy.len > 0 && gllTy[0] == 37) {
        return ""
    }
    let sname = stripPercent(gllTy)
    if !cg.structs.contains(sname) {
        return ""
    }
    let sfields = cg.structs.get(sname)!
    match value.kind {
        Expr.StructLit(lname, litFields) => {
            var parts: Vec<string> = Vec.new()
            for fi in 0..sfields.len {
                let fll = llType(sfields[fi].ty)
                let scalar = fll == "i1" || fll == "i8" || fll == "i16" || fll == "i32" || fll == "i64" || fll == "double" || fll == "float"
                if !scalar {
                    return ""
                }
                var fval = "0"
                for lf in 0..litFields.len {
                    if litFields[lf].name == sfields[fi].name {
                        fval = constInitOf(*litFields[lf].value, fll)
                    }
                }
                parts.push(fll + " " + fval)
            }
            var body = "{ "
            for pi in 0..parts.len {
                if pi > 0 {
                    body = body + ", "
                }
                body = body + parts[pi].clone()
            }
            return body + " }"
        }
        _ => {
            return ""
        }
    }
}

// Const element list for a global initialized by an Expr.ArrayLit/ArrayRepeat,
// else empty (falls back to zeroinit + runtime init). Takes `value` by
// reference for the same reason constStructBody does — see its comment.
pub fn constArrayElems(cg: &Cgen, value: &ExprNode, elemLl: &string, structElem: bool): Vec<string> {
    var kind = ""
    var litElems: Vec<Heap<ExprNode>> = Vec.new()
    var repeatVal: Heap<ExprNode> = mkExpr(Expr.IntLit(0), Option.None)
    var repeatCount: i64 = 0
    match value.kind {
        Expr.ArrayLit(elements) => {
            kind = "lit"
            for i in 0..elements.len {
                litElems.push(Heap((*elements[i]).clone()))
            }
        }
        Expr.ArrayRepeat(val, count) => {
            kind = "repeat"
            repeatVal = Heap((*val).clone())
            repeatCount = count
        }
        _ => {
        }
    }
    var elems: Vec<string> = Vec.new()
    var elemOk = true
    if kind == "lit" {
        for ei in 0..litElems.len {
            if structElem {
                let sc = structLitConst(cg, elemLl, *litElems[ei])
                if sc.len == 0 {
                    elemOk = false
                } else {
                    elems.push(elemLl.clone() + " " + sc)
                }
            } else {
                elems.push(elemLl.clone() + " " + constInitOf(*litElems[ei], elemLl))
            }
        }
    } else if kind == "repeat" {
        var one = ""
        if structElem {
            one = structLitConst(cg, elemLl, *repeatVal)
            if one.len == 0 {
                elemOk = false
            }
        } else {
            one = constInitOf(*repeatVal, elemLl)
        }
        for ci in 0..repeatCount {
            elems.push(elemLl.clone() + " " + one.clone())
        }
    }
    if !elemOk {
        return Vec.new()
    }
    return elems
}

// A struct-literal field initialized by an empty container constructor
// (`Vec.new()`) is still all-zero bytes, hence const. Takes `&ExprNode` (a
// borrow) — see constStructBody's comment for why that matters here.
//
// Gated on the TYPE name, not just the variant/method name: `vn == "new"` alone
// also matches `Once.new()`, `Mutex.new()` and friends, whose ".new()" allocates
// real resources (malloc + pthread_mutex_init for Once) and is nothing like
// all-zero bytes. Treating that as a constant zero-inits the global and skips
// its real runtime initializer entirely — the struct's pointer field stays
// null forever, and the first `.run()`/`.isDone()` dereferences it and
// segfaults. Only Vec/HashMap's `.new()` is genuinely the empty/zeroed state.
pub fn isEmptyCtorInit(e: &ExprNode): bool {
    match e.kind {
        Expr.EnumLit(en, vn, eargs) => {
            return (en == "Vec" || en == "HashMap") && vn == "new" && eargs.len == 0
        }
        _ => {
            return false
        }
    }
}

// The LLVM struct-constant body ("{ ... }") for a global whose initializer is
// an all-const-scalar Expr.StructLit, else None (falls back to zeroinit +
// runtime init). MUST take `value` by reference: this used to be inlined as
// `match *prog.globals[gi].value { Expr.StructLit(...) => ..., _ => {} }` —
// dereferencing the global's Heap<ExprNode> MOVES it out of the box for the
// match's duration, and a non-StructLit initializer (e.g. a generic call
// like `arenaNew<Node>()`) fell into the wildcard arm, dropping that owned
// temporary — freeing the global's OWN AST node in place. The runtime-init
// pass then re-read the same (now-freed) Heap<ExprNode> and got back garbage
// that happened to decode as Expr.IntLit(0), silently emitting `store %T 0`
// instead of the real initializer call.
pub fn constStructBody(_cg: &Cgen, value: &ExprNode, sfields: &Vec<FieldInfo>): Option<string> {
    var isLit = false
    var litFields: Vec<StructLitField> = Vec.new()
    match value.kind {
        Expr.StructLit(n, fs) => {
            isLit = true
            for i in 0..fs.len {
                litFields.push(fs[i].clone())
            }
        }
        _ => {
        }
    }
    if !isLit {
        return Option.None
    }
    var parts: Vec<string> = Vec.new()
    var allConst = true
    // emit in declared field order, matching the literal by name
    for fi in 0..sfields.len {
        let fll = llType(sfields[fi].ty)
        let scalar = fll == "i1" || fll == "i8" || fll == "i16" || fll == "i32" || fll == "i64" || fll == "double" || fll == "float"
        var fval = "0"
        var fieldConst = scalar
        for lf in 0..litFields.len {
            if litFields[lf].name == sfields[fi].name {
                if scalar {
                    fval = constInitOf(*litFields[lf].value, fll)
                } else if isEmptyCtorInit(*litFields[lf].value) {
                    // An EMPTY container is still a constant: `Vec.new()` is all-zero
                    // bytes. Bailing on it zero-initialized the WHOLE struct, so a
                    // `Vec` field silently discarded every scalar field beside it.
                    fval = "zeroinitializer"
                    fieldConst = true
                }
            }
        }
        if !fieldConst {
            allConst = false
        }
        parts.push(fll + " " + fval)
    }
    if !allConst {
        return Option.None
    }
    var body = "{ "
    for pi in 0..parts.len {
        if pi > 0 {
            body = body + ", "
        }
        body = body + parts[pi].clone()
    }
    body = body + " }"
    return Option.Some(body)
}

// Can this initializer be spelled as an LLVM constant? Anything else needs the runtime
// initializer. Deliberately conservative: a shape not listed here gets runtime init, which
// is always correct, where guessing "constant" would silently emit a zero.
// An aggregate initializer that IS all-zero bytes, so the static zeroinitializer is
// already the right answer and no runtime store is needed.
//
// Same type-name gate as isEmptyCtorInit above and for the same reason: a bare
// `vn == "new"` also fires on `Once.new()`, whose zero bytes are NOT its real
// initial state (a null `_p` instead of a live malloc'd mutex/cond pair) —
// skipping its runtime init left every `Once` global permanently unusable and
// crashed on first use.
pub fn isEmptyAggInit(e: &ExprNode): bool {
    match e.kind {
        Expr.EnumLit(en, vn, args) => {
            return (en == "Vec" || en == "HashMap") && vn == "new" && args.len == 0
        }
        _ => {
            return false
        }
    }
}

pub fn isConstInit(e: &ExprNode): bool {
    match e.kind {
        Expr.IntLit(n) => {
            return true
        }
        Expr.FloatLit(f) => {
            return true
        }
        Expr.BoolLit(b) => {
            return true
        }
        Expr.CharLit(c) => {
            return true
        }
        Expr.StringLit(v) => {
            return true
        }
        Expr.UnaryOp(op, operand) => {
            if op == "-" {
                return isConstInit(*operand)
            }
            return false
        }
        Expr.BinOp(op, lhs, rhs) => {
            // Only NUMERIC folding exists; string concatenation has to run at runtime.
            let f = constFoldNum(e)
            return f.ok
        }
        Expr.ArrayLit(elements) => {
            for i in 0..elements.len {
                if !isConstInit(*elements[i]) {
                    return false
                }
            }
            return true
        }
        Expr.ArrayRepeat(val, count) => {
            return isConstInit(*val)
        }
        Expr.StructLit(name, fields) => {
            for i in 0..fields.len {
                if !isConstInit(*fields[i].value) {
                    return false
                }
            }
            return true
        }
        Expr.EnumLit(en, vn, args) => {
            // `Vec.new()` / `HashMap.new()` are the empty-container constructors, which
            // are all-zero bytes — but only those two; `en` must be checked too, or
            // `Once.new()` (real malloc'd state behind a struct that only LOOKS like
            // an empty container) is wrongly treated as constant zero. See
            // isEmptyAggInit's comment for the crash this caused.
            return (en == "Vec" || en == "HashMap") && vn == "new" && args.len == 0
        }
        _ => {
            return false
        }
    }
}

pub fn constInitOf(e: &ExprNode, llTy: &string): string {
    // a pointer global can only be a compile-time-constant null (`0 as *T`); LLVM
    // rejects `global ptr 0`, the null pointer constant is spelled `null`.
    if llTy == "ptr" {
        return "null"
    }
    match e.kind {
        Expr.IntLit(n) => {
            if llTy == "double" || llTy == "float" {
                return n.toString() + ".0"
            }
            return n.toString()
        }
        Expr.BoolLit(b) => {
            if b {
                return "1"
            }
            return "0"
        }
        Expr.CharLit(c) => {
            return c.toString()
        }
        Expr.FloatLit(f) => {
            return floatDecimalStr(f)
        }
        Expr.UnaryOp(op, operand) => {
            if op == "-" {
                return "-" + constInitOf(*operand, llTy)
            }
            return zeroOf(llTy)
        }
        // Arithmetic on literals is folded here. Without it `let A: f64 = 3.0 / 2.0`
        // fell through to the zero fallback and emitted `global double 0` — both the
        // wrong VALUE and, since `0` is an integer constant, not even valid IR for a
        // double.
        Expr.BinOp(op, lhs, rhs) => {
            let lf = constFoldNum(*lhs)
            let rf = constFoldNum(*rhs)
            if lf.ok && rf.ok {
                let folded = applyConstOp(op, lf, rf)
                if folded.ok {
                    if llTy == "double" || llTy == "float" {
                        return floatConstStr(folded.f)
                    }
                    return folded.i.toString()
                }
            }
            return zeroOf(llTy)
        }
        _ => {
            return zeroOf(llTy)
        }
    }
}

// The zero an LLVM type actually accepts: `0` is an integer constant and a `double`
// global spelled `global double 0` is rejected outright.
pub fn zeroOf(llTy: &string): string {
    if llTy == "double" || llTy == "float" {
        return "0.000000e+00"
    }
    if llTy == "ptr" {
        return "null"
    }
    return "0"
}

pub struct ConstNum {
    ok: bool,
    isFloat: bool,
    i: i64,
    f: f64,
}

pub fn floatConstStr(f: f64): string {
    return floatDecimalStr(f)
}

pub fn constFoldNum(e: &ExprNode): ConstNum {
    match e.kind {
        Expr.IntLit(n) => {
            return ConstNum {
                ok: true, isFloat: false, i: n, f: n as f64
            }
        }
        Expr.FloatLit(f) => {
            return ConstNum {
                ok: true, isFloat: true, i: f as i64, f: f
            }
        }
        Expr.UnaryOp(op, operand) => {
            if op == "-" {
                let inner = constFoldNum(*operand)
                if inner.ok {
                    return ConstNum {
                        ok: true, isFloat: inner.isFloat, i: 0 - inner.i, f: 0.0 - inner.f
                    }
                }
            }
            return ConstNum {
                ok: false, isFloat: false, i: 0, f: 0.0
            }
        }
        Expr.BinOp(op, lhs, rhs) => {
            let l = constFoldNum(*lhs)
            let r = constFoldNum(*rhs)
            if l.ok && r.ok {
                return applyConstOp(op, l, r)
            }
            return ConstNum {
                ok: false, isFloat: false, i: 0, f: 0.0
            }
        }
        _ => {
            return ConstNum {
                ok: false, isFloat: false, i: 0, f: 0.0
            }
        }
    }
}

pub fn applyConstOp(op: &string, l: ConstNum, r: ConstNum): ConstNum {
    let isF = l.isFloat || r.isFloat
    var oi: i64 = 0
    var of: f64 = 0.0
    if op == "+" {
        oi = l.i + r.i
        of = l.f + r.f
    } else if op == "-" {
        oi = l.i - r.i
        of = l.f - r.f
    } else if op == "*" {
        oi = l.i * r.i
        of = l.f * r.f
    } else if op == "/" {
        if isF {
            if r.f == 0.0 {
                return ConstNum {
                    ok: false, isFloat: false, i: 0, f: 0.0
                }
            }
            of = l.f / r.f
        } else {
            if r.i == 0 {
                return ConstNum {
                    ok: false, isFloat: false, i: 0, f: 0.0
                }
            }
            oi = l.i / r.i
        }
    } else if op == "%" && !isF {
        if r.i == 0 {
            return ConstNum {
                ok: false, isFloat: false, i: 0, f: 0.0
            }
        }
        oi = l.i % r.i
    } else if op == "<<" && !isF {
        oi = l.i << r.i
    } else if op == ">>" && !isF {
        oi = l.i >> r.i
    } else if op == "|" && !isF {
        oi = l.i | r.i
    } else if op == "&" && !isF {
        oi = l.i & r.i
    } else if op == "^" && !isF {
        oi = l.i ^ r.i
    } else {
        return ConstNum {
            ok: false, isFloat: false, i: 0, f: 0.0
        }
    }
    return ConstNum {
        ok: true, isFloat: isF, i: oi, f: of
    }
}
from "src-milo/codegen/types.milo" import {
    astTypeStr, tyStr, rangeOfTyK, rangeOfAnnotation,
    Cgen, Val, Local, CgFnSig, FieldInfo, CgVariantInfo, CgEnumInfo, RangeAnno, noRange,
    cgenNew, nextTemp, emit, emitG, llType, llTypeBytes, payloadBytes, resolveTyStr, isVecTy, unwrapVec,
    stripPercent, ensureStringTy, ensureVecTy, ensureHashMapTy,
}
from "src-milo/codegen/stmt.milo" import {
    genStmt, emitScopeDrops, collectIdentsExpr, returnEscapedIdents, inferVecPushHints
}
from "src-milo/codegen/expr.milo" import {
    genHExpr
}
from "src-milo/codegen/abi.milo" import {
    AbiStruct, ArgClass, RetClass, AbiReg,
    abiStructOf, classifyArg, classifyRet,
}
from "src-milo/target.milo" import {
    getHostTarget
}
from "src-milo/codegen/strings.milo" import {
    floatDecimalStr
}

// Build the call-site signature table: every function that was lowered, plus the generic
// templates that were not. A generic call names the TEMPLATE, so leaving those out drops
// the by-reference flags for exactly the calls that need them most.
pub fn buildFnTable(cg: &Cgen, fns: &Vec<HFunction>, generics: &Vec<Function>): Vec<CgFnSig> {
    var sigs: Vec<CgFnSig> = Vec.new()
    for i in 0..fns.len {
        var pts: Vec<string> = Vec.new()
        var prefs: Vec<bool> = Vec.new()
        var pranges: Vec<RangeAnno> = Vec.new()
        for j in 0..fns[i].params.len {
            pts.push(tyStr(cg, fns[i].params[j].ty, "parameter '" + fns[i].params[j].name.clone() + "' of '" + fns[i].name.clone() + "'"))
            prefs.push(fns[i].params[j].isRef || fns[i].params[j].isRefMut)
            pranges.push(rangeOfTyK(fns[i].params[j].ty))
        }
        sigs.push(CgFnSig {
            name: fns[i].name.clone(),
            retTy: tyStr(cg, fns[i].retType, "return type of '" + fns[i].name.clone() + "'"),
            paramTys: pts,
            paramRefs: prefs,
            isVariadic: fns[i].isVariadic,
            paramRanges: pranges,
        })
    }
    // A template's parameter types are still syntax — `T` names nothing the checker
    // resolved — so these read the AST. They are hints and modes only; no instantiation
    // is emitted from them.
    for i in 0..generics.len {
        var gts: Vec<string> = Vec.new()
        var grefs: Vec<bool> = Vec.new()
        var granges: Vec<RangeAnno> = Vec.new()
        for j in 0..generics[i].params.len {
            gts.push(astTypeStr(generics[i].params[j].ty))
            grefs.push(generics[i].params[j].ty.isRef || generics[i].params[j].ty.isRefMut)
            granges.push(rangeOfAnnotation(cg, generics[i].params[j].ty))
        }
        sigs.push(CgFnSig {
            name: generics[i].name.clone(),
            retTy: astTypeStr(generics[i].retType),
            paramTys: gts,
            paramRefs: grefs,
            isVariadic: generics[i].isVariadic,
            paramRanges: granges,
        })
    }
    return sigs
}

// True when `t` is a bare (non-ref, non-pointer, non-array) struct type — the only
// shape that crosses a C extern boundary by value and needs ABI classification.
// `byRef` is passed separately because HFnParam stores a `&T` param's INNER type with
// the indirection on a flag beside it.
pub fn isByValStruct(cg: &Cgen, t: &TypeKind, byRef: bool): bool {
    if byRef {
        return false
    }
    match t {
        TypeKind.TPtr(inner) => {
            return false
        }
        TypeKind.TRef(inner, mutable) => {
            return false
        }
        TypeKind.TArray(elem, size) => {
            return false
        }
        TypeKind.TFn(fparams, fret) => {
            return false
        }
        _ => {
        }
    }
    let raw = stripPercent(tyStr(cg, t, "extern by-value type"))
    if !cg.structs.contains(raw) {
        return false
    }
    if cg.interfaces.contains(raw) {
        return false
    }
    return true
}

// A fn-typed param of a C extern is a raw function pointer, not milo's %Closure fat
// pointer (qsort's cmp is `int(*)(…)`, no env).
pub fn isCFnTy(t: &TypeKind): bool {
    match t {
        TypeKind.TFn(fparams, fret) => {
            return true
        }
        _ => {
            return false
        }
    }
}

// Lowered LLVM param/return signature for an extern with by-value struct params or
// return. The SAME rendering must appear at the declare AND every call site (an
// sret/byval attr on one but not the other silently miscompiles on x86_64), so both
// go through this single source of truth. Returns (paramStrs, retStr).
pub fn externLoweredParams(cg: &Cgen, f: &HFunction): Vec<string> {
    var params: Vec<string> = Vec.new()
    if isByValStruct(cg, f.retType, false) {
        let rname = stripPercent(tyStr(cg, f.retType, "return type of '" + f.name.clone() + "'"))
        let rc = classifyRet(cg.arch, abiStructOf(cg, rname))
        if rc.kind == "sret" {
            params.push("ptr sret(%" + rc.name.clone() + ") align " + rc.align.toString())
        }
    }
    for i in 0..f.params.len {
        let byRef = f.params[i].isRef || f.params[i].isRefMut
        if isCFnTy(f.params[i].ty) {
            params.push("ptr")
        } else if isByValStruct(cg, f.params[i].ty, byRef) {
            let pname = stripPercent(tyStr(cg, f.params[i].ty, "parameter of '" + f.name.clone() + "'"))
            let ac = classifyArg(cg.arch, abiStructOf(cg, pname))
            if ac.kind == "coerce" {
                for r in 0..ac.regs.len {
                    params.push(ac.regs[r].ty.clone())
                }
            } else {
                if ac.byval {
                    params.push("ptr byval(%" + ac.name.clone() + ") align " + ac.align.toString())
                } else {
                    params.push("ptr")
                }
            }
        } else {
            params.push(llType(paramTyStr(cg, f, i)))
        }
    }
    return params
}

// The backend type of parameter `i`, with the `&T`/`&mut T` indirection put back on: a
// ref param is a `ptr` to the pointee, and HFnParam keeps the pointee type with the
// indirection on a flag beside it.
pub fn paramTyStr(cg: &Cgen, f: &HFunction, i: i64): string {
    return tyStr(cg, f.params[i].ty, "parameter '" + f.params[i].name.clone() + "' of '" + f.name.clone() + "'")
}

pub fn externLoweredRet(cg: &Cgen, f: &HFunction): string {
    if isByValStruct(cg, f.retType, false) {
        let rname = stripPercent(tyStr(cg, f.retType, "return type of '" + f.name.clone() + "'"))
        let rc = classifyRet(cg.arch, abiStructOf(cg, rname))
        if rc.kind == "sret" {
            return "void"
        }
        if rc.kind == "coerce" {
            return rc.retTy.clone()
        }
    }
    return llType(tyStr(cg, f.retType, "return type of '" + f.name.clone() + "'"))
}

// Emit a single function definition or extern declaration.
// Move fixed-size allocas to the entry block. LLVM only reclaims stack at function
// return, so an `alloca` emitted inside a loop body allocates AGAIN every iteration:
// sha256 over a megabyte segfaulted at ~1500 iterations while 800 worked. 27 functions in
// a std-using program had allocas outside entry, `sha256Bytes` alone 29 of them.
//
// Safe by construction: entry dominates every block, and only allocas with no operands
// move. A dynamically-sized `alloca T, i64 %n` is left alone — %n need not be available
// at entry.
pub fn hoistAllocas(fnText: &string): string {
    var lines: Vec<string> = Vec.new()
    var cur = ""
    for i in 0..fnText.len {
        let c = fnText[i]
        if c == 10 {
            lines.push(cur.clone())
            cur = ""
        } else {
            cur.push(c)
        }
    }
    lines.push(cur.clone())

    // Index of the entry label; allocas already at or before it stay put.
    var entryIdx: i64 = -1
    for i in 0..lines.len {
        if entryIdx < 0 && lines[i].len > 1 && lines[i][lines[i].len - 1] == 58 && lines[i][0] != 32 {
            entryIdx = i
        }
    }
    if entryIdx < 0 {
        return fnText.clone()
    }

    var moved: Vec<string> = Vec.new()
    var kept: Vec<string> = Vec.new()
    var blockIdx: i64 = -1
    for i in 0..lines.len {
        let l = lines[i].clone()
        if l.len > 1 && l[l.len - 1] == 58 && l[0] != 32 {
            blockIdx = i
        }
        var isHoistable = false
        if blockIdx > entryIdx && l.len > 4 && l[0] == 32 {
            // `  %name = alloca <type>` with nothing after the type is fixed-size.
            var seenAlloca = false
            var hasComma = false
            var j: i64 = 0
            while j + 6 < l.len {
                if l[j] == 97 && l[j + 1] == 108 && l[j + 2] == 108 && l[j + 3] == 111 && l[j + 4] == 99 && l[j + 5] == 97 {
                    seenAlloca = true
                }
                if seenAlloca && l[j] == 44 {
                    hasComma = true
                }
                j = j + 1
            }
            if seenAlloca && !hasComma {
                isHoistable = true
            }
        }
        if isHoistable {
            moved.push(l)
        } else {
            kept.push(l)
        }
    }
    if moved.len == 0 {
        return fnText.clone()
    }

    var out = ""
    var placed = false
    for i in 0..kept.len {
        out = out + kept[i].clone()
        out.push(10 as u8)
        if !placed && kept[i].len > 1 && kept[i][kept[i].len - 1] == 58 && kept[i][0] != 32 {
            for m in 0..moved.len {
                out = out + moved[m].clone()
                out.push(10 as u8)
            }
            placed = true
        }
    }
    // Drop the trailing newline this rebuild added beyond the original.
    if out.len > 0 {
        out = out[0..out.len - 1].clone()
    }
    return out
}

pub fn genFn(cg: &mut Cgen, f: &HFunction, sigs: &Vec<CgFnSig>) {
    if f.isExtern {
        cg.externFns.insert(f.name.clone(), true)
        var ps = ""
        if cg.abiExterns.contains(f.name) {
            // struct-by-value extern: emit the native-ABI-lowered param list (coerced
            // register types / byval / sret) so it matches the C peer's calling convention.
            let lp = externLoweredParams(cg, f)
            for i in 0..lp.len {
                if i > 0 {
                    ps = ps + ", "
                }
                ps = ps + lp[i].clone()
            }
        } else {
            for i in 0..f.params.len {
                if i > 0 {
                    ps = ps + ", "
                }
                if isCFnTy(f.params[i].ty) {
                    ps = ps + "ptr"
                } else {
                    ps = ps + llType(paramTyStr(cg, f, i))
                }
            }
        }
        if f.isVariadic {
            if f.params.len > 0 {
                ps = ps + ", "
            }
            ps = ps + "..."
        }
        // extern decls double as the runtime-helper declares — coordinate with
        // the ensure* flags in either order (clang rejects a redefinition)
        if f.name == "memcmp" {
            if cg.declaredMemcmp {
                return
            }
            cg.declaredMemcmp = true
        }
        if f.name == "memcpy" {
            if cg.declaredMemcpy {
                return
            }
            cg.declaredMemcpy = true
        }
        if f.name == "malloc" {
            if cg.declaredMalloc {
                return
            }
            cg.declaredMalloc = true
        }
        if f.name == "realloc" {
            if cg.declaredRealloc {
                return
            }
            cg.declaredRealloc = true
        }
        if f.name == "printf" {
            if cg.declaredPrintf {
                return
            }
            cg.declaredPrintf = true
        }
        if f.name == "putchar" {
            if cg.declaredPutchar {
                return
            }
            cg.declaredPutchar = true
        }
        if f.name == "snprintf" {
            if cg.declaredSnprintf {
                return
            }
            cg.declaredSnprintf = true
        }
        if f.name == "exit" {
            if cg.declaredExit {
                return
            }
            cg.declaredExit = true
        }
        if f.name == "strlen" {
            if cg.declaredStrlen {
                return
            }
            cg.declaredStrlen = true
        }
        // drop glue also emits `declare @free`; share one dedup flag so an
        // explicit `extern fn free` and the drop glue never double-declare it.
        if f.name == "free" {
            if cg.declaredFree {
                return
            }
            cg.declaredFree = true
        }
        // the `flush()` builtin (expr.milo) also emits `declare @fflush`; share one
        // dedup flag so std/os's `extern fn fflush` and the builtin never double-declare
        // it — LLVM rejects a redefinition, which broke every program importing std/os
        // AND calling the bare `flush()` builtin.
        if f.name == "fflush" {
            if cg.declaredFflush {
                return
            }
            cg.declaredFflush = true
        }
        // The checker's own return type, so a `*u8` stays a pointer: dropping the
        // pointer-ness declared e.g. strerror as returning i8 → truncated pointer →
        // strlen on garbage in the self-compiled build.
        var declRet = llType(tyStr(cg, f.retType, "return type of '" + f.name.clone() + "'"))
        if cg.abiExterns.contains(f.name) {
            declRet = externLoweredRet(cg, f)
        }
        emitG(&mut cg, "declare " + declRet + " @" + f.name + "(" + ps + ")\n")
        return
    }

    cg.temp = 0
    cg.label = 0
    // temp addresses (%.tN) are reused across functions (counter resets above),
    // so a moved-address record from a PRIOR function must not leak in here.
    cg.movedLocalAddrs = Vec.new()
    // `@wrapping` (direct, or inherited from a file-level `@!wrapping` — see
    // parser.milo) skips the checked-arith/shift traps below and takes the
    // plain two's-complement instruction instead. Reset per function: this is
    // NOT scope-nested, every genFn call is a fresh function.
    cg.currentFnWrapping = f.isWrapping
    var locs: Vec<Local> = Vec.new()
    // C `main` is forced to `i32 (i32 argc, ptr argv)`: it stashes argc/argv into
    // globals that _miloArgCount/_miloArgAt read, and returns an exit code.
    let isMain = f.name == "main"
    var retTyStr = tyStr(cg, f.retType, "return type of '" + f.name.clone() + "'")
    if isMain {
        retTyStr = "i32"
    }
    let retLl = llType(retTyStr)
    cg.curRetTy = retTyStr.clone()
    // main is forced to i32 above, so a bound spelled on its return type is
    // deliberately not carried — the exit code it produces is not that value.
    if isMain {
        cg.curRetRange = noRange()
    } else {
        cg.curRetRange = rangeOfTyK(f.retType)
    }
    var hdr = "define " + retLl + " @" + f.name + "("
    if isMain {
        hdr = hdr + "i32 %_milo_argc, ptr %_milo_argv"
    }
    for pi in 0..f.params.len {
        if pi > 0 || isMain {
            hdr = hdr + ", "
        }
        // A `&T`/`&mut T` param is lowered as a `ptr` to the pointee, so mutations
        // through it are visible to the caller (milo threads `&mut Cgen` etc.).
        let piRef = f.params[pi].isRef || f.params[pi].isRefMut
        var pLl = "ptr"
        if !piRef {
            pLl = llType(paramTyStr(cg, f, pi))
        }
        hdr = hdr + pLl + " %" + f.params[pi].name
    }
    hdr = hdr + ") {\n"
    cg.fnBuf = ""
    cg.inFn = true
    emit(&mut cg, hdr)
    // "entry.bb", not "entry": a PARAMETER named `entry` (std/fs's directory walker has
    // one) becomes `%entry`, which collides with a block label spelled `entry` and LLVM
    // refuses the module. Same class as the `%.t` temp prefix — a generated name must be
    // one the source language cannot produce.
    emit(&mut cg, "entry.bb:\n")
    if isMain {
        emit(&mut cg, "  store i32 %_milo_argc, ptr @_milo_argc_global\n")
        emit(&mut cg, "  store ptr %_milo_argv, ptr @_milo_argv_global\n")
        if cg.needsGlobalInit {
            emit(&mut cg, "  call void @_milo_init_globals()\n")
        }
    }

    // Bind parameters. A ref param arrives as a `ptr` to the pointee, so it IS
    // already the local's address — use it directly (no alloca/copy), which is
    // what makes mutation-through-&mut visible to the caller. Value params spill
    // to a fresh alloca as usual.
    for pj in 0..f.params.len {
        let pTyStr = paramTyStr(cg, f, pj)
        let pIsRef = f.params[pj].isRef || f.params[pj].isRefMut
        let pIsArr = isFixedArrayTy(f.params[pj].ty)
        if pIsRef {
            locs.push(Local {
                name: f.params[pj].name.clone(), ty: pTyStr, addr: "%" + f.params[pj].name, isRef: true, isArr: pIsArr, range: noRange()
            })
        } else {
            let llt = llType(pTyStr)
            let addr = "%" + f.params[pj].name + "_addr"
            emit(&mut cg, "  " + addr + " = alloca " + llt + "\n")
            emit(&mut cg, "  store " + llt + " %" + f.params[pj].name + ", ptr " + addr + "\n")
            locs.push(Local {
                name: f.params[pj].name.clone(), ty: pTyStr, addr: addr, isRef: false, isArr: pIsArr, range: rangeOfTyK(f.params[pj].ty)
            })
        }
    }

    // Pre-scan for `let f = <closure>; ...; return f` — the escape has to be known
    // before the LetDecl runs (see collectReturnEscapedIdentsInto's doc comment).
    let escaped = returnEscapedIdents(f.body)
    cg.forceMoveClosures = escaped
    // Pre-scan for `var v = Vec.new(); ...; v.push(x)` — the element type has to be
    // known before the VarDecl runs (see collectVecPushHintsInto's doc comment).
    let pushHints = inferVecPushHints(f.body)
    cg.vecPushHints = pushHints
    var terminated = false
    for si in 0..f.body.len {
        if genStmt(&mut cg, *f.body[si], &mut locs, sigs, retTyStr) {
            terminated = true
        }
    }
    if !terminated {
        emitScopeDrops(&mut cg, locs, 0, "")
        if retLl == "void" {
            emit(&mut cg, "  ret void\n")
        } else {
            emit(&mut cg, "  ret " + retLl + " 0\n")
        }
    }
    emit(&mut cg, "}\n\n")
    cg.inFn = false
    // One append of one function's text. `body = body + x` hits the in-place append
    // peephole (amortized realloc), so the accumulated module is never re-copied.
    let hoisted = hoistAllocas(cg.fnBuf)
    cg.body = cg.body + hoisted
    cg.fnBuf = ""
}

// A fixed-size `[T; N]` — the shape that shares %Vec's runtime layout but must be
// deep-copied, not moved, at a by-value site. An unsized `&[T]` slice view is not one.
pub fn isFixedArrayTy(t: &TypeKind): bool {
    match t {
        TypeKind.TArray(elem, size) => {
            match size {
                Option.Some(n) => {
                    return true
                }
                Option.None => {
                    return false
                }
            }
        }
        _ => {
            return false
        }
    }
}

// A struct field's backend type. A fixed array lays out INLINE (`[N x T]` in the LLVM
// struct), not as the Vec<T> heap header locals and params use — C structs with array
// fields (extern layout, offsetOf) need the real size/offset, which a 24-byte %Vec
// header can never produce. Marker: "[" N "]" elemTyStr — see isInlineArrTy.
pub fn fieldTyStr(cg: &Cgen, sname: &string, fname: &string, t: &TypeKind): string {
    match t {
        TypeKind.TArray(elem, size) => {
            match size {
                Option.Some(n) => {
                    return "[" + n.toString() + "]" + tyStr(cg, *elem, "field '" + fname.clone() + "' of " + sname.clone())
                }
                Option.None => {
                }
            }
        }
        _ => {
        }
    }
    return tyStr(cg, t, "field '" + fname.clone() + "' of " + sname.clone())
}

// Emit a global's static initializer line. Returns true when the value cannot be spelled
// as an LLVM constant and has to be computed by the runtime initializer instead.
fn emitGlobalStatic(cg: &mut Cgen, gname: &string, surfaceTy: &string, value: &ExprNode): bool {
    let gllTy = llType(surfaceTy)
    // A fixed-array global with a literal initializer (`var xs: [i32;5] = [10,…]`)
    // lowers to a %Vec — materialize the element data as a writable global and
    // point the %Vec at it (zeroinit would leave it empty).
    var arrayHandled = false
    if isVecTy(surfaceTy) {
        let elemLl = llType(unwrapVec(surfaceTy))
        let scalarElem = elemLl == "i1" || elemLl == "i8" || elemLl == "i16" || elemLl == "i32" || elemLl == "i64" || elemLl == "double" || elemLl == "float"
        let structElem = elemLl.len > 0 && elemLl[0] == 37 && cg.structs.contains(stripPercent(elemLl))
        if scalarElem || structElem {
            let elems = constArrayElems(cg, value, elemLl, structElem)
            if elems.len > 0 {
                var dataC = "["
                for ei in 0..elems.len {
                    if ei > 0 {
                        dataC = dataC + ", "
                    }
                    dataC = dataC + elems[ei].clone()
                }
                dataC = dataC + "]"
                let n = elems.len.toString()
                emitG(&mut cg, "@" + gname.clone() + "_data = global [" + n + " x " + elemLl + "] " + dataC + "\n")
                emitG(&mut cg, "@" + gname.clone() + " = global %Vec { ptr @" + gname.clone() + "_data, i64 " + n + ", i64 " + n + " }\n")
                arrayHandled = true
            }
        }
    }
    if arrayHandled {
        return false
    }
    // A struct global with an all-const-scalar literal (`var o: Point = Point{x,y}`)
    // becomes an aggregate constant; otherwise aggregates zero-init.
    let isStructG = gllTy.len > 0 && gllTy[0] == 37 && cg.structs.contains(stripPercent(gllTy))
    if isStructG {
        let sname = stripPercent(gllTy)
        let sfields = cg.structs.get(sname)!
        match constStructBody(cg, value, sfields) {
            Option.Some(body) => {
                emitG(&mut cg, "@" + gname.clone() + " = global " + gllTy + " " + body + "\n")
                return false
            }
            Option.None => {
            }
        }
    }
    // aggregate globals (%String/%Vec/struct) zero-init; scalars take a const.
    var gval = "zeroinitializer"
    var needsInit = false
    let isAgg = gllTy.len > 0 && gllTy[0] == 37
    if !isAgg {
        gval = constInitOf(value, gllTy)
        if !isConstInit(value) {
            needsInit = true
        }
    } else if !isEmptyAggInit(value) {
        // A %String or %Vec built from anything other than an empty constructor
        // cannot be an LLVM constant, so zeroinitializer here is a placeholder —
        // the real value has to be computed at startup. Without this a
        // `pub let TAIL: string = "tail"` stayed the empty string forever.
        needsInit = true
    }
    emitG(&mut cg, "@" + gname.clone() + " = global " + gllTy + " " + gval + "\n")
    return needsInit
}

// Register structs, enums, functions in Cgen tables, then emit all functions.
pub fn genProgram(m: HIRModule, sourceDir: string): string {
    var mod = m
    var cg = cgenNew()
    cg.sourceDir = sourceDir
    cg.targetOs = getHostTarget().os
    // The lifted-body arena moves in whole. Nothing below adds to it or removes from it:
    // codegen only takes a block out to walk it and puts the same one back.
    cg.stmtBlocks = replace(mod.stmtBlocks, Vec.new())
    cg.stmtBlockAt = replace(mod.stmtBlockAt, HashMap.new())

    // Runtime-support globals: argc/argv (read by _miloArgCount/_miloArgAt) and
    // the current green scheduler (read/written by _schedulerGet/_schedulerSet).
    emitG(&mut cg, "@_milo_argc_global = internal global i32 0\n")
    emitG(&mut cg, "@_milo_argv_global = internal global ptr null\n")
    emitG(&mut cg, "@_milo_scheduler = internal thread_local global ptr null\n")
    // closure/fn value = { fn pointer, environment pointer }
    emitG(&mut cg, "%Closure = type { ptr, ptr }\n")

    // Register type aliases FIRST — the astTypeStr(...)/resolveTyStr(...) calls that
    // remain (trait method return types) need the alias table already populated to
    // expand a bare alias name like `Board` to its base type.
    for ai in 0..mod.astTypeAliases.len {
        cg.typeAliases.insert(mod.astTypeAliases[ai].name.clone(), mod.astTypeAliases[ai].base.clone())
    }

    // %String/%Vec/%HashMap are fixed-layout runtime types with no dependencies, so
    // declare all three up front rather than on first use. LLVM's textual parser sizes
    // a `getelementptr %S` at the point it reads it: a struct carrying a %HashMap field
    // is UNSIZED until %HashMap is declared, and lazy declaration put %HashMap 2000
    // lines below the drop helper that geps %Checker ("base element of getelementptr
    // must be sized"). Three unused type lines is a cheap price for order-independence.
    ensureStringTy(&mut cg)
    ensureVecTy(&mut cg)
    ensureHashMapTy(&mut cg)

    // Register global var types NOW (functions reference them); the `@name = global`
    // lines are EMITTED LATER, after struct/enum type decls, so a struct-typed global
    // (`var o: Point = …`) doesn't forward-reference an as-yet-undeclared %Point.
    for gi in 0..mod.globals.len {
        let surfaceTy = tyStr(cg, mod.globals[gi].ty, "global '" + mod.globals[gi].name.clone() + "'")
        cg.globalVars.insert(mod.globals[gi].name.clone(), surfaceTy)
    }

    // Register function return types. Generic templates never reach here — lowering
    // emits only their monomorphized instantiations.
    for i in 0..mod.functions.len {
        cg.fnRets.insert(mod.functions[i].name.clone(), tyStr(cg, mod.functions[i].retType, "return type of '" + mod.functions[i].name.clone() + "'"))
    }

    // Register interfaces EARLY (name + itable-slot layout) so struct-field and other
    // type resolution below collapses Heap<Interface> → the %Iface fat pointer. Trait
    // decls are still read as syntax: the checker keeps no per-slot method order.
    for ti in 0..mod.astTraits.len {
        let tn = mod.astTraits[ti].name.clone()
        cg.interfaces.insert(tn.clone(), true)
        var slots: Vec<FieldInfo> = Vec.new()
        for mi in 0..mod.astTraits[ti].methods.len {
            slots.push(FieldInfo {
                name: mod.astTraits[ti].methods[mi].name.clone(), ty: resolveTyStr(cg, astTypeStr(mod.astTraits[ti].methods[mi].retType)), range: noRange()
            })
        }
        cg.structs.insert(tn.clone(), slots)
    }

    // Enum/struct sizing needs ALL metadata registered first: an enum payload can
    // be a struct (Option<Info>) and vice-versa, and mono enums are appended after
    // the structs they wrap. So: (1) register enum variant metadata, (2) register
    // struct fields, (3) size + emit enums, (4) emit structs. Sizing (payloadBytes)
    // then sees every type regardless of declaration order.

    // (1) enum metadata — slots filled in phase 3
    for ei in 0..mod.enums.len {
        var variants: Vec<CgVariantInfo> = Vec.new()
        for vi in 0..mod.enums[ei].variants.len {
            var payloadTypes: Vec<string> = Vec.new()
            for fi in 0..mod.enums[ei].variants[vi].fields.len {
                payloadTypes.push(tyStr(cg, mod.enums[ei].variants[vi].fields[fi], "payload of " + mod.enums[ei].name.clone() + "." + mod.enums[ei].variants[vi].name.clone()))
            }
            variants.push(CgVariantInfo {
                name: mod.enums[ei].variants[vi].name.clone(), tag: mod.enums[ei].variants[vi].tag as i32, payloadTypes: payloadTypes
            })
        }
        cg.enums.insert(mod.enums[ei].name.clone(), CgEnumInfo {
            name: mod.enums[ei].name.clone(), variants: variants, payloadSlots: 0
        })
    }

    // (2) struct metadata. Register all struct NAMES first, so a field that references
    // a struct declared later in the list (e.g. Dom { arena: Arena<Node> } before
    // Arena_Node's own decl) still resolves.
    for si in 0..mod.structs.len {
        cg.structs.insert(mod.structs[si].name.clone(), Vec.new())
    }
    for si in 0..mod.structs.len {
        let sname = mod.structs[si].name.clone()
        var fields: Vec<FieldInfo> = Vec.new()
        for fi in 0..mod.structs[si].fields.len {
            fields.push(FieldInfo {
                name: mod.structs[si].fields[fi].name.clone(),
                ty: fieldTyStr(cg, sname, mod.structs[si].fields[fi].name, mod.structs[si].fields[fi].ty),
                range: rangeOfTyK(mod.structs[si].fields[fi].ty),
            })
        }
        cg.structs.insert(sname, fields)
    }

    // Native struct-by-value C ABI: mark extern fns that pass/return a bare struct
    // by value (a `&Struct`/`*Struct`/`[N]Struct` crosses by reference already). Their
    // declares + call sites go through the abi.milo classifier (HFA/coerce/byval/sret).
    cg.arch = getHostTarget().arch
    for i in 0..mod.functions.len {
        if !mod.functions[i].isExtern {
            continue
        }
        var wantsAbi = isByValStruct(cg, mod.functions[i].retType, false)
        for pi in 0..mod.functions[i].params.len {
            let byRef = mod.functions[i].params[pi].isRef || mod.functions[i].params[pi].isRefMut
            if isByValStruct(cg, mod.functions[i].params[pi].ty, byRef) {
                wantsAbi = true
            }
        }
        if wantsAbi {
            cg.abiExterns.insert(mod.functions[i].name.clone(), true)
        }
    }

    // (3) size enums (payloadBytes sees all metadata now) + emit their decls
    for ei in 0..mod.enums.len {
        let ename = mod.enums[ei].name.clone()
        if !cg.enums.contains(ename) {
            continue
        }
        let einfo = cg.enums.get(ename)!
        // Ask payloadBytes for the size instead of re-deriving it here. This loop
        // used to walk the variants itself, which made two implementations of one
        // rule — and they drifted: this copy resolved generic instance names before
        // measuring and payloadBytes' own recursion did not, so the two disagreed
        // about the size of the very same enum and Option<TypeKind> came out a slot
        // short. One rule, one implementation, nothing left to keep in sync.
        // payloadBytes returns the whole enum (payload rounded to a word + one tag
        // word), so subtract the tag to get the payload slots.
        let slots = (payloadBytes(cg, ename) - 8) / 8
        // move einfo's owned fields back in with the computed slot count (no clone)
        cg.enums.insert(ename.clone(), CgEnumInfo {
            name: einfo.name, variants: einfo.variants, payloadSlots: slots
        })
        if slots > 0 {
            emitG(&mut cg, "%" + ename + " = type { i32, [" + slots.toString() + " x i64] }\n")
        } else {
            emitG(&mut cg, "%" + ename + " = type { i32 }\n")
        }
    }

    // (4) emit struct decls (reference enum types emitted in phase 3)
    for si in 0..mod.structs.len {
        let sname = mod.structs[si].name.clone()
        if !cg.structs.contains(sname) {
            continue
        }
        let sfields = cg.structs.get(sname)!
        var llStruct = "{ "
        for fi in 0..sfields.len {
            if fi > 0 {
                llStruct = llStruct + ", "
            }
            llStruct = llStruct + llType(sfields[fi].ty)
        }
        llStruct = llStruct + " }"
        emitG(&mut cg, "%" + sname + " = type " + llStruct + "\n")
    }

    // Interfaces (traits used as types) are trait objects — a fat pointer
    // `%Iface = type { ptr data, ptr itable }`. The name/slots were registered early
    // (before struct fields, so Heap<Iface> fields collapse); emit the type decl now.
    for ti in 0..mod.astTraits.len {
        emitG(&mut cg, "%" + mod.astTraits[ti].name.clone() + " = type { ptr, ptr }\n")
    }

    // Module-level global initializers — emitted here so struct/enum/%Vec/%String
    // types they reference are already declared above. Anything the static paths below
    // cannot express is collected for the runtime initializer.
    var dynIdx: Vec<i64> = Vec.new()
    for gi in 0..mod.globals.len {
        let surfaceTy = tyStr(cg, mod.globals[gi].ty, "global '" + mod.globals[gi].name.clone() + "'")
        let gname = mod.globals[gi].name.clone()
        match (*mod.globals[gi].value).kind {
            HExpr.Unlowered(av) => {
                if emitGlobalStatic(&mut cg, gname, surfaceTy, *av) {
                    dynIdx.push(gi)
                }
            }
            _ => {
                hexprAbort(*mod.globals[gi].value, "global '" + gname.clone() + "' initializer")
            }
        }
    }

    // Globals whose initializer is not a compile-time constant get a runtime initializer,
    // run from main before any user code. Emitted in DEPENDENCY order, not source order:
    // `let FRAG = "head|" + TAIL` may be written above `TAIL`, and evaluating it first
    // would read a zeroed string. Without this whole pass such a global stayed
    // zeroinitializer forever and printed as empty — a silent wrong answer, not an error.
    let sigs = buildFnTable(cg, mod.functions, mod.astGenericFns)
    if dynIdx.len > 0 {
        cg.needsGlobalInit = true
        // Insertion sort by dependency: a global is emitted only once every global it
        // names has been emitted. A cycle cannot be ordered, so the remaining ones go in
        // source order rather than looping forever — the checker is what should reject a
        // cyclic initializer.
        var ordered: Vec<i64> = Vec.new()
        var placed: HashMap<string, bool> = HashMap.new()
        var remaining = dynIdx.len
        while remaining > 0 {
            var progressed = false
            for k in 0..dynIdx.len {
                let gi = dynIdx[k]
                let nm = mod.globals[gi].name.clone()
                if placed.contains(nm) {
                    continue
                }
                var refs: Vec<string> = Vec.new()
                match (*mod.globals[gi].value).kind {
                    HExpr.Unlowered(av) => {
                        collectIdentsExpr(cg, *av, &mut refs)
                    }
                    _ => {
                    }
                }
                var ready = true
                for ri in 0..refs.len {
                    for k2 in 0..dynIdx.len {
                        let g2 = dynIdx[k2]
                        if mod.globals[g2].name == refs[ri] && !placed.contains(refs[ri]) {
                            ready = false
                        }
                    }
                }
                if ready {
                    ordered.push(gi)
                    placed.insert(nm, true)
                    remaining = remaining - 1
                    progressed = true
                }
            }
            if !progressed {
                for k in 0..dynIdx.len {
                    let gi = dynIdx[k]
                    if !placed.contains(mod.globals[gi].name) {
                        ordered.push(gi)
                        placed.insert(mod.globals[gi].name.clone(), true)
                        remaining = remaining - 1
                    }
                }
            }
        }
        emit(&mut cg, "define void @_milo_init_globals() {\n")
        emit(&mut cg, "entry.bb:\n")
        var initLocs: Vec<Local> = Vec.new()
        for oi in 0..ordered.len {
            let gi = ordered[oi]
            let surfaceTy = tyStr(cg, mod.globals[gi].ty, "global '" + mod.globals[gi].name.clone() + "'")
            let v = genHExpr(&mut cg, *mod.globals[gi].value, initLocs, sigs, surfaceTy.clone())
            emit(&mut cg, "  store " + llType(surfaceTy) + " " + v.v + ", ptr @" + mod.globals[gi].name.clone() + "\n")
        }
        emit(&mut cg, "  ret void\n")
        emit(&mut cg, "}\n\n")
    }

    // Emit all functions
    for j in 0..mod.functions.len {
        genFn(&mut cg, mod.functions[j], sigs)
    }

    return cg.globals + "\n" + cg.body
}
