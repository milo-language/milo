// Codegen types, state, and LLVM type mapping
from "src-milo/tokens.milo" import {
    TokKind
}
from "src-milo/ast.milo" import {
    MiloType, StructDecl, EnumDecl, Function
}
from "src-milo/checker/types.milo" import {
    TypeKind
}
from "src-milo/hir.milo" import {
    HStmtBlock
}

// -- Value returned by expression codegen --

pub struct Val {
    v: string,
    ty: string,
}

// -- Range constraint carried by an annotation (`i32(0..100)`) --

// Codegen only ever knows types as LLVM strings, which have nowhere to put a
// bound — so the bound rides alongside, on whatever declared the value: the
// local, the parameter slot, the enclosing function's return type.
pub struct RangeAnno {
    has: bool,
    min: i64,
    max: i64,
}

pub fn noRange(): RangeAnno {
    return RangeAnno {
        has: false, min: 0, max: 0
    }
}

impl Clone for RangeAnno {
    fn clone(self: &Self): Self {
        return RangeAnno {
            has: self.has, min: self.min, max: self.max
        }
    }
}

// The range a spelled annotation resolves to, following type aliases
// (`type Altitude = i32(0..50000)`). A wrapper — array, pointer, reference —
// means the value being stored is not the constrained scalar, so no range
// applies. The depth cap is a guard against a cyclic alias chain, which the
// checker should have rejected long before here.
pub fn rangeOfAnnotation(cg: &Cgen, ty: &MiloType): RangeAnno {
    var cur = ty.clone()
    var depth = 0
    while depth < 16 {
        if cur.isArray || cur.ptrDepth > 0 || cur.isRef || cur.isRefMut || cur.isFn {
            return noRange()
        }
        match cur.rangeMin {
            Option.Some(lo) => {
                match cur.rangeMax {
                    Option.Some(hi) => {
                        return RangeAnno {
                            has: true, min: lo, max: hi
                        }
                    }
                    Option.None => {
                    }
                }
            }
            Option.None => {
            }
        }
        if cur.typeArgs.len > 0 || !cg.typeAliases.contains(cur.name) {
            return noRange()
        }
        cur = cg.typeAliases.get(cur.name)!
        depth = depth + 1
    }
    return noRange()
}

// The bound a CHECKER type carries. A ranged int is the same TInt tag with its two ends
// attached, so this is a read; rangeOfAnnotation, by contrast, has to chase the alias
// table through the syntax to recover the same two numbers.
pub fn rangeOfTyK(t: &TypeKind): RangeAnno {
    match t {
        TypeKind.TInt(bits, signed, lo, hi) => {
            match lo {
                Option.Some(l) => {
                    match hi {
                        Option.Some(h) => {
                            return RangeAnno {
                                has: true, min: l, max: h
                            }
                        }
                        Option.None => {
                        }
                    }
                }
                Option.None => {
                }
            }
            return noRange()
        }
        _ => {
            return noRange()
        }
    }
}

pub fn rangeOfOptAnnotation(cg: &Cgen, ty: &Option<MiloType>): RangeAnno {
    match ty {
        Option.Some(t) => {
            return rangeOfAnnotation(cg, t)
        }
        Option.None => {
            return noRange()
        }
    }
}

// -- Local variable in scope --

pub struct Local {
    name: string,
    ty: string,
    addr: string,
    // ref params are borrows — never dropped by this scope (a drop hook's own
    // &mut self param used to recurse into itself forever)
    isRef: bool,
    // Declared as a fixed-size array (`[T; N]`) rather than a real growable Vec —
    // both lower onto the same %Vec {ptr,len,cap} runtime shape (same `ty` string),
    // so this bit is the ONLY way genOwnedArg can tell them apart at a pass-by-
    // value site. The checker only accepts an array-typed binding whose element
    // is Copy (tests/errors/arrayNonCopyMove.milo enforces the rest), so any
    // local reaching codegen with this set is always safe to deep-clone instead
    // of move.
    isArr: bool,
    // Bound this binding was declared with, so writing THROUGH the name
    // (`p = x`) re-checks it, not just the initializer.
    range: RangeAnno,
}

// -- Function signature for call-site type lookup --

pub struct CgFnSig {
    name: string,
    retTy: string,
    paramTys: Vec<string>,
    paramRefs: Vec<bool>,
    isVariadic: bool,
    // Index-aligned with paramTys: the bound each parameter slot declared, so a
    // call site can check the argument before it is passed.
    paramRanges: Vec<RangeAnno>,
}

// -- Struct field info --

pub struct FieldInfo {
    name: string,
    ty: string,
    // Bound the field was declared with, checked when something is written into
    // it (`p.pct = n`).
    range: RangeAnno,
}

// -- Enum variant info --

pub struct CgVariantInfo {
    name: string,
    tag: i32,
    payloadTypes: Vec<string>,
}

pub struct CgEnumInfo {
    name: string,
    variants: Vec<CgVariantInfo>,
    payloadSlots: i64,
}

// -- Codegen state --

pub struct Cgen {
    // The CURRENT function's text. genFn emits here instead of straight into `body` so the
    // alloca-hoisting rewrite only ever touches one function's worth of string, then
    // appends it once. Rewriting in place inside `body` meant copying the whole accumulated
    // module per function — quadratic, and it leaked every intermediate buffer (measured:
    // 4.4 MB of `realloc in emit` plus 4.6 MB of `malloc in genFn` on a 7-line fixture).
    fnBuf: string,
    inFn: bool,
    // Target OS, used to fold `@targetOs()` to a literal at codegen time. milo0 does not
    // cross-compile, so this is the host.
    targetOs: string,
    body: string,
    globals: string,
    temp: i64,
    label: i64,
    strId: i64,
    // Type lookup tables (replaces old string-encoded DBs)
    fnRets: HashMap<string, string>,
    externFns: HashMap<string, bool>,
    interfaces: HashMap<string, bool>,
    itableEmitted: HashMap<string, bool>,
    structs: HashMap<string, Vec<FieldInfo>>,
    enums: HashMap<string, CgEnumInfo>,
    // module-level global constants: name -> llvm type (referenced via @name)
    globalVars: HashMap<string, string>,
    // Loop labels for break/continue
    curBreakLbl: string,
    // enclosing fn's resolved return type string — `?` builds the early
    // return from it
    curRetTy: string,
    // enclosing fn's declared return bound, checked at every `return`
    curRetRange: RangeAnno,
    curContLbl: string,
    // the block label most recently opened via emitLabel — a branch value's phi
    // predecessor is wherever control actually is, not the static then/else label
    // (a nested if-expr in a branch ends in ITS own block).
    curBlock: string,
    // Deduplication flags for extern declarations
    declaredPrintf: bool,
    declaredPutchar: bool,
    declaredMalloc: bool,
    declaredMemcpy: bool,
    declaredMemcmp: bool,
    declaredStringTy: bool,
    declaredSnprintf: bool,
    declaredFloatFmt: bool,
    declaredFloatFmt32: bool,
    // @milo.strfind — naive substring search shared by every `lines()`/`splitView()`
    // for-in loop
    declaredStrFind: bool,
    // Set when some global has an initializer that is not a compile-time constant, so
    // main knows to call the runtime initializer before any user code runs.
    needsGlobalInit: bool,
    declaredVecTy: bool,
    declaredRealloc: bool,
    declaredHashMapTy: bool,
    declaredExit: bool,
    declaredStrtod: bool,
    declaredStrlen: bool,
    declaredDprintf: bool,
    declaredFflush: bool,
    declaredFree: bool,
    // monotonic id for lifted closure function names (@__closure_N)
    closureId: i64,
    // return type recorded while emitting an unannotated closure body (its
    // `return <e>` uses the value's own type and stamps it here for the header)
    closureRetTy: string,
    // directory of the source file, for embedFile() compile-time path resolution
    sourceDir: string,
    // names of fn->closure adapter thunks already emitted (dedup)
    emittedThunks: Vec<string>,
    // host arch ("aarch64"/"x86_64") for native struct-by-value C ABI classification
    arch: string,
    // extern fns needing struct-by-value ABI lowering: name -> "1" (presence marker)
    abiExterns: HashMap<string, bool>,
    // names of emitted drop-helper fns (milo.drop.struct.X / .enum.X) — dedup
    dropHelpers: Vec<string>,
    // locals, scoped to the function/closure body currently being generated, that a
    // `return <name>` escapes by identity (bound to a closure literal earlier in the
    // same body). Populated by a pre-scan before the body is walked, so the LetDecl
    // that creates the closure — which runs BEFORE the later Return is seen in this
    // single forward pass — already knows to heap-allocate its captures instead of
    // pointing them at a frame that is about to be torn down.
    forceMoveClosures: Vec<string>,
    // Element type (Milo source syntax, e.g. "i64" / "string" / "ZipEntry") for an
    // unannotated `var v = Vec.new()` / `Vec.withCapacity(n)`, keyed by local name.
    // Populated by a pre-scan (see inferVecPushHints) before the body is walked, for
    // the same single-forward-pass reason as forceMoveClosures above: the LetDecl/
    // VarDecl that creates the Vec runs BEFORE the later `v.push(x)` that reveals its
    // element type. Without this, an unannotated Vec.new() always got %Vec's default
    // element (i64) baked into its declared type, so pushing anything else compiled
    // to a byte-width mismatch instead of a diagnostic — the checker independently
    // agrees on the SAME first-push inference (checker/expr.milo checkMethodCall), so
    // the two disagreeing here would be a silent memory-layout bug, not a rejection.
    vecPushHints: HashMap<string, string>,
    // Param-type hint for the closure about to be gen'd (index-aligned with its
    // params), set by a caller that knows the expected type (e.g. Option/Result
    // combinators know the payload type) right before genExpr on the closure expr.
    // genClosure falls back to this ONLY for an unannotated param — codegen has no
    // HIR carrying the checker's inferred type, so without this an untyped closure
    // param silently defaults to i32 (wrong for anything wider, and fatal for a
    // struct/string field access, which is exactly what these combinators need).
    closureParamHint: Vec<string>,
    // Whole-closure RETURN-type hint, for the rare case where the caller knows the
    // exact expected type even though the closure itself is unannotated (e.g.
    // Option<T>.orElse's callback must return this SAME Option<T> — T can't
    // change). Needed because an unannotated `() => Option.None` has zero payload
    // args, so genEnumLit's own bottom-up "infer from the payload" fallback has
    // nothing to look at and would otherwise misroute to a nonexistent static
    // method call. Empty = no hint (the ordinary unannotated-closure inference
    // path runs instead).
    closureRetHint: string,
    // addresses of locals move-zeroed by genOwnedArg (Ident branch), within the
    // CURRENT function only — reset at each genFn start alongside temp/label.
    // A user `impl Drop` has no null/cap sentinel to guard on (unlike Vec/String/
    // Heap, whose zeroed state IS "nothing to free"), so without this a value
    // moved into a Vec/call/push and then scope-dropped at its old slot's exit
    // runs the user's drop() a second time — dropAccounting's viaLocal-push
    // shape counted 5 phantom drops from exactly this. Address strings are safe
    // to compare only because the checker enforces no-partial-move: a program
    // that type-checks never reads/re-drops a local on a path where it wasn't
    // ALSO moved on every path reaching that point.
    movedLocalAddrs: Vec<string>,
    // locs.len at the innermost active loop's body start — break/continue drop
    // everything pushed since then (mirrors emitScopeDrops at a normal loop-body
    // end), same idea as curBreakLbl/curContLbl. -1 outside any loop.
    curLoopScopeLen: i64,
    // names of emitted `llvm.fptosi.sat.*`/`llvm.fptoui.sat.*` declares (dedup) —
    // one per distinct (op, toTy, fromTy) combo actually used, mirrors emittedThunks.
    declaredFpSat: Vec<string>,
    // `type Name = <base>` aliases, name -> raw (unresolved) base MiloType. astTypeStr
    // has no alias awareness (it works off the bare AST, same as the checker's own
    // typeFromAst) — resolveTyStr is what expands a bare alias NAME to its base type
    // string, mirroring checker's resolveAstType: the alias body is substituted, but
    // any `*`/ptrDepth wrapper at the USE site is preserved around the substitution.
    typeAliases: HashMap<string, MiloType>,
    declaredAbort: bool,
    // Whether the function CURRENTLY being generated carries `@wrapping` (directly, or
    // inherited from a file-level `@!wrapping` — see parser.milo). Set at the top of
    // genFn from `f.attributes`, read by every runtime-safety check below that has a
    // defined wrapping behavior (checked arith skips its trap and falls through to the
    // plain instruction; div-by-zero still traps, since there is no modular value for
    // x/0; shift still traps too — mirrors src/codegen.ts's currentFnWrapping).
    currentFnWrapping: bool,
    // Statement blocks lifted out of expression-position Closure/IfExpr/MatchExpr nodes,
    // moved here from the HIR module. Fixed for the whole run: codegen only ever takes a
    // block out to walk it and puts the same one back.
    stmtBlocks: Vec<HStmtBlock>,
    // Owning ExprNode id -> index of its first block (see HIRModule.stmtBlockAt).
    stmtBlockAt: HashMap<u32, i64>,
}

pub fn cgenNew(): Cgen {
    return Cgen {
        fnBuf: "",
        inFn: false,
        targetOs: "",
        body: "",
        globals: "",
        temp: 0,
        label: 0,
        strId: 0,
        fnRets: HashMap.new(),
        externFns: HashMap.new(),
        interfaces: HashMap.new(),
        itableEmitted: HashMap.new(),
        structs: HashMap.new(),
        enums: HashMap.new(),
        globalVars: HashMap.new(),
        curBreakLbl: "",
        curRetTy: "",
        curRetRange: noRange(),
        curContLbl: "",
        curBlock: "",
        declaredPrintf: false,
        declaredPutchar: false,
        declaredMalloc: false,
        declaredMemcpy: false,
        declaredMemcmp: false,
        declaredStringTy: false,
        declaredSnprintf: false,
        declaredFloatFmt: false,
        declaredFloatFmt32: false,
        declaredStrFind: false,
        needsGlobalInit: false,
        declaredVecTy: false,
        declaredRealloc: false,
        declaredHashMapTy: false,
        declaredExit: false,
        declaredStrtod: false,
        declaredStrlen: false,
        declaredDprintf: false,
        declaredFflush: false,
        declaredFree: false,
        closureId: 0,
        closureRetTy: "",
        sourceDir: "",
        emittedThunks: Vec.new(),
        arch: "aarch64",
        abiExterns: HashMap.new(),
        dropHelpers: Vec.new(),
        forceMoveClosures: Vec.new(),
        vecPushHints: HashMap.new(),
        closureParamHint: Vec.new(),
        closureRetHint: "",
        movedLocalAddrs: Vec.new(),
        curLoopScopeLen: -1,
        declaredFpSat: Vec.new(),
        typeAliases: HashMap.new(),
        declaredAbort: false,
        currentFnWrapping: false,
        stmtBlocks: Vec.new(),
        stmtBlockAt: HashMap.new(),
    }
}

// Has this address been recorded as move-zeroed (this function only)?
pub fn addrWasMoved(cg: &Cgen, addr: &string): bool {
    for i in 0..cg.movedLocalAddrs.len {
        if cg.movedLocalAddrs[i] == addr {
            return true
        }
    }
    return false
}

// -- Helpers --

pub fn nextTemp(cg: &mut Cgen): string {
    let n = cg.temp
    cg.temp = cg.temp + 1
    // Leading dot: LLVM accepts it in a local name, Milo does not accept it in an
    // identifier. Without it a parameter named `t0` collided with the temp counter's
    // `%t0` and LLVM rejected the whole module.
    return "%.t" + n.toString()
}

pub fn nextLabel(cg: &mut Cgen, base: string): string {
    let n = cg.label
    cg.label = cg.label + 1
    return base + n.toString()
}

pub fn emit(cg: &mut Cgen, s: &string) {
    if cg.inFn {
        cg.fnBuf = cg.fnBuf + s
        return
    }
    cg.body = cg.body + s
}

// Open a basic block and record it as the current block (for phi predecessors).
pub fn emitLabel(cg: &mut Cgen, lbl: &string) {
    // Must go through emit(), not straight to `body`: inside a function the text belongs in
    // fnBuf, and writing here directly dumped block labels at module top level.
    emit(&mut cg, lbl.clone() + ":\n")
    cg.curBlock = lbl.clone()
}

pub fn emitG(cg: &mut Cgen, s: &string) {
    cg.globals = cg.globals + s
}

pub fn ensureStringTy(cg: &mut Cgen) {
    if !cg.declaredStringTy {
        emitG(&mut cg, "%String = type { ptr, i64, i64 }\n")
        cg.declaredStringTy = true
    }
}

pub fn ensureMalloc(cg: &mut Cgen) {
    if !cg.declaredMalloc {
        emitG(&mut cg, "declare ptr @malloc(i64)\n")
        cg.declaredMalloc = true
    }
}

pub fn ensureMemcpy(cg: &mut Cgen) {
    if !cg.declaredMemcpy {
        emitG(&mut cg, "declare ptr @memcpy(ptr, ptr, i64)\n")
        cg.declaredMemcpy = true
    }
}

pub fn ensureMemcmp(cg: &mut Cgen) {
    if !cg.declaredMemcmp {
        emitG(&mut cg, "declare i32 @memcmp(ptr, ptr, i64)\n")
        cg.declaredMemcmp = true
    }
}

pub fn ensurePutchar(cg: &mut Cgen) {
    if !cg.declaredPutchar {
        emitG(&mut cg, "declare i32 @putchar(i32)\n")
        cg.declaredPutchar = true
    }
}

// `declare @free`, shared with any explicit `extern fn free` via declaredFree.
pub fn ensureFree(cg: &mut Cgen) {
    if !cg.declaredFree {
        emitG(&mut cg, "declare void @free(ptr)\n")
        cg.declaredFree = true
    }
}

// A raw `fptosi`/`fptoui` is poison (UB) when the source doesn't fit the target
// or is NaN — mirrors src/codegen.ts's fpSatIntrinsics: use LLVM's saturating
// variant instead, so a float->int cast is total (out-of-range clamps to the
// target's min/max, NaN -> 0), matching Rust's post-1.45 `as` semantics.
// Returns the bare intrinsic name (no leading '@'); declares it once per
// distinct (op, toTy, fromTy) combo.
pub fn ensureFpSat(cg: &mut Cgen, opBase: string, toLl: string, fromLl: string): string {
    var fpSuffix = "f32"
    if fromLl == "double" {
        fpSuffix = "f64"
    }
    let name = "llvm." + opBase.clone() + ".sat." + toLl.clone() + "." + fpSuffix
    for i in 0..cg.declaredFpSat.len {
        if cg.declaredFpSat[i] == name {
            return name
        }
    }
    cg.declaredFpSat.push(name.clone())
    emitG(&mut cg, "declare " + toLl.clone() + " @" + name.clone() + "(" + fromLl.clone() + ")\n")
    return name
}

// -- Inline fixed-size array (struct FIELDS only — see astTypeStr) --
//
// A struct field of array type `[T; N]` lays out as a real LLVM `[N x T]`
// blob inline in the struct (so sizeOf/offsetOf match C). Locals/params of
// array type still lower onto the %Vec heap runtime (astTypeStr) — this
// marker exists ONLY on struct-field type strings, built at struct
// registration time (emit.milo). Encoding: "[" N "]" elemTyStr, e.g. "[3]i32".
// Leading '[' cannot collide with any other type-string prefix in this file.
pub fn isInlineArrTy(t: &string): bool {
    return t.len > 0 && t[0] == 91 // '['
}

pub fn inlineArrLen(t: &string): i64 {
    var i = 1
    var n: i64 = 0
    while i < t.len && t[i] != 93 { // ']'
        n = n * 10 + (t[i] - 48) as i64
        i = i + 1
    }
    return n
}

pub fn inlineArrElem(t: &string): string {
    var i = 1
    while i < t.len && t[i] != 93 { // ']'
        i = i + 1
    }
    return t[i + 1..t.len].clone()
}

// -- LLVM type mapping --

pub fn llType(t: &string): string {
    if isInlineArrTy(t) {
        return "[" + inlineArrLen(t).toString() + " x " + llType(inlineArrElem(t)) + "]"
    }
    if t == "i1" {
        return "i1"
    }
    if t == "i8" || t == "u8" {
        return "i8"
    }
    if t == "i16" || t == "u16" {
        return "i16"
    }
    if t == "i32" || t == "u32" {
        return "i32"
    }
    if t == "i64" || t == "u64" || t == "int" {
        return "i64"
    }
    if t == "f32" {
        return "float"
    }
    if t == "f64" || t == "float" {
        return "double"
    }
    // Idempotent on the LLVM float type: some Vals carry "double" directly (float
    // literals, float-op results). Without this, llType("double") hit the i32
    // fallback → a float arg emitted as `i32 3.5`.
    if t == "double" {
        return "double"
    }
    if t == "bool" {
        return "i1"
    }
    if t == "void" {
        return "void"
    }
    if t == "ptr" {
        return "ptr"
    }
    if t == "string" {
        return "%String"
    }
    // closures/fn-typed values are a { fnptr, envptr } fat pointer ("Closure:R"
    // and "fn:R" carry the return type for call-site disambiguation / retTy)
    if t == "fn" || t == "Closure" {
        return "%Closure"
    }
    if t.len >= 3 && t[0] == 102 && t[1] == 110 && t[2] == 58 {
        return "%Closure"
    }
    if t.len >= 8 && t[0] == 67 && t[1] == 108 && t[2] == 111 && t[3] == 115 && t[4] == 117 && t[5] == 114 && t[6] == 101 && t[7] == 58 {
        return "%Closure"
    }
    // Pointer types
    if t.len > 0 && t[0] == 42 {
        return "ptr"
    }
    // Heap<T>, Vec<T>, etc. — all pointer-shaped
    if t.len >= 5 && t[0] == 72 && t[1] == 101 && t[2] == 97 && t[3] == 112 && t[4] == 60 {
        return "ptr"
    }
    // Vec<T> — {data, len, cap}, like %String. Must precede the uppercase
    // user-struct rule below, which would otherwise yield "%Vec<T>".
    if isVecTy(t) {
        return "%Vec"
    }
    if isHashMapTy(t) {
        return "%HashMap"
    }
    // Already an LLVM type (%Name)
    if t.len > 0 && t[0] == 37 {
        return t.clone()
    }
    // Uppercase = user struct
    if t.len > 0 && t[0] >= 65 && t[0] <= 90 {
        return "%" + t.clone()
    }
    return "i32"
}

pub fn isUnsigned(t: &string): bool {
    if t.len < 1 {
        return false
    }
    return t[0] == 117 // 'u'
}

pub fn llTypeBytes(ll: &string): i64 {
    if ll == "i1" || ll == "i8" {
        return 1
    }
    if ll == "i16" {
        return 2
    }
    if ll == "i32" {
        return 4
    }
    if ll == "i64" || ll == "ptr" {
        return 8
    }
    // %String/%Vec/%HashMap are 3-word {ptr,i64,i64} = 24 bytes, NOT 8. Sizing
    // them as 8 undersizes any enum payload holding one (e.g. Result<string>),
    // truncating the string's len/cap → it reads back empty.
    if ll == "%String" || ll == "%Vec" || ll == "%HashMap" {
        return 24
    }
    return 8
}

// Natural alignment of a type — needed so struct/enum payload sizing inserts the
// same inter-field padding LLVM does. Structs align to their widest field; enums
// have an i64-array payload so align 8; scalars per their width.
pub fn alignOf(cg: &Cgen, pt: &string): i64 {
    // Array alignment == element alignment (C/LLVM: `[N x T]` has no extra
    // alignment beyond T's own).
    if isInlineArrTy(pt) {
        return alignOf(cg, inlineArrElem(pt))
    }
    let ll = llType(pt)
    if ll == "i1" || ll == "i8" {
        return 1
    }
    if ll == "i16" {
        return 2
    }
    if ll == "i32" {
        return 4
    }
    if ll == "%String" || ll == "%Vec" || ll == "%HashMap" {
        return 8
    }
    if ll.len > 0 && ll[0] == 37 {
        let raw = stripPercent(pt)
        if cg.enums.contains(raw) {
            return 8
        }
        if cg.structs.contains(raw) {
            var a: i64 = 1
            let fields = cg.structs.get(raw)!
            for i in 0..fields.len {
                let fa = alignOf(cg, fields[i].ty)
                if fa > a {
                    a = fa
                }
            }
            return a
        }
    }
    return 8
}

// Byte size of a payload type for enum-slot sizing — cg-aware so nested enums and
// structs (which llTypeBytes can't measure) get their real size, not the 8-byte
// fallback. Recursion terminates: recursive types go through Heap (a ptr, 8).
// Field offsets are aligned exactly as LLVM lays them out — summing raw field
// sizes undersizes any struct with mixed alignment (e.g. MiloType's i1s before an
// 8-aligned field), which overflows the enum payload slot and reads undef at -O2.
pub fn payloadBytes(cg: &Cgen, pt: &string): i64 {
    // Inline array: N contiguous elements, each padded to its own alignment
    // already (elements are never individually padded beyond that in C/LLVM).
    if isInlineArrTy(pt) {
        return inlineArrLen(pt) * payloadBytes(cg, inlineArrElem(pt))
    }
    let ll = llType(pt)
    if ll != "%String" && ll != "%Vec" && ll != "%HashMap" && ll.len > 0 && ll[0] == 37 {
        let raw = stripPercent(pt)
        if cg.enums.contains(raw) {
            // Recurse via variant payload TYPES (not the cached slot count) so this
            // is independent of registration order: enum size = biggest variant
            // payload rounded to a word, plus one tag word. Recursive types go
            // through Heap → ptr (8), so this terminates.
            let info = cg.enums.get(raw)!
            var mx: i64 = 0
            for vi in 0..info.variants.len {
                var s: i64 = 0
                var va: i64 = 1
                for pi in 0..info.variants[vi].payloadTypes.len {
                    // resolveTyStr FIRST — a payload written as a generic instance
                    // ("Option<i64>") is registered under its mangled name
                    // ("Option_i64"), so measuring the raw spelling finds neither an
                    // enum nor a struct and silently falls through to llTypeBytes'
                    // 8-byte default. The caller that emits the type decl already
                    // resolves; this recursion did not, so the two disagreed about
                    // the size of the very same type. TypeKind.TInt carries two
                    // Option<i64>s, each measured as 8 instead of 16 — which sized
                    // Option<TypeKind> one slot short and let a store run off the end
                    // of its alloca into the neighbouring local.
                    let pt2 = resolveTyStr(cg, info.variants[vi].payloadTypes[pi])
                    let fa = alignOf(cg, pt2)
                    if fa > va {
                        va = fa
                    }
                    s = ((s + fa - 1) / fa) * fa
                    s = s + payloadBytes(cg, pt2)
                }
                s = ((s + va - 1) / va) * va
                if s > mx {
                    mx = s
                }
            }
            return ((mx + 7) / 8) * 8 + 8
        }
        if cg.structs.contains(raw) {
            var total: i64 = 0
            var maxAlign: i64 = 1
            let fields = cg.structs.get(raw)!
            for i in 0..fields.len {
                // Same resolve-before-measure rule as the enum branch above: a field
                // typed with a generic instance is registered mangled.
                let ft = resolveTyStr(cg, fields[i].ty)
                let fa = alignOf(cg, ft)
                if fa > maxAlign {
                    maxAlign = fa
                }
                total = ((total + fa - 1) / fa) * fa
                total = total + payloadBytes(cg, ft)
            }
            return ((total + maxAlign - 1) / maxAlign) * maxAlign
        }
    }
    return llTypeBytes(ll)
}

pub fn intBits(t: &string): i64 {
    if t == "i1" {
        return 1
    }
    if t == "i8" || t == "u8" {
        return 8
    }
    if t == "i16" || t == "u16" {
        return 16
    }
    if t == "i32" || t == "u32" {
        return 32
    }
    if t == "i64" || t == "u64" {
        return 64
    }
    if t == "ptr" {
        return 64
    }
    return 0
}

pub fn unwrapHeap(t: &string): string {
    if t.len >= 6 && t[0] == 72 && t[1] == 101 && t[2] == 97 && t[3] == 112 && t[4] == 60 {
        return t[5..t.len - 1].clone()
    }
    return ""
}

// -- Table lookup helpers (HashMap-based) --

pub fn lookupFnRet(cg: &Cgen, name: &string): string {
    if cg.fnRets.contains(name) {
        return cg.fnRets.get(name)!
    }
    return "i32"
}

pub fn lookupFieldIndex(cg: &Cgen, structName: &string, fieldName: &string): i64 {
    if !cg.structs.contains(structName) {
        return -1 as i64
    }
    let fields = cg.structs.get(structName)!
    for i in 0..fields.len {
        if fields[i].name == fieldName {
            return i
        }
    }
    return -1 as i64
}

pub fn lookupFieldType(cg: &Cgen, structName: &string, idx: i64): string {
    if !cg.structs.contains(structName) {
        return "i32"
    }
    let fields = cg.structs.get(structName)!
    if idx >= 0 && idx < fields.len {
        return fields[idx].ty.clone()
    }
    return "i32"
}

pub fn lookupFieldRange(cg: &Cgen, structName: &string, idx: i64): RangeAnno {
    if !cg.structs.contains(structName) {
        return noRange()
    }
    let fields = cg.structs.get(structName)!
    if idx >= 0 && idx < fields.len {
        return fields[idx].range.clone()
    }
    return noRange()
}

// The `@iter` field name on this struct, if it has one — `for x in wrapper`
// should walk this field's runtime value instead of the wrapper itself. See
// genForIn, which extracts the field from the already-evaluated struct Val.
// Does this enum have this variant, and what is its tag? Option, not a -1 sentinel: an
// explicit discriminant may legitimately BE -1 (`enum Signed: i32 { Neg = -1, … }`), and a
// sentinel makes that variant indistinguishable from "no such variant" — its constructor
// then compiles to a call to an undefined function, or silently to tag 0.
//
// EVERY existence test must go through this. `lookupVariantTag` below is the convenience
// form for the many call sites that have already established the variant exists and only
// want its number; it is never correct to test that result for existence.
pub fn variantTagOpt(cg: &Cgen, enumName: &string, variantName: &string): Option<i32> {
    if !cg.enums.contains(enumName) {
        return Option.None
    }
    let info = cg.enums.get(enumName)!
    for i in 0..info.variants.len {
        if info.variants[i].name == variantName {
            return Option.Some(info.variants[i].tag)
        }
    }
    return Option.None
}

pub fn lookupVariantTag(cg: &Cgen, enumName: &string, variantName: &string): i32 {
    match variantTagOpt(cg, enumName, variantName) {
        Option.Some(t) => {
            return t
        }
        Option.None => {
            return -1
        }
    }
}

pub fn lookupVariantPayload(cg: &Cgen, enumName: &string, variantName: &string): Vec<string> {
    if !cg.enums.contains(enumName) {
        return Vec.new()
    }
    let info = cg.enums.get(enumName)!
    for i in 0..info.variants.len {
        if info.variants[i].name == variantName {
            // Payloads are stored with full args but UNMANGLED (a mono enum like
            // Option_i64 isn't registered yet when its container registers). Mangle
            // here at read-time — codegen of bodies runs after all registration, so
            // generic instantiations now resolve to their mono decl (%Option_i64).
            var out: Vec<string> = Vec.new()
            for j in 0..info.variants[i].payloadTypes.len {
                out.push(resolveTyStr(cg, info.variants[i].payloadTypes[j]))
            }
            return out
        }
    }
    return Vec.new()
}

pub fn lookupEnumPayloadSlots(cg: &Cgen, enumName: &string): i64 {
    if !cg.enums.contains(enumName) {
        return 0
    }
    return cg.enums.get(enumName)!.payloadSlots
}

// Strip leading '%' from LLVM type to get raw struct name
pub fn stripPercent(ty: &string): string {
    if ty.len > 0 && ty[0] == 37 {
        return ty[1..ty.len].clone()
    }
    return ty.clone()
}

// -- Operator helpers --

pub fn binOpInt(op: &string, unsigned: bool): string {
    if op == "+" {
        return "add"
    }
    if op == "-" {
        return "sub"
    }
    if op == "*" {
        return "mul"
    }
    if op == "/" {
        return if unsigned {
            "udiv"
        } else {
            "sdiv"
        }
    }
    if op == "%" {
        return if unsigned {
            "urem"
        } else {
            "srem"
        }
    }
    if op == "&" {
        return "and"
    }
    if op == "|" {
        return "or"
    }
    if op == "^" {
        return "xor"
    }
    if op == "<<" {
        return "shl"
    }
    if op == ">>" {
        return if unsigned {
            "lshr"
        } else {
            "ashr"
        }
    }
    return ""
}

pub fn cmpOpInt(op: &string, unsigned: bool): string {
    if op == "==" {
        return "eq"
    }
    if op == "!=" {
        return "ne"
    }
    if op == "<" {
        return if unsigned {
            "ult"
        } else {
            "slt"
        }
    }
    if op == ">" {
        return if unsigned {
            "ugt"
        } else {
            "sgt"
        }
    }
    if op == "<=" {
        return if unsigned {
            "ule"
        } else {
            "sle"
        }
    }
    if op == ">=" {
        return if unsigned {
            "uge"
        } else {
            "sge"
        }
    }
    return ""
}

pub fn isArithOp(op: &string): bool {
    return op == "+" || op == "-" || op == "*" || op == "/" ||
    op == "%" || op == "&" || op == "|" || op == "^" ||
    op == "<<" || op == ">>"
}

pub fn isCmpOp(op: &string): bool {
    return op == "==" || op == "!=" || op == "<" || op == ">" ||
    op == "<=" || op == ">="
}

// -- Local variable lookup --

pub fn hasLocal(locs: &Vec<Local>, name: &string): bool {
    var i: i64 = locs.len - 1
    while i >= 0 {
        if locs[i].name == name {
            return true
        }
        i = i - 1
    }
    return false
}

pub fn findLocal(locs: &Vec<Local>, name: &string): Local {
    var i: i64 = locs.len - 1
    while i >= 0 {
        if locs[i].name == name {
            return locs[i]
        }
        i = i - 1
    }
    // Fallback — should not happen in valid programs
    return locs[0]
}

pub fn genLoad(cg: &mut Cgen, addr: &string, ty: &string): Val {
    let t = nextTemp(&mut cg)
    emit(&mut cg, "  " + t + " = load " + ty + ", ptr " + addr + "\n")
    return Val {
        v: t, ty: ty.clone()
    }
}

// "Vec<T>" — 'V','e','c','<'
pub fn isVecTy(t: &string): bool {
    return t.len >= 5 && t[0] == 86 && t[1] == 101 && t[2] == 99 && t[3] == 60
}

pub fn unwrapVec(t: &string): string {
    if isVecTy(t) {
        return t[4..t.len - 1].clone()
    }
    return t.clone()
}

pub fn ensureVecTy(cg: &mut Cgen) {
    if !cg.declaredVecTy {
        emitG(&mut cg, "%Vec = type { ptr, i64, i64 }\n")
        cg.declaredVecTy = true
    }
}

// milo-self compiles whole programs (no linking against oracle IR), so this
// %HashMap layout only has to be self-consistent — a flat unordered array of
// { K, V } entries, linear scan. O(n) per op is fine for bootstrap; the M4
// perf gate decides if it ever needs real hashing.
// "HashMap<" — 'H','a','s','h','M','a','p','<'
pub fn isHashMapTy(t: &string): bool {
    return t.len >= 9 && t[0] == 72 && t[1] == 97 && t[2] == 115 && t[3] == 104 &&
    t[4] == 77 && t[5] == 97 && t[6] == 112 && t[7] == 60
}

// top-level comma split of "HashMap<K, V>" (K/V may nest generics)
pub fn hashMapKeyTy(t: &string): string {
    let inner = t[8..t.len - 1]
    var depth = 0
    for i in 0..inner.len {
        let c = inner[i]
        if c == 60 {
            depth = depth + 1
        }
        if c == 62 {
            depth = depth - 1
        }
        if c == 44 && depth == 0 {
            return inner[0..i].clone()
        }
    }
    return "i64"
}

pub fn hashMapValTy(t: &string): string {
    let inner = t[8..t.len - 1]
    var depth = 0
    for i in 0..inner.len {
        let c = inner[i]
        if c == 60 {
            depth = depth + 1
        }
        if c == 62 {
            depth = depth - 1
        }
        if c == 44 && depth == 0 {
            var j = i + 1
            while j < inner.len && inner[j] == 32 {
                j = j + 1
            }
            return inner[j..inner.len].clone()
        }
    }
    return "i64"
}

pub fn hmEntryTy(keyTy: &string, valTy: &string): string {
    return "{ " + llType(keyTy) + ", " + llType(valTy) + " }"
}

// The AST still names generic types/fns by their base name ("Maybe", "pick");
// the registered decls are the monomorphized ones ("Maybe_i64"). With exactly
// one instantiation the base resolves unambiguously — multi-instantiation
// sites need type info the AST-directed codegen doesn't carry yet.
pub fn nameHasMonoPrefix(name: &string, base: &string): bool {
    if name.len <= base.len + 1 {
        return false
    }
    if name[base.len] != 95 {
        return false
    }
    for i in 0..base.len {
        if name[i] != base[i] {
            return false
        }
    }
    return true
}

pub fn resolveEnumName(cg: &Cgen, base: &string): string {
    if cg.enums.contains(base) {
        return base.clone()
    }
    var found = ""
    var count = 0
    for k, v in cg.enums {
        if nameHasMonoPrefix(k, base) {
            found = k.clone()
            count = count + 1
        }
    }
    if count == 1 {
        return found
    }
    return base.clone()
}

pub fn resolveStructName(cg: &Cgen, base: &string): string {
    if cg.structs.contains(base) {
        return base.clone()
    }
    var found = ""
    var count = 0
    for k, v in cg.structs {
        if nameHasMonoPrefix(k, base) {
            found = k.clone()
            count = count + 1
        }
    }
    if count == 1 {
        return found
    }
    return base.clone()
}

// A milo type string that still carries generic args ("Result<i32,string>")
// resolves to the registered mangled decl. Vec/HashMap/Heap keep their
// built-in lowering; everything else falls through unchanged.
// The built-in type names, spelled out. A capitalised unknown is a type parameter, not a
// struct, so no shape heuristic can stand in for this list.
pub fn isPrimitiveTyName(t: &string): bool {
    if t == "i8" || t == "i16" || t == "i32" || t == "i64" {
        return true
    }
    if t == "u8" || t == "u16" || t == "u32" || t == "u64" {
        return true
    }
    if t == "f32" || t == "f64" || t == "float" || t == "double" {
        return true
    }
    if t == "bool" || t == "string" || t == "String" || t == "char" {
        return true
    }
    if t == "void" || t == "ptr" || t == "fn" {
        return true
    }
    return false
}

// Does every type argument in a bracketed name denote something concrete?
//
// The discriminator between a generic TEMPLATE and a broken INSTANTIATION. `Wrapper<T>`
// carries a type parameter: `T` names no primitive and no registered decl, so the name is
// a template form and legitimately unregistered. `Option<Vec<u8>>` carries only concrete
// arguments, so if nothing is registered under it the backend rebuilt a name the checker
// never made — the bug astTypeStr's own comment warns about.
//
// Scans at bracket depth 1 so a nested `Vec<u8>` is examined as one argument.
pub fn typeArgsAllConcrete(cg: &Cgen, s: &string): bool {
    var depth: i64 = 0
    var cur = ""
    var seen = false
    var i: i64 = 0
    while i < s.len {
        let c = s[i]
        if c == 60 {
            depth = depth + 1
            if depth == 1 {
                i = i + 1
                continue
            }
        }
        if c == 62 {
            depth = depth - 1
            if depth == 0 {
                if cur.len > 0 && !argIsConcrete(cg, cur) {
                    return false
                }
                seen = true
                cur = ""
                i = i + 1
                continue
            }
        }
        if c == 44 && depth == 1 {
            if cur.len > 0 && !argIsConcrete(cg, cur) {
                return false
            }
            cur = ""
            i = i + 1
            continue
        }
        if depth >= 1 {
            cur = cur + s[i..i + 1].clone()
        }
        i = i + 1
    }
    return seen
}

// A single type argument names something the backend can point at.
fn argIsConcrete(cg: &Cgen, a: &string): bool {
    var bare = a.clone()
    while bare.len > 0 && bare[0] == 42 {
        bare = bare[1..bare.len].clone()
    }
    // A nested generic is concrete exactly when its own arguments are.
    for i in 0..bare.len {
        if bare[i] == 60 {
            return typeArgsAllConcrete(cg, bare)
        }
    }
    // Deliberately NOT llType: it maps any capitalised unknown to "%Name", so `T` came
    // back as "%T" and read as concrete — which is exactly backwards, since a bare
    // capital is the shape of a type parameter.
    if isPrimitiveTyName(bare) {
        return true
    }
    if cg.structs.contains(bare) || cg.enums.contains(bare) || cg.typeAliases.contains(bare) {
        return true
    }
    return false
}

pub fn resolveTyStr(cg: &Cgen, s: &string): string {
    // Vec/HashMap keep their built-in lowering, but their element types must still
    // mangle (Vec<Handle<Node>> → Vec<Handle_Node>) so unwrapVec/genSizeOf don't
    // later emit an unregistered `%Handle<Node>`.
    if isVecTy(s) {
        return "Vec<" + resolveTyStr(cg, unwrapVec(s)) + ">"
    }
    if isHashMapTy(s) {
        return s.clone()
    }
    var lt: i64 = -1
    for i in 0..s.len {
        if s[i] == 60 {
            lt = i
            break
        }
    }
    if lt <= 0 {
        // Type alias: the ptr depth belongs to the USE site (`*Board`), not the
        // alias body — strip the use site's stars, expand the bare name, then
        // reapply the same star depth (mirrors checker's resolveAstType). Ref-ness
        // never reaches this string at all: astTypeStr drops isRef/isRefMut
        // entirely, so a `&Board` param and a by-value `Board` already share this
        // same bare string — nothing extra to reapply for that case.
        var stars: i64 = 0
        var si: i64 = 0
        while si < s.len && s[si] == 42 {
            stars = stars + 1
            si = si + 1
        }
        let bare = s[si..s.len].clone()
        if cg.typeAliases.contains(bare) {
            let aliasBase = cg.typeAliases.get(bare)!
            var resolved = resolveTyStr(cg, astTypeStr(aliasBase))
            var k: i64 = 0
            while k < stars {
                resolved = "*" + resolved
                k = k + 1
            }
            return resolved
        }
        return s.clone()
    }
    let base = s[0..lt].clone()
    if base == "Heap" {
        // Heap<Interface> IS the interface fat pointer (data ptr is heap-allocated) —
        // collapse it to the interface so llType gives %Iface, not a plain ptr.
        let hinner = unwrapHeap(s)
        if cg.interfaces.contains(hinner) {
            return hinner.clone()
        }
        return s.clone()
    }
    // Exact mangling first: "Result<i32,string>" → "Result_i32_string" is the
    // checker's mangling scheme, so a registered decl matches directly even
    // when several instantiations exist. A pointer type ARG mangles to "ptr_" +
    // inner (mono.milo's mangleTypeName), not a literal '*' — a type arg like
    // `Result<*u8,string>` naively kept its star, producing "Result_*u8_string",
    // which never matched the checker's registered "Result_ptr_u8_string": the
    // `define` line for any fn returning such a type fell through to the raw
    // unmangled `%Result<*u8,string>`, which isn't valid LLVM syntax.
    var mangled = ""
    for i in 0..s.len {
        let c = s[i]
        if c == 60 || c == 44 {
            mangled = mangled + "_"
        } else if c == 62 || c == 32 {
        } else if c == 42 {
            mangled = mangled + "ptr_"
        } else {
            mangled.push(c)
        }
    }
    if cg.enums.contains(mangled) {
        return mangled
    }
    if cg.structs.contains(mangled) {
        return mangled
    }
    // Result<T> sugar mirrors the checker: E defaults to string
    if base == "Result" {
        let sugared = mangled + "_string"
        if cg.enums.contains(sugared) {
            return sugared
        }
    }
    let e = resolveEnumName(cg, base)
    if e != base {
        return e
    }
    let st = resolveStructName(cg, base)
    if st != base {
        return st
    }
    // Everything above failed, and `s` still carries a '<' — a bare primitive left
    // through the lt <= 0 branch far above, and Vec/HashMap returned before that. So this
    // is a generic instantiation that matches nothing the checker registered: not a
    // mangled decl, not Result sugar, not an enum, not a struct.
    //
    // Returning it unchanged is how `Option<Vec<u8>>` used to travel onward as a type
    // name nothing declares, surfacing much later as "unsupported method 'isSome' on
    // %Option<Vec<u8>>" or as invalid LLVM — a failure whose message points nowhere near
    // the reconstruction that caused it. The comment on astTypeStr describes this exact
    // bug and warns that any future attempt must consult the checker's mangling rather
    // than reconstruct it. This is that warning made enforceable.
    // A template form (`Wrapper<T>`) is legitimately unregistered — its type parameter is
    // still unbound, and monomorphization registers the instantiations, not the template.
    // A name whose arguments are ALL concrete is a different animal: something should be
    // registered under it, and nothing is.
    // "fn" and "fn:<ret>" are astTypeStr's own encoding for a function type, carried so an
    // indirect closure call can recover R. They are markers, not declarations, so nothing
    // is ever registered under them and their type arguments belong to the return type.
    var isFnMarker = false
    if s.len >= 3 && s[0..3].clone() == "fn:" {
        isFnMarker = true
    }
    if s == "fn" {
        isFnMarker = true
    }
    if !isFnMarker && typeArgsAllConcrete(cg, s) {
        eprint("internal error: '" + s.clone() + "' resolves to no registered type — the backend rebuilt a name the checker never registered")
        unsafe {
            exit(1)
        }
    }
    return s.clone()
}

// Prefer the checker's own monomorphization key — built structurally from the AST
// type, array size included — over the bracket-string round-trip in resolveTyStr.
// astTypeStr lowers a fixed array to "Vec<T>" for RUNTIME-representation purposes
// (a fixed array behaves like a %Vec at the value level), which loses the size and
// so produces a different string than the checker's "arr_T_N" mangling when the
// array sits inside a generic argument: `Option<[u8;16]>` must resolve to
// "Option_arr_u8_16" (what checker/mono.milo registered), but resolveTyStr's scan
// of the already-Vec-wrapped string can only reconstruct "Option_Vec_u8", which was
// never registered — the `define`/`global` line then fell through to the raw
// unresolved "Option<Vec<u8>>", which isn't valid LLVM. mangleAstTypeArg mirrors the
// checker's mangleTypeName exactly (including "arr_" + size), so try it FIRST and
// only fall back to the string path when it doesn't name a registered decl — Vec/
// Heap/HashMap keep their built-in (non-mangled) runtime representation.
pub fn resolveAstTy(cg: &Cgen, ty: &MiloType): string {
    if ty.typeArgs.len > 0 && ty.name != "Vec" && ty.name != "Heap" && ty.name != "HashMap" {
        let candidate = mangleAstTypeArg(ty)
        if cg.structs.contains(candidate) {
            return candidate
        }
        if cg.enums.contains(candidate) {
            return candidate
        }
    }
    return resolveTyStr(cg, astTypeStr(ty))
}

pub fn resolveFnName(cg: &Cgen, base: &string): string {
    if cg.fnRets.contains(base) {
        return base.clone()
    }
    var found = ""
    var count = 0
    for k, v in cg.fnRets {
        if nameHasMonoPrefix(k, base) {
            found = k.clone()
            count = count + 1
        }
    }
    if count == 1 {
        return found
    }
    return base.clone()
}

pub fn ensureHashMapTy(cg: &mut Cgen) {
    if !cg.declaredHashMapTy {
        emitG(&mut cg, "%HashMap = type { ptr, i64, i64 }\n")
        cg.declaredHashMapTy = true
    }
}

pub fn ensureExit(cg: &mut Cgen) {
    if !cg.declaredExit {
        emitG(&mut cg, "declare void @exit(i32)\n")
        cg.declaredExit = true
    }
}

pub fn ensureStrlen(cg: &mut Cgen) {
    if !cg.declaredStrlen {
        emitG(&mut cg, "declare i64 @strlen(ptr)\n")
        cg.declaredStrlen = true
    }
}

pub fn ensureStrtod(cg: &mut Cgen) {
    if !cg.declaredStrtod {
        emitG(&mut cg, "declare double @strtod(ptr, ptr)\n")
        cg.declaredStrtod = true
    }
}

pub fn ensureRealloc(cg: &mut Cgen) {
    if !cg.declaredRealloc {
        emitG(&mut cg, "declare ptr @realloc(ptr, i64)\n")
        cg.declaredRealloc = true
    }
}

pub fn ensureAbort(cg: &mut Cgen) {
    if !cg.declaredAbort {
        emitG(&mut cg, "declare void @abort()\n")
        cg.declaredAbort = true
    }
}

pub fn ensureDprintf(cg: &mut Cgen) {
    if !cg.declaredDprintf {
        emitG(&mut cg, "declare i32 @dprintf(i32, ptr, ...)\n")
        cg.declaredDprintf = true
    }
}

pub fn ensureFflush(cg: &mut Cgen) {
    if !cg.declaredFflush {
        emitG(&mut cg, "declare i32 @fflush(ptr)\n")
        cg.declaredFflush = true
    }
}

// Byte size of an LLVM type, computed by the compiler rather than a table —
// %String and user structs have no fixed size we can hardcode.
pub fn genSizeOf(cg: &mut Cgen, llTy: &string): string {
    let p = nextTemp(&mut cg)
    emit(&mut cg, "  " + p + " = getelementptr " + llTy.clone() + ", ptr null, i32 1\n")
    let n = nextTemp(&mut cg)
    emit(&mut cg, "  " + n + " = ptrtoint ptr " + p + " to i64\n")
    return n
}

// Render an AST type back to milo0's internal type-name string. codegen keys
// everything off these strings (llType, unwrapVec, unwrapHeap), and a bare
// `ty.name` drops the type arguments -- `Vec<string>` would arrive as "Vec" and
// its elements would be sized as i64.
// Mirrors checker/mono.milo's mangleTypeName (which mangles a *resolved*
// TypeKind) but works off the raw MiloType AST, since codegen never sees the
// checker's resolved types for a global's declared annotation (main.milo
// hands codegen `resolved` — the pre-check AST — plus the checker's
// monomorphized decls appended; globals themselves are never rewritten).
// Always flat (Container_Arg1_Arg2, no angle brackets) — used both for a
// user-generic's own args and, recursively, for Vec/Heap/HashMap when THEY
// appear as an argument rather than the outermost type.
pub fn mangleAstTypeArg(ty: &MiloType): string {
    if ty.isFn {
        var s = "fn"
        for i in 0..ty.fnParams.len {
            s = s + "_" + mangleAstTypeArg(ty.fnParams[i])
        }
        match ty.fnRet {
            Option.Some(r) => {
                s = s + "_ret_" + mangleAstTypeArg(*r)
            }
            Option.None => {
                s = s + "_ret_void"
            }
        }
        return s
    }
    // ptrDepth, not a bool: `**u8` must mangle to two levels. An `isPtr` flag here would
    // give `*u8` and `**u8` the SAME mangled name and silently merge two distinct
    // monomorphizations.
    if ty.ptrDepth > 0 {
        var inner = ty.clone()
        inner.ptrDepth = ty.ptrDepth - 1
        return "ptr_" + mangleAstTypeArg(inner)
    }
    if ty.isRef || ty.isRefMut {
        var inner = ty.clone()
        inner.isRef = false
        inner.isRefMut = false
        return "ref_" + mangleAstTypeArg(inner)
    }
    if ty.isArray {
        var inner = ty.clone()
        inner.isArray = false
        var s = "arr_" + mangleAstTypeArg(inner)
        match ty.arraySize {
            Option.Some(n) => {
                s = s + "_" + n.toString()
            }
            Option.None => {
            }
        }
        return s
    }
    if ty.name == "Vec" && ty.typeArgs.len == 1 {
        return "Vec_" + mangleAstTypeArg(ty.typeArgs[0])
    }
    if ty.name == "Heap" && ty.typeArgs.len == 1 {
        return "Heap_" + mangleAstTypeArg(ty.typeArgs[0])
    }
    if ty.name == "HashMap" && ty.typeArgs.len == 2 {
        return "HashMap_" + mangleAstTypeArg(ty.typeArgs[0]) + "_" + mangleAstTypeArg(ty.typeArgs[1])
    }
    if ty.typeArgs.len > 0 {
        var s = ty.name.clone()
        for i in 0..ty.typeArgs.len {
            s = s + "_" + mangleAstTypeArg(ty.typeArgs[i])
        }
        return s
    }
    // scalar aliases canonicalize the same way checker/types.milo's typeFromName does
    if ty.name == "int" {
        return "i64"
    }
    if ty.name == "byte" {
        return "u8"
    }
    if ty.name == "float" {
        return "f64"
    }
    return ty.name.clone()
}

pub fn astTypeStr(ty: &MiloType): string {
    if ty.isFn {
        // carry the return type ("fn:Response") so an indirect closure call can
        // recover it — a fn-typed param otherwise loses R and defaults to i64.
        match ty.fnRet {
            Option.Some(r) => {
                return "fn:" + astTypeStr(*r)
            }
            Option.None => {
                return "fn"
            }
        }
    }
    var base = ty.name.clone()
    if ty.typeArgs.len > 0 {
        // Bracket form for EVERY generic, builtin or user-defined.
        //
        // A flat mangled spelling (Arena<Node> -> Arena_Node) was tried here to make a
        // directly-named user generic emit valid LLVM. It broke twenty fixtures: the
        // mangled name must match what the CHECKER registered, and this function cannot
        // know that. `Result<string>` has one written type argument but monomorphizes to
        // `Result_string_string` because E defaults — so the hand-rolled name referenced a
        // type that was never declared. Any future attempt must consult the checker's own
        // mangling rather than reconstruct it.
        base = base + "<"
        for i in 0..ty.typeArgs.len {
            if i > 0 {
                base = base + ","
            }
            // A fixed-array typeArg mangles to "arr_<elem>_<N>" (the checker's
            // mangleTypeName scheme, mirrored by mangleAstTypeArg below) — NOT the
            // "Vec<elem>" RUNTIME-representation form the plain recursive astTypeStr
            // call below produces for a top-level array (see the isArray branch
            // after this loop). That form drops the array size, so e.g.
            // `Option<[u8;16]>` mangled down to "Option<Vec<u8>>", a key the checker
            // never registered any enum under — resolveTyStr's char-scan then passed
            // through the unresolved "%Option<Vec<u8>>", and any method call on the
            // value read that as an unknown type ("unsupported method 'isSome' on
            // %Option<Vec<u8>>").
            if ty.typeArgs[i].isArray {
                var elem = ty.typeArgs[i].clone()
                elem.isArray = false
                var arrStr = "arr_" + astTypeStr(elem)
                match ty.typeArgs[i].arraySize {
                    Option.Some(n) => {
                        arrStr = arrStr + "_" + n.toString()
                    }
                    Option.None => {
                    }
                }
                base = base + arrStr
            } else {
                base = base + astTypeStr(ty.typeArgs[i])
            }
        }
        base = base + ">"
    }
    // Fixed arrays lower onto the Vec runtime: same {ptr,len,cap} header, so
    // len/index/iterate/index-assign all reuse the Vec paths.
    if ty.isArray {
        base = "Vec<" + base + ">"
    }
    // llType only checks for a leading '*' (any count means "ptr" — LLVM's
    // opaque ptr is depth-agnostic), but the star count still has to survive
    // here so the string round-trips and downstream tooling reflects **T.
    if ty.ptrDepth > 0 {
        var stars = ""
        var i: i32 = 0
        while i < ty.ptrDepth {
            stars = stars + "*"
            i = i + 1
        }
        return stars + base
    }
    return base
}

// -- Checker type → backend type string --

// The replacement for `resolveTyStr(cg, astTypeStr(t))`. Same output vocabulary as
// astTypeStr ("i64", "string", "Vec<T>", "HashMap<K,V>", "Heap<T>", "*u8", "fn:R", and
// a bare mangled struct/enum name) — but read off the type the CHECKER inferred instead
// of reconstructed from the syntax that produced it.
//
// The difference that matters is generics. astTypeStr's own comment records that it
// cannot reconstruct a monomorphized name: `Result<string>` is written with one type
// argument and registers as `Result_string_string` because E defaults, so the syntactic
// path has to guess and then be rescued by resolveTyStr's table lookups. TStruct/TEnum
// already carry the mangled name the checker registered, so there is nothing to guess.
//
// Aborts on TUnknown rather than returning "". The empty string is the value 33 sites in
// this backend produce on failure and that callers read as "skip" — reintroducing it here
// would carry that silent-skip class straight into the typed pipeline. `what` names the
// use site so the abort points at the code, not just the type.
pub fn tyStr(cg: &Cgen, t: &TypeKind, what: &string): string {
    match t {
        TypeKind.TInt(bits, signed, lo, hi) => {
            var pfx = "u"
            if signed {
                pfx = "i"
            }
            return pfx + bits.toString()
        }
        TypeKind.TFloat(bits) => {
            return "f" + bits.toString()
        }
        TypeKind.TBool => {
            return "bool"
        }
        TypeKind.TVoid => {
            return "void"
        }
        TypeKind.TString => {
            return "string"
        }
        // llType is depth-agnostic (any leading '*' is one opaque ptr), but the star
        // count still has to survive so the string round-trips — same rule astTypeStr
        // follows for ty.ptrDepth.
        TypeKind.TPtr(inner) => {
            return "*" + tyStr(cg, *inner, what)
        }
        // Ref-ness never reaches a backend type string: a `&Board` param and a by-value
        // `Board` share one string today, and second-class references mean the backend
        // never has to tell them apart at the type level.
        TypeKind.TRef(inner, mutable) => {
            return tyStr(cg, *inner, what)
        }
        // An interface name is already its own backend type (%Iface, the fat pointer),
        // so structs and interfaces both pass through as the bare registered name.
        TypeKind.TStruct(name) => {
            return name.clone()
        }
        TypeKind.TEnum(name) => {
            return name.clone()
        }
        // Heap<Interface> IS the interface fat pointer (its data ptr is heap-allocated),
        // so it collapses to the interface — otherwise llType gives a plain ptr and the
        // vtable slot is lost. Mirrors resolveTyStr's Heap branch.
        TypeKind.THeap(inner) => {
            let hinner = tyStr(cg, *inner, what)
            if cg.interfaces.contains(hinner) {
                return hinner
            }
            return "Heap<" + hinner + ">"
        }
        TypeKind.TVec(elem) => {
            return "Vec<" + tyStr(cg, *elem, what) + ">"
        }
        TypeKind.THashMap(k, v) => {
            return "HashMap<" + tyStr(cg, *k, what) + "," + tyStr(cg, *v, what) + ">"
        }
        // A fixed array lowers onto the Vec runtime — same {ptr,len,cap} header, so
        // len/index/iterate/index-assign all reuse the Vec paths. The size is dropped
        // here exactly as astTypeStr drops it; anything that needs the size reads the
        // TArray directly rather than this string.
        TypeKind.TArray(elem, size) => {
            return "Vec<" + tyStr(cg, *elem, what) + ">"
        }
        // "fn:R" carries the return type so an indirect closure call can recover it —
        // a fn-typed value otherwise loses R and defaults to i64.
        TypeKind.TFn(params, ret) => {
            return "fn:" + tyStr(cg, *ret, what)
        }
        TypeKind.TUnknown => {
            eprint("internal error: no backend type for " + what.clone() + " (checker left it unknown)")
            unsafe {
                exit(1)
            }
            return ""
        }
    }
}
