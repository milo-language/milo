// -- Struct literal --

// Coarse type category of a literal field expression (no evaluation).
pub fn exprCategory(e: &ExprNode): string {
    match e.kind {
        Expr.IntLit(n) => {
            return "int"
        }
        Expr.CharLit(c) => {
            return "int"
        }
        Expr.BoolLit(b) => {
            return "int"
        }
        Expr.FloatLit(f) => {
            return "float"
        }
        Expr.StringLit(v) => {
            return "str"
        }
        _ => {
            return ""
        }
    }
}

pub fn llCategory(ll: &string): string {
    if ll == "%String" {
        return "str"
    }
    if ll == "double" || ll == "float" {
        return "float"
    }
    if ll.len > 0 && ll[0] == 105 {
        return "int"
    }
    return ""
}

// A struct literal `Pair { … }` whose base has >1 monomorphization (Pair_i32_i32
// vs Pair_string_i32) picks the candidate whose field categories match the literal
// field values (which the checker already resolved, but the AST keeps the bare name).
pub fn disambiguateStructLit(cg: &Cgen, base: &string, fields: &Vec<StructLitField>): string {
    var result = base.clone()
    var count = 0
    for k, v in cg.structs {
        if !nameHasMonoPrefix(k, base) {
            continue
        }
        var ok = true
        for fi in 0..fields.len {
            let cat = exprCategory(*fields[fi].value)
            if cat.len == 0 {
                // Skipping this field's evidence, and that is a guess rather than a
                // safe default. exprCategory answers for five literal kinds and returns
                // "" for everything else — idents, calls, field reads — so the skip is
                // the COMMON path, not the rare one.
                //
                // The hazard is narrow but real: if the skipped field is the one that
                // would have excluded a candidate, exactly one survivor remains and this
                // function returns the WRONG monomorphization, whose fields are then read
                // at the wrong types. When two or more survive it returns the bare base
                // name and the failure is loud downstream; the single-survivor case is
                // the silent one.
                //
                // Unlike the other can't-tell sites closed in this pass, aborting here is
                // not available: the unknown case is the normal case. The fix is the one
                // the comment above this function already names — the checker RESOLVED
                // this literal's type and the AST kept the bare name. Carrying that type
                // through to codegen removes the guess entirely, rather than making
                // category-matching cleverer.
                continue
            }
            let idx = lookupFieldIndex(cg, k, fields[fi].name)
            if idx < 0 {
                ok = false
            } else {
                let fcat = llCategory(llType(lookupFieldType(cg, k, idx)))
                if fcat.len > 0 && fcat != cat {
                    ok = false
                }
            }
        }
        if ok {
            result = k.clone()
            count = count + 1
        }
    }
    if count == 1 {
        return result
    }
    return base.clone()
}

// A `[T;N]`-typed local/param is represented at runtime as a %Vec ({ptr,len,cap})
// so index/iterate reuse the Vec paths — see the doc comment on astTypeStr's
// isArray rule. A STRUCT FIELD of the same declared type is laid out INLINE
// (`[N x T]`, matching a real C array for @cLayout/offsetOf; see the array-field
// branch in emit.milo's struct registration). Storing a Vec-backed value straight
// into such a field wrote the raw %Vec bytes (a 24-byte {ptr,i64,i64}) over a slot
// that is really N*sizeof(T) bytes — wrong size, wrong shape, corrupting whatever
// stack memory followed (Uuid's `bytes: [u8;16]` field came back as garbage after
// `Uuid { bytes: b }` from a local `var b: [u8;16]`). Copy the Vec's N live
// elements into the field's own memory instead. Returns true when it fully wrote
// `destPtr` itself (the caller must not also emit a normal `store`).
pub fn genInlineArrCoerceIfNeeded(cg: &mut Cgen, v: &Val, fieldTy: &string, destPtr: &string): bool {
    if !isInlineArrTy(fieldTy) || !isVecTy(v.ty) {
        return false
    }
    let n = inlineArrLen(fieldTy)
    let elemLl = llType(inlineArrElem(fieldTy))
    let dataPtr = nextTemp(&mut cg)
    emit(&mut cg, "  " + dataPtr + " = extractvalue %Vec " + v.v.clone() + ", 0\n")
    // genSizeOf, not llTypeBytes: the latter defaults every named struct/enum to 8,
    // which would under-copy a `[SomeStruct;N]` field and leave its tail undefined.
    let esz = genSizeOf(&mut cg, elemLl)
    let totalBytes = nextTemp(&mut cg)
    emit(&mut cg, "  " + totalBytes + " = mul i64 " + n.toString() + ", " + esz + "\n")
    ensureMemcpy(&mut cg)
    emit(&mut cg, "  call ptr @memcpy(ptr " + destPtr.clone() + ", ptr " + dataPtr + ", i64 " + totalBytes + ")\n")
    return true
}

pub fn genStructLit(cg: &mut Cgen, name: &string, fields: &Vec<StructLitField>, locs: &Vec<Local>, sigs: &Vec<CgFnSig>, hintTy: &string): Val {
    // a bare generic name (`Handle` from a monomorphized body) resolves to its
    // sole instantiation (`Handle_Expr`); a concrete struct name passes through.
    var rname = resolveStructName(cg, name)
    // >1 instantiation → resolveStructName returns the bare name; disambiguate by
    // the literal field value categories.
    if rname == name && !cg.structs.contains(name) {
        rname = disambiguateStructLit(cg, name, fields)
    }
    // still ambiguous (Handle<T> — T isn't in the fields) → use the annotation hint
    // (`let h: Handle<i64> = Handle {…}` → Handle_i64).
    if rname == name && !cg.structs.contains(name) && hintTy.len > 0 {
        let h = stripPercent(resolveTyStr(cg, stripPercent(hintTy)))
        if cg.structs.contains(h) && nameHasMonoPrefix(h, name) {
            rname = h
        }
    }
    let structTy = "%" + rname.clone()
    let alloc = nextTemp(&mut cg)
    emit(&mut cg, "  " + alloc + " = alloca " + structTy + "\n")
    for fi in 0..fields.len {
        // Read the field through the borrow. Cloning it here (which this used to do)
        // rebuilds the value expression, and ExprNode::clone mints a fresh id — which
        // orphans whatever lowering lifted out of it under the old one.
        let idx = lookupFieldIndex(cg, rname, fields[fi].name)
        let fty = lookupFieldType(cg, rname, idx)
        // struct fields are owned → move the value (zero the source place)
        let fv0 = genOwnedArg(&mut cg, *fields[fi].value, fty.clone(), locs, sigs)
        let fv = genInterfaceCoerceIfNeeded(&mut cg, fv0, fty)
        let fp = nextTemp(&mut cg)
        emit(&mut cg, "  " + fp + " = getelementptr " + structTy + ", ptr " + alloc + ", i32 0, i32 " + idx.toString() + "\n")
        if !genInlineArrCoerceIfNeeded(&mut cg, fv, fty, fp) {
            emit(&mut cg, "  store " + llType(fv.ty) + " " + fv.v + ", ptr " + fp + "\n")
        }
    }
    let loaded = nextTemp(&mut cg)
    emit(&mut cg, "  " + loaded + " = load " + structTy + ", ptr " + alloc + "\n")
    return Val {
        v: loaded, ty: structTy
    }
}

// -- Field access --

// `f64.INF` / `f64.NEG_INF` / `f64.NAN` (and f32) — a FieldAccess whose object is a TYPE
// name. LLVM has no textual spelling for these, so they are emitted as the IEEE bit
// patterns; note LLVM writes an f32 constant as the DOUBLE that the float rounds to, which
// is why the f32 arms carry the same hex as the f64 ones.
pub fn floatNamespaceLit(object: &ExprNode, field: &string): string {
    match object.kind {
        Expr.Ident(name) => {
            if name != "f64" && name != "f32" {
                return ""
            }
            if field == "INF" {
                return "0x7FF0000000000000"
            }
            if field == "NEG_INF" {
                return "0xFFF0000000000000"
            }
            if field == "NAN" {
                return "0x7FF8000000000000"
            }
            return ""
        }
        _ => {
            return ""
        }
    }
}

pub fn genFieldAccess(cg: &mut Cgen, object: &ExprNode, field: &string, locs: &Vec<Local>, sigs: &Vec<CgFnSig>): Val {
    let nsLit = floatNamespaceLit(object, field)
    if nsLit.len > 0 {
        var fty = "double"
        match object.kind {
            Expr.Ident(nm) => {
                if nm == "f32" {
                    fty = "float"
                }
            }
            _ => {
            }
        }
        return Val {
            v: nsLit, ty: fty
        }
    }
    let lv = genLvalue(&mut cg, object, locs, sigs)
    let lvTyLl = llType(lv.ty)
    // Built-in: string.len
    if lvTyLl == "%String" && field == "len" {
        let loaded = nextTemp(&mut cg)
        emit(&mut cg, "  " + loaded + " = load %String, ptr " + lv.v + "\n")
        let lenT = nextTemp(&mut cg)
        emit(&mut cg, "  " + lenT + " = extractvalue %String " + loaded + ", 1\n")
        return Val {
            v: lenT, ty: "i64"
        }
    }
    // Built-in: vec.len (a field, not a method, in the surface syntax)
    if isVecTy(lv.ty) && field == "len" {
        let lenPtr = nextTemp(&mut cg)
        emit(&mut cg, "  " + lenPtr + " = getelementptr %Vec, ptr " + lv.v + ", i32 0, i32 1\n")
        let lenT = nextTemp(&mut cg)
        emit(&mut cg, "  " + lenT + " = load i64, ptr " + lenPtr + "\n")
        return Val {
            v: lenT, ty: "i64"
        }
    }
    if isHashMapTy(lv.ty) && field == "len" {
        let lenPtr = nextTemp(&mut cg)
        emit(&mut cg, "  " + lenPtr + " = getelementptr %HashMap, ptr " + lv.v + ", i32 0, i32 1\n")
        let lenT = nextTemp(&mut cg)
        emit(&mut cg, "  " + lenT + " = load i64, ptr " + lenPtr + "\n")
        return Val {
            v: lenT, ty: "i64"
        }
    }
    // field access through a raw pointer (`p.x` on *Struct): load the pointer to get
    // the struct address, then gep the pointee field.
    if lv.ty.len > 0 && lv.ty[0] == 42 {
        let pointee = lv.ty[1..lv.ty.len].clone()
        let pn = stripPercent(resolveTyStr(cg, pointee))
        let pidx = lookupFieldIndex(cg, pn, field)
        if pidx < 0 {
            eprint("codegen: no field '" + field.clone() + "' on " + lv.ty.clone())
            exit(1)
        }
        let structAddr = nextTemp(&mut cg)
        emit(&mut cg, "  " + structAddr + " = load ptr, ptr " + lv.v + "\n")
        let pfty = lookupFieldType(cg, pn, pidx)
        let pftyLl = llType(pfty)
        let pfp = nextTemp(&mut cg)
        emit(&mut cg, "  " + pfp + " = getelementptr %" + pn + ", ptr " + structAddr + ", i32 0, i32 " + pidx.toString() + "\n")
        let ploaded = nextTemp(&mut cg)
        emit(&mut cg, "  " + ploaded + " = load " + pftyLl + ", ptr " + pfp + "\n")
        return Val {
            v: ploaded, ty: pfty
        }
    }
    // resolve a still-generic type (`Handle<Node>` from a monomorphized/closure
    // context) to its mangled struct name before the field lookup.
    let rawName = stripPercent(resolveTyStr(cg, lv.ty))
    let idx = lookupFieldIndex(cg, rawName, field)
    if idx < 0 {
        eprint("codegen: no field '" + field.clone() + "' on " + lv.ty.clone())
        exit(1)
    }
    let fty = lookupFieldType(cg, rawName, idx)
    let ftyLl = llType(fty)
    let structTy = "%" + rawName
    let fp = nextTemp(&mut cg)
    emit(&mut cg, "  " + fp + " = getelementptr " + structTy + ", ptr " + lv.v + ", i32 0, i32 " + idx.toString() + "\n")
    let loaded = nextTemp(&mut cg)
    emit(&mut cg, "  " + loaded + " = load " + ftyLl + ", ptr " + fp + "\n")
    return Val {
        v: loaded, ty: fty
    }
}

// -- Enum literal --

// -- Move-out of an owned operand --

// Pure (no emit) type of an addressable place expr. "" for non-places, bare fn
// names, and derefs — anything genOwnedArg must not treat as an owned slot.
// Three answers where there were two.
//
// "This expression is not a place" and "this IS a place but I could not derive its type"
// both used to return "", and every caller reads "" as "skip the ownership decision". The
// first is correct: a non-place owns nothing, so there is nothing to mark moved or drop.
// The second is a missed drop or a double free, and it was indistinguishable from the
// first. That conflation is the reason this enum exists.
//
// Deliberately NOT a string with a sentinel. A sentinel is what got us here.
pub enum PlaceTy {
    NotAPlace,
    Unresolved(string),
    Known(string),
}

// The string face, for the call sites that still want one.
//
// NotAPlace still yields "" and callers still read that as "skip" — which is correct, a
// non-place owns nothing. Unresolved does NOT: it aborts naming what could not be resolved.
// That is the whole change. Every caller of this function is making an ownership decision
// (mark a receiver moved, clone-or-move an argument, drop the old value at an assignment),
// and a decision made on a type nobody could derive is a decision made on nothing.
//
// Constitution I: every "unknown / can't tell / didn't match" path must reject, not accept.
// This path used to accept.
pub fn placeTypeStrOrAbort(cg: &Cgen, e: &ExprNode, locs: &Vec<Local>, what: &string): string {
    match placeTypeOf(cg, e, locs) {
        PlaceTy.Known(t) => {
            return t
        }
        PlaceTy.NotAPlace => {
            return ""
        }
        PlaceTy.Unresolved(w) => {
            eprint("internal error: " + what.clone() + " needs the type of a place, but " + w.clone() + " could not be resolved")
            unsafe {
                exit(1)
            }
            return ""
        }
    }
}

// The place's type, or an honest statement that there isn't one.
pub fn placeTypeOf(cg: &Cgen, e: &ExprNode, locs: &Vec<Local>): PlaceTy {
    match e.kind {
        Expr.Ident(name) => {
            if hasLocal(locs, name) {
                return PlaceTy.Known(findLocal(locs, name).ty.clone())
            }
            if cg.globalVars.contains(name) {
                return PlaceTy.Known(cg.globalVars.get(name)!)
            }
            // Every place is rooted in a local or a global. A bare name that is neither
            // is not a place root at all: a function referenced as a value, or a type
            // used as a namespace (`f64.NAN` parses as FieldAccess over Ident "f64").
            // NotAPlace here is a classification, not a skip — the strictness that
            // matters lives in the derived cases below, where an object IS a place and
            // its field, element or pointee type cannot be named.
            return PlaceTy.NotAPlace
        }
        Expr.FieldAccess(obj, field) => {
            match placeTypeOf(cg, *obj, locs) {
                PlaceTy.NotAPlace => {
                    return PlaceTy.NotAPlace
                }
                PlaceTy.Unresolved(w) => {
                    return PlaceTy.Unresolved(w)
                }
                PlaceTy.Known(ot0) => {
                    let ot = stripPercent(ot0)
                    let idx = lookupFieldIndex(cg, ot, field)
                    if idx >= 0 {
                        return PlaceTy.Known(lookupFieldType(cg, ot, idx))
                    }
                    // A miss on a type that IS a struct means a field this walk cannot
                    // name — that is a real unknown. A miss on anything else is a builtin
                    // accessor (`s.len`, `v.ptr`) which yields a value, not a place, so
                    // there is no ownership decision to skip.
                    if cg.structs.contains(ot) {
                        return PlaceTy.Unresolved("field '" + field.clone() + "' of struct '" + ot.clone() + "'")
                    }
                    return PlaceTy.NotAPlace
                }
            }
        }
        Expr.IndexAccess(obj, i) => {
            match placeTypeOf(cg, *obj, locs) {
                PlaceTy.NotAPlace => {
                    return PlaceTy.NotAPlace
                }
                PlaceTy.Unresolved(w) => {
                    return PlaceTy.Unresolved(w)
                }
                PlaceTy.Known(ot0) => {
                    let ot = resolveTyStr(cg, ot0)
                    if isVecTy(ot) {
                        return PlaceTy.Known(unwrapVec(ot))
                    }
                    if ot.len > 0 && ot[0] == 42 {
                        return PlaceTy.Known(ot[1..ot.len].clone())
                    }
                    if isInlineArrTy(ot) {
                        return PlaceTy.Known(inlineArrElem(ot))
                    }
                    // Indexing a string yields a byte by value, and indexing a HashMap
                    // hands back a copy of the value. Neither is a place the caller can
                    // own, so there is genuinely no ownership decision to make — the
                    // honest answer is NotAPlace, not an unresolved type.
                    if ot == "%String" || ot == "String" || ot == "string" {
                        return PlaceTy.NotAPlace
                    }
                    if isHashMapTy(ot) {
                        return PlaceTy.NotAPlace
                    }
                    return PlaceTy.Unresolved("element of '" + ot.clone() + "'")
                }
            }
        }
        // `*box` on a Heap<T> is the pointee's place; `*p` on a raw `*T` likewise.
        // Without this the deref of an owned box read as "unknown type", which made
        // every ownership decision about it (move? drop?) fall through to "no".
        Expr.UnaryOp(op, operand) => {
            if op != "*" {
                return PlaceTy.NotAPlace
            }
            match placeTypeOf(cg, *operand, locs) {
                PlaceTy.NotAPlace => {
                    return PlaceTy.NotAPlace
                }
                PlaceTy.Unresolved(w) => {
                    return PlaceTy.Unresolved(w)
                }
                PlaceTy.Known(ot0) => {
                    let ot = resolveTyStr(cg, ot0)
                    let inner = unwrapHeap(ot)
                    if inner.len > 0 {
                        return PlaceTy.Known(inner)
                    }
                    if ot.len > 0 && ot[0] == 42 {
                        return PlaceTy.Known(ot[1..ot.len].clone())
                    }
                    return PlaceTy.Unresolved("pointee of '" + ot.clone() + "'")
                }
            }
        }
        _ => {
            return PlaceTy.NotAPlace
        }
    }
}

// Is this place rooted in an OWNED local/global (as opposed to a `&T` binding)?
// A move may only zero storage this frame owns; a borrow's pointee belongs to
// someone else, and the checker already rejects moving out of one.
fn placeRootIsOwned(e: &ExprNode, cg: &Cgen, locs: &Vec<Local>): bool {
    match e.kind {
        Expr.Ident(name) => {
            if hasLocal(locs, name) {
                return !findLocal(locs, name).isRef
            }
            return cg.globalVars.contains(name)
        }
        Expr.FieldAccess(obj, field) => {
            return placeRootIsOwned(*obj, cg, locs)
        }
        Expr.UnaryOp(op, operand) => {
            if op == "*" {
                return placeRootIsOwned(*operand, cg, locs)
            }
            return false
        }
        _ => {
            return false
        }
    }
}

// Record that a receiver place was consumed, AFTER its value has already been
// loaded — the same bookkeeping genOwnedArg does for an argument, split out for
// the methods whose dispatch only learns they consume once the receiver's type is
// known (Result.map forwards the Err payload into its result, so the receiver must
// not be dropped again by the enclosing scope). Only whole owned places are
// touched; a borrow's pointee belongs to someone else.
pub fn markReceiverMoved(cg: &mut Cgen, e: &ExprNode, locs: &Vec<Local>, sigs: &Vec<CgFnSig>) {
    let tyStr = placeTypeStrOrAbort(cg, e, locs, "marking a receiver moved")
    if tyStr.len == 0 {
        return
    }
    if !cgNeedsDrop(cg, tyStr) {
        return
    }
    if !placeRootIsOwned(e, cg, locs) {
        return
    }
    match e.kind {
        Expr.Ident(name) => {
            let lv = genLvalue(&mut cg, e, locs, sigs)
            zeroStore(&mut cg, lv.v, lv.ty)
            cg.movedLocalAddrs.push(lv.v.clone())
        }
        Expr.FieldAccess(obj, field) => {
            let lv = genLvalue(&mut cg, e, locs, sigs)
            zeroStore(&mut cg, lv.v, lv.ty)
            cg.movedLocalAddrs.push(lv.v.clone())
        }
        _ => {
        }
    }
}

// Evaluate an expr in an OWNING position (a by-value arg, RHS, or field). If it
// is a droppable local/global place, load its value and zero the slot — the
// move that keeps a later scope/reassign drop from double-freeing.
//
// Idents and struct FIELDS move (`let raw = msg.payload` takes the buffer with
// it, and msg's own drop must not free it again — the oracle spells this as the
// checker's isMove bit, which this compiler has no HIR to carry). Index accesses
// do NOT: the checker treats `let x = v[i]` as a copy that leaves v[i] live, so
// zeroing there would corrupt the source.
pub fn genOwnedArg(cg: &mut Cgen, e: &ExprNode, hintTy: string, locs: &Vec<Local>, sigs: &Vec<CgFnSig>): Val {
    match e.kind {
        Expr.Closure(cps, crt, cbody, cIsMove) => {
            var isMove = cIsMove
            if !isMove {
                isMove = autoMoveClosureArg(cg, e.id, cps, locs)
            }
            return genClosure(&mut cg, e.id, cps, crt, isMove, locs, sigs)
        }
        _ => {
        }
    }
    match e.kind {
        // `let d = dirs[i]` is a COPY, not a move (the checker leaves dirs[i] live),
        // so a droppable element has to be deep-cloned here: a shallow header copy
        // gives two owners of one buffer and whichever drops first empties the other.
        // Mirrors the oracle's indexAccessClones.
        Expr.IndexAccess(obj, idx) => {
            let elemTy = placeTypeStrOrAbort(cg, e, locs, "passing an owned argument")
            if elemTy.len > 0 && cgNeedsDrop(cg, elemTy) {
                let lv = genLvalue(&mut cg, e, locs, sigs)
                let ll = llType(resolveTyStr(cg, lv.ty))
                let loaded = nextTemp(&mut cg)
                emit(&mut cg, "  " + loaded + " = load " + ll + ", ptr " + lv.v + "\n")
                let cloned = genCloneOfLoaded(&mut cg, loaded, lv.ty)
                return Val {
                    v: cloned, ty: lv.ty.clone()
                }
            }
        }
        _ => {
        }
    }
    match e.kind {
        // `*box` in an owning position hands the POINTEE on (`sum(*left)` on a
        // Heap<Tree> payload): zero it so the box's own drop frees the box without
        // recursing into a subtree the callee already took and dropped.
        Expr.UnaryOp(op, operand) => {
            let tyStr = placeTypeStrOrAbort(cg, e, locs, "passing an owned argument")
            if op == "*" && tyStr.len > 0 && cgNeedsDrop(cg, tyStr) {
                if placeRootIsOwned(e, cg, locs) {
                    let lv = genLvalue(&mut cg, e, locs, sigs)
                    let ll = llType(resolveTyStr(cg, lv.ty))
                    let v = nextTemp(&mut cg)
                    emit(&mut cg, "  " + v + " = load " + ll + ", ptr " + lv.v + "\n")
                    zeroStore(&mut cg, lv.v, lv.ty)
                    cg.movedLocalAddrs.push(lv.v.clone())
                    return Val {
                        v: v, ty: lv.ty.clone()
                    }
                }
                // The box is reached through an index or a borrow, so the container
                // still owns it and will free it: `return *args[0]` in parseFString
                // handed back the pointee of a box the local `args` Vec dropped one
                // instruction later. Copy the pointee out instead of aliasing it.
                let lv2 = genLvalue(&mut cg, e, locs, sigs)
                let ll2 = llType(resolveTyStr(cg, lv2.ty))
                let loaded2 = nextTemp(&mut cg)
                emit(&mut cg, "  " + loaded2 + " = load " + ll2 + ", ptr " + lv2.v + "\n")
                let cloned2 = genCloneOfLoaded(&mut cg, loaded2, lv2.ty)
                return Val {
                    v: cloned2, ty: lv2.ty.clone()
                }
            }
        }
        _ => {
        }
    }
    match e.kind {
        Expr.FieldAccess(obj, field) => {
            let tyStr = placeTypeStrOrAbort(cg, e, locs, "passing an owned argument")
            if tyStr.len > 0 && cgNeedsDrop(cg, tyStr) {
                if placeRootIsOwned(e, cg, locs) {
                    let lv = genLvalue(&mut cg, e, locs, sigs)
                    let ll = llType(resolveTyStr(cg, lv.ty))
                    let v = nextTemp(&mut cg)
                    emit(&mut cg, "  " + v + " = load " + ll + ", ptr " + lv.v + "\n")
                    zeroStore(&mut cg, lv.v, lv.ty)
                    cg.movedLocalAddrs.push(lv.v.clone())
                    return Val {
                        v: v, ty: lv.ty.clone()
                    }
                }
                // Root is NOT a whole owned local — it reaches through an index
                // (`sig.params[i].ty`) or a borrow. The container keeps owning the
                // field, so zeroing it would corrupt the source; handing back the
                // loaded header would give two owners of one buffer. Deep-copy,
                // exactly as the IndexAccess arm above does for `v[i]`.
                let lv2 = genLvalue(&mut cg, e, locs, sigs)
                let ll2 = llType(resolveTyStr(cg, lv2.ty))
                let loaded2 = nextTemp(&mut cg)
                emit(&mut cg, "  " + loaded2 + " = load " + ll2 + ", ptr " + lv2.v + "\n")
                let cloned2 = genCloneOfLoaded(&mut cg, loaded2, lv2.ty)
                return Val {
                    v: cloned2, ty: lv2.ty.clone()
                }
            }
        }
        _ => {
        }
    }
    match e.kind {
        Expr.Ident(name) => {
            let isLocal = hasLocal(locs, name)
            if (isLocal && !findLocal(locs, name).isRef) || (!isLocal && cg.globalVars.contains(name)) {
                let tyStr = placeTypeStrOrAbort(cg, e, locs, "passing an owned argument")
                // A fixed-size Copy array (`[T;N]`) lowers onto the SAME %Vec runtime
                // shape as a real growable Vec — nothing in the `ty` string tells them
                // apart, only the Local's isArr bit does (see its doc comment). Passing
                // one "by value" has to deep-clone, not move: the checker only accepts
                // an array-typed binding when its element is Copy
                // (tests/errors/arrayNonCopyMove.milo enforces the rest), so moving —
                // zeroing the source's {ptr,len,cap} header — left a SECOND read of the
                // same local dereferencing a null buffer.
                if isLocal && findLocal(locs, name).isArr && tyStr.len > 0 && isVecTy(tyStr) {
                    let lv = genLvalue(&mut cg, e, locs, sigs)
                    let ll = llType(resolveTyStr(cg, lv.ty))
                    let loaded = nextTemp(&mut cg)
                    emit(&mut cg, "  " + loaded + " = load " + ll + ", ptr " + lv.v + "\n")
                    let srcVal = Val {
                        v: loaded, ty: lv.ty.clone()
                    }
                    return genDeepCloneVecVal(&mut cg, srcVal)
                }
                if tyStr.len > 0 && cgNeedsDrop(cg, tyStr) {
                    let lv = genLvalue(&mut cg, e, locs, sigs)
                    let ll = llType(resolveTyStr(cg, lv.ty))
                    let v = nextTemp(&mut cg)
                    emit(&mut cg, "  " + v + " = load " + ll + ", ptr " + lv.v + "\n")
                    zeroStore(&mut cg, lv.v, lv.ty)
                    // Record the move: zeroing the bytes is enough to make a later
                    // Vec/String/Heap drop a safe no-op (their zero state IS "nothing
                    // to free"), but a plain struct with a user `impl Drop` has no such
                    // sentinel — its drop() runs the user's side effect unconditionally.
                    // Without this record, a later scope/reassign drop of this same
                    // slot calls that side effect a second time on a moved-out value.
                    cg.movedLocalAddrs.push(lv.v.clone())
                    return Val {
                        v: v, ty: lv.ty.clone()
                    }
                }
            }
        }
        _ => {
        }
    }
    return genExpr(&mut cg, e, locs, sigs, hintTy)
}

pub fn variantStructTy(payloadTypes: &Vec<string>): string {
    var s = "{ "
    for i in 0..payloadTypes.len {
        if i > 0 {
            s = s + ", "
        }
        s = s + llType(payloadTypes[i])
    }
    s = s + " }"
    return s
}

// `Vec.new()` is an empty {data, len, cap}. Its element type is not recoverable
// from the call, so it rides in on the caller's type hint (`var v: Vec<string> =
// Vec.new()`), exactly as the let/var annotation supplies it in the checker.
pub fn genVecNew(cg: &mut Cgen, hintTy: &string): Val {
    ensureVecTy(&mut cg)
    let a = nextTemp(&mut cg)
    emit(&mut cg, "  " + a + " = insertvalue %Vec undef, ptr null, 0\n")
    let b = nextTemp(&mut cg)
    emit(&mut cg, "  " + b + " = insertvalue %Vec " + a + ", i64 0, 1\n")
    let c = nextTemp(&mut cg)
    emit(&mut cg, "  " + c + " = insertvalue %Vec " + b + ", i64 0, 2\n")
    var ty = hintTy.clone()
    if !isVecTy(ty) {
        ty = "Vec<i64>"
    }
    return Val {
        v: c, ty: ty
    }
}

// `Vec.withCapacity(n)` must return a Vec whose `.ptr()` is a REAL, malloc'd
// buffer of n elements — not just an empty Vec (data=null, cap=0) with capacity
// treated as a discarded "growth hint". A caller that hands the pointer straight
// to a syscall without ever pushing (`std/io`'s fdRead: `Vec.withCapacity(max);
// let base = raw.ptr(); read(fd, base, max)`) got a null buffer, and the kernel
// rejected it with EFAULT ("Bad address") — every std/net and std/fs read that
// went through fdRead failed before a single byte moved. Mirrors
// src/codegen.ts's genVecWithCapacity: malloc(cap*elemSize), len=0, cap=cap.
pub fn genVecWithCapacity(cg: &mut Cgen, hintTy: &string, capExpr: &ExprNode, locs: &Vec<Local>, sigs: &Vec<CgFnSig>): Val {
    ensureVecTy(&mut cg)
    ensureMalloc(&mut cg)
    var ty = hintTy.clone()
    if !isVecTy(ty) {
        ty = "Vec<i64>"
    }
    let elemTy = unwrapVec(resolveTyStr(cg, ty.clone()))
    let elemLl = llType(elemTy)
    // llTypeBytes is a naive literal-shape lookup that only knows scalars and the
    // three built-in {ptr,i64,i64} containers — every other named struct (Handle,
    // Triple, any user type) falls through its default `return 8`. That undersized
    // the malloc for any non-scalar element (arenaHandles' `Vec<Handle<T>>`, 8 bytes
    // instead of Handle's real size): `cap` in the returned %Vec is still the
    // element COUNT, so push() never sees len==cap and never grows — every push
    // after the first couple wrote straight past the too-small buffer, corrupting
    // the heap (observed as a SIGBUS well downstream of the actual overflow).
    // genSizeOf asks LLVM itself via the GEP-null trick, so it's exact for structs
    // (padding and all) — same approach genArrayLit/genVecPush already use.
    let elemSz = genSizeOf(&mut cg, elemLl)
    let capV = genExpr(&mut cg, capExpr, locs, sigs, "i64")
    emitNonNegativeCheck(&mut cg, capV.v, "capacity")
    let bytes = nextTemp(&mut cg)
    emit(&mut cg, "  " + bytes + " = mul i64 " + capV.v.clone() + ", " + elemSz + "\n")
    let buf = nextTemp(&mut cg)
    emit(&mut cg, "  " + buf + " = call ptr @malloc(i64 " + bytes + ")\n")
    let a = nextTemp(&mut cg)
    emit(&mut cg, "  " + a + " = insertvalue %Vec undef, ptr " + buf + ", 0\n")
    let b = nextTemp(&mut cg)
    emit(&mut cg, "  " + b + " = insertvalue %Vec " + a + ", i64 0, 1\n")
    let c = nextTemp(&mut cg)
    emit(&mut cg, "  " + c + " = insertvalue %Vec " + b + ", i64 " + capV.v.clone() + ", 2\n")
    return Val {
        v: c, ty: ty
    }
}

// Append to a Vec through its address: growth has to be visible to the caller,
// so this takes the receiver as an lvalue rather than a loaded value.
pub fn genVecPush(cg: &mut Cgen, addr: &string, vecTy: &string, elemVal: &Val): Val {
    ensureVecTy(&mut cg)
    ensureRealloc(&mut cg)
    // resolve so a still-generic element (Vec<Handle<Node>>) mangles before it
    // reaches genSizeOf, which would otherwise emit an unsized `%Handle<Node>`.
    let elemTy = unwrapVec(resolveTyStr(cg, vecTy))
    let elemLl = llType(elemTy)

    let dPtr = nextTemp(&mut cg)
    emit(&mut cg, "  " + dPtr + " = getelementptr %Vec, ptr " + addr.clone() + ", i32 0, i32 0\n")
    let lPtr = nextTemp(&mut cg)
    emit(&mut cg, "  " + lPtr + " = getelementptr %Vec, ptr " + addr.clone() + ", i32 0, i32 1\n")
    let cPtr = nextTemp(&mut cg)
    emit(&mut cg, "  " + cPtr + " = getelementptr %Vec, ptr " + addr.clone() + ", i32 0, i32 2\n")

    let d = nextTemp(&mut cg)
    emit(&mut cg, "  " + d + " = load ptr, ptr " + dPtr + "\n")
    let l = nextTemp(&mut cg)
    emit(&mut cg, "  " + l + " = load i64, ptr " + lPtr + "\n")
    let cap = nextTemp(&mut cg)
    emit(&mut cg, "  " + cap + " = load i64, ptr " + cPtr + "\n")

    let full = nextTemp(&mut cg)
    emit(&mut cg, "  " + full + " = icmp eq i64 " + l + ", " + cap + "\n")
    let growLbl = nextLabel(&mut cg, "vec.grow")
    let storeLbl = nextLabel(&mut cg, "vec.store")
    emit(&mut cg, "  br i1 " + full + ", label %" + growLbl + ", label %" + storeLbl + "\n")

    emit(&mut cg, growLbl + ":\n")
    let isZero = nextTemp(&mut cg)
    emit(&mut cg, "  " + isZero + " = icmp eq i64 " + cap + ", 0\n")
    let dbl = nextTemp(&mut cg)
    emit(&mut cg, "  " + dbl + " = mul i64 " + cap + ", 2\n")
    let newCap = nextTemp(&mut cg)
    emit(&mut cg, "  " + newCap + " = select i1 " + isZero + ", i64 4, i64 " + dbl + "\n")
    let esz = genSizeOf(&mut cg, elemLl)
    let bytes = nextTemp(&mut cg)
    emit(&mut cg, "  " + bytes + " = mul i64 " + newCap + ", " + esz + "\n")
    let nd = nextTemp(&mut cg)
    emit(&mut cg, "  " + nd + " = call ptr @realloc(ptr " + d + ", i64 " + bytes + ")\n")
    emit(&mut cg, "  store ptr " + nd + ", ptr " + dPtr + "\n")
    emit(&mut cg, "  store i64 " + newCap + ", ptr " + cPtr + "\n")
    emit(&mut cg, "  br label %" + storeLbl + "\n")

    emit(&mut cg, storeLbl + ":\n")
    let dd = nextTemp(&mut cg)
    emit(&mut cg, "  " + dd + " = load ptr, ptr " + dPtr + "\n")
    let slot = nextTemp(&mut cg)
    emit(&mut cg, "  " + slot + " = getelementptr " + elemLl + ", ptr " + dd + ", i64 " + l + "\n")
    emit(&mut cg, "  store " + elemLl + " " + elemVal.v.clone() + ", ptr " + slot + "\n")
    let l1 = nextTemp(&mut cg)
    emit(&mut cg, "  " + l1 + " = add i64 " + l + ", 1\n")
    emit(&mut cg, "  store i64 " + l1 + ", ptr " + lPtr + "\n")
    return Val {
        v: "0", ty: "void"
    }
}

// Vec.map/filter: walk the input, call the closure per element (by-ptr ABI),
// build a new Vec. map pushes the closure result; filter pushes the element when
// the closure returns true.
pub fn genVecMapFilter(cg: &mut Cgen, obj: &Val, resultVecTy: &string, resultElemTy: &string, clv: &Val, isFilter: bool, _locs: &Vec<Local>, _sigs: &Vec<CgFnSig>): Val {
    let inElemLl = llType(unwrapVec(resolveTyStr(cg, obj.ty)))
    let outElemLl = llType(resultElemTy)
    let nv = genVecNew(&mut cg, resultVecTy)
    let vecSlot = nextTemp(&mut cg)
    emit(&mut cg, "  " + vecSlot + " = alloca %Vec\n")
    emit(&mut cg, "  store %Vec " + nv.v + ", ptr " + vecSlot + "\n")
    let d = nextTemp(&mut cg)
    emit(&mut cg, "  " + d + " = extractvalue %Vec " + obj.v + ", 0\n")
    let len = nextTemp(&mut cg)
    emit(&mut cg, "  " + len + " = extractvalue %Vec " + obj.v + ", 1\n")
    let fp = nextTemp(&mut cg)
    emit(&mut cg, "  " + fp + " = extractvalue %Closure " + clv.v + ", 0\n")
    let env = nextTemp(&mut cg)
    emit(&mut cg, "  " + env + " = extractvalue %Closure " + clv.v + ", 1\n")
    let iAddr = nextTemp(&mut cg)
    emit(&mut cg, "  " + iAddr + " = alloca i64\n")
    emit(&mut cg, "  store i64 0, ptr " + iAddr + "\n")
    let condLbl = nextLabel(&mut cg, "mf.cond")
    let bodyLbl = nextLabel(&mut cg, "mf.body")
    let endLbl = nextLabel(&mut cg, "mf.end")
    emit(&mut cg, "  br label %" + condLbl + "\n")
    emitLabel(&mut cg, condLbl)
    let i = nextTemp(&mut cg)
    emit(&mut cg, "  " + i + " = load i64, ptr " + iAddr + "\n")
    let lt = nextTemp(&mut cg)
    emit(&mut cg, "  " + lt + " = icmp slt i64 " + i + ", " + len + "\n")
    emit(&mut cg, "  br i1 " + lt + ", label %" + bodyLbl + ", label %" + endLbl + "\n")
    emitLabel(&mut cg, bodyLbl)
    let slot = nextTemp(&mut cg)
    emit(&mut cg, "  " + slot + " = getelementptr " + inElemLl + ", ptr " + d + ", i64 " + i + "\n")
    if isFilter {
        let keep = nextTemp(&mut cg)
        emit(&mut cg, "  " + keep + " = call i1 " + fp + "(ptr " + env + ", ptr " + slot + ")\n")
        let keepLbl = nextLabel(&mut cg, "mf.keep")
        let skipLbl = nextLabel(&mut cg, "mf.skip")
        emit(&mut cg, "  br i1 " + keep + ", label %" + keepLbl + ", label %" + skipLbl + "\n")
        emitLabel(&mut cg, keepLbl)
        let ev = nextTemp(&mut cg)
        emit(&mut cg, "  " + ev + " = load " + inElemLl + ", ptr " + slot + "\n")
        genVecPush(&mut cg, vecSlot, resultVecTy, Val {
            v: ev, ty: resultElemTy.clone()
        })
        emit(&mut cg, "  br label %" + skipLbl + "\n")
        emitLabel(&mut cg, skipLbl)
    } else {
        let r = nextTemp(&mut cg)
        emit(&mut cg, "  " + r + " = call " + outElemLl + " " + fp + "(ptr " + env + ", ptr " + slot + ")\n")
        genVecPush(&mut cg, vecSlot, resultVecTy, Val {
            v: r, ty: resultElemTy.clone()
        })
    }
    let i1v = nextTemp(&mut cg)
    emit(&mut cg, "  " + i1v + " = add i64 " + i + ", 1\n")
    emit(&mut cg, "  store i64 " + i1v + ", ptr " + iAddr + "\n")
    emit(&mut cg, "  br label %" + condLbl + "\n")
    emitLabel(&mut cg, endLbl)
    let out = nextTemp(&mut cg)
    emit(&mut cg, "  " + out + " = load %Vec, ptr " + vecSlot + "\n")
    return Val {
        v: out, ty: resultVecTy.clone()
    }
}

// find((&T)=>bool): Option<T>; any/all((&T)=>bool): bool. Walks the Vec calling
// the predicate per element; find deep-clones the first match into an Option, any
// short-circuits on the first true, all short-circuits on the first false.
pub fn genVecFindAnyAll(cg: &mut Cgen, obj: &Val, elemTy: &string, clv: &Val, mode: &string): Val {
    let inElemLl = llType(unwrapVec(resolveTyStr(cg, obj.ty)))
    let d = nextTemp(&mut cg)
    emit(&mut cg, "  " + d + " = extractvalue %Vec " + obj.v + ", 0\n")
    let len = nextTemp(&mut cg)
    emit(&mut cg, "  " + len + " = extractvalue %Vec " + obj.v + ", 1\n")
    let fp = nextTemp(&mut cg)
    emit(&mut cg, "  " + fp + " = extractvalue %Closure " + clv.v + ", 0\n")
    let env = nextTemp(&mut cg)
    emit(&mut cg, "  " + env + " = extractvalue %Closure " + clv.v + ", 1\n")

    let isFind = mode == "find"
    // result cell: Option<T> for find, i1 for any/all (any starts false, all true)
    var optName = ""
    var optTy = ""
    var someTag: i32 = 0 // variant tag (i32); annotate now that bare literals default i64
    let resAddr = nextTemp(&mut cg)
    if isFind {
        optName = stripPercent(resolveTyStr(cg, "Option<" + elemTy.clone() + ">"))
        optTy = "%" + optName
        someTag = lookupVariantTag(cg, optName, "Some")
        let noneTag = lookupVariantTag(cg, optName, "None")
        emit(&mut cg, "  " + resAddr + " = alloca " + optTy + "\n")
        let tagPtr = nextTemp(&mut cg)
        emit(&mut cg, "  " + tagPtr + " = getelementptr " + optTy + ", ptr " + resAddr + ", i32 0, i32 0\n")
        emit(&mut cg, "  store i32 " + noneTag.toString() + ", ptr " + tagPtr + "\n")
    } else {
        emit(&mut cg, "  " + resAddr + " = alloca i1\n")
        var init = "0"
        if mode == "all" {
            init = "1"
        }
        emit(&mut cg, "  store i1 " + init + ", ptr " + resAddr + "\n")
    }

    let iAddr = nextTemp(&mut cg)
    emit(&mut cg, "  " + iAddr + " = alloca i64\n")
    emit(&mut cg, "  store i64 0, ptr " + iAddr + "\n")
    let condLbl = nextLabel(&mut cg, "fa.cond")
    let bodyLbl = nextLabel(&mut cg, "fa.body")
    let contLbl = nextLabel(&mut cg, "fa.cont")
    let endLbl = nextLabel(&mut cg, "fa.end")
    emit(&mut cg, "  br label %" + condLbl + "\n")
    emitLabel(&mut cg, condLbl)
    let i = nextTemp(&mut cg)
    emit(&mut cg, "  " + i + " = load i64, ptr " + iAddr + "\n")
    let lt = nextTemp(&mut cg)
    emit(&mut cg, "  " + lt + " = icmp slt i64 " + i + ", " + len + "\n")
    emit(&mut cg, "  br i1 " + lt + ", label %" + bodyLbl + ", label %" + endLbl + "\n")
    emitLabel(&mut cg, bodyLbl)
    let slot = nextTemp(&mut cg)
    emit(&mut cg, "  " + slot + " = getelementptr " + inElemLl + ", ptr " + d + ", i64 " + i + "\n")
    let pred = nextTemp(&mut cg)
    emit(&mut cg, "  " + pred + " = call i1 " + fp + "(ptr " + env + ", ptr " + slot + ")\n")
    if isFind {
        let hitLbl = nextLabel(&mut cg, "fa.hit")
        emit(&mut cg, "  br i1 " + pred + ", label %" + hitLbl + ", label %" + contLbl + "\n")
        emitLabel(&mut cg, hitLbl)
        let ev = nextTemp(&mut cg)
        emit(&mut cg, "  " + ev + " = load " + inElemLl + ", ptr " + slot + "\n")
        let evc = genCloneOfLoaded(&mut cg, ev, elemTy)
        let tagPtr2 = nextTemp(&mut cg)
        emit(&mut cg, "  " + tagPtr2 + " = getelementptr " + optTy + ", ptr " + resAddr + ", i32 0, i32 0\n")
        emit(&mut cg, "  store i32 " + someTag.toString() + ", ptr " + tagPtr2 + "\n")
        let payPtr = nextTemp(&mut cg)
        emit(&mut cg, "  " + payPtr + " = getelementptr " + optTy + ", ptr " + resAddr + ", i32 0, i32 1\n")
        let pfp = nextTemp(&mut cg)
        emit(&mut cg, "  " + pfp + " = getelementptr { " + inElemLl + " }, ptr " + payPtr + ", i32 0, i32 0\n")
        emit(&mut cg, "  store " + inElemLl + " " + evc + ", ptr " + pfp + "\n")
        emit(&mut cg, "  br label %" + endLbl + "\n")
    } else {
        // any: break (store true) when pred true; all: break (store false) when pred false
        var hitVal = pred.clone()
        if mode == "all" {
            let neg = nextTemp(&mut cg)
            emit(&mut cg, "  " + neg + " = xor i1 " + pred + ", true\n")
            hitVal = neg
        }
        let hitLbl = nextLabel(&mut cg, "fa.hit")
        emit(&mut cg, "  br i1 " + hitVal + ", label %" + hitLbl + ", label %" + contLbl + "\n")
        emitLabel(&mut cg, hitLbl)
        var stored = "1"
        if mode == "all" {
            stored = "0"
        }
        emit(&mut cg, "  store i1 " + stored + ", ptr " + resAddr + "\n")
        emit(&mut cg, "  br label %" + endLbl + "\n")
    }
    emitLabel(&mut cg, contLbl)
    let i1v = nextTemp(&mut cg)
    emit(&mut cg, "  " + i1v + " = add i64 " + i + ", 1\n")
    emit(&mut cg, "  store i64 " + i1v + ", ptr " + iAddr + "\n")
    emit(&mut cg, "  br label %" + condLbl + "\n")
    emitLabel(&mut cg, endLbl)
    if isFind {
        let r = nextTemp(&mut cg)
        emit(&mut cg, "  " + r + " = load " + optTy + ", ptr " + resAddr + "\n")
        return Val {
            v: r, ty: optName
        }
    }
    let rb = nextTemp(&mut cg)
    emit(&mut cg, "  " + rb + " = load i1, ptr " + resAddr + "\n")
    return Val {
        v: rb, ty: "bool"
    }
}

// insert-at-index: grow if full, shift [idx..len) right one (descending copy so
// overlapping slots don't clobber), store elem at idx, len++.
pub fn genVecInsert(cg: &mut Cgen, addr: &string, vecTy: &string, idx: &string, elemVal: &Val): Val {
    ensureVecTy(&mut cg)
    ensureRealloc(&mut cg)
    let elemTy = unwrapVec(vecTy)
    let elemLl = llType(elemTy)

    let dPtr = nextTemp(&mut cg)
    emit(&mut cg, "  " + dPtr + " = getelementptr %Vec, ptr " + addr.clone() + ", i32 0, i32 0\n")
    let lPtr = nextTemp(&mut cg)
    emit(&mut cg, "  " + lPtr + " = getelementptr %Vec, ptr " + addr.clone() + ", i32 0, i32 1\n")
    let cPtr = nextTemp(&mut cg)
    emit(&mut cg, "  " + cPtr + " = getelementptr %Vec, ptr " + addr.clone() + ", i32 0, i32 2\n")
    let l = nextTemp(&mut cg)
    emit(&mut cg, "  " + l + " = load i64, ptr " + lPtr + "\n")
    let cap = nextTemp(&mut cg)
    emit(&mut cg, "  " + cap + " = load i64, ptr " + cPtr + "\n")

    let full = nextTemp(&mut cg)
    emit(&mut cg, "  " + full + " = icmp eq i64 " + l + ", " + cap + "\n")
    let growLbl = nextLabel(&mut cg, "vins.grow")
    let shiftLbl = nextLabel(&mut cg, "vins.shift")
    emit(&mut cg, "  br i1 " + full + ", label %" + growLbl + ", label %" + shiftLbl + "\n")
    emit(&mut cg, growLbl + ":\n")
    let d0 = nextTemp(&mut cg)
    emit(&mut cg, "  " + d0 + " = load ptr, ptr " + dPtr + "\n")
    let isZero = nextTemp(&mut cg)
    emit(&mut cg, "  " + isZero + " = icmp eq i64 " + cap + ", 0\n")
    let dbl = nextTemp(&mut cg)
    emit(&mut cg, "  " + dbl + " = mul i64 " + cap + ", 2\n")
    let newCap = nextTemp(&mut cg)
    emit(&mut cg, "  " + newCap + " = select i1 " + isZero + ", i64 4, i64 " + dbl + "\n")
    let esz = genSizeOf(&mut cg, elemLl)
    let bytes = nextTemp(&mut cg)
    emit(&mut cg, "  " + bytes + " = mul i64 " + newCap + ", " + esz + "\n")
    let nd = nextTemp(&mut cg)
    emit(&mut cg, "  " + nd + " = call ptr @realloc(ptr " + d0 + ", i64 " + bytes + ")\n")
    emit(&mut cg, "  store ptr " + nd + ", ptr " + dPtr + "\n")
    emit(&mut cg, "  store i64 " + newCap + ", ptr " + cPtr + "\n")
    emit(&mut cg, "  br label %" + shiftLbl + "\n")

    emit(&mut cg, shiftLbl + ":\n")
    let dd = nextTemp(&mut cg)
    emit(&mut cg, "  " + dd + " = load ptr, ptr " + dPtr + "\n")
    let iAddr = nextTemp(&mut cg)
    emit(&mut cg, "  " + iAddr + " = alloca i64\n")
    let lm1 = nextTemp(&mut cg)
    emit(&mut cg, "  " + lm1 + " = sub i64 " + l + ", 1\n")
    emit(&mut cg, "  store i64 " + lm1 + ", ptr " + iAddr + "\n")
    let condLbl = nextLabel(&mut cg, "vins.cond")
    let bodyLbl = nextLabel(&mut cg, "vins.body")
    let doneLbl = nextLabel(&mut cg, "vins.done")
    emit(&mut cg, "  br label %" + condLbl + "\n")
    emit(&mut cg, condLbl + ":\n")
    let i = nextTemp(&mut cg)
    emit(&mut cg, "  " + i + " = load i64, ptr " + iAddr + "\n")
    let ge = nextTemp(&mut cg)
    emit(&mut cg, "  " + ge + " = icmp sge i64 " + i + ", " + idx.clone() + "\n")
    emit(&mut cg, "  br i1 " + ge + ", label %" + bodyLbl + ", label %" + doneLbl + "\n")
    emit(&mut cg, bodyLbl + ":\n")
    let src = nextTemp(&mut cg)
    emit(&mut cg, "  " + src + " = getelementptr " + elemLl + ", ptr " + dd + ", i64 " + i + "\n")
    let ip1 = nextTemp(&mut cg)
    emit(&mut cg, "  " + ip1 + " = add i64 " + i + ", 1\n")
    let dst = nextTemp(&mut cg)
    emit(&mut cg, "  " + dst + " = getelementptr " + elemLl + ", ptr " + dd + ", i64 " + ip1 + "\n")
    let ev = nextTemp(&mut cg)
    emit(&mut cg, "  " + ev + " = load " + elemLl + ", ptr " + src + "\n")
    emit(&mut cg, "  store " + elemLl + " " + ev + ", ptr " + dst + "\n")
    let im1 = nextTemp(&mut cg)
    emit(&mut cg, "  " + im1 + " = sub i64 " + i + ", 1\n")
    emit(&mut cg, "  store i64 " + im1 + ", ptr " + iAddr + "\n")
    emit(&mut cg, "  br label %" + condLbl + "\n")
    emit(&mut cg, doneLbl + ":\n")
    let slot = nextTemp(&mut cg)
    emit(&mut cg, "  " + slot + " = getelementptr " + elemLl + ", ptr " + dd + ", i64 " + idx.clone() + "\n")
    emit(&mut cg, "  store " + elemLl + " " + elemVal.v.clone() + ", ptr " + slot + "\n")
    let l1 = nextTemp(&mut cg)
    emit(&mut cg, "  " + l1 + " = add i64 " + l + ", 1\n")
    emit(&mut cg, "  store i64 " + l1 + ", ptr " + lPtr + "\n")
    return Val {
        v: "0", ty: "void"
    }
}

// remove-at-index: load the elem to return, shift [idx+1..len) left one
// (ascending copy, safe since dst<src for a left shift), len--.
pub fn genVecRemove(cg: &mut Cgen, addr: &string, vecTy: &string, idx: &string): Val {
    ensureVecTy(&mut cg)
    let elemTy = unwrapVec(vecTy)
    let elemLl = llType(elemTy)

    let dPtr = nextTemp(&mut cg)
    emit(&mut cg, "  " + dPtr + " = getelementptr %Vec, ptr " + addr.clone() + ", i32 0, i32 0\n")
    let lPtr = nextTemp(&mut cg)
    emit(&mut cg, "  " + lPtr + " = getelementptr %Vec, ptr " + addr.clone() + ", i32 0, i32 1\n")
    let d = nextTemp(&mut cg)
    emit(&mut cg, "  " + d + " = load ptr, ptr " + dPtr + "\n")
    let l = nextTemp(&mut cg)
    emit(&mut cg, "  " + l + " = load i64, ptr " + lPtr + "\n")

    let rslot = nextTemp(&mut cg)
    emit(&mut cg, "  " + rslot + " = getelementptr " + elemLl + ", ptr " + d + ", i64 " + idx.clone() + "\n")
    let rv = nextTemp(&mut cg)
    emit(&mut cg, "  " + rv + " = load " + elemLl + ", ptr " + rslot + "\n")

    let iAddr = nextTemp(&mut cg)
    emit(&mut cg, "  " + iAddr + " = alloca i64\n")
    emit(&mut cg, "  store i64 " + idx.clone() + ", ptr " + iAddr + "\n")
    let lm1 = nextTemp(&mut cg)
    emit(&mut cg, "  " + lm1 + " = sub i64 " + l + ", 1\n")
    let condLbl = nextLabel(&mut cg, "vrm.cond")
    let bodyLbl = nextLabel(&mut cg, "vrm.body")
    let doneLbl = nextLabel(&mut cg, "vrm.done")
    emit(&mut cg, "  br label %" + condLbl + "\n")
    emit(&mut cg, condLbl + ":\n")
    let i = nextTemp(&mut cg)
    emit(&mut cg, "  " + i + " = load i64, ptr " + iAddr + "\n")
    let lt = nextTemp(&mut cg)
    emit(&mut cg, "  " + lt + " = icmp slt i64 " + i + ", " + lm1 + "\n")
    emit(&mut cg, "  br i1 " + lt + ", label %" + bodyLbl + ", label %" + doneLbl + "\n")
    emit(&mut cg, bodyLbl + ":\n")
    let ip1 = nextTemp(&mut cg)
    emit(&mut cg, "  " + ip1 + " = add i64 " + i + ", 1\n")
    let src = nextTemp(&mut cg)
    emit(&mut cg, "  " + src + " = getelementptr " + elemLl + ", ptr " + d + ", i64 " + ip1 + "\n")
    let dst = nextTemp(&mut cg)
    emit(&mut cg, "  " + dst + " = getelementptr " + elemLl + ", ptr " + d + ", i64 " + i + "\n")
    let ev = nextTemp(&mut cg)
    emit(&mut cg, "  " + ev + " = load " + elemLl + ", ptr " + src + "\n")
    emit(&mut cg, "  store " + elemLl + " " + ev + ", ptr " + dst + "\n")
    emit(&mut cg, "  store i64 " + ip1 + ", ptr " + iAddr + "\n")
    emit(&mut cg, "  br label %" + condLbl + "\n")
    emit(&mut cg, doneLbl + ":\n")
    emit(&mut cg, "  store i64 " + lm1 + ", ptr " + lPtr + "\n")
    return Val {
        v: rv, ty: elemTy
    }
}

// -- HashMap runtime: flat { K, V } entry array, linear scan --

pub fn genHashMapNew(cg: &mut Cgen, hintTy: &string): Val {
    ensureHashMapTy(&mut cg)
    let a = nextTemp(&mut cg)
    emit(&mut cg, "  " + a + " = insertvalue %HashMap undef, ptr null, 0\n")
    let b = nextTemp(&mut cg)
    emit(&mut cg, "  " + b + " = insertvalue %HashMap " + a + ", i64 0, 1\n")
    let c = nextTemp(&mut cg)
    emit(&mut cg, "  " + c + " = insertvalue %HashMap " + b + ", i64 0, 2\n")
    var ty = hintTy.clone()
    if !isHashMapTy(ty) {
        ty = "HashMap<i64, i64>"
    }
    return Val {
        v: c, ty: ty
    }
}

// i1 temp that is true when two keys of keyTy compare equal
// Structural equality for an aggregate: compare every field and AND the results. Returns
// "" when some field has a type milo0 cannot compare, so callers fail loudly instead of
// emitting `icmp` on an aggregate (not valid IR) or comparing field 0 alone (which calls
// distinct values equal — the previous behaviour, which passed the fixtures only because
// their differing values happened to differ in the first field).
// Field-wise equality for an INLINE fixed-array struct field (`[N x T]` in the
// LLVM struct layout, not the {ptr,len,cap} %Vec runtime representation locals/
// params use — see the marker-string comment on isInlineArrTy). `extractvalue`
// only takes a struct/array VALUE and an index; there is no `icmp` on an
// aggregate, so the only way to compare one is to unroll it element-wise and fold
// with `and`, exactly like genAggregateEq does for a struct's own fields.
// Uuid's 16-byte `bytes: [u8;16]` field is exactly this shape — unhandled, it left
// genAggregateEq unable to compare the struct at all, and the BinOp handler fell
// through to a raw `icmp eq %Uuid ...`, which LLVM rejects on any aggregate.
pub fn genInlineArrEq(cg: &mut Cgen, arrTy: &string, a: &string, b: &string): string {
    let n = inlineArrLen(arrTy)
    let elemTy = inlineArrElem(arrTy)
    let elemLl = llType(elemTy)
    let arrLl = llType(arrTy)
    var acc = ""
    var i: i64 = 0
    while i < n {
        let ea = nextTemp(&mut cg)
        emit(&mut cg, "  " + ea + " = extractvalue " + arrLl.clone() + " " + a.clone() + ", " + i.toString() + "\n")
        let eb = nextTemp(&mut cg)
        emit(&mut cg, "  " + eb + " = extractvalue " + arrLl.clone() + " " + b.clone() + ", " + i.toString() + "\n")
        var one = ""
        if elemLl == "i1" || elemLl == "i8" || elemLl == "i16" || elemLl == "i32" || elemLl == "i64" || elemLl == "ptr" {
            let t1 = nextTemp(&mut cg)
            emit(&mut cg, "  " + t1 + " = icmp eq " + elemLl.clone() + " " + ea + ", " + eb + "\n")
            one = t1
        } else if elemLl == "double" || elemLl == "float" {
            let t2 = nextTemp(&mut cg)
            emit(&mut cg, "  " + t2 + " = fcmp oeq " + elemLl.clone() + " " + ea + ", " + eb + "\n")
            one = t2
        } else {
            // element itself an aggregate (nested array/struct) — not needed by any
            // fixture yet; fail closed rather than emit an invalid comparison.
            return ""
        }
        if acc.len == 0 {
            acc = one
        } else {
            let t3 = nextTemp(&mut cg)
            emit(&mut cg, "  " + t3 + " = and i1 " + acc.clone() + ", " + one + "\n")
            acc = t3
        }
        i = i + 1
    }
    // A zero-length fixed array has nothing to disagree on.
    if acc.len == 0 {
        return "true"
    }
    return acc
}

pub fn genAggregateEq(cg: &mut Cgen, aggLl: &string, a: &string, b: &string): string {
    let aggName = stripPercent(aggLl.clone())
    if !cg.structs.contains(aggName) {
        return ""
    }
    let sf = cg.structs.get(aggName)!
    var acc = ""
    for fi in 0..sf.len {
        let fty = sf[fi].ty.clone()
        let fll = llType(fty)
        let ea = nextTemp(&mut cg)
        emit(&mut cg, "  " + ea + " = extractvalue " + aggLl.clone() + " " + a.clone() + ", " + fi.toString() + "\n")
        let eb = nextTemp(&mut cg)
        emit(&mut cg, "  " + eb + " = extractvalue " + aggLl.clone() + " " + b.clone() + ", " + fi.toString() + "\n")
        var one = ""
        if fll == "%String" {
            let r = genStringEq(&mut cg, ea, eb, true)
            one = r.v.clone()
        } else if fll == "i1" || fll == "i8" || fll == "i16" || fll == "i32" || fll == "i64" || fll == "ptr" {
            let t1 = nextTemp(&mut cg)
            emit(&mut cg, "  " + t1 + " = icmp eq " + fll.clone() + " " + ea + ", " + eb + "\n")
            one = t1
        } else if fll == "double" || fll == "float" {
            let t2 = nextTemp(&mut cg)
            emit(&mut cg, "  " + t2 + " = fcmp oeq " + fll.clone() + " " + ea + ", " + eb + "\n")
            one = t2
        } else if isInlineArrTy(fty) {
            let r = genInlineArrEq(&mut cg, fty, ea, eb)
            if r.len == 0 {
                return ""
            }
            one = r
        } else if fll.len > 1 && fll[0] == 37 && cg.structs.contains(stripPercent(fll.clone())) {
            let r = genAggregateEq(&mut cg, fll, ea, eb)
            if r.len == 0 {
                return ""
            }
            one = r
        } else {
            return ""
        }
        if acc.len == 0 {
            acc = one
        } else {
            let t3 = nextTemp(&mut cg)
            emit(&mut cg, "  " + t3 + " = and i1 " + acc.clone() + ", " + one + "\n")
            acc = t3
        }
    }
    return acc
}

pub fn genKeyEq(cg: &mut Cgen, keyTy: &string, a: &string, b: &string): string {
    let keyLl = llType(keyTy)
    if keyLl == "%String" {
        let r = genStringEq(&mut cg, a, b, true)
        return r.v
    }
    // A struct key is an aggregate; `icmp` is not defined on aggregates.
    if keyLl.len > 1 && keyLl[0] == 37 && cg.structs.contains(stripPercent(keyLl.clone())) {
        let r = genAggregateEq(&mut cg, keyLl, a, b)
        if r.len == 0 {
            eprint("codegen: HashMap key '" + stripPercent(keyLl.clone()) + "' has a field milo0 cannot compare")
            exit(1)
        }
        return r
    }
    let t = nextTemp(&mut cg)
    emit(&mut cg, "  " + t + " = icmp eq " + keyLl + " " + a + ", " + b + "\n")
    return t
}

// Scan loop shared by contains/getOrDefault/remove/insert: walks entries from
// a data ptr + count, jumping to foundLbl with the index in idxAddr on key
// match, or notFoundLbl after the last entry.
pub fn genHashMapScan(cg: &mut Cgen, entryTy: &string, keyTy: &string, data: &string, count: &string, keyVal: &string, idxAddr: &string, foundLbl: &string, notFoundLbl: &string) {
    let condLbl = nextLabel(&mut cg, "hm.scan.cond")
    let bodyLbl = nextLabel(&mut cg, "hm.scan.body")
    let stepLbl = nextLabel(&mut cg, "hm.scan.step")
    emit(&mut cg, "  store i64 0, ptr " + idxAddr + "\n")
    emit(&mut cg, "  br label %" + condLbl + "\n")
    emit(&mut cg, condLbl + ":\n")
    let i = nextTemp(&mut cg)
    emit(&mut cg, "  " + i + " = load i64, ptr " + idxAddr + "\n")
    let lt = nextTemp(&mut cg)
    emit(&mut cg, "  " + lt + " = icmp slt i64 " + i + ", " + count + "\n")
    emit(&mut cg, "  br i1 " + lt + ", label %" + bodyLbl + ", label %" + notFoundLbl + "\n")
    emit(&mut cg, bodyLbl + ":\n")
    let slot = nextTemp(&mut cg)
    emit(&mut cg, "  " + slot + " = getelementptr " + entryTy + ", ptr " + data + ", i64 " + i + "\n")
    let kp = nextTemp(&mut cg)
    emit(&mut cg, "  " + kp + " = getelementptr " + entryTy + ", ptr " + slot + ", i32 0, i32 0\n")
    let k = nextTemp(&mut cg)
    emit(&mut cg, "  " + k + " = load " + llType(keyTy) + ", ptr " + kp + "\n")
    let eq = genKeyEq(&mut cg, keyTy, k, keyVal)
    emit(&mut cg, "  br i1 " + eq + ", label %" + foundLbl + ", label %" + stepLbl + "\n")
    emit(&mut cg, stepLbl + ":\n")
    let i1t = nextTemp(&mut cg)
    emit(&mut cg, "  " + i1t + " = add i64 " + i + ", 1\n")
    emit(&mut cg, "  store i64 " + i1t + ", ptr " + idxAddr + "\n")
    emit(&mut cg, "  br label %" + condLbl + "\n")
}

// insert through the receiver's address: replace on key match, else append
// (growing the entry array like Vec push).
pub fn genHashMapInsert(cg: &mut Cgen, addr: &string, mapTy: &string, keyVal: &Val, valVal: &Val): Val {
    ensureHashMapTy(&mut cg)
    ensureRealloc(&mut cg)
    let keyTy = hashMapKeyTy(mapTy)
    let valTy = hashMapValTy(mapTy)
    let entryTy = hmEntryTy(keyTy, valTy)
    let keyLl = llType(keyTy)
    let valLl = llType(valTy)

    let dPtr = nextTemp(&mut cg)
    emit(&mut cg, "  " + dPtr + " = getelementptr %HashMap, ptr " + addr.clone() + ", i32 0, i32 0\n")
    let lPtr = nextTemp(&mut cg)
    emit(&mut cg, "  " + lPtr + " = getelementptr %HashMap, ptr " + addr.clone() + ", i32 0, i32 1\n")
    let cPtr = nextTemp(&mut cg)
    emit(&mut cg, "  " + cPtr + " = getelementptr %HashMap, ptr " + addr.clone() + ", i32 0, i32 2\n")
    let d = nextTemp(&mut cg)
    emit(&mut cg, "  " + d + " = load ptr, ptr " + dPtr + "\n")
    let l = nextTemp(&mut cg)
    emit(&mut cg, "  " + l + " = load i64, ptr " + lPtr + "\n")
    let cap = nextTemp(&mut cg)
    emit(&mut cg, "  " + cap + " = load i64, ptr " + cPtr + "\n")

    let idxAddr = nextTemp(&mut cg)
    emit(&mut cg, "  " + idxAddr + " = alloca i64\n")
    let foundLbl = nextLabel(&mut cg, "hm.ins.found")
    let missLbl = nextLabel(&mut cg, "hm.ins.miss")
    let doneLbl = nextLabel(&mut cg, "hm.ins.done")
    genHashMapScan(&mut cg, entryTy, keyTy, d, l, keyVal.v, idxAddr, foundLbl, missLbl)

    emit(&mut cg, foundLbl + ":\n")
    let fi = nextTemp(&mut cg)
    emit(&mut cg, "  " + fi + " = load i64, ptr " + idxAddr + "\n")
    let fslot = nextTemp(&mut cg)
    emit(&mut cg, "  " + fslot + " = getelementptr " + entryTy + ", ptr " + d + ", i64 " + fi + "\n")
    let fvp = nextTemp(&mut cg)
    emit(&mut cg, "  " + fvp + " = getelementptr " + entryTy + ", ptr " + fslot + ", i32 0, i32 1\n")
    emit(&mut cg, "  store " + valLl + " " + valVal.v + ", ptr " + fvp + "\n")
    emit(&mut cg, "  br label %" + doneLbl + "\n")

    emit(&mut cg, missLbl + ":\n")
    let full = nextTemp(&mut cg)
    emit(&mut cg, "  " + full + " = icmp eq i64 " + l + ", " + cap + "\n")
    let growLbl = nextLabel(&mut cg, "hm.ins.grow")
    let storeLbl = nextLabel(&mut cg, "hm.ins.store")
    emit(&mut cg, "  br i1 " + full + ", label %" + growLbl + ", label %" + storeLbl + "\n")
    emit(&mut cg, growLbl + ":\n")
    let isZero = nextTemp(&mut cg)
    emit(&mut cg, "  " + isZero + " = icmp eq i64 " + cap + ", 0\n")
    let dbl = nextTemp(&mut cg)
    emit(&mut cg, "  " + dbl + " = mul i64 " + cap + ", 2\n")
    let newCap = nextTemp(&mut cg)
    emit(&mut cg, "  " + newCap + " = select i1 " + isZero + ", i64 8, i64 " + dbl + "\n")
    let esz = genSizeOf(&mut cg, entryTy)
    let bytes = nextTemp(&mut cg)
    emit(&mut cg, "  " + bytes + " = mul i64 " + newCap + ", " + esz + "\n")
    let nd = nextTemp(&mut cg)
    emit(&mut cg, "  " + nd + " = call ptr @realloc(ptr " + d + ", i64 " + bytes + ")\n")
    emit(&mut cg, "  store ptr " + nd + ", ptr " + dPtr + "\n")
    emit(&mut cg, "  store i64 " + newCap + ", ptr " + cPtr + "\n")
    emit(&mut cg, "  br label %" + storeLbl + "\n")
    emit(&mut cg, storeLbl + ":\n")
    let dd = nextTemp(&mut cg)
    emit(&mut cg, "  " + dd + " = load ptr, ptr " + dPtr + "\n")
    let nslot = nextTemp(&mut cg)
    emit(&mut cg, "  " + nslot + " = getelementptr " + entryTy + ", ptr " + dd + ", i64 " + l + "\n")
    let nkp = nextTemp(&mut cg)
    emit(&mut cg, "  " + nkp + " = getelementptr " + entryTy + ", ptr " + nslot + ", i32 0, i32 0\n")
    emit(&mut cg, "  store " + keyLl + " " + keyVal.v + ", ptr " + nkp + "\n")
    let nvp = nextTemp(&mut cg)
    emit(&mut cg, "  " + nvp + " = getelementptr " + entryTy + ", ptr " + nslot + ", i32 0, i32 1\n")
    emit(&mut cg, "  store " + valLl + " " + valVal.v + ", ptr " + nvp + "\n")
    let l1 = nextTemp(&mut cg)
    emit(&mut cg, "  " + l1 + " = add i64 " + l + ", 1\n")
    emit(&mut cg, "  store i64 " + l1 + ", ptr " + lPtr + "\n")
    emit(&mut cg, "  br label %" + doneLbl + "\n")
    emit(&mut cg, doneLbl + ":\n")
    return Val {
        v: "0", ty: "void"
    }
}

// contains/getOrDefault: read-only scans over a loaded %HashMap value.
pub fn genHashMapContains(cg: &mut Cgen, obj: &Val, keyVal: &Val): Val {
    ensureHashMapTy(&mut cg)
    let keyTy = hashMapKeyTy(obj.ty)
    let valTy = hashMapValTy(obj.ty)
    let entryTy = hmEntryTy(keyTy, valTy)
    let d = nextTemp(&mut cg)
    emit(&mut cg, "  " + d + " = extractvalue %HashMap " + obj.v + ", 0\n")
    let l = nextTemp(&mut cg)
    emit(&mut cg, "  " + l + " = extractvalue %HashMap " + obj.v + ", 1\n")
    let resAddr = nextTemp(&mut cg)
    emit(&mut cg, "  " + resAddr + " = alloca i1\n")
    emit(&mut cg, "  store i1 0, ptr " + resAddr + "\n")
    let idxAddr = nextTemp(&mut cg)
    emit(&mut cg, "  " + idxAddr + " = alloca i64\n")
    let foundLbl = nextLabel(&mut cg, "hm.has.found")
    let endLbl = nextLabel(&mut cg, "hm.has.end")
    genHashMapScan(&mut cg, entryTy, keyTy, d, l, keyVal.v, idxAddr, foundLbl, endLbl)
    emit(&mut cg, foundLbl + ":\n")
    emit(&mut cg, "  store i1 1, ptr " + resAddr + "\n")
    emit(&mut cg, "  br label %" + endLbl + "\n")
    emit(&mut cg, endLbl + ":\n")
    let r = nextTemp(&mut cg)
    emit(&mut cg, "  " + r + " = load i1, ptr " + resAddr + "\n")
    return Val {
        v: r, ty: "bool"
    }
}

// get returns Option_<V> — the checker monomorphizes it, so the enum layout
// is registered by the time this emits.
pub fn genHashMapGet(cg: &mut Cgen, obj: &Val, keyVal: &Val): Val {
    ensureHashMapTy(&mut cg)
    let keyTy = hashMapKeyTy(obj.ty)
    let valTy = hashMapValTy(obj.ty)
    let entryTy = hmEntryTy(keyTy, valTy)
    let valLl = llType(valTy)
    // Mangle the whole `Option<valTy>` so a nested generic value (Vec<ImplInfo>)
    // resolves to the registered mono enum (Option_Vec_ImplInfo, not the partial
    // Option_Vec<ImplInfo>).
    let optName = stripPercent(resolveTyStr(cg, "Option<" + valTy + ">"))
    let optTy = "%" + optName
    let someTag = lookupVariantTag(cg, optName, "Some")
    let noneTag = lookupVariantTag(cg, optName, "None")
    let resAddr = nextTemp(&mut cg)
    emit(&mut cg, "  " + resAddr + " = alloca " + optTy + "\n")
    let tagPtr = nextTemp(&mut cg)
    emit(&mut cg, "  " + tagPtr + " = getelementptr " + optTy + ", ptr " + resAddr + ", i32 0, i32 0\n")
    emit(&mut cg, "  store i32 " + noneTag.toString() + ", ptr " + tagPtr + "\n")
    let d = nextTemp(&mut cg)
    emit(&mut cg, "  " + d + " = extractvalue %HashMap " + obj.v + ", 0\n")
    let l = nextTemp(&mut cg)
    emit(&mut cg, "  " + l + " = extractvalue %HashMap " + obj.v + ", 1\n")
    let idxAddr = nextTemp(&mut cg)
    emit(&mut cg, "  " + idxAddr + " = alloca i64\n")
    let foundLbl = nextLabel(&mut cg, "hm.get.found")
    let endLbl = nextLabel(&mut cg, "hm.get.end")
    genHashMapScan(&mut cg, entryTy, keyTy, d, l, keyVal.v, idxAddr, foundLbl, endLbl)
    emit(&mut cg, foundLbl + ":\n")
    let fi = nextTemp(&mut cg)
    emit(&mut cg, "  " + fi + " = load i64, ptr " + idxAddr + "\n")
    let slot = nextTemp(&mut cg)
    emit(&mut cg, "  " + slot + " = getelementptr " + entryTy + ", ptr " + d + ", i64 " + fi + "\n")
    let vp = nextTemp(&mut cg)
    emit(&mut cg, "  " + vp + " = getelementptr " + entryTy + ", ptr " + slot + ", i32 0, i32 1\n")
    let fv = nextTemp(&mut cg)
    emit(&mut cg, "  " + fv + " = load " + valLl + ", ptr " + vp + "\n")
    // DEEP-CLONE the value: a shallow load shares the value's Vec/String/HashMap
    // buffers with the entry still in the map, so dropping the returned Option
    // frees them out from under the map (later gets read freed memory → garbage).
    let fvc = genCloneOfLoaded(&mut cg, fv, valTy)
    emit(&mut cg, "  store i32 " + someTag.toString() + ", ptr " + tagPtr + "\n")
    let payPtr = nextTemp(&mut cg)
    emit(&mut cg, "  " + payPtr + " = getelementptr " + optTy + ", ptr " + resAddr + ", i32 0, i32 1\n")
    let pstructTy = "{ " + valLl + " }"
    let fp = nextTemp(&mut cg)
    emit(&mut cg, "  " + fp + " = getelementptr " + pstructTy + ", ptr " + payPtr + ", i32 0, i32 0\n")
    emit(&mut cg, "  store " + valLl + " " + fvc + ", ptr " + fp + "\n")
    emit(&mut cg, "  br label %" + endLbl + "\n")
    emit(&mut cg, endLbl + ":\n")
    let r = nextTemp(&mut cg)
    emit(&mut cg, "  " + r + " = load " + optTy + ", ptr " + resAddr + "\n")
    return Val {
        v: r, ty: optName
    }
}

pub fn genHashMapGetOrDefault(cg: &mut Cgen, obj: &Val, keyVal: &Val, defVal: &Val): Val {
    ensureHashMapTy(&mut cg)
    let keyTy = hashMapKeyTy(obj.ty)
    let valTy = hashMapValTy(obj.ty)
    let entryTy = hmEntryTy(keyTy, valTy)
    let valLl = llType(valTy)
    let d = nextTemp(&mut cg)
    emit(&mut cg, "  " + d + " = extractvalue %HashMap " + obj.v + ", 0\n")
    let l = nextTemp(&mut cg)
    emit(&mut cg, "  " + l + " = extractvalue %HashMap " + obj.v + ", 1\n")
    let resAddr = nextTemp(&mut cg)
    emit(&mut cg, "  " + resAddr + " = alloca " + valLl + "\n")
    emit(&mut cg, "  store " + valLl + " " + defVal.v + ", ptr " + resAddr + "\n")
    let idxAddr = nextTemp(&mut cg)
    emit(&mut cg, "  " + idxAddr + " = alloca i64\n")
    let foundLbl = nextLabel(&mut cg, "hm.god.found")
    let endLbl = nextLabel(&mut cg, "hm.god.end")
    genHashMapScan(&mut cg, entryTy, keyTy, d, l, keyVal.v, idxAddr, foundLbl, endLbl)
    emit(&mut cg, foundLbl + ":\n")
    let fi = nextTemp(&mut cg)
    emit(&mut cg, "  " + fi + " = load i64, ptr " + idxAddr + "\n")
    let slot = nextTemp(&mut cg)
    emit(&mut cg, "  " + slot + " = getelementptr " + entryTy + ", ptr " + d + ", i64 " + fi + "\n")
    let vp = nextTemp(&mut cg)
    emit(&mut cg, "  " + vp + " = getelementptr " + entryTy + ", ptr " + slot + ", i32 0, i32 1\n")
    let fv = nextTemp(&mut cg)
    emit(&mut cg, "  " + fv + " = load " + valLl + ", ptr " + vp + "\n")
    // deep-clone so the returned value owns its buffers (see genHashMapGet)
    let fvc = genCloneOfLoaded(&mut cg, fv, valTy)
    emit(&mut cg, "  store " + valLl + " " + fvc + ", ptr " + resAddr + "\n")
    emit(&mut cg, "  br label %" + endLbl + "\n")
    emit(&mut cg, endLbl + ":\n")
    let r = nextTemp(&mut cg)
    emit(&mut cg, "  " + r + " = load " + valLl + ", ptr " + resAddr + "\n")
    return Val {
        v: r, ty: valTy
    }
}

// remove through the receiver's address: swap the last entry into the hole.
pub fn genHashMapRemove(cg: &mut Cgen, addr: &string, mapTy: &string, keyVal: &Val): Val {
    ensureHashMapTy(&mut cg)
    let keyTy = hashMapKeyTy(mapTy)
    let valTy = hashMapValTy(mapTy)
    let entryTy = hmEntryTy(keyTy, valTy)
    let dPtr = nextTemp(&mut cg)
    emit(&mut cg, "  " + dPtr + " = getelementptr %HashMap, ptr " + addr.clone() + ", i32 0, i32 0\n")
    let lPtr = nextTemp(&mut cg)
    emit(&mut cg, "  " + lPtr + " = getelementptr %HashMap, ptr " + addr.clone() + ", i32 0, i32 1\n")
    let d = nextTemp(&mut cg)
    emit(&mut cg, "  " + d + " = load ptr, ptr " + dPtr + "\n")
    let l = nextTemp(&mut cg)
    emit(&mut cg, "  " + l + " = load i64, ptr " + lPtr + "\n")
    let resAddr = nextTemp(&mut cg)
    emit(&mut cg, "  " + resAddr + " = alloca i1\n")
    emit(&mut cg, "  store i1 0, ptr " + resAddr + "\n")
    let idxAddr = nextTemp(&mut cg)
    emit(&mut cg, "  " + idxAddr + " = alloca i64\n")
    let foundLbl = nextLabel(&mut cg, "hm.rm.found")
    let endLbl = nextLabel(&mut cg, "hm.rm.end")
    genHashMapScan(&mut cg, entryTy, keyTy, d, l, keyVal.v, idxAddr, foundLbl, endLbl)
    emit(&mut cg, foundLbl + ":\n")
    let fi = nextTemp(&mut cg)
    emit(&mut cg, "  " + fi + " = load i64, ptr " + idxAddr + "\n")
    let last = nextTemp(&mut cg)
    emit(&mut cg, "  " + last + " = sub i64 " + l + ", 1\n")
    let slot = nextTemp(&mut cg)
    emit(&mut cg, "  " + slot + " = getelementptr " + entryTy + ", ptr " + d + ", i64 " + fi + "\n")
    let lastSlot = nextTemp(&mut cg)
    emit(&mut cg, "  " + lastSlot + " = getelementptr " + entryTy + ", ptr " + d + ", i64 " + last + "\n")
    let moved = nextTemp(&mut cg)
    emit(&mut cg, "  " + moved + " = load " + entryTy + ", ptr " + lastSlot + "\n")
    emit(&mut cg, "  store " + entryTy + " " + moved + ", ptr " + slot + "\n")
    emit(&mut cg, "  store i64 " + last + ", ptr " + lPtr + "\n")
    emit(&mut cg, "  store i1 1, ptr " + resAddr + "\n")
    emit(&mut cg, "  br label %" + endLbl + "\n")
    emit(&mut cg, endLbl + ":\n")
    let r = nextTemp(&mut cg)
    emit(&mut cg, "  " + r + " = load i1, ptr " + resAddr + "\n")
    return Val {
        v: r, ty: "bool"
    }
}

// Fixed arrays lower onto the Vec runtime (see astTypeStr): a literal is a
// malloc'd buffer with a {ptr, n, n} header.
pub fn genArrayLit(cg: &mut Cgen, elems: &Vec<Heap<ExprNode>>, locs: &Vec<Local>, sigs: &Vec<CgFnSig>, hintTy: &string): Val {
    // Struct-field array (hintTy = the "[N]elem" inline marker, see
    // codegen/types.milo): build the real `[N x T]` aggregate via an alloca +
    // GEP + store sequence, not a malloc'd %Vec — there is no separate heap
    // buffer, the bytes live inline in the enclosing struct.
    if isInlineArrTy(hintTy) {
        let n = inlineArrLen(hintTy)
        if elems.len != n {
            eprint("codegen: array literal has " + elems.len.toString() + " elements, field expects " + n.toString())
            exit(1)
        }
        let elemTy = inlineArrElem(hintTy)
        let elemLl = llType(elemTy)
        let arrLl = llType(hintTy)
        let alloc = nextTemp(&mut cg)
        emit(&mut cg, "  " + alloc + " = alloca " + arrLl + "\n")
        for i in 0..elems.len {
            let v = genExpr(&mut cg, *elems[i], locs, sigs, elemTy.clone())
            let slot = nextTemp(&mut cg)
            emit(&mut cg, "  " + slot + " = getelementptr " + arrLl + ", ptr " + alloc + ", i32 0, i32 " + i.toString() + "\n")
            emit(&mut cg, "  store " + elemLl + " " + v.v + ", ptr " + slot + "\n")
        }
        let loaded = nextTemp(&mut cg)
        emit(&mut cg, "  " + loaded + " = load " + arrLl + ", ptr " + alloc + "\n")
        return Val {
            v: loaded, ty: hintTy.clone()
        }
    }
    ensureVecTy(&mut cg)
    ensureMalloc(&mut cg)
    // Overwritten from the hint just below, or inferred from the first element in the
    // loop after it. It survives only for an EMPTY literal with no hint, which is the one
    // case with no element type to be had — see the haveTy check after the loop.
    var elemTy = "i64"
    var haveTy = false
    if isVecTy(hintTy) {
        elemTy = unwrapVec(hintTy)
        haveTy = true
    }
    var vals: Vec<Val> = Vec.new()
    for i in 0..elems.len {
        var h = ""
        if haveTy {
            h = elemTy.clone()
        }
        let v = genExpr(&mut cg, *elems[i], locs, sigs, h)
        if !haveTy {
            elemTy = v.ty.clone()
            haveTy = true
        }
        vals.push(v)
    }
    // An empty literal with no hint: nothing supplied an element type and there is no
    // element to infer one from. i64 here would name the Vec `Vec<i64>` on the strength of
    // nothing — the checker requires an annotation in that position, so reaching this
    // means the hint was lost on the way down rather than the program being untyped.
    if !haveTy {
        eprint("internal error: empty array literal with no element type — no hint reached it and there is no element to infer from")
        unsafe {
            exit(1)
        }
    }
    let elemLl = llType(elemTy)
    let esz = genSizeOf(&mut cg, elemLl)
    let n = elems.len
    let bytes = nextTemp(&mut cg)
    emit(&mut cg, "  " + bytes + " = mul i64 " + n.toString() + ", " + esz + "\n")
    let data = nextTemp(&mut cg)
    emit(&mut cg, "  " + data + " = call ptr @malloc(i64 " + bytes + ")\n")
    for i in 0..vals.len {
        let slot = nextTemp(&mut cg)
        emit(&mut cg, "  " + slot + " = getelementptr " + elemLl + ", ptr " + data + ", i64 " + i.toString() + "\n")
        emit(&mut cg, "  store " + elemLl + " " + vals[i].v + ", ptr " + slot + "\n")
    }
    let a = nextTemp(&mut cg)
    emit(&mut cg, "  " + a + " = insertvalue %Vec undef, ptr " + data + ", 0\n")
    let b = nextTemp(&mut cg)
    emit(&mut cg, "  " + b + " = insertvalue %Vec " + a + ", i64 " + n.toString() + ", 1\n")
    let c = nextTemp(&mut cg)
    emit(&mut cg, "  " + c + " = insertvalue %Vec " + b + ", i64 " + n.toString() + ", 2\n")
    return Val {
        v: c, ty: "Vec<" + elemTy + ">"
    }
}

// [x; N] — evaluate once, fill N slots with an emitted loop (N can be large).
pub fn genArrayRepeat(cg: &mut Cgen, value: &ExprNode, count: i64, locs: &Vec<Local>, sigs: &Vec<CgFnSig>, hintTy: &string): Val {
    // Struct-field array — same inline-aggregate treatment as genArrayLit above.
    // Unrolled (count is always compile-time known for a fixed-size field).
    if isInlineArrTy(hintTy) {
        let elemTy = inlineArrElem(hintTy)
        let elemLl = llType(elemTy)
        let arrLl = llType(hintTy)
        let v = genExpr(&mut cg, value, locs, sigs, elemTy.clone())
        let alloc = nextTemp(&mut cg)
        emit(&mut cg, "  " + alloc + " = alloca " + arrLl + "\n")
        var i: i64 = 0
        while i < count {
            let slot = nextTemp(&mut cg)
            emit(&mut cg, "  " + slot + " = getelementptr " + arrLl + ", ptr " + alloc + ", i32 0, i32 " + i.toString() + "\n")
            emit(&mut cg, "  store " + elemLl + " " + v.v + ", ptr " + slot + "\n")
            i = i + 1
        }
        let loaded = nextTemp(&mut cg)
        emit(&mut cg, "  " + loaded + " = load " + arrLl + ", ptr " + alloc + "\n")
        return Val {
            v: loaded, ty: hintTy.clone()
        }
    }
    ensureVecTy(&mut cg)
    ensureMalloc(&mut cg)
    // Never observed: the two branches below (hint, else the repeated value's own type)
    // are exhaustive, and Milo requires the var be initialised. Left as i64 rather than
    // restructured, but it is not a default anyone falls through to.
    var elemTy = "i64"
    var h = ""
    if isVecTy(hintTy) {
        elemTy = unwrapVec(hintTy)
        h = elemTy.clone()
    }
    let v = genExpr(&mut cg, value, locs, sigs, h)
    if !isVecTy(hintTy) {
        elemTy = v.ty.clone()
    }
    let elemLl = llType(elemTy)
    let esz = genSizeOf(&mut cg, elemLl)
    let bytes = nextTemp(&mut cg)
    emit(&mut cg, "  " + bytes + " = mul i64 " + count.toString() + ", " + esz + "\n")
    let data = nextTemp(&mut cg)
    emit(&mut cg, "  " + data + " = call ptr @malloc(i64 " + bytes + ")\n")
    let iAddr = nextTemp(&mut cg)
    emit(&mut cg, "  " + iAddr + " = alloca i64\n")
    emit(&mut cg, "  store i64 0, ptr " + iAddr + "\n")
    let condLbl = nextLabel(&mut cg, "arr.fill.cond")
    let bodyLbl = nextLabel(&mut cg, "arr.fill.body")
    let endLbl = nextLabel(&mut cg, "arr.fill.end")
    emit(&mut cg, "  br label %" + condLbl + "\n")
    emit(&mut cg, condLbl + ":\n")
    let cur = nextTemp(&mut cg)
    emit(&mut cg, "  " + cur + " = load i64, ptr " + iAddr + "\n")
    let lt = nextTemp(&mut cg)
    emit(&mut cg, "  " + lt + " = icmp slt i64 " + cur + ", " + count.toString() + "\n")
    emit(&mut cg, "  br i1 " + lt + ", label %" + bodyLbl + ", label %" + endLbl + "\n")
    emit(&mut cg, bodyLbl + ":\n")
    let slot = nextTemp(&mut cg)
    emit(&mut cg, "  " + slot + " = getelementptr " + elemLl + ", ptr " + data + ", i64 " + cur + "\n")
    emit(&mut cg, "  store " + elemLl + " " + v.v + ", ptr " + slot + "\n")
    let inc = nextTemp(&mut cg)
    emit(&mut cg, "  " + inc + " = add i64 " + cur + ", 1\n")
    emit(&mut cg, "  store i64 " + inc + ", ptr " + iAddr + "\n")
    emit(&mut cg, "  br label %" + condLbl + "\n")
    emit(&mut cg, endLbl + ":\n")
    let a = nextTemp(&mut cg)
    emit(&mut cg, "  " + a + " = insertvalue %Vec undef, ptr " + data + ", 0\n")
    let b = nextTemp(&mut cg)
    emit(&mut cg, "  " + b + " = insertvalue %Vec " + a + ", i64 " + count.toString() + ", 1\n")
    let c = nextTemp(&mut cg)
    emit(&mut cg, "  " + c + " = insertvalue %Vec " + b + ", i64 " + count.toString() + ", 2\n")
    return Val {
        v: c, ty: "Vec<" + elemTy + ">"
    }
}

// -- ! unwrap and ?? default (M3c) --

// `expr!` on Option_T / Result_T_E: tag 0 (Some/Ok) yields the payload;
// otherwise print the oracle's message shape and exit(1).
pub fn genUnwrap(cg: &mut Cgen, inner: &ExprNode, span: &Option<Span>, locs: &Vec<Local>, sigs: &Vec<CgFnSig>): Val {
    let v = genExpr(&mut cg, inner, locs, sigs, "")
    let enumName = resolveEnumName(cg, resolveTyStr(cg, stripPercent(v.ty)))
    let enumTy = "%" + enumName
    var okVariant = "Some"
    var failWord = "None"
    if variantTagOpt(cg, enumName, "Some").isNone() {
        okVariant = "Ok"
        failWord = "Err"
    }
    let payloadTypes = lookupVariantPayload(cg, enumName, okVariant)
    if payloadTypes.len != 1 {
        eprint("codegen: '!' on non-unwrappable type " + v.ty.clone())
        exit(1)
    }
    let payTy = payloadTypes[0].clone()
    let payLl = llType(payTy)

    var line: i32 = 0
    var col: i32 = 0
    match span {
        Option.Some(s) => {
            line = s.line
            col = s.col
        }
        Option.None => {
        }
    }

    let addr = nextTemp(&mut cg)
    emit(&mut cg, "  " + addr + " = alloca " + enumTy + "\n")
    emit(&mut cg, "  store " + enumTy + " " + v.v + ", ptr " + addr + "\n")
    let tagPtr = nextTemp(&mut cg)
    emit(&mut cg, "  " + tagPtr + " = getelementptr " + enumTy + ", ptr " + addr + ", i32 0, i32 0\n")
    let tag = nextTemp(&mut cg)
    emit(&mut cg, "  " + tag + " = load i32, ptr " + tagPtr + "\n")
    let okTag = lookupVariantTag(cg, enumName, okVariant)
    let isOk = nextTemp(&mut cg)
    emit(&mut cg, "  " + isOk + " = icmp eq i32 " + tag + ", " + okTag.toString() + "\n")
    let okLbl = nextLabel(&mut cg, "unwrap.ok")
    let failLbl = nextLabel(&mut cg, "unwrap.fail")
    emit(&mut cg, "  br i1 " + isOk + ", label %" + okLbl + ", label %" + failLbl + "\n")

    emit(&mut cg, failLbl + ":\n")
    if !cg.declaredPrintf {
        emitG(&mut cg, "declare i32 @printf(ptr, ...)\n")
        cg.declaredPrintf = true
    }
    ensureExit(&mut cg)
    // Err(string) prints the error's message, matching the TS panic shape
    var printedErrString = false
    if failWord == "Err" {
        let errPayload = lookupVariantPayload(cg, enumName, "Err")
        if errPayload.len == 1 && llType(errPayload[0]) == "%String" {
            let fmtLbl = emitStringLit(&mut cg, "error at " + line.toString() + ":" + col.toString() + ": %s\n")
            let payPtrE = nextTemp(&mut cg)
            emit(&mut cg, "  " + payPtrE + " = getelementptr " + enumTy + ", ptr " + addr + ", i32 0, i32 1\n")
            let errStr = nextTemp(&mut cg)
            emit(&mut cg, "  " + errStr + " = load %String, ptr " + payPtrE + "\n")
            let errData = nextTemp(&mut cg)
            emit(&mut cg, "  " + errData + " = extractvalue %String " + errStr + ", 0\n")
            let pcall = nextTemp(&mut cg)
            emit(&mut cg, "  " + pcall + " = call i32 (ptr, ...) @printf(ptr " + fmtLbl + ", ptr " + errData + ")\n")
            printedErrString = true
        }
    }
    if !printedErrString {
        let msgLbl = emitStringLit(&mut cg, "error at " + line.toString() + ":" + col.toString() + ": unwrap called on " + failWord + "\n")
        let pcall2 = nextTemp(&mut cg)
        emit(&mut cg, "  " + pcall2 + " = call i32 (ptr, ...) @printf(ptr " + msgLbl + ")\n")
    }
    emit(&mut cg, "  call void @exit(i32 1)\n")
    emit(&mut cg, "  unreachable\n")

    emit(&mut cg, okLbl + ":\n")
    let payPtr = nextTemp(&mut cg)
    emit(&mut cg, "  " + payPtr + " = getelementptr " + enumTy + ", ptr " + addr + ", i32 0, i32 1\n")
    let pstructTy = "{ " + payLl + " }"
    let fp = nextTemp(&mut cg)
    emit(&mut cg, "  " + fp + " = getelementptr " + pstructTy + ", ptr " + payPtr + ", i32 0, i32 0\n")
    let result = nextTemp(&mut cg)
    emit(&mut cg, "  " + result + " = load " + payLl + ", ptr " + fp + "\n")
    return Val {
        v: result, ty: payTy
    }
}

// `expr?` (M3d): Ok/Some yields the payload; Err/None returns early with the
// enclosing fn's result type. Same-enum propagation returns the value as-is;
// differing Result enums copy the Err payload when the slot types match
// (auto-From conversions are not ported yet — fail loud instead of silently).
pub fn genPropagate(cg: &mut Cgen, inner: &ExprNode, locs: &Vec<Local>, sigs: &Vec<CgFnSig>): Val {
    let v = genExpr(&mut cg, inner, locs, sigs, "")
    let srcEnum = resolveEnumName(cg, resolveTyStr(cg, stripPercent(v.ty)))
    let srcTy = "%" + srcEnum
    var okVariant = "Some"
    var failVariant = "None"
    if variantTagOpt(cg, srcEnum, "Some").isNone() {
        okVariant = "Ok"
        failVariant = "Err"
    }
    let payloadTypes = lookupVariantPayload(cg, srcEnum, okVariant)
    if payloadTypes.len != 1 {
        eprint("codegen: '?' on non-propagatable type " + v.ty.clone())
        exit(1)
    }
    let payTy = payloadTypes[0].clone()
    let payLl = llType(payTy)
    let retEnum = resolveEnumName(cg, stripPercent(cg.curRetTy))
    let retTy = "%" + retEnum

    let addr = nextTemp(&mut cg)
    emit(&mut cg, "  " + addr + " = alloca " + srcTy + "\n")
    emit(&mut cg, "  store " + srcTy + " " + v.v + ", ptr " + addr + "\n")
    let tagPtr = nextTemp(&mut cg)
    emit(&mut cg, "  " + tagPtr + " = getelementptr " + srcTy + ", ptr " + addr + ", i32 0, i32 0\n")
    let tag = nextTemp(&mut cg)
    emit(&mut cg, "  " + tag + " = load i32, ptr " + tagPtr + "\n")
    let okTag = lookupVariantTag(cg, srcEnum, okVariant)
    let isOk = nextTemp(&mut cg)
    emit(&mut cg, "  " + isOk + " = icmp eq i32 " + tag + ", " + okTag.toString() + "\n")
    let okLbl = nextLabel(&mut cg, "prop.ok")
    let errLbl = nextLabel(&mut cg, "prop.err")
    emit(&mut cg, "  br i1 " + isOk + ", label %" + okLbl + ", label %" + errLbl + "\n")

    // emitLabel, not a raw emit: cg.curBlock must track that control is now in errLbl.
    emitLabel(&mut cg, errLbl)
    if srcEnum == retEnum {
        let whole = nextTemp(&mut cg)
        emit(&mut cg, "  " + whole + " = load " + srcTy + ", ptr " + addr + "\n")
        emit(&mut cg, "  ret " + srcTy + " " + whole + "\n")
    } else {
        let retFail = lookupVariantTag(cg, retEnum, failVariant)
        if variantTagOpt(cg, retEnum, failVariant).isNone() {
            eprint("codegen: '?' cannot propagate " + srcEnum.clone() + " into fn returning " + retEnum.clone())
            exit(1)
        }
        let retAddr = nextTemp(&mut cg)
        emit(&mut cg, "  " + retAddr + " = alloca " + retTy + "\n")
        let rTagPtr = nextTemp(&mut cg)
        emit(&mut cg, "  " + rTagPtr + " = getelementptr " + retTy + ", ptr " + retAddr + ", i32 0, i32 0\n")
        emit(&mut cg, "  store i32 " + retFail.toString() + ", ptr " + rTagPtr + "\n")
        if failVariant == "Err" {
            let srcErrTypes = lookupVariantPayload(cg, srcEnum, "Err")
            let retErrTypes = lookupVariantPayload(cg, retEnum, "Err")
            if srcErrTypes.len == 1 && retErrTypes.len == 1 && llType(srcErrTypes[0]) == llType(retErrTypes[0]) {
                let errLl = llType(srcErrTypes[0])
                let sPay = nextTemp(&mut cg)
                emit(&mut cg, "  " + sPay + " = getelementptr " + srcTy + ", ptr " + addr + ", i32 0, i32 1\n")
                let sfp = nextTemp(&mut cg)
                emit(&mut cg, "  " + sfp + " = getelementptr { " + errLl + " }, ptr " + sPay + ", i32 0, i32 0\n")
                let ev = nextTemp(&mut cg)
                emit(&mut cg, "  " + ev + " = load " + errLl + ", ptr " + sfp + "\n")
                let rPay = nextTemp(&mut cg)
                emit(&mut cg, "  " + rPay + " = getelementptr " + retTy + ", ptr " + retAddr + ", i32 0, i32 1\n")
                let rfp = nextTemp(&mut cg)
                emit(&mut cg, "  " + rfp + " = getelementptr { " + errLl + " }, ptr " + rPay + ", i32 0, i32 0\n")
                emit(&mut cg, "  store " + errLl + " " + ev + ", ptr " + rfp + "\n")
            } else if srcErrTypes.len == 1 && retErrTypes.len == 1 {
                // auto-From: the ret Err type is an enum with a variant that wraps the
                // src Err type (AppError.Io(IoError)). Build that variant around the
                // src error value, then store it as the ret Result's Err payload.
                let srcErrTy = srcErrTypes[0].clone()
                let retErrTy = retErrTypes[0].clone()
                let retErrName = resolveEnumName(cg, stripPercent(retErrTy))
                let srcErrKey = stripPercent(resolveTyStr(cg, srcErrTy))
                var wrapVar = ""
                var wrapTag: i32 = 0
                if cg.enums.contains(retErrName) {
                    let ei = cg.enums.get(retErrName)!
                    for vi in 0..ei.variants.len {
                        let pt = ei.variants[vi].payloadTypes
                        if pt.len == 1 && stripPercent(resolveTyStr(cg, pt[0])) == srcErrKey {
                            wrapVar = ei.variants[vi].name.clone()
                            wrapTag = ei.variants[vi].tag
                        }
                    }
                }
                if wrapVar.len == 0 {
                    eprint("codegen: '?' error conversion (auto-From) not supported: " + srcEnum.clone() + " -> " + retEnum.clone())
                    exit(1)
                }
                let srcErrLl = llType(srcErrTy)
                let retErrLl = llType(retErrTy)
                // load the src Err value (e.g. the IoError)
                let sPay = nextTemp(&mut cg)
                emit(&mut cg, "  " + sPay + " = getelementptr " + srcTy + ", ptr " + addr + ", i32 0, i32 1\n")
                let sfp = nextTemp(&mut cg)
                emit(&mut cg, "  " + sfp + " = getelementptr { " + srcErrLl + " }, ptr " + sPay + ", i32 0, i32 0\n")
                let ev = nextTemp(&mut cg)
                emit(&mut cg, "  " + ev + " = load " + srcErrLl + ", ptr " + sfp + "\n")
                // build the wrapping variant value (AppError.Io(ev))
                let weAddr = nextTemp(&mut cg)
                emit(&mut cg, "  " + weAddr + " = alloca " + retErrLl + "\n")
                let wtagPtr = nextTemp(&mut cg)
                emit(&mut cg, "  " + wtagPtr + " = getelementptr " + retErrLl + ", ptr " + weAddr + ", i32 0, i32 0\n")
                emit(&mut cg, "  store i32 " + wrapTag.toString() + ", ptr " + wtagPtr + "\n")
                let wpayPtr = nextTemp(&mut cg)
                emit(&mut cg, "  " + wpayPtr + " = getelementptr " + retErrLl + ", ptr " + weAddr + ", i32 0, i32 1\n")
                let wfp = nextTemp(&mut cg)
                emit(&mut cg, "  " + wfp + " = getelementptr { " + srcErrLl + " }, ptr " + wpayPtr + ", i32 0, i32 0\n")
                emit(&mut cg, "  store " + srcErrLl + " " + ev + ", ptr " + wfp + "\n")
                let weVal = nextTemp(&mut cg)
                emit(&mut cg, "  " + weVal + " = load " + retErrLl + ", ptr " + weAddr + "\n")
                // store the wrapped error as the ret Result's Err payload
                let rPay = nextTemp(&mut cg)
                emit(&mut cg, "  " + rPay + " = getelementptr " + retTy + ", ptr " + retAddr + ", i32 0, i32 1\n")
                let rfp = nextTemp(&mut cg)
                emit(&mut cg, "  " + rfp + " = getelementptr { " + retErrLl + " }, ptr " + rPay + ", i32 0, i32 0\n")
                emit(&mut cg, "  store " + retErrLl + " " + weVal + ", ptr " + rfp + "\n")
            } else {
                eprint("codegen: '?' error conversion (auto-From) not supported: " + srcEnum.clone() + " -> " + retEnum.clone())
                exit(1)
            }
        }
        let rWhole = nextTemp(&mut cg)
        emit(&mut cg, "  " + rWhole + " = load " + retTy + ", ptr " + retAddr + "\n")
        emit(&mut cg, "  ret " + retTy + " " + rWhole + "\n")
    }

    // emitLabel, not a raw emit. genPropagate's CALLER may still believe control is in
    // the block that branched into the propagate sequence; a PHI built by an enclosing
    // if-expression then names that stale block as its predecessor, and LLVM rejects the
    // module with "PHI node entries do not match predecessors".
    emitLabel(&mut cg, okLbl)
    let payPtr = nextTemp(&mut cg)
    emit(&mut cg, "  " + payPtr + " = getelementptr " + srcTy + ", ptr " + addr + ", i32 0, i32 1\n")
    let fp = nextTemp(&mut cg)
    emit(&mut cg, "  " + fp + " = getelementptr { " + payLl + " }, ptr " + payPtr + ", i32 0, i32 0\n")
    let result = nextTemp(&mut cg)
    emit(&mut cg, "  " + result + " = load " + payLl + ", ptr " + fp + "\n")
    return Val {
        v: result, ty: payTy
    }
}

// `expr ?? default`: Some/Ok payload, else the default.
// `??` moves the ok-payload out of its operand, or moves the default in. Zero the
// slot the value came from so that slot's scope-end drop can't free a buffer the
// result now owns. Emitted inside the branch that actually took the value, not
// before the branch: on the default path the operand's other variant (a Result's
// Err) still owns its payload and its drop must still fire, and on the ok path the
// default was never evaluated so its variable is untouched.
fn zeroMovedSource(cg: &mut Cgen, e: &ExprNode, payTy: &string, locs: &Vec<Local>) {
    if !cgNeedsDrop(cg, payTy) {
        return
    }
    match e.kind {
        Expr.Ident(name) => {
            if !hasLocal(locs, name) {
                return
            }
            let loc = findLocal(locs, name)
            // A ref param's pointee belongs to the caller — never zero through it.
            if loc.isRef {
                return
            }
            zeroStore(&mut cg, loc.addr, loc.ty)
        }
        _ => {
        }
    }
}

pub fn genDefaultValue(cg: &mut Cgen, inner: &ExprNode, defaultE: &ExprNode, locs: &Vec<Local>, sigs: &Vec<CgFnSig>): Val {
    let v = genExpr(&mut cg, inner, locs, sigs, "")
    let enumName = resolveEnumName(cg, resolveTyStr(cg, stripPercent(v.ty)))
    let enumTy = "%" + enumName
    var okVariant = "Some"
    if variantTagOpt(cg, enumName, "Some").isNone() {
        okVariant = "Ok"
    }
    let payloadTypes = lookupVariantPayload(cg, enumName, okVariant)
    if payloadTypes.len != 1 {
        eprint("codegen: '??' on non-unwrappable type " + v.ty.clone())
        exit(1)
    }
    let payTy = payloadTypes[0].clone()
    let payLl = llType(payTy)
    let addr = nextTemp(&mut cg)
    emit(&mut cg, "  " + addr + " = alloca " + enumTy + "\n")
    emit(&mut cg, "  store " + enumTy + " " + v.v + ", ptr " + addr + "\n")
    let resAddr = nextTemp(&mut cg)
    emit(&mut cg, "  " + resAddr + " = alloca " + payLl + "\n")
    let tagPtr = nextTemp(&mut cg)
    emit(&mut cg, "  " + tagPtr + " = getelementptr " + enumTy + ", ptr " + addr + ", i32 0, i32 0\n")
    let tag = nextTemp(&mut cg)
    emit(&mut cg, "  " + tag + " = load i32, ptr " + tagPtr + "\n")
    let okTag = lookupVariantTag(cg, enumName, okVariant)
    let isOk = nextTemp(&mut cg)
    emit(&mut cg, "  " + isOk + " = icmp eq i32 " + tag + ", " + okTag.toString() + "\n")
    let okLbl = nextLabel(&mut cg, "dflt.some")
    let noneLbl = nextLabel(&mut cg, "dflt.none")
    let endLbl = nextLabel(&mut cg, "dflt.end")
    emit(&mut cg, "  br i1 " + isOk + ", label %" + okLbl + ", label %" + noneLbl + "\n")
    emit(&mut cg, okLbl + ":\n")
    let payPtr = nextTemp(&mut cg)
    emit(&mut cg, "  " + payPtr + " = getelementptr " + enumTy + ", ptr " + addr + ", i32 0, i32 1\n")
    let pstructTy = "{ " + payLl + " }"
    let fp = nextTemp(&mut cg)
    emit(&mut cg, "  " + fp + " = getelementptr " + pstructTy + ", ptr " + payPtr + ", i32 0, i32 0\n")
    let pv = nextTemp(&mut cg)
    emit(&mut cg, "  " + pv + " = load " + payLl + ", ptr " + fp + "\n")
    emit(&mut cg, "  store " + payLl + " " + pv + ", ptr " + resAddr + "\n")
    zeroMovedSource(&mut cg, inner, payTy, locs)
    emit(&mut cg, "  br label %" + endLbl + "\n")
    // The default is evaluated HERE, not before the branch: it may have side
    // effects, and evaluating it eagerly also moved its source on the ok path
    // where it is never used.
    emit(&mut cg, noneLbl + ":\n")
    let dv = genExpr(&mut cg, defaultE, locs, sigs, payTy.clone())
    emit(&mut cg, "  store " + payLl + " " + dv.v + ", ptr " + resAddr + "\n")
    zeroMovedSource(&mut cg, defaultE, payTy, locs)
    emit(&mut cg, "  br label %" + endLbl + "\n")
    emit(&mut cg, endLbl + ":\n")
    let r = nextTemp(&mut cg)
    emit(&mut cg, "  " + r + " = load " + payLl + ", ptr " + resAddr + "\n")
    return Val {
        v: r, ty: payTy
    }
}

// `subject is Enum.Variant` → i1 tag equality (no bindings; a boolean test).
pub fn genIsExpr(cg: &mut Cgen, subject: &ExprNode, pattern: &Pattern, locs: &Vec<Local>, sigs: &Vec<CgFnSig>): Val {
    let sv = genExpr(&mut cg, subject, locs, sigs, "")
    let svLl = llType(sv.ty)
    let rawName = stripPercent(sv.ty)
    let tag = nextTemp(&mut cg)
    emit(&mut cg, "  " + tag + " = extractvalue " + svLl + " " + sv.v + ", 0\n")
    match pattern {
        Pattern.EnumPattern(enumName, variant, bindings, span) => {
            let vtag = lookupVariantTag(cg, rawName, variant)
            let res = nextTemp(&mut cg)
            emit(&mut cg, "  " + res + " = icmp eq i32 " + tag + ", " + vtag.toString() + "\n")
            return Val {
                v: res, ty: "bool"
            }
        }
        _ => {
            return Val {
                v: "0", ty: "bool"
            }
        }
    }
}

// Wrap an already-computed value in `Some` for an `Option<T>` param (auto-wrap at
// a call site). rEnum is the mangled option name (e.g. "Option_u16").
// A named fn used as a closure value needs an adapter: the closure ABI calls
// `fn(ptr env, ptr args…)` but the named fn has no env param and takes its args
// directly. Emit (once) a thunk `@__fnthunk_<name>(ptr env, ptr a0, …)` that drops
// env, adapts each arg (ref → pass ptr; value → load), and calls the real fn.
pub fn ensureFnThunk(cg: &mut Cgen, name: &string, sigs: &Vec<CgFnSig>): string {
    let thunkName = "__fnthunk_" + name.clone()
    for i in 0..cg.emittedThunks.len {
        if cg.emittedThunks[i] == thunkName {
            return thunkName
        }
    }
    cg.emittedThunks.push(thunkName.clone())

    var pTys: Vec<string> = Vec.new()
    var pRefs: Vec<bool> = Vec.new()
    var retTy = "void"
    for si in 0..sigs.len {
        if sigs[si].name == name {
            for pi in 0..sigs[si].paramTys.len {
                pTys.push(sigs[si].paramTys[pi].clone())
            }
            for pi in 0..sigs[si].paramRefs.len {
                pRefs.push(sigs[si].paramRefs[pi])
            }
            retTy = sigs[si].retTy.clone()
        }
    }
    let retLl = llType(resolveTyStr(cg, retTy))

    var hdr = "define " + retLl + " @" + thunkName + "(ptr %__env"
    for pi in 0..pTys.len {
        hdr = hdr + ", ptr %a" + pi.toString()
    }
    hdr = hdr + ") {\nentry:\n"

    var body = ""
    var callArgs = ""
    var tctr = 0
    for pi in 0..pTys.len {
        if pi > 0 {
            callArgs = callArgs + ", "
        }
        var isRef = false
        if pi < pRefs.len {
            isRef = pRefs[pi]
        }
        if isRef {
            callArgs = callArgs + "ptr %a" + pi.toString()
        } else {
            let pll = llType(resolveTyStr(cg, pTys[pi]))
            let t = "%tk" + tctr.toString()
            tctr = tctr + 1
            body = body + "  " + t + " = load " + pll + ", ptr %a" + pi.toString() + "\n"
            callArgs = callArgs + pll + " " + t
        }
    }
    if retLl == "void" {
        body = body + "  call void @" + name.clone() + "(" + callArgs + ")\n  ret void\n"
    } else {
        body = body + "  %tkr = call " + retLl + " @" + name.clone() + "(" + callArgs + ")\n  ret " + retLl + " %tkr\n"
    }
    cg.globals = cg.globals + hdr + body + "}\n\n"
    return thunkName
}

// If hintTy is an Option<T> enum and `v` is a bare payload value (not already the
// Option), wrap it in Some — used for `let x: T? = <val>` and `x = <val>`. genWrapSome
// int-coerces the payload, so a `42:i32` wraps cleanly into an Option<u16>.
pub fn genOptionWrapIfNeeded(cg: &mut Cgen, v: &Val, hintTy: &string): Val {
    let asis = Val {
        v: v.v.clone(), ty: v.ty.clone()
    }
    if hintTy.len == 0 {
        return asis
    }
    let rp = stripPercent(resolveTyStr(cg, stripPercent(hintTy)))
    if !cg.enums.contains(rp) {
        return asis
    }
    if llType(v.ty) == "%" + rp.clone() {
        return asis
    }
    // Existence first, then the tag — the two questions are separate (a discriminant can
    // legitimately BE -1, which is why lookupVariantTag's sentinel must never be used as a
    // presence test).
    if variantTagOpt(cg, rp, "Some").isNone() {
        return asis
    }
    let pl = lookupVariantPayload(cg, rp, "Some")
    if pl.len != 1 {
        return asis
    }
    let plLl = llType(pl[0])
    let vLl = llType(v.ty)
    if plLl == vLl || (intBits(plLl) > 0 && intBits(vLl) > 0) {
        return genWrapSome(&mut cg, v, rp)
    }
    return asis
}

// Coerce a Heap<Concrete> value (a heap ptr) into an interface fat pointer
// %Iface{data, itable} when hintTy resolves to an interface. No-op otherwise.
pub fn genInterfaceCoerceIfNeeded(cg: &mut Cgen, v: &Val, hintTy: &string): Val {
    let asis = Val {
        v: v.v.clone(), ty: v.ty.clone()
    }
    if hintTy.len == 0 {
        return asis
    }
    let ib = stripPercent(resolveTyStr(cg, stripPercent(hintTy)))
    if !cg.interfaces.contains(ib) {
        return asis
    }
    if stripPercent(resolveTyStr(cg, stripPercent(v.ty))) == ib {
        return asis
    }
    // data pointer + concrete type from the source value
    var dataPtr = v.v.clone()
    var concrete = ""
    if unwrapHeap(v.ty).len > 0 {
        concrete = stripPercent(resolveTyStr(cg, unwrapHeap(v.ty)))
    } else {
        concrete = stripPercent(resolveTyStr(cg, stripPercent(v.ty)))
    }
    if concrete.len == 0 {
        return asis
    }
    let itab = ensureItable(&mut cg, concrete, ib)
    let ifTy = "%" + ib.clone()
    let w0 = nextTemp(&mut cg)
    emit(&mut cg, "  " + w0 + " = insertvalue " + ifTy + " undef, ptr " + dataPtr + ", 0\n")
    let w1 = nextTemp(&mut cg)
    emit(&mut cg, "  " + w1 + " = insertvalue " + ifTy + " " + w0 + ", ptr " + itab + ", 1\n")
    return Val {
        v: w1, ty: ib
    }
}

pub fn genWrapSome(cg: &mut Cgen, innerVal: &Val, rEnum: &string): Val {
    let tag = lookupVariantTag(cg, rEnum, "Some")
    let structTy = "%" + rEnum.clone()
    let alloc = nextTemp(&mut cg)
    emit(&mut cg, "  " + alloc + " = alloca " + structTy + "\n")
    let tagPtr = nextTemp(&mut cg)
    emit(&mut cg, "  " + tagPtr + " = getelementptr " + structTy + ", ptr " + alloc + ", i32 0, i32 0\n")
    emit(&mut cg, "  store i32 " + tag.toString() + ", ptr " + tagPtr + "\n")
    let payloadTypes = lookupVariantPayload(cg, rEnum, "Some")
    if payloadTypes.len > 0 {
        let payPtr = nextTemp(&mut cg)
        emit(&mut cg, "  " + payPtr + " = getelementptr " + structTy + ", ptr " + alloc + ", i32 0, i32 1\n")
        let vstructTy = variantStructTy(payloadTypes)
        let ftyLl = llType(payloadTypes[0])
        let fp = nextTemp(&mut cg)
        emit(&mut cg, "  " + fp + " = getelementptr " + vstructTy + ", ptr " + payPtr + ", i32 0, i32 0\n")
        var storeVal = innerVal.v.clone()
        let fvLl = llType(innerVal.ty)
        if fvLl != ftyLl && intBits(fvLl) > 0 && intBits(ftyLl) > 0 {
            let w = nextTemp(&mut cg)
            if intBits(fvLl) > intBits(ftyLl) {
                emit(&mut cg, "  " + w + " = trunc " + fvLl + " " + innerVal.v + " to " + ftyLl + "\n")
            } else {
                var ext = "sext"
                if isUnsigned(innerVal.ty) {
                    ext = "zext"
                }
                emit(&mut cg, "  " + w + " = " + ext + " " + fvLl + " " + innerVal.v + " to " + ftyLl + "\n")
            }
            storeVal = w
        }
        emit(&mut cg, "  store " + ftyLl + " " + storeVal + ", ptr " + fp + "\n")
    }
    let loaded = nextTemp(&mut cg)
    emit(&mut cg, "  " + loaded + " = load " + structTy + ", ptr " + alloc + "\n")
    return Val {
        v: loaded, ty: rEnum.clone()
    }
}

// -- Option/Result combinators (map/andThen/orElse/mapErr/unwrapOrElse) --
//
// isSome/isNone/isOk/isErr/unwrapOr live in genMethodCall directly (existing
// code); these are the combinators that take a closure. All build/read the
// receiver's {tag, payload} layout the same way `!`/`?`/`??` do: alloca a scratch
// copy of the loaded enum value, then GEP into it — never `extractvalue` on the
// payload field directly, since its slot is a raw byte union sized for the
// largest variant.

// Build an arbitrary single-payload variant value (generalizes genWrapSome,
// which is hardcoded to "Some") — used to wrap a callback result into Some/Ok,
// or to forward an already-loaded payload into a differently-monomorphized Err/Ok.
pub fn genBuildVariant1(cg: &mut Cgen, innerVal: &Val, rEnum: &string, variant: &string): Val {
    let tag = lookupVariantTag(cg, rEnum, variant)
    let structTy = "%" + rEnum.clone()
    let alloc = nextTemp(&mut cg)
    emit(&mut cg, "  " + alloc + " = alloca " + structTy + "\n")
    let tagPtr = nextTemp(&mut cg)
    emit(&mut cg, "  " + tagPtr + " = getelementptr " + structTy + ", ptr " + alloc + ", i32 0, i32 0\n")
    emit(&mut cg, "  store i32 " + tag.toString() + ", ptr " + tagPtr + "\n")
    let payloadTypes = lookupVariantPayload(cg, rEnum, variant)
    if payloadTypes.len > 0 {
        let payPtr = nextTemp(&mut cg)
        emit(&mut cg, "  " + payPtr + " = getelementptr " + structTy + ", ptr " + alloc + ", i32 0, i32 1\n")
        let vstructTy = variantStructTy(payloadTypes)
        let ftyLl = llType(payloadTypes[0])
        let fp = nextTemp(&mut cg)
        emit(&mut cg, "  " + fp + " = getelementptr " + vstructTy + ", ptr " + payPtr + ", i32 0, i32 0\n")
        var storeVal = innerVal.v.clone()
        let fvLl = llType(innerVal.ty)
        if fvLl != ftyLl && intBits(fvLl) > 0 && intBits(ftyLl) > 0 {
            let w = nextTemp(&mut cg)
            if intBits(fvLl) > intBits(ftyLl) {
                emit(&mut cg, "  " + w + " = trunc " + fvLl + " " + innerVal.v + " to " + ftyLl + "\n")
            } else {
                var ext = "sext"
                if isUnsigned(innerVal.ty) {
                    ext = "zext"
                }
                emit(&mut cg, "  " + w + " = " + ext + " " + fvLl + " " + innerVal.v + " to " + ftyLl + "\n")
            }
            storeVal = w
        }
        emit(&mut cg, "  store " + ftyLl + " " + storeVal + ", ptr " + fp + "\n")
    }
    let loaded = nextTemp(&mut cg)
    emit(&mut cg, "  " + loaded + " = load " + structTy + ", ptr " + alloc + "\n")
    return Val {
        v: loaded, ty: rEnum.clone()
    }
}

// Build a payload-less variant value (None) of a possibly different monomorphized
// enum than the receiver's — used when map/andThen short-circuit on None.
pub fn genBuildVariant0(cg: &mut Cgen, rEnum: &string, variant: &string): Val {
    let tag = lookupVariantTag(cg, rEnum, variant)
    let structTy = "%" + rEnum.clone()
    let alloc = nextTemp(&mut cg)
    emit(&mut cg, "  " + alloc + " = alloca " + structTy + "\n")
    let tagPtr = nextTemp(&mut cg)
    emit(&mut cg, "  " + tagPtr + " = getelementptr " + structTy + ", ptr " + alloc + ", i32 0, i32 0\n")
    emit(&mut cg, "  store i32 " + tag.toString() + ", ptr " + tagPtr + "\n")
    let loaded = nextTemp(&mut cg)
    emit(&mut cg, "  " + loaded + " = load " + structTy + ", ptr " + alloc + "\n")
    return Val {
        v: loaded, ty: rEnum.clone()
    }
}

// The tag word of an already-loaded enum value (field 0, always a plain i32 — no
// alloca needed, unlike the payload).
pub fn genEnumTag(cg: &mut Cgen, ov: &Val, enumName: &string): string {
    let tag = nextTemp(&mut cg)
    emit(&mut cg, "  " + tag + " = extractvalue %" + enumName.clone() + " " + ov.v.clone() + ", 0\n")
    return tag
}

// A pointer to the receiver's payload field for the given variant — scratch-copies
// `ov` into a fresh alloca first (same dance as `!`), then GEPs field 1 and the
// variant's own sub-struct. This is what a by-ref combinator closure receives
// directly as its argument pointer (map/andThen/mapErr/orElse never load the
// payload themselves — only unwrapOr/unwrapOrElse do, since only those consume it).
pub fn genPayloadPtr(cg: &mut Cgen, ov: &Val, enumName: &string, variant: &string): string {
    let structTy = "%" + enumName.clone()
    let addr = nextTemp(&mut cg)
    emit(&mut cg, "  " + addr + " = alloca " + structTy + "\n")
    emit(&mut cg, "  store " + structTy + " " + ov.v.clone() + ", ptr " + addr + "\n")
    let payloadTypes = lookupVariantPayload(cg, enumName, variant)
    let payPtr = nextTemp(&mut cg)
    emit(&mut cg, "  " + payPtr + " = getelementptr " + structTy + ", ptr " + addr + ", i32 0, i32 1\n")
    let vstructTy = variantStructTy(payloadTypes)
    let fp = nextTemp(&mut cg)
    emit(&mut cg, "  " + fp + " = getelementptr " + vstructTy + ", ptr " + payPtr + ", i32 0, i32 0\n")
    return fp
}

// unwrapOrElse(f) — unwrapOr with the default computed (and the closure called)
// only on the fail branch. Option's f takes no args; Result's f takes the error
// by ref, so it's appended to the call only when failVariant is "Err".
pub fn genOptionResultUnwrapOrElse(cg: &mut Cgen, ov: &Val, enumName: &string, cbExpr: &ExprNode, locs: &Vec<Local>, sigs: &Vec<CgFnSig>): Val {
    var okVariant = "Some"
    var failVariant = "None"
    if variantTagOpt(cg, enumName, "Ok").isSome() {
        okVariant = "Ok"
        failVariant = "Err"
    }
    let payloadTypes = lookupVariantPayload(cg, enumName, okVariant)
    if payloadTypes.len != 1 {
        eprint("codegen: 'unwrapOrElse' on non-unwrappable type " + enumName.clone())
        exit(1)
    }
    let payTy = payloadTypes[0].clone()
    let payLl = llType(payTy)
    let resAddr = nextTemp(&mut cg)
    emit(&mut cg, "  " + resAddr + " = alloca " + payLl + "\n")
    let tag = genEnumTag(&mut cg, ov, enumName)
    let okTag = lookupVariantTag(cg, enumName, okVariant)
    let isOk = nextTemp(&mut cg)
    emit(&mut cg, "  " + isOk + " = icmp eq i32 " + tag + ", " + okTag.toString() + "\n")
    let okLbl = nextLabel(&mut cg, "uwoe.ok")
    let failLbl = nextLabel(&mut cg, "uwoe.fail")
    let endLbl = nextLabel(&mut cg, "uwoe.end")
    emit(&mut cg, "  br i1 " + isOk + ", label %" + okLbl + ", label %" + failLbl + "\n")

    emitLabel(&mut cg, okLbl)
    let fp = genPayloadPtr(&mut cg, ov, enumName, okVariant)
    let pv = nextTemp(&mut cg)
    emit(&mut cg, "  " + pv + " = load " + payLl + ", ptr " + fp + "\n")
    emit(&mut cg, "  store " + payLl + " " + pv + ", ptr " + resAddr + "\n")
    emit(&mut cg, "  br label %" + endLbl + "\n")

    emitLabel(&mut cg, failLbl)
    var uwoeHints: Vec<string> = Vec.new()
    if failVariant == "Err" {
        uwoeHints.push(lookupVariantPayload(cg, enumName, "Err") [0].clone())
    }
    cg.closureParamHint = uwoeHints
    let clv = genExpr(&mut cg, cbExpr, locs, sigs, "")
    cg.closureParamHint = Vec.new()
    let cfp = nextTemp(&mut cg)
    emit(&mut cg, "  " + cfp + " = extractvalue %Closure " + clv.v + ", 0\n")
    let cenv = nextTemp(&mut cg)
    emit(&mut cg, "  " + cenv + " = extractvalue %Closure " + clv.v + ", 1\n")
    var callArgs = "ptr " + cenv
    if failVariant == "Err" {
        let efp = genPayloadPtr(&mut cg, ov, enumName, "Err")
        callArgs = callArgs + ", ptr " + efp
    }
    let cr = nextTemp(&mut cg)
    emit(&mut cg, "  " + cr + " = call " + payLl + " " + cfp + "(" + callArgs + ")\n")
    emit(&mut cg, "  store " + payLl + " " + cr + ", ptr " + resAddr + "\n")
    emit(&mut cg, "  br label %" + endLbl + "\n")

    emitLabel(&mut cg, endLbl)
    let r = nextTemp(&mut cg)
    emit(&mut cg, "  " + r + " = load " + payLl + ", ptr " + resAddr + "\n")
    return Val {
        v: r, ty: payTy
    }
}

// map(f): T -> U through the payload BY REF (the closure never consumes it).
// Option<T> -> Option<U> forwards nothing on None; Result<T,E> -> Result<U,E>
// forwards the receiver's Err payload untouched on the fail branch.
pub fn genOptionResultMap(cg: &mut Cgen, ov: &Val, enumName: &string, isResult: bool, cbExpr: &ExprNode, locs: &Vec<Local>, sigs: &Vec<CgFnSig>): Val {
    var okVariant = "Some"
    if isResult {
        okVariant = "Ok"
    }
    var mapHints: Vec<string> = Vec.new()
    mapHints.push(lookupVariantPayload(cg, enumName, okVariant) [0].clone())
    cg.closureParamHint = mapHints
    let clv = genExpr(&mut cg, cbExpr, locs, sigs, "")
    cg.closureParamHint = Vec.new()
    // genEnumLit (unlike genWrapSome/genBuildVariant1) stores the "%"-prefixed
    // LLVM type in Val.ty, so a closure whose inferred return flows through an
    // enum-literal `return` (like `return Result.Ok(...)`) carries a stray '%'
    // here — strip it before treating this as a bare enum/type name below.
    let newInnerTy = stripPercent(closureRetOf(clv.ty))
    var newEnumTy = ""
    if isResult {
        let errTy = lookupVariantPayload(cg, enumName, "Err") [0].clone()
        newEnumTy = stripPercent(resolveTyStr(cg, "Result<" + newInnerTy.clone() + "," + errTy.clone() + ">"))
    } else {
        newEnumTy = stripPercent(resolveTyStr(cg, "Option<" + newInnerTy.clone() + ">"))
    }
    let newStructTy = "%" + newEnumTy.clone()
    let resAddr = nextTemp(&mut cg)
    emit(&mut cg, "  " + resAddr + " = alloca " + newStructTy + "\n")
    let tag = genEnumTag(&mut cg, ov, enumName)
    let okTag = lookupVariantTag(cg, enumName, okVariant)
    let isOk = nextTemp(&mut cg)
    emit(&mut cg, "  " + isOk + " = icmp eq i32 " + tag + ", " + okTag.toString() + "\n")
    let okLbl = nextLabel(&mut cg, "map.ok")
    let failLbl = nextLabel(&mut cg, "map.fail")
    let endLbl = nextLabel(&mut cg, "map.end")
    emit(&mut cg, "  br i1 " + isOk + ", label %" + okLbl + ", label %" + failLbl + "\n")

    emitLabel(&mut cg, okLbl)
    let fp = genPayloadPtr(&mut cg, ov, enumName, okVariant)
    let cfp = nextTemp(&mut cg)
    emit(&mut cg, "  " + cfp + " = extractvalue %Closure " + clv.v + ", 0\n")
    let cenv = nextTemp(&mut cg)
    emit(&mut cg, "  " + cenv + " = extractvalue %Closure " + clv.v + ", 1\n")
    let newInnerLl = llType(newInnerTy)
    let cr = nextTemp(&mut cg)
    emit(&mut cg, "  " + cr + " = call " + newInnerLl + " " + cfp + "(ptr " + cenv + ", ptr " + fp + ")\n")
    let someVal = genBuildVariant1(&mut cg, Val {
        v: cr, ty: newInnerTy.clone()
    }, newEnumTy, okVariant)
    emit(&mut cg, "  store " + newStructTy + " " + someVal.v + ", ptr " + resAddr + "\n")
    emit(&mut cg, "  br label %" + endLbl + "\n")

    emitLabel(&mut cg, failLbl)
    if isResult {
        let efp = genPayloadPtr(&mut cg, ov, enumName, "Err")
        let errTy = lookupVariantPayload(cg, enumName, "Err") [0].clone()
        let ev = nextTemp(&mut cg)
        emit(&mut cg, "  " + ev + " = load " + llType(errTy) + ", ptr " + efp + "\n")
        let errVal = genBuildVariant1(&mut cg, Val {
            v: ev, ty: errTy
        }, newEnumTy, "Err")
        emit(&mut cg, "  store " + newStructTy + " " + errVal.v + ", ptr " + resAddr + "\n")
    } else {
        let noneVal = genBuildVariant0(&mut cg, newEnumTy, "None")
        emit(&mut cg, "  store " + newStructTy + " " + noneVal.v + ", ptr " + resAddr + "\n")
    }
    emit(&mut cg, "  br label %" + endLbl + "\n")

    emitLabel(&mut cg, endLbl)
    let r = nextTemp(&mut cg)
    emit(&mut cg, "  " + r + " = load " + newStructTy + ", ptr " + resAddr + "\n")
    return Val {
        v: r, ty: newEnumTy
    }
}

// mapErr(f): Result<T,E> -> Result<T,F> — the mirror of map, callback on the Err
// side. The Ok payload is forwarded through untouched.
pub fn genOptionResultMapErr(cg: &mut Cgen, ov: &Val, enumName: &string, cbExpr: &ExprNode, locs: &Vec<Local>, sigs: &Vec<CgFnSig>): Val {
    let innerTy = lookupVariantPayload(cg, enumName, "Ok") [0].clone()
    var maperrHints: Vec<string> = Vec.new()
    maperrHints.push(lookupVariantPayload(cg, enumName, "Err") [0].clone())
    cg.closureParamHint = maperrHints
    let clv = genExpr(&mut cg, cbExpr, locs, sigs, "")
    cg.closureParamHint = Vec.new()
    // see genOptionResultMap's comment: strip a stray '%' from genEnumLit's convention
    let newErrTy = stripPercent(closureRetOf(clv.ty))
    let newEnumTy = stripPercent(resolveTyStr(cg, "Result<" + innerTy.clone() + "," + newErrTy.clone() + ">"))
    let newStructTy = "%" + newEnumTy.clone()
    let resAddr = nextTemp(&mut cg)
    emit(&mut cg, "  " + resAddr + " = alloca " + newStructTy + "\n")
    let tag = genEnumTag(&mut cg, ov, enumName)
    let okTag = lookupVariantTag(cg, enumName, "Ok")
    let isOk = nextTemp(&mut cg)
    emit(&mut cg, "  " + isOk + " = icmp eq i32 " + tag + ", " + okTag.toString() + "\n")
    let okLbl = nextLabel(&mut cg, "maperr.ok")
    let errLbl = nextLabel(&mut cg, "maperr.err")
    let endLbl = nextLabel(&mut cg, "maperr.end")
    emit(&mut cg, "  br i1 " + isOk + ", label %" + okLbl + ", label %" + errLbl + "\n")

    emitLabel(&mut cg, okLbl)
    let ofp = genPayloadPtr(&mut cg, ov, enumName, "Ok")
    let okv = nextTemp(&mut cg)
    emit(&mut cg, "  " + okv + " = load " + llType(innerTy) + ", ptr " + ofp + "\n")
    let okVal = genBuildVariant1(&mut cg, Val {
        v: okv, ty: innerTy.clone()
    }, newEnumTy, "Ok")
    emit(&mut cg, "  store " + newStructTy + " " + okVal.v + ", ptr " + resAddr + "\n")
    emit(&mut cg, "  br label %" + endLbl + "\n")

    emitLabel(&mut cg, errLbl)
    let efp = genPayloadPtr(&mut cg, ov, enumName, "Err")
    let cfp = nextTemp(&mut cg)
    emit(&mut cg, "  " + cfp + " = extractvalue %Closure " + clv.v + ", 0\n")
    let cenv = nextTemp(&mut cg)
    emit(&mut cg, "  " + cenv + " = extractvalue %Closure " + clv.v + ", 1\n")
    let newErrLl = llType(newErrTy)
    let cr = nextTemp(&mut cg)
    emit(&mut cg, "  " + cr + " = call " + newErrLl + " " + cfp + "(ptr " + cenv + ", ptr " + efp + ")\n")
    let errVal = genBuildVariant1(&mut cg, Val {
        v: cr, ty: newErrTy.clone()
    }, newEnumTy, "Err")
    emit(&mut cg, "  store " + newStructTy + " " + errVal.v + ", ptr " + resAddr + "\n")
    emit(&mut cg, "  br label %" + endLbl + "\n")

    emitLabel(&mut cg, endLbl)
    let r = nextTemp(&mut cg)
    emit(&mut cg, "  " + r + " = load " + newStructTy + ", ptr " + resAddr + "\n")
    return Val {
        v: r, ty: newEnumTy
    }
}

// andThen(f): T -> Option<U>/Result<U,E>, f itself returning the whole enum — the
// chaining form. The result's mono type IS the closure's return type. Result's Err
// payload is forwarded untouched on the fail branch (same as map).
pub fn genOptionResultAndThen(cg: &mut Cgen, ov: &Val, enumName: &string, isResult: bool, cbExpr: &ExprNode, locs: &Vec<Local>, sigs: &Vec<CgFnSig>): Val {
    var okVariant = "Some"
    if isResult {
        okVariant = "Ok"
    }
    var andThenHints: Vec<string> = Vec.new()
    andThenHints.push(lookupVariantPayload(cg, enumName, okVariant) [0].clone())
    cg.closureParamHint = andThenHints
    let clv = genExpr(&mut cg, cbExpr, locs, sigs, "")
    cg.closureParamHint = Vec.new()
    // see genOptionResultMap's comment: strip a stray '%' from genEnumLit's convention
    let newEnumTy = stripPercent(closureRetOf(clv.ty))
    let newStructTy = "%" + newEnumTy.clone()
    let resAddr = nextTemp(&mut cg)
    emit(&mut cg, "  " + resAddr + " = alloca " + newStructTy + "\n")
    let tag = genEnumTag(&mut cg, ov, enumName)
    let okTag = lookupVariantTag(cg, enumName, okVariant)
    let isOk = nextTemp(&mut cg)
    emit(&mut cg, "  " + isOk + " = icmp eq i32 " + tag + ", " + okTag.toString() + "\n")
    let okLbl = nextLabel(&mut cg, "andthen.ok")
    let failLbl = nextLabel(&mut cg, "andthen.fail")
    let endLbl = nextLabel(&mut cg, "andthen.end")
    emit(&mut cg, "  br i1 " + isOk + ", label %" + okLbl + ", label %" + failLbl + "\n")

    emitLabel(&mut cg, okLbl)
    let fp = genPayloadPtr(&mut cg, ov, enumName, okVariant)
    let cfp = nextTemp(&mut cg)
    emit(&mut cg, "  " + cfp + " = extractvalue %Closure " + clv.v + ", 0\n")
    let cenv = nextTemp(&mut cg)
    emit(&mut cg, "  " + cenv + " = extractvalue %Closure " + clv.v + ", 1\n")
    let cr = nextTemp(&mut cg)
    emit(&mut cg, "  " + cr + " = call " + newStructTy + " " + cfp + "(ptr " + cenv + ", ptr " + fp + ")\n")
    emit(&mut cg, "  store " + newStructTy + " " + cr + ", ptr " + resAddr + "\n")
    emit(&mut cg, "  br label %" + endLbl + "\n")

    emitLabel(&mut cg, failLbl)
    if isResult {
        let efp = genPayloadPtr(&mut cg, ov, enumName, "Err")
        let errTy = lookupVariantPayload(cg, enumName, "Err") [0].clone()
        let ev = nextTemp(&mut cg)
        emit(&mut cg, "  " + ev + " = load " + llType(errTy) + ", ptr " + efp + "\n")
        let errVal = genBuildVariant1(&mut cg, Val {
            v: ev, ty: errTy
        }, newEnumTy, "Err")
        emit(&mut cg, "  store " + newStructTy + " " + errVal.v + ", ptr " + resAddr + "\n")
    } else {
        let noneVal = genBuildVariant0(&mut cg, newEnumTy, "None")
        emit(&mut cg, "  store " + newStructTy + " " + noneVal.v + ", ptr " + resAddr + "\n")
    }
    emit(&mut cg, "  br label %" + endLbl + "\n")

    emitLabel(&mut cg, endLbl)
    let r = nextTemp(&mut cg)
    emit(&mut cg, "  " + r + " = load " + newStructTy + ", ptr " + resAddr + "\n")
    return Val {
        v: r, ty: newEnumTy
    }
}

// orElse(f): the None/Err-side andThen — f: () -> Option<T> (Option) or
// (&E) -> Result<T,F> (Result). The ok payload is forwarded through untouched on
// the ok branch, into the (possibly re-typed-E) result.
pub fn genOptionResultOrElse(cg: &mut Cgen, ov: &Val, enumName: &string, isResult: bool, cbExpr: &ExprNode, locs: &Vec<Local>, sigs: &Vec<CgFnSig>): Val {
    var okVariant = "Some"
    if isResult {
        okVariant = "Ok"
    }
    var orElseHints: Vec<string> = Vec.new()
    if isResult {
        orElseHints.push(lookupVariantPayload(cg, enumName, "Err") [0].clone())
    }
    cg.closureParamHint = orElseHints
    // Option<T>.orElse's callback returns the SAME Option<T> (T can't change) — an
    // exact hint, unlike Result's F which the callback is free to retype. Without
    // this, an unannotated `() => Option.None` (zero payload args) can't be
    // disambiguated bottom-up when >1 Option_* monomorphization exists.
    if !isResult {
        cg.closureRetHint = enumName.clone()
    }
    let clv = genExpr(&mut cg, cbExpr, locs, sigs, "")
    cg.closureParamHint = Vec.new()
    cg.closureRetHint = ""
    // see genOptionResultMap's comment: strip a stray '%' from genEnumLit's convention
    let newEnumTy = stripPercent(closureRetOf(clv.ty))
    let newStructTy = "%" + newEnumTy.clone()
    let resAddr = nextTemp(&mut cg)
    emit(&mut cg, "  " + resAddr + " = alloca " + newStructTy + "\n")
    let tag = genEnumTag(&mut cg, ov, enumName)
    let okTag = lookupVariantTag(cg, enumName, okVariant)
    let isOk = nextTemp(&mut cg)
    emit(&mut cg, "  " + isOk + " = icmp eq i32 " + tag + ", " + okTag.toString() + "\n")
    let okLbl = nextLabel(&mut cg, "orelse.ok")
    let failLbl = nextLabel(&mut cg, "orelse.fail")
    let endLbl = nextLabel(&mut cg, "orelse.end")
    emit(&mut cg, "  br i1 " + isOk + ", label %" + okLbl + ", label %" + failLbl + "\n")

    emitLabel(&mut cg, okLbl)
    let fp = genPayloadPtr(&mut cg, ov, enumName, okVariant)
    let okTy = lookupVariantPayload(cg, enumName, okVariant) [0].clone()
    let okv = nextTemp(&mut cg)
    emit(&mut cg, "  " + okv + " = load " + llType(okTy) + ", ptr " + fp + "\n")
    let okVal = genBuildVariant1(&mut cg, Val {
        v: okv, ty: okTy
    }, newEnumTy, okVariant)
    emit(&mut cg, "  store " + newStructTy + " " + okVal.v + ", ptr " + resAddr + "\n")
    emit(&mut cg, "  br label %" + endLbl + "\n")

    emitLabel(&mut cg, failLbl)
    let cfp = nextTemp(&mut cg)
    emit(&mut cg, "  " + cfp + " = extractvalue %Closure " + clv.v + ", 0\n")
    let cenv = nextTemp(&mut cg)
    emit(&mut cg, "  " + cenv + " = extractvalue %Closure " + clv.v + ", 1\n")
    var callArgs = "ptr " + cenv
    if isResult {
        let efp = genPayloadPtr(&mut cg, ov, enumName, "Err")
        callArgs = callArgs + ", ptr " + efp
    }
    let cr = nextTemp(&mut cg)
    emit(&mut cg, "  " + cr + " = call " + newStructTy + " " + cfp + "(" + callArgs + ")\n")
    emit(&mut cg, "  store " + newStructTy + " " + cr + ", ptr " + resAddr + "\n")
    emit(&mut cg, "  br label %" + endLbl + "\n")

    emitLabel(&mut cg, endLbl)
    let r = nextTemp(&mut cg)
    emit(&mut cg, "  " + r + " = load " + newStructTy + ", ptr " + resAddr + "\n")
    return Val {
        v: r, ty: newEnumTy
    }
}

// x.checkedAdd/Sub/Mul(y) → Option<T> via an LLVM overflow intrinsic: Some(result)
// on no overflow, None otherwise.
pub fn genCheckedArith(cg: &mut Cgen, obj: &Val, method: &string, av: &Val): Val {
    let lt = llType(obj.ty)
    var op = "add"
    if method == "checkedSub" {
        op = "sub"
    }
    if method == "checkedMul" {
        op = "mul"
    }
    var pfx = "s"
    if isUnsigned(obj.ty) {
        pfx = "u"
    }
    let intr = "llvm." + pfx + op + ".with.overflow." + lt
    var declared = false
    for i in 0..cg.emittedThunks.len {
        if cg.emittedThunks[i] == intr {
            declared = true
        }
    }
    if !declared {
        cg.emittedThunks.push(intr.clone())
        emitG(&mut cg, "declare {" + lt + ", i1} @" + intr + "(" + lt + ", " + lt + ")\n")
    }
    let cr = nextTemp(&mut cg)
    emit(&mut cg, "  " + cr + " = call {" + lt + ", i1} @" + intr + "(" + lt + " " + obj.v + ", " + lt + " " + av.v + ")\n")
    let val = nextTemp(&mut cg)
    emit(&mut cg, "  " + val + " = extractvalue {" + lt + ", i1} " + cr + ", 0\n")
    let flag = nextTemp(&mut cg)
    emit(&mut cg, "  " + flag + " = extractvalue {" + lt + ", i1} " + cr + ", 1\n")
    let optName = "Option_" + obj.ty.clone()
    let optTy = "%" + optName.clone()
    let slot = nextTemp(&mut cg)
    emit(&mut cg, "  " + slot + " = alloca " + optTy + "\n")
    let okLbl = nextLabel(&mut cg, "chk.ok")
    let ovLbl = nextLabel(&mut cg, "chk.ov")
    let doneLbl = nextLabel(&mut cg, "chk.done")
    emit(&mut cg, "  br i1 " + flag + ", label %" + ovLbl + ", label %" + okLbl + "\n")
    emitLabel(&mut cg, okLbl)
    let someV = genWrapSome(&mut cg, Val {
        v: val, ty: obj.ty.clone()
    }, optName)
    emit(&mut cg, "  store " + optTy + " " + someV.v + ", ptr " + slot + "\n")
    emit(&mut cg, "  br label %" + doneLbl + "\n")
    emitLabel(&mut cg, ovLbl)
    let noneTag = lookupVariantTag(cg, optName, "None")
    let tp = nextTemp(&mut cg)
    emit(&mut cg, "  " + tp + " = getelementptr " + optTy + ", ptr " + slot + ", i32 0, i32 0\n")
    emit(&mut cg, "  store i32 " + noneTag.toString() + ", ptr " + tp + "\n")
    emit(&mut cg, "  br label %" + doneLbl + "\n")
    emitLabel(&mut cg, doneLbl)
    let r = nextTemp(&mut cg)
    emit(&mut cg, "  " + r + " = load " + optTy + ", ptr " + slot + "\n")
    return Val {
        v: r, ty: optName
    }
}

// The implicit-default-mode counterpart of genCheckedArith above: same overflow
// intrinsic, but a plain `+`/`-`/`*` (or unary negate, spelled as `sub 0, x`)
// PANICS on overflow instead of returning an Option. `resultTy` is the SURFACE
// milo type (e.g. "u32", not the LLVM "i32") the caller already computed —
// threaded through explicitly rather than derived from `llTy`, since llTy alone
// can't tell signed from unsigned and a wrong answer here would corrupt any
// later isUnsigned() check on this result.
pub fn emitCheckedArith(cg: &mut Cgen, op: &string, unsigned: bool, llTy: &string, lv: &string, rv: &string, resultTy: &string): Val {
    var pfx = "s"
    if unsigned {
        pfx = "u"
    }
    let intr = "llvm." + pfx + op.clone() + ".with.overflow." + llTy.clone()
    var declared = false
    for i in 0..cg.emittedThunks.len {
        if cg.emittedThunks[i] == intr {
            declared = true
        }
    }
    if !declared {
        cg.emittedThunks.push(intr.clone())
        emitG(&mut cg, "declare {" + llTy.clone() + ", i1} @" + intr + "(" + llTy.clone() + ", " + llTy.clone() + ")\n")
    }
    let cr = nextTemp(&mut cg)
    emit(&mut cg, "  " + cr + " = call {" + llTy.clone() + ", i1} @" + intr + "(" + llTy.clone() + " " + lv.clone() + ", " + llTy.clone() + " " + rv.clone() + ")\n")
    let val = nextTemp(&mut cg)
    emit(&mut cg, "  " + val + " = extractvalue {" + llTy.clone() + ", i1} " + cr + ", 0\n")
    let flag = nextTemp(&mut cg)
    emit(&mut cg, "  " + flag + " = extractvalue {" + llTy.clone() + ", i1} " + cr + ", 1\n")
    let okLbl = nextLabel(&mut cg, "overflow.ok")
    let failLbl = nextLabel(&mut cg, "overflow.fail")
    emit(&mut cg, "  br i1 " + flag + ", label %" + failLbl + ", label %" + okLbl + "\n")
    emit(&mut cg, failLbl + ":\n")
    emitPanic(&mut cg, "milo: integer overflow\n", "")
    // emitLabel, not plain emit: this is the block execution actually falls
    // through to, and any ENCLOSING phi node (an if/match-expression this
    // arithmetic sits inside) picks its predecessor from cg.curBlock — leaving
    // it stale here produced "PHI node entries do not match predecessors!"
    // the first time a checked op landed inside a branch of one (deflateRoundtrip).
    emitLabel(&mut cg, okLbl)
    return Val {
        v: val, ty: resultTy.clone()
    }
}

// The most negative representable value of a signed integer of `bits` width,
// as an LLVM decimal literal. A literal table, not `-(2**(bits-1))` computed at
// runtime: for bits=64 that computation is itself i64::MIN's own magnitude,
// which does not fit as a positive i64 — computing it live would overflow (and
// trap, now that this compiler's own arithmetic is checked-by-default too).
fn minIntLiteral(bits: i64): string {
    if bits == 8 {
        return "-128"
    }
    if bits == 16 {
        return "-32768"
    }
    if bits == 32 {
        return "-2147483648"
    }
    return "-9223372036854775808"
}

// Integer `/` and `%` by zero are LLVM UB (unlike `+ - *`, which wrap): sdiv/udiv
// on a zero divisor is undefined, not merely wrong, so it must trap in every
// mode — including inside a `@wrapping fn`, which only changes the CHECKED-ARITH
// behavior above (there is no modular value for x/0 to wrap to). Signed division
// also traps INT_MIN / -1, the one signed division with no representable result.
pub fn emitDivByZeroCheck(cg: &mut Cgen, divisor: &string, dividend: &string, llTy: &string, signed: bool, bits: i64) {
    let isZero = nextTemp(&mut cg)
    let okLbl = nextLabel(&mut cg, "divz.ok")
    let zeroFail = nextLabel(&mut cg, "divz.zero")
    emit(&mut cg, "  " + isZero + " = icmp eq " + llTy.clone() + " " + divisor.clone() + ", 0\n")
    if signed {
        let ovfCheck = nextLabel(&mut cg, "divz.chkovf")
        let ovfFail = nextLabel(&mut cg, "divz.ovf")
        emit(&mut cg, "  br i1 " + isZero + ", label %" + zeroFail + ", label %" + ovfCheck + "\n")
        emit(&mut cg, ovfCheck + ":\n")
        let minVal = minIntLiteral(bits)
        let isMin = nextTemp(&mut cg)
        emit(&mut cg, "  " + isMin + " = icmp eq " + llTy.clone() + " " + dividend.clone() + ", " + minVal + "\n")
        let isNeg1 = nextTemp(&mut cg)
        emit(&mut cg, "  " + isNeg1 + " = icmp eq " + llTy.clone() + " " + divisor.clone() + ", -1\n")
        let ovf = nextTemp(&mut cg)
        emit(&mut cg, "  " + ovf + " = and i1 " + isMin + ", " + isNeg1 + "\n")
        emit(&mut cg, "  br i1 " + ovf + ", label %" + ovfFail + ", label %" + okLbl + "\n")
        emit(&mut cg, ovfFail + ":\n")
        // The two causes get their own messages — reporting the overflow as "division
        // by zero" sends the reader hunting for a zero divisor that isn't there.
        emitPanic(&mut cg, "milo: division overflow (i" + bits.toString() + "::MIN / -1)\n", "")
    } else {
        emit(&mut cg, "  br i1 " + isZero + ", label %" + zeroFail + ", label %" + okLbl + "\n")
    }
    emit(&mut cg, zeroFail + ":\n")
    emitPanic(&mut cg, "milo: division by zero\n", "")
    emitLabel(&mut cg, okLbl)
}

// The one signed-division exception to "traps in every mode": under `@wrapping`,
// INT_MIN / -1 wraps to INT_MIN (remainder 0) instead of trapping — unlike
// division by zero (no value is "the modular zero-divisor answer", so that
// still always traps), INT_MIN/-1 DOES have a defined modular result. LLVM's
// sdiv/srem of exactly that pair is itself poison, so this routes around the
// instruction with a select rather than feeding it the poison operands.
pub fn emitWrappingSignedDivRem(cg: &mut Cgen, op: &string, lv: &string, rv: &string, llTy: &string, bits: i64): string {
    // zero-only trap: signed=false skips emitDivByZeroCheck's own INT_MIN/-1 branch.
    emitDivByZeroCheck(&mut cg, rv, lv, llTy, false, bits)
    let minVal = minIntLiteral(bits)
    let isMin = nextTemp(&mut cg)
    emit(&mut cg, "  " + isMin + " = icmp eq " + llTy.clone() + " " + lv.clone() + ", " + minVal + "\n")
    let isNeg1 = nextTemp(&mut cg)
    emit(&mut cg, "  " + isNeg1 + " = icmp eq " + llTy.clone() + " " + rv.clone() + ", -1\n")
    let isOvf = nextTemp(&mut cg)
    emit(&mut cg, "  " + isOvf + " = and i1 " + isMin + ", " + isNeg1 + "\n")
    let safeDivisor = nextTemp(&mut cg)
    emit(&mut cg, "  " + safeDivisor + " = select i1 " + isOvf + ", " + llTy.clone() + " 1, " + llTy.clone() + " " + rv.clone() + "\n")
    var instr = "sdiv"
    if op == "%" {
        instr = "srem"
    }
    let raw = nextTemp(&mut cg)
    emit(&mut cg, "  " + raw + " = " + instr + " " + llTy.clone() + " " + lv.clone() + ", " + safeDivisor + "\n")
    var wrapped = minVal
    if op == "%" {
        wrapped = "0"
    }
    let res = nextTemp(&mut cg)
    emit(&mut cg, "  " + res + " = select i1 " + isOvf + ", " + llTy.clone() + " " + wrapped + ", " + llTy.clone() + " " + raw + "\n")
    return res
}

// A shift by >= the operand's bit width (or a negative amount, huge as unsigned)
// is LLVM poison — trap it. `@wrapping fn` callers mask the amount instead (see
// the BinOp choke point) and never reach this at all.
pub fn emitShiftCheck(cg: &mut Cgen, amount: &string, llTy: &string, bits: i64) {
    let bad = nextTemp(&mut cg)
    let okLbl = nextLabel(&mut cg, "shift.ok")
    let failLbl = nextLabel(&mut cg, "shift.oob")
    emit(&mut cg, "  " + bad + " = icmp uge " + llTy.clone() + " " + amount.clone() + ", " + bits.toString() + "\n")
    emit(&mut cg, "  br i1 " + bad + ", label %" + failLbl + ", label %" + okLbl + "\n")
    emit(&mut cg, failLbl + ":\n")
    emitPanic(&mut cg, "milo: shift amount out of range (>= " + bits.toString() + ")\n", "")
    emitLabel(&mut cg, okLbl)
}

// x.wrapping{Add,Sub,Mul}(y): plain add/sub/mul (two's-complement wraps by def).
// x.saturating{Add,Sub,Mul}(y): clamp on overflow. add/sub use llvm.*.sat; mul has
// no sat intrinsic so it uses *.with.overflow + select-to-max.
pub fn genWrapSatArith(cg: &mut Cgen, obj: &Val, method: &string, av: &Val): Val {
    let lt = llType(obj.ty)
    var op = "add"
    if method.endsWith("Sub") {
        op = "sub"
    }
    if method.endsWith("Mul") {
        op = "mul"
    }
    var pfx = "s"
    if isUnsigned(obj.ty) {
        pfx = "u"
    }

    if method.startsWith("wrapping") {
        let r = nextTemp(&mut cg)
        emit(&mut cg, "  " + r + " = " + op + " " + lt + " " + obj.v + ", " + av.v + "\n")
        return Val {
            v: r, ty: obj.ty.clone()
        }
    }

    // saturating mul: overflow intrinsic + clamp to type max
    if op == "mul" {
        let intr = "llvm." + pfx + "mul.with.overflow." + lt
        var declared = false
        for i in 0..cg.emittedThunks.len {
            if cg.emittedThunks[i] == intr {
                declared = true
            }
        }
        if !declared {
            cg.emittedThunks.push(intr.clone())
            emitG(&mut cg, "declare {" + lt + ", i1} @" + intr + "(" + lt + ", " + lt + ")\n")
        }
        let cr = nextTemp(&mut cg)
        emit(&mut cg, "  " + cr + " = call {" + lt + ", i1} @" + intr + "(" + lt + " " + obj.v + ", " + lt + " " + av.v + ")\n")
        let val = nextTemp(&mut cg)
        emit(&mut cg, "  " + val + " = extractvalue {" + lt + ", i1} " + cr + ", 0\n")
        let flag = nextTemp(&mut cg)
        emit(&mut cg, "  " + flag + " = extractvalue {" + lt + ", i1} " + cr + ", 1\n")
        let bits = intBits(lt)
        var clampVal = "0"
        if isUnsigned(obj.ty) {
            clampVal = uMax(bits)
        } else {
            clampVal = sMax(bits)
        }
        let r = nextTemp(&mut cg)
        emit(&mut cg, "  " + r + " = select i1 " + flag + ", " + lt + " " + clampVal + ", " + lt + " " + val + "\n")
        return Val {
            v: r, ty: obj.ty.clone()
        }
    }

    // saturating add/sub via llvm.{s,u}{add,sub}.sat
    let intr = "llvm." + pfx + op + ".sat." + lt
    var declared = false
    for i in 0..cg.emittedThunks.len {
        if cg.emittedThunks[i] == intr {
            declared = true
        }
    }
    if !declared {
        cg.emittedThunks.push(intr.clone())
        emitG(&mut cg, "declare " + lt + " @" + intr + "(" + lt + ", " + lt + ")\n")
    }
    let r = nextTemp(&mut cg)
    emit(&mut cg, "  " + r + " = call " + lt + " @" + intr + "(" + lt + " " + obj.v + ", " + lt + " " + av.v + ")\n")
    return Val {
        v: r, ty: obj.ty.clone()
    }
}

// largest unsigned value for a bit width, as a decimal string (2^bits - 1)
pub fn uMax(bits: i64): string {
    if bits == 8 {
        return "255"
    }
    if bits == 16 {
        return "65535"
    }
    if bits == 32 {
        return "4294967295"
    }
    return "18446744073709551615"
}

// largest signed value for a bit width, as a decimal string (2^(bits-1) - 1)
pub fn sMax(bits: i64): string {
    if bits == 8 {
        return "127"
    }
    if bits == 16 {
        return "32767"
    }
    if bits == 32 {
        return "2147483647"
    }
    return "9223372036854775807"
}

// smallest signed value for a bit width, as a decimal string (-(2^(bits-1)))
pub fn sMin(bits: i64): string {
    if bits == 8 {
        return "-128"
    }
    if bits == 16 {
        return "-32768"
    }
    if bits == 32 {
        return "-2147483648"
    }
    return "-9223372036854775808"
}

// x.checkedDiv/checkedRem(y) → Option<T>, None on divide-by-zero or (signed)
// INT_MIN/-1 (no representable result). div/rem have no *.with.overflow intrinsic
// and LLVM's sdiv/udiv/srem/urem TRAP on those inputs, so the divide itself must
// run only on the branch that already proved it's safe.
pub fn genCheckedDivRem(cg: &mut Cgen, obj: &Val, method: &string, av: &Val): Val {
    let lt = llType(obj.ty)
    var op = "div"
    if method == "checkedRem" {
        op = "rem"
    }
    let signed = !isUnsigned(obj.ty)
    let bits = intBits(lt)

    let zeroCmp = nextTemp(&mut cg)
    emit(&mut cg, "  " + zeroCmp + " = icmp eq " + lt + " " + av.v + ", 0\n")
    var flag = zeroCmp.clone()

    if signed {
        let isMin = nextTemp(&mut cg)
        emit(&mut cg, "  " + isMin + " = icmp eq " + lt + " " + obj.v + ", " + sMin(bits) + "\n")
        let isNeg1 = nextTemp(&mut cg)
        emit(&mut cg, "  " + isNeg1 + " = icmp eq " + lt + " " + av.v + ", -1\n")
        let ovf = nextTemp(&mut cg)
        emit(&mut cg, "  " + ovf + " = and i1 " + isMin + ", " + isNeg1 + "\n")
        let combined = nextTemp(&mut cg)
        emit(&mut cg, "  " + combined + " = or i1 " + zeroCmp + ", " + ovf + "\n")
        flag = combined
    }

    let optName = "Option_" + obj.ty.clone()
    let optTy = "%" + optName.clone()
    let slot = nextTemp(&mut cg)
    emit(&mut cg, "  " + slot + " = alloca " + optTy + "\n")
    let okLbl = nextLabel(&mut cg, "chk.ok")
    let ovLbl = nextLabel(&mut cg, "chk.ov")
    let doneLbl = nextLabel(&mut cg, "chk.done")
    emit(&mut cg, "  br i1 " + flag + ", label %" + ovLbl + ", label %" + okLbl + "\n")

    emitLabel(&mut cg, okLbl)
    var llvmOp = "udiv"
    if signed {
        llvmOp = "sdiv"
    }
    if op == "rem" {
        llvmOp = "urem"
        if signed {
            llvmOp = "srem"
        }
    }
    let val = nextTemp(&mut cg)
    emit(&mut cg, "  " + val + " = " + llvmOp + " " + lt + " " + obj.v + ", " + av.v + "\n")
    let someV = genWrapSome(&mut cg, Val {
        v: val, ty: obj.ty.clone()
    }, optName)
    emit(&mut cg, "  store " + optTy + " " + someV.v + ", ptr " + slot + "\n")
    emit(&mut cg, "  br label %" + doneLbl + "\n")

    emitLabel(&mut cg, ovLbl)
    let noneTag = lookupVariantTag(cg, optName, "None")
    let tp = nextTemp(&mut cg)
    emit(&mut cg, "  " + tp + " = getelementptr " + optTy + ", ptr " + slot + ", i32 0, i32 0\n")
    emit(&mut cg, "  store i32 " + noneTag.toString() + ", ptr " + tp + "\n")
    emit(&mut cg, "  br label %" + doneLbl + "\n")

    emitLabel(&mut cg, doneLbl)
    let r = nextTemp(&mut cg)
    emit(&mut cg, "  " + r + " = load " + optTy + ", ptr " + slot + "\n")
    return Val {
        v: r, ty: optName
    }
}

// x.countOnes/leadingZeros/trailingZeros() → i64 via llvm.ctpop/ctlz/cttz, zero-
// extended to i64 (the count fits any width so the result type is fixed at i64
// regardless of the receiver's). x.reverseBits() → llvm.bitreverse, same width.
pub fn genBitIntrinsic(cg: &mut Cgen, obj: &Val, method: &string): Val {
    let lt = llType(obj.ty)
    if method == "reverseBits" {
        let intr = "llvm.bitreverse." + lt
        var declared = false
        for i in 0..cg.emittedThunks.len {
            if cg.emittedThunks[i] == intr {
                declared = true
            }
        }
        if !declared {
            cg.emittedThunks.push(intr.clone())
            emitG(&mut cg, "declare " + lt + " @" + intr + "(" + lt + ")\n")
        }
        let r = nextTemp(&mut cg)
        emit(&mut cg, "  " + r + " = call " + lt + " @" + intr + "(" + lt + " " + obj.v + ")\n")
        return Val {
            v: r, ty: obj.ty.clone()
        }
    }

    var name = "ctpop"
    if method == "leadingZeros" {
        name = "ctlz"
    }
    if method == "trailingZeros" {
        name = "cttz"
    }
    let intr = "llvm." + name + "." + lt
    var declared = false
    for i in 0..cg.emittedThunks.len {
        if cg.emittedThunks[i] == intr {
            declared = true
        }
    }
    if !declared {
        cg.emittedThunks.push(intr.clone())
        if name == "ctpop" {
            emitG(&mut cg, "declare " + lt + " @" + intr + "(" + lt + ")\n")
        } else {
            // ctlz/cttz take an i1 "is-zero-poison" flag; false = defined for 0 (returns bit width)
            emitG(&mut cg, "declare " + lt + " @" + intr + "(" + lt + ", i1)\n")
        }
    }
    let raw = nextTemp(&mut cg)
    if name == "ctpop" {
        emit(&mut cg, "  " + raw + " = call " + lt + " @" + intr + "(" + lt + " " + obj.v + ")\n")
    } else {
        emit(&mut cg, "  " + raw + " = call " + lt + " @" + intr + "(" + lt + " " + obj.v + ", i1 false)\n")
    }
    if lt == "i64" {
        return Val {
            v: raw, ty: "i64"
        }
    }
    let wide = nextTemp(&mut cg)
    emit(&mut cg, "  " + wide + " = zext " + lt + " " + raw + " to i64\n")
    return Val {
        v: wide, ty: "i64"
    }
}

// Best-effort surface type of a simple payload arg WITHOUT emitting IR — used to
// disambiguate which monomorphization of a generic enum literal to build.
pub fn peekArgTy(e: &ExprNode, locs: &Vec<Local>): string {
    match e.kind {
        Expr.IntLit(n) => {
            return "i64"
        }
        Expr.FloatLit(f) => {
            return "double"
        }
        Expr.BoolLit(b) => {
            return "bool"
        }
        Expr.StringLit(v) => {
            return "string"
        }
        Expr.Ident(name) => {
            if hasLocal(locs, name) {
                return findLocal(locs, name).ty.clone()
            }
            return ""
        }
        // `.len` is always i64 in this codebase (String/Vec/HashMap's length field)
        // — a cheap syntax-only special case, since peekArgTy has no Cgen access
        // for a full struct-field-type lookup. Exists so a generic-enum literal
        // whose payload is a field access (`Option.Some(v.len)`, ambiguous without
        // a hint) can still disambiguate by the payload's actual type below.
        Expr.FieldAccess(obj, field) => {
            if field == "len" {
                return "i64"
            }
            return ""
        }
        _ => {
            return ""
        }
    }
}

// AST-only mirror of the checker's isConstFloatExpr: true when `e` is a float
// literal, or unary-minus / arithmetic built ONLY from float literals — such a
// subtree has no width of its own and may adopt a context type. Used by BinOp
// codegen below, same as the IntLit-only special case it sits beside.
pub fn isFloatLitAstExpr(e: &ExprNode): bool {
    match e.kind {
        Expr.FloatLit(f) => {
            return true
        }
        Expr.UnaryOp(op, operand) => {
            if op == "-" {
                return isFloatLitAstExpr(*operand)
            }
            return false
        }
        Expr.BinOp(op, l, r) => {
            if op == "+" || op == "-" || op == "*" || op == "/" || op == "%" {
                return isFloatLitAstExpr(*l) && isFloatLitAstExpr(*r)
            }
            return false
        }
        _ => {
            return false
        }
    }
}

pub fn genEnumLit(cg: &mut Cgen, enumName: &string, variant: &string, args: &Vec<Heap<ExprNode>>, locs: &Vec<Local>, sigs: &Vec<CgFnSig>, hintTy: &string): Val {
    // Generic enums are registered under their mangled name
    var rEnum = resolveEnumName(cg, enumName)
    // `found` answers "is this a variant at all"; `tag` is only its number. They must stay
    // separate — a variant whose discriminant is -1 is a perfectly good variant, and
    // folding the two questions together routed it to the static-method path, emitting a
    // call to a function that does not exist.
    var found = variantTagOpt(cg, rEnum, variant).isSome()
    var tag = lookupVariantTag(cg, rEnum, variant)
    if !found && hintTy.len > 0 {
        let he = stripPercent(resolveTyStr(cg, stripPercent(hintTy)))
        if he.startsWith(enumName + "_") && variantTagOpt(cg, he, variant).isSome() {
            rEnum = he.clone()
            tag = lookupVariantTag(cg, he, variant)
            found = true
        }
    }
    // No hint (`let a = Maybe.Just(42)`): pick the monomorphization of this generic
    // enum that carries the variant — the sole one, or (if several) the one whose
    // variant payload type matches the first payload argument.
    if !found {
        var cands: Vec<string> = Vec.new()
        for k, v in cg.enums {
            if k.startsWith(enumName + "_") && variantTagOpt(cg, k, variant).isSome() {
                cands.push(k.clone())
            }
        }
        var chosen = ""
        if cands.len == 1 {
            chosen = cands[0].clone()
        } else if cands.len > 1 && args.len > 0 {
            let argKey = llType(peekArgTy(*args[0], locs))
            if argKey.len > 0 {
                for ci in 0..cands.len {
                    let pl = lookupVariantPayload(cg, cands[ci], variant)
                    if pl.len >= 1 && llType(pl[0]) == argKey {
                        chosen = cands[ci].clone()
                    }
                }
            }
        }
        if chosen.len > 0 {
            rEnum = chosen
            tag = lookupVariantTag(cg, rEnum, variant)
            found = true
        }
    }
    // `Type.method(...)` with no matching variant is a static method on a struct
    // (e.g. File.openRead) — the parser lands both on the enum-literal form. It is
    // registered as `Type$method`; route it to the plain call path.
    if !found {
        // A capitalized *variable* followed by `.thing` parses identically to a
        // static call — the parser has no type info to disambiguate. The checker
        // (checkEnumLit) already resolves this case to a real field/method access
        // when enumName is a bound variable rather than a struct type; codegen has
        // no access to that decision (it re-walks the raw, already-checked AST), so
        // it re-derives it here the same way: struct-type name wins first (it's a
        // disjoint namespace from locals in valid programs), else fall back to the
        // variable's field/method, matching the checker's field-vs-method rule
        // (field only when there's an exact field of that name and no call args).
        let isVarLocal = hasLocal(locs, enumName)
        let isVarGlobal = !isVarLocal && cg.globalVars.contains(enumName)
        if !cg.structs.contains(enumName) && (isVarLocal || isVarGlobal) {
            var varTy = ""
            if isVarLocal {
                varTy = findLocal(locs, enumName).ty
            } else {
                varTy = cg.globalVars.get(enumName)!
            }
            let varStructName = stripPercent(varTy) // struct-typed vars carry the '%' LLVM prefix; cg.structs keys on the bare name
            var isField = false
            if cg.structs.contains(varStructName) {
                let sfields = cg.structs.get(varStructName)!
                for fi in 0..sfields.len {
                    if sfields[fi].name == variant {
                        isField = true
                    }
                }
            }
            let objExpr = mkExpr(Expr.Ident(enumName.clone()), Option.None)
            if isField && args.len == 0 {
                return genFieldAccess(&mut cg, *objExpr, variant, locs, sigs)
            }
            return genMethodCall(&mut cg, *objExpr, variant, args, locs, sigs)
        }
        var emptyTA: Vec<MiloType> = Vec.new()
        var noSpan: Option<Span> = Option.None
        return genCall(&mut cg, rEnum + "$" + variant, args, emptyTA, locs, sigs, "", noSpan)
    }
    let structTy = "%" + rEnum
    let alloc = nextTemp(&mut cg)
    emit(&mut cg, "  " + alloc + " = alloca " + structTy + "\n")
    let tagPtr = nextTemp(&mut cg)
    emit(&mut cg, "  " + tagPtr + " = getelementptr " + structTy + ", ptr " + alloc + ", i32 0, i32 0\n")
    emit(&mut cg, "  store i32 " + tag.toString() + ", ptr " + tagPtr + "\n")
    let payloadTypes = lookupVariantPayload(cg, rEnum, variant)
    if args.len > 0 && payloadTypes.len > 0 {
        let payPtr = nextTemp(&mut cg)
        emit(&mut cg, "  " + payPtr + " = getelementptr " + structTy + ", ptr " + alloc + ", i32 0, i32 1\n")
        let vstructTy = variantStructTy(payloadTypes)
        for fi in 0..args.len {
            let ftyLl = llType(payloadTypes[fi])
            let fp = nextTemp(&mut cg)
            emit(&mut cg, "  " + fp + " = getelementptr " + vstructTy + ", ptr " + payPtr + ", i32 0, i32 " + fi.toString() + "\n")
            // enum payloads are owned → move the value (zero the source place)
            let fv = genOwnedArg(&mut cg, *args[fi], payloadTypes[fi].clone(), locs, sigs)
            // Reconcile integer width: a payload slot of u32 fed an i64 value
            // (e.g. Result.Ok(someI64) where Ok holds u32) must trunc, or clang
            // rejects `store i32 <i64>`.
            var storeVal = fv.v.clone()
            let fvLl = llType(fv.ty)
            if fvLl != ftyLl && intBits(fvLl) > 0 && intBits(ftyLl) > 0 {
                let w = nextTemp(&mut cg)
                if intBits(fvLl) > intBits(ftyLl) {
                    emit(&mut cg, "  " + w + " = trunc " + fvLl + " " + fv.v + " to " + ftyLl + "\n")
                } else {
                    var ext = "sext"
                    if isUnsigned(fv.ty) {
                        ext = "zext"
                    }
                    emit(&mut cg, "  " + w + " = " + ext + " " + fvLl + " " + fv.v + " to " + ftyLl + "\n")
                }
                storeVal = w
            }
            emit(&mut cg, "  store " + ftyLl + " " + storeVal + ", ptr " + fp + "\n")
        }
    }
    let loaded = nextTemp(&mut cg)
    emit(&mut cg, "  " + loaded + " = load " + structTy + ", ptr " + alloc + "\n")
    return Val {
        v: loaded, ty: structTy
    }
}

// -- Cast --

// Whether it is safe to feed the CAST's target type in as `inner`'s hint.
// `0 as *T` needs the hint (so the IntLit branch spells it "null", not "0"),
// and `0.1 as f32` needs it too (so the literal rounds through f32). But the
// checker never gives a cast operand an expected-type hint (checkCast just
// calls plain checkExpr on it — the whole point of `as` is bridging operand
// types the checker did NOT unify) — so a cast operand with a REAL variable in
// it, e.g. `(-1 - xs) as f64` with `xs: i64`, checks as a plain i64 subtraction.
// Forwarding the f64 hint into that BinOp used to retype the bare `-1` literal
// as a double while `xs` stayed i64, producing `fsub double %float, %i64` —
// invalid IR. Only forward the hint when `inner` is built ENTIRELY from
// literals (no Ident/Call/FieldAccess/…), matching what the checker itself
// would have resolved unhinted.
pub fn isHintSafeCastOperand(e: &ExprNode): bool {
    match e.kind {
        Expr.IntLit(n) => {
            return true
        }
        Expr.FloatLit(f) => {
            return true
        }
        Expr.BoolLit(b) => {
            return true
        }
        Expr.CharLit(c) => {
            return true
        }
        Expr.UnaryOp(op, operand) => {
            if op == "-" {
                return isHintSafeCastOperand(*operand)
            }
            return false
        }
        Expr.BinOp(op, l, r) => {
            if op == "+" || op == "-" || op == "*" || op == "/" || op == "%" {
                return isHintSafeCastOperand(*l) && isHintSafeCastOperand(*r)
            }
            return false
        }
        _ => {
            return false
        }
    }
}

pub fn genAsCast(cg: &mut Cgen, inner: &ExprNode, targetTy: &string, locs: &Vec<Local>, sigs: &Vec<CgFnSig>): Val {
    // A bare fn name cast to a raw pointer (`_osThreadTrampoline as *u8`) is the
    // fn's own address, NOT a closure thunk — pass @name directly.
    let toPtr = (targetTy.len > 0 && targetTy[0] == 42) || llType(targetTy) == "ptr"
    if toPtr {
        match inner.kind {
            Expr.Ident(nm) => {
                if !hasLocal(locs, nm) && cg.fnRets.contains(nm) {
                    return Val {
                        v: "@" + nm.clone(), ty: targetTy.clone()
                    }
                }
            }
            _ => {
            }
        }
        // Inline struct-field array (see isInlineArrTy — e.g. `saved: [u8;80]` inside
        // TermState) cast to a raw pointer is C's array-to-pointer decay: the field's
        // OWN ADDRESS is the pointer value. This isn't Vec-backed (no {ptr,len,cap}
        // header to extract a data pointer from — see genIndex's identical check), so
        // the plain genExpr path below would LOAD the whole `[N x T]` as a value
        // instead, and the catch-all `intBits(fromLl) == 0` fallback further down then
        // mislabeled that aggregate `ptr` without converting it: `tcgetattr(0,
        // state.saved as *u8)` passed a `[80 x i8]`-typed temporary where the extern
        // declared `ptr`, and clang rejected the mismatched define.
        if isInlineArrTy(placeTypeStrOrAbort(cg, inner, locs, "a cast through an inline array")) {
            let addr = genLvalue(&mut cg, inner, locs, sigs)
            return Val {
                v: addr.v, ty: targetTy.clone()
            }
        }
    }
    var innerHint = ""
    if isHintSafeCastOperand(inner) {
        innerHint = targetTy.clone()
    }
    let v = genExpr(&mut cg, inner, locs, sigs, innerHint)
    let fromLl = llType(v.ty)
    let toLl = llType(targetTy)

    // Integer-repr enum to an integer: the discriminant IS the value, and milo0 stores it
    // as the i32 tag in field 0. Self-contained (extract, then widen/narrow to the target)
    // so it cannot interact with the pointer and float paths below.
    if intBits(toLl.clone()) > 0 && cg.enums.contains(stripPercent(resolveTyStr(cg, stripPercent(v.ty)))) {
        let raw = nextTemp(&mut cg)
        emit(&mut cg, "  " + raw + " = extractvalue " + fromLl.clone() + " " + v.v.clone() + ", 0\n")
        let want = intBits(toLl.clone())
        if want == 32 {
            return Val {
                v: raw, ty: targetTy.clone()
            }
        }
        let conv = nextTemp(&mut cg)
        var op = "sext"
        if want < 32 {
            op = "trunc"
        }
        emit(&mut cg, "  " + conv + " = " + op + " i32 " + raw + " to " + toLl.clone() + "\n")
        return Val {
            v: conv, ty: targetTy.clone()
        }
    }
    // Pointer target (`x as *T`, or a bare `ptr`): the value is an opaque `ptr`,
    // but carry the SURFACE `*T` so index/index-assign can recover element type T.
    let toIsPtr = (targetTy.len > 0 && targetTy[0] == 42) || toLl == "ptr"
    if toIsPtr {
        // Vec/String decay to their data pointer (field 0), not the whole header.
        if fromLl == "%Vec" || fromLl == "%String" {
            let d = nextTemp(&mut cg)
            emit(&mut cg, "  " + d + " = extractvalue " + fromLl + " " + v.v + ", 0\n")
            return Val {
                v: d, ty: targetTy.clone()
            }
        }
        // a closure/fn value cast to a raw pointer yields its fnptr (field 0).
        if fromLl == "%Closure" {
            let d = nextTemp(&mut cg)
            emit(&mut cg, "  " + d + " = extractvalue %Closure " + v.v + ", 0\n")
            return Val {
                v: d, ty: targetTy.clone()
            }
        }
        if fromLl == "ptr" || intBits(fromLl) == 0 {
            return Val {
                v: v.v, ty: targetTy.clone()
            }
        }
        var src = v.v.clone()
        if intBits(fromLl) < 64 {
            let ext = nextTemp(&mut cg)
            let op = if isUnsigned(v.ty) {
                "zext"
            } else {
                "sext"
            }
            emit(&mut cg, "  " + ext + " = " + op + " " + fromLl + " " + src + " to i64\n")
            src = ext
        }
        let ip = nextTemp(&mut cg)
        emit(&mut cg, "  " + ip + " = inttoptr i64 " + src + " to ptr\n")
        return Val {
            v: ip, ty: targetTy.clone()
        }
    }
    if fromLl == toLl {
        return v
    }
    let fromBits = intBits(fromLl)
    let toBits = intBits(toLl)
    // ptr <-> int needs ptrtoint/inttoptr, not bitcast. intBits("ptr") is 64, so
    // without this `p as i64` lands in the equal-width bitcast branch below and
    // clang rejects it.
    if fromLl == "ptr" && toBits > 0 {
        let pi = nextTemp(&mut cg)
        emit(&mut cg, "  " + pi + " = ptrtoint ptr " + v.v + " to i64\n")
        if toBits == 64 {
            return Val {
                v: pi, ty: toLl
            }
        }
        let tr = nextTemp(&mut cg)
        emit(&mut cg, "  " + tr + " = trunc i64 " + pi + " to " + toLl + "\n")
        return Val {
            v: tr, ty: toLl
        }
    }
    if toLl == "ptr" && fromBits > 0 {
        var src = v.v.clone()
        if fromBits < 64 {
            let ext = nextTemp(&mut cg)
            let op = if isUnsigned(v.ty) {
                "zext"
            } else {
                "sext"
            }
            emit(&mut cg, "  " + ext + " = " + op + " " + fromLl + " " + src + " to i64\n")
            src = ext
        }
        let ip = nextTemp(&mut cg)
        emit(&mut cg, "  " + ip + " = inttoptr i64 " + src + " to ptr\n")
        return Val {
            v: ip, ty: "ptr"
        }
    }
    // int <-> float and float <-> float need real conversion ops, not a relabel.
    let fromIsFloat = fromLl == "double" || fromLl == "float"
    let toIsFloat = toLl == "double" || toLl == "float"
    if fromBits > 0 && toIsFloat {
        let cf = nextTemp(&mut cg)
        var op = "sitofp"
        if isUnsigned(v.ty) {
            op = "uitofp"
        }
        emit(&mut cg, "  " + cf + " = " + op + " " + fromLl + " " + v.v + " to " + toLl + "\n")
        // SURFACE type ("f32"), not the LLVM spelling ("float"): llType's milo
        // "float" alias for f64 also stringifies to "float", so a caller that
        // re-derives the LLVM type from this Val.ty (llType(v.ty)) got "double"
        // back for what is actually an LLVM `float` value — a real type/value
        // mismatch downstream (`trunc double %x to float` on an already-float %x).
        return Val {
            v: cf, ty: targetTy.clone()
        }
    }
    if fromIsFloat && toBits > 0 {
        // Raw fptosi/fptoui is poison (UB) when the value overflows the target or is
        // NaN — castFloatSaturate wants total, defined behavior (clamp to min/max,
        // NaN -> 0), so route through LLVM's saturating intrinsic instead of the
        // bare instruction. Matches the oracle (src/codegen.ts) exactly.
        var op = "fptosi"
        if isUnsigned(targetTy) {
            op = "fptoui"
        }
        let intrinsic = ensureFpSat(&mut cg, op, toLl.clone(), fromLl.clone())
        let ci = nextTemp(&mut cg)
        emit(&mut cg, "  " + ci + " = call " + toLl + " @" + intrinsic + "(" + fromLl + " " + v.v + ")\n")
        // The SURFACE type, not the LLVM spelling: `x as u8` typed as plain `i8` is
        // indistinguishable from a signed i8 downstream, and printing then sign-extended
        // a u8 of 255 into -1.
        return Val {
            v: ci, ty: targetTy.clone()
        }
    }
    if fromIsFloat && toIsFloat {
        let cff = nextTemp(&mut cg)
        var op = "fpext"
        if fromLl == "double" && toLl == "float" {
            op = "fptrunc"
        }
        emit(&mut cg, "  " + cff + " = " + op + " " + fromLl + " " + v.v + " to " + toLl + "\n")
        // SURFACE type, same reason as the int->float branch above.
        return Val {
            v: cff, ty: targetTy.clone()
        }
    }
    if fromBits == 0 || toBits == 0 {
        return Val {
            v: v.v, ty: toLl
        }
    }
    let t = nextTemp(&mut cg)
    if toBits < fromBits {
        emit(&mut cg, "  " + t + " = trunc " + fromLl + " " + v.v + " to " + toLl + "\n")
    } else if toBits > fromBits {
        let op = if isUnsigned(v.ty) {
            "zext"
        } else {
            "sext"
        }
        emit(&mut cg, "  " + t + " = " + op + " " + fromLl + " " + v.v + " to " + toLl + "\n")
    } else {
        emit(&mut cg, "  " + t + " = bitcast " + fromLl + " " + v.v + " to " + toLl + "\n")
    }
    return Val {
        v: t, ty: toLl
    }
}

// -- Heap deref --

pub fn genHeapDeref(cg: &mut Cgen, inner: &ExprNode, locs: &Vec<Local>, sigs: &Vec<CgFnSig>): Val {
    let v = genExpr(&mut cg, inner, locs, sigs, "")
    let heapInner = unwrapHeap(v.ty)
    if heapInner.len > 0 {
        let innerLl = llType(heapInner)
        let loaded = nextTemp(&mut cg)
        emit(&mut cg, "  " + loaded + " = load " + innerLl + ", ptr " + v.v + "\n")
        return Val {
            v: loaded, ty: innerLl
        }
    }
    // Raw pointer deref (*T, **T, ...). Mirror genLvalue's UnaryOp('*') case:
    // strip exactly one leading '*' to get the pointee's AST-form type string.
    // Returning the AST form (not llType'd) — instead of the old unconditional
    // "i64" fallback this replaced — is what lets `let p = *pp` on a `**T` keep
    // enough type info for a second `*p` to find ITS pointee correctly.
    if v.ty.len == 0 || v.ty[0] != 42 {
        eprint("codegen: '*' deref on non-pointer, non-Heap type '" + v.ty.clone() + "'")
        exit(1)
    }
    let ptrInner = v.ty[1..v.ty.len].clone()
    let innerLl = llType(ptrInner)
    let loaded = nextTemp(&mut cg)
    emit(&mut cg, "  " + loaded + " = load " + innerLl + ", ptr " + v.v + "\n")
    return Val {
        v: loaded, ty: ptrInner
    }
}

// -- Method calls --

// In-place two-pointer reverse of a Vec, swapping element-sized blocks via
// memcpy — mirrors the TS oracle's genVecReverse.
pub fn genVecReverse(cg: &mut Cgen, addr: &string, vecTy: &string): Val {
    ensureMemcpy(&mut cg)
    let elemLl = llType(unwrapVec(vecTy))
    let elemSz = genSizeOf(&mut cg, elemLl)
    let dataPtr = nextTemp(&mut cg)
    emit(&mut cg, "  " + dataPtr + " = getelementptr %Vec, ptr " + addr + ", i32 0, i32 0\n")
    let data = nextTemp(&mut cg)
    emit(&mut cg, "  " + data + " = load ptr, ptr " + dataPtr + "\n")
    let lenPtr = nextTemp(&mut cg)
    emit(&mut cg, "  " + lenPtr + " = getelementptr %Vec, ptr " + addr + ", i32 0, i32 1\n")
    let len = nextTemp(&mut cg)
    emit(&mut cg, "  " + len + " = load i64, ptr " + lenPtr + "\n")
    let tmp = nextTemp(&mut cg)
    emit(&mut cg, "  " + tmp + " = alloca " + elemLl + "\n")
    let loA = nextTemp(&mut cg)
    emit(&mut cg, "  " + loA + " = alloca i64\n")
    emit(&mut cg, "  store i64 0, ptr " + loA + "\n")
    let hiA = nextTemp(&mut cg)
    emit(&mut cg, "  " + hiA + " = alloca i64\n")
    let hiInit = nextTemp(&mut cg)
    emit(&mut cg, "  " + hiInit + " = sub i64 " + len + ", 1\n")
    emit(&mut cg, "  store i64 " + hiInit + ", ptr " + hiA + "\n")
    let condL = nextLabel(&mut cg, "rev.cond")
    let bodyL = nextLabel(&mut cg, "rev.body")
    let endL = nextLabel(&mut cg, "rev.end")
    emit(&mut cg, "  br label %" + condL + "\n")
    emit(&mut cg, condL + ":\n")
    let lo = nextTemp(&mut cg)
    emit(&mut cg, "  " + lo + " = load i64, ptr " + loA + "\n")
    let hi = nextTemp(&mut cg)
    emit(&mut cg, "  " + hi + " = load i64, ptr " + hiA + "\n")
    let cmp = nextTemp(&mut cg)
    emit(&mut cg, "  " + cmp + " = icmp slt i64 " + lo + ", " + hi + "\n")
    emit(&mut cg, "  br i1 " + cmp + ", label %" + bodyL + ", label %" + endL + "\n")
    emit(&mut cg, bodyL + ":\n")
    let loP = nextTemp(&mut cg)
    emit(&mut cg, "  " + loP + " = getelementptr " + elemLl + ", ptr " + data + ", i64 " + lo + "\n")
    let hiP = nextTemp(&mut cg)
    emit(&mut cg, "  " + hiP + " = getelementptr " + elemLl + ", ptr " + data + ", i64 " + hi + "\n")
    emit(&mut cg, "  call ptr @memcpy(ptr " + tmp + ", ptr " + loP + ", i64 " + elemSz + ")\n")
    emit(&mut cg, "  call ptr @memcpy(ptr " + loP + ", ptr " + hiP + ", i64 " + elemSz + ")\n")
    emit(&mut cg, "  call ptr @memcpy(ptr " + hiP + ", ptr " + tmp + ", i64 " + elemSz + ")\n")
    let nlo = nextTemp(&mut cg)
    emit(&mut cg, "  " + nlo + " = add i64 " + lo + ", 1\n")
    emit(&mut cg, "  store i64 " + nlo + ", ptr " + loA + "\n")
    let nhi = nextTemp(&mut cg)
    emit(&mut cg, "  " + nhi + " = sub i64 " + hi + ", 1\n")
    emit(&mut cg, "  store i64 " + nhi + ", ptr " + hiA + "\n")
    emit(&mut cg, "  br label %" + condL + "\n")
    emit(&mut cg, endL + ":\n")
    return Val {
        v: "0", ty: "void"
    }
}

// Clone a loaded value of surface type `ty` (already in register `v`), returning
// the cloned register. Strings deep-copy; types with an `impl Clone` route to
// their `Ty$..$clone` helper; Heap boxes recurse; Copy types pass through.
// Emit `define %NAME @milo.clone.struct.NAME(ptr %self)` — a field-wise deep copy,
// the mirror image of ensureStructDropHelper. Needed because a struct with droppable
// fields and no user `impl Clone` used to fall through genCloneOfLoaded's Copy
// fallback and get a shallow header copy: `arenaGet` then handed back an Option whose
// payload aliased the arena's own element, and dropping the caller's copy freed
// buffers the arena still owned (examples/basics/depgraph.milo, SIGTRAP in libmalloc).
//
// Same mid-stream emission dance as the drop helpers — save every buffer/counter the
// enclosing function is mid-way through, and mark the name BEFORE emitting so a
// self-referential struct (recursing through Heap<T>) terminates.
pub fn ensureStructCloneHelper(cg: &mut Cgen, name: &string) {
    let hn = "milo.clone.struct." + name.clone()
    if dropHelperEmitted(cg, hn) {
        return
    }
    cg.dropHelpers.push(hn.clone())
    let savedBody = cg.body.clone()
    let savedBlock = cg.curBlock.clone()
    let savedTemp = cg.temp
    let savedLabel = cg.label
    let savedFnBuf = cg.fnBuf.clone()
    let savedInFn = cg.inFn
    cg.inFn = false
    cg.fnBuf = ""
    cg.body = ""
    cg.temp = 0
    cg.label = 0
    emit(&mut cg, "entry.bb:\n")
    let structTy = "%" + name.clone()
    let out = nextTemp(&mut cg)
    emit(&mut cg, "  " + out + " = alloca " + structTy + "\n")
    let fields = cg.structs.get(name)!
    for i in 0..fields.len {
        let fll = llType(resolveTyStr(cg, fields[i].ty))
        let sp = nextTemp(&mut cg)
        emit(&mut cg, "  " + sp + " = getelementptr " + structTy + ", ptr %self, i32 0, i32 " + i.toString() + "\n")
        let fv = nextTemp(&mut cg)
        emit(&mut cg, "  " + fv + " = load " + fll + ", ptr " + sp + "\n")
        var stored = fv.clone()
        if cgNeedsDrop(cg, fields[i].ty) {
            stored = genCloneOfLoaded(&mut cg, fv, fields[i].ty)
        }
        let dp = nextTemp(&mut cg)
        emit(&mut cg, "  " + dp + " = getelementptr " + structTy + ", ptr " + out + ", i32 0, i32 " + i.toString() + "\n")
        emit(&mut cg, "  store " + fll + " " + stored + ", ptr " + dp + "\n")
    }
    let loaded = nextTemp(&mut cg)
    emit(&mut cg, "  " + loaded + " = load " + structTy + ", ptr " + out + "\n")
    emit(&mut cg, "  ret " + structTy + " " + loaded + "\n")
    let helperIR = "define " + structTy + " @" + hn + "(ptr %self) {\n" + cg.body.clone() + "}\n\n"
    cg.body = savedBody
    cg.curBlock = savedBlock
    cg.fnBuf = savedFnBuf
    cg.inFn = savedInFn
    cg.temp = savedTemp
    cg.label = savedLabel
    cg.globals = cg.globals + helperIR
}

// Emit `define %NAME @milo.clone.enum.NAME(ptr %self)` — the mirror image of
// ensureEnumDropHelper, for an enum that owns heap in some variant and has no user
// `impl Clone`. Without it those enums took genCloneOfLoaded's Copy fallback and the
// "clone" shared every payload buffer with the original (a JsonPlan payload string
// was freed by both the local's scope drop and the enum's drop helper).
//
// The whole aggregate is copied first, so Copy payloads and the tag come along for
// free; only droppable payload fields are overwritten with real clones.
pub fn ensureEnumCloneHelper(cg: &mut Cgen, name: &string) {
    let hn = "milo.clone.enum." + name.clone()
    if dropHelperEmitted(cg, hn) {
        return
    }
    // Marked BEFORE emitting so a self-referential enum (recursing through Heap<T>)
    // terminates, same as the struct/drop helpers.
    cg.dropHelpers.push(hn.clone())
    let savedBody = cg.body.clone()
    let savedBlock = cg.curBlock.clone()
    let savedTemp = cg.temp
    let savedLabel = cg.label
    let savedFnBuf = cg.fnBuf.clone()
    let savedInFn = cg.inFn
    cg.inFn = false
    cg.fnBuf = ""
    cg.body = ""
    cg.temp = 0
    cg.label = 0
    emit(&mut cg, "entry.bb:\n")
    let enumTy = "%" + name.clone()
    let out = nextTemp(&mut cg)
    emit(&mut cg, "  " + out + " = alloca " + enumTy + "\n")
    let whole = nextTemp(&mut cg)
    emit(&mut cg, "  " + whole + " = load " + enumTy + ", ptr %self\n")
    emit(&mut cg, "  store " + enumTy + " " + whole + ", ptr " + out + "\n")
    let tp = nextTemp(&mut cg)
    emit(&mut cg, "  " + tp + " = getelementptr " + enumTy + ", ptr %self, i32 0, i32 0\n")
    let tag = nextTemp(&mut cg)
    emit(&mut cg, "  " + tag + " = load i32, ptr " + tp + "\n")
    let done = nextLabel(&mut cg, "ecdone")

    var caseLines = ""
    var cloneIdx: Vec<i64> = Vec.new()
    var cloneLbls: Vec<string> = Vec.new()
    let info = cg.enums.get(name)!
    for vi in 0..info.variants.len {
        let payloadTypes = lookupVariantPayload(cg, name, info.variants[vi].name)
        var anyDrop = false
        for pi in 0..payloadTypes.len {
            if cgNeedsDrop(cg, payloadTypes[pi]) {
                anyDrop = true
            }
        }
        if anyDrop {
            let lbl = nextLabel(&mut cg, "eclone")
            caseLines = caseLines + "    i32 " + info.variants[vi].tag.toString() + ", label %" + lbl + "\n"
            cloneIdx.push(vi)
            cloneLbls.push(lbl)
        }
    }
    if cloneIdx.len > 0 {
        emit(&mut cg, "  switch i32 " + tag + ", label %" + done + " [\n" + caseLines + "  ]\n")
        for k in 0..cloneIdx.len {
            let vi = cloneIdx[k]
            emitLabel(&mut cg, cloneLbls[k])
            let payloadTypes = lookupVariantPayload(cg, name, info.variants[vi].name)
            let srcPay = nextTemp(&mut cg)
            emit(&mut cg, "  " + srcPay + " = getelementptr " + enumTy + ", ptr %self, i32 0, i32 1\n")
            let dstPay = nextTemp(&mut cg)
            emit(&mut cg, "  " + dstPay + " = getelementptr " + enumTy + ", ptr " + out + ", i32 0, i32 1\n")
            let vstructTy = variantStructTyDrop(payloadTypes)
            for pi in 0..payloadTypes.len {
                if cgNeedsDrop(cg, payloadTypes[pi]) {
                    let fll = llType(resolveTyStr(cg, payloadTypes[pi]))
                    let sfp = nextTemp(&mut cg)
                    emit(&mut cg, "  " + sfp + " = getelementptr " + vstructTy + ", ptr " + srcPay + ", i32 0, i32 " + pi.toString() + "\n")
                    let fv = nextTemp(&mut cg)
                    emit(&mut cg, "  " + fv + " = load " + fll + ", ptr " + sfp + "\n")
                    let cloned = genCloneOfLoaded(&mut cg, fv, payloadTypes[pi])
                    let dfp = nextTemp(&mut cg)
                    emit(&mut cg, "  " + dfp + " = getelementptr " + vstructTy + ", ptr " + dstPay + ", i32 0, i32 " + pi.toString() + "\n")
                    emit(&mut cg, "  store " + fll + " " + cloned + ", ptr " + dfp + "\n")
                }
            }
            emit(&mut cg, "  br label %" + done + "\n")
        }
    } else {
        emit(&mut cg, "  br label %" + done + "\n")
    }
    emitLabel(&mut cg, done)
    let loaded = nextTemp(&mut cg)
    emit(&mut cg, "  " + loaded + " = load " + enumTy + ", ptr " + out + "\n")
    emit(&mut cg, "  ret " + enumTy + " " + loaded + "\n")
    let helperIR = "define " + enumTy + " @" + hn + "(ptr %self) {\n" + cg.body.clone() + "}\n\n"
    cg.body = savedBody
    cg.curBlock = savedBlock
    cg.fnBuf = savedFnBuf
    cg.inFn = savedInFn
    cg.temp = savedTemp
    cg.label = savedLabel
    cg.globals = cg.globals + helperIR
}

pub fn genCloneOfLoaded(cg: &mut Cgen, v: &string, ty: &string): string {
    let ll = llType(ty)
    if ll == "%String" {
        return genStringClone(&mut cg, v).v
    }
    // A nested owning container needs the same deep copy the top level gets.
    // Without these two, cloning a Vec<Vec<T>> or a Vec<HashMap<K,V>> copied the
    // inner {ptr,len,cap} headers verbatim and the "clone" shared every inner
    // buffer with the original — the fallback at the bottom of this function
    // treats an unrecognized type as Copy, and both of these look Copy to it.
    if isVecTy(ty) {
        return genDeepCloneVecVal(&mut cg, Val {
            v: v.clone(), ty: ty.clone()
        }).v
    }
    if isHashMapTy(ty) {
        return genDeepCloneHashMapVal(&mut cg, Val {
            v: v.clone(), ty: ty.clone()
        }).v
    }
    // A Heap<T> box is just a pointer. Copying it verbatim hands out a SECOND owner
    // of one allocation: `Expr.ArrayRepeat(elements[0], …)` returned a box the
    // element Vec still owned, so the Vec's scope drop freed a node the returned AST
    // still pointed at (parseArrayLit → drop.struct.Program, 264-byte %Expr). Box a
    // deep copy of the pointee instead.
    let heapInner = unwrapHeap(resolveTyStr(cg, ty))
    if heapInner.len > 0 {
        let innerLl = llType(resolveTyStr(cg, heapInner))
        let loadedInner = nextTemp(&mut cg)
        emit(&mut cg, "  " + loadedInner + " = load " + innerLl + ", ptr " + v.clone() + "\n")
        let clonedInner = genCloneOfLoaded(&mut cg, loadedInner, heapInner)
        let szPtr = nextTemp(&mut cg)
        emit(&mut cg, "  " + szPtr + " = getelementptr " + innerLl + ", ptr null, i32 1\n")
        let szInt = nextTemp(&mut cg)
        emit(&mut cg, "  " + szInt + " = ptrtoint ptr " + szPtr + " to i64\n")
        ensureMalloc(&mut cg)
        let boxPtr = nextTemp(&mut cg)
        emit(&mut cg, "  " + boxPtr + " = call ptr @malloc(i64 " + szInt + ")\n")
        emit(&mut cg, "  store " + innerLl + " " + clonedInner + ", ptr " + boxPtr + "\n")
        return boxPtr
    }
    // find an impl-Clone helper Ty$..$clone for this type
    let rec = stripPercent(resolveTyStr(cg, stripPercent(ty)))
    var cloneFn = ""
    for k, kv in cg.fnRets {
        if k.startsWith(rec + "$") && k.endsWith("$clone") {
            cloneFn = k.clone()
        }
    }
    if cloneFn.len > 0 {
        // impl-Clone methods take `self: &Self` → a ptr, so materialize v to a
        // temp and pass its address (not the value).
        let slot = nextTemp(&mut cg)
        emit(&mut cg, "  " + slot + " = alloca " + ll + "\n")
        emit(&mut cg, "  store " + ll + " " + v + ", ptr " + slot + "\n")
        let t = nextTemp(&mut cg)
        emit(&mut cg, "  " + t + " = call " + ll + " @" + cloneFn + "(ptr " + slot + ")\n")
        return t
    }
    // A plain struct with droppable fields and no `impl Clone` still needs a real
    // copy — the Copy fallback below would alias every buffer it holds.
    if cg.structs.contains(rec) {
        var anyDroppable = false
        let recFields = cg.structs.get(rec)!
        for i in 0..recFields.len {
            if cgNeedsDrop(cg, recFields[i].ty) {
                anyDroppable = true
            }
        }
        if anyDroppable {
            ensureStructCloneHelper(&mut cg, rec)
            let slot = nextTemp(&mut cg)
            emit(&mut cg, "  " + slot + " = alloca " + ll + "\n")
            emit(&mut cg, "  store " + ll + " " + v + ", ptr " + slot + "\n")
            let t = nextTemp(&mut cg)
            emit(&mut cg, "  " + t + " = call " + ll + " @milo.clone.struct." + rec.clone() + "(ptr " + slot + ")\n")
            return t
        }
    }
    // An enum that owns heap in some variant and has no `impl Clone` needs the same
    // treatment as a droppable struct — the Copy fallback below aliases its payload.
    if cg.enums.contains(rec) {
        var anyDroppable = false
        let einfo = cg.enums.get(rec)!
        for vi in 0..einfo.variants.len {
            let payloadTypes = lookupVariantPayload(cg, rec, einfo.variants[vi].name)
            for pi in 0..payloadTypes.len {
                if cgNeedsDrop(cg, payloadTypes[pi]) {
                    anyDroppable = true
                }
            }
        }
        if anyDroppable {
            ensureEnumCloneHelper(&mut cg, rec)
            let slot = nextTemp(&mut cg)
            emit(&mut cg, "  " + slot + " = alloca " + ll + "\n")
            emit(&mut cg, "  store " + ll + " " + v + ", ptr " + slot + "\n")
            let t = nextTemp(&mut cg)
            emit(&mut cg, "  " + t + " = call " + ll + " @milo.clone.enum." + rec.clone() + "(ptr " + slot + ")\n")
            return t
        }
    }
    // Fail closed. Reaching here with a type that owns heap means the value copy
    // below would alias a buffer someone else frees — a silent double-free, the
    // exact class this function keeps regrowing. Refuse to emit it instead.
    if cgNeedsDrop(cg, ty) {
        eprint("codegen: no deep-clone path for droppable type '" + resolveTyStr(cg, ty) + "' — refusing to emit an aliasing copy")
        exit(1)
    }
    // Copy (ints/bool/ptr) or no clone helper: value copy is a faithful clone
    return v.clone()
}

// `h.clone()` for h: Heap<T> is a deref-and-clone: the checker types it as T
// (not Heap<T>), so return the cloned pointee VALUE, not a re-boxed pointer.
pub fn genHeapClone(cg: &mut Cgen, boxPtr: &string, heapTy: &string): Val {
    let inner = unwrapHeap(heapTy)
    let innerLl = llType(inner)
    let p = nextTemp(&mut cg)
    emit(&mut cg, "  " + p + " = load " + innerLl + ", ptr " + boxPtr + "\n")
    let cloned = genCloneOfLoaded(&mut cg, p, inner)
    return Val {
        v: cloned, ty: inner
    }
}

// Vec.pop: Option<T> — None on empty, else len-- and MOVE the (former) last
// element into Some. No clone: the slot is past the new len, so ownership
// transfers to the caller rather than being shared with the Vec.
pub fn genVecPop(cg: &mut Cgen, addr: &string, vecTy: &string): Val {
    let elemTy = unwrapVec(vecTy)
    let elemLl = llType(elemTy)
    // Mangle the whole Option<elemTy> so nested generics resolve to the mono
    // enum the checker registered (see genHashMapGet).
    let optName = stripPercent(resolveTyStr(cg, "Option<" + elemTy + ">"))
    let optTy = "%" + optName
    let someTag = lookupVariantTag(cg, optName, "Some")
    let noneTag = lookupVariantTag(cg, optName, "None")
    let resAddr = nextTemp(&mut cg)
    emit(&mut cg, "  " + resAddr + " = alloca " + optTy + "\n")
    emit(&mut cg, "  store " + optTy + " zeroinitializer, ptr " + resAddr + "\n")
    let tagPtr = nextTemp(&mut cg)
    emit(&mut cg, "  " + tagPtr + " = getelementptr " + optTy + ", ptr " + resAddr + ", i32 0, i32 0\n")
    emit(&mut cg, "  store i32 " + noneTag.toString() + ", ptr " + tagPtr + "\n")
    let lenPtr = nextTemp(&mut cg)
    emit(&mut cg, "  " + lenPtr + " = getelementptr %Vec, ptr " + addr + ", i32 0, i32 1\n")
    let len = nextTemp(&mut cg)
    emit(&mut cg, "  " + len + " = load i64, ptr " + lenPtr + "\n")
    let isEmpty = nextTemp(&mut cg)
    emit(&mut cg, "  " + isEmpty + " = icmp eq i64 " + len + ", 0\n")
    let someLbl = nextLabel(&mut cg, "pop.some")
    let endLbl = nextLabel(&mut cg, "pop.end")
    emit(&mut cg, "  br i1 " + isEmpty + ", label %" + endLbl + ", label %" + someLbl + "\n")
    emit(&mut cg, someLbl + ":\n")
    let newLen = nextTemp(&mut cg)
    emit(&mut cg, "  " + newLen + " = sub i64 " + len + ", 1\n")
    emit(&mut cg, "  store i64 " + newLen + ", ptr " + lenPtr + "\n")
    let dataPtr = nextTemp(&mut cg)
    emit(&mut cg, "  " + dataPtr + " = getelementptr %Vec, ptr " + addr + ", i32 0, i32 0\n")
    let data = nextTemp(&mut cg)
    emit(&mut cg, "  " + data + " = load ptr, ptr " + dataPtr + "\n")
    let elemPtr = nextTemp(&mut cg)
    emit(&mut cg, "  " + elemPtr + " = getelementptr " + elemLl + ", ptr " + data + ", i64 " + newLen + "\n")
    let val = nextTemp(&mut cg)
    emit(&mut cg, "  " + val + " = load " + elemLl + ", ptr " + elemPtr + "\n")
    emit(&mut cg, "  store i32 " + someTag.toString() + ", ptr " + tagPtr + "\n")
    let payPtr = nextTemp(&mut cg)
    emit(&mut cg, "  " + payPtr + " = getelementptr " + optTy + ", ptr " + resAddr + ", i32 0, i32 1\n")
    let pstructTy = "{ " + elemLl + " }"
    let fp = nextTemp(&mut cg)
    emit(&mut cg, "  " + fp + " = getelementptr " + pstructTy + ", ptr " + payPtr + ", i32 0, i32 0\n")
    emit(&mut cg, "  store " + elemLl + " " + val + ", ptr " + fp + "\n")
    emit(&mut cg, "  br label %" + endLbl + "\n")
    emit(&mut cg, endLbl + ":\n")
    let r = nextTemp(&mut cg)
    emit(&mut cg, "  " + r + " = load " + optTy + ", ptr " + resAddr + "\n")
    return Val {
        v: r, ty: optName
    }
}

// v.truncate(n) / v.clear() (clear passes nArg=0): elements at index >= n are
// OWNED by the Vec, so shortening the length without running their drop glue
// would leak every string, nested Vec or Drop-implementing struct above the
// cut. `lv` is the Vec's ADDRESS (mutates the length field in place).
pub fn genVecTruncateCg(cg: &mut Cgen, lv: &Val, elemTy: &string, nArg: &Val): Val {
    let elemLl = llType(elemTy)
    let nRaw = widenToI64(&mut cg, nArg)
    // A negative length means empty; a length past the end is a no-op, never a grow.
    let isNeg = nextTemp(&mut cg)
    emit(&mut cg, "  " + isNeg + " = icmp slt i64 " + nRaw + ", 0\n")
    let n = nextTemp(&mut cg)
    emit(&mut cg, "  " + n + " = select i1 " + isNeg + ", i64 0, i64 " + nRaw + "\n")

    let lenPtr = nextTemp(&mut cg)
    emit(&mut cg, "  " + lenPtr + " = getelementptr %Vec, ptr " + lv.v + ", i32 0, i32 1\n")
    let len = nextTemp(&mut cg)
    emit(&mut cg, "  " + len + " = load i64, ptr " + lenPtr + "\n")

    let doneLbl = nextLabel(&mut cg, "vec.trunc.done")
    let startLbl = nextLabel(&mut cg, "vec.trunc.start")
    let noop = nextTemp(&mut cg)
    emit(&mut cg, "  " + noop + " = icmp uge i64 " + n + ", " + len + "\n")
    emit(&mut cg, "  br i1 " + noop + ", label %" + doneLbl + ", label %" + startLbl + "\n")
    emitLabel(&mut cg, startLbl)

    if cgNeedsDrop(cg, elemTy) {
        let dataPtr = nextTemp(&mut cg)
        emit(&mut cg, "  " + dataPtr + " = getelementptr %Vec, ptr " + lv.v + ", i32 0, i32 0\n")
        let data = nextTemp(&mut cg)
        emit(&mut cg, "  " + data + " = load ptr, ptr " + dataPtr + "\n")
        let iAddr = nextTemp(&mut cg)
        emit(&mut cg, "  " + iAddr + " = alloca i64\n")
        emit(&mut cg, "  store i64 " + n + ", ptr " + iAddr + "\n")
        let condLbl = nextLabel(&mut cg, "vec.trunc.cond")
        let bodyLbl = nextLabel(&mut cg, "vec.trunc.body")
        let finLbl = nextLabel(&mut cg, "vec.trunc.fin")
        emit(&mut cg, "  br label %" + condLbl + "\n")
        emitLabel(&mut cg, condLbl)
        let i = nextTemp(&mut cg)
        emit(&mut cg, "  " + i + " = load i64, ptr " + iAddr + "\n")
        let cont = nextTemp(&mut cg)
        emit(&mut cg, "  " + cont + " = icmp ult i64 " + i + ", " + len + "\n")
        emit(&mut cg, "  br i1 " + cont + ", label %" + bodyLbl + ", label %" + finLbl + "\n")
        emitLabel(&mut cg, bodyLbl)
        let elemPtr = nextTemp(&mut cg)
        emit(&mut cg, "  " + elemPtr + " = getelementptr " + elemLl + ", ptr " + data + ", i64 " + i + "\n")
        emitDropValue(&mut cg, elemPtr, elemTy)
        let iNext = nextTemp(&mut cg)
        emit(&mut cg, "  " + iNext + " = add i64 " + i + ", 1\n")
        emit(&mut cg, "  store i64 " + iNext + ", ptr " + iAddr + "\n")
        emit(&mut cg, "  br label %" + condLbl + "\n")
        emitLabel(&mut cg, finLbl)
    }

    emit(&mut cg, "  store i64 " + n + ", ptr " + lenPtr + "\n")
    emit(&mut cg, "  br label %" + doneLbl + "\n")
    emitLabel(&mut cg, doneLbl)
    return Val {
        v: "0", ty: "void"
    }
}

// `>` on a sortByKey key value. Mirrors sort's comparable-type gate (int, float,
// string, bool) — the checker already rejected anything else.
pub fn genKeyGt(cg: &mut Cgen, keyTy: &string, keyLl: &string, av: &string, bv: &string): string {
    if keyLl == "%String" {
        let r = genStringCmp(&mut cg, av, bv, ">")
        return r.v
    }
    if keyLl == "double" || keyLl == "float" {
        let r = nextTemp(&mut cg)
        emit(&mut cg, "  " + r + " = fcmp ogt " + keyLl + " " + av.clone() + ", " + bv.clone() + "\n")
        return r
    }
    if keyLl == "i1" {
        let r = nextTemp(&mut cg)
        emit(&mut cg, "  " + r + " = icmp ugt i1 " + av.clone() + ", " + bv.clone() + "\n")
        return r
    }
    var cmpOp = "sgt"
    if isUnsigned(keyTy) {
        cmpOp = "ugt"
    }
    let r = nextTemp(&mut cg)
    emit(&mut cg, "  " + r + " = icmp " + cmpOp + " " + keyLl + " " + av.clone() + ", " + bv.clone() + "\n")
    return r
}

// sortByKey((&T)=>K): a stable insertion sort — O(n^2), fine at bootstrap scale
// (mirrors the oracle's genVecSortByKey in src/codegen-vec.ts). `lv` is the Vec's
// ADDRESS; the key extractor is called on the temp slot being inserted AND on
// each candidate predecessor, same as the oracle (no caching of predecessor keys).
pub fn genVecSortByKeyCg(cg: &mut Cgen, lv: &Val, elemTy: &string, keyTy: &string, clv: &Val): Val {
    ensureMemcpy(&mut cg)
    let elemLl = llType(elemTy)
    // llTypeBytes only knows scalar/{ptr,len,cap} widths and defaults everything
    // else (any user struct/enum) to 8 — silently truncating a memcpy of e.g. a
    // %User (24+ bytes) mid-sort. genSizeOf emits the real getelementptr-based
    // sizeof, correct for any LLVM type including padding.
    let elemBytes = genSizeOf(&mut cg, elemLl)
    let keyLl = llType(keyTy)

    let dPtr = nextTemp(&mut cg)
    emit(&mut cg, "  " + dPtr + " = getelementptr %Vec, ptr " + lv.v + ", i32 0, i32 0\n")
    let d = nextTemp(&mut cg)
    emit(&mut cg, "  " + d + " = load ptr, ptr " + dPtr + "\n")
    let lenPtr = nextTemp(&mut cg)
    emit(&mut cg, "  " + lenPtr + " = getelementptr %Vec, ptr " + lv.v + ", i32 0, i32 1\n")
    let len = nextTemp(&mut cg)
    emit(&mut cg, "  " + len + " = load i64, ptr " + lenPtr + "\n")

    let tmpAddr = nextTemp(&mut cg)
    emit(&mut cg, "  " + tmpAddr + " = alloca " + elemLl + "\n")
    let tmpKeyAddr = nextTemp(&mut cg)
    emit(&mut cg, "  " + tmpKeyAddr + " = alloca " + keyLl + "\n")
    let iAddr = nextTemp(&mut cg)
    emit(&mut cg, "  " + iAddr + " = alloca i64\n")
    emit(&mut cg, "  store i64 1, ptr " + iAddr + "\n")
    let jAddr = nextTemp(&mut cg)
    emit(&mut cg, "  " + jAddr + " = alloca i64\n")

    let fp = nextTemp(&mut cg)
    emit(&mut cg, "  " + fp + " = extractvalue %Closure " + clv.v + ", 0\n")
    let env = nextTemp(&mut cg)
    emit(&mut cg, "  " + env + " = extractvalue %Closure " + clv.v + ", 1\n")

    let outerCond = nextLabel(&mut cg, "sortkey.outer.cond")
    let outerBody = nextLabel(&mut cg, "sortkey.outer.body")
    let innerCond = nextLabel(&mut cg, "sortkey.inner.cond")
    let checkCmp = nextLabel(&mut cg, "sortkey.checkcmp")
    let innerBody = nextLabel(&mut cg, "sortkey.inner.body")
    let innerEnd = nextLabel(&mut cg, "sortkey.inner.end")
    let outerEnd = nextLabel(&mut cg, "sortkey.outer.end")

    emit(&mut cg, "  br label %" + outerCond + "\n")
    emitLabel(&mut cg, outerCond)
    let i = nextTemp(&mut cg)
    emit(&mut cg, "  " + i + " = load i64, ptr " + iAddr + "\n")
    let iCmp = nextTemp(&mut cg)
    emit(&mut cg, "  " + iCmp + " = icmp ult i64 " + i + ", " + len + "\n")
    emit(&mut cg, "  br i1 " + iCmp + ", label %" + outerBody + ", label %" + outerEnd + "\n")

    emitLabel(&mut cg, outerBody)
    let iPtr = nextTemp(&mut cg)
    emit(&mut cg, "  " + iPtr + " = getelementptr " + elemLl + ", ptr " + d + ", i64 " + i + "\n")
    emit(&mut cg, "  call ptr @memcpy(ptr " + tmpAddr + ", ptr " + iPtr + ", i64 " + elemBytes + ")\n")
    let tmpKey = nextTemp(&mut cg)
    emit(&mut cg, "  " + tmpKey + " = call " + keyLl + " " + fp + "(ptr " + env + ", ptr " + tmpAddr + ")\n")
    emit(&mut cg, "  store " + keyLl + " " + tmpKey + ", ptr " + tmpKeyAddr + "\n")
    emit(&mut cg, "  store i64 " + i + ", ptr " + jAddr + "\n")
    emit(&mut cg, "  br label %" + innerCond + "\n")

    emitLabel(&mut cg, innerCond)
    let j = nextTemp(&mut cg)
    emit(&mut cg, "  " + j + " = load i64, ptr " + jAddr + "\n")
    let jGt0 = nextTemp(&mut cg)
    emit(&mut cg, "  " + jGt0 + " = icmp ugt i64 " + j + ", 0\n")
    emit(&mut cg, "  br i1 " + jGt0 + ", label %" + checkCmp + ", label %" + innerEnd + "\n")

    emitLabel(&mut cg, checkCmp)
    let jm1 = nextTemp(&mut cg)
    emit(&mut cg, "  " + jm1 + " = sub i64 " + j + ", 1\n")
    let prevPtr = nextTemp(&mut cg)
    emit(&mut cg, "  " + prevPtr + " = getelementptr " + elemLl + ", ptr " + d + ", i64 " + jm1 + "\n")
    let prevKey = nextTemp(&mut cg)
    emit(&mut cg, "  " + prevKey + " = call " + keyLl + " " + fp + "(ptr " + env + ", ptr " + prevPtr + ")\n")
    let curKey = nextTemp(&mut cg)
    emit(&mut cg, "  " + curKey + " = load " + keyLl + ", ptr " + tmpKeyAddr + "\n")
    let gt = genKeyGt(&mut cg, keyTy, keyLl, prevKey, curKey)
    emit(&mut cg, "  br i1 " + gt + ", label %" + innerBody + ", label %" + innerEnd + "\n")

    emitLabel(&mut cg, innerBody)
    let jPtr = nextTemp(&mut cg)
    emit(&mut cg, "  " + jPtr + " = getelementptr " + elemLl + ", ptr " + d + ", i64 " + j + "\n")
    emit(&mut cg, "  call ptr @memcpy(ptr " + jPtr + ", ptr " + prevPtr + ", i64 " + elemBytes + ")\n")
    let jNext = nextTemp(&mut cg)
    emit(&mut cg, "  " + jNext + " = sub i64 " + j + ", 1\n")
    emit(&mut cg, "  store i64 " + jNext + ", ptr " + jAddr + "\n")
    emit(&mut cg, "  br label %" + innerCond + "\n")

    emitLabel(&mut cg, innerEnd)
    let jFinal = nextTemp(&mut cg)
    emit(&mut cg, "  " + jFinal + " = load i64, ptr " + jAddr + "\n")
    let destPtr = nextTemp(&mut cg)
    emit(&mut cg, "  " + destPtr + " = getelementptr " + elemLl + ", ptr " + d + ", i64 " + jFinal + "\n")
    emit(&mut cg, "  call ptr @memcpy(ptr " + destPtr + ", ptr " + tmpAddr + ", i64 " + elemBytes + ")\n")
    let iNext = nextTemp(&mut cg)
    emit(&mut cg, "  " + iNext + " = add i64 " + i + ", 1\n")
    emit(&mut cg, "  store i64 " + iNext + ", ptr " + iAddr + "\n")
    emit(&mut cg, "  br label %" + outerCond + "\n")

    emitLabel(&mut cg, outerEnd)
    return Val {
        v: "0", ty: "void"
    }
}

// sort(): the same stable insertion sort as sortByKey above, but with no key
// extractor — the element IS the key, compared directly via genKeyGt. `lv` is
// the Vec's ADDRESS, same as sortByKey/swap/insert/remove.
pub fn genVecSort(cg: &mut Cgen, lv: &Val, elemTy: &string): Val {
    ensureMemcpy(&mut cg)
    let elemLl = llType(elemTy)
    let elemBytes = genSizeOf(&mut cg, elemLl)

    let dPtr = nextTemp(&mut cg)
    emit(&mut cg, "  " + dPtr + " = getelementptr %Vec, ptr " + lv.v + ", i32 0, i32 0\n")
    let d = nextTemp(&mut cg)
    emit(&mut cg, "  " + d + " = load ptr, ptr " + dPtr + "\n")
    let lenPtr = nextTemp(&mut cg)
    emit(&mut cg, "  " + lenPtr + " = getelementptr %Vec, ptr " + lv.v + ", i32 0, i32 1\n")
    let len = nextTemp(&mut cg)
    emit(&mut cg, "  " + len + " = load i64, ptr " + lenPtr + "\n")

    let tmpAddr = nextTemp(&mut cg)
    emit(&mut cg, "  " + tmpAddr + " = alloca " + elemLl + "\n")
    let iAddr = nextTemp(&mut cg)
    emit(&mut cg, "  " + iAddr + " = alloca i64\n")
    emit(&mut cg, "  store i64 1, ptr " + iAddr + "\n")
    let jAddr = nextTemp(&mut cg)
    emit(&mut cg, "  " + jAddr + " = alloca i64\n")

    let outerCond = nextLabel(&mut cg, "sort.outer.cond")
    let outerBody = nextLabel(&mut cg, "sort.outer.body")
    let innerCond = nextLabel(&mut cg, "sort.inner.cond")
    let checkCmp = nextLabel(&mut cg, "sort.checkcmp")
    let innerBody = nextLabel(&mut cg, "sort.inner.body")
    let innerEnd = nextLabel(&mut cg, "sort.inner.end")
    let outerEnd = nextLabel(&mut cg, "sort.outer.end")

    emit(&mut cg, "  br label %" + outerCond + "\n")
    emitLabel(&mut cg, outerCond)
    let i = nextTemp(&mut cg)
    emit(&mut cg, "  " + i + " = load i64, ptr " + iAddr + "\n")
    let iCmp = nextTemp(&mut cg)
    emit(&mut cg, "  " + iCmp + " = icmp ult i64 " + i + ", " + len + "\n")
    emit(&mut cg, "  br i1 " + iCmp + ", label %" + outerBody + ", label %" + outerEnd + "\n")

    emitLabel(&mut cg, outerBody)
    let iPtr = nextTemp(&mut cg)
    emit(&mut cg, "  " + iPtr + " = getelementptr " + elemLl + ", ptr " + d + ", i64 " + i + "\n")
    emit(&mut cg, "  call ptr @memcpy(ptr " + tmpAddr + ", ptr " + iPtr + ", i64 " + elemBytes + ")\n")
    emit(&mut cg, "  store i64 " + i + ", ptr " + jAddr + "\n")
    emit(&mut cg, "  br label %" + innerCond + "\n")

    emitLabel(&mut cg, innerCond)
    let j = nextTemp(&mut cg)
    emit(&mut cg, "  " + j + " = load i64, ptr " + jAddr + "\n")
    let jGt0 = nextTemp(&mut cg)
    emit(&mut cg, "  " + jGt0 + " = icmp ugt i64 " + j + ", 0\n")
    emit(&mut cg, "  br i1 " + jGt0 + ", label %" + checkCmp + ", label %" + innerEnd + "\n")

    emitLabel(&mut cg, checkCmp)
    let jm1 = nextTemp(&mut cg)
    emit(&mut cg, "  " + jm1 + " = sub i64 " + j + ", 1\n")
    let prevPtr = nextTemp(&mut cg)
    emit(&mut cg, "  " + prevPtr + " = getelementptr " + elemLl + ", ptr " + d + ", i64 " + jm1 + "\n")
    let prevVal = nextTemp(&mut cg)
    emit(&mut cg, "  " + prevVal + " = load " + elemLl + ", ptr " + prevPtr + "\n")
    let curVal = nextTemp(&mut cg)
    emit(&mut cg, "  " + curVal + " = load " + elemLl + ", ptr " + tmpAddr + "\n")
    let gt = genKeyGt(&mut cg, elemTy, elemLl, prevVal, curVal)
    emit(&mut cg, "  br i1 " + gt + ", label %" + innerBody + ", label %" + innerEnd + "\n")

    emitLabel(&mut cg, innerBody)
    let jPtr = nextTemp(&mut cg)
    emit(&mut cg, "  " + jPtr + " = getelementptr " + elemLl + ", ptr " + d + ", i64 " + j + "\n")
    emit(&mut cg, "  call ptr @memcpy(ptr " + jPtr + ", ptr " + prevPtr + ", i64 " + elemBytes + ")\n")
    let jNext = nextTemp(&mut cg)
    emit(&mut cg, "  " + jNext + " = sub i64 " + j + ", 1\n")
    emit(&mut cg, "  store i64 " + jNext + ", ptr " + jAddr + "\n")
    emit(&mut cg, "  br label %" + innerCond + "\n")

    emitLabel(&mut cg, innerEnd)
    let jFinal = nextTemp(&mut cg)
    emit(&mut cg, "  " + jFinal + " = load i64, ptr " + jAddr + "\n")
    let destPtr = nextTemp(&mut cg)
    emit(&mut cg, "  " + destPtr + " = getelementptr " + elemLl + ", ptr " + d + ", i64 " + jFinal + "\n")
    emit(&mut cg, "  call ptr @memcpy(ptr " + destPtr + ", ptr " + tmpAddr + ", i64 " + elemBytes + ")\n")
    let iNext = nextTemp(&mut cg)
    emit(&mut cg, "  " + iNext + " = add i64 " + i + ", 1\n")
    emit(&mut cg, "  store i64 " + iNext + ", ptr " + iAddr + "\n")
    emit(&mut cg, "  br label %" + outerCond + "\n")

    emitLabel(&mut cg, outerEnd)
    return Val {
        v: "0", ty: "void"
    }
}

// sortBy((&T,&T)=>i32): same insertion sort, comparator called directly on the
// two element pointers (qsort/Ord::cmp contract — >0 means the first arg sorts
// after the second), no key caching needed since there's no key to cache.
pub fn genVecSortByCg(cg: &mut Cgen, lv: &Val, elemTy: &string, clv: &Val): Val {
    ensureMemcpy(&mut cg)
    let elemLl = llType(elemTy)
    let elemBytes = genSizeOf(&mut cg, elemLl)

    let dPtr = nextTemp(&mut cg)
    emit(&mut cg, "  " + dPtr + " = getelementptr %Vec, ptr " + lv.v + ", i32 0, i32 0\n")
    let d = nextTemp(&mut cg)
    emit(&mut cg, "  " + d + " = load ptr, ptr " + dPtr + "\n")
    let lenPtr = nextTemp(&mut cg)
    emit(&mut cg, "  " + lenPtr + " = getelementptr %Vec, ptr " + lv.v + ", i32 0, i32 1\n")
    let len = nextTemp(&mut cg)
    emit(&mut cg, "  " + len + " = load i64, ptr " + lenPtr + "\n")

    let tmpAddr = nextTemp(&mut cg)
    emit(&mut cg, "  " + tmpAddr + " = alloca " + elemLl + "\n")
    let iAddr = nextTemp(&mut cg)
    emit(&mut cg, "  " + iAddr + " = alloca i64\n")
    emit(&mut cg, "  store i64 1, ptr " + iAddr + "\n")
    let jAddr = nextTemp(&mut cg)
    emit(&mut cg, "  " + jAddr + " = alloca i64\n")

    let fp = nextTemp(&mut cg)
    emit(&mut cg, "  " + fp + " = extractvalue %Closure " + clv.v + ", 0\n")
    let env = nextTemp(&mut cg)
    emit(&mut cg, "  " + env + " = extractvalue %Closure " + clv.v + ", 1\n")

    let outerCond = nextLabel(&mut cg, "sortby.outer.cond")
    let outerBody = nextLabel(&mut cg, "sortby.outer.body")
    let innerCond = nextLabel(&mut cg, "sortby.inner.cond")
    let checkCmp = nextLabel(&mut cg, "sortby.checkcmp")
    let innerBody = nextLabel(&mut cg, "sortby.inner.body")
    let innerEnd = nextLabel(&mut cg, "sortby.inner.end")
    let outerEnd = nextLabel(&mut cg, "sortby.outer.end")

    emit(&mut cg, "  br label %" + outerCond + "\n")
    emitLabel(&mut cg, outerCond)
    let i = nextTemp(&mut cg)
    emit(&mut cg, "  " + i + " = load i64, ptr " + iAddr + "\n")
    let iCmp = nextTemp(&mut cg)
    emit(&mut cg, "  " + iCmp + " = icmp ult i64 " + i + ", " + len + "\n")
    emit(&mut cg, "  br i1 " + iCmp + ", label %" + outerBody + ", label %" + outerEnd + "\n")

    emitLabel(&mut cg, outerBody)
    let iPtr = nextTemp(&mut cg)
    emit(&mut cg, "  " + iPtr + " = getelementptr " + elemLl + ", ptr " + d + ", i64 " + i + "\n")
    emit(&mut cg, "  call ptr @memcpy(ptr " + tmpAddr + ", ptr " + iPtr + ", i64 " + elemBytes + ")\n")
    emit(&mut cg, "  store i64 " + i + ", ptr " + jAddr + "\n")
    emit(&mut cg, "  br label %" + innerCond + "\n")

    emitLabel(&mut cg, innerCond)
    let j = nextTemp(&mut cg)
    emit(&mut cg, "  " + j + " = load i64, ptr " + jAddr + "\n")
    let jGt0 = nextTemp(&mut cg)
    emit(&mut cg, "  " + jGt0 + " = icmp ugt i64 " + j + ", 0\n")
    emit(&mut cg, "  br i1 " + jGt0 + ", label %" + checkCmp + ", label %" + innerEnd + "\n")

    emitLabel(&mut cg, checkCmp)
    let jm1 = nextTemp(&mut cg)
    emit(&mut cg, "  " + jm1 + " = sub i64 " + j + ", 1\n")
    let prevPtr = nextTemp(&mut cg)
    emit(&mut cg, "  " + prevPtr + " = getelementptr " + elemLl + ", ptr " + d + ", i64 " + jm1 + "\n")
    let cmpResult = nextTemp(&mut cg)
    emit(&mut cg, "  " + cmpResult + " = call i32 " + fp + "(ptr " + env + ", ptr " + prevPtr + ", ptr " + tmpAddr + ")\n")
    let gt = nextTemp(&mut cg)
    emit(&mut cg, "  " + gt + " = icmp sgt i32 " + cmpResult + ", 0\n")
    emit(&mut cg, "  br i1 " + gt + ", label %" + innerBody + ", label %" + innerEnd + "\n")

    emitLabel(&mut cg, innerBody)
    let jPtr = nextTemp(&mut cg)
    emit(&mut cg, "  " + jPtr + " = getelementptr " + elemLl + ", ptr " + d + ", i64 " + j + "\n")
    emit(&mut cg, "  call ptr @memcpy(ptr " + jPtr + ", ptr " + prevPtr + ", i64 " + elemBytes + ")\n")
    let jNext = nextTemp(&mut cg)
    emit(&mut cg, "  " + jNext + " = sub i64 " + j + ", 1\n")
    emit(&mut cg, "  store i64 " + jNext + ", ptr " + jAddr + "\n")
    emit(&mut cg, "  br label %" + innerCond + "\n")

    emitLabel(&mut cg, innerEnd)
    let jFinal = nextTemp(&mut cg)
    emit(&mut cg, "  " + jFinal + " = load i64, ptr " + jAddr + "\n")
    let destPtr = nextTemp(&mut cg)
    emit(&mut cg, "  " + destPtr + " = getelementptr " + elemLl + ", ptr " + d + ", i64 " + jFinal + "\n")
    emit(&mut cg, "  call ptr @memcpy(ptr " + destPtr + ", ptr " + tmpAddr + ", i64 " + elemBytes + ")\n")
    let iNext = nextTemp(&mut cg)
    emit(&mut cg, "  " + iNext + " = add i64 " + i + ", 1\n")
    emit(&mut cg, "  store i64 " + iNext + ", ptr " + iAddr + "\n")
    emit(&mut cg, "  br label %" + outerCond + "\n")

    emitLabel(&mut cg, outerEnd)
    return Val {
        v: "0", ty: "void"
    }
}

// get(i)/first()/last() -> Option<T>: the total reads. `idxV` is a pre-widened
// i64 temp for "get" (ignored for first/last, which compute their own index).
// Mirrors genVecPop's Option-build shape but never shrinks the Vec — the
// element is deep-cloned out (genCloneOfLoaded) so a String/Vec/struct element
// isn't left aliased between the live Vec slot and the returned Option.
pub fn genVecGetOpt(cg: &mut Cgen, obj: &Val, elemTy: &string, mode: &string, idxV: &string): Val {
    let elemLl = llType(elemTy)
    let d = nextTemp(&mut cg)
    emit(&mut cg, "  " + d + " = extractvalue %Vec " + obj.v + ", 0\n")
    let len = nextTemp(&mut cg)
    emit(&mut cg, "  " + len + " = extractvalue %Vec " + obj.v + ", 1\n")

    var idx = idxV.clone()
    if mode == "first" {
        idx = "0"
    } else if mode == "last" {
        let li = nextTemp(&mut cg)
        emit(&mut cg, "  " + li + " = sub i64 " + len + ", 1\n")
        idx = li
    }

    let optName = stripPercent(resolveTyStr(cg, "Option<" + elemTy.clone() + ">"))
    let optTy = "%" + optName
    let someTag = lookupVariantTag(cg, optName, "Some")
    let noneTag = lookupVariantTag(cg, optName, "None")
    let resAddr = nextTemp(&mut cg)
    emit(&mut cg, "  " + resAddr + " = alloca " + optTy + "\n")
    let tagPtr = nextTemp(&mut cg)
    emit(&mut cg, "  " + tagPtr + " = getelementptr " + optTy + ", ptr " + resAddr + ", i32 0, i32 0\n")
    emit(&mut cg, "  store i32 " + noneTag.toString() + ", ptr " + tagPtr + "\n")

    // Unsigned bounds check: for last() on an empty Vec, idx = 0 - 1 wraps to
    // u64::MAX, which still fails `< len` — no separate empty-check needed.
    let inBounds = nextTemp(&mut cg)
    emit(&mut cg, "  " + inBounds + " = icmp ult i64 " + idx + ", " + len + "\n")
    let someLbl = nextLabel(&mut cg, "vecget.some")
    let endLbl = nextLabel(&mut cg, "vecget.end")
    emit(&mut cg, "  br i1 " + inBounds + ", label %" + someLbl + ", label %" + endLbl + "\n")
    emitLabel(&mut cg, someLbl)
    let elemPtr = nextTemp(&mut cg)
    emit(&mut cg, "  " + elemPtr + " = getelementptr " + elemLl + ", ptr " + d + ", i64 " + idx + "\n")
    let ev = nextTemp(&mut cg)
    emit(&mut cg, "  " + ev + " = load " + elemLl + ", ptr " + elemPtr + "\n")
    let evc = genCloneOfLoaded(&mut cg, ev, elemTy)
    emit(&mut cg, "  store i32 " + someTag.toString() + ", ptr " + tagPtr + "\n")
    let payPtr = nextTemp(&mut cg)
    emit(&mut cg, "  " + payPtr + " = getelementptr " + optTy + ", ptr " + resAddr + ", i32 0, i32 1\n")
    let pfp = nextTemp(&mut cg)
    emit(&mut cg, "  " + pfp + " = getelementptr { " + elemLl + " }, ptr " + payPtr + ", i32 0, i32 0\n")
    emit(&mut cg, "  store " + elemLl + " " + evc + ", ptr " + pfp + "\n")
    emit(&mut cg, "  br label %" + endLbl + "\n")
    emitLabel(&mut cg, endLbl)
    let r = nextTemp(&mut cg)
    emit(&mut cg, "  " + r + " = load " + optTy + ", ptr " + resAddr + "\n")
    return Val {
        v: r, ty: optName
    }
}

// min()/max() -> Option<T>: a linear scan tracking the winning INDEX (not the
// value), so a String winner is cloned once at the end instead of on every
// improvement — same trick genVecSortByKeyCg's caller and genKeyGt already
// use for comparisons. `wantMax` picks the direction; "a beats b" for min is
// just genKeyGt with the operands swapped (b > a), no separate "lt" needed.
pub fn genVecMinMax(cg: &mut Cgen, obj: &Val, elemTy: &string, wantMax: bool): Val {
    let elemLl = llType(elemTy)
    let d = nextTemp(&mut cg)
    emit(&mut cg, "  " + d + " = extractvalue %Vec " + obj.v + ", 0\n")
    let len = nextTemp(&mut cg)
    emit(&mut cg, "  " + len + " = extractvalue %Vec " + obj.v + ", 1\n")

    let optName = stripPercent(resolveTyStr(cg, "Option<" + elemTy.clone() + ">"))
    let optTy = "%" + optName
    let someTag = lookupVariantTag(cg, optName, "Some")
    let noneTag = lookupVariantTag(cg, optName, "None")
    let resAddr = nextTemp(&mut cg)
    emit(&mut cg, "  " + resAddr + " = alloca " + optTy + "\n")
    let tagPtr = nextTemp(&mut cg)
    emit(&mut cg, "  " + tagPtr + " = getelementptr " + optTy + ", ptr " + resAddr + ", i32 0, i32 0\n")
    emit(&mut cg, "  store i32 " + noneTag.toString() + ", ptr " + tagPtr + "\n")

    let empty = nextTemp(&mut cg)
    emit(&mut cg, "  " + empty + " = icmp eq i64 " + len + ", 0\n")
    let scanLbl = nextLabel(&mut cg, "vecmm.scan")
    let endLbl = nextLabel(&mut cg, "vecmm.end")
    emit(&mut cg, "  br i1 " + empty + ", label %" + endLbl + ", label %" + scanLbl + "\n")
    emitLabel(&mut cg, scanLbl)

    let bestAddr = nextTemp(&mut cg)
    emit(&mut cg, "  " + bestAddr + " = alloca i64\n")
    emit(&mut cg, "  store i64 0, ptr " + bestAddr + "\n")
    let iAddr = nextTemp(&mut cg)
    emit(&mut cg, "  " + iAddr + " = alloca i64\n")
    emit(&mut cg, "  store i64 1, ptr " + iAddr + "\n")
    let condLbl = nextLabel(&mut cg, "vecmm.cond")
    let bodyLbl = nextLabel(&mut cg, "vecmm.body")
    let betterLbl = nextLabel(&mut cg, "vecmm.better")
    let stepLbl = nextLabel(&mut cg, "vecmm.step")
    let doneLbl = nextLabel(&mut cg, "vecmm.done")
    emit(&mut cg, "  br label %" + condLbl + "\n")
    emitLabel(&mut cg, condLbl)
    let i = nextTemp(&mut cg)
    emit(&mut cg, "  " + i + " = load i64, ptr " + iAddr + "\n")
    let more = nextTemp(&mut cg)
    emit(&mut cg, "  " + more + " = icmp ult i64 " + i + ", " + len + "\n")
    emit(&mut cg, "  br i1 " + more + ", label %" + bodyLbl + ", label %" + doneLbl + "\n")
    emitLabel(&mut cg, bodyLbl)
    let curPtr = nextTemp(&mut cg)
    emit(&mut cg, "  " + curPtr + " = getelementptr " + elemLl + ", ptr " + d + ", i64 " + i + "\n")
    let cur = nextTemp(&mut cg)
    emit(&mut cg, "  " + cur + " = load " + elemLl + ", ptr " + curPtr + "\n")
    let bestIdx = nextTemp(&mut cg)
    emit(&mut cg, "  " + bestIdx + " = load i64, ptr " + bestAddr + "\n")
    let bestPtr = nextTemp(&mut cg)
    emit(&mut cg, "  " + bestPtr + " = getelementptr " + elemLl + ", ptr " + d + ", i64 " + bestIdx + "\n")
    let best = nextTemp(&mut cg)
    emit(&mut cg, "  " + best + " = load " + elemLl + ", ptr " + bestPtr + "\n")
    var wins = ""
    if wantMax {
        wins = genKeyGt(&mut cg, elemTy, elemLl, cur, best)
    } else {
        wins = genKeyGt(&mut cg, elemTy, elemLl, best, cur)
    }
    emit(&mut cg, "  br i1 " + wins + ", label %" + betterLbl + ", label %" + stepLbl + "\n")
    emitLabel(&mut cg, betterLbl)
    emit(&mut cg, "  store i64 " + i + ", ptr " + bestAddr + "\n")
    emit(&mut cg, "  br label %" + stepLbl + "\n")
    emitLabel(&mut cg, stepLbl)
    let iNext = nextTemp(&mut cg)
    emit(&mut cg, "  " + iNext + " = add i64 " + i + ", 1\n")
    emit(&mut cg, "  store i64 " + iNext + ", ptr " + iAddr + "\n")
    emit(&mut cg, "  br label %" + condLbl + "\n")
    emitLabel(&mut cg, doneLbl)
    let winIdx = nextTemp(&mut cg)
    emit(&mut cg, "  " + winIdx + " = load i64, ptr " + bestAddr + "\n")
    let winPtr = nextTemp(&mut cg)
    emit(&mut cg, "  " + winPtr + " = getelementptr " + elemLl + ", ptr " + d + ", i64 " + winIdx + "\n")
    let winVal = nextTemp(&mut cg)
    emit(&mut cg, "  " + winVal + " = load " + elemLl + ", ptr " + winPtr + "\n")
    let winC = genCloneOfLoaded(&mut cg, winVal, elemTy)
    emit(&mut cg, "  store i32 " + someTag.toString() + ", ptr " + tagPtr + "\n")
    let payPtr = nextTemp(&mut cg)
    emit(&mut cg, "  " + payPtr + " = getelementptr " + optTy + ", ptr " + resAddr + ", i32 0, i32 1\n")
    let pfp = nextTemp(&mut cg)
    emit(&mut cg, "  " + pfp + " = getelementptr { " + elemLl + " }, ptr " + payPtr + ", i32 0, i32 0\n")
    emit(&mut cg, "  store " + elemLl + " " + winC + ", ptr " + pfp + "\n")
    emit(&mut cg, "  br label %" + endLbl + "\n")
    emitLabel(&mut cg, endLbl)
    let r = nextTemp(&mut cg)
    emit(&mut cg, "  " + r + " = load " + optTy + ", ptr " + resAddr + "\n")
    return Val {
        v: r, ty: optName
    }
}

// indexOf(needle) -> Option<i64>: linear scan for the first equal element
// (`find` answers "which value", this answers "where"). Gated by the checker
// to comparable element types only, so the equality test never has to handle
// a struct.
pub fn genVecIndexOf(cg: &mut Cgen, obj: &Val, elemTy: &string, needle: &Val): Val {
    let elemLl = llType(elemTy)
    let d = nextTemp(&mut cg)
    emit(&mut cg, "  " + d + " = extractvalue %Vec " + obj.v + ", 0\n")
    let len = nextTemp(&mut cg)
    emit(&mut cg, "  " + len + " = extractvalue %Vec " + obj.v + ", 1\n")

    let optName = stripPercent(resolveTyStr(cg, "Option<i64>"))
    let optTy = "%" + optName
    let someTag = lookupVariantTag(cg, optName, "Some")
    let noneTag = lookupVariantTag(cg, optName, "None")
    let resAddr = nextTemp(&mut cg)
    emit(&mut cg, "  " + resAddr + " = alloca " + optTy + "\n")
    let tagPtr = nextTemp(&mut cg)
    emit(&mut cg, "  " + tagPtr + " = getelementptr " + optTy + ", ptr " + resAddr + ", i32 0, i32 0\n")
    emit(&mut cg, "  store i32 " + noneTag.toString() + ", ptr " + tagPtr + "\n")

    let iAddr = nextTemp(&mut cg)
    emit(&mut cg, "  " + iAddr + " = alloca i64\n")
    emit(&mut cg, "  store i64 0, ptr " + iAddr + "\n")
    let condLbl = nextLabel(&mut cg, "vecidx.cond")
    let bodyLbl = nextLabel(&mut cg, "vecidx.body")
    let foundLbl = nextLabel(&mut cg, "vecidx.found")
    let stepLbl = nextLabel(&mut cg, "vecidx.step")
    let endLbl = nextLabel(&mut cg, "vecidx.end")
    emit(&mut cg, "  br label %" + condLbl + "\n")
    emitLabel(&mut cg, condLbl)
    let i = nextTemp(&mut cg)
    emit(&mut cg, "  " + i + " = load i64, ptr " + iAddr + "\n")
    let more = nextTemp(&mut cg)
    emit(&mut cg, "  " + more + " = icmp ult i64 " + i + ", " + len + "\n")
    emit(&mut cg, "  br i1 " + more + ", label %" + bodyLbl + ", label %" + endLbl + "\n")
    emitLabel(&mut cg, bodyLbl)
    let elemPtr = nextTemp(&mut cg)
    emit(&mut cg, "  " + elemPtr + " = getelementptr " + elemLl + ", ptr " + d + ", i64 " + i + "\n")
    let elemVal = nextTemp(&mut cg)
    emit(&mut cg, "  " + elemVal + " = load " + elemLl + ", ptr " + elemPtr + "\n")
    var eq = ""
    if elemLl == "%String" {
        eq = genStringEq(&mut cg, elemVal, needle.v, true).v
    } else if elemLl == "double" || elemLl == "float" {
        let fe = nextTemp(&mut cg)
        emit(&mut cg, "  " + fe + " = fcmp oeq " + elemLl + " " + elemVal + ", " + needle.v + "\n")
        eq = fe
    } else {
        let ie = nextTemp(&mut cg)
        emit(&mut cg, "  " + ie + " = icmp eq " + elemLl + " " + elemVal + ", " + needle.v + "\n")
        eq = ie
    }
    emit(&mut cg, "  br i1 " + eq + ", label %" + foundLbl + ", label %" + stepLbl + "\n")
    emitLabel(&mut cg, foundLbl)
    emit(&mut cg, "  store i32 " + someTag.toString() + ", ptr " + tagPtr + "\n")
    let payPtr = nextTemp(&mut cg)
    emit(&mut cg, "  " + payPtr + " = getelementptr " + optTy + ", ptr " + resAddr + ", i32 0, i32 1\n")
    emit(&mut cg, "  store i64 " + i + ", ptr " + payPtr + "\n")
    emit(&mut cg, "  br label %" + endLbl + "\n")
    emitLabel(&mut cg, stepLbl)
    let iNext = nextTemp(&mut cg)
    emit(&mut cg, "  " + iNext + " = add i64 " + i + ", 1\n")
    emit(&mut cg, "  store i64 " + iNext + ", ptr " + iAddr + "\n")
    emit(&mut cg, "  br label %" + condLbl + "\n")
    emitLabel(&mut cg, endLbl)
    let r = nextTemp(&mut cg)
    emit(&mut cg, "  " + r + " = load " + optTy + ", ptr " + resAddr + "\n")
    return Val {
        v: r, ty: optName
    }
}

// position(pred) -> Option<i64>: like genVecFindAnyAll's find mode, but the
// payload is the index that matched rather than a clone of the element.
pub fn genVecPosition(cg: &mut Cgen, obj: &Val, clv: &Val): Val {
    let inElemLl = llType(unwrapVec(resolveTyStr(cg, obj.ty)))
    let d = nextTemp(&mut cg)
    emit(&mut cg, "  " + d + " = extractvalue %Vec " + obj.v + ", 0\n")
    let len = nextTemp(&mut cg)
    emit(&mut cg, "  " + len + " = extractvalue %Vec " + obj.v + ", 1\n")
    let fp = nextTemp(&mut cg)
    emit(&mut cg, "  " + fp + " = extractvalue %Closure " + clv.v + ", 0\n")
    let env = nextTemp(&mut cg)
    emit(&mut cg, "  " + env + " = extractvalue %Closure " + clv.v + ", 1\n")

    let optName = stripPercent(resolveTyStr(cg, "Option<i64>"))
    let optTy = "%" + optName
    let someTag = lookupVariantTag(cg, optName, "Some")
    let noneTag = lookupVariantTag(cg, optName, "None")
    let resAddr = nextTemp(&mut cg)
    emit(&mut cg, "  " + resAddr + " = alloca " + optTy + "\n")
    let tagPtr = nextTemp(&mut cg)
    emit(&mut cg, "  " + tagPtr + " = getelementptr " + optTy + ", ptr " + resAddr + ", i32 0, i32 0\n")
    emit(&mut cg, "  store i32 " + noneTag.toString() + ", ptr " + tagPtr + "\n")

    let iAddr = nextTemp(&mut cg)
    emit(&mut cg, "  " + iAddr + " = alloca i64\n")
    emit(&mut cg, "  store i64 0, ptr " + iAddr + "\n")
    let condLbl = nextLabel(&mut cg, "vecpos.cond")
    let bodyLbl = nextLabel(&mut cg, "vecpos.body")
    let hitLbl = nextLabel(&mut cg, "vecpos.hit")
    let stepLbl = nextLabel(&mut cg, "vecpos.step")
    let endLbl = nextLabel(&mut cg, "vecpos.end")
    emit(&mut cg, "  br label %" + condLbl + "\n")
    emitLabel(&mut cg, condLbl)
    let i = nextTemp(&mut cg)
    emit(&mut cg, "  " + i + " = load i64, ptr " + iAddr + "\n")
    let lt = nextTemp(&mut cg)
    emit(&mut cg, "  " + lt + " = icmp slt i64 " + i + ", " + len + "\n")
    emit(&mut cg, "  br i1 " + lt + ", label %" + bodyLbl + ", label %" + endLbl + "\n")
    emitLabel(&mut cg, bodyLbl)
    let slot = nextTemp(&mut cg)
    emit(&mut cg, "  " + slot + " = getelementptr " + inElemLl + ", ptr " + d + ", i64 " + i + "\n")
    let hit = nextTemp(&mut cg)
    emit(&mut cg, "  " + hit + " = call i1 " + fp + "(ptr " + env + ", ptr " + slot + ")\n")
    emit(&mut cg, "  br i1 " + hit + ", label %" + hitLbl + ", label %" + stepLbl + "\n")
    emitLabel(&mut cg, hitLbl)
    emit(&mut cg, "  store i32 " + someTag.toString() + ", ptr " + tagPtr + "\n")
    let payPtr = nextTemp(&mut cg)
    emit(&mut cg, "  " + payPtr + " = getelementptr " + optTy + ", ptr " + resAddr + ", i32 0, i32 1\n")
    emit(&mut cg, "  store i64 " + i + ", ptr " + payPtr + "\n")
    emit(&mut cg, "  br label %" + endLbl + "\n")
    emitLabel(&mut cg, stepLbl)
    let iNext = nextTemp(&mut cg)
    emit(&mut cg, "  " + iNext + " = add i64 " + i + ", 1\n")
    emit(&mut cg, "  store i64 " + iNext + ", ptr " + iAddr + "\n")
    emit(&mut cg, "  br label %" + condLbl + "\n")
    emitLabel(&mut cg, endLbl)
    let r = nextTemp(&mut cg)
    emit(&mut cg, "  " + r + " = load " + optTy + ", ptr " + resAddr + "\n")
    return Val {
        v: r, ty: optName
    }
}

// retain(pred): filter's in-place twin — one pass, compacting keepers toward
// the front; rejected elements are dropped where they sit (drop glue runs
// exactly once per discard, matching truncate/clear above).
pub fn genVecRetain(cg: &mut Cgen, addr: &string, vecTy: &string, clv: &Val): Val {
    let elemTy = unwrapVec(resolveTyStr(cg, vecTy))
    let elemLl = llType(elemTy)
    let dataPtr = nextTemp(&mut cg)
    emit(&mut cg, "  " + dataPtr + " = getelementptr %Vec, ptr " + addr + ", i32 0, i32 0\n")
    let data = nextTemp(&mut cg)
    emit(&mut cg, "  " + data + " = load ptr, ptr " + dataPtr + "\n")
    let lenPtr = nextTemp(&mut cg)
    emit(&mut cg, "  " + lenPtr + " = getelementptr %Vec, ptr " + addr + ", i32 0, i32 1\n")
    let len = nextTemp(&mut cg)
    emit(&mut cg, "  " + len + " = load i64, ptr " + lenPtr + "\n")
    let fp = nextTemp(&mut cg)
    emit(&mut cg, "  " + fp + " = extractvalue %Closure " + clv.v + ", 0\n")
    let env = nextTemp(&mut cg)
    emit(&mut cg, "  " + env + " = extractvalue %Closure " + clv.v + ", 1\n")

    let iAddr = nextTemp(&mut cg)
    emit(&mut cg, "  " + iAddr + " = alloca i64\n")
    emit(&mut cg, "  store i64 0, ptr " + iAddr + "\n")
    let keptAddr = nextTemp(&mut cg)
    emit(&mut cg, "  " + keptAddr + " = alloca i64\n")
    emit(&mut cg, "  store i64 0, ptr " + keptAddr + "\n")

    let condLbl = nextLabel(&mut cg, "vecret.cond")
    let bodyLbl = nextLabel(&mut cg, "vecret.body")
    let keepLbl = nextLabel(&mut cg, "vecret.keep")
    let dropLbl = nextLabel(&mut cg, "vecret.drop")
    let stepLbl = nextLabel(&mut cg, "vecret.step")
    let endLbl = nextLabel(&mut cg, "vecret.end")
    emit(&mut cg, "  br label %" + condLbl + "\n")
    emitLabel(&mut cg, condLbl)
    let i = nextTemp(&mut cg)
    emit(&mut cg, "  " + i + " = load i64, ptr " + iAddr + "\n")
    let more = nextTemp(&mut cg)
    emit(&mut cg, "  " + more + " = icmp ult i64 " + i + ", " + len + "\n")
    emit(&mut cg, "  br i1 " + more + ", label %" + bodyLbl + ", label %" + endLbl + "\n")
    emitLabel(&mut cg, bodyLbl)
    let elemPtr = nextTemp(&mut cg)
    emit(&mut cg, "  " + elemPtr + " = getelementptr " + elemLl + ", ptr " + data + ", i64 " + i + "\n")
    let hit = nextTemp(&mut cg)
    emit(&mut cg, "  " + hit + " = call i1 " + fp + "(ptr " + env + ", ptr " + elemPtr + ")\n")
    emit(&mut cg, "  br i1 " + hit + ", label %" + keepLbl + ", label %" + dropLbl + "\n")
    emitLabel(&mut cg, keepLbl)
    let kept = nextTemp(&mut cg)
    emit(&mut cg, "  " + kept + " = load i64, ptr " + keptAddr + "\n")
    let dstSlot = nextTemp(&mut cg)
    emit(&mut cg, "  " + dstSlot + " = getelementptr " + elemLl + ", ptr " + data + ", i64 " + kept + "\n")
    let val = nextTemp(&mut cg)
    emit(&mut cg, "  " + val + " = load " + elemLl + ", ptr " + elemPtr + "\n")
    emit(&mut cg, "  store " + elemLl + " " + val + ", ptr " + dstSlot + "\n")
    let keptNext = nextTemp(&mut cg)
    emit(&mut cg, "  " + keptNext + " = add i64 " + kept + ", 1\n")
    emit(&mut cg, "  store i64 " + keptNext + ", ptr " + keptAddr + "\n")
    emit(&mut cg, "  br label %" + stepLbl + "\n")
    emitLabel(&mut cg, dropLbl)
    if cgNeedsDrop(cg, elemTy) {
        emitDropValue(&mut cg, elemPtr, elemTy)
    }
    emit(&mut cg, "  br label %" + stepLbl + "\n")
    emitLabel(&mut cg, stepLbl)
    let iNext = nextTemp(&mut cg)
    emit(&mut cg, "  " + iNext + " = add i64 " + i + ", 1\n")
    emit(&mut cg, "  store i64 " + iNext + ", ptr " + iAddr + "\n")
    emit(&mut cg, "  br label %" + condLbl + "\n")
    emitLabel(&mut cg, endLbl)
    let finalLen = nextTemp(&mut cg)
    emit(&mut cg, "  " + finalLen + " = load i64, ptr " + keptAddr + "\n")
    emit(&mut cg, "  store i64 " + finalLen + ", ptr " + lenPtr + "\n")
    return Val {
        v: "0", ty: "void"
    }
}

// extend(other): `other`'s elements move across bitwise (load+store through
// genVecPush's amortized growth, one per element) — nothing is cloned, so
// nothing needs dropping on the source side. Only `other`'s spine buffer is
// freed once, and only if it owned one (a slice view has cap 0).
pub fn genVecExtend(cg: &mut Cgen, dstAddr: &string, dstVecTy: &string, srcVal: &Val): Val {
    ensureFree(&mut cg)
    let elemTy = unwrapVec(resolveTyStr(cg, dstVecTy))
    let elemLl = llType(elemTy)
    let srcData = nextTemp(&mut cg)
    emit(&mut cg, "  " + srcData + " = extractvalue %Vec " + srcVal.v + ", 0\n")
    let srcLen = nextTemp(&mut cg)
    emit(&mut cg, "  " + srcLen + " = extractvalue %Vec " + srcVal.v + ", 1\n")
    let srcCap = nextTemp(&mut cg)
    emit(&mut cg, "  " + srcCap + " = extractvalue %Vec " + srcVal.v + ", 2\n")

    let iAddr = nextTemp(&mut cg)
    emit(&mut cg, "  " + iAddr + " = alloca i64\n")
    emit(&mut cg, "  store i64 0, ptr " + iAddr + "\n")
    let condLbl = nextLabel(&mut cg, "vecext.cond")
    let bodyLbl = nextLabel(&mut cg, "vecext.body")
    let endLbl = nextLabel(&mut cg, "vecext.end")
    emit(&mut cg, "  br label %" + condLbl + "\n")
    emitLabel(&mut cg, condLbl)
    let i = nextTemp(&mut cg)
    emit(&mut cg, "  " + i + " = load i64, ptr " + iAddr + "\n")
    let more = nextTemp(&mut cg)
    emit(&mut cg, "  " + more + " = icmp ult i64 " + i + ", " + srcLen + "\n")
    emit(&mut cg, "  br i1 " + more + ", label %" + bodyLbl + ", label %" + endLbl + "\n")
    emitLabel(&mut cg, bodyLbl)
    let elemPtr = nextTemp(&mut cg)
    emit(&mut cg, "  " + elemPtr + " = getelementptr " + elemLl + ", ptr " + srcData + ", i64 " + i + "\n")
    let val = nextTemp(&mut cg)
    emit(&mut cg, "  " + val + " = load " + elemLl + ", ptr " + elemPtr + "\n")
    genVecPush(&mut cg, dstAddr, dstVecTy, Val {
        v: val, ty: elemTy.clone()
    })
    let iNext = nextTemp(&mut cg)
    emit(&mut cg, "  " + iNext + " = add i64 " + i + ", 1\n")
    emit(&mut cg, "  store i64 " + iNext + ", ptr " + iAddr + "\n")
    emit(&mut cg, "  br label %" + condLbl + "\n")
    emitLabel(&mut cg, endLbl)

    let owns = nextTemp(&mut cg)
    emit(&mut cg, "  " + owns + " = icmp ugt i64 " + srcCap + ", 0\n")
    let freeLbl = nextLabel(&mut cg, "vecext.free")
    let doneLbl = nextLabel(&mut cg, "vecext.done")
    emit(&mut cg, "  br i1 " + owns + ", label %" + freeLbl + ", label %" + doneLbl + "\n")
    emitLabel(&mut cg, freeLbl)
    emit(&mut cg, "  call void @free(ptr " + srcData + ")\n")
    emit(&mut cg, "  br label %" + doneLbl + "\n")
    emitLabel(&mut cg, doneLbl)
    return Val {
        v: "0", ty: "void"
    }
}

// reserve(n): grow the buffer so it holds `len + n` without a further
// realloc — same amortized-growth machinery genVecPush uses, just sized to
// an explicit request instead of "one more".
pub fn genVecReserve(cg: &mut Cgen, addr: &string, vecTy: &string, nVal: &Val): Val {
    ensureRealloc(&mut cg)
    let elemTy = unwrapVec(resolveTyStr(cg, vecTy))
    let elemLl = llType(elemTy)
    let dPtr = nextTemp(&mut cg)
    emit(&mut cg, "  " + dPtr + " = getelementptr %Vec, ptr " + addr + ", i32 0, i32 0\n")
    let lPtr = nextTemp(&mut cg)
    emit(&mut cg, "  " + lPtr + " = getelementptr %Vec, ptr " + addr + ", i32 0, i32 1\n")
    let cPtr = nextTemp(&mut cg)
    emit(&mut cg, "  " + cPtr + " = getelementptr %Vec, ptr " + addr + ", i32 0, i32 2\n")
    let d = nextTemp(&mut cg)
    emit(&mut cg, "  " + d + " = load ptr, ptr " + dPtr + "\n")
    let l = nextTemp(&mut cg)
    emit(&mut cg, "  " + l + " = load i64, ptr " + lPtr + "\n")
    let cap = nextTemp(&mut cg)
    emit(&mut cg, "  " + cap + " = load i64, ptr " + cPtr + "\n")
    let nI = widenToI64(&mut cg, nVal)
    let need = nextTemp(&mut cg)
    emit(&mut cg, "  " + need + " = add i64 " + l + ", " + nI + "\n")
    let enough = nextTemp(&mut cg)
    emit(&mut cg, "  " + enough + " = icmp uge i64 " + cap + ", " + need + "\n")
    let growLbl = nextLabel(&mut cg, "vecrsv.grow")
    let doneLbl = nextLabel(&mut cg, "vecrsv.done")
    emit(&mut cg, "  br i1 " + enough + ", label %" + doneLbl + ", label %" + growLbl + "\n")
    emitLabel(&mut cg, growLbl)
    let esz = genSizeOf(&mut cg, elemLl)
    let bytes = nextTemp(&mut cg)
    emit(&mut cg, "  " + bytes + " = mul i64 " + need + ", " + esz + "\n")
    let nd = nextTemp(&mut cg)
    emit(&mut cg, "  " + nd + " = call ptr @realloc(ptr " + d + ", i64 " + bytes + ")\n")
    emit(&mut cg, "  store ptr " + nd + ", ptr " + dPtr + "\n")
    emit(&mut cg, "  store i64 " + need + ", ptr " + cPtr + "\n")
    emit(&mut cg, "  br label %" + doneLbl + "\n")
    emitLabel(&mut cg, doneLbl)
    return Val {
        v: "0", ty: "void"
    }
}

// A real deep copy of a %Vec-shaped value: fresh malloc'd buffer, every element
// cloned in (not just the {ptr,len,cap} header — that would alias the source
// buffer, so a later push/mutate through either value would corrupt the other
// and a scope-exit drop of both would free the same allocation twice). Shared
// by `Vec<T>.clone()` and by passing a fixed-size Copy array by value (see
// genOwnedArg's Ident branch): a `[T;N]` local lowers onto this same %Vec
// runtime representation, so "pass by value" has to mean THIS, not a move.
pub fn genDeepCloneVecVal(cg: &mut Cgen, obj: &Val): Val {
    ensureMalloc(&mut cg)
    let elemTy = unwrapVec(resolveTyStr(cg, obj.ty))
    let elemLl = llType(elemTy.clone())
    // The buffer is indexed with `getelementptr <elemLl>` below, so it must be
    // allocated at THAT stride. llTypeBytes only knows scalars and the three
    // {ptr,i64,i64} containers and defaults every named struct/enum to 8 — cloning
    // a Vec<FieldInfo> mallocd len*8 and then strode len*sizeof(FieldInfo) over it,
    // corrupting the heap. genSizeOf asks LLVM for the real size, padding included.
    let esz = genSizeOf(&mut cg, elemLl.clone())
    let srcP = nextTemp(&mut cg)
    emit(&mut cg, "  " + srcP + " = extractvalue %Vec " + obj.v.clone() + ", 0\n")
    let lenV = nextTemp(&mut cg)
    emit(&mut cg, "  " + lenV + " = extractvalue %Vec " + obj.v.clone() + ", 1\n")
    let bytes = nextTemp(&mut cg)
    emit(&mut cg, "  " + bytes + " = mul i64 " + lenV + ", " + esz + "\n")
    let dst = nextTemp(&mut cg)
    emit(&mut cg, "  " + dst + " = call ptr @malloc(i64 " + bytes + ")\n")
    let ictr = nextTemp(&mut cg)
    emit(&mut cg, "  " + ictr + " = alloca i64\n")
    emit(&mut cg, "  store i64 0, ptr " + ictr + "\n")
    let condL = nextLabel(&mut cg, "vclone.cond")
    let bodyL = nextLabel(&mut cg, "vclone.body")
    let endL = nextLabel(&mut cg, "vclone.end")
    emit(&mut cg, "  br label %" + condL.clone() + "\n")
    emitLabel(&mut cg, condL)
    let iv = nextTemp(&mut cg)
    emit(&mut cg, "  " + iv + " = load i64, ptr " + ictr + "\n")
    let more = nextTemp(&mut cg)
    emit(&mut cg, "  " + more + " = icmp slt i64 " + iv + ", " + lenV + "\n")
    emit(&mut cg, "  br i1 " + more + ", label %" + bodyL.clone() + ", label %" + endL.clone() + "\n")
    emitLabel(&mut cg, bodyL)
    let sslot = nextTemp(&mut cg)
    emit(&mut cg, "  " + sslot + " = getelementptr " + elemLl.clone() + ", ptr " + srcP + ", i64 " + iv + "\n")
    let cur = nextTemp(&mut cg)
    emit(&mut cg, "  " + cur + " = load " + elemLl.clone() + ", ptr " + sslot + "\n")
    // Each ELEMENT is cloned too — a shallow element copy would leave two Vecs sharing
    // the same string buffers.
    let cloned = genCloneOfLoaded(&mut cg, cur, elemTy.clone())
    let dslot = nextTemp(&mut cg)
    emit(&mut cg, "  " + dslot + " = getelementptr " + elemLl.clone() + ", ptr " + dst + ", i64 " + iv + "\n")
    emit(&mut cg, "  store " + elemLl.clone() + " " + cloned + ", ptr " + dslot + "\n")
    let inext = nextTemp(&mut cg)
    emit(&mut cg, "  " + inext + " = add i64 " + iv + ", 1\n")
    emit(&mut cg, "  store i64 " + inext + ", ptr " + ictr + "\n")
    emit(&mut cg, "  br label %" + condL.clone() + "\n")
    emitLabel(&mut cg, endL)
    let v0 = nextTemp(&mut cg)
    emit(&mut cg, "  " + v0 + " = insertvalue %Vec undef, ptr " + dst + ", 0\n")
    let v1 = nextTemp(&mut cg)
    emit(&mut cg, "  " + v1 + " = insertvalue %Vec " + v0 + ", i64 " + lenV + ", 1\n")
    let v2 = nextTemp(&mut cg)
    emit(&mut cg, "  " + v2 + " = insertvalue %Vec " + v1 + ", i64 " + lenV + ", 2\n")
    return Val {
        v: v2, ty: obj.ty.clone()
    }
}

// HashMap<K,V>.clone(): a real deep copy, entry by entry. The header is
// {ptr,len,cap} — structurally identical to a Vec — so a plain value copy emits
// valid IR and looks right while aliasing the entry buffer: a write through
// either map is visible in both, and both free the same allocation on drop.
//
// This is exactly how the self-hosted compiler broke. `.clone()` on a HashMap
// had no case here and fell through to the identity fallback at the bottom of
// genMethodCall, so `ck.movedFields = snap.movedFields.clone()` in the checker's
// restoreMoves aliased instead of copying. Two consequences, one cause: restoring
// a move snapshot became a no-op (moves leaked out of an if-arm into its sibling
// and the compiler rejected its own valid source), and once the snapshot dropped
// and freed the shared buffer, ck.movedFields dangled.
pub fn genDeepCloneHashMapVal(cg: &mut Cgen, obj: &Val): Val {
    ensureMalloc(&mut cg)
    ensureHashMapTy(&mut cg)
    let mapTy = resolveTyStr(cg, obj.ty)
    let keyTy = hashMapKeyTy(mapTy)
    let valTy = hashMapValTy(mapTy)
    let keyLl = llType(keyTy.clone())
    let valLl = llType(valTy.clone())
    let entLl = hmEntryTy(keyTy, valTy)
    // GEP-null, not llTypeBytes: the entry is an anonymous struct literal, so its
    // size is LLVM's to compute (padding included), not ours to guess.
    let esz = genSizeOf(&mut cg, entLl)
    let srcP = nextTemp(&mut cg)
    emit(&mut cg, "  " + srcP + " = extractvalue %HashMap " + obj.v.clone() + ", 0\n")
    let lenV = nextTemp(&mut cg)
    emit(&mut cg, "  " + lenV + " = extractvalue %HashMap " + obj.v.clone() + ", 1\n")
    let bytes = nextTemp(&mut cg)
    emit(&mut cg, "  " + bytes + " = mul i64 " + lenV + ", " + esz + "\n")
    let dst = nextTemp(&mut cg)
    emit(&mut cg, "  " + dst + " = call ptr @malloc(i64 " + bytes + ")\n")
    let ictr = nextTemp(&mut cg)
    emit(&mut cg, "  " + ictr + " = alloca i64\n")
    emit(&mut cg, "  store i64 0, ptr " + ictr + "\n")
    let condL = nextLabel(&mut cg, "hmclone.cond")
    let bodyL = nextLabel(&mut cg, "hmclone.body")
    let endL = nextLabel(&mut cg, "hmclone.end")
    emit(&mut cg, "  br label %" + condL.clone() + "\n")
    emitLabel(&mut cg, condL)
    let iv = nextTemp(&mut cg)
    emit(&mut cg, "  " + iv + " = load i64, ptr " + ictr + "\n")
    let more = nextTemp(&mut cg)
    emit(&mut cg, "  " + more + " = icmp slt i64 " + iv + ", " + lenV + "\n")
    emit(&mut cg, "  br i1 " + more + ", label %" + bodyL.clone() + ", label %" + endL.clone() + "\n")
    emitLabel(&mut cg, bodyL)
    let sslot = nextTemp(&mut cg)
    emit(&mut cg, "  " + sslot + " = getelementptr " + entLl.clone() + ", ptr " + srcP + ", i64 " + iv + "\n")
    let ent = nextTemp(&mut cg)
    emit(&mut cg, "  " + ent + " = load " + entLl.clone() + ", ptr " + sslot + "\n")
    // Key AND value are cloned. A shallow key copy is the worse of the two: keys
    // are the thing memcmp reads on every lookup, so a freed-and-reused key buffer
    // shows up as a wrong hit rather than a clean crash.
    let k0 = nextTemp(&mut cg)
    emit(&mut cg, "  " + k0 + " = extractvalue " + entLl.clone() + " " + ent + ", 0\n")
    let v0 = nextTemp(&mut cg)
    emit(&mut cg, "  " + v0 + " = extractvalue " + entLl.clone() + " " + ent + ", 1\n")
    let kc = genCloneOfLoaded(&mut cg, k0, keyTy.clone())
    let vc = genCloneOfLoaded(&mut cg, v0, valTy.clone())
    let e0 = nextTemp(&mut cg)
    emit(&mut cg, "  " + e0 + " = insertvalue " + entLl.clone() + " undef, " + keyLl.clone() + " " + kc + ", 0\n")
    let e1 = nextTemp(&mut cg)
    emit(&mut cg, "  " + e1 + " = insertvalue " + entLl.clone() + " " + e0 + ", " + valLl.clone() + " " + vc + ", 1\n")
    let dslot = nextTemp(&mut cg)
    emit(&mut cg, "  " + dslot + " = getelementptr " + entLl.clone() + ", ptr " + dst + ", i64 " + iv + "\n")
    emit(&mut cg, "  store " + entLl.clone() + " " + e1 + ", ptr " + dslot + "\n")
    let inext = nextTemp(&mut cg)
    emit(&mut cg, "  " + inext + " = add i64 " + iv + ", 1\n")
    emit(&mut cg, "  store i64 " + inext + ", ptr " + ictr + "\n")
    emit(&mut cg, "  br label %" + condL.clone() + "\n")
    emitLabel(&mut cg, endL)
    let h0 = nextTemp(&mut cg)
    emit(&mut cg, "  " + h0 + " = insertvalue %HashMap undef, ptr " + dst + ", 0\n")
    let h1 = nextTemp(&mut cg)
    emit(&mut cg, "  " + h1 + " = insertvalue %HashMap " + h0 + ", i64 " + lenV + ", 1\n")
    let h2 = nextTemp(&mut cg)
    emit(&mut cg, "  " + h2 + " = insertvalue %HashMap " + h1 + ", i64 " + lenV + ", 2\n")
    return Val {
        v: h2, ty: obj.ty.clone()
    }
}

pub fn genMethodCall(cg: &mut Cgen, object: &ExprNode, method: &string, args: &Vec<Heap<ExprNode>>, locs: &Vec<Local>, sigs: &Vec<CgFnSig>): Val {
    // x.addrOf(): the raw address of the receiver lvalue — identical to the old
    // `&x` (see the UnaryOp `&` arm). Resolve the lvalue, don't load a value.
    if method == "addrOf" {
        let lv = genLvalue(&mut cg, object, locs, sigs)
        return Val {
            v: lv.v, ty: "ptr"
        }
    }
    // `push` grows the receiver in place, so it needs the address, not a loaded
    // copy. Resolve the lvalue before evaluating the object as a value.
    if method == "push" {
        let lv = genLvalue(&mut cg, object, locs, sigs)
        if isVecTy(lv.ty) {
            let elemTy = unwrapVec(lv.ty)
            // the pushed element is owned by the vec → move it (zero the source)
            let ev0 = genOwnedArg(&mut cg, *args[0], elemTy.clone(), locs, sigs)
            let ev = genInterfaceCoerceIfNeeded(&mut cg, ev0, elemTy)
            return genVecPush(&mut cg, lv.v, lv.ty, ev)
        }
        if llType(lv.ty) == "%String" {
            let ev = genExpr(&mut cg, *args[0], locs, sigs, "u8")
            // The byte slot is i8; a wider value (e.g. a byte built via i64 bit-ops)
            // must be truncated or clang rejects `store i8 <i64>`.
            var bv = ev.v.clone()
            let evLl = llType(ev.ty)
            if evLl != "i8" && intBits(evLl) > 8 {
                let tb = nextTemp(&mut cg)
                emit(&mut cg, "  " + tb + " = trunc " + evLl + " " + ev.v + " to i8\n")
                bv = tb
            }
            return genStringPush(&mut cg, lv.v, bv)
        }
    }
    // `s.pushStr(other)` — append a whole string in place. Reuses the same amortized
    // growth path the `s = s + x` peephole uses, so the two cannot drift apart.
    if method == "pushStr" {
        let lv = genLvalue(&mut cg, object, locs, sigs)
        if llType(lv.ty) == "%String" {
            let ev = genExpr(&mut cg, *args[0], locs, sigs, "%String")
            genStringAppendInPlace(&mut cg, lv.v, ev.v)
            return Val {
                v: "0", ty: "void"
            }
        }
    }
    // Vec.reverse mutates in place → needs the receiver address. (String.reverse
    // is a different method — it falls through to the strReverse mapping below.)
    if method == "reverse" {
        let lv = genLvalue(&mut cg, object, locs, sigs)
        if isVecTy(lv.ty) {
            return genVecReverse(&mut cg, lv.v, lv.ty)
        }
    }
    // Vec.pop shrinks the receiver in place → needs its address.
    if method == "pop" {
        let lv = genLvalue(&mut cg, object, locs, sigs)
        if isVecTy(lv.ty) {
            return genVecPop(&mut cg, lv.v, lv.ty)
        }
    }
    // insert/remove mutate the receiver in place → need its address, not a copy.
    if method == "insert" || method == "remove" {
        let lv = genLvalue(&mut cg, object, locs, sigs)
        if method == "insert" && isVecTy(lv.ty) {
            let iv = genExpr(&mut cg, *args[0], locs, sigs, "i64")
            var iw = iv.v.clone()
            if llType(iv.ty) != "i64" {
                let ti = nextTemp(&mut cg)
                emit(&mut cg, "  " + ti + " = sext " + llType(iv.ty) + " " + iv.v + " to i64\n")
                iw = ti
            }
            let elemTy = unwrapVec(lv.ty)
            let ev = genExpr(&mut cg, *args[1], locs, sigs, elemTy)
            return genVecInsert(&mut cg, lv.v, lv.ty, iw, ev)
        }
        if method == "remove" && isVecTy(lv.ty) {
            let iv = genExpr(&mut cg, *args[0], locs, sigs, "i64")
            var iw = iv.v.clone()
            if llType(iv.ty) != "i64" {
                let ti = nextTemp(&mut cg)
                emit(&mut cg, "  " + ti + " = sext " + llType(iv.ty) + " " + iv.v + " to i64\n")
                iw = ti
            }
            return genVecRemove(&mut cg, lv.v, lv.ty, iw)
        }
        if isHashMapTy(lv.ty) {
            let keyTy = hashMapKeyTy(lv.ty)
            if method == "insert" {
                // The map takes ownership of BOTH: move them (genOwnedArg), or the
                // caller's binding drops the same buffer at scope end and the stored
                // key/value dangles — jsonHashmap's keys all came back empty.
                let kvOwned = genOwnedArg(&mut cg, *args[0], keyTy, locs, sigs)
                let valTy = hashMapValTy(lv.ty)
                let vv = genOwnedArg(&mut cg, *args[1], valTy, locs, sigs)
                return genHashMapInsert(&mut cg, lv.v, lv.ty, kvOwned, vv)
            }
            // remove(key) only probes with the key; the caller keeps it.
            let kv = genExpr(&mut cg, *args[0], locs, sigs, keyTy)
            return genHashMapRemove(&mut cg, lv.v, lv.ty, kv)
        }
    }
    // retain(pred) mutates the receiver in place → needs its address, same as
    // insert/remove above.
    if method == "retain" {
        let lv = genLvalue(&mut cg, object, locs, sigs)
        if isVecTy(lv.ty) {
            let clv = genExpr(&mut cg, *args[0], locs, sigs, "")
            return genVecRetain(&mut cg, lv.v, lv.ty, clv)
        }
    }
    // extend(other) grows the receiver in place → needs its address. `other`
    // is consumed by move (genOwnedArg zeroes it if it's a bare local ident),
    // matching push's ownership transfer.
    if method == "extend" {
        let lv = genLvalue(&mut cg, object, locs, sigs)
        if isVecTy(lv.ty) {
            let sv = genOwnedArg(&mut cg, *args[0], lv.ty.clone(), locs, sigs)
            return genVecExtend(&mut cg, lv.v, lv.ty, sv)
        }
    }
    // reserve(n) grows the receiver's buffer in place → needs its address.
    if method == "reserve" {
        let lv = genLvalue(&mut cg, object, locs, sigs)
        if isVecTy(lv.ty) {
            let nv = genExpr(&mut cg, *args[0], locs, sigs, "i64")
            return genVecReserve(&mut cg, lv.v, lv.ty, nv)
        }
    }
    // `.each(fn)` — call the closure once per element, passing the element address
    // (uniform closure ABI: env + by-ptr arg).
    if method == "map" || method == "filter" {
        let ov = genExpr(&mut cg, object, locs, sigs, "")
        if isVecTy(ov.ty) {
            let clv = genExpr(&mut cg, *args[0], locs, sigs, "")
            if method == "filter" {
                let inElem = unwrapVec(resolveTyStr(cg, ov.ty))
                return genVecMapFilter(&mut cg, ov, ov.ty.clone(), inElem, clv, true, locs, sigs)
            }
            // map: result element type = the closure's carried return type
            let r = closureRetOf(clv.ty)
            return genVecMapFilter(&mut cg, ov, "Vec<" + r.clone() + ">", r, clv, false, locs, sigs)
        }
        // Option<T>.map/Result<T,E>.map (there is no Option/Result "filter").
        if method == "map" {
            let enumName = stripPercent(resolveTyStr(cg, stripPercent(ov.ty)))
            let isOptOrRes = variantTagOpt(cg, enumName, "Some").isSome() || variantTagOpt(cg, enumName, "Ok").isSome()
            if isOptOrRes {
                let isResult = variantTagOpt(cg, enumName, "Ok").isSome()
                // Result.map carries the Err payload into the mapped result, so a
                // non-Copy E means the receiver is consumed. Option.map's None side
                // has no payload, so its receiver stays live.
                if isResult {
                    markReceiverMoved(&mut cg, object, locs, sigs)
                }
                return genOptionResultMap(&mut cg, ov, enumName, isResult, *args[0], locs, sigs)
            }
        }
    }
    if method == "find" || method == "any" || method == "all" {
        let ov = genExpr(&mut cg, object, locs, sigs, "")
        if isVecTy(ov.ty) {
            let elem = unwrapVec(resolveTyStr(cg, ov.ty))
            let clv = genExpr(&mut cg, *args[0], locs, sigs, "")
            return genVecFindAnyAll(&mut cg, ov, elem, clv, method)
        }
    }
    // get/first/last -> Option<T>: the total reads.
    if method == "get" || method == "first" || method == "last" {
        let ov = genExpr(&mut cg, object, locs, sigs, "")
        if isVecTy(ov.ty) {
            let elem = unwrapVec(resolveTyStr(cg, ov.ty))
            if method == "get" {
                let iv = genExpr(&mut cg, *args[0], locs, sigs, "i64")
                let iw = widenToI64(&mut cg, iv)
                return genVecGetOpt(&mut cg, ov, elem, method, iw)
            }
            return genVecGetOpt(&mut cg, ov, elem, method, "")
        }
    }
    if method == "min" || method == "max" {
        let ov = genExpr(&mut cg, object, locs, sigs, "")
        if isVecTy(ov.ty) {
            let elem = unwrapVec(resolveTyStr(cg, ov.ty))
            return genVecMinMax(&mut cg, ov, elem, method == "max")
        }
    }
    if method == "indexOf" {
        let ov = genExpr(&mut cg, object, locs, sigs, "")
        if isVecTy(ov.ty) {
            let elem = unwrapVec(resolveTyStr(cg, ov.ty))
            let nv = genExpr(&mut cg, *args[0], locs, sigs, elem.clone())
            return genVecIndexOf(&mut cg, ov, elem, nv)
        }
    }
    if method == "position" {
        let ov = genExpr(&mut cg, object, locs, sigs, "")
        if isVecTy(ov.ty) {
            let clv = genExpr(&mut cg, *args[0], locs, sigs, "")
            return genVecPosition(&mut cg, ov, clv)
        }
    }
    if method == "each" {
        let ov = genExpr(&mut cg, object, locs, sigs, "")
        if isVecTy(ov.ty) {
            let elemLl = llType(unwrapVec(resolveTyStr(cg, ov.ty)))
            let clv = genExpr(&mut cg, *args[0], locs, sigs, "")
            let d = nextTemp(&mut cg)
            emit(&mut cg, "  " + d + " = extractvalue %Vec " + ov.v + ", 0\n")
            let len = nextTemp(&mut cg)
            emit(&mut cg, "  " + len + " = extractvalue %Vec " + ov.v + ", 1\n")
            let fp = nextTemp(&mut cg)
            emit(&mut cg, "  " + fp + " = extractvalue %Closure " + clv.v + ", 0\n")
            let env = nextTemp(&mut cg)
            emit(&mut cg, "  " + env + " = extractvalue %Closure " + clv.v + ", 1\n")
            let iAddr = nextTemp(&mut cg)
            emit(&mut cg, "  " + iAddr + " = alloca i64\n")
            emit(&mut cg, "  store i64 0, ptr " + iAddr + "\n")
            let condLbl = nextLabel(&mut cg, "each.cond")
            let bodyLbl = nextLabel(&mut cg, "each.body")
            let endLbl = nextLabel(&mut cg, "each.end")
            emit(&mut cg, "  br label %" + condLbl + "\n")
            emitLabel(&mut cg, condLbl)
            let i = nextTemp(&mut cg)
            emit(&mut cg, "  " + i + " = load i64, ptr " + iAddr + "\n")
            let lt = nextTemp(&mut cg)
            emit(&mut cg, "  " + lt + " = icmp slt i64 " + i + ", " + len + "\n")
            emit(&mut cg, "  br i1 " + lt + ", label %" + bodyLbl + ", label %" + endLbl + "\n")
            emitLabel(&mut cg, bodyLbl)
            let slot = nextTemp(&mut cg)
            emit(&mut cg, "  " + slot + " = getelementptr " + elemLl + ", ptr " + d + ", i64 " + i + "\n")
            emit(&mut cg, "  call void " + fp + "(ptr " + env + ", ptr " + slot + ")\n")
            let i1 = nextTemp(&mut cg)
            emit(&mut cg, "  " + i1 + " = add i64 " + i + ", 1\n")
            emit(&mut cg, "  store i64 " + i1 + ", ptr " + iAddr + "\n")
            emit(&mut cg, "  br label %" + condLbl + "\n")
            emitLabel(&mut cg, endLbl)
            return Val {
                v: "0", ty: "void"
            }
        }
    }
    // `.len()` — the length word of the receiver's 3-word header (same slot the
    // `.len` field reads, exposed as a method for `vec.len()` call syntax).
    if method == "len" {
        let ov = genExpr(&mut cg, object, locs, sigs, "")
        let oll = llType(ov.ty)
        if isVecTy(ov.ty) || oll == "%String" || isHashMapTy(ov.ty) {
            var container = "%Vec"
            if oll == "%String" {
                container = "%String"
            }
            if isHashMapTy(ov.ty) {
                container = "%HashMap"
            }
            let r = nextTemp(&mut cg)
            emit(&mut cg, "  " + r + " = extractvalue " + container + " " + ov.v + ", 1\n")
            return Val {
                v: r, ty: "i64"
            }
        }
    }
    // `.capacity()` — the cap word of the Vec's 3-word header.
    if method == "capacity" {
        let ov = genExpr(&mut cg, object, locs, sigs, "")
        if isVecTy(ov.ty) {
            let r = nextTemp(&mut cg)
            emit(&mut cg, "  " + r + " = extractvalue %Vec " + ov.v + ", 2\n")
            return Val {
                v: r, ty: "i64"
            }
        }
    }
    // `.swap(i, j)` mutates in place → needs the receiver address.
    if method == "swap" {
        let lv = genLvalue(&mut cg, object, locs, sigs)
        if isVecTy(lv.ty) {
            let elemLl = llType(unwrapVec(lv.ty))
            let ia = genExpr(&mut cg, *args[0], locs, sigs, "i64")
            let ib = genExpr(&mut cg, *args[1], locs, sigs, "i64")
            var iaw = ia.v.clone()
            if llType(ia.ty) != "i64" {
                let ta = nextTemp(&mut cg)
                emit(&mut cg, "  " + ta + " = sext " + llType(ia.ty) + " " + ia.v + " to i64\n")
                iaw = ta
            }
            var ibw = ib.v.clone()
            if llType(ib.ty) != "i64" {
                let tb = nextTemp(&mut cg)
                emit(&mut cg, "  " + tb + " = sext " + llType(ib.ty) + " " + ib.v + " to i64\n")
                ibw = tb
            }
            let dPtr = nextTemp(&mut cg)
            emit(&mut cg, "  " + dPtr + " = getelementptr %Vec, ptr " + lv.v + ", i32 0, i32 0\n")
            let d = nextTemp(&mut cg)
            emit(&mut cg, "  " + d + " = load ptr, ptr " + dPtr + "\n")
            let slotA = nextTemp(&mut cg)
            emit(&mut cg, "  " + slotA + " = getelementptr " + elemLl + ", ptr " + d + ", i64 " + iaw + "\n")
            let slotB = nextTemp(&mut cg)
            emit(&mut cg, "  " + slotB + " = getelementptr " + elemLl + ", ptr " + d + ", i64 " + ibw + "\n")
            let va = nextTemp(&mut cg)
            emit(&mut cg, "  " + va + " = load " + elemLl + ", ptr " + slotA + "\n")
            let vb = nextTemp(&mut cg)
            emit(&mut cg, "  " + vb + " = load " + elemLl + ", ptr " + slotB + "\n")
            emit(&mut cg, "  store " + elemLl + " " + vb + ", ptr " + slotA + "\n")
            emit(&mut cg, "  store " + elemLl + " " + va + ", ptr " + slotB + "\n")
            return Val {
                v: "0", ty: "void"
            }
        }
    }
    // sort()/sortBy(cmp) mutate the Vec's element order in place → need the
    // receiver address, same as sortByKey/swap/insert/remove.
    if method == "sort" {
        let lv = genLvalue(&mut cg, object, locs, sigs)
        if isVecTy(lv.ty) {
            let elemTy = unwrapVec(lv.ty)
            return genVecSort(&mut cg, lv, elemTy)
        }
    }
    if method == "sortBy" {
        let lv = genLvalue(&mut cg, object, locs, sigs)
        if isVecTy(lv.ty) {
            let elemTy = unwrapVec(lv.ty)
            let clv = genExpr(&mut cg, *args[0], locs, sigs, "")
            return genVecSortByCg(&mut cg, lv, elemTy, clv)
        }
    }
    // sortByKey mutates the Vec's element order in place → needs the receiver
    // address, same as swap/insert/remove above.
    if method == "sortByKey" {
        let lv = genLvalue(&mut cg, object, locs, sigs)
        if isVecTy(lv.ty) {
            let elemTy = unwrapVec(lv.ty)
            let clv = genExpr(&mut cg, *args[0], locs, sigs, "")
            let keyTy = closureRetOf(clv.ty)
            return genVecSortByKeyCg(&mut cg, lv, elemTy, keyTy, clv)
        }
    }

    // Option/Result combinators that take a closure and aren't handled above
    // (isSome/isNone/isOk/isErr/unwrapOr live earlier in this function; map is
    // folded into the method=="map" block above). Structural gate — codegen has
    // no baseName table, so "carries a Some/Ok variant" stands in for it, same as
    // the isSome/unwrapOr block already does.
    if method == "andThen" || method == "orElse" || method == "mapErr" || method == "unwrapOrElse" {
        // orElse's Some/Ok branch forwards the receiver's payload into its result, so a
        // non-Copy payload is CONSUMED: load through genOwnedArg so a named receiver's
        // slot is zeroed and the enclosing scope's drop doesn't free a buffer the result
        // now owns. andThen/mapErr/unwrapOrElse hand the payload to the callback BY REF
        // and leave the receiver usable (tests/fixtures/optionAndThen.milo,
        // resultMapErr.milo both read it afterwards) — zeroing there reads back zeros.
        var ov = Val {
            v: "", ty: ""
        }
        if method == "orElse" {
            ov = genOwnedArg(&mut cg, object, "", locs, sigs)
        } else {
            ov = genExpr(&mut cg, object, locs, sigs, "")
        }
        let enumName = stripPercent(resolveTyStr(cg, stripPercent(ov.ty)))
        let isOptOrRes = variantTagOpt(cg, enumName, "Some").isSome() || variantTagOpt(cg, enumName, "Ok").isSome()
        if isOptOrRes {
            let isResult = variantTagOpt(cg, enumName, "Ok").isSome()
            if method == "andThen" {
                return genOptionResultAndThen(&mut cg, ov, enumName, isResult, *args[0], locs, sigs)
            }
            if method == "orElse" {
                return genOptionResultOrElse(&mut cg, ov, enumName, isResult, *args[0], locs, sigs)
            }
            if method == "mapErr" && isResult {
                return genOptionResultMapErr(&mut cg, ov, enumName, *args[0], locs, sigs)
            }
            if method == "unwrapOrElse" {
                return genOptionResultUnwrapOrElse(&mut cg, ov, enumName, *args[0], locs, sigs)
            }
        }
    }

    let obj = genExpr(&mut cg, object, locs, sigs, "")
    let objTyLl = llType(obj.ty)

    // Option/Result queries. The receiver is a monomorphized enum value, so the tag is
    // field 0 and the payload is field 1 — same layout the `!` unwrap path reads.
    if method == "isSome" || method == "isNone" || method == "isOk" || method == "isErr" || method == "unwrapOr" {
        let enumName = stripPercent(resolveTyStr(cg, stripPercent(obj.ty)))
        if cg.enums.contains(enumName) {
            var okVariant = "Some"
            if method == "isOk" || method == "isErr" {
                okVariant = "Ok"
            }
            if method == "unwrapOr" && lookupVariantTag(cg, enumName, "Some") < 0 {
                okVariant = "Ok"
            }
            let okTag = lookupVariantTag(cg, enumName, okVariant)
            if okTag >= 0 {
                let enumTy = "%" + enumName.clone()
                let addr = nextTemp(&mut cg)
                emit(&mut cg, "  " + addr + " = alloca " + enumTy.clone() + "\n")
                emit(&mut cg, "  store " + enumTy.clone() + " " + obj.v.clone() + ", ptr " + addr.clone() + "\n")
                let tagPtr = nextTemp(&mut cg)
                emit(&mut cg, "  " + tagPtr + " = getelementptr " + enumTy.clone() + ", ptr " + addr.clone() + ", i32 0, i32 0\n")
                let tag = nextTemp(&mut cg)
                emit(&mut cg, "  " + tag + " = load i32, ptr " + tagPtr + "\n")
                if method != "unwrapOr" {
                    var cmp = "eq"
                    if method == "isNone" || method == "isErr" {
                        cmp = "ne"
                    }
                    let r = nextTemp(&mut cg)
                    emit(&mut cg, "  " + r + " = icmp " + cmp + " i32 " + tag.clone() + ", " + okTag.toString() + "\n")
                    return Val {
                        v: r, ty: "i1"
                    }
                }
                let payloadTypes = lookupVariantPayload(cg, enumName, okVariant)
                if payloadTypes.len == 1 {
                    let payTy = payloadTypes[0].clone()
                    let payLl = llType(payTy)
                    // The default is evaluated before the branch: `unwrapOr(x)` takes x
                    // eagerly, so evaluating it on the present path too would be wrong.
                    // Hint with the SURFACE payload type ("f32"), not its LLVM spelling
                    // (llType's milo "float" alias for f64 also stringifies to "float",
                    // so an f32 payload's hint collided with that and silently defaulted
                    // a bare default-value literal to f64).
                    let dv = genExpr(&mut cg, *args[0], locs, sigs, payTy.clone())
                    let isOkT = nextTemp(&mut cg)
                    emit(&mut cg, "  " + isOkT + " = icmp eq i32 " + tag.clone() + ", " + okTag.toString() + "\n")
                    let haveLbl = nextLabel(&mut cg, "unwrapor.have")
                    let defLbl = nextLabel(&mut cg, "unwrapor.default")
                    let endLbl = nextLabel(&mut cg, "unwrapor.end")
                    emit(&mut cg, "  br i1 " + isOkT + ", label %" + haveLbl.clone() + ", label %" + defLbl.clone() + "\n")
                    emit(&mut cg, haveLbl.clone() + ":\n")
                    let payPtr = nextTemp(&mut cg)
                    emit(&mut cg, "  " + payPtr + " = getelementptr " + enumTy.clone() + ", ptr " + addr.clone() + ", i32 0, i32 1\n")
                    let fp = nextTemp(&mut cg)
                    emit(&mut cg, "  " + fp + " = getelementptr { " + payLl.clone() + " }, ptr " + payPtr + ", i32 0, i32 0\n")
                    let got = nextTemp(&mut cg)
                    emit(&mut cg, "  " + got + " = load " + payLl.clone() + ", ptr " + fp + "\n")
                    emit(&mut cg, "  br label %" + endLbl.clone() + "\n")
                    emit(&mut cg, defLbl.clone() + ":\n")
                    emit(&mut cg, "  br label %" + endLbl.clone() + "\n")
                    emit(&mut cg, endLbl.clone() + ":\n")
                    let r2 = nextTemp(&mut cg)
                    emit(&mut cg, "  " + r2 + " = phi " + payLl.clone() + " [ " + got + ", %" + haveLbl.clone() + " ], [ " + dv.v.clone() + ", %" + defLbl.clone() + " ]\n")
                    return Val {
                        v: r2, ty: payTy
                    }
                }
            }
        }
    }

    if isHashMapTy(obj.ty) && method == "contains" {
        let kv = genExpr(&mut cg, *args[0], locs, sigs, hashMapKeyTy(obj.ty))
        return genHashMapContains(&mut cg, obj, kv)
    }
    if isHashMapTy(obj.ty) && method == "get" {
        let kv = genExpr(&mut cg, *args[0], locs, sigs, hashMapKeyTy(obj.ty))
        return genHashMapGet(&mut cg, obj, kv)
    }
    if isHashMapTy(obj.ty) && method == "getOrDefault" {
        let kv = genExpr(&mut cg, *args[0], locs, sigs, hashMapKeyTy(obj.ty))
        let dv = genExpr(&mut cg, *args[1], locs, sigs, hashMapValTy(obj.ty))
        return genHashMapGetOrDefault(&mut cg, obj, kv, dv)
    }
    if isHashMapTy(obj.ty) && method == "len" {
        let lenT = nextTemp(&mut cg)
        emit(&mut cg, "  " + lenT + " = extractvalue %HashMap " + obj.v + ", 1\n")
        return Val {
            v: lenT, ty: "i64"
        }
    }
    if isHashMapTy(obj.ty) && method == "isEmpty" {
        let lenT = nextTemp(&mut cg)
        emit(&mut cg, "  " + lenT + " = extractvalue %HashMap " + obj.v + ", 1\n")
        let eq = nextTemp(&mut cg)
        emit(&mut cg, "  " + eq + " = icmp eq i64 " + lenT + ", 0\n")
        return Val {
            v: eq, ty: "bool"
        }
    }
    // `clear`/`truncate` on a Vec: elements at index >= n are OWNED by the Vec, so
    // shortening the length without running their drop glue would leak every
    // string, nested Vec, or Drop-implementing struct above the cut. clear() is
    // truncate(0). The buffer itself is kept — only the length moves, capacity
    // survives (matches pop/remove).
    if (method == "clear" || method == "truncate") && isVecTy(obj.ty) {
        let lv = genLvalue(&mut cg, object, locs, sigs)
        let elemTy = unwrapVec(resolveTyStr(cg, obj.ty))
        var nArg = Val {
            v: "0", ty: "i64"
        }
        if method == "truncate" {
            nArg = genExpr(&mut cg, *args[0], locs, sigs, "i64")
        }
        return genVecTruncateCg(&mut cg, lv, elemTy, nArg)
    }
    // `clear` on a HashMap: length to zero, buffer kept so the capacity survives.
    // Entries are not dropped — HashMap element drop is a known deferred gap
    // (cgNeedsDrop always returns false for HashMap; see drops.milo).
    if method == "clear" && isHashMapTy(obj.ty) {
        let lv = genLvalue(&mut cg, object, locs, sigs)
        let lenPtr = nextTemp(&mut cg)
        emit(&mut cg, "  " + lenPtr + " = getelementptr %HashMap, ptr " + lv.v + ", i32 0, i32 1\n")
        emit(&mut cg, "  store i64 0, ptr " + lenPtr + "\n")
        return Val {
            v: "0", ty: "void"
        }
    }
    // Vec<T>.clone(): a real deep copy. Copying only the {ptr,len,cap} header would alias
    // the original's buffer, so a later push into either one would be visible in both and
    // the two would double-free the same allocation.
    if isVecTy(obj.ty) && method == "clone" && args.len == 0 {
        return genDeepCloneVecVal(&mut cg, obj)
    }
    if isHashMapTy(obj.ty) && method == "clone" && args.len == 0 {
        return genDeepCloneHashMapVal(&mut cg, obj)
    }
    // Vec<T>.contains(x): linear scan. Elements are compared the same way `==` compares
    // them — memcmp for %String, icmp/fcmp for scalars — so a Vec<string> lookup does not
    // silently degrade to pointer identity.
    if isVecTy(obj.ty) && method == "contains" && args.len == 1 {
        let elemTy = unwrapVec(resolveTyStr(cg, obj.ty))
        let elemLl = llType(elemTy.clone())
        // SURFACE elem type, not its LLVM spelling — same "float" alias collision
        // as Vec.filled's fill-value hint.
        let needle = genExpr(&mut cg, *args[0], locs, sigs, elemTy.clone())
        let dataP = nextTemp(&mut cg)
        emit(&mut cg, "  " + dataP + " = extractvalue %Vec " + obj.v.clone() + ", 0\n")
        let lenV = nextTemp(&mut cg)
        emit(&mut cg, "  " + lenV + " = extractvalue %Vec " + obj.v.clone() + ", 1\n")
        let res = nextTemp(&mut cg)
        emit(&mut cg, "  " + res + " = alloca i1\n")
        emit(&mut cg, "  store i1 false, ptr " + res + "\n")
        let ictr = nextTemp(&mut cg)
        emit(&mut cg, "  " + ictr + " = alloca i64\n")
        emit(&mut cg, "  store i64 0, ptr " + ictr + "\n")
        let condL = nextLabel(&mut cg, "vcontains.cond")
        let bodyL = nextLabel(&mut cg, "vcontains.body")
        let hitL = nextLabel(&mut cg, "vcontains.hit")
        let stepL = nextLabel(&mut cg, "vcontains.step")
        let endL = nextLabel(&mut cg, "vcontains.end")
        emit(&mut cg, "  br label %" + condL.clone() + "\n")
        emitLabel(&mut cg, condL)
        let iv = nextTemp(&mut cg)
        emit(&mut cg, "  " + iv + " = load i64, ptr " + ictr + "\n")
        let more = nextTemp(&mut cg)
        emit(&mut cg, "  " + more + " = icmp slt i64 " + iv + ", " + lenV + "\n")
        emit(&mut cg, "  br i1 " + more + ", label %" + bodyL.clone() + ", label %" + endL.clone() + "\n")
        emitLabel(&mut cg, bodyL)
        let slot = nextTemp(&mut cg)
        emit(&mut cg, "  " + slot + " = getelementptr " + elemLl.clone() + ", ptr " + dataP + ", i64 " + iv + "\n")
        let cur = nextTemp(&mut cg)
        emit(&mut cg, "  " + cur + " = load " + elemLl.clone() + ", ptr " + slot + "\n")
        var eqv = ""
        if elemLl == "%String" {
            let r = genStringEq(&mut cg, cur, needle.v.clone(), true)
            eqv = r.v.clone()
        } else if elemLl == "double" || elemLl == "float" {
            let t = nextTemp(&mut cg)
            emit(&mut cg, "  " + t + " = fcmp oeq " + elemLl.clone() + " " + cur + ", " + needle.v.clone() + "\n")
            eqv = t
        } else if intBits(elemLl.clone()) > 0 || elemLl == "ptr" {
            let t = nextTemp(&mut cg)
            emit(&mut cg, "  " + t + " = icmp eq " + elemLl.clone() + " " + cur + ", " + needle.v.clone() + "\n")
            eqv = t
        } else {
            eprint("codegen: Vec.contains on element type " + elemLl.clone() + " is not supported in milo0")
            exit(1)
        }
        emit(&mut cg, "  br i1 " + eqv + ", label %" + hitL.clone() + ", label %" + stepL.clone() + "\n")
        emitLabel(&mut cg, hitL)
        emit(&mut cg, "  store i1 true, ptr " + res + "\n")
        emit(&mut cg, "  br label %" + endL.clone() + "\n")
        emitLabel(&mut cg, stepL)
        let inext = nextTemp(&mut cg)
        emit(&mut cg, "  " + inext + " = add i64 " + iv + ", 1\n")
        emit(&mut cg, "  store i64 " + inext + ", ptr " + ictr + "\n")
        emit(&mut cg, "  br label %" + condL.clone() + "\n")
        emitLabel(&mut cg, endL)
        let out = nextTemp(&mut cg)
        emit(&mut cg, "  " + out + " = load i1, ptr " + res + "\n")
        return Val {
            v: out, ty: "bool"
        }
    }
    // isEmpty(): len == 0. Kept beside len rather than lowered to `.len() == 0` in the
    // checker, because the checker records a type for the isEmpty CALL and a rewrite
    // there would leave that record pointing at a node lowering no longer emits.
    if isVecTy(obj.ty) && method == "isEmpty" {
        let elenT = nextTemp(&mut cg)
        emit(&mut cg, "  " + elenT + " = extractvalue %Vec " + obj.v + ", 1\n")
        let cmpT = nextTemp(&mut cg)
        emit(&mut cg, "  " + cmpT + " = icmp eq i64 " + elenT + ", 0\n")
        return Val {
            v: cmpT, ty: "i1"
        }
    }
    if isVecTy(obj.ty) && method == "len" {
        let lenT = nextTemp(&mut cg)
        emit(&mut cg, "  " + lenT + " = extractvalue %Vec " + obj.v + ", 1\n")
        return Val {
            v: lenT, ty: "i64"
        }
    }
    // fold(init, (acc, elem) => acc) / reduce (same op, alternate spelling): an
    // index walk threading the accumulator through an alloca, calling the
    // closure once per element. EVERY closure param in src-milo's ABI is passed
    // as a pointer regardless of whether the surface type was `T` or `&T`
    // (genClosure's header is unconditionally `ptr %name` — see its comment);
    // the accumulator's own storage IS that pointer, so there is no separate
    // load-before-call the way the oracle's genVecFold does it — passing
    // `accAddr` directly is the same shape find/any/all already use for the
    // element pointer, just reused for the acc slot too.
    if isVecTy(obj.ty) && (method == "fold" || method == "reduce") {
        let elemTy = unwrapVec(resolveTyStr(cg, obj.ty))
        let elemLl = llType(elemTy)
        let initV = genExpr(&mut cg, *args[0], locs, sigs, "")
        let accTy = initV.ty.clone()
        let accLl = llType(accTy)
        let clv = genExpr(&mut cg, *args[1], locs, sigs, "")
        let fp = nextTemp(&mut cg)
        emit(&mut cg, "  " + fp + " = extractvalue %Closure " + clv.v + ", 0\n")
        let env = nextTemp(&mut cg)
        emit(&mut cg, "  " + env + " = extractvalue %Closure " + clv.v + ", 1\n")
        let d = nextTemp(&mut cg)
        emit(&mut cg, "  " + d + " = extractvalue %Vec " + obj.v + ", 0\n")
        let len = nextTemp(&mut cg)
        emit(&mut cg, "  " + len + " = extractvalue %Vec " + obj.v + ", 1\n")
        let accAddr = nextTemp(&mut cg)
        emit(&mut cg, "  " + accAddr + " = alloca " + accLl + "\n")
        emit(&mut cg, "  store " + accLl + " " + initV.v + ", ptr " + accAddr + "\n")
        let iAddr = nextTemp(&mut cg)
        emit(&mut cg, "  " + iAddr + " = alloca i64\n")
        emit(&mut cg, "  store i64 0, ptr " + iAddr + "\n")
        let condLbl = nextLabel(&mut cg, "fold.cond")
        let bodyLbl = nextLabel(&mut cg, "fold.body")
        let endLbl = nextLabel(&mut cg, "fold.end")
        emit(&mut cg, "  br label %" + condLbl + "\n")
        emitLabel(&mut cg, condLbl)
        let i = nextTemp(&mut cg)
        emit(&mut cg, "  " + i + " = load i64, ptr " + iAddr + "\n")
        let lt = nextTemp(&mut cg)
        emit(&mut cg, "  " + lt + " = icmp ult i64 " + i + ", " + len + "\n")
        emit(&mut cg, "  br i1 " + lt + ", label %" + bodyLbl + ", label %" + endLbl + "\n")
        emitLabel(&mut cg, bodyLbl)
        let elemPtr = nextTemp(&mut cg)
        emit(&mut cg, "  " + elemPtr + " = getelementptr " + elemLl + ", ptr " + d + ", i64 " + i + "\n")
        let next = nextTemp(&mut cg)
        emit(&mut cg, "  " + next + " = call " + accLl + " " + fp + "(ptr " + env + ", ptr " + accAddr + ", ptr " + elemPtr + ")\n")
        emit(&mut cg, "  store " + accLl + " " + next + ", ptr " + accAddr + "\n")
        let inext = nextTemp(&mut cg)
        emit(&mut cg, "  " + inext + " = add i64 " + i + ", 1\n")
        emit(&mut cg, "  store i64 " + inext + ", ptr " + iAddr + "\n")
        emit(&mut cg, "  br label %" + condLbl + "\n")
        emitLabel(&mut cg, endLbl)
        let result = nextTemp(&mut cg)
        emit(&mut cg, "  " + result + " = load " + accLl + ", ptr " + accAddr + "\n")
        return Val {
            v: result, ty: accTy
        }
    }
    // sum(): accumulate every element (int or float), no callback.
    if isVecTy(obj.ty) && method == "sum" {
        let elemTy = unwrapVec(resolveTyStr(cg, obj.ty))
        let elemLl = llType(elemTy)
        let isFloatElem = elemLl == "double" || elemLl == "float"
        let d = nextTemp(&mut cg)
        emit(&mut cg, "  " + d + " = extractvalue %Vec " + obj.v + ", 0\n")
        let len = nextTemp(&mut cg)
        emit(&mut cg, "  " + len + " = extractvalue %Vec " + obj.v + ", 1\n")
        let accAddr = nextTemp(&mut cg)
        emit(&mut cg, "  " + accAddr + " = alloca " + elemLl + "\n")
        var initV = "0"
        if isFloatElem {
            initV = "0.0"
        }
        emit(&mut cg, "  store " + elemLl + " " + initV + ", ptr " + accAddr + "\n")
        let iAddr = nextTemp(&mut cg)
        emit(&mut cg, "  " + iAddr + " = alloca i64\n")
        emit(&mut cg, "  store i64 0, ptr " + iAddr + "\n")
        let condLbl = nextLabel(&mut cg, "sum.cond")
        let bodyLbl = nextLabel(&mut cg, "sum.body")
        let endLbl = nextLabel(&mut cg, "sum.end")
        emit(&mut cg, "  br label %" + condLbl + "\n")
        emitLabel(&mut cg, condLbl)
        let i = nextTemp(&mut cg)
        emit(&mut cg, "  " + i + " = load i64, ptr " + iAddr + "\n")
        let lt = nextTemp(&mut cg)
        emit(&mut cg, "  " + lt + " = icmp slt i64 " + i + ", " + len + "\n")
        emit(&mut cg, "  br i1 " + lt + ", label %" + bodyLbl + ", label %" + endLbl + "\n")
        emitLabel(&mut cg, bodyLbl)
        let slot = nextTemp(&mut cg)
        emit(&mut cg, "  " + slot + " = getelementptr " + elemLl + ", ptr " + d + ", i64 " + i + "\n")
        let ev = nextTemp(&mut cg)
        emit(&mut cg, "  " + ev + " = load " + elemLl + ", ptr " + slot + "\n")
        let acc = nextTemp(&mut cg)
        emit(&mut cg, "  " + acc + " = load " + elemLl + ", ptr " + accAddr + "\n")
        let newAcc = nextTemp(&mut cg)
        var addOp = "add"
        if isFloatElem {
            addOp = "fadd"
        }
        emit(&mut cg, "  " + newAcc + " = " + addOp + " " + elemLl + " " + acc + ", " + ev + "\n")
        emit(&mut cg, "  store " + elemLl + " " + newAcc + ", ptr " + accAddr + "\n")
        let i1v = nextTemp(&mut cg)
        emit(&mut cg, "  " + i1v + " = add i64 " + i + ", 1\n")
        emit(&mut cg, "  store i64 " + i1v + ", ptr " + iAddr + "\n")
        emit(&mut cg, "  br label %" + condLbl + "\n")
        emitLabel(&mut cg, endLbl)
        let result = nextTemp(&mut cg)
        emit(&mut cg, "  " + result + " = load " + elemLl + ", ptr " + accAddr + "\n")
        return Val {
            v: result, ty: elemTy
        }
    }
    // join(sep): Vec<string> → concatenate elements with `sep` between them. Grows
    // one result string via in-place append (avoids leaking a fresh buffer per +).
    if isVecTy(obj.ty) && method == "join" {
        let d = nextTemp(&mut cg)
        emit(&mut cg, "  " + d + " = extractvalue %Vec " + obj.v + ", 0\n")
        let len = nextTemp(&mut cg)
        emit(&mut cg, "  " + len + " = extractvalue %Vec " + obj.v + ", 1\n")
        let sepV = genExpr(&mut cg, *args[0], locs, sigs, "string")
        let resAddr = nextTemp(&mut cg)
        emit(&mut cg, "  " + resAddr + " = alloca %String\n")
        let empty = genStringLit(&mut cg, "")
        emit(&mut cg, "  store %String " + empty.v + ", ptr " + resAddr + "\n")
        let iAddr = nextTemp(&mut cg)
        emit(&mut cg, "  " + iAddr + " = alloca i64\n")
        emit(&mut cg, "  store i64 0, ptr " + iAddr + "\n")
        let condLbl = nextLabel(&mut cg, "join.cond")
        let bodyLbl = nextLabel(&mut cg, "join.body")
        let sepLbl = nextLabel(&mut cg, "join.sep")
        let elemLbl = nextLabel(&mut cg, "join.elem")
        let endLbl = nextLabel(&mut cg, "join.end")
        emit(&mut cg, "  br label %" + condLbl + "\n")
        emitLabel(&mut cg, condLbl)
        let i = nextTemp(&mut cg)
        emit(&mut cg, "  " + i + " = load i64, ptr " + iAddr + "\n")
        let lt = nextTemp(&mut cg)
        emit(&mut cg, "  " + lt + " = icmp slt i64 " + i + ", " + len + "\n")
        emit(&mut cg, "  br i1 " + lt + ", label %" + bodyLbl + ", label %" + endLbl + "\n")
        emitLabel(&mut cg, bodyLbl)
        let notFirst = nextTemp(&mut cg)
        emit(&mut cg, "  " + notFirst + " = icmp sgt i64 " + i + ", 0\n")
        emit(&mut cg, "  br i1 " + notFirst + ", label %" + sepLbl + ", label %" + elemLbl + "\n")
        emitLabel(&mut cg, sepLbl)
        genStringAppendInPlace(&mut cg, resAddr, sepV.v)
        emit(&mut cg, "  br label %" + elemLbl + "\n")
        emitLabel(&mut cg, elemLbl)
        let slot = nextTemp(&mut cg)
        emit(&mut cg, "  " + slot + " = getelementptr %String, ptr " + d + ", i64 " + i + "\n")
        let ev = nextTemp(&mut cg)
        emit(&mut cg, "  " + ev + " = load %String, ptr " + slot + "\n")
        genStringAppendInPlace(&mut cg, resAddr, ev)
        let i1v = nextTemp(&mut cg)
        emit(&mut cg, "  " + i1v + " = add i64 " + i + ", 1\n")
        emit(&mut cg, "  store i64 " + i1v + ", ptr " + iAddr + "\n")
        emit(&mut cg, "  br label %" + condLbl + "\n")
        emitLabel(&mut cg, endLbl)
        let out = nextTemp(&mut cg)
        emit(&mut cg, "  " + out + " = load %String, ptr " + resAddr + "\n")
        return Val {
            v: out, ty: "string"
        }
    }
    // keys(): snapshot the HashMap's { K, V } entry array into a fresh Vec<K>.
    if isHashMapTy(obj.ty) && method == "keys" {
        let keyTy = hashMapKeyTy(obj.ty)
        let valTy = hashMapValTy(obj.ty)
        let entryTy = hmEntryTy(keyTy, valTy)
        let keyLl = llType(keyTy)
        let resultVecTy = "Vec<" + keyTy + ">"
        let nv = genVecNew(&mut cg, resultVecTy)
        let vecSlot = nextTemp(&mut cg)
        emit(&mut cg, "  " + vecSlot + " = alloca %Vec\n")
        emit(&mut cg, "  store %Vec " + nv.v + ", ptr " + vecSlot + "\n")
        let data = nextTemp(&mut cg)
        emit(&mut cg, "  " + data + " = extractvalue %HashMap " + obj.v + ", 0\n")
        let count = nextTemp(&mut cg)
        emit(&mut cg, "  " + count + " = extractvalue %HashMap " + obj.v + ", 1\n")
        let iAddr = nextTemp(&mut cg)
        emit(&mut cg, "  " + iAddr + " = alloca i64\n")
        emit(&mut cg, "  store i64 0, ptr " + iAddr + "\n")
        let condLbl = nextLabel(&mut cg, "hmkeys.cond")
        let bodyLbl = nextLabel(&mut cg, "hmkeys.body")
        let endLbl = nextLabel(&mut cg, "hmkeys.end")
        emit(&mut cg, "  br label %" + condLbl + "\n")
        emitLabel(&mut cg, condLbl)
        let i = nextTemp(&mut cg)
        emit(&mut cg, "  " + i + " = load i64, ptr " + iAddr + "\n")
        let lt = nextTemp(&mut cg)
        emit(&mut cg, "  " + lt + " = icmp slt i64 " + i + ", " + count + "\n")
        emit(&mut cg, "  br i1 " + lt + ", label %" + bodyLbl + ", label %" + endLbl + "\n")
        emitLabel(&mut cg, bodyLbl)
        let slot = nextTemp(&mut cg)
        emit(&mut cg, "  " + slot + " = getelementptr " + entryTy + ", ptr " + data + ", i64 " + i + "\n")
        let kp = nextTemp(&mut cg)
        emit(&mut cg, "  " + kp + " = getelementptr " + entryTy + ", ptr " + slot + ", i32 0, i32 0\n")
        let k = nextTemp(&mut cg)
        emit(&mut cg, "  " + k + " = load " + keyLl + ", ptr " + kp + "\n")
        let kc = genCloneOfLoaded(&mut cg, k, keyTy)
        genVecPush(&mut cg, vecSlot, resultVecTy, Val {
            v: kc, ty: keyTy.clone()
        })
        let i1v = nextTemp(&mut cg)
        emit(&mut cg, "  " + i1v + " = add i64 " + i + ", 1\n")
        emit(&mut cg, "  store i64 " + i1v + ", ptr " + iAddr + "\n")
        emit(&mut cg, "  br label %" + condLbl + "\n")
        emitLabel(&mut cg, endLbl)
        let out = nextTemp(&mut cg)
        emit(&mut cg, "  " + out + " = load %Vec, ptr " + vecSlot + "\n")
        return Val {
            v: out, ty: resultVecTy
        }
    }
    // values(): same snapshot-into-a-Vec walk as keys() above, reading the
    // entry's second field (index 1) instead of the first.
    if isHashMapTy(obj.ty) && method == "values" {
        let keyTy = hashMapKeyTy(obj.ty)
        let valTy = hashMapValTy(obj.ty)
        let entryTy = hmEntryTy(keyTy, valTy)
        let valLl = llType(valTy)
        let resultVecTy = "Vec<" + valTy + ">"
        let nv = genVecNew(&mut cg, resultVecTy)
        let vecSlot = nextTemp(&mut cg)
        emit(&mut cg, "  " + vecSlot + " = alloca %Vec\n")
        emit(&mut cg, "  store %Vec " + nv.v + ", ptr " + vecSlot + "\n")
        let data = nextTemp(&mut cg)
        emit(&mut cg, "  " + data + " = extractvalue %HashMap " + obj.v + ", 0\n")
        let count = nextTemp(&mut cg)
        emit(&mut cg, "  " + count + " = extractvalue %HashMap " + obj.v + ", 1\n")
        let iAddr = nextTemp(&mut cg)
        emit(&mut cg, "  " + iAddr + " = alloca i64\n")
        emit(&mut cg, "  store i64 0, ptr " + iAddr + "\n")
        let condLbl = nextLabel(&mut cg, "hmvals.cond")
        let bodyLbl = nextLabel(&mut cg, "hmvals.body")
        let endLbl = nextLabel(&mut cg, "hmvals.end")
        emit(&mut cg, "  br label %" + condLbl + "\n")
        emitLabel(&mut cg, condLbl)
        let i = nextTemp(&mut cg)
        emit(&mut cg, "  " + i + " = load i64, ptr " + iAddr + "\n")
        let lt = nextTemp(&mut cg)
        emit(&mut cg, "  " + lt + " = icmp slt i64 " + i + ", " + count + "\n")
        emit(&mut cg, "  br i1 " + lt + ", label %" + bodyLbl + ", label %" + endLbl + "\n")
        emitLabel(&mut cg, bodyLbl)
        let slot = nextTemp(&mut cg)
        emit(&mut cg, "  " + slot + " = getelementptr " + entryTy + ", ptr " + data + ", i64 " + i + "\n")
        let vp = nextTemp(&mut cg)
        emit(&mut cg, "  " + vp + " = getelementptr " + entryTy + ", ptr " + slot + ", i32 0, i32 1\n")
        let v = nextTemp(&mut cg)
        emit(&mut cg, "  " + v + " = load " + valLl + ", ptr " + vp + "\n")
        let vc = genCloneOfLoaded(&mut cg, v, valTy)
        genVecPush(&mut cg, vecSlot, resultVecTy, Val {
            v: vc, ty: valTy.clone()
        })
        let i1v = nextTemp(&mut cg)
        emit(&mut cg, "  " + i1v + " = add i64 " + i + ", 1\n")
        emit(&mut cg, "  store i64 " + i1v + ", ptr " + iAddr + "\n")
        emit(&mut cg, "  br label %" + condLbl + "\n")
        emitLabel(&mut cg, endLbl)
        let out = nextTemp(&mut cg)
        emit(&mut cg, "  " + out + " = load %Vec, ptr " + vecSlot + "\n")
        return Val {
            v: out, ty: resultVecTy
        }
    }
    if objTyLl == "%String" && method == "clone" {
        return genStringClone(&mut cg, obj.v)
    }
    // Heap<T>.clone() — deep-copy the box (recursive enums rely on this)
    if method == "clone" && unwrapHeap(obj.ty).len > 0 {
        return genHeapClone(&mut cg, obj.v, obj.ty)
    }
    if objTyLl == "%String" && (method == "substr" || method == "slice") {
        // The "i64" hint above only steers a bare LITERAL's inferred width — an
        // i32 local passed as `a`/`b` (e.g. `s[a..b]` with `var a: i32`) still
        // comes back i32 from genExpr, and genStringSlice's `sub i64 av, bv`
        // then mismatches its own instruction's type. widenToI64 (already used
        // by the Vec.slice case right below) makes both sides actually i64.
        let a = genExpr(&mut cg, *args[0], locs, sigs, "i64")
        let aI = widenToI64(&mut cg, a)
        let b = genExpr(&mut cg, *args[1], locs, sigs, "i64")
        // `method` reaches genStringSlice so its range-check panic can name the
        // operation the user actually wrote ("substr range out of bounds" vs
        // "slice range out of bounds") instead of guessing.
        let bI = widenToI64(&mut cg, b)
        return genStringSlice(&mut cg, obj.v, aI, bI, method)
    }
    // v[a..b] → v.slice(a,b): a non-owning %Vec view {data+a*esz, b-a, cap=0}. milo0
    // never auto-frees Vec buffers (only user Drop$drop), so a cap=0 alias is safe.
    if isVecTy(obj.ty) && method == "slice" {
        let elemTy = unwrapVec(resolveTyStr(cg, obj.ty))
        let elemLl = llType(elemTy)
        let dataP = nextTemp(&mut cg)
        emit(&mut cg, "  " + dataP + " = extractvalue %Vec " + obj.v + ", 0\n")
        let a = genExpr(&mut cg, *args[0], locs, sigs, "i64")
        let aI = widenToI64(&mut cg, a)
        let b = genExpr(&mut cg, *args[1], locs, sigs, "i64")
        let bI = widenToI64(&mut cg, b)
        let off = nextTemp(&mut cg)
        emit(&mut cg, "  " + off + " = getelementptr " + elemLl + ", ptr " + dataP + ", i64 " + aI + "\n")
        let newLen = nextTemp(&mut cg)
        emit(&mut cg, "  " + newLen + " = sub i64 " + bI + ", " + aI + "\n")
        let v0 = nextTemp(&mut cg)
        emit(&mut cg, "  " + v0 + " = insertvalue %Vec undef, ptr " + off + ", 0\n")
        let v1 = nextTemp(&mut cg)
        emit(&mut cg, "  " + v1 + " = insertvalue %Vec " + v0 + ", i64 " + newLen + ", 1\n")
        let v2 = nextTemp(&mut cg)
        emit(&mut cg, "  " + v2 + " = insertvalue %Vec " + v1 + ", i64 0, 2\n")
        return Val {
            v: v2, ty: obj.ty.clone()
        }
    }
    if objTyLl == "%String" && method == "cstr" {
        let p = nextTemp(&mut cg)
        emit(&mut cg, "  " + p + " = extractvalue %String " + obj.v + ", 0\n")
        return Val {
            v: p, ty: "ptr"
        }
    }
    // .indexOf(needle)/.lastIndexOf(needle) -> Option<i64>: call strIndexOf /
    // strLastIndexOf (already in std/string.milo, prelude-visible), then wrap
    // the -1 sentinel as None/Some. Same shape as .indexOfFrom just below —
    // the checker now declares Option<i64> for these too, so codegen has to
    // actually build one instead of falling through to the generic strXxx
    // dispatch (which just forwards the raw i64).
    if objTyLl == "%String" && (method == "indexOf" || method == "lastIndexOf") {
        let recvLv = genLvalue(&mut cg, object, locs, sigs)
        let needleLv = genLvalue(&mut cg, *args[0], locs, sigs)
        var rfn = "strIndexOf"
        if method == "lastIndexOf" {
            rfn = "strLastIndexOf"
        }
        let idx = nextTemp(&mut cg)
        emit(&mut cg, "  " + idx + " = call i64 @" + rfn + "(ptr " + recvLv.v + ", ptr " + needleLv.v + ")\n")

        let optName = stripPercent(resolveTyStr(cg, "Option<i64>"))
        let optTy = "%" + optName
        let someTag = lookupVariantTag(cg, optName, "Some")
        let noneTag = lookupVariantTag(cg, optName, "None")
        let resAddr = nextTemp(&mut cg)
        emit(&mut cg, "  " + resAddr + " = alloca " + optTy + "\n")
        let tagPtr = nextTemp(&mut cg)
        emit(&mut cg, "  " + tagPtr + " = getelementptr " + optTy + ", ptr " + resAddr + ", i32 0, i32 0\n")
        let found = nextTemp(&mut cg)
        emit(&mut cg, "  " + found + " = icmp sge i64 " + idx + ", 0\n")
        let someLbl = nextLabel(&mut cg, "str.idx.some")
        let noneLbl = nextLabel(&mut cg, "str.idx.none")
        let endLbl = nextLabel(&mut cg, "str.idx.end")
        emit(&mut cg, "  br i1 " + found + ", label %" + someLbl + ", label %" + noneLbl + "\n")
        emit(&mut cg, noneLbl + ":\n")
        emit(&mut cg, "  store i32 " + noneTag.toString() + ", ptr " + tagPtr + "\n")
        emit(&mut cg, "  br label %" + endLbl + "\n")
        emit(&mut cg, someLbl + ":\n")
        emit(&mut cg, "  store i32 " + someTag.toString() + ", ptr " + tagPtr + "\n")
        let payPtr = nextTemp(&mut cg)
        emit(&mut cg, "  " + payPtr + " = getelementptr " + optTy + ", ptr " + resAddr + ", i32 0, i32 1\n")
        emit(&mut cg, "  store i64 " + idx + ", ptr " + payPtr + "\n")
        emit(&mut cg, "  br label %" + endLbl + "\n")
        emit(&mut cg, endLbl + ":\n")
        let r = nextTemp(&mut cg)
        emit(&mut cg, "  " + r + " = load " + optTy + ", ptr " + resAddr + "\n")
        return Val {
            v: r, ty: optName
        }
    }
    if objTyLl == "%String" && method == "indexOfFrom" {
        let recvLv = genLvalue(&mut cg, object, locs, sigs)
        let needleLv = genLvalue(&mut cg, *args[0], locs, sigs)
        let fromVal = genExpr(&mut cg, *args[1], locs, sigs, "i64")
        let fromI = widenToI64(&mut cg, fromVal)
        let idx = nextTemp(&mut cg)
        emit(&mut cg, "  " + idx + " = call i64 @strIndexOfFrom(ptr " + recvLv.v + ", ptr " + needleLv.v + ", i64 " + fromI + ")\n")

        let optName = stripPercent(resolveTyStr(cg, "Option<i64>"))
        let optTy = "%" + optName
        let someTag = lookupVariantTag(cg, optName, "Some")
        let noneTag = lookupVariantTag(cg, optName, "None")
        let resAddr = nextTemp(&mut cg)
        emit(&mut cg, "  " + resAddr + " = alloca " + optTy + "\n")
        let tagPtr = nextTemp(&mut cg)
        emit(&mut cg, "  " + tagPtr + " = getelementptr " + optTy + ", ptr " + resAddr + ", i32 0, i32 0\n")
        let found = nextTemp(&mut cg)
        emit(&mut cg, "  " + found + " = icmp sge i64 " + idx + ", 0\n")
        let someLbl = nextLabel(&mut cg, "str.idxfrom.some")
        let noneLbl = nextLabel(&mut cg, "str.idxfrom.none")
        let endLbl = nextLabel(&mut cg, "str.idxfrom.end")
        emit(&mut cg, "  br i1 " + found + ", label %" + someLbl + ", label %" + noneLbl + "\n")
        emit(&mut cg, noneLbl + ":\n")
        emit(&mut cg, "  store i32 " + noneTag.toString() + ", ptr " + tagPtr + "\n")
        emit(&mut cg, "  br label %" + endLbl + "\n")
        emit(&mut cg, someLbl + ":\n")
        emit(&mut cg, "  store i32 " + someTag.toString() + ", ptr " + tagPtr + "\n")
        let payPtr = nextTemp(&mut cg)
        emit(&mut cg, "  " + payPtr + " = getelementptr " + optTy + ", ptr " + resAddr + ", i32 0, i32 1\n")
        emit(&mut cg, "  store i64 " + idx + ", ptr " + payPtr + "\n")
        emit(&mut cg, "  br label %" + endLbl + "\n")
        emit(&mut cg, endLbl + ":\n")
        let r = nextTemp(&mut cg)
        emit(&mut cg, "  " + r + " = load " + optTy + ", ptr " + resAddr + "\n")
        return Val {
            v: r, ty: optName
        }
    }
    if objTyLl == "%Vec" && method == "ptr" {
        let p = nextTemp(&mut cg)
        emit(&mut cg, "  " + p + " = extractvalue %Vec " + obj.v + ", 0\n")
        // *T, not the bare "ptr" placeholder: Vec<*u8>.ptr() must come back **u8
        // (one MORE star than the element already carries), or a second index/
        // deref through the result has no element type to work with — genIndex's
        // raw-pointer branch strips exactly one leading '*' off `o.ty` and needs
        // a real type string underneath, not the depth-erased "ptr".
        let elemTy = unwrapVec(resolveTyStr(cg, obj.ty))
        return Val {
            v: p, ty: "*" + elemTy
        }
    }
    if objTyLl == "%String" && method == "len" {
        let lenT = nextTemp(&mut cg)
        emit(&mut cg, "  " + lenT + " = extractvalue %String " + obj.v + ", 1\n")
        return Val {
            v: lenT, ty: "i64"
        }
    }
    if intBits(objTyLl) > 0 && (method == "checkedAdd" || method == "checkedSub" || method == "checkedMul") {
        let av = genExpr(&mut cg, *args[0], locs, sigs, obj.ty.clone())
        return genCheckedArith(&mut cg, obj, method, av)
    }
    if intBits(objTyLl) > 0 && (method == "checkedDiv" || method == "checkedRem") {
        let av = genExpr(&mut cg, *args[0], locs, sigs, obj.ty.clone())
        return genCheckedDivRem(&mut cg, obj, method, av)
    }
    if intBits(objTyLl) > 0 && (method == "wrappingAdd" || method == "wrappingSub" || method == "wrappingMul" || method == "saturatingAdd" || method == "saturatingSub" || method == "saturatingMul") {
        let av = genExpr(&mut cg, *args[0], locs, sigs, obj.ty.clone())
        return genWrapSatArith(&mut cg, obj, method, av)
    }
    // x.wrappingNeg() / x.checkedNeg() → wrapping/checked sub(0, x); reuses the
    // existing sub codegen with a synthesized zero on the left (mirrors src/lower.ts).
    if intBits(objTyLl) > 0 && method == "wrappingNeg" {
        let zero = Val {
            v: "0", ty: obj.ty.clone()
        }
        return genWrapSatArith(&mut cg, zero, "wrappingSub", obj)
    }
    if intBits(objTyLl) > 0 && method == "checkedNeg" {
        let zero = Val {
            v: "0", ty: obj.ty.clone()
        }
        return genCheckedArith(&mut cg, zero, "checkedSub", obj)
    }
    if intBits(objTyLl) > 0 && (method == "countOnes" || method == "leadingZeros" || method == "trailingZeros" || method == "reverseBits") {
        return genBitIntrinsic(&mut cg, obj, method)
    }
    if objTyLl == "i1" && method == "toString" {
        let t = genStringLit(&mut cg, "true")
        let f = genStringLit(&mut cg, "false")
        let r = nextTemp(&mut cg)
        emit(&mut cg, "  " + r + " = select i1 " + obj.v + ", %String " + t.v + ", %String " + f.v + "\n")
        return Val {
            v: r, ty: "string"
        }
    }
    // Rotate via the funnel-shift intrinsics: fshl/fshr with both operands set to the
    // same value IS a rotate, and LLVM lowers it to the single machine instruction.
    if method == "rotateLeft" || method == "rotateRight" {
        if intBits(objTyLl.clone()) > 0 {
            let w = objTyLl.clone()
            let av = genExpr(&mut cg, *args[0], locs, sigs, w.clone())
            var amt = av.v.clone()
            // The shift amount must match the value's width or LLVM rejects the call.
            let avLl = llType(av.ty)
            if avLl != w {
                let c = nextTemp(&mut cg)
                var castOp = "zext"
                if intBits(avLl.clone()) > intBits(w.clone()) {
                    castOp = "trunc"
                }
                emit(&mut cg, "  " + c + " = " + castOp + " " + avLl.clone() + " " + av.v + " to " + w.clone() + "\n")
                amt = c
            }
            var shiftFn = "llvm.fshl."
            if method == "rotateRight" {
                shiftFn = "llvm.fshr."
            }
            let intr = shiftFn + w.clone()
            var declared = false
            for i in 0..cg.emittedThunks.len {
                if cg.emittedThunks[i] == intr {
                    declared = true
                }
            }
            if !declared {
                cg.emittedThunks.push(intr.clone())
                emitG(&mut cg, "declare " + w.clone() + " @" + intr.clone() + "(" + w.clone() + ", " + w.clone() + ", " + w.clone() + ")\n")
            }
            let r = nextTemp(&mut cg)
            emit(&mut cg, "  " + r + " = call " + w.clone() + " @" + intr.clone() + "(" + w.clone() + " " + obj.v.clone() + ", " + w.clone() + " " + obj.v.clone() + ", " + w.clone() + " " + amt + ")\n")
            return Val {
                v: r, ty: obj.ty.clone()
            }
        }
    }
    if objTyLl == "i64" && method == "toString" {
        return genIntToString(&mut cg, obj.v, isUnsigned(obj.ty))
    }
    if objTyLl == "double" && method == "toString" {
        return genFloatToString(&mut cg, obj.v)
    }
    // f32 round-trips at f32 precision, not the promoted double's (floatRoundTrip) —
    // genFloat32ToString already existed for f-string interpolation but was never
    // wired into method-call dispatch, so `f.toString()` on an f32 fell through to
    // "unsupported method" once float literals could actually type as f32.
    if objTyLl == "float" && method == "toString" {
        return genFloat32ToString(&mut cg, obj.v)
    }
    // i8/i16/i32 (and their unsigned forms) → widen to i64 then format. Unsigned
    // types zero-extend so e.g. a u8 of 200 prints 200, not -56.
    if method == "toString" && (objTyLl == "i8" || objTyLl == "i16" || objTyLl == "i32") {
        let w = nextTemp(&mut cg)
        var op = "sext"
        if isUnsigned(obj.ty) {
            op = "zext"
        }
        emit(&mut cg, "  " + w + " = " + op + " " + objTyLl + " " + obj.v + " to i64\n")
        return genIntToString(&mut cg, w, false)
    }
    // Interface (trait-object) dispatch: obj is a `%Iface {ptr data, ptr itable}`
    // fat pointer. Extract data + itable, load the method's itable slot, call it with
    // data as the receiver.
    let recvName0 = stripPercent(resolveTyStr(cg, stripPercent(obj.ty)))
    if cg.interfaces.contains(recvName0) {
        let ifTy = "%" + recvName0.clone()
        let slot = lookupFieldIndex(cg, recvName0, method)
        let retTy = lookupFieldType(cg, recvName0, slot)
        let retLl = llType(retTy)
        let dataP = nextTemp(&mut cg)
        emit(&mut cg, "  " + dataP + " = extractvalue " + ifTy + " " + obj.v + ", 0\n")
        let itabP = nextTemp(&mut cg)
        emit(&mut cg, "  " + itabP + " = extractvalue " + ifTy + " " + obj.v + ", 1\n")
        // itable is an array of fn pointers; load slot `slot`
        let mslotP = nextTemp(&mut cg)
        emit(&mut cg, "  " + mslotP + " = getelementptr ptr, ptr " + itabP + ", i64 " + slot.toString() + "\n")
        let mfn = nextTemp(&mut cg)
        emit(&mut cg, "  " + mfn + " = load ptr, ptr " + mslotP + "\n")
        var argStr = "ptr " + dataP
        for ai in 0..args.len {
            let av = genExpr(&mut cg, *args[ai], locs, sigs, "")
            argStr = argStr + ", " + llType(av.ty) + " " + av.v
        }
        if retLl == "void" {
            emit(&mut cg, "  call void " + mfn + "(" + argStr + ")\n")
            return Val {
                v: "0", ty: "void"
            }
        }
        let t = nextTemp(&mut cg)
        emit(&mut cg, "  " + t + " = call " + retLl + " " + mfn + "(" + argStr + ")\n")
        return Val {
            v: t, ty: retTy
        }
    }

    // User-defined methods via impl tables: Ty$m or Ty$Trait$m; the receiver
    // is passed by value first (milo0's ref-param convention)
    let recvName = stripPercent(resolveTyStr(cg, stripPercent(obj.ty)))
    var userFn = recvName.clone() + "$" + method.clone()
    if !cg.fnRets.contains(userFn) {
        for k, v in cg.fnRets {
            if k.startsWith(recvName + "$") && k.endsWith("$" + method) {
                userFn = k.clone()
            }
        }
    }
    if cg.fnRets.contains(userFn) {
        // The method's param ref-ness decides which args (incl. self) pass by
        // address vs value — self is param 0.
        var mRefs: Vec<bool> = Vec.new()
        var mHints: Vec<string> = Vec.new()
        for si in 0..sigs.len {
            if sigs[si].name == userFn {
                for pi in 0..sigs[si].paramRefs.len {
                    mRefs.push(sigs[si].paramRefs[pi])
                }
                for pi in 0..sigs[si].paramTys.len {
                    mHints.push(resolveTyStr(cg, sigs[si].paramTys[pi]))
                }
            }
        }
        var selfIsRef = false
        if mRefs.len > 0 {
            selfIsRef = mRefs[0]
        }
        var argStr = ""
        if selfIsRef {
            if isSimpleLvalue(object) {
                let slv = genLvalue(&mut cg, object, locs, sigs)
                argStr = "ptr " + slv.v
            } else {
                // a non-lvalue receiver (e.g. `foo(x).method()`) was already evaluated
                // into `obj`; materialize it rather than re-running the side-effecting
                // receiver expression a second time.
                let tmp = nextTemp(&mut cg)
                emit(&mut cg, "  " + tmp + " = alloca " + llType(obj.ty) + "\n")
                emit(&mut cg, "  store " + llType(obj.ty) + " " + obj.v + ", ptr " + tmp + "\n")
                argStr = "ptr " + tmp
            }
        } else {
            // A by-value `self` param TAKES the receiver (`fn under(self: JsonError, …)`):
            // record the move so the caller's scope teardown does not drop a value the
            // callee already owns and dropped.
            argStr = llType(obj.ty) + " " + obj.v
            markReceiverMoved(&mut cg, object, locs, sigs)
        }
        for ai in 0..args.len {
            var aRef = false
            if (ai + 1) < mRefs.len {
                aRef = mRefs[ai + 1]
            }
            var mhRef = ""
            if (ai + 1) < mHints.len {
                mhRef = mHints[ai + 1].clone()
            }
            if aRef {
                let alv = genLvalueWithHint(&mut cg, *args[ai], locs, sigs, mhRef)
                argStr = argStr + ", ptr " + alv.v
            } else {
                // by-value method param takes ownership → move (unless `*T` decay)
                var mh = ""
                if (ai + 1) < mHints.len {
                    mh = mHints[ai + 1].clone()
                }
                var av = Val {
                    v: "", ty: ""
                }
                if mh.len > 0 && mh[0] != 42 {
                    av = genOwnedArg(&mut cg, *args[ai], "", locs, sigs)
                } else {
                    av = genExpr(&mut cg, *args[ai], locs, sigs, "")
                }
                // `sink.json(entry)` — see genJsonToStringVal's doc comment.
                if method == "json" && stripPercent(mh) == "string" && llType(av.ty) != "%String" {
                    let argStructName = stripPercent(resolveTyStr(cg, stripPercent(av.ty)))
                    if cg.structs.contains(argStructName) {
                        av = genJsonToStringVal(&mut cg, av, locs, sigs)
                    }
                }
                argStr = argStr + ", " + llType(av.ty) + " " + av.v
            }
        }
        let retTy = resolveTyStr(cg, lookupFnRet(cg, userFn))
        let retLl = llType(retTy)
        if retLl == "void" {
            emit(&mut cg, "  call void @" + userFn + "(" + argStr + ")\n")
            return Val {
                v: "0", ty: "void"
            }
        }
        let t = nextTemp(&mut cg)
        emit(&mut cg, "  " + t + " = call " + retLl + " @" + userFn + "(" + argStr + ")\n")
        return Val {
            v: t, ty: retTy
        }
    }

    // fn-typed struct field called like a method: h.apply(x). The field holds a
    // %Closure {fnptr, env}; extract and do an indirect call (uniform args-by-ptr).
    if cg.structs.contains(recvName) {
        let fields = cg.structs.get(recvName)!
        var fidx: i64 = -1
        var fieldTy = ""
        for fi in 0..fields.len {
            if fields[fi].name == method {
                fidx = fi
                fieldTy = fields[fi].ty.clone()
            }
        }
        if fidx >= 0 && llType(fieldTy) == "%Closure" {
            let clv = nextTemp(&mut cg)
            emit(&mut cg, "  " + clv + " = extractvalue " + llType(obj.ty) + " " + obj.v + ", " + fidx.toString() + "\n")
            let fp = nextTemp(&mut cg)
            emit(&mut cg, "  " + fp + " = extractvalue %Closure " + clv + ", 0\n")
            let env = nextTemp(&mut cg)
            emit(&mut cg, "  " + env + " = extractvalue %Closure " + clv + ", 1\n")
            var argStr = "ptr " + env
            for ai in 0..args.len {
                let alv = genLvalue(&mut cg, *args[ai], locs, sigs)
                argStr = argStr + ", ptr " + alv.v
            }
            var retTyStr = closureRetOf(fieldTy)
            if retTyStr.len == 0 {
                // The field's type did not carry a return type ("fn" rather than
                // "fn:<ret>"). Defaulting to i64 does not make the closure return an
                // integer — it makes the call site READ whatever it returned as one, so a
                // String comes back as a pointer-sized integer and every use of it is
                // garbage. There is no safe guess here.
                eprint("internal error: closure field of type '" + fieldTy.clone() + "' carries no return type, so its call result cannot be typed")
                unsafe {
                    exit(1)
                }
            }
            let retTyResolved = resolveTyStr(cg, retTyStr)
            let retLl = llType(retTyResolved)
            if retLl == "void" {
                emit(&mut cg, "  call void " + fp + "(" + argStr + ")\n")
                return Val {
                    v: "0", ty: "void"
                }
            }
            let t = nextTemp(&mut cg)
            emit(&mut cg, "  " + t + " = call " + retLl + " " + fp + "(" + argStr + ")\n")
            return Val {
                v: t, ty: retTyResolved
            }
        }
    }

    // String methods are sugar for std/string free functions (`s.trim()` ->
    // `s.trim()`): the name is `str` + Capitalized(method), receiver passed as
    // the first arg. parseInt/toInt alias strParseInt; parseF64 is a strtod call.
    if objTyLl == "%String" {
        if method == "parseF64" || method == "parseFloat" || method == "toFloat" {
            // TOTAL parse: strtod alone answers 0 for garbage and stops happily at the
            // first bad character, so "abc" and "0" were indistinguishable and "3.14.5"
            // silently became 3.14. Pass an endptr and demand it reached the end of a
            // non-empty string; otherwise the answer is None.
            ensureStrtod(&mut cg)
            ensureStringTy(&mut cg)
            let dp = nextTemp(&mut cg)
            emit(&mut cg, "  " + dp + " = extractvalue %String " + obj.v.clone() + ", 0\n")
            let slen = nextTemp(&mut cg)
            emit(&mut cg, "  " + slen + " = extractvalue %String " + obj.v.clone() + ", 1\n")
            let endSlot = nextTemp(&mut cg)
            emit(&mut cg, "  " + endSlot + " = alloca ptr\n")
            let r = nextTemp(&mut cg)
            emit(&mut cg, "  " + r + " = call double @strtod(ptr " + dp + ", ptr " + endSlot + ")\n")
            let endP = nextTemp(&mut cg)
            emit(&mut cg, "  " + endP + " = load ptr, ptr " + endSlot + "\n")
            let startI = nextTemp(&mut cg)
            emit(&mut cg, "  " + startI + " = ptrtoint ptr " + dp + " to i64\n")
            let endI = nextTemp(&mut cg)
            emit(&mut cg, "  " + endI + " = ptrtoint ptr " + endP + " to i64\n")
            let used = nextTemp(&mut cg)
            emit(&mut cg, "  " + used + " = sub i64 " + endI + ", " + startI + "\n")
            let allUsed = nextTemp(&mut cg)
            emit(&mut cg, "  " + allUsed + " = icmp eq i64 " + used + ", " + slen + "\n")
            let nonEmpty = nextTemp(&mut cg)
            emit(&mut cg, "  " + nonEmpty + " = icmp sgt i64 " + slen + ", 0\n")
            // strtod also SKIPS leading whitespace, so " 1.2" consumed every byte and
            // looked total. Reject a leading blank explicitly.
            let b0 = nextTemp(&mut cg)
            emit(&mut cg, "  " + b0 + " = load i8, ptr " + dp + "\n")
            let isSp = nextTemp(&mut cg)
            emit(&mut cg, "  " + isSp + " = icmp eq i8 " + b0 + ", 32\n")
            let isTab = nextTemp(&mut cg)
            emit(&mut cg, "  " + isTab + " = icmp eq i8 " + b0 + ", 9\n")
            let isNl = nextTemp(&mut cg)
            emit(&mut cg, "  " + isNl + " = icmp eq i8 " + b0 + ", 10\n")
            let isCr = nextTemp(&mut cg)
            emit(&mut cg, "  " + isCr + " = icmp eq i8 " + b0 + ", 13\n")
            let ws1 = nextTemp(&mut cg)
            emit(&mut cg, "  " + ws1 + " = or i1 " + isSp + ", " + isTab + "\n")
            let ws2 = nextTemp(&mut cg)
            emit(&mut cg, "  " + ws2 + " = or i1 " + isNl + ", " + isCr + "\n")
            let anyWs = nextTemp(&mut cg)
            emit(&mut cg, "  " + anyWs + " = or i1 " + ws1 + ", " + ws2 + "\n")
            let notWs = nextTemp(&mut cg)
            emit(&mut cg, "  " + notWs + " = xor i1 " + anyWs + ", true\n")
            let okLen = nextTemp(&mut cg)
            emit(&mut cg, "  " + okLen + " = and i1 " + allUsed + ", " + nonEmpty + "\n")
            let okBoth = nextTemp(&mut cg)
            emit(&mut cg, "  " + okBoth + " = and i1 " + okLen + ", " + notWs + "\n")

            // The monomorphized Option the checker will have registered for this call.
            // If it is absent the program never used an Option<f64>, so fall back to the
            // bare double rather than referencing a type that was never declared.
            let optName = "Option_f64"
            if !cg.enums.contains(optName) {
                return Val {
                    v: r, ty: "double"
                }
            }
            let optTy = "%" + optName.clone()
            let slot = nextTemp(&mut cg)
            emit(&mut cg, "  " + slot + " = alloca " + optTy.clone() + "\n")
            let someLbl = nextLabel(&mut cg, "parse.some")
            let noneLbl = nextLabel(&mut cg, "parse.none")
            let endLbl = nextLabel(&mut cg, "parse.end")
            emit(&mut cg, "  br i1 " + okBoth + ", label %" + someLbl.clone() + ", label %" + noneLbl.clone() + "\n")
            emit(&mut cg, someLbl.clone() + ":\n")
            let rv = Val {
                v: r, ty: "f64"
            }
            let someV = genWrapSome(&mut cg, rv, optName)
            emit(&mut cg, "  store " + optTy.clone() + " " + someV.v + ", ptr " + slot.clone() + "\n")
            emit(&mut cg, "  br label %" + endLbl.clone() + "\n")
            emit(&mut cg, noneLbl.clone() + ":\n")
            let noneTag = lookupVariantTag(cg, optName, "None")
            let nslot = nextTemp(&mut cg)
            emit(&mut cg, "  " + nslot + " = alloca " + optTy.clone() + "\n")
            let ntagPtr = nextTemp(&mut cg)
            emit(&mut cg, "  " + ntagPtr + " = getelementptr " + optTy.clone() + ", ptr " + nslot + ", i32 0, i32 0\n")
            emit(&mut cg, "  store i32 " + noneTag.toString() + ", ptr " + ntagPtr + "\n")
            let nval = nextTemp(&mut cg)
            emit(&mut cg, "  " + nval + " = load " + optTy.clone() + ", ptr " + nslot + "\n")
            emit(&mut cg, "  store " + optTy.clone() + " " + nval + ", ptr " + slot.clone() + "\n")
            emit(&mut cg, "  br label %" + endLbl.clone() + "\n")
            emit(&mut cg, endLbl.clone() + ":\n")
            let outv = nextTemp(&mut cg)
            emit(&mut cg, "  " + outv + " = load " + optTy.clone() + ", ptr " + slot.clone() + "\n")
            return Val {
                v: outv, ty: optName
            }
        }
        var sfn = ""
        if method == "toInt" || method == "parseInt" {
            sfn = "strParseInt"
        } else {
            var first = method[0]
            if first >= 97 && first <= 122 {
                first = first - 32
            }
            sfn = "str"
            sfn.push(first)
            sfn = sfn + method[1..method.len].clone()
        }
        if cg.fnRets.contains(sfn) {
            // strXxx take `&string` (and sometimes `&string`) params → ptr. The
            // receiver (self) is always a ref; other args follow the sig.
            var sRefs: Vec<bool> = Vec.new()
            for si in 0..sigs.len {
                if sigs[si].name == sfn {
                    for pi in 0..sigs[si].paramRefs.len {
                        sRefs.push(sigs[si].paramRefs[pi])
                    }
                }
            }
            let recvLv = genLvalue(&mut cg, object, locs, sigs)
            var argStr = "ptr " + recvLv.v
            for ai in 0..args.len {
                var aRef = false
                if (ai + 1) < sRefs.len {
                    aRef = sRefs[ai + 1]
                }
                if aRef {
                    let alv = genLvalue(&mut cg, *args[ai], locs, sigs)
                    argStr = argStr + ", ptr " + alv.v
                } else {
                    let av = genExpr(&mut cg, *args[ai], locs, sigs, "")
                    argStr = argStr + ", " + llType(av.ty) + " " + av.v
                }
            }
            let retTy = resolveTyStr(cg, lookupFnRet(cg, sfn))
            let retLl = llType(retTy)
            let t = nextTemp(&mut cg)
            emit(&mut cg, "  " + t + " = call " + retLl + " @" + sfn + "(" + argStr + ")\n")
            return Val {
                v: t, ty: retTy
            }
        }
    }

    // `.clone()` on a Copy scalar (int/float/bool) is the identity — the value is
    // already loaded by value in `obj`, so there is nothing to actually copy. The
    // checker only accepts this method call at all when isCopyCk(objType) held
    // (see checker/expr.milo's clone-on-Copy fallback), so anything reaching here
    // should be a scalar, not a Vec/String/HashMap (those all have their own clone
    // case above, which already returned before this point).
    //
    // "Should be" was relied on and unenforced, which is how HashMap.clone()
    // became a silent aliasing copy: no case above matched, this arm accepted it,
    // and a deep copy the source asked for by name never happened. An owning
    // container that reaches here means its clone case is MISSING — say so instead
    // of emitting a copy that is wrong in exactly the way `.clone()` was written to
    // prevent. Scalars still take the identity path.
    if method == "clone" && args.len == 0 {
        if objTyLl == "%Vec" || objTyLl == "%HashMap" || objTyLl == "%String" {
            eprint("codegen: .clone() on " + objTyLl.clone() + " reached the scalar identity path — its deep-clone case is missing, and a shallow copy would alias the buffer")
            exit(1)
        }
        return Val {
            v: obj.v.clone(), ty: obj.ty.clone()
        }
    }

    // A silent placeholder here becomes invalid IR much later (`trunc i64 0 to
    // %String`), which is a miserable way to discover a missing method. Fail loud.
    eprint("codegen: unsupported method '" + method.clone() + "' on " + objTyLl.clone())
    exit(1)
    return Val {
        v: "0", ty: "i64"
    }
}

// -- Index + Slice --

// Trap on an out-of-range index. `idx`/`size` are i64 SSA values — a straight i64
// compare, unlike the oracle's emitBoundsCheck (which truncates to i32 first for a
// tighter hot-loop compare); simpler and still correct, at the cost of that one
// perf optimization. Every array/Vec index — read (genIndex) and write/address
// (genLvalue) — funnels through this so the check shape lives in one place.
pub fn emitBoundsCheck(cg: &mut Cgen, idx: &string, size: &string) {
    let cmp = nextTemp(&mut cg)
    let okLbl = nextLabel(&mut cg, "bounds.ok")
    let failLbl = nextLabel(&mut cg, "bounds.fail")
    emit(&mut cg, "  " + cmp + " = icmp ult i64 " + idx.clone() + ", " + size.clone() + "\n")
    emit(&mut cg, "  br i1 " + cmp + ", label %" + okLbl + ", label %" + failLbl + "\n")
    emit(&mut cg, failLbl + ":\n")
    emitPanic(&mut cg, "milo: array index out of bounds: %lld/%lld\n", ", i64 " + idx.clone() + ", i64 " + size.clone())
    // emitLabel, not plain emit — see emitCheckedArith's note: an enclosing
    // phi node needs cg.curBlock to name the block this check actually falls
    // through to, not whatever was current before the check.
    emitLabel(&mut cg, okLbl)
}

// Trap on a value that escapes the bound its target declared (`i32(0..100)`).
// A no-op unless the target actually carries a bound and the value is an
// integer — this rides every flow into a ranged slot (let/var, assignment,
// argument, return), so the bound constrains the VALUES that reach the slot,
// not merely the declaration that names it. Unlike the bounds check this is a
// correctness trap, not a memory-safety one, and it is deliberately on in every
// build: the oracle emits it unconditionally too.
pub fn emitRangeCheck(cg: &mut Cgen, v: &Val, r: &RangeAnno, span: &Option<Span>) {
    if !r.has {
        return
    }
    let llTy = llType(v.ty)
    if llTy != "i8" && llTy != "i16" && llTy != "i32" && llTy != "i64" {
        return
    }
    var cmpLo = "slt"
    var cmpHi = "sgt"
    if isUnsigned(v.ty) {
        cmpLo = "ult"
        cmpHi = "ugt"
    }
    let lo = nextTemp(&mut cg)
    let hi = nextTemp(&mut cg)
    let bad = nextTemp(&mut cg)
    let okLbl = nextLabel(&mut cg, "range.ok")
    let failLbl = nextLabel(&mut cg, "range.fail")
    emit(&mut cg, "  " + lo + " = icmp " + cmpLo + " " + llTy.clone() + " " + v.v.clone() + ", " + r.min.toString() + "\n")
    emit(&mut cg, "  " + hi + " = icmp " + cmpHi + " " + llTy.clone() + " " + v.v.clone() + ", " + r.max.toString() + "\n")
    emit(&mut cg, "  " + bad + " = or i1 " + lo + ", " + hi + "\n")
    emit(&mut cg, "  br i1 " + bad + ", label %" + failLbl + ", label %" + okLbl + "\n")
    emit(&mut cg, failLbl + ":\n")
    emitPanic(&mut cg, "runtime error: value out of range" + spanSuffix(span) + "\n", "")
    // emitLabel, not plain emit — see emitCheckedArith's note: an enclosing
    // phi node needs cg.curBlock to name the block this check actually falls
    // through to.
    emitLabel(&mut cg, okLbl)
}

// " at file:line" for a panic message, or "" when the span was dropped. Spans
// are static in this AOT compiler, so the location is baked into the string
// rather than passed as printf arguments the way the oracle does it.
pub fn spanSuffix(span: &Option<Span>): string {
    match span {
        Option.Some(s) => {
            return " at " + s.file.clone() + ":" + s.line.toString()
        }
        Option.None => {
            return ""
        }
    }
}

// Trap if a collection length/capacity is negative. Every index bounds check
// above is an UNSIGNED compare, so a negative count (a literal -1, or a wrapped
// overflow before overflow checks existed) sails through as a huge unsigned
// bound and lets any index write past a mis-sized (or failed) allocation — an
// OOB in code that never wrote an unsafe block. `val` is an i64 SSA value.
pub fn emitNonNegativeCheck(cg: &mut Cgen, val: &string, what: &string) {
    let neg = nextTemp(&mut cg)
    let okLbl = nextLabel(&mut cg, "neglen.ok")
    let failLbl = nextLabel(&mut cg, "neglen.fail")
    emit(&mut cg, "  " + neg + " = icmp slt i64 " + val.clone() + ", 0\n")
    emit(&mut cg, "  br i1 " + neg + ", label %" + failLbl + ", label %" + okLbl + "\n")
    emit(&mut cg, failLbl + ":\n")
    emitPanic(&mut cg, "milo: negative " + what.clone() + ": %lld\n", ", i64 " + val.clone())
    emitLabel(&mut cg, okLbl)
}

pub fn genIndex(cg: &mut Cgen, obj: &ExprNode, idx: &ExprNode, locs: &Vec<Local>, sigs: &Vec<CgFnSig>): Val {
    // Inline struct-field array (see isInlineArrTy): there is no %Vec header to
    // pull a data ptr out of by value, so index the field's ADDRESS directly
    // via genLvalue + GEP[0, i] instead of the by-value genExpr path below.
    let objPlaceTy = placeTypeStrOrAbort(cg, obj, locs, "indexing a place")
    if isInlineArrTy(objPlaceTy) {
        let addr = genLvalue(&mut cg, obj, locs, sigs)
        let elemTy = inlineArrElem(addr.ty)
        let elemLl = llType(elemTy)
        let arrLl = llType(addr.ty)
        let iv = genExpr(&mut cg, idx, locs, sigs, "i64")
        let iw = widenToI64(&mut cg, iv)
        let size = inlineArrLen(addr.ty)
        emitBoundsCheck(&mut cg, iw, size.toString())
        let slot = nextTemp(&mut cg)
        emit(&mut cg, "  " + slot + " = getelementptr " + arrLl + ", ptr " + addr.v + ", i32 0, i64 " + iw + "\n")
        let v = nextTemp(&mut cg)
        emit(&mut cg, "  " + v + " = load " + elemLl + ", ptr " + slot + "\n")
        return Val {
            v: v, ty: elemTy
        }
    }
    let o = genExpr(&mut cg, obj, locs, sigs, "")
    let i = genExpr(&mut cg, idx, locs, sigs, "i64")
    if llType(o.ty) == "%String" {
        return genStringIndex(&mut cg, o.v, i.v)
    }
    if isVecTy(o.ty) {
        let elemTy = unwrapVec(resolveTyStr(cg, o.ty))
        let elemLl = llType(elemTy)
        let d = nextTemp(&mut cg)
        emit(&mut cg, "  " + d + " = extractvalue %Vec " + o.v + ", 0\n")
        let vlen = nextTemp(&mut cg)
        emit(&mut cg, "  " + vlen + " = extractvalue %Vec " + o.v + ", 1\n")
        // a gep index must be i64; a narrower index (e.g. an i32 loop counter) is widened
        let iw = widenToI64(&mut cg, i)
        emitBoundsCheck(&mut cg, iw, vlen)
        let slot = nextTemp(&mut cg)
        emit(&mut cg, "  " + slot + " = getelementptr " + elemLl + ", ptr " + d + ", i64 " + iw + "\n")
        let v = nextTemp(&mut cg)
        emit(&mut cg, "  " + v + " = load " + elemLl + ", ptr " + slot + "\n")
        return Val {
            v: v, ty: elemTy
        }
    }
    // Raw pointer `*T` (unsafe): o.v is already the loaded pointer value.
    if o.ty.len > 0 && o.ty[0] == 42 {
        let elemTy = o.ty[1..o.ty.len].clone()
        let elemLl = llType(elemTy)
        let iw = widenToI64(&mut cg, i)
        let slot = nextTemp(&mut cg)
        emit(&mut cg, "  " + slot + " = getelementptr " + elemLl + ", ptr " + o.v + ", i64 " + iw + "\n")
        let v = nextTemp(&mut cg)
        emit(&mut cg, "  " + v + " = load " + elemLl + ", ptr " + slot + "\n")
        return Val {
            v: v, ty: elemTy
        }
    }
    eprint("codegen: cannot index type " + o.ty.clone())
    exit(1)
    return Val {
        v: "0", ty: "i64"
    }
}

pub fn genSlice(cg: &mut Cgen, obj: &ExprNode, a: &ExprNode, b: &ExprNode, locs: &Vec<Local>, sigs: &Vec<CgFnSig>): Val {
    let o = genExpr(&mut cg, obj, locs, sigs, "")
    let av = genExpr(&mut cg, a, locs, sigs, "i64")
    let bv = genExpr(&mut cg, b, locs, sigs, "i64")
    if llType(o.ty) == "%String" {
        return genStringSlice(&mut cg, o.v, av.v, bv.v, "slice")
    }
    return Val {
        v: "0", ty: "i64"
    }
}

// -- Function calls --

// f-strings lower to `format(parts...)`. Fold the parts into one %String:
// string parts pass through, integers go via genIntToString.
pub fn isIntLlType(ll: &string): bool {
    return ll == "i8" || ll == "i16" || ll == "i32" || ll == "i64"
}

// Display a value of any type as an owned %String (mirrors the oracle's
// emitDisplayPart). Recurses for struct/enum payloads; recursive types bottom out
// at Heap (a ptr → the "<ty>" fallback). Without this, an f-string part that
// isn't a String or integer (e.g. `{e}` where e is an IoError enum) fell through
// to genIntToString and emitted `sext %IoError to i64` — invalid IR.
pub fn genDisplayString(cg: &mut Cgen, val: &string, ty: &string, locs: &Vec<Local>, sigs: &Vec<CgFnSig>): Val {
    let ll = llType(ty)
    if ll == "%String" {
        return Val {
            v: val.clone(), ty: "string"
        }
    }
    if ll == "i1" {
        let ts = genStringLit(&mut cg, "true")
        let fs = genStringLit(&mut cg, "false")
        let r = nextTemp(&mut cg)
        emit(&mut cg, "  " + r + " = select i1 " + val.clone() + ", %String " + ts.v + ", %String " + fs.v + "\n")
        return Val {
            v: r, ty: "string"
        }
    }
    if ll == "double" {
        return genFloatToString(&mut cg, val.clone())
    }
    if ll == "float" {
        return genFloat32ToString(&mut cg, val.clone())
    }
    // A fixed array and a `.slice()`/`v[a..b]` view share the Vec's %Vec runtime
    // rep (see astTypeStr), so this one path renders Vec<T>, [T;N], and a slice.
    if isVecTy(ty) {
        let elemTy = unwrapVec(ty)
        return genVecDisplay(&mut cg, val, elemTy, locs, sigs)
    }
    if isHashMapTy(ty) {
        return genHashMapDisplay(&mut cg, val, ty, locs, sigs)
    }
    if isIntLlType(ll) {
        var widened = val.clone()
        if ll != "i64" {
            let w = nextTemp(&mut cg)
            var op = "sext"
            if isUnsigned(ty) {
                op = "zext"
            }
            emit(&mut cg, "  " + w + " = " + op + " " + ll + " " + val.clone() + " to i64\n")
            widened = w
        }
        return genIntToString(&mut cg, widened, isUnsigned(ty))
    }
    if ll.len > 0 && ll[0] == 37 {
        let raw = stripPercent(ty)
        if cg.structs.contains(raw) {
            return genStructDisplay(&mut cg, val, raw, locs, sigs)
        }
        if cg.enums.contains(raw) {
            return genEnumDisplay(&mut cg, val, raw, locs, sigs)
        }
    }
    return genStringLit(&mut cg, "<" + ty.clone() + ">")
}

// "[e0, e1, ...]" — string elements get quoted (matches genStructDisplay's
// convention: a bare string next to the commas is ambiguous). Builds the result
// via one %String, growing in place (genStringAppendInPlace), rather than a
// fresh malloc per '+' — this can run over an arbitrarily long Vec.
pub fn genVecDisplay(cg: &mut Cgen, val: &string, elemTy: &string, locs: &Vec<Local>, sigs: &Vec<CgFnSig>): Val {
    let elemLl = llType(elemTy)
    let resAddr = nextTemp(&mut cg)
    emit(&mut cg, "  " + resAddr + " = alloca %String\n")
    let open = genStringLit(&mut cg, "[")
    emit(&mut cg, "  store %String " + open.v + ", ptr " + resAddr + "\n")

    let d = nextTemp(&mut cg)
    emit(&mut cg, "  " + d + " = extractvalue %Vec " + val.clone() + ", 0\n")
    let len = nextTemp(&mut cg)
    emit(&mut cg, "  " + len + " = extractvalue %Vec " + val.clone() + ", 1\n")
    let iAddr = nextTemp(&mut cg)
    emit(&mut cg, "  " + iAddr + " = alloca i64\n")
    emit(&mut cg, "  store i64 0, ptr " + iAddr + "\n")
    let condLbl = nextLabel(&mut cg, "disp.cond")
    let bodyLbl = nextLabel(&mut cg, "disp.body")
    let sepLbl = nextLabel(&mut cg, "disp.sep")
    let elemLbl = nextLabel(&mut cg, "disp.elem")
    let endLbl = nextLabel(&mut cg, "disp.end")
    emit(&mut cg, "  br label %" + condLbl + "\n")
    emitLabel(&mut cg, condLbl)
    let i = nextTemp(&mut cg)
    emit(&mut cg, "  " + i + " = load i64, ptr " + iAddr + "\n")
    let lt = nextTemp(&mut cg)
    emit(&mut cg, "  " + lt + " = icmp slt i64 " + i + ", " + len + "\n")
    emit(&mut cg, "  br i1 " + lt + ", label %" + bodyLbl + ", label %" + endLbl + "\n")
    emitLabel(&mut cg, bodyLbl)
    let notFirst = nextTemp(&mut cg)
    emit(&mut cg, "  " + notFirst + " = icmp sgt i64 " + i + ", 0\n")
    emit(&mut cg, "  br i1 " + notFirst + ", label %" + sepLbl + ", label %" + elemLbl + "\n")
    emitLabel(&mut cg, sepLbl)
    let sepLit = genStringLit(&mut cg, ", ")
    genStringAppendInPlace(&mut cg, resAddr, sepLit.v)
    emit(&mut cg, "  br label %" + elemLbl + "\n")
    emitLabel(&mut cg, elemLbl)
    let slot = nextTemp(&mut cg)
    emit(&mut cg, "  " + slot + " = getelementptr " + elemLl + ", ptr " + d + ", i64 " + i + "\n")
    let ev = nextTemp(&mut cg)
    emit(&mut cg, "  " + ev + " = load " + elemLl + ", ptr " + slot + "\n")
    if elemLl == "%String" {
        let q = genStringLit(&mut cg, "\"")
        genStringAppendInPlace(&mut cg, resAddr, q.v)
        genStringAppendInPlace(&mut cg, resAddr, ev)
        genStringAppendInPlace(&mut cg, resAddr, q.v)
    } else {
        let ds = genDisplayString(&mut cg, ev, elemTy, locs, sigs)
        genStringAppendInPlace(&mut cg, resAddr, ds.v)
    }
    let i1v = nextTemp(&mut cg)
    emit(&mut cg, "  " + i1v + " = add i64 " + i + ", 1\n")
    emit(&mut cg, "  store i64 " + i1v + ", ptr " + iAddr + "\n")
    emit(&mut cg, "  br label %" + condLbl + "\n")
    emitLabel(&mut cg, endLbl)
    let close = genStringLit(&mut cg, "]")
    genStringAppendInPlace(&mut cg, resAddr, close.v)
    let out = nextTemp(&mut cg)
    emit(&mut cg, "  " + out + " = load %String, ptr " + resAddr + "\n")
    return Val {
        v: out, ty: "string"
    }
}

// "{k0: v0, k1: v1, ...}" — mirrors genVecDisplay above, but over %HashMap's
// {key, val} entry pairs. src-milo's HashMap stores its `len` live entries
// densely in `data[0..len]` (see .keys()'s codegen, which walks the same
// range with no separate occupied/tombstone check) — there is no hole to
// skip, unlike the oracle's open-addressed table.
pub fn genHashMapDisplay(cg: &mut Cgen, val: &string, ty: &string, locs: &Vec<Local>, sigs: &Vec<CgFnSig>): Val {
    let keyTy = hashMapKeyTy(ty)
    let valTy = hashMapValTy(ty)
    let entryTy = hmEntryTy(keyTy, valTy)
    let keyLl = llType(keyTy)
    let valLl = llType(valTy)
    let resAddr = nextTemp(&mut cg)
    emit(&mut cg, "  " + resAddr + " = alloca %String\n")
    let open = genStringLit(&mut cg, "{")
    emit(&mut cg, "  store %String " + open.v + ", ptr " + resAddr + "\n")

    let d = nextTemp(&mut cg)
    emit(&mut cg, "  " + d + " = extractvalue %HashMap " + val.clone() + ", 0\n")
    let len = nextTemp(&mut cg)
    emit(&mut cg, "  " + len + " = extractvalue %HashMap " + val.clone() + ", 1\n")
    let iAddr = nextTemp(&mut cg)
    emit(&mut cg, "  " + iAddr + " = alloca i64\n")
    emit(&mut cg, "  store i64 0, ptr " + iAddr + "\n")
    let condLbl = nextLabel(&mut cg, "dispm.cond")
    let bodyLbl = nextLabel(&mut cg, "dispm.body")
    let sepLbl = nextLabel(&mut cg, "dispm.sep")
    let elemLbl = nextLabel(&mut cg, "dispm.elem")
    let endLbl = nextLabel(&mut cg, "dispm.end")
    emit(&mut cg, "  br label %" + condLbl + "\n")
    emitLabel(&mut cg, condLbl)
    let i = nextTemp(&mut cg)
    emit(&mut cg, "  " + i + " = load i64, ptr " + iAddr + "\n")
    let lt = nextTemp(&mut cg)
    emit(&mut cg, "  " + lt + " = icmp slt i64 " + i + ", " + len + "\n")
    emit(&mut cg, "  br i1 " + lt + ", label %" + bodyLbl + ", label %" + endLbl + "\n")
    emitLabel(&mut cg, bodyLbl)
    let notFirst = nextTemp(&mut cg)
    emit(&mut cg, "  " + notFirst + " = icmp sgt i64 " + i + ", 0\n")
    emit(&mut cg, "  br i1 " + notFirst + ", label %" + sepLbl + ", label %" + elemLbl + "\n")
    emitLabel(&mut cg, sepLbl)
    let sepLit = genStringLit(&mut cg, ", ")
    genStringAppendInPlace(&mut cg, resAddr, sepLit.v)
    emit(&mut cg, "  br label %" + elemLbl + "\n")
    emitLabel(&mut cg, elemLbl)
    let slot = nextTemp(&mut cg)
    emit(&mut cg, "  " + slot + " = getelementptr " + entryTy + ", ptr " + d + ", i64 " + i + "\n")
    let kp = nextTemp(&mut cg)
    emit(&mut cg, "  " + kp + " = getelementptr " + entryTy + ", ptr " + slot + ", i32 0, i32 0\n")
    let kv = nextTemp(&mut cg)
    emit(&mut cg, "  " + kv + " = load " + keyLl + ", ptr " + kp + "\n")
    if keyLl == "%String" {
        let qk = genStringLit(&mut cg, "\"")
        genStringAppendInPlace(&mut cg, resAddr, qk.v)
        genStringAppendInPlace(&mut cg, resAddr, kv)
        genStringAppendInPlace(&mut cg, resAddr, qk.v)
    } else {
        let kds = genDisplayString(&mut cg, kv, keyTy, locs, sigs)
        genStringAppendInPlace(&mut cg, resAddr, kds.v)
    }
    let colon = genStringLit(&mut cg, ": ")
    genStringAppendInPlace(&mut cg, resAddr, colon.v)
    let vp = nextTemp(&mut cg)
    emit(&mut cg, "  " + vp + " = getelementptr " + entryTy + ", ptr " + slot + ", i32 0, i32 1\n")
    let vv = nextTemp(&mut cg)
    emit(&mut cg, "  " + vv + " = load " + valLl + ", ptr " + vp + "\n")
    if valLl == "%String" {
        let qv = genStringLit(&mut cg, "\"")
        genStringAppendInPlace(&mut cg, resAddr, qv.v)
        genStringAppendInPlace(&mut cg, resAddr, vv)
        genStringAppendInPlace(&mut cg, resAddr, qv.v)
    } else {
        let vds = genDisplayString(&mut cg, vv, valTy, locs, sigs)
        genStringAppendInPlace(&mut cg, resAddr, vds.v)
    }
    let i1v = nextTemp(&mut cg)
    emit(&mut cg, "  " + i1v + " = add i64 " + i + ", 1\n")
    emit(&mut cg, "  store i64 " + i1v + ", ptr " + iAddr + "\n")
    emit(&mut cg, "  br label %" + condLbl + "\n")
    emitLabel(&mut cg, endLbl)
    let close2 = genStringLit(&mut cg, "}")
    genStringAppendInPlace(&mut cg, resAddr, close2.v)
    let out2 = nextTemp(&mut cg)
    emit(&mut cg, "  " + out2 + " = load %String, ptr " + resAddr + "\n")
    return Val {
        v: out2, ty: "string"
    }
}

pub fn genStructDisplay(cg: &mut Cgen, val: &string, structName: &string, locs: &Vec<Local>, sigs: &Vec<CgFnSig>): Val {
    let structTy = "%" + structName.clone()
    let stage = nextTemp(&mut cg)
    emit(&mut cg, "  " + stage + " = alloca " + structTy + "\n")
    emit(&mut cg, "  store " + structTy + " " + val.clone() + ", ptr " + stage + "\n")
    var acc = genStringLit(&mut cg, structName.clone() + " { ")
    let fields = cg.structs.get(structName.clone())!
    for i in 0..fields.len {
        if i > 0 {
            let sep = genStringLit(&mut cg, ", ")
            acc = genStringConcat(&mut cg, acc.v, sep.v)
        }
        let namePart = genStringLit(&mut cg, fields[i].name.clone() + ": ")
        acc = genStringConcat(&mut cg, acc.v, namePart.v)
        let fll = llType(fields[i].ty)
        let fp = nextTemp(&mut cg)
        emit(&mut cg, "  " + fp + " = getelementptr " + structTy + ", ptr " + stage + ", i32 0, i32 " + i.toString() + "\n")
        let fv = nextTemp(&mut cg)
        emit(&mut cg, "  " + fv + " = load " + fll + ", ptr " + fp + "\n")
        let isStr = fll == "%String"
        if isStr {
            let q = genStringLit(&mut cg, "\"")
            acc = genStringConcat(&mut cg, acc.v, q.v)
        }
        let disp = genDisplayString(&mut cg, fv, fields[i].ty, locs, sigs)
        acc = genStringConcat(&mut cg, acc.v, disp.v)
        if isStr {
            let q2 = genStringLit(&mut cg, "\"")
            acc = genStringConcat(&mut cg, acc.v, q2.v)
        }
    }
    let close = genStringLit(&mut cg, " }")
    acc = genStringConcat(&mut cg, acc.v, close.v)
    return acc
}

pub fn genEnumDisplay(cg: &mut Cgen, val: &string, enumName: &string, locs: &Vec<Local>, sigs: &Vec<CgFnSig>): Val {
    let enumTy = "%" + enumName.clone()
    let stage = nextTemp(&mut cg)
    emit(&mut cg, "  " + stage + " = alloca " + enumTy + "\n")
    emit(&mut cg, "  store " + enumTy + " " + val.clone() + ", ptr " + stage + "\n")
    let tagPtr = nextTemp(&mut cg)
    emit(&mut cg, "  " + tagPtr + " = getelementptr " + enumTy + ", ptr " + stage + ", i32 0, i32 0\n")
    let tag = nextTemp(&mut cg)
    emit(&mut cg, "  " + tag + " = load i32, ptr " + tagPtr + "\n")
    let resPtr = nextTemp(&mut cg)
    emit(&mut cg, "  " + resPtr + " = alloca %String\n")
    let endLbl = nextLabel(&mut cg, "enum.disp.end")
    let defaultLbl = nextLabel(&mut cg, "enum.disp.default")
    let info = cg.enums.get(enumName.clone())!
    var caseLbls: Vec<string> = Vec.new()
    for vi in 0..info.variants.len {
        caseLbls.push(nextLabel(&mut cg, "enum.disp.case"))
    }
    var sw = "  switch i32 " + tag + ", label %" + defaultLbl + " ["
    for vi in 0..info.variants.len {
        sw = sw + " i32 " + info.variants[vi].tag.toString() + ", label %" + caseLbls[vi]
    }
    sw = sw + " ]\n"
    emit(&mut cg, sw)
    for vi in 0..info.variants.len {
        emit(&mut cg, caseLbls[vi] + ":\n")
        var acc = genStringLit(&mut cg, info.variants[vi].name.clone())
        let np = info.variants[vi].payloadTypes.len
        if np > 0 {
            let op = genStringLit(&mut cg, "(")
            acc = genStringConcat(&mut cg, acc.v, op.v)
            let payPtr = nextTemp(&mut cg)
            emit(&mut cg, "  " + payPtr + " = getelementptr " + enumTy + ", ptr " + stage + ", i32 0, i32 1\n")
            var payStructTy = "{ "
            for fi in 0..np {
                if fi > 0 {
                    payStructTy = payStructTy + ", "
                }
                payStructTy = payStructTy + llType(info.variants[vi].payloadTypes[fi])
            }
            payStructTy = payStructTy + " }"
            for fi in 0..np {
                if fi > 0 {
                    let sep = genStringLit(&mut cg, ", ")
                    acc = genStringConcat(&mut cg, acc.v, sep.v)
                }
                let fll = llType(info.variants[vi].payloadTypes[fi])
                let fp = nextTemp(&mut cg)
                emit(&mut cg, "  " + fp + " = getelementptr " + payStructTy + ", ptr " + payPtr + ", i32 0, i32 " + fi.toString() + "\n")
                let fv = nextTemp(&mut cg)
                emit(&mut cg, "  " + fv + " = load " + fll + ", ptr " + fp + "\n")
                let isStr = fll == "%String"
                if isStr {
                    let q = genStringLit(&mut cg, "\"")
                    acc = genStringConcat(&mut cg, acc.v, q.v)
                }
                let disp = genDisplayString(&mut cg, fv, info.variants[vi].payloadTypes[fi], locs, sigs)
                acc = genStringConcat(&mut cg, acc.v, disp.v)
                if isStr {
                    let q2 = genStringLit(&mut cg, "\"")
                    acc = genStringConcat(&mut cg, acc.v, q2.v)
                }
            }
            let cp = genStringLit(&mut cg, ")")
            acc = genStringConcat(&mut cg, acc.v, cp.v)
        }
        emit(&mut cg, "  store %String " + acc.v + ", ptr " + resPtr + "\n")
        emit(&mut cg, "  br label %" + endLbl + "\n")
    }
    emit(&mut cg, defaultLbl + ":\n")
    let fb = genStringLit(&mut cg, "<" + enumName.clone() + ".?>")
    emit(&mut cg, "  store %String " + fb.v + ", ptr " + resPtr + "\n")
    emit(&mut cg, "  br label %" + endLbl + "\n")
    emit(&mut cg, endLbl + ":\n")
    let out = nextTemp(&mut cg)
    emit(&mut cg, "  " + out + " = load %String, ptr " + resPtr + "\n")
    return Val {
        v: out, ty: "string"
    }
}

pub fn genFormat(cg: &mut Cgen, args: &Vec<Heap<ExprNode>>, locs: &Vec<Local>, sigs: &Vec<CgFnSig>): Val {
    ensureStringTy(&mut cg)
    var acc = genStringLit(&mut cg, "")
    for i in 0..args.len {
        let part = genExpr(&mut cg, *args[i], locs, sigs, "")
        let disp = genDisplayString(&mut cg, part.v, part.ty, locs, sigs)
        acc = genStringConcat(&mut cg, acc.v, disp.v)
    }
    return acc
}

// jsonStringify(struct) → `{"f1":v1,"f2":v2}` for scalar fields. Reuses
// genDisplayString for the values (bool→true/false, int/float→number, string
// as-is, wrapped in quotes). NOTE: string values are not yet RFC-escaped, so a
// field containing a quote/backslash produces invalid JSON (the checker permits
// only scalar fields; escaping is a follow-up).
// Five IR lines that append one byte (a constant or an SSA i8 value) to the
// escape buffer %out at index %oi, then bump %oi. `n` names its temps uniquely.
pub fn jsonAppendIR(n: i64, byteVal: string): string {
    let o = "%jo" + n.toString()
    let p = "%jp" + n.toString()
    let q = "%jq" + n.toString()
    return "  " + o + " = load i64, ptr %oi\n" +
    "  " + p + " = getelementptr i8, ptr %out, i64 " + o + "\n" +
    "  store i8 " + byteVal + ", ptr " + p + "\n" +
    "  " + q + " = add i64 " + o + ", 1\n" +
    "  store i64 " + q + ", ptr %oi\n"
}

// Emit the JSON string-escaping runtime helper once:
// `@__jsonEsc(%String) -> %String` — quotes/backslash/\n\t\r\b\f get a backslash
// escape, other control chars become \u00XX (RFC 8259), everything else copies.
pub fn ensureJsonEsc(cg: &mut Cgen) {
    for i in 0..cg.emittedThunks.len {
        if cg.emittedThunks[i] == "__jsonEsc" {
            return
        }
    }
    cg.emittedThunks.push("__jsonEsc")
    ensureMalloc(&mut cg)
    var f = "define %String @__jsonEsc(%String %s) {\nentry:\n"
    f = f + "  %data = extractvalue %String %s, 0\n"
    f = f + "  %len = extractvalue %String %s, 1\n"
    f = f + "  %sz = mul i64 %len, 6\n"
    f = f + "  %sz1 = add i64 %sz, 1\n"
    f = f + "  %out = call ptr @malloc(i64 %sz1)\n"
    f = f + "  %oi = alloca i64\n  store i64 0, ptr %oi\n"
    f = f + "  %ii = alloca i64\n  store i64 0, ptr %ii\n"
    f = f + "  %escslot = alloca i8\n"
    f = f + "  br label %jl\n"
    f = f + "jl:\n  %i = load i64, ptr %ii\n  %done = icmp sge i64 %i, %len\n  br i1 %done, label %jf, label %jb\n"
    f = f + "jb:\n  %cp = getelementptr i8, ptr %data, i64 %i\n  %c = load i8, ptr %cp\n"
    f = f + "  switch i8 %c, label %jchk [ i8 34, label %j_dq i8 92, label %j_bs i8 10, label %j_nl i8 9, label %j_tb i8 13, label %j_cr i8 8, label %j_bb i8 12, label %j_ff ]\n"
    f = f + "j_dq:\n  store i8 34, ptr %escslot\n  br label %jesc2\n"
    f = f + "j_bs:\n  store i8 92, ptr %escslot\n  br label %jesc2\n"
    f = f + "j_nl:\n  store i8 110, ptr %escslot\n  br label %jesc2\n"
    f = f + "j_tb:\n  store i8 116, ptr %escslot\n  br label %jesc2\n"
    f = f + "j_cr:\n  store i8 114, ptr %escslot\n  br label %jesc2\n"
    f = f + "j_bb:\n  store i8 98, ptr %escslot\n  br label %jesc2\n"
    f = f + "j_ff:\n  store i8 102, ptr %escslot\n  br label %jesc2\n"
    f = f + "jesc2:\n" + jsonAppendIR(1, "92")
    f = f + "  %ec = load i8, ptr %escslot\n" + jsonAppendIR(2, "%ec")
    f = f + "  br label %jnext\n"
    f = f + "jchk:\n  %isc = icmp ult i8 %c, 32\n  br i1 %isc, label %juni, label %jraw\n"
    f = f + "jraw:\n" + jsonAppendIR(3, "%c") + "  br label %jnext\n"
    f = f + "juni:\n" + jsonAppendIR(4, "92") + jsonAppendIR(5, "117") + jsonAppendIR(6, "48") + jsonAppendIR(7, "48")
    f = f + "  %hi = lshr i8 %c, 4\n  %lo = and i8 %c, 15\n"
    f = f + "  %hic = icmp ult i8 %hi, 10\n  %hid = add i8 %hi, 48\n  %hia = add i8 %hi, 87\n  %hich = select i1 %hic, i8 %hid, i8 %hia\n"
    f = f + "  %loc = icmp ult i8 %lo, 10\n  %lod = add i8 %lo, 48\n  %loa = add i8 %lo, 87\n  %loch = select i1 %loc, i8 %lod, i8 %loa\n"
    f = f + jsonAppendIR(8, "%hich") + jsonAppendIR(9, "%loch") + "  br label %jnext\n"
    f = f + "jnext:\n  %i1 = add i64 %i, 1\n  store i64 %i1, ptr %ii\n  br label %jl\n"
    f = f + "jf:\n  %olen = load i64, ptr %oi\n"
    f = f + "  %r0 = insertvalue %String undef, ptr %out, 0\n  %r1 = insertvalue %String %r0, i64 %olen, 1\n  %r2 = insertvalue %String %r1, i64 %sz1, 2\n  ret %String %r2\n}\n\n"
    cg.globals = cg.globals + f
}

// Escape a string Val for JSON, returning the escaped %String Val.
pub fn genJsonEsc(cg: &mut Cgen, strVal: &string): Val {
    ensureJsonEsc(&mut cg)
    let t = nextTemp(&mut cg)
    emit(&mut cg, "  " + t + " = call %String @__jsonEsc(%String " + strVal.clone() + ")\n")
    return Val {
        v: t, ty: "string"
    }
}

// Serialize an anonymous JSON object literal `{ k: v, … }` to a JSON string,
// matching genJsonStringify's format (string values quoted; numbers/bools bare).
pub fn genJsonObject(cg: &mut Cgen, fields: &Vec<StructLitField>, locs: &Vec<Local>, sigs: &Vec<CgFnSig>): Val {
    var acc = genStringLit(&mut cg, "{")
    for i in 0..fields.len {
        if i > 0 {
            let comma = genStringLit(&mut cg, ",")
            acc = genStringConcat(&mut cg, acc.v, comma.v)
        }
        let key = genStringLit(&mut cg, "\"" + fields[i].name.clone() + "\":")
        acc = genStringConcat(&mut cg, acc.v, key.v)
        let fv = genExpr(&mut cg, *fields[i].value, locs, sigs, "")
        let isStr = llType(fv.ty) == "%String"
        if isStr {
            let q = genStringLit(&mut cg, "\"")
            acc = genStringConcat(&mut cg, acc.v, q.v)
            let esc = genJsonEsc(&mut cg, fv.v)
            acc = genStringConcat(&mut cg, acc.v, esc.v)
            let q2 = genStringLit(&mut cg, "\"")
            acc = genStringConcat(&mut cg, acc.v, q2.v)
        } else {
            let disp = genDisplayString(&mut cg, fv.v, fv.ty, locs, sigs)
            acc = genStringConcat(&mut cg, acc.v, disp.v)
        }
    }
    let close = genStringLit(&mut cg, "}")
    acc = genStringConcat(&mut cg, acc.v, close.v)
    return acc
}

pub fn genJsonStringify(cg: &mut Cgen, arg: &ExprNode, locs: &Vec<Local>, sigs: &Vec<CgFnSig>): Val {
    let sv = genExpr(&mut cg, arg, locs, sigs, "")
    return genJsonStringifyFromVal(&mut cg, sv, locs, sigs)
}

// Scalar-only built-in stringifier, factored out of genJsonStringify so the
// "json"-named-method auto-stringify path (genJsonToStringVal below) can reuse
// it against an already-evaluated Val instead of re-evaluating (and
// re-moving) the source expression.
pub fn genJsonStringifyFromVal(cg: &mut Cgen, sv: Val, locs: &Vec<Local>, sigs: &Vec<CgFnSig>): Val {
    let structName = stripPercent(sv.ty)
    let structTy = "%" + structName.clone()
    let stage = nextTemp(&mut cg)
    emit(&mut cg, "  " + stage + " = alloca " + structTy + "\n")
    emit(&mut cg, "  store " + structTy + " " + sv.v + ", ptr " + stage + "\n")
    var acc = genStringLit(&mut cg, "{")
    let fields = cg.structs.get(structName.clone())!
    for i in 0..fields.len {
        if i > 0 {
            let comma = genStringLit(&mut cg, ",")
            acc = genStringConcat(&mut cg, acc.v, comma.v)
        }
        let key = genStringLit(&mut cg, "\"" + fields[i].name.clone() + "\":")
        acc = genStringConcat(&mut cg, acc.v, key.v)
        let fll = llType(fields[i].ty)
        let fp = nextTemp(&mut cg)
        emit(&mut cg, "  " + fp + " = getelementptr " + structTy + ", ptr " + stage + ", i32 0, i32 " + i.toString() + "\n")
        let fv = nextTemp(&mut cg)
        emit(&mut cg, "  " + fv + " = load " + fll + ", ptr " + fp + "\n")
        let isStr = fll == "%String"
        if isStr {
            let q = genStringLit(&mut cg, "\"")
            acc = genStringConcat(&mut cg, acc.v, q.v)
            let esc = genJsonEsc(&mut cg, fv)
            acc = genStringConcat(&mut cg, acc.v, esc.v)
            let q2 = genStringLit(&mut cg, "\"")
            acc = genStringConcat(&mut cg, acc.v, q2.v)
        } else {
            let disp = genDisplayString(&mut cg, fv, fields[i].ty, locs, sigs)
            acc = genStringConcat(&mut cg, acc.v, disp.v)
        }
    }
    let close = genStringLit(&mut cg, "}")
    acc = genStringConcat(&mut cg, acc.v, close.v)
    return acc
}

// `sink.json(entry)`: a struct argument passed to a 'json'-named method's
// string param. Mirrors the oracle's autoJsonToJson/autoJsonStringify pair —
// route through the struct's real toJson (hand-written or @derive(Json)) when
// it has one, since that's the only path that recurses into non-scalar
// fields; fall back to the scalar-only built-in stringifier otherwise. The
// checker (checkStructMethod's "json" special case) already verified one of
// these two is valid, so this re-derives rather than trusts a side table —
// src-milo has no Expr-keyed side table to carry the checker's decision.
pub fn genJsonToStringVal(cg: &mut Cgen, sv: Val, locs: &Vec<Local>, sigs: &Vec<CgFnSig>): Val {
    let structName = stripPercent(resolveTyStr(cg, stripPercent(sv.ty)))
    let toJsonFn = structName.clone() + "$toJson"
    if cg.fnRets.contains(toJsonFn) {
        let structTy = "%" + structName.clone()
        let stage = nextTemp(&mut cg)
        emit(&mut cg, "  " + stage + " = alloca " + structTy + "\n")
        emit(&mut cg, "  store " + structTy + " " + sv.v.clone() + ", ptr " + stage + "\n")
        let t = nextTemp(&mut cg)
        emit(&mut cg, "  " + t + " = call %String @" + toJsonFn + "(ptr " + stage + ")\n")
        return Val {
            v: t, ty: "string"
        }
    }
    return genJsonStringifyFromVal(&mut cg, sv, locs, sigs)
}

// Copy a NUL-terminated C string at `pv` into an owned %String {buf,len,len+1}.
pub fn genCstrToString(cg: &mut Cgen, pv: &string): Val {
    ensureStringTy(&mut cg)
    ensureMalloc(&mut cg)
    ensureMemcpy(&mut cg)
    // strlen may or may not be declared by a stdlib extern the program imports;
    // ensureStrlen dedups against genFn's extern-decl path via cg.declaredStrlen.
    ensureStrlen(&mut cg)
    let len = nextTemp(&mut cg)
    emit(&mut cg, "  " + len + " = call i64 @strlen(ptr " + pv + ")\n")
    let cap = nextTemp(&mut cg)
    emit(&mut cg, "  " + cap + " = add i64 " + len + ", 1\n")
    let buf = nextTemp(&mut cg)
    emit(&mut cg, "  " + buf + " = call ptr @malloc(i64 " + cap + ")\n")
    emit(&mut cg, "  call ptr @memcpy(ptr " + buf + ", ptr " + pv + ", i64 " + len + ")\n")
    let nul = nextTemp(&mut cg)
    emit(&mut cg, "  " + nul + " = getelementptr i8, ptr " + buf + ", i64 " + len + "\n")
    emit(&mut cg, "  store i8 0, ptr " + nul + "\n")
    let s0 = nextTemp(&mut cg)
    emit(&mut cg, "  " + s0 + " = insertvalue %String zeroinitializer, ptr " + buf + ", 0\n")
    let s1 = nextTemp(&mut cg)
    emit(&mut cg, "  " + s1 + " = insertvalue %String " + s0 + ", i64 " + len + ", 1\n")
    let s2 = nextTemp(&mut cg)
    emit(&mut cg, "  " + s2 + " = insertvalue %String " + s1 + ", i64 " + cap + ", 2\n")
    return Val {
        v: s2, ty: "string"
    }
}

// strip a leading "Option_" so a candidate's `Option<R>` return yields R
pub fn stripOptionPrefix(s: &string): string {
    if s.len > 7 && s[0] == 79 && s[1] == 112 && s[2] == 116 && s[3] == 105 && s[4] == 111 && s[5] == 110 && s[6] == 95 {
        return s[7..s.len].clone()
    }
    return s.clone()
}

// return type suffix of a "Closure:R" surface type, else ""
pub fn closureRetOf(ty: &string): string {
    // "fn:R" (f=102,n=110,:=58) — fn-typed struct fields/params carry R this way
    if ty.len > 3 && ty[0] == 102 && ty[1] == 110 && ty[2] == 58 {
        return ty[3..ty.len].clone()
    }
    if ty.len < 9 {
        return ""
    }
    // "Closure:" is 8 chars
    if ty[0] == 67 && ty[7] == 58 {
        return ty[8..ty.len].clone()
    }
    return ""
}

// A generic call whose base name has >1 monomorphization can't be resolved by
// prefix alone. Pick the candidate whose param LLVM types match the actual args,
// breaking a closure-return ambiguity (arenaWith_T_{NodeKind,string,…}) by
// matching the closure arg's carried return type against the candidate's ret.
// One matching pass. `intLenient` allows an int-literal arg (defaults to i64) to
// match a differently-sized int param; the strict pass (intLenient=false) is tried
// first so `identity_i64` wins over `identity_i32` for an i64 arg instead of both
// matching and going ambiguous.
pub fn disambiguatePass(cg: &Cgen, base: &string, argVals: &Vec<Val>, argPointees: &Vec<string>, sigs: &Vec<CgFnSig>, intLenient: bool): string {
    var result = base.clone()
    var count = 0
    for si in 0..sigs.len {
        if !nameHasMonoPrefix(sigs[si].name, base) {
            continue
        }
        if sigs[si].paramTys.len != argVals.len {
            continue
        }
        var ok = true
        for pi in 0..argVals.len {
            var pll = llType(resolveTyStr(cg, sigs[si].paramTys[pi]))
            let isRef = pi < sigs[si].paramRefs.len && sigs[si].paramRefs[pi]
            // a ref param is passed as a bare pointer (arg llType "ptr"); when the
            // arg's pointee type is known, match on the POINTEE so `getVal_i64` and
            // `getVal_string` (both `ptr` params) stay distinguishable.
            if isRef && pi < argPointees.len && argPointees[pi].len > 0 {
                let wantSurf = resolveTyStr(cg, sigs[si].paramTys[pi])
                let gotSurf = resolveTyStr(cg, argPointees[pi])
                let want = llType(wantSurf)
                let got = llType(gotSurf)
                if want != got {
                    ok = false
                } else if (isVecTy(wantSurf) || isHashMapTy(wantSurf)) && wantSurf != gotSurf {
                    // llType alone can't tell `&Vec<i32>` from `&Vec<string>` apart — both
                    // collapse to the same "%Vec" runtime shape regardless of element type
                    // (same for %HashMap). Without this, disambiguating `countOf(&Vec<T>)`
                    // over a `Vec<i32>` arg matched BOTH countOf_i32 and countOf_string,
                    // went ambiguous (count>1), and fell back to the unmangled base name —
                    // which was never declared ("use of undefined value '@countOf'").
                    // Compare the resolved surface types (element types included) to
                    // break the tie.
                    ok = false
                }
                continue
            }
            if isRef {
                pll = "ptr"
            }
            let all = llType(resolveTyStr(cg, argVals[pi].ty))
            if pll == "%Closure" && all == "%Closure" {
                let cr = closureRetOf(argVals[pi].ty)
                let pr = closureRetOf(sigs[si].paramTys[pi])
                if cr.len > 0 && pr.len > 0 {
                    // match the candidate's closure-PARAM return against the arg's —
                    // distinguishes arenaModify_string ((string)=>string) from _i64.
                    if resolveTyStr(cg, pr) != resolveTyStr(cg, cr) {
                        ok = false
                    }
                } else {
                    // fallback (arenaWith-style): candidate returns Option<R>; match R
                    let candR = stripOptionPrefix(resolveTyStr(cg, sigs[si].retTy))
                    if cr.len > 0 && candR != cr {
                        ok = false
                    }
                }
            } else if pll != all {
                if intLenient && isIntLlType(pll) && isIntLlType(all) {
                    // ok — int coercion (lenient pass only)
                } else {
                    ok = false
                }
            }
        }
        if ok {
            result = sigs[si].name.clone()
            count = count + 1
        }
    }
    if count == 1 {
        return result
    }
    return base.clone()
}

// True if `e` is a bare top-level function name (not a local variable) — i.e. a
// value that denotes a function, eligible to pass as a raw fn pointer.
// Emit (once) the itable global for a concrete type's implementation of an
// interface: `@itable.<Concrete>.<Iface> = constant [N x ptr] [ptr @m0, …]`, method
// pointers in the interface's declared method order. Returns the global name.
pub fn ensureItable(cg: &mut Cgen, concrete: &string, iface: &string): string {
    let gname = "@itable." + concrete.clone() + "." + iface.clone()
    let key = concrete.clone() + "." + iface.clone()
    if cg.itableEmitted.contains(key) {
        return gname
    }
    cg.itableEmitted.insert(key, true)
    let methods = cg.structs.get(iface.clone())!
    let n = methods.len
    var body = "["
    for mi in 0..n {
        if mi > 0 {
            body = body + ", "
        }
        let mname = methods[mi].name.clone()
        // resolve the concrete's method: Concrete$Iface$m, Concrete$m, or a scan
        var mfn = concrete.clone() + "$" + iface.clone() + "$" + mname.clone()
        if !cg.fnRets.contains(mfn) {
            mfn = concrete.clone() + "$" + mname.clone()
            if !cg.fnRets.contains(mfn) {
                for ik, iv in cg.fnRets {
                    if ik.startsWith(concrete + "$") && ik.endsWith("$" + mname) {
                        mfn = ik.clone()
                    }
                }
            }
        }
        body = body + "ptr @" + mfn
    }
    body = body + "]"
    emitG(&mut cg, gname + " = private unnamed_addr constant [" + n.toString() + " x ptr] " + body + "\n")
    return gname
}

// A receiver that denotes storage (re-evaluating it is side-effect-free and yields
// the same address). Anything else (a fn-call result, etc.) must NOT be re-evaluated.
pub fn isSimpleLvalue(e: &ExprNode): bool {
    match e.kind {
        Expr.Ident(nm) => {
            return true
        }
        Expr.FieldAccess(o, f) => {
            return true
        }
        Expr.IndexAccess(o, ix) => {
            return true
        }
        _ => {
            return false
        }
    }
}

pub fn isBareFnName(cg: &Cgen, e: &ExprNode, locs: &Vec<Local>): bool {
    match e.kind {
        Expr.Ident(nm) => {
            return !hasLocal(locs, nm) && cg.fnRets.contains(nm)
        }
        _ => {
            return false
        }
    }
}

pub fn disambiguateGenericCall(cg: &Cgen, base: &string, argVals: &Vec<Val>, argPointees: &Vec<string>, sigs: &Vec<CgFnSig>): string {
    // exact-type match first; only if that's ambiguous/absent try int-width coercion
    let strict = disambiguatePass(cg, base, argVals, argPointees, sigs, false)
    if strict != base {
        return strict
    }
    return disambiguatePass(cg, base, argVals, argPointees, sigs, true)
}

// A no-arg generic call (`arenaNew<T>()`) can't be disambiguated by arg types —
// pick the monomorphization whose return type matches the expected-type hint.
pub fn disambiguateByReturn(cg: &Cgen, base: &string, hint: &string): string {
    let want = resolveTyStr(cg, stripPercent(hint))
    var result = base.clone()
    var count = 0
    for k, v in cg.fnRets {
        if !nameHasMonoPrefix(k, base) {
            continue
        }
        if resolveTyStr(cg, v) == want {
            result = k.clone()
            count = count + 1
        }
    }
    if count == 1 {
        return result
    }
    return base.clone()
}

// Emit an extern call whose signature crosses the C ABI with a by-value struct.
// argVals hold the Milo-level arguments (struct args are whole %T values); here each
// is reinterpreted into the register/indirect/sret form the ABI demands, matching the
// lowered declare from emit.milo. Ports src/codegen.ts emitExternAbiCall.
pub fn emitExternAbiCall(cg: &mut Cgen, name: &string, argVals: &Vec<Val>, paramHints: &Vec<string>, paramRefs: &Vec<bool>): Val {
    let retSurface = resolveTyStr(cg, lookupFnRet(cg, name))
    let retLl = llType(retSurface)
    let retRaw = stripPercent(retLl)
    var retKind = "direct"
    var callRetTy = retLl.clone() // the LLVM type the call itself returns
    var retContainer: i64 = 0
    var sretName = ""
    var sretAlign: i64 = 0
    if retLl.len > 0 && retLl[0] == 37 && cg.structs.contains(retRaw) && !cg.interfaces.contains(retRaw) {
        let rc = classifyRet(cg.arch, abiStructOf(cg, retRaw))
        retKind = rc.kind.clone()
        if rc.kind == "sret" {
            sretName = rc.name.clone()
            sretAlign = rc.align
            callRetTy = "void"
        } else if rc.kind == "coerce" {
            callRetTy = rc.retTy.clone()
            retContainer = rc.container
        }
    }

    var finalArgs: Vec<string> = Vec.new()
    var sretAlloca = ""
    if retKind == "sret" {
        sretAlloca = nextTemp(&mut cg)
        emit(&mut cg, "  " + sretAlloca + " = alloca %" + sretName.clone() + "\n")
        finalArgs.push("ptr sret(%" + sretName.clone() + ") align " + sretAlign.toString() + " " + sretAlloca.clone())
    }

    for i in 0..argVals.len {
        let avTy = argVals[i].ty.clone()
        let avV = argVals[i].v.clone()
        var structParam = false
        if i < paramHints.len {
            let pr = stripPercent(paramHints[i])
            let isRef = i < paramRefs.len && paramRefs[i]
            if !isRef && cg.structs.contains(pr) && !cg.interfaces.contains(pr) {
                structParam = true
            }
        }
        if !structParam {
            finalArgs.push(llType(avTy) + " " + avV)
            continue
        }
        let structLl = llType(avTy)
        let sname = stripPercent(structLl)
        let ac = classifyArg(cg.arch, abiStructOf(cg, sname))
        if ac.kind == "coerce" {
            let buf = nextTemp(&mut cg)
            emit(&mut cg, "  " + buf + " = alloca [" + (ac.container / 8).toString() + " x i64]\n")
            emit(&mut cg, "  store " + structLl.clone() + " " + avV + ", ptr " + buf + "\n")
            for r in 0..ac.regs.len {
                var p = buf.clone()
                if ac.regs[r].offset != 0 {
                    p = nextTemp(&mut cg)
                    emit(&mut cg, "  " + p + " = getelementptr i8, ptr " + buf + ", i64 " + ac.regs[r].offset.toString() + "\n")
                }
                let lv = nextTemp(&mut cg)
                emit(&mut cg, "  " + lv + " = load " + ac.regs[r].ty.clone() + ", ptr " + p + "\n")
                finalArgs.push(ac.regs[r].ty.clone() + " " + lv)
            }
        } else {
            let buf = nextTemp(&mut cg)
            emit(&mut cg, "  " + buf + " = alloca %" + ac.name.clone() + "\n")
            emit(&mut cg, "  store " + structLl.clone() + " " + avV + ", ptr " + buf + "\n")
            if ac.byval {
                finalArgs.push("ptr byval(%" + ac.name.clone() + ") align " + ac.align.toString() + " " + buf)
            } else {
                finalArgs.push("ptr " + buf)
            }
        }
    }

    var argStr = ""
    for i in 0..finalArgs.len {
        if i > 0 {
            argStr = argStr + ", "
        }
        argStr = argStr + finalArgs[i].clone()
    }

    if retKind == "sret" {
        emit(&mut cg, "  call void @" + name.clone() + "(" + argStr + ")\n")
        let v = nextTemp(&mut cg)
        emit(&mut cg, "  " + v + " = load %" + sretName.clone() + ", ptr " + sretAlloca.clone() + "\n")
        return Val {
            v: v, ty: retSurface
        }
    }
    if retKind == "coerce" {
        let raw = nextTemp(&mut cg)
        emit(&mut cg, "  " + raw + " = call " + callRetTy.clone() + " @" + name.clone() + "(" + argStr + ")\n")
        let buf = nextTemp(&mut cg)
        emit(&mut cg, "  " + buf + " = alloca [" + (retContainer / 8).toString() + " x i64]\n")
        emit(&mut cg, "  store " + callRetTy.clone() + " " + raw + ", ptr " + buf + "\n")
        let v = nextTemp(&mut cg)
        emit(&mut cg, "  " + v + " = load " + retLl.clone() + ", ptr " + buf + "\n")
        return Val {
            v: v, ty: retSurface
        }
    }
    if callRetTy == "void" {
        emit(&mut cg, "  call void @" + name.clone() + "(" + argStr + ")\n")
        return Val {
            v: "0", ty: "void"
        }
    }
    let t = nextTemp(&mut cg)
    emit(&mut cg, "  " + t + " = call " + callRetTy.clone() + " @" + name.clone() + "(" + argStr + ")\n")
    return Val {
        v: t, ty: retSurface
    }
}

// Does this expression denote existing storage, or is it a freshly materialized value?
// Only the latter may be freed after being lent to a callee. Conservative: anything not
// positively recognized as a temporary counts as a place and is left alone, because
// freeing a place would be a use-after-free of the caller's own data.
// Free the string temporaries lent to a call. cap==0 marks a literal living in .rodata,
// which must never be freed — the same sentinel genStringPush already relies on.
pub fn emitTempFrees(cg: &mut Cgen, frees: &Vec<string>) {
    if frees.len == 0 {
        return
    }
    ensureFree(&mut cg)
    for i in 0..frees.len {
        let parts = frees[i].split("|")
        if parts.len == 2 {
            let skipLbl = nextLabel(&mut cg, "tmpfree.skip")
            let doLbl = nextLabel(&mut cg, "tmpfree.do")
            let isHeap = nextTemp(&mut cg)
            emit(&mut cg, "  " + isHeap + " = icmp ne i64 " + parts[1].clone() + ", 0\n")
            emit(&mut cg, "  br i1 " + isHeap + ", label %" + doLbl.clone() + ", label %" + skipLbl.clone() + "\n")
            emitLabel(&mut cg, doLbl)
            emit(&mut cg, "  call void @free(ptr " + parts[0].clone() + ")\n")
            emit(&mut cg, "  br label %" + skipLbl.clone() + "\n")
            emitLabel(&mut cg, skipLbl)
        }
    }
}

pub fn isPlaceExprForFree(e: &ExprNode): bool {
    match e.kind {
        Expr.BinOp(op, l, r) => {
            // A concat builds a fresh buffer; every other binop on strings does too.
            return false
        }
        Expr.MethodCall(o, m, a) => {
            return false
        }
        Expr.Call(n, a, ta) => {
            return false
        }
        _ => {
            return true
        }
    }
}

// A string operand the compiler already knows the value of: a literal, or the
// `@targetOs()` builtin, which is a constant for the whole compilation.
fn constString(cg: &Cgen, e: &ExprNode): Option<string> {
    match e.kind {
        Expr.StringLit(v) => {
            return Option.Some(v.clone())
        }
        Expr.Call(name, args, typeArgs) => {
            if name == "targetOs" && args.len == 0 {
                return Option.Some(cg.targetOs.clone())
            }
            return Option.None
        }
        _ => {
            return Option.None
        }
    }
}

fn foldIsTrue(o: &Option<bool>): bool {
    match o {
        Option.Some(v) => {
            return v
        }
        Option.None => {
            return false
        }
    }
}

fn foldIsFalse(o: &Option<bool>): bool {
    match o {
        Option.Some(v) => {
            return !v
        }
        Option.None => {
            return false
        }
    }
}

// Compile-time value of a condition that rests entirely on constants — the
// `@targetOs() == "…"` case, plus !/&&/|| over such values. None means "not
// statically known", i.e. the ordinary runtime path. Deliberately conservative:
// only constant operands fold, so no runtime condition is ever short-circuited
// by accident.
pub fn constFoldBool(cg: &Cgen, e: &ExprNode): Option<bool> {
    match e.kind {
        Expr.BoolLit(v) => {
            return Option.Some(v)
        }
        Expr.UnaryOp(op, operand) => {
            if op == "!" {
                match constFoldBool(cg, *operand) {
                    Option.Some(inner) => {
                        return Option.Some(!inner)
                    }
                    Option.None => {
                        return Option.None
                    }
                }
            }
            return Option.None
        }
        Expr.BinOp(op, l, r) => {
            if op == "&&" {
                let lb = constFoldBool(cg, *l)
                let rb = constFoldBool(cg, *r)
                // One statically-false side settles it even when the other is
                // unknown — matches the short-circuit the runtime would do.
                if foldIsFalse(lb) || foldIsFalse(rb) {
                    return Option.Some(false)
                }
                if foldIsTrue(lb) && foldIsTrue(rb) {
                    return Option.Some(true)
                }
                return Option.None
            }
            if op == "||" {
                let lb = constFoldBool(cg, *l)
                let rb = constFoldBool(cg, *r)
                if foldIsTrue(lb) || foldIsTrue(rb) {
                    return Option.Some(true)
                }
                if foldIsFalse(lb) && foldIsFalse(rb) {
                    return Option.Some(false)
                }
                return Option.None
            }
            if op == "==" || op == "!=" {
                let ls = constString(cg, *l)
                let rs = constString(cg, *r)
                match ls {
                    Option.Some(lv) => {
                        match rs {
                            Option.Some(rv) => {
                                if op == "==" {
                                    return Option.Some(lv == rv)
                                }
                                return Option.Some(lv != rv)
                            }
                            Option.None => {
                            }
                        }
                    }
                    Option.None => {
                    }
                }
                let lb = constFoldBool(cg, *l)
                let rb = constFoldBool(cg, *r)
                match lb {
                    Option.Some(lv) => {
                        match rb {
                            Option.Some(rv) => {
                                if op == "==" {
                                    return Option.Some(lv == rv)
                                }
                                return Option.Some(lv != rv)
                            }
                            Option.None => {
                            }
                        }
                    }
                    Option.None => {
                    }
                }
                return Option.None
            }
            return Option.None
        }
        _ => {
            return Option.None
        }
    }
}

pub fn genCall(cg: &mut Cgen, name: &string, args: &Vec<Heap<ExprNode>>, typeArgs: &Vec<MiloType>, locs: &Vec<Local>, sigs: &Vec<CgFnSig>, hintTy: &string, callSpan: &Option<Span>): Val {
    if name == "format" {
        return genFormat(&mut cg, args, locs, sigs)
    }
    if name == "jsonStringify" && args.len == 1 {
        return genJsonStringify(&mut cg, *args[0], locs, sigs)
    }
    // embedFile("path"): read the file at compile time (relative to the source
    // dir) and emit its contents as a string literal.
    if name == "targetOs" && args.len == 0 {
        return genStringLit(&mut cg, cg.targetOs.clone())
    }
    if name == "embedFile" && args.len == 1 {
        var path = ""
        // Resolve against the file CONTAINING the call, not the entry file: an
        // imported module embedding "bodies/x.png" means its own bodies/x.png.
        // cg.sourceDir is the entry's directory, so it points at the wrong tree
        // the moment the embedding module is reached through an import from
        // another directory. Mirrors the oracle's lower.ts, which uses span.file.
        var callerDir = cg.sourceDir.clone()
        match (*args[0]).kind {
            Expr.StringLit(s) => {
                path = s.clone()
                match (*args[0]).span {
                    Option.Some(spn) => {
                        if spn.file.len > 0 {
                            callerDir = Path.dirname(spn.file)
                        }
                    }
                    Option.None => {
                    }
                }
            }
            _ => {
            }
        }
        var full = path.clone()
        if callerDir.len > 0 {
            full = callerDir.clone() + "/" + path.clone()
        }
        var contents = ""
        match readFile(full.clone()) {
            Result.Ok(c) => {
                contents = c
            }
            Result.Err(e) => {
                eprint("error: embedFile cannot open '" + path + "'")
                exit(1)
            }
        }
        return genStringLit(&mut cg, contents)
    }
    // Same user-function-shadows-builtin guard as the checker (checkCall's "flush"
    // branch) — without it, a module-private `fn flush(...)` sharing this name gets
    // silently rewired to fflush(NULL) instead of its own body being called.
    if name == "flush" && !cg.fnRets.contains(name) {
        if !cg.declaredFflush {
            emitG(&mut cg, "declare i32 @fflush(ptr)\n")
            cg.declaredFflush = true
        }
        let fc = nextTemp(&mut cg)
        emit(&mut cg, "  " + fc + " = call i32 @fflush(ptr null)\n")
        return Val {
            v: "0", ty: "void"
        }
    }
    // Promise(fn) → Promise_<R>$run(fn), R recovered from the closure's carried type.
    if name == "Promise" && !cg.fnRets.contains("Promise") && args.len == 1 {
        let clv = genExpr(&mut cg, *args[0], locs, sigs, "")
        let rt = closureRetOf(clv.ty)
        if rt.len > 0 {
            let runName = "Promise_" + rt + "$run"
            let retTy = resolveTyStr(cg, lookupFnRet(cg, runName))
            let retLl = llType(retTy)
            let t = nextTemp(&mut cg)
            emit(&mut cg, "  " + t + " = call " + retLl + " @" + runName + "(%Closure " + clv.v + ")\n")
            return Val {
                v: t, ty: retTy
            }
        }
    }
    // assert(cond[, msg]): on false, print to stderr and exit(1); no-op when true.
    // built-in assert only when no real `assert` is in scope (std/testing defines
    // its own 1-arg assert with failure counting — don't shadow it).
    // forget(x): evaluate the operand for its effects and drop the value on the floor.
    // Suppressing a drop is a no-op while this compiler emits no owning-closure drop
    // glue to suppress; the call still has to CODEGEN, or std/runtime.milo cannot build.
    if name == "forget" && !cg.fnRets.contains("forget") {
        genExpr(&mut cg, *args[0], locs, sigs, "")
        return Val {
            v: "0", ty: "void"
        }
    }
    if name == "assert" && !cg.fnRets.contains("assert") {
        let cv = genExpr(&mut cg, *args[0], locs, sigs, "bool")
        let okLbl = nextLabel(&mut cg, "assert.ok")
        let failLbl = nextLabel(&mut cg, "assert.fail")
        emit(&mut cg, "  br i1 " + cv.v + ", label %" + okLbl + ", label %" + failLbl + "\n")
        emit(&mut cg, failLbl + ":\n")
        if !cg.declaredDprintf {
            emitG(&mut cg, "declare i32 @dprintf(i32, ptr, ...)\n")
            cg.declaredDprintf = true
        }
        if args.len >= 2 {
            let mv = genExpr(&mut cg, *args[1], locs, sigs, "string")
            let mp = nextTemp(&mut cg)
            emit(&mut cg, "  " + mp + " = extractvalue %String " + mv.v + ", 0\n")
            let fl = emitStringLit(&mut cg, "assertion failed: %s\n")
            emit(&mut cg, "  call i32 (i32, ptr, ...) @dprintf(i32 2, ptr " + fl + ", ptr " + mp + ")\n")
        } else {
            let fl = emitStringLit(&mut cg, "assertion failed\n")
            emit(&mut cg, "  call i32 (i32, ptr, ...) @dprintf(i32 2, ptr " + fl + ")\n")
        }
        ensureExit(&mut cg)
        emit(&mut cg, "  call void @exit(i32 1)\n")
        emit(&mut cg, "  unreachable\n")
        emit(&mut cg, okLbl + ":\n")
        return Val {
            v: "0", ty: "void"
        }
    }
    // sizeOf<T>() — byte size of the instantiated type
    if name == "sizeOf" && typeArgs.len == 1 {
        let ll = llType(resolveAstTy(cg, typeArgs[0]))
        let sz = genSizeOf(&mut cg, ll)
        return Val {
            v: sz, ty: "i64"
        }
    }
    // offsetOf<T>("field") — byte offset of a field within a struct type
    if name == "offsetOf" && typeArgs.len == 1 && args.len == 1 {
        let sname = stripPercent(resolveAstTy(cg, typeArgs[0]))
        var fieldName = ""
        match (*args[0]).kind {
            Expr.StringLit(s) => {
                fieldName = s.clone()
            }
            _ => {
            }
        }
        let off = structFieldOffset(cg, sname, fieldName)
        return Val {
            v: off.toString(), ty: "i64"
        }
    }
    // zeroed<T>() — llvm zeroinitializer of the instantiated type
    if name == "zeroed" && typeArgs.len == 1 {
        let zt = resolveAstTy(cg, typeArgs[0])
        return Val {
            v: "zeroinitializer", ty: zt
        }
    }
    // Built-in Heap(expr) — the box takes ownership of the value, so move it
    // (zero the source place) or a later reassign/scope drop double-frees it.
    if name == "Heap" {
        let inner = genOwnedArg(&mut cg, *args[0], "", locs, sigs)
        let innerLl = llType(inner.ty)
        let szPtr = nextTemp(&mut cg)
        emit(&mut cg, "  " + szPtr + " = getelementptr " + innerLl + ", ptr null, i32 1\n")
        let szInt = nextTemp(&mut cg)
        emit(&mut cg, "  " + szInt + " = ptrtoint ptr " + szPtr + " to i64\n")
        ensureMalloc(&mut cg)
        let boxPtr = nextTemp(&mut cg)
        emit(&mut cg, "  " + boxPtr + " = call ptr @malloc(i64 " + szInt + ")\n")
        emit(&mut cg, "  store " + innerLl + " " + inner.v + ", ptr " + boxPtr + "\n")
        // carry the element type so `*box` derefs to the right type (was "ptr",
        // which made a string box's deref load an i64 and print the data pointer)
        return Val {
            v: boxPtr, ty: "Heap<" + inner.ty + ">"
        }
    }

    // replace(place, value): move `value` into place, return the previous occupant.
    // The checker enforces the move/borrow rules; codegen is a plain load-then-store.
    if name == "replace" {
        let rlv = genLvalue(&mut cg, *args[0], locs, sigs)
        let rll = llType(rlv.ty)
        let rold = nextTemp(&mut cg)
        emit(&mut cg, "  " + rold + " = load " + rll + ", ptr " + rlv.v + "\n")
        let rnew = genExpr(&mut cg, *args[1], locs, sigs, rlv.ty.clone())
        emit(&mut cg, "  store " + rll + " " + rnew.v + ", ptr " + rlv.v + "\n")
        return Val {
            v: rold, ty: rlv.ty
        }
    }
    // swap(a, b): exchange the contents of two places of the same type.
    if name == "swap" {
        let slva = genLvalue(&mut cg, *args[0], locs, sigs)
        let slvb = genLvalue(&mut cg, *args[1], locs, sigs)
        let sll = llType(slva.ty)
        let sva = nextTemp(&mut cg)
        emit(&mut cg, "  " + sva + " = load " + sll + ", ptr " + slva.v + "\n")
        let svb = nextTemp(&mut cg)
        emit(&mut cg, "  " + svb + " = load " + sll + ", ptr " + slvb.v + "\n")
        emit(&mut cg, "  store " + sll + " " + svb + ", ptr " + slva.v + "\n")
        emit(&mut cg, "  store " + sll + " " + sva + ", ptr " + slvb.v + "\n")
        return Val {
            v: "0", ty: "void"
        }
    }
    // _cstrToString(ptr): copy a NUL-terminated C string into an owned %String.
    if name == "_cstrToString" {
        let cstrp = genExpr(&mut cg, *args[0], locs, sigs, "")
        return genCstrToString(&mut cg, cstrp.v)
    }
    // _bytesToString(ptr, len): copy an explicit-length byte run into an owned
    // %String (std/io's readAll — the length comes from a read count, not a NUL).
    // Same layout as _cstrToString (len+1 with trailing NUL) so the result can
    // still be handed to C without another copy.
    if name == "_bytesToString" {
        let btsp = genExpr(&mut cg, *args[0], locs, sigs, "")
        let btsl = genExpr(&mut cg, *args[1], locs, sigs, "i64")
        ensureStringTy(&mut cg)
        ensureMalloc(&mut cg)
        ensureMemcpy(&mut cg)
        let btscap = nextTemp(&mut cg)
        emit(&mut cg, "  " + btscap + " = add i64 " + btsl.v + ", 1\n")
        let btsbuf = nextTemp(&mut cg)
        emit(&mut cg, "  " + btsbuf + " = call ptr @malloc(i64 " + btscap + ")\n")
        emit(&mut cg, "  call ptr @memcpy(ptr " + btsbuf + ", ptr " + btsp.v + ", i64 " + btsl.v + ")\n")
        let btsnul = nextTemp(&mut cg)
        emit(&mut cg, "  " + btsnul + " = getelementptr i8, ptr " + btsbuf + ", i64 " + btsl.v + "\n")
        emit(&mut cg, "  store i8 0, ptr " + btsnul + "\n")
        let bts0 = nextTemp(&mut cg)
        emit(&mut cg, "  " + bts0 + " = insertvalue %String zeroinitializer, ptr " + btsbuf + ", 0\n")
        let bts1 = nextTemp(&mut cg)
        emit(&mut cg, "  " + bts1 + " = insertvalue %String " + bts0 + ", i64 " + btsl.v + ", 1\n")
        let bts2 = nextTemp(&mut cg)
        emit(&mut cg, "  " + bts2 + " = insertvalue %String " + bts1 + ", i64 " + btscap + ", 2\n")
        return Val {
            v: bts2, ty: "string"
        }
    }
    // Runtime-support builtins (mirror the TS oracle's intrinsics).
    if name == "_miloArgCount" {
        let macraw = nextTemp(&mut cg)
        emit(&mut cg, "  " + macraw + " = load i32, ptr @_milo_argc_global\n")
        let macext = nextTemp(&mut cg)
        emit(&mut cg, "  " + macext + " = sext i32 " + macraw + " to i64\n")
        return Val {
            v: macext, ty: "i64"
        }
    }
    if name == "_miloArgAt" {
        let maidx = genExpr(&mut cg, *args[0], locs, sigs, "i64")
        let maargv = nextTemp(&mut cg)
        emit(&mut cg, "  " + maargv + " = load ptr, ptr @_milo_argv_global\n")
        let maslot = nextTemp(&mut cg)
        emit(&mut cg, "  " + maslot + " = getelementptr ptr, ptr " + maargv + ", i64 " + maidx.v + "\n")
        let macstr = nextTemp(&mut cg)
        emit(&mut cg, "  " + macstr + " = load ptr, ptr " + maslot + "\n")
        return genCstrToString(&mut cg, macstr)
    }
    if name == "_schedulerGet" {
        let schgv = nextTemp(&mut cg)
        emit(&mut cg, "  " + schgv + " = load ptr, ptr @_milo_scheduler\n")
        return Val {
            v: schgv, ty: "ptr"
        }
    }
    if name == "_schedulerSet" {
        let schsp = genExpr(&mut cg, *args[0], locs, sigs, "")
        emit(&mut cg, "  store ptr " + schsp.v + ", ptr @_milo_scheduler\n")
        return Val {
            v: "0", ty: "void"
        }
    }
    if name == "_callClosureVoid" {
        let fnPtr = genExpr(&mut cg, *args[0], locs, sigs, "")
        let envPtr = genExpr(&mut cg, *args[1], locs, sigs, "")
        emit(&mut cg, "  call void " + fnPtr.v + "(ptr " + envPtr.v + ")\n")
        return Val {
            v: "0", ty: "void"
        }
    }
    if name == "_loadU8" {
        let lu8p = genExpr(&mut cg, *args[0], locs, sigs, "")
        let lu8v = nextTemp(&mut cg)
        emit(&mut cg, "  " + lu8v + " = load i8, ptr " + lu8p.v + "\n")
        return Val {
            v: lu8v, ty: "u8"
        }
    }
    if name == "_loadI32" {
        let li32p = genExpr(&mut cg, *args[0], locs, sigs, "")
        let li32v = nextTemp(&mut cg)
        emit(&mut cg, "  " + li32v + " = load i32, ptr " + li32p.v + "\n")
        return Val {
            v: li32v, ty: "i32"
        }
    }
    if name == "_strDataPtr" {
        // The ADDRESS of the %String, not its value. genExpr on a `&string` parameter
        // yields the loaded aggregate, and GEPing that emits
        // `getelementptr %String, ptr <an SSA %String>` — invalid IR, so any function
        // taking `s: &string` and asking for its data pointer failed to compile.
        let sdp = genLvalue(&mut cg, *args[0], locs, sigs)
        let sdg = nextTemp(&mut cg)
        emit(&mut cg, "  " + sdg + " = getelementptr %String, ptr " + sdp.v + ", i32 0, i32 0\n")
        let sdd = nextTemp(&mut cg)
        emit(&mut cg, "  " + sdd + " = load ptr, ptr " + sdg + "\n")
        return Val {
            v: sdd, ty: "ptr"
        }
    }
    if name == "_atomicLoadI64" {
        let alip = genExpr(&mut cg, *args[0], locs, sigs, "")
        let aliv = nextTemp(&mut cg)
        emit(&mut cg, "  " + aliv + " = load atomic i64, ptr " + alip.v + " seq_cst, align 8\n")
        return Val {
            v: aliv, ty: "i64"
        }
    }
    if name == "_atomicStoreI64" {
        let asip = genExpr(&mut cg, *args[0], locs, sigs, "")
        let asiv = genExpr(&mut cg, *args[1], locs, sigs, "i64")
        emit(&mut cg, "  store atomic i64 " + asiv.v + ", ptr " + asip.v + " seq_cst, align 8\n")
        return Val {
            v: "0", ty: "void"
        }
    }
    if name == "_atomicAddI64" {
        let aaip = genExpr(&mut cg, *args[0], locs, sigs, "")
        let aaiv = genExpr(&mut cg, *args[1], locs, sigs, "i64")
        let aaio = nextTemp(&mut cg)
        emit(&mut cg, "  " + aaio + " = atomicrmw add ptr " + aaip.v + ", i64 " + aaiv.v + " seq_cst, align 8\n")
        return Val {
            v: aaio, ty: "i64"
        }
    }
    if name == "_atomicSubI64" {
        let asubp = genExpr(&mut cg, *args[0], locs, sigs, "")
        let asubv = genExpr(&mut cg, *args[1], locs, sigs, "i64")
        let asubo = nextTemp(&mut cg)
        emit(&mut cg, "  " + asubo + " = atomicrmw sub ptr " + asubp.v + ", i64 " + asubv.v + " seq_cst, align 8\n")
        return Val {
            v: asubo, ty: "i64"
        }
    }
    if name == "_atomicCasI64" {
        let acp = genExpr(&mut cg, *args[0], locs, sigs, "")
        let ace = genExpr(&mut cg, *args[1], locs, sigs, "i64")
        let acd = genExpr(&mut cg, *args[2], locs, sigs, "i64")
        let acpair = nextTemp(&mut cg)
        emit(&mut cg, "  " + acpair + " = cmpxchg ptr " + acp.v + ", i64 " + ace.v + ", i64 " + acd.v + " seq_cst seq_cst, align 8\n")
        let aco = nextTemp(&mut cg)
        emit(&mut cg, "  " + aco + " = extractvalue { i64, i1 } " + acpair + ", 0\n")
        return Val {
            v: aco, ty: "i64"
        }
    }
    if name == "_atomicLoadBool" {
        let albp = genExpr(&mut cg, *args[0], locs, sigs, "")
        let albraw = nextTemp(&mut cg)
        emit(&mut cg, "  " + albraw + " = load atomic i8, ptr " + albp.v + " seq_cst, align 1\n")
        let albv = nextTemp(&mut cg)
        emit(&mut cg, "  " + albv + " = trunc i8 " + albraw + " to i1\n")
        return Val {
            v: albv, ty: "bool"
        }
    }
    if name == "_atomicStoreBool" {
        let asbp = genExpr(&mut cg, *args[0], locs, sigs, "")
        let asbb = genExpr(&mut cg, *args[1], locs, sigs, "bool")
        let asbe = nextTemp(&mut cg)
        emit(&mut cg, "  " + asbe + " = zext i1 " + asbb.v + " to i8\n")
        emit(&mut cg, "  store atomic i8 " + asbe + ", ptr " + asbp.v + " seq_cst, align 1\n")
        return Val {
            v: "0", ty: "void"
        }
    }
    if name == "_atomicSwapBool" {
        let aswp = genExpr(&mut cg, *args[0], locs, sigs, "")
        let aswb = genExpr(&mut cg, *args[1], locs, sigs, "bool")
        let aswe = nextTemp(&mut cg)
        emit(&mut cg, "  " + aswe + " = zext i1 " + aswb.v + " to i8\n")
        let aswo = nextTemp(&mut cg)
        emit(&mut cg, "  " + aswo + " = atomicrmw xchg ptr " + aswp.v + ", i8 " + aswe + " seq_cst, align 1\n")
        let aswv = nextTemp(&mut cg)
        emit(&mut cg, "  " + aswv + " = trunc i8 " + aswo + " to i1\n")
        return Val {
            v: aswv, ty: "bool"
        }
    }
    if name == "_atomicCasBool" {
        let acbp = genExpr(&mut cg, *args[0], locs, sigs, "")
        let acbe = genExpr(&mut cg, *args[1], locs, sigs, "bool")
        let acbd = genExpr(&mut cg, *args[2], locs, sigs, "bool")
        let acbee = nextTemp(&mut cg)
        emit(&mut cg, "  " + acbee + " = zext i1 " + acbe.v + " to i8\n")
        let acbde = nextTemp(&mut cg)
        emit(&mut cg, "  " + acbde + " = zext i1 " + acbd.v + " to i8\n")
        let acbpair = nextTemp(&mut cg)
        emit(&mut cg, "  " + acbpair + " = cmpxchg ptr " + acbp.v + ", i8 " + acbee + ", i8 " + acbde + " seq_cst seq_cst, align 1\n")
        let acbo = nextTemp(&mut cg)
        emit(&mut cg, "  " + acbo + " = extractvalue { i8, i1 } " + acbpair + ", 0\n")
        let acbv = nextTemp(&mut cg)
        emit(&mut cg, "  " + acbv + " = trunc i8 " + acbo + " to i1\n")
        return Val {
            v: acbv, ty: "bool"
        }
    }
    // i64-width swap — same rmw-xchg shape as _atomicAddI64/_atomicSubI64 above,
    // just missing until now (fell through to the generic call path, which
    // defaulted the return type to i32 and emitted an invalid i32->i64 trunc).
    if name == "_atomicSwapI64" {
        let aswip = genExpr(&mut cg, *args[0], locs, sigs, "")
        let aswiv = genExpr(&mut cg, *args[1], locs, sigs, "i64")
        let aswio = nextTemp(&mut cg)
        emit(&mut cg, "  " + aswio + " = atomicrmw xchg ptr " + aswip.v + ", i64 " + aswiv.v + " seq_cst, align 8\n")
        return Val {
            v: aswio, ty: "i64"
        }
    }
    if name == "_atomicLoadI32" {
        let ali32p = genExpr(&mut cg, *args[0], locs, sigs, "")
        let ali32v = nextTemp(&mut cg)
        emit(&mut cg, "  " + ali32v + " = load atomic i32, ptr " + ali32p.v + " seq_cst, align 4\n")
        return Val {
            v: ali32v, ty: "i32"
        }
    }
    if name == "_atomicStoreI32" {
        let asi32p = genExpr(&mut cg, *args[0], locs, sigs, "")
        let asi32v = genExpr(&mut cg, *args[1], locs, sigs, "i32")
        emit(&mut cg, "  store atomic i32 " + asi32v.v + ", ptr " + asi32p.v + " seq_cst, align 4\n")
        return Val {
            v: "0", ty: "void"
        }
    }
    if name == "_atomicAddI32" {
        let aai32p = genExpr(&mut cg, *args[0], locs, sigs, "")
        let aai32v = genExpr(&mut cg, *args[1], locs, sigs, "i32")
        let aai32o = nextTemp(&mut cg)
        emit(&mut cg, "  " + aai32o + " = atomicrmw add ptr " + aai32p.v + ", i32 " + aai32v.v + " seq_cst, align 4\n")
        return Val {
            v: aai32o, ty: "i32"
        }
    }
    if name == "_atomicSubI32" {
        let asubi32p = genExpr(&mut cg, *args[0], locs, sigs, "")
        let asubi32v = genExpr(&mut cg, *args[1], locs, sigs, "i32")
        let asubi32o = nextTemp(&mut cg)
        emit(&mut cg, "  " + asubi32o + " = atomicrmw sub ptr " + asubi32p.v + ", i32 " + asubi32v.v + " seq_cst, align 4\n")
        return Val {
            v: asubi32o, ty: "i32"
        }
    }
    if name == "_atomicSwapI32" {
        let aswi32p = genExpr(&mut cg, *args[0], locs, sigs, "")
        let aswi32v = genExpr(&mut cg, *args[1], locs, sigs, "i32")
        let aswi32o = nextTemp(&mut cg)
        emit(&mut cg, "  " + aswi32o + " = atomicrmw xchg ptr " + aswi32p.v + ", i32 " + aswi32v.v + " seq_cst, align 4\n")
        return Val {
            v: aswi32o, ty: "i32"
        }
    }
    if name == "_atomicCasI32" {
        let aci32p = genExpr(&mut cg, *args[0], locs, sigs, "")
        let aci32e = genExpr(&mut cg, *args[1], locs, sigs, "i32")
        let aci32d = genExpr(&mut cg, *args[2], locs, sigs, "i32")
        let aci32pair = nextTemp(&mut cg)
        emit(&mut cg, "  " + aci32pair + " = cmpxchg ptr " + aci32p.v + ", i32 " + aci32e.v + ", i32 " + aci32d.v + " seq_cst seq_cst, align 4\n")
        let aci32o = nextTemp(&mut cg)
        emit(&mut cg, "  " + aci32o + " = extractvalue { i32, i1 } " + aci32pair + ", 0\n")
        return Val {
            v: aci32o, ty: "i32"
        }
    }
    // _bytesToString(ptr, len): like _cstrToString but the length is already known
    // (source bytes may contain embedded NULs), matching the oracle's layout —
    // len+1 capacity with a trailing NUL so the result can still reach a C API.
    if name == "_bytesToString" {
        ensureStringTy(&mut cg)
        ensureMalloc(&mut cg)
        ensureMemcpy(&mut cg)
        let btsp = genExpr(&mut cg, *args[0], locs, sigs, "")
        let btsl = genExpr(&mut cg, *args[1], locs, sigs, "i64")
        let btscap = nextTemp(&mut cg)
        emit(&mut cg, "  " + btscap + " = add i64 " + btsl.v + ", 1\n")
        let btsbuf = nextTemp(&mut cg)
        emit(&mut cg, "  " + btsbuf + " = call ptr @malloc(i64 " + btscap + ")\n")
        emit(&mut cg, "  call ptr @memcpy(ptr " + btsbuf + ", ptr " + btsp.v + ", i64 " + btsl.v + ")\n")
        let btsnul = nextTemp(&mut cg)
        emit(&mut cg, "  " + btsnul + " = getelementptr i8, ptr " + btsbuf + ", i64 " + btsl.v + "\n")
        emit(&mut cg, "  store i8 0, ptr " + btsnul + "\n")
        let bts0 = nextTemp(&mut cg)
        emit(&mut cg, "  " + bts0 + " = insertvalue %String zeroinitializer, ptr " + btsbuf + ", 0\n")
        let bts1 = nextTemp(&mut cg)
        emit(&mut cg, "  " + bts1 + " = insertvalue %String " + bts0 + ", i64 " + btsl.v + ", 1\n")
        let bts2 = nextTemp(&mut cg)
        emit(&mut cg, "  " + bts2 + " = insertvalue %String " + bts1 + ", i64 " + btscap + ", 2\n")
        return Val {
            v: bts2, ty: "string"
        }
    }
    // _putByte(b): freestanding-friendly single-byte stdout write via putchar.
    if name == "_putByte" {
        ensurePutchar(&mut cg)
        let pbv = genExpr(&mut cg, *args[0], locs, sigs, "u8")
        let pbe = nextTemp(&mut cg)
        emit(&mut cg, "  " + pbe + " = zext i8 " + pbv.v + " to i32\n")
        emit(&mut cg, "  call i32 @putchar(i32 " + pbe + ")\n")
        return Val {
            v: "0", ty: "void"
        }
    }

    // Evaluate arguments. Pass each parameter's declared type as the hint so a
    // generic enum literal in argument position (`error(_, _, Option.None)`)
    // resolves to the right instantiation instead of an unmangled Option$None.
    var paramHints: Vec<string> = Vec.new()
    var paramRefs: Vec<bool> = Vec.new()
    var paramRanges: Vec<RangeAnno> = Vec.new()
    var calleeVariadic = false
    for si in 0..sigs.len {
        if sigs[si].name == name {
            for pi in 0..sigs[si].paramTys.len {
                paramHints.push(resolveTyStr(cg, sigs[si].paramTys[pi]))
            }
            for pi in 0..sigs[si].paramRefs.len {
                paramRefs.push(sigs[si].paramRefs[pi])
            }
            for pi in 0..sigs[si].paramRanges.len {
                paramRanges.push(sigs[si].paramRanges[pi])
            }
            if sigs[si].isVariadic {
                calleeVariadic = true
            }
        }
    }
    var argVals: Vec<Val> = Vec.new()
    // for ref args, the lvalue's pointee type (kept parallel to argVals) so generic
    // disambiguation can tell `&Wrapper<i64>` from `&Wrapper<string>` — both pass as ptr.
    var argPointees: Vec<string> = Vec.new()
    // "<dataPtr>|<cap>" per lent string temporary, freed immediately after the call.
    var tempFrees: Vec<string> = Vec.new()
    for i in 0..args.len {
        var hint = ""
        if i < paramHints.len {
            hint = paramHints[i].clone()
        }
        // A ref param takes the argument's ADDRESS (auto-borrow of an lvalue), so
        // the callee mutates the caller's storage rather than a copy.
        var isRefParam = false
        if i < paramRefs.len {
            isRefParam = paramRefs[i]
        }
        // interface coercion: an `&Interface` param takes a fat pointer {data, itable},
        // not a plain ref. Build it from the concrete arg's address + its itable.
        let hintBase = stripPercent(resolveTyStr(cg, stripPercent(hint)))
        if cg.interfaces.contains(hintBase) {
            let lv = genLvalue(&mut cg, *args[i], locs, sigs)
            let concrete = stripPercent(lv.ty)
            let itab = ensureItable(&mut cg, concrete, hintBase)
            let ifTy = "%" + hintBase.clone()
            let v0 = nextTemp(&mut cg)
            emit(&mut cg, "  " + v0 + " = insertvalue " + ifTy + " undef, ptr " + lv.v + ", 0\n")
            let v1 = nextTemp(&mut cg)
            emit(&mut cg, "  " + v1 + " = insertvalue " + ifTy + " " + v0 + ", ptr " + itab + ", 1\n")
            // an `&Interface` param uses the ref ABI (callee gets a ptr, loads the fat
            // pointer): materialize the fat pointer and pass its address.
            let slot = nextTemp(&mut cg)
            emit(&mut cg, "  " + slot + " = alloca " + ifTy + "\n")
            emit(&mut cg, "  store " + ifTy + " " + v1 + ", ptr " + slot + "\n")
            argVals.push(Val {
                v: slot, ty: "ptr"
            })
            argPointees.push("")
        } else if isRefParam {
            let lv = genLvalueWithHint(&mut cg, *args[i], locs, sigs, hint.clone())
            // A `&mut [u8;N]` (fixed arrays lower to a Vec {ptr,len,cap}) passed to a C
            // extern must decay to its DATA pointer: the C side wants `u8*`, and writing
            // through the header's address would clobber len/cap instead of the buffer.
            if cg.externFns.contains(name) && isVecTy(lv.ty) {
                let loaded = nextTemp(&mut cg)
                emit(&mut cg, "  " + loaded + " = load %Vec, ptr " + lv.v + "\n")
                let dp = nextTemp(&mut cg)
                emit(&mut cg, "  " + dp + " = extractvalue %Vec " + loaded + ", 0\n")
                argVals.push(Val {
                    v: dp, ty: "ptr"
                })
                argPointees.push("")
            } else {
                // A STRING TEMPORARY passed to a `&string` param can be freed right after
                // the call, and this is sound because of second-class references: a `&T`
                // cannot be stored in a struct or returned, so the callee provably holds no
                // copy of it once it returns. Without this every
                // `emit(cg, "  " + a + " = " + b)` leaks its intermediates — measured at
                // ~0.8 MB retained per source line, which is what put self-compilation of
                // src-milo past a 4 GB cap.
                if llType(lv.ty) == "%String" && !isPlaceExprForFree(*args[i]) {
                    let dp = nextTemp(&mut cg)
                    emit(&mut cg, "  " + dp + " = getelementptr %String, ptr " + lv.v + ", i32 0, i32 0\n")
                    let dv = nextTemp(&mut cg)
                    emit(&mut cg, "  " + dv + " = load ptr, ptr " + dp + "\n")
                    let cp = nextTemp(&mut cg)
                    emit(&mut cg, "  " + cp + " = getelementptr %String, ptr " + lv.v + ", i32 0, i32 2\n")
                    let cv = nextTemp(&mut cg)
                    emit(&mut cg, "  " + cv + " = load i64, ptr " + cp + "\n")
                    tempFrees.push(dv + "|" + cv)
                }
                argVals.push(Val {
                    v: lv.v, ty: "ptr"
                })
                argPointees.push(lv.ty.clone())
            }
        } else if cg.externFns.contains(name) && hint.len > 0 && hint[0] == 42 && isInlineArrTy(placeTypeStrOrAbort(cg, *args[i], locs, "an extern inline-array argument")) {
            // A struct-field array passed to a raw-pointer extern param decays to
            // its data address (C's `T arr[N]` → `T*` argument rule) — e.g. regcomp's
            // `_preg: *u8` out-param. Must be the field's REAL address (genLvalue),
            // not a value loaded by genFieldAccess: an out-param writes through this
            // pointer into the caller's struct, which a loaded-then-discarded copy
            // would silently lose.
            let lv = genLvalue(&mut cg, *args[i], locs, sigs)
            argVals.push(Val {
                v: lv.v, ty: "ptr"
            })
            argPointees.push("")
        } else if cg.externFns.contains(name) && llType(hint) == "%Closure" && isBareFnName(cg, *args[i], locs) {
            // a bare fn name passed to a C extern's fn-ptr param is the RAW function
            // address (@cmpI32, C signature), NOT milo's %Closure/env thunk.
            var fnm = ""
            match (*args[i]).kind {
                Expr.Ident(nm) => {
                    fnm = nm.clone()
                }
                _ => {
                }
            }
            argVals.push(Val {
                v: "@" + fnm, ty: "ptr"
            })
            argPointees.push("")
        } else {
            // A by-value param of a real user fn TAKES OWNERSHIP → move the arg
            // (zero its source), matching the checker. Skip: print/builtins &
            // externs (no declared param, only borrow) and `*T` params (a
            // string/array decays to a borrowed data pointer, not a move).
            var av = Val {
                v: "", ty: ""
            }
            let ownParam = i < paramHints.len && !cg.externFns.contains(name) &&
            (hint.len == 0 || hint[0] != 42)
            if ownParam {
                av = genOwnedArg(&mut cg, *args[i], hint, locs, sigs)
            } else {
                av = genExpr(&mut cg, *args[i], locs, sigs, hint)
            }
            // auto-wrap a bare T argument into an Option<T> param
            if i < paramHints.len {
                let rp = stripPercent(resolveTyStr(cg, stripPercent(paramHints[i])))
                if cg.enums.contains(rp) && llType(av.ty) != ("%" + rp) {
                    if variantTagOpt(cg, rp, "Some").isSome() {
                        let pl = lookupVariantPayload(cg, rp, "Some")
                        if pl.len == 1 && llType(pl[0]) == llType(av.ty) {
                            av = genWrapSome(&mut cg, av, rp)
                        }
                    }
                }
            }
            argVals.push(av)
            argPointees.push("")
        }
    }

    // A ranged parameter constrains the ARGUMENT, not just the slot it lands in,
    // so the check rides the call site. Ref/struct args fall out inside
    // emitRangeCheck (nothing to compare on a pointer).
    for i in 0..argVals.len {
        if i < paramRanges.len {
            emitRangeCheck(&mut cg, argVals[i], paramRanges[i], callSpan)
        }
    }

    // struct-by-value extern: reinterpret struct args/return into the native ABI's
    // register/byval/sret form (declares were lowered to match in emit.milo).
    if cg.abiExterns.contains(name) {
        return emitExternAbiCall(&mut cg, name, argVals, paramHints, paramRefs)
    }

    let isEprint = name == "eprint"
    let isPrintCall = name == "print" || name == "println" || isEprint
    let isVariadicExtern = name == "printf" || name == "fprintf" ||
    name == "snprintf" || isPrintCall || calleeVariadic

    // Build argument string
    var argStr = ""
    if isPrintCall {
        // print/println are printf with a format string synthesized from the
        // argument types; passing the values bare (printf(i64 42)) is not even
        // valid IR. Trailing newline matches the TS compiler's `print`.
        var fmt = ""
        for ai in 0..argVals.len {
            let elemLl = llType(argVals[ai].ty)
            if elemLl == "%String" {
                fmt = fmt + "%s"
                let p = nextTemp(&mut cg)
                emit(&mut cg, "  " + p + " = extractvalue %String " + argVals[ai].v + ", 0\n")
                argStr = argStr + ", ptr " + p
            } else if elemLl == "double" || elemLl == "float" {
                // Format through the same round-trip helper `.toString()` uses, then print
                // the bytes with %s. A bare %g here was 6 significant digits, so PRINTING a
                // float silently truncated it even though `.toString()` did not — the two
                // paths disagreed on the same value.
                // Only ONE of these may be emitted: calling the f64 helper and then
                // overwriting the result left a dead `@milo.fmt.f64(double <a float>)`
                // in the stream, which LLVM rejects even though nothing reads it.
                let fstr = if elemLl == "float" {
                    genFloat32ToString(&mut cg, argVals[ai].v)
                } else {
                    genFloatToString(&mut cg, argVals[ai].v)
                }
                fmt = fmt + "%s"
                let fp = nextTemp(&mut cg)
                emit(&mut cg, "  " + fp + " = extractvalue %String " + fstr.v + ", 0\n")
                argStr = argStr + ", ptr " + fp
            } else if elemLl == "i64" {
                // u64 prints unsigned (%llu) — else 18446744073709551615 → -1
                if isUnsigned(argVals[ai].ty) {
                    fmt = fmt + "%llu"
                } else {
                    fmt = fmt + "%lld"
                }
                argStr = argStr + ", i64 " + argVals[ai].v
            } else if elemLl == "ptr" {
                fmt = fmt + "%p"
                argStr = argStr + ", ptr " + argVals[ai].v
            } else if elemLl == "i32" {
                if isUnsigned(argVals[ai].ty) {
                    fmt = fmt + "%u"
                } else {
                    fmt = fmt + "%d"
                }
                argStr = argStr + ", i32 " + argVals[ai].v
            } else if elemLl == "i1" {
                // bool prints as true/false, matching the TS compiler
                fmt = fmt + "%s"
                let ts = emitStringLit(&mut cg, "true")
                let fs = emitStringLit(&mut cg, "false")
                let b = nextTemp(&mut cg)
                emit(&mut cg, "  " + b + " = select i1 " + argVals[ai].v + ", ptr " + ts + ", ptr " + fs + "\n")
                argStr = argStr + ", ptr " + b
            } else if elemLl.len > 0 && elemLl[0] == 37 {
                // struct/enum (%Name) → Display it as %s. Without this the branch
                // below zext'd the aggregate (`zext %IoError to i32`) → invalid IR.
                fmt = fmt + "%s"
                let ds = genDisplayString(&mut cg, argVals[ai].v, argVals[ai].ty, locs, sigs)
                let dp = nextTemp(&mut cg)
                emit(&mut cg, "  " + dp + " = extractvalue %String " + ds.v + ", 0\n")
                argStr = argStr + ", ptr " + dp
            } else {
                // i8/i16 — printf varargs promote to int. SIGN-extend a signed type:
                // zext turned an i8 of -128 into 128, so every negative narrow integer
                // printed as its unsigned bit pattern.
                // Sign-extend only when the surface type is POSITIVELY known signed.
                // `isUnsigned` reads the first character of the type string, and a value
                // whose type has been reduced to the LLVM spelling (`i8`) is
                // indistinguishable from a genuine `i8` — so a `u8` of 255 would sign-
                // extend to -1. Defaulting to zext keeps unsigned and unknown correct,
                // and the explicit list fixes the signed case (an i8 of -128 printed 128).
                let sty = argVals[ai].ty.clone()
                var ext = "zext"
                if sty == "i8" || sty == "i16" || sty == "i32" || sty == "i64" {
                    ext = "sext"
                }
                fmt = fmt + "%d"
                let z = nextTemp(&mut cg)
                emit(&mut cg, "  " + z + " = " + ext + " " + elemLl + " " + argVals[ai].v + " to i32\n")
                argStr = argStr + ", i32 " + z
            }
        }
        fmt = fmt + "\n"
        let flabel = emitStringLit(&mut cg, fmt)
        argStr = "ptr " + flabel + argStr
        // eprint writes to stderr via dprintf(2, ...) instead of printf.
        if isEprint {
            if !cg.declaredDprintf {
                emitG(&mut cg, "declare i32 @dprintf(i32, ptr, ...)\n")
                cg.declaredDprintf = true
            }
            emit(&mut cg, "  call i32 (i32, ptr, ...) @dprintf(i32 2, " + argStr + ")\n")
            return Val {
                v: "0", ty: "void"
            }
        }
    } else {
        for ai in 0..argVals.len {
            if ai > 0 {
                argStr = argStr + ", "
            }
            let elemLl = llType(argVals[ai].ty)
            // A string/Vec passed to a pointer param (`open(path: *u8, …)`) or to a
            // variadic extern decays to its data pointer (field 0). Without this the
            // whole %String struct is passed, shifting the ABI so later args (open's
            // flags) get garbage → wrong open mode → EBADF on read.
            var paramLl = ""
            if ai < paramHints.len {
                paramLl = llType(paramHints[ai])
            }
            let wantPtr = isVariadicExtern || paramLl == "ptr"
            if wantPtr && (elemLl == "%String" || elemLl == "%Vec") {
                let p = nextTemp(&mut cg)
                emit(&mut cg, "  " + p + " = extractvalue " + elemLl + " " + argVals[ai].v + ", 0\n")
                argStr = argStr + "ptr " + p
            } else if wantPtr && elemLl == "%Closure" {
                // a closure passed where a raw fn pointer is expected (e.g.
                // pthread_create's start_routine) decays to its fnptr field.
                let p = nextTemp(&mut cg)
                emit(&mut cg, "  " + p + " = extractvalue %Closure " + argVals[ai].v + ", 0\n")
                argStr = argStr + "ptr " + p
            } else {
                argStr = argStr + elemLl + " " + argVals[ai].v
            }
        }
    }

    // Static method on an instantiated generic type: Type<Args>.method —
    // registered as <MangledType>$method (or $Trait$method)
    var staticName = name.clone()
    var dotIdx: i64 = -1
    for di in 0..name.len {
        if name[di] == 46 {
            dotIdx = di
            break
        }
    }
    if dotIdx > 0 && typeArgs.len > 0 {
        let base = name[0..dotIdx].clone()
        let methodName = name[dotIdx + 1..name.len].clone()
        var full = base + "<"
        for ti in 0..typeArgs.len {
            if ti > 0 {
                full = full + ","
            }
            full = full + astTypeStr(typeArgs[ti])
        }
        full = full + ">"
        let tyName = stripPercent(resolveTyStr(cg, full))
        var cand = tyName.clone() + "$" + methodName.clone()
        if !cg.fnRets.contains(cand) {
            for k, v in cg.fnRets {
                if k.startsWith(tyName + "$") && k.endsWith("$" + methodName) {
                    cand = k.clone()
                }
            }
        }
        staticName = cand
    }
    // Generic fns are registered under their mangled name
    var callName = resolveFnName(cg, staticName)
    // resolveFnName falls back to the bare name when >1 instantiation exists;
    // disambiguate by the actual argument types (incl. a closure arg's return).
    if callName == staticName && !cg.fnRets.contains(staticName) {
        callName = disambiguateGenericCall(cg, staticName, argVals, argPointees, sigs)
    }
    // still ambiguous (a no-arg generic like arenaNew) → use the return-type hint.
    if callName == staticName && !cg.fnRets.contains(staticName) && hintTy.len > 0 {
        callName = disambiguateByReturn(cg, staticName, hintTy)
    }
    let retTy = resolveTyStr(cg, lookupFnRet(cg, callName))
    let retLl = llType(retTy)
    var sigStr = retLl.clone()

    // Builtins: print/println → printf
    let isPrint = name == "print"
    let isPrintln = name == "println"
    var emitName = callName.clone()
    // `exit` is an extern with no prelude body; ensure its declare is emitted.
    if emitName == "exit" {
        ensureExit(&mut cg)
    }
    if isPrint || isPrintln {
        emitName = "printf"
        sigStr = "i32 (ptr, ...)"
        if !cg.declaredPrintf {
            emitG(&mut cg, "declare i32 @printf(ptr, ...)\n")
            cg.declaredPrintf = true
        }

    }
    if name == "printf" || name == "fprintf" || name == "snprintf" {
        sigStr = "i32 (ptr, ...)"
    }
    // A variadic callee (e.g. `open(path, flags, ...)`) MUST be called through its
    // full `(fixed…, ...)` function type, or LLVM lowers the trailing args as
    // fixed register params instead of into the vararg region (stack on arm64)
    // where the callee's va_arg reads them → garbage (e.g. open's mode).
    if calleeVariadic && !isPrint && !isPrintln {
        var vsig = retLl.clone() + " ("
        for pi in 0..paramHints.len {
            if pi > 0 {
                vsig = vsig + ", "
            }
            vsig = vsig + llType(paramHints[pi])
        }
        if paramHints.len > 0 {
            vsig = vsig + ", "
        }
        vsig = vsig + "...)"
        sigStr = vsig
    }

    // A void call must NOT be named (`%t = call void ...` is invalid IR).
    if retLl == "void" {
        emit(&mut cg, "  call " + sigStr + " @" + emitName + "(" + argStr + ")\n")
        emitTempFrees(&mut cg, tempFrees)
        return Val {
            v: "0", ty: "void"
        }
    }
    let t = nextTemp(&mut cg)
    emit(&mut cg, "  " + t + " = call " + sigStr + " @" + emitName + "(" + argStr + ")\n")
    emitTempFrees(&mut cg, tempFrees)

    // carry the SURFACE type (Vec<string>, not %Vec) so field/method resolution
    // on the result (`.len`, index, isVecTy) still works; llType(retTy)==retLl
    return Val {
        v: t, ty: retTy
    }
}

// -- Lvalue (address-of) --

pub fn genLvalue(cg: &mut Cgen, e: &ExprNode, locs: &Vec<Local>, sigs: &Vec<CgFnSig>): Val {
    return genLvalueWithHint(&mut cg, e, locs, sigs, "")
}

// `hintTy` only reaches the rvalue-materialization arm at the bottom — every other arm
// names an existing place whose type is already known. It matters for an rvalue passed
// to a `&T` param: `Texture2D.rgb32f(.., Vec.filled(n, 0.0), ..)` against `pixels:
// &Vec<f32>` had no way to learn the element type, defaulted to Vec<i64>, and emitted
// `store i64 0.0` — IR LLVM rejects outright.
pub fn genLvalueWithHint(cg: &mut Cgen, e: &ExprNode, locs: &Vec<Local>, sigs: &Vec<CgFnSig>, hintTy: string): Val {
    match e.kind {
        Expr.Ident(name) => {
            // a module global's address is @name (used for push/field-store/etc.)
            if !hasLocal(locs, name) && cg.globalVars.contains(name) {
                let surf = cg.globalVars.get(name)!
                return Val {
                    v: "@" + name.clone(), ty: surf
                }
            }
            let local = findLocal(locs, name)
            return Val {
                v: local.addr.clone(), ty: local.ty.clone()
            }
        }
        Expr.FieldAccess(object, field) => {
            let inner = genLvalue(&mut cg, *object, locs, sigs)
            let rawName = stripPercent(inner.ty)
            let idx = lookupFieldIndex(cg, rawName, field)
            let fty = lookupFieldType(cg, rawName, idx)
            let structTy = "%" + rawName
            let fp = nextTemp(&mut cg)
            emit(&mut cg, "  " + fp + " = getelementptr " + structTy + ", ptr " + inner.v + ", i32 0, i32 " + idx.toString() + "\n")
            return Val {
                v: fp, ty: fty
            }
        }
        // A capitalized *variable* followed by `.field` parses identically to a
        // static enum-literal (see checker's isRootMutable/checkEnumLit "variable
        // fallback", which this mirrors) — `STORE.inner.n = x` and
        // `STORE.items.push(x)` used to fall to the generic `_` arm below, which
        // materializes a FRESH TEMPORARY's address: both silently wrote into a
        // copy that vanished at statement end, never touching the real `@STORE`
        // global. Guarded on `cg.enums` + an actual local/global match — a
        // GENUINE enum literal (`Color.Red`) must still fall through to the `_`
        // arm; without the guard, looking a real enum name up as a local finds
        // nothing and findLocal's documented "should not happen" fallback
        // silently hands back locs[0] (some UNRELATED local), and every field/
        // index computed on top of it is garbage.
        Expr.EnumLit(enumName, variant, args) => {
            let isVar = !cg.enums.contains(enumName) && (hasLocal(locs, enumName) || cg.globalVars.contains(enumName))
            if isVar {
                // Plain string vars, not a reassigned Val — milo-self's own (still
                // incomplete) borrow checker over-rejects "var v: Struct = …; if
                // … { v = … }" as an escaping borrow (a known, separately-owned
                // gap; see AGENTS.md). Reassigning strings sidesteps it.
                var innerV = "0"
                var innerTy = ""
                if !hasLocal(locs, enumName) && cg.globalVars.contains(enumName) {
                    let surf = cg.globalVars.get(enumName)!
                    innerV = "@" + enumName.clone()
                    innerTy = surf
                } else {
                    let local = findLocal(locs, enumName)
                    innerV = local.addr.clone()
                    innerTy = local.ty.clone()
                }
                let rawName = stripPercent(innerTy)
                let idx = lookupFieldIndex(cg, rawName, variant)
                let fty = lookupFieldType(cg, rawName, idx)
                let structTy = "%" + rawName
                let fp = nextTemp(&mut cg)
                emit(&mut cg, "  " + fp + " = getelementptr " + structTy + ", ptr " + innerV + ", i32 0, i32 " + idx.toString() + "\n")
                return Val {
                    v: fp, ty: fty
                }
            }
            let v = genExpr(&mut cg, e, locs, sigs, hintTy)
            let ll = llType(v.ty)
            let addr = nextTemp(&mut cg)
            emit(&mut cg, "  " + addr + " = alloca " + ll + "\n")
            emit(&mut cg, "  store " + ll + " " + v.v + ", ptr " + addr + "\n")
            return Val {
                v: addr, ty: v.ty
            }
        }
        Expr.UnaryOp(op, operand) => {
            // `*p` as an lvalue: the pointee's address IS the pointer value, so
            // evaluate the operand (Heap<T> box ptr or raw `*T`) and return it
            // with the pointee type. Covers `(*inner).field` reads and writes.
            if op == "*" {
                let pv = genExpr(&mut cg, *operand, locs, sigs, "")
                var pointee = unwrapHeap(pv.ty)
                if pointee.len == 0 && pv.ty.len > 0 && pv.ty[0] == 42 {
                    pointee = pv.ty[1..pv.ty.len].clone()
                }
                if pointee.len == 0 {
                    // Neither a Heap<T> nor a raw pointer, so there is no pointee to name.
                    // The checker rejects dereferencing anything else, so reaching here
                    // means the backend lost the operand's type rather than the program
                    // being wrong — and reading the result as i64 would silently
                    // reinterpret whatever is actually there.
                    eprint("internal error: dereferencing a value of type '" + pv.ty.clone() + "', which names no pointee")
                    unsafe {
                        exit(1)
                    }
                }
                return Val {
                    v: pv.v, ty: pointee
                }
            }
            return Val {
                v: "0", ty: "i64"
            }
        }
        Expr.IndexAccess(obj, idx) => {
            // `a[i]` as an lvalue — needed for `a[i].field = x` and `&a[i]`.
            // Inline struct-field array: index the field's address directly
            // (mirrors genIndex above — no %Vec header to extract a data ptr from).
            let objPlaceTy = placeTypeStrOrAbort(cg, *obj, locs, "an lvalue with a type hint")
            if isInlineArrTy(objPlaceTy) {
                let addr = genLvalue(&mut cg, *obj, locs, sigs)
                let elemTy = inlineArrElem(addr.ty)
                let arrLl = llType(addr.ty)
                let iv2 = genExpr(&mut cg, *idx, locs, sigs, "i64")
                let iw2 = widenToI64(&mut cg, iv2)
                let size2 = inlineArrLen(addr.ty)
                emitBoundsCheck(&mut cg, iw2, size2.toString())
                let slot = nextTemp(&mut cg)
                emit(&mut cg, "  " + slot + " = getelementptr " + arrLl + ", ptr " + addr.v + ", i32 0, i64 " + iw2 + "\n")
                return Val {
                    v: slot, ty: elemTy
                }
            }
            let o = genExpr(&mut cg, *obj, locs, sigs, "")
            let iv = genExpr(&mut cg, *idx, locs, sigs, "i64")
            if isVecTy(o.ty) {
                let elemTy = unwrapVec(resolveTyStr(cg, o.ty))
                let elemLl = llType(elemTy)
                let d = nextTemp(&mut cg)
                emit(&mut cg, "  " + d + " = extractvalue %Vec " + o.v + ", 0\n")
                let vlen2 = nextTemp(&mut cg)
                emit(&mut cg, "  " + vlen2 + " = extractvalue %Vec " + o.v + ", 1\n")
                emitBoundsCheck(&mut cg, iv.v, vlen2)
                let slot = nextTemp(&mut cg)
                emit(&mut cg, "  " + slot + " = getelementptr " + elemLl + ", ptr " + d + ", i64 " + iv.v + "\n")
                return Val {
                    v: slot, ty: elemTy
                }
            }
            if o.ty.len > 0 && o.ty[0] == 42 {
                let elemTy = o.ty[1..o.ty.len].clone()
                let elemLl = llType(elemTy)
                let slot = nextTemp(&mut cg)
                emit(&mut cg, "  " + slot + " = getelementptr " + elemLl + ", ptr " + o.v + ", i64 " + iv.v + "\n")
                return Val {
                    v: slot, ty: elemTy
                }
            }
            return Val {
                v: "0", ty: "i64"
            }
        }
        _ => {
            // rvalue (call result, etc.) used where an address is needed
            // (`peek(p).kind`, `match f()`): materialize it into a temp alloca.
            let v = genExpr(&mut cg, e, locs, sigs, "")
            let ll = llType(v.ty)
            let addr = nextTemp(&mut cg)
            emit(&mut cg, "  " + addr + " = alloca " + ll + "\n")
            emit(&mut cg, "  store " + ll + " " + v.v + ", ptr " + addr + "\n")
            return Val {
                v: addr, ty: v.ty
            }
        }
    }
}

// -- Main expression dispatch --

// The result expression of an expression-bodied closure statement (`=> expr`
// lowers to one Return/ExprStmt). Returns None when it isn't that shape.
// The seam between the typed pipeline and the untyped one. Every HIR node still carrying
// an AST subtree comes through here; anything else aborts naming the kind, because a node
// that reached this walk already lowered is a node whose type the walk below is about to
// reconstruct from syntax — the exact defect this migration exists to remove.
pub fn genHExpr(cg: &mut Cgen, n: &HExprNode, locs: &Vec<Local>, sigs: &Vec<CgFnSig>, hintTy: string): Val {
    match n.kind {
        HExpr.Unlowered(e) => {
            return genExpr(&mut cg, *e, locs, sigs, hintTy)
        }
        // The one node lowering builds for itself: `@iter` on a field redirects a for-in
        // to that field, and that read is genuinely lowered — it carries its own type, so
        // nothing here has to look the field's type up again.
        HExpr.FieldAccess(obj, field, isRefRead) => {
            let sv = genHExpr(&mut cg, *obj, locs, sigs, "")
            let sname = stripPercent(resolveTyStr(cg, sv.ty))
            let fidx = lookupFieldIndex(cg, sname, field)
            let fty = hirType(n)
            let fv = nextTemp(&mut cg)
            emit(&mut cg, "  " + fv + " = extractvalue %" + sname + " " + sv.v + ", " + fidx.toString() + "\n")
            return Val {
                v: fv, ty: tyStr(cg, fty, "'@iter' delegate field '" + field.clone() + "'")
            }
        }
        _ => {
            hexprAbort(n, "expression")
            return Val {
                v: "0", ty: "void"
            }
        }
    }
}

// The value an integer literal takes once its surface type is known. Split out of the
// AST arm so the typed path can reuse it: the HIR node carries the checker's type, the
// AST node has only a hint that may be empty. Two copies of the ptr/float/unsigned rules
// would be two chances for them to disagree about what `let b: u8 = 200` means.
pub fn genIntLitVal(cg: &mut Cgen, n: i64, ty: string): Val {

    var ll = llType(ty)
    // An integer literal in pointer position (`p: *u8 = 0`) is a null
    // pointer: LLVM writes `null`, not the integer constant `0`.
    if ll == "ptr" {
        if n == 0 {
            return Val {
                v: "null", ty: "ptr"
            }
        }
        let t = nextTemp(&mut cg)
        emit(&mut cg, "  " + t + " = inttoptr i64 " + n.toString() + " to ptr\n")
        return Val {
            v: t, ty: "ptr"
        }
    }
    // An int literal in float position (`x: f64 = 0`, a zeroed float field)
    // must be a floating constant — LLVM rejects `double 0`, needs `0.0`.
    if ll == "double" || ll == "float" {
        return Val {
            v: n.toString() + ".0", ty: ll
        }
    }
    // Only integer hints apply to an int literal; a non-int hint (e.g. a
    // generic type param `A` passed as a call-arg hint) must not retype it.
    let isInt = ll.len > 0 && ll[0] == 105
    if !isInt {
        return Val {
            v: n.toString(), ty: "i64"
        }
    }
    // keep the SURFACE type (u8/i32/…), not the LLVM type, so unsigned-ness
    // survives — otherwise `let b: u8 = 200; b as i32` sign-extends to -56.
    return Val {
        v: n.toString(), ty: ty
    }
}

pub fn genExpr(cg: &mut Cgen, e: &ExprNode, locs: &Vec<Local>, sigs: &Vec<CgFnSig>, hintTy: string): Val {
    match e.kind {
        Expr.IntLit(n) => {
            // NOT a silent default, despite looking exactly like one. The language
            // reference is explicit: "An integer literal with no type context defaults to
            // i64" (docs/language-reference.md, `let a = 5  // i64 (no context)`). An
            // empty hint IS the no-type-context case, so this line implements the spec.
            //
            // Called out because it was mistaken for the defect during the fail-closed
            // pass: the shape of an invented type and the shape of a documented default
            // are identical in the source, and only the spec tells them apart.
            var ty = hintTy.clone()
            if ty.len == 0 {
                ty = "i64"
            }
            return genIntLitVal(&mut cg, n, ty)
        }
        Expr.FloatLit(f) => {
            // Honor an f32 field/arg hint: a bare float literal defaults to double,
            // but in `float` position LLVM needs a `float` constant. Carry the
            // SURFACE type "f32" (not "float" — llType maps the surface alias
            // "float"→double, which would re-widen the store).
            var fll = "double"
            if hintTy.len > 0 && llType(hintTy) == "float" {
                fll = "f32"
            }
            if fll == "f32" {
                // A decimal literal at f64 precision (e.g. "0.1") doesn't reduce to
                // an exactly-representable float32 value, and LLVM's parser hard-
                // rejects a `float` operand written that way ("floating point
                // constant invalid for type"). Use the hex bit-pattern form instead.
                return Val {
                    v: formatF32Bits(f), ty: fll
                }
            }
            return Val {
                v: floatDecimalStr(f), ty: fll
            }
        }
        Expr.BoolLit(b) => {
            let v = if b {
                "1"
            } else {
                "0"
            }
            return Val {
                v: v, ty: "i1"
            }
        }
        Expr.StringLit(s) => {
            return genStringLit(&mut cg, s)
        }
        Expr.CharLit(c) => {
            return Val {
                v: c.toString(), ty: "i8"
            }
        }
        Expr.Ident(name) => {
            // A module global (unless a local shadows it): load @name.
            var isLocal = false
            for li in 0..locs.len {
                if locs[li].name == name {
                    isLocal = true
                }
            }
            if !isLocal && cg.globalVars.contains(name) {
                let surf = cg.globalVars.get(name)!
                let gll = llType(resolveTyStr(cg, surf))
                let g = nextTemp(&mut cg)
                emit(&mut cg, "  " + g + " = load " + gll + ", ptr @" + name.clone() + "\n")
                return Val {
                    v: g, ty: surf
                }
            }
            // A bare function name used as a closure value → { @thunk, null }, where
            // the thunk adapts the named fn to the closure ABI (env + by-ptr args).
            // (A fn-name cast to a raw ptr — `trampoline as *u8` — is handled in
            // genAsCast, which uses the fn's real address, not the thunk.)
            if !isLocal && cg.fnRets.contains(name) {
                let thunk = ensureFnThunk(&mut cg, name, sigs)
                let f0 = nextTemp(&mut cg)
                emit(&mut cg, "  " + f0 + " = insertvalue %Closure undef, ptr @" + thunk + ", 0\n")
                let f1 = nextTemp(&mut cg)
                emit(&mut cg, "  " + f1 + " = insertvalue %Closure " + f0 + ", ptr null, 1\n")
                return Val {
                    v: f1, ty: "Closure"
                }
            }
            let local = findLocal(locs, name)
            let lt = llType(local.ty)
            let loaded = genLoad(&mut cg, local.addr, lt)
            return Val {
                v: loaded.v, ty: local.ty.clone()
            }
        }
        Expr.UnaryOp(op, inner) => {
            if op == "*" {
                return genHeapDeref(&mut cg, *inner, locs, sigs)
            }
            // `&place` yields the place's address (used for `(&x) as *T` extern args).
            if op == "&" {
                let lv = genLvalue(&mut cg, *inner, locs, sigs)
                return Val {
                    v: lv.v, ty: "ptr"
                }
            }
            // Negating an integer literal is a compile-time constant — fold it. Without
            // this, a legitimate negative literal like i32 INT_MIN (-2147483648, lexed
            // as the unary minus of 2147483648) would emit a runtime checked-negate and
            // trap on the INT_MIN overflow now that negation is checked by default.
            if op == "-" {
                match (*inner).kind {
                    Expr.IntLit(n) => {
                        let v0 = genExpr(&mut cg, *inner, locs, sigs, hintTy)
                        // i64 MIN is lexed as the negation of 9223372036854775808, a
                        // magnitude i64 cannot hold — it already wrapped to
                        // -9223372036854775808, which is exactly the value this negation
                        // wants. Prefixing another '-' emits `--9223372036854775808`.
                        if v0.v.startsWith("-") {
                            return Val {
                                v: v0.v.clone(), ty: v0.ty
                            }
                        }
                        return Val {
                            v: "-" + v0.v, ty: v0.ty
                        }
                    }
                    _ => {
                    }
                }
            }
            let v = genExpr(&mut cg, *inner, locs, sigs, hintTy)
            let t = nextTemp(&mut cg)
            if op == "-" {
                let vll = llType(v.ty)
                // Float negation uses fneg — `sub double 0, x` has an invalid
                // integer `0` operand for a double.
                if vll == "double" || vll == "float" {
                    emit(&mut cg, "  " + t + " = fneg " + vll + " " + v.v + "\n")
                    return Val {
                        v: t, ty: v.ty
                    }
                }
                if !cg.currentFnWrapping && intBits(vll.clone()) > 0 {
                    let unsigned = isUnsigned(v.ty)
                    return emitCheckedArith(&mut cg, "sub", unsigned, vll, "0", v.v, v.ty)
                }
                emit(&mut cg, "  " + t + " = sub " + vll + " 0, " + v.v + "\n")
                return Val {
                    v: t, ty: v.ty
                }
            }
            if op == "!" {
                emit(&mut cg, "  " + t + " = xor i1 " + v.v + ", 1\n")
                return Val {
                    v: t, ty: "i1"
                }
            }
            if op == "~" {
                emit(&mut cg, "  " + t + " = xor " + llType(v.ty) + " " + v.v + ", -1\n")
                return Val {
                    v: t, ty: v.ty
                }
            }
            return v
        }
        Expr.BinOp(op, l, r) => {
            // Short-circuit && / || — the RHS must NOT be evaluated eagerly (it may
            // have side effects). Store into a slot to avoid phi/current-block bookkeeping.
            if op == "&&" || op == "||" {
                let res = nextTemp(&mut cg)
                emit(&mut cg, "  " + res + " = alloca i1\n")
                let lhs = genExpr(&mut cg, *l, locs, sigs, "bool")
                emit(&mut cg, "  store i1 " + lhs.v + ", ptr " + res + "\n")
                let rhsLbl = nextLabel(&mut cg, "sc.rhs")
                let endLbl = nextLabel(&mut cg, "sc.end")
                if op == "&&" {
                    emit(&mut cg, "  br i1 " + lhs.v + ", label %" + rhsLbl + ", label %" + endLbl + "\n")
                } else {
                    emit(&mut cg, "  br i1 " + lhs.v + ", label %" + endLbl + ", label %" + rhsLbl + "\n")
                }
                emit(&mut cg, rhsLbl + ":\n")
                let rhs = genExpr(&mut cg, *r, locs, sigs, "bool")
                emit(&mut cg, "  store i1 " + rhs.v + ", ptr " + res + "\n")
                emit(&mut cg, "  br label %" + endLbl + "\n")
                emit(&mut cg, endLbl + ":\n")
                let out = nextTemp(&mut cg)
                emit(&mut cg, "  " + out + " = load i1, ptr " + res + "\n")
                return Val {
                    v: out, ty: "bool"
                }
            }
            // A comparison's RESULT is bool but its OPERANDS are the compared type —
            // don't leak a "bool" hint onto them (`if 3 > 2` would make the int
            // literals i1 and compare 1 > 0 signed = false).
            var lHint = hintTy.clone()
            if isCmpOp(op) {
                lHint = ""
            }
            // A bare integer literal on the left has no width of its own and defaults to
            // i64, which then dragged the RHS up with it: `0 - b` on an i32 `b` computed
            // at i64 and printed 2147483648 where wrapping i32 gives INT_MIN. Take the
            // width from the other operand instead.
            if lHint.len == 0 {
                match (*l).kind {
                    Expr.IntLit(nlit) => {
                        let rt = peekArgTy(*r, locs)
                        if isIntLlType(llType(rt)) {
                            lHint = rt
                        }
                    }
                    _ => {
                        // Same idea for a float-literal subtree on the left with no
                        // hint of its own (`(1.0 + 3.0) * w` — the parenthesized sum
                        // has no width, but w does): peek the right operand's actual
                        // type and adopt it if it's float. A lone `1.0 - t` is already
                        // covered by an outer hint flowing down (return type, let
                        // annotation, …); this only matters when there is none.
                        if isFloatLitAstExpr(*l) {
                            let rt = peekArgTy(*r, locs)
                            let rll = llType(rt)
                            if rll == "float" || rll == "double" {
                                lHint = rt
                            }
                        }
                    }
                }
            }
            let lv = genExpr(&mut cg, *l, locs, sigs, lHint)
            let rv = genExpr(&mut cg, *r, locs, sigs, lv.ty.clone())
            let lvLl = llType(lv.ty)
            // String operations
            if lvLl == "%String" {
                if op == "+" {
                    return genStringConcat(&mut cg, lv.v, rv.v)
                }
                if op == "==" || op == "!=" {
                    return genStringEq(&mut cg, lv.v, rv.v, op == "==")
                }
                if op == "<" || op == "<=" || op == ">" || op == ">=" {
                    return genStringCmp(&mut cg, lv.v, rv.v, op)
                }
            }
            // Aggregate equality. An ENUM compares its i32 tag; a STRUCT compares every
            // field. Using the tag path for structs compared field 0 alone and called
            // distinct values equal — it passed the fixtures only because their values
            // happened to differ in the first field.
            if (op == "==" || op == "!=") && lvLl.len > 1 && lvLl[0] == 37 {
                let aggName = stripPercent(lvLl.clone())
                if cg.enums.contains(aggName) {
                    let lt = nextTemp(&mut cg)
                    emit(&mut cg, "  " + lt + " = extractvalue " + lvLl + " " + lv.v + ", 0\n")
                    let rt = nextTemp(&mut cg)
                    emit(&mut cg, "  " + rt + " = extractvalue " + lvLl + " " + rv.v + ", 0\n")
                    let opn = if op == "==" {
                        "eq"
                    } else {
                        "ne"
                    }
                    let res = nextTemp(&mut cg)
                    emit(&mut cg, "  " + res + " = icmp " + opn + " i32 " + lt + ", " + rt + "\n")
                    return Val {
                        v: res, ty: "bool"
                    }
                }
                if cg.structs.contains(aggName) {
                    let eqv = genAggregateEq(&mut cg, lvLl, lv.v, rv.v)
                    if eqv.len > 0 {
                        if op == "==" {
                            return Val {
                                v: eqv, ty: "bool"
                            }
                        }
                        let neg = nextTemp(&mut cg)
                        emit(&mut cg, "  " + neg + " = xor i1 " + eqv + ", true\n")
                        return Val {
                            v: neg, ty: "bool"
                        }
                    }
                }
            }
            // Operator overloading: struct <op> struct → the Type$..$<method> call
            // (add/sub/mul/div); self and other are &Self, passed as pointers.
            if op == "+" || op == "-" || op == "*" || op == "/" {
                let rawName = stripPercent(resolveTyStr(cg, lv.ty))
                if cg.structs.contains(rawName) {
                    var opm = "add"
                    if op == "-" {
                        opm = "sub"
                    }
                    if op == "*" {
                        opm = "mul"
                    }
                    if op == "/" {
                        opm = "div"
                    }
                    var opFn = ""
                    for opk, opv in cg.fnRets {
                        if opk.startsWith(rawName + "$") && opk.endsWith("$" + opm) {
                            opFn = opk.clone()
                        }
                    }
                    if opFn.len > 0 {
                        let structTy = "%" + rawName
                        let la = nextTemp(&mut cg)
                        emit(&mut cg, "  " + la + " = alloca " + structTy + "\n")
                        emit(&mut cg, "  store " + structTy + " " + lv.v + ", ptr " + la + "\n")
                        let ra = nextTemp(&mut cg)
                        emit(&mut cg, "  " + ra + " = alloca " + structTy + "\n")
                        emit(&mut cg, "  store " + structTy + " " + rv.v + ", ptr " + ra + "\n")
                        let t = nextTemp(&mut cg)
                        emit(&mut cg, "  " + t + " = call " + structTy + " @" + opFn + "(ptr " + la + ", ptr " + ra + ")\n")
                        return Val {
                            v: t, ty: lv.ty.clone()
                        }
                    }
                }
            }
            // Mixed integer widths (e.g. `i64Var < i32Param`): widen the narrower
            // operand so the op has one type. i1 is excluded (bool, not arithmetic).
            var lvv = lv.v.clone()
            var rvv = rv.v.clone()
            var opLl = lvLl.clone()
            let rvLl = llType(rv.ty)
            let lInt = lvLl.len > 1 && lvLl[0] == 105
            let rInt = rvLl.len > 1 && rvLl[0] == 105
            if lInt && rInt && lvLl != rvLl {
                let lb = intBits(lvLl)
                let rb = intBits(rvLl)
                if lb < rb {
                    let w = nextTemp(&mut cg)
                    let ext = if isUnsigned(lv.ty) {
                        "zext"
                    } else {
                        "sext"
                    }
                    emit(&mut cg, "  " + w + " = " + ext + " " + lvLl + " " + lvv + " to " + rvLl + "\n")
                    lvv = w
                    opLl = rvLl.clone()
                } else {
                    let w = nextTemp(&mut cg)
                    let ext = if isUnsigned(rv.ty) {
                        "zext"
                    } else {
                        "sext"
                    }
                    emit(&mut cg, "  " + w + " = " + ext + " " + rvLl + " " + rvv + " to " + lvLl + "\n")
                    rvv = w
                }
            }
            let t = nextTemp(&mut cg)
            let unsigned = isUnsigned(lv.ty)
            // If a narrower operand was widened, the RESULT value is the wider
            // width — report that, not lv.ty. Otherwise `(u8 | i64shifted) as u8`
            // sees u8->u8 (no-op) and never truncates the actually-i64 value.
            var resTy = lv.ty.clone()
            if opLl != lvLl {
                resTy = opLl.clone()
            }
            // Floating-point operands use f-instructions, not the integer ops.
            if lvLl == "double" || lvLl == "float" {
                if isArithOp(op) {
                    var fop = "fadd"
                    if op == "-" {
                        fop = "fsub"
                    } else if op == "*" {
                        fop = "fmul"
                    } else if op == "/" {
                        fop = "fdiv"
                    } else if op == "%" {
                        fop = "frem"
                    }
                    emit(&mut cg, "  " + t + " = " + fop + " " + lvLl + " " + lvv + ", " + rvv + "\n")
                    return Val {
                        v: t, ty: lv.ty
                    }
                }
                if isCmpOp(op) {
                    var fp = "oeq"
                    // `une`, not `one`: IEEE 754 says every comparison with NaN is false
                    // EXCEPT `!=`, which is true. `one` is the ordered form, which makes
                    // both `x == x` and `x != x` false for NaN — so `!(x == x)` and
                    // `x != x` disagree, and NaN stops being detectable.
                    if op == "!=" {
                        fp = "une"
                    } else if op == "<" {
                        fp = "olt"
                    } else if op == "<=" {
                        fp = "ole"
                    } else if op == ">" {
                        fp = "ogt"
                    } else if op == ">=" {
                        fp = "oge"
                    }
                    emit(&mut cg, "  " + t + " = fcmp " + fp + " " + lvLl + " " + lvv + ", " + rvv + "\n")
                    return Val {
                        v: t, ty: "bool"
                    }
                }
            }
            if isArithOp(op) {
                // Overflow-checked by default; `@wrapping fn` skips the trap and falls
                // through to the plain two's-complement instruction below.
                if !cg.currentFnWrapping && (op == "+" || op == "-" || op == "*") {
                    var arithOp = "add"
                    if op == "-" {
                        arithOp = "sub"
                    }
                    if op == "*" {
                        arithOp = "mul"
                    }
                    return emitCheckedArith(&mut cg, arithOp, unsigned, opLl, lvv, rvv, resTy)
                }
                // Division/remainder by zero is UB — trap it in every mode, including
                // @wrapping: there is no modular value for x/0. Signed INT_MIN / -1 is
                // ALSO UB by default, but under @wrapping it has a defined modular
                // result (wraps to INT_MIN) — see emitWrappingSignedDivRem.
                if op == "/" || op == "%" {
                    let dbits = intBits(opLl.clone())
                    if cg.currentFnWrapping && !unsigned {
                        let wres = emitWrappingSignedDivRem(&mut cg, op, lvv, rvv, opLl, dbits)
                        return Val {
                            v: wres, ty: resTy
                        }
                    }
                    emitDivByZeroCheck(&mut cg, rvv, lvv, opLl, !unsigned, dbits)
                }
                // A shift by >= the operand's bit width (or a negative amount, huge as
                // unsigned) is LLVM poison EITHER WAY — checked or not, the plain `shl`/
                // `ashr`/`lshr` below cannot be handed a raw out-of-range amount. Default:
                // trap. `@wrapping`: mask the amount into [0, bits) instead — defined,
                // matches Rust's `wrapping_shl`/C's shift-amount masking (tests/fixtures/
                // moduleWrapping.milo: `1i32 << 40` under `@!wrapping` must be `1 << 8`
                // (256), not a trap and not the poison a bare `shl i32 1, 40` produces).
                if op == "<<" || op == ">>" {
                    let sbits = intBits(opLl.clone())
                    if cg.currentFnWrapping {
                        let masked = nextTemp(&mut cg)
                        emit(&mut cg, "  " + masked + " = and " + opLl + " " + rvv + ", " + (sbits - 1).toString() + "\n")
                        rvv = masked
                    } else {
                        emitShiftCheck(&mut cg, rvv, opLl, sbits)
                    }
                }
                let opname = binOpInt(op, unsigned)
                // A shift amount >= the operand's bit width (or negative, huge as
                // unsigned) is LLVM POISON, not a defined wraparound. src-milo has no
                // checked-shift trap to fall back on — it emits no overflow traps for
                // ordinary arithmetic at all (see parser.milo's @!wrapping note) — so
                // this masks unconditionally, matching what the oracle does under
                // @wrapping (Rust's wrapping_shl/C's masked shift): `1i32 << 40`
                // becomes `1 << (40 & 31)` = 256, not undefined.
                if (op == "<<" || op == ">>") && opLl != "double" && opLl != "float" {
                    let bits = intBits(opLl)
                    if bits > 0 {
                        let maskT = nextTemp(&mut cg)
                        emit(&mut cg, "  " + maskT + " = and " + opLl + " " + rvv + ", " + (bits - 1).toString() + "\n")
                        emit(&mut cg, "  " + t + " = " + opname + " " + opLl + " " + lvv + ", " + maskT + "\n")
                        return Val {
                            v: t, ty: resTy
                        }
                    }
                }
                // Signed INT_MIN / -1 (and the matching %) has no representable quotient —
                // LLVM's sdiv/srem is POISON on that exact operand pair, same class of bug
                // as the unmasked shift above. src-milo has no div-by-zero/overflow trap to
                // fall back on for ordinary arithmetic, so — mirroring the shift fix —
                // this routes the poison pair around the instruction with a select instead
                // of trapping: divide by 1 when the pair would overflow, then select the
                // wrapped answer (MIN for '/', 0 for '%') over the bogus div-by-1 result.
                // Matches the oracle's @wrapping semantics (Rust's wrapping_div/wrapping_rem).
                // Division by zero is unrelated (still whatever the hardware does) and out
                // of scope here — this only removes the poison, not adds a zero-check.
                if (op == "/" || op == "%") && !unsigned && opLl != "double" && opLl != "float" {
                    let bits = intBits(opLl)
                    if bits > 0 {
                        let minVal = sMin(bits)
                        let isMin = nextTemp(&mut cg)
                        emit(&mut cg, "  " + isMin + " = icmp eq " + opLl + " " + lvv + ", " + minVal + "\n")
                        let isNeg1 = nextTemp(&mut cg)
                        emit(&mut cg, "  " + isNeg1 + " = icmp eq " + opLl + " " + rvv + ", -1\n")
                        let isOvf = nextTemp(&mut cg)
                        emit(&mut cg, "  " + isOvf + " = and i1 " + isMin + ", " + isNeg1 + "\n")
                        let safeDivisor = nextTemp(&mut cg)
                        emit(&mut cg, "  " + safeDivisor + " = select i1 " + isOvf + ", " + opLl + " 1, " + opLl + " " + rvv + "\n")
                        let raw = nextTemp(&mut cg)
                        emit(&mut cg, "  " + raw + " = " + opname + " " + opLl + " " + lvv + ", " + safeDivisor + "\n")
                        var wrapped = minVal
                        if op == "%" {
                            wrapped = "0"
                        }
                        emit(&mut cg, "  " + t + " = select i1 " + isOvf + ", " + opLl + " " + wrapped + ", " + opLl + " " + raw + "\n")
                        return Val {
                            v: t, ty: resTy
                        }
                    }
                }
                emit(&mut cg, "  " + t + " = " + opname + " " + opLl + " " + lvv + ", " + rvv + "\n")
                return Val {
                    v: t, ty: resTy
                }
            }
            if isCmpOp(op) {
                let opname = cmpOpInt(op, unsigned)
                emit(&mut cg, "  " + t + " = icmp " + opname + " " + opLl + " " + lvv + ", " + rvv + "\n")
                return Val {
                    v: t, ty: "bool"
                }
            }
            if op == "&&" {
                emit(&mut cg, "  " + t + " = and i1 " + lv.v + ", " + rv.v + "\n")
                return Val {
                    v: t, ty: "i1"
                }
            }
            if op == "||" {
                emit(&mut cg, "  " + t + " = or i1 " + lv.v + ", " + rv.v + "\n")
                return Val {
                    v: t, ty: "i1"
                }
            }
            return Val {
                v: "0", ty: "i64"
            }
        }
        Expr.Call(name, args, typeArgs) => {
            // a call whose callee is a %Closure-typed local is an indirect call
            if hasLocal(locs, name) {
                let lc = findLocal(locs, name)
                if llType(lc.ty) == "%Closure" {
                    return genClosureCall(&mut cg, lc, args, locs, sigs, hintTy)
                }
            }
            return genCall(&mut cg, name, args, typeArgs, locs, sigs, hintTy, e.span)
        }
        Expr.StructLit(name, fields) => {
            return genStructLit(&mut cg, name, fields, locs, sigs, hintTy)
        }
        Expr.JsonObject(fields) => {
            return genJsonObject(&mut cg, fields, locs, sigs)
        }
        Expr.FieldAccess(object, field) => {
            return genFieldAccess(&mut cg, *object, field, locs, sigs)
        }
        Expr.Closure(params, retType, body, isMove) => {
            return genClosure(&mut cg, e.id, params, retType, isMove, locs, sigs)
        }
        Expr.EnumLit(enumName, variant, args) => {
            if enumName == "Vec" && variant == "new" {
                return genVecNew(&mut cg, hintTy)
            }
            if enumName == "HashMap" && variant == "new" {
                return genHashMapNew(&mut cg, hintTy)
            }
            // HashMap.withCapacity(n): the oracle's own HashMapNew HIR node carries
            // no capacity field (src/lower.ts:823) — the argument is checked for a
            // type error and then dropped, so withCapacity allocates the same fixed
            // initial table as new. Mirror that exactly rather than "fixing" it here:
            // self-host parity means matching the oracle's actual codegen, not the
            // behavior its name implies.
            if enumName == "HashMap" && variant == "withCapacity" {
                return genHashMapNew(&mut cg, hintTy)
            }
            // Real capacity, not just a growth hint: callers that write through
            // `.ptr()` without ever pushing (fdRead's read-syscall landing pad) need
            // an actually-allocated buffer — see genVecWithCapacity's doc comment.
            if enumName == "Vec" && variant == "withCapacity" && args.len == 1 {
                return genVecWithCapacity(&mut cg, hintTy, *args[0], locs, sigs)
            }
            if enumName == "Vec" && variant == "withCapacity" {
                return genVecNew(&mut cg, hintTy)
            }
            // `Vec.filled(n, v)`: allocate n slots and store v into each.
            if enumName == "Vec" && variant == "filled" && args.len == 2 {
                ensureVecTy(&mut cg)
                ensureMalloc(&mut cg)
                var vecTy = hintTy.clone()
                if !isVecTy(vecTy) {
                    vecTy = "Vec<i64>"
                }
                let elemTy = unwrapVec(resolveTyStr(cg, vecTy.clone()))
                let elemLl = llType(elemTy.clone())
                let n = genExpr(&mut cg, *args[0], locs, sigs, "i64")
                emitNonNegativeCheck(&mut cg, n.v, "length")
                // hint with the SURFACE elem type ("f32"), not its LLVM spelling: llType's
                // milo "float" alias for f64 also stringifies to "float", so passing
                // elemLl ("float", the true LLVM f32 type) collided with that alias and
                // genExpr's FloatLit hint check silently treated it as an f64 hint.
                let fill = genExpr(&mut cg, *args[1], locs, sigs, elemTy.clone())
                // genSizeOf, not llTypeBytes: the fill loop strides by elemLl, so a
                // struct element sized at llTypeBytes' 8-byte default would run the
                // stores clean off the end of the buffer.
                let esz = genSizeOf(&mut cg, elemLl.clone())
                let bytes = nextTemp(&mut cg)
                emit(&mut cg, "  " + bytes + " = mul i64 " + n.v.clone() + ", " + esz + "\n")
                let data = nextTemp(&mut cg)
                emit(&mut cg, "  " + data + " = call ptr @malloc(i64 " + bytes + ")\n")
                let ictr = nextTemp(&mut cg)
                emit(&mut cg, "  " + ictr + " = alloca i64\n")
                emit(&mut cg, "  store i64 0, ptr " + ictr + "\n")
                let condL = nextLabel(&mut cg, "vfill.cond")
                let bodyL = nextLabel(&mut cg, "vfill.body")
                let endL = nextLabel(&mut cg, "vfill.end")
                emit(&mut cg, "  br label %" + condL.clone() + "\n")
                emit(&mut cg, condL.clone() + ":\n")
                let iv = nextTemp(&mut cg)
                emit(&mut cg, "  " + iv + " = load i64, ptr " + ictr + "\n")
                let more = nextTemp(&mut cg)
                emit(&mut cg, "  " + more + " = icmp slt i64 " + iv + ", " + n.v.clone() + "\n")
                emit(&mut cg, "  br i1 " + more + ", label %" + bodyL.clone() + ", label %" + endL.clone() + "\n")
                emit(&mut cg, bodyL.clone() + ":\n")
                let slot = nextTemp(&mut cg)
                emit(&mut cg, "  " + slot + " = getelementptr " + elemLl.clone() + ", ptr " + data + ", i64 " + iv + "\n")
                emit(&mut cg, "  store " + elemLl.clone() + " " + fill.v.clone() + ", ptr " + slot + "\n")
                let inext = nextTemp(&mut cg)
                emit(&mut cg, "  " + inext + " = add i64 " + iv + ", 1\n")
                emit(&mut cg, "  store i64 " + inext + ", ptr " + ictr + "\n")
                emit(&mut cg, "  br label %" + condL.clone() + "\n")
                emit(&mut cg, endL.clone() + ":\n")
                let v0 = nextTemp(&mut cg)
                emit(&mut cg, "  " + v0 + " = insertvalue %Vec undef, ptr " + data + ", 0\n")
                let v1 = nextTemp(&mut cg)
                emit(&mut cg, "  " + v1 + " = insertvalue %Vec " + v0 + ", i64 " + n.v.clone() + ", 1\n")
                let v2 = nextTemp(&mut cg)
                emit(&mut cg, "  " + v2 + " = insertvalue %Vec " + v1 + ", i64 " + n.v.clone() + ", 2\n")
                return Val {
                    v: v2, ty: vecTy
                }
            }
            if enumName == "String" && variant == "withCapacity" {
                // capacity is a growth hint; an empty string (cap 0 = literal
                // convention, push mallocs) is semantically equivalent
                return genStringLit(&mut cg, "")
            }
            // Promise.all/race → the generic free fns promiseAll/promiseRace
            // (mono picked by the Vec<Promise<T>> arg type in genCall).
            if enumName == "Promise" && (variant == "all" || variant == "race") {
                var pfn = "promiseAll"
                if variant == "race" {
                    pfn = "promiseRace"
                }
                var emptyTA: Vec<MiloType> = Vec.new()
                var noSpan2: Option<Span> = Option.None
                return genCall(&mut cg, pfn, args, emptyTA, locs, sigs, hintTy, noSpan2)
            }
            // `Kind.tryFrom(n)` on a payload-free enum -> Option<Kind>: Some(the
            // matched variant) when `n` equals one of the enum's discriminants,
            // None otherwise. Mirrors the oracle's genEnumTryFrom (src/codegen.ts) —
            // a fieldless enum's value IS its i32 tag, so the payload write is just
            // the matched integer, truncated.
            if variant == "tryFrom" && cg.enums.contains(enumName) && args.len == 1 {
                let srcInfo = cg.enums.get(enumName)!
                let nv = genExpr(&mut cg, *args[0], locs, sigs, "i64")
                var n64 = nv.v.clone()
                if llType(nv.ty) != "i64" {
                    let w = nextTemp(&mut cg)
                    var op = "sext"
                    if isUnsigned(nv.ty) {
                        op = "zext"
                    }
                    emit(&mut cg, "  " + w + " = " + op + " " + llType(nv.ty) + " " + n64 + " to i64\n")
                    n64 = w
                }
                var valid = "0"
                for vi in 0..srcInfo.variants.len {
                    let eq = nextTemp(&mut cg)
                    emit(&mut cg, "  " + eq + " = icmp eq i64 " + n64 + ", " + srcInfo.variants[vi].tag.toString() + "\n")
                    if valid == "0" {
                        valid = eq
                    } else {
                        let o = nextTemp(&mut cg)
                        emit(&mut cg, "  " + o + " = or i1 " + valid + ", " + eq + "\n")
                        valid = o
                    }
                }
                let optName = "Option_" + enumName.clone()
                let optTy = "%" + optName
                let someTag = lookupVariantTag(cg, optName, "Some")
                let noneTag = lookupVariantTag(cg, optName, "None")
                let res = nextTemp(&mut cg)
                emit(&mut cg, "  " + res + " = alloca " + optTy + "\n")
                let someBB = nextLabel(&mut cg, "tryfrom.some")
                let noneBB = nextLabel(&mut cg, "tryfrom.none")
                let doneBB = nextLabel(&mut cg, "tryfrom.done")
                emit(&mut cg, "  br i1 " + valid + ", label %" + someBB + ", label %" + noneBB + "\n")
                emitLabel(&mut cg, someBB)
                let sTagPtr = nextTemp(&mut cg)
                emit(&mut cg, "  " + sTagPtr + " = getelementptr " + optTy + ", ptr " + res + ", i32 0, i32 0\n")
                emit(&mut cg, "  store i32 " + someTag.toString() + ", ptr " + sTagPtr + "\n")
                let n32 = nextTemp(&mut cg)
                emit(&mut cg, "  " + n32 + " = trunc i64 " + n64 + " to i32\n")
                let payloadPtr = nextTemp(&mut cg)
                emit(&mut cg, "  " + payloadPtr + " = getelementptr " + optTy + ", ptr " + res + ", i32 0, i32 1\n")
                emit(&mut cg, "  store i32 " + n32 + ", ptr " + payloadPtr + "\n")
                emit(&mut cg, "  br label %" + doneBB + "\n")
                emitLabel(&mut cg, noneBB)
                let nTagPtr = nextTemp(&mut cg)
                emit(&mut cg, "  " + nTagPtr + " = getelementptr " + optTy + ", ptr " + res + ", i32 0, i32 0\n")
                emit(&mut cg, "  store i32 " + noneTag.toString() + ", ptr " + nTagPtr + "\n")
                emit(&mut cg, "  br label %" + doneBB + "\n")
                emitLabel(&mut cg, doneBB)
                let out = nextTemp(&mut cg)
                emit(&mut cg, "  " + out + " = load " + optTy + ", ptr " + res + "\n")
                return Val {
                    v: out, ty: optName
                }
            }
            return genEnumLit(&mut cg, enumName, variant, args, locs, sigs, hintTy)
        }
        Expr.CastExpr(inner, targetType) => {
            // full astTypeStr, not just .name: `x as *i64` must keep pointer-ness
            // (otherwise the target reads as plain i64 and the cast result loses it)
            //
            // Resolved rather than raw: genAsCast uses this string as a Val's type without
            // resolving it, so a cast to a generic used to carry the reconstructed bracket
            // form onward instead of the mangled name the checker registered. Going through
            // resolveTyStr both fixes the name and picks up its fail-closed check.
            return genAsCast(&mut cg, *inner, resolveTyStr(cg, astTypeStr(targetType)), locs, sigs)
        }
        Expr.MethodCall(object, method, args) => {
            return genMethodCall(&mut cg, *object, method, args, locs, sigs)
        }
        Expr.IndexAccess(obj, idx) => {
            return genIndex(&mut cg, *obj, *idx, locs, sigs)
        }
        // Both body-carrying expression forms read their statements out of the block
        // arena: lowering emptied the AST bodies, because they had to be lowered while
        // lowering still OWNED the AST.
        Expr.IfExpr(cond, thenBody, elseBody) => {
            let base = blockBase(cg, e.id, "if-expression")
            var thenB = takeBlock(&mut cg, base)
            var elseB = takeBlock(&mut cg, base + 1)
            let v = genIfExprValue(&mut cg, *cond, thenB, elseB, &mut locs, sigs, hintTy.clone())
            putBlock(&mut cg, base, thenB)
            putBlock(&mut cg, base + 1, elseB)
            return v
        }
        Expr.MatchExpr(subject, arms) => {
            // cg.curRetTy is the enclosing function's return type — needed so a
            // diverging arm's `return` statement (genStmt, reached through
            // genArmBody) emits the right `ret <ty> …`, same as any other return.
            let retTyStr = cg.curRetTy.clone()
            let base = blockBase(cg, e.id, "match-expression")
            var armsH = takeArms(&mut cg, base)
            let mg = genMatchAst(&mut cg, *subject, armsH, &mut locs, sigs, retTyStr, true, hintTy)
            putArms(&mut cg, base, armsH)
            return mg.val
        }
        Expr.ArrayLit(elems) => {
            return genArrayLit(&mut cg, elems, locs, sigs, hintTy)
        }
        Expr.ArrayRepeat(value, count) => {
            return genArrayRepeat(&mut cg, *value, count, locs, sigs, hintTy)
        }
        Expr.Unwrap(inner) => {
            // `x!` takes the payload OUT of x — including the temp the let-else
            // desugar unwraps (`let v = __letelse_N!`). Without recording that move
            // the enclosing scope drops x too and the payload the binding now owns is
            // freed under it (letElse returned an empty string).
            let uv = genUnwrap(&mut cg, *inner, e.span, locs, sigs)
            markReceiverMoved(&mut cg, *inner, locs, sigs)
            return uv
        }
        Expr.DefaultValue(inner, defaultE) => {
            return genDefaultValue(&mut cg, *inner, *defaultE, locs, sigs)
        }
        Expr.Propagate(inner) => {
            // `x?` moves the payload out on the success path and the error value into
            // the early return — either way x no longer owns it (same as Unwrap above).
            let pv = genPropagate(&mut cg, *inner, locs, sigs)
            markReceiverMoved(&mut cg, *inner, locs, sigs)
            return pv
        }
        Expr.IsExpr(subject, pattern) => {
            return genIsExpr(&mut cg, *subject, *pattern, locs, sigs)
        }
        _ => {
            return Val {
                v: "0", ty: "i64"
            }
        }
    }
}
