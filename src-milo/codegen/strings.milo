// String codegen: literals, concat, equality, clone, int-to-string
from "src-milo/codegen/types.milo" import {
    ensureRealloc, nextLabel, ensureStrtod,
    Cgen, Val, emit, emitG, emitLabel, nextTemp, ensureStringTy, ensureMalloc, ensureMemcpy, ensureMemcmp,
    ensureAbort, ensureDprintf, ensureFflush
}
from "std/binary" import {
    Bytes
}

// -- Hex encoding for string literal bytes --

pub fn hexDigit(n: u8): u8 {
    if n < 10 {
        return n + 48
    }
    return n - 10 + 65
}

pub fn hex2(b: u8): string {
    var s = ""
    s.push(hexDigit(b >> 4))
    s.push(hexDigit(b & 15))
    return s
}

// 16 hex digits, most-significant byte first (matches LLVM's hex-float spelling).
pub fn hexU64(bits: u64): string {
    var s = ""
    var shift: u64 = 56
    for _i in 0..8 {
        let byte = (bits >> shift) as u8
        s = s + hex2(byte)
        // the final iteration would underflow an unsigned subtraction, and
        // arithmetic is checked, so stop shifting once the low byte is out
        if shift == 0 {
            return s
        }
        shift = shift - 8
    }
    return s
}

// The decimal spelling of an f64 CONSTANT for LLVM IR: f.toString() drops the
// decimal point for whole values (0.0 -> "0") and uses bare exponential
// notation for very large/small magnitudes (1e+21) — LLVM's grammar requires
// an actual '.' before any exponent marker ("1e+21" is rejected as "integer
// constant must have integer type"; it needs "1.0e+21"). Insert the missing
// decimal point rather than just checking whether one is present anywhere in
// the string. Shared by genExpr's FloatLit and the global-initializer/
// const-fold paths in emit.milo — all three used to carry their own copy of
// this, and only one had the exponent case fixed.
pub fn floatDecimalStr(f: f64): string {
    var fs = f.toString()
    var dotPos = 0 - 1
    var ePos = 0 - 1
    for ci in 0..fs.len {
        if fs[ci] == 46 {
            dotPos = ci
        }
        if fs[ci] == 101 || fs[ci] == 69 {
            ePos = ci
        }
    }
    if dotPos < 0 {
        if ePos >= 0 {
            fs = fs[0..ePos].clone() + ".0" + fs[ePos..fs.len].clone()
        } else {
            fs = fs + ".0"
        }
    }
    return fs
}

// LLVM's hex-float syntax always spells a `float`/`double` constant as the
// 64-bit bit pattern of a DOUBLE — even a 32-bit `float` operand's hex form is
// the double that value promotes to (LLVM langref quirk). A plain decimal
// literal works for f64 (Milo's own f64.toString() is shortest round-trip, so
// it re-parses to the exact same bits) but not for f32: the literal's
// f64-precision decimal does not reduce to an exactly-representable float32
// value, and LLVM's parser hard-rejects it with "floating point constant
// invalid for type". Round through f32 first, then take the resulting
// double's bits — mirrors the oracle's formatFloatBits (src/codegen.ts).
pub fn formatF32Bits(v: f64): string {
    let rounded: f64 = (v as f32) as f64
    let bits = Bytes.f64ToBits(rounded)
    return "0x" + hexU64(bits)
}

// Emit a global constant for a string literal. Returns @.strN label.
// Handles escape sequences: \n \t \r \\ \" \0
pub fn emitStringLit(cg: &mut Cgen, raw: &string): string {
    let id = cg.strId
    cg.strId = cg.strId + 1
    let label = "@.str" + id.toString()
    var encoded = ""
    var byteCount: i64 = 0
    var i: i64 = 0
    // `raw` is the already-decoded runtime string: a backslash byte is a
    // literal backslash, NOT an escape introducer. Escape each byte on its own
    // (mirrors the oracle's addString) — re-decoding \n/\0 here would bake a
    // real NUL into the constant and truncate the emitted IR at print time.
    while i < raw.len {
        let c = raw[i]
        if c < 32 || c == 34 || c == 92 || c >= 127 {
            // Push the three bytes rather than `encoded = encoded + "\\" + hex2(c)`:
            // that concat copies the whole accumulator per escaped byte, which is
            // quadratic in the escape count. Printable text hides it (it takes the
            // push path below), but a @embedFile'd binary escapes nearly every byte
            // — 22 MB of PNG made this loop effectively non-terminating.
            encoded.push(92)
            encoded.push(hexDigit(c >> 4))
            encoded.push(hexDigit(c & 15))
        } else {
            encoded.push(c)
        }
        i = i + 1
        byteCount = byteCount + 1
    }
    encoded.push(92)
    encoded.push(48)
    encoded.push(48)
    let total = byteCount + 1
    emitG(&mut cg, label + " = private unnamed_addr constant [" + total.toString() + " x i8] c\"" + encoded + "\"\n")
    return label
}

// Print `msg` (a fully-formatted panic message — file/line are baked in at compile
// time, since spans are static in this AOT compiler, unlike the oracle's runtime
// %s/%d file-pointer plumbing) to stderr, flush stdout (block-buffered under a
// piped test harness — lost otherwise), then abort(): SIGABRT, not exit(1), so a
// supervisor can tell an abnormal exit from an ordinary one and a debugger breaks
// at the fault. `extraArgs` is a pre-formatted printf-style argument suffix (e.g.
// ", i32 " + idx) for a message with %d holes — most panics have none ("").
// Every runtime safety trap (overflow, bounds, div-by-zero, shift, negative
// length) funnels through this so the abort/fflush shape lives in one place.
pub fn emitPanic(cg: &mut Cgen, msg: &string, extraArgs: &string) {
    ensureDprintf(&mut cg)
    ensureFflush(&mut cg)
    ensureAbort(&mut cg)
    let fl = emitStringLit(&mut cg, msg)
    emit(&mut cg, "  call i32 (i32, ptr, ...) @dprintf(i32 2, ptr " + fl + extraArgs.clone() + ")\n")
    let fc = nextTemp(&mut cg)
    emit(&mut cg, "  " + fc + " = call i32 @fflush(ptr null)\n")
    emit(&mut cg, "  call void @abort()\n")
    emit(&mut cg, "  unreachable\n")
}

// Build %String aggregate { @.strN, len, 0 } for a string literal.
pub fn genStringLit(cg: &mut Cgen, raw: &string): Val {
    ensureStringTy(&mut cg)
    let label = emitStringLit(&mut cg, raw)
    let len = raw.len
    let s0 = nextTemp(&mut cg)
    emit(&mut cg, "  " + s0 + " = insertvalue %String undef, ptr " + label + ", 0\n")
    let s1 = nextTemp(&mut cg)
    emit(&mut cg, "  " + s1 + " = insertvalue %String " + s0 + ", i64 " + len.toString() + ", 1\n")
    let s2 = nextTemp(&mut cg)
    emit(&mut cg, "  " + s2 + " = insertvalue %String " + s1 + ", i64 0, 2\n")
    return Val {
        v: s2, ty: "string"
    }
}

// Deep copy a %String value. malloc + memcpy.
pub fn genStringClone(cg: &mut Cgen, sv: &string): Val {
    ensureStringTy(&mut cg)
    ensureMalloc(&mut cg)
    ensureMemcpy(&mut cg)
    let data = nextTemp(&mut cg)
    emit(&mut cg, "  " + data + " = extractvalue %String " + sv + ", 0\n")
    let len = nextTemp(&mut cg)
    emit(&mut cg, "  " + len + " = extractvalue %String " + sv + ", 1\n")
    let sz = nextTemp(&mut cg)
    emit(&mut cg, "  " + sz + " = add i64 " + len + ", 1\n")
    let buf = nextTemp(&mut cg)
    emit(&mut cg, "  " + buf + " = call ptr @malloc(i64 " + sz + ")\n")
    emit(&mut cg, "  call ptr @memcpy(ptr " + buf + ", ptr " + data + ", i64 " + len + ")\n")
    let np = nextTemp(&mut cg)
    emit(&mut cg, "  " + np + " = getelementptr i8, ptr " + buf + ", i64 " + len + "\n")
    emit(&mut cg, "  store i8 0, ptr " + np + "\n")
    let s0 = nextTemp(&mut cg)
    emit(&mut cg, "  " + s0 + " = insertvalue %String undef, ptr " + buf + ", 0\n")
    let s1 = nextTemp(&mut cg)
    emit(&mut cg, "  " + s1 + " = insertvalue %String " + s0 + ", i64 " + len + ", 1\n")
    // cap = allocated bytes (sz), not undef: a later in-place append reads cap to
    // decide whether to grow — leaving it undef risks writing past this buffer.
    let s2 = nextTemp(&mut cg)
    emit(&mut cg, "  " + s2 + " = insertvalue %String " + s1 + ", i64 " + sz + ", 2\n")
    return Val {
        v: s2, ty: "string"
    }
}

// String concat: malloc(a.len + b.len + 1), memcpy both halves.
pub fn genStringConcat(cg: &mut Cgen, av: &string, bv: &string): Val {
    ensureStringTy(&mut cg)
    ensureMalloc(&mut cg)
    ensureMemcpy(&mut cg)
    let aData = nextTemp(&mut cg)
    emit(&mut cg, "  " + aData + " = extractvalue %String " + av + ", 0\n")
    let aLen = nextTemp(&mut cg)
    emit(&mut cg, "  " + aLen + " = extractvalue %String " + av + ", 1\n")
    let bData = nextTemp(&mut cg)
    emit(&mut cg, "  " + bData + " = extractvalue %String " + bv + ", 0\n")
    let bLen = nextTemp(&mut cg)
    emit(&mut cg, "  " + bLen + " = extractvalue %String " + bv + ", 1\n")
    let total = nextTemp(&mut cg)
    emit(&mut cg, "  " + total + " = add i64 " + aLen + ", " + bLen + "\n")
    let allocSz = nextTemp(&mut cg)
    emit(&mut cg, "  " + allocSz + " = add i64 " + total + ", 1\n")
    let buf = nextTemp(&mut cg)
    emit(&mut cg, "  " + buf + " = call ptr @malloc(i64 " + allocSz + ")\n")
    emit(&mut cg, "  call ptr @memcpy(ptr " + buf + ", ptr " + aData + ", i64 " + aLen + ")\n")
    let dst = nextTemp(&mut cg)
    emit(&mut cg, "  " + dst + " = getelementptr i8, ptr " + buf + ", i64 " + aLen + "\n")
    emit(&mut cg, "  call ptr @memcpy(ptr " + dst + ", ptr " + bData + ", i64 " + bLen + ")\n")
    let np = nextTemp(&mut cg)
    emit(&mut cg, "  " + np + " = getelementptr i8, ptr " + buf + ", i64 " + total + "\n")
    emit(&mut cg, "  store i8 0, ptr " + np + "\n")
    let s0 = nextTemp(&mut cg)
    emit(&mut cg, "  " + s0 + " = insertvalue %String undef, ptr " + buf + ", 0\n")
    let s1 = nextTemp(&mut cg)
    emit(&mut cg, "  " + s1 + " = insertvalue %String " + s0 + ", i64 " + total + ", 1\n")
    // cap = allocated bytes so a later in-place append knows the true capacity.
    let s2 = nextTemp(&mut cg)
    emit(&mut cg, "  " + s2 + " = insertvalue %String " + s1 + ", i64 " + allocSz + ", 2\n")
    return Val {
        v: s2, ty: "string"
    }
}

// Append `bv` (a %String value) onto the %String at `addr` in place, growing
// with amortized doubling. Mirrors genStringPush but copies bLen bytes. Used by
// the `place = place + rhs` assign optimization: the naive genStringConcat path
// allocates a fresh buffer and leaks the old one every append, making an
// accumulator like `cg.body = cg.body + s` O(n^2) in both time and memory.
pub fn genStringAppendInPlace(cg: &mut Cgen, addr: &string, bv: &string) {
    ensureStringTy(&mut cg)
    ensureRealloc(&mut cg)
    let dPtr = nextTemp(&mut cg)
    emit(&mut cg, "  " + dPtr + " = getelementptr %String, ptr " + addr.clone() + ", i32 0, i32 0\n")
    let lPtr = nextTemp(&mut cg)
    emit(&mut cg, "  " + lPtr + " = getelementptr %String, ptr " + addr.clone() + ", i32 0, i32 1\n")
    let cPtr = nextTemp(&mut cg)
    emit(&mut cg, "  " + cPtr + " = getelementptr %String, ptr " + addr.clone() + ", i32 0, i32 2\n")
    let d = nextTemp(&mut cg)
    emit(&mut cg, "  " + d + " = load ptr, ptr " + dPtr + "\n")
    let l = nextTemp(&mut cg)
    emit(&mut cg, "  " + l + " = load i64, ptr " + lPtr + "\n")
    let cap = nextTemp(&mut cg)
    emit(&mut cg, "  " + cap + " = load i64, ptr " + cPtr + "\n")

    let bData = nextTemp(&mut cg)
    emit(&mut cg, "  " + bData + " = extractvalue %String " + bv.clone() + ", 0\n")
    let bLen = nextTemp(&mut cg)
    emit(&mut cg, "  " + bLen + " = extractvalue %String " + bv.clone() + ", 1\n")

    let newLen = nextTemp(&mut cg)
    emit(&mut cg, "  " + newLen + " = add i64 " + l + ", " + bLen + "\n")
    let need = nextTemp(&mut cg)
    emit(&mut cg, "  " + need + " = add i64 " + newLen + ", 1\n")
    let small = nextTemp(&mut cg)
    emit(&mut cg, "  " + small + " = icmp ult i64 " + cap + ", " + need + "\n")
    let growLbl = nextLabel(&mut cg, "strapp.grow")
    let storeLbl = nextLabel(&mut cg, "strapp.store")
    emit(&mut cg, "  br i1 " + small + ", label %" + growLbl + ", label %" + storeLbl + "\n")

    emit(&mut cg, growLbl + ":\n")
    let dbl = nextTemp(&mut cg)
    emit(&mut cg, "  " + dbl + " = mul i64 " + cap + ", 2\n")
    let bigger = nextTemp(&mut cg)
    emit(&mut cg, "  " + bigger + " = icmp ugt i64 " + dbl + ", " + need + "\n")
    let newCap = nextTemp(&mut cg)
    emit(&mut cg, "  " + newCap + " = select i1 " + bigger + ", i64 " + dbl + ", i64 " + need + "\n")
    // cap == 0 means the buffer is a string literal in .rodata — realloc'ing it
    // is an invalid free, so copy it out to a fresh heap block instead.
    let isStatic = nextTemp(&mut cg)
    emit(&mut cg, "  " + isStatic + " = icmp eq i64 " + cap + ", 0\n")
    let copyLbl = nextLabel(&mut cg, "strapp.copy")
    let reallocLbl = nextLabel(&mut cg, "strapp.realloc")
    let grownLbl = nextLabel(&mut cg, "strapp.grown")
    emit(&mut cg, "  br i1 " + isStatic + ", label %" + copyLbl + ", label %" + reallocLbl + "\n")

    emit(&mut cg, copyLbl + ":\n")
    ensureMalloc(&mut cg)
    ensureMemcpy(&mut cg)
    let fresh = nextTemp(&mut cg)
    emit(&mut cg, "  " + fresh + " = call ptr @malloc(i64 " + newCap + ")\n")
    emit(&mut cg, "  call ptr @memcpy(ptr " + fresh + ", ptr " + d + ", i64 " + l + ")\n")
    emit(&mut cg, "  br label %" + grownLbl + "\n")

    emit(&mut cg, reallocLbl + ":\n")
    let grown = nextTemp(&mut cg)
    emit(&mut cg, "  " + grown + " = call ptr @realloc(ptr " + d + ", i64 " + newCap + ")\n")
    emit(&mut cg, "  br label %" + grownLbl + "\n")

    emit(&mut cg, grownLbl + ":\n")
    let nd = nextTemp(&mut cg)
    emit(&mut cg, "  " + nd + " = phi ptr [ " + fresh + ", %" + copyLbl + " ], [ " + grown + ", %" + reallocLbl + " ]\n")
    emit(&mut cg, "  store ptr " + nd + ", ptr " + dPtr + "\n")
    emit(&mut cg, "  store i64 " + newCap + ", ptr " + cPtr + "\n")
    emit(&mut cg, "  br label %" + storeLbl + "\n")

    emit(&mut cg, storeLbl + ":\n")
    ensureMemcpy(&mut cg)
    let dd = nextTemp(&mut cg)
    emit(&mut cg, "  " + dd + " = load ptr, ptr " + dPtr + "\n")
    let slot = nextTemp(&mut cg)
    emit(&mut cg, "  " + slot + " = getelementptr i8, ptr " + dd + ", i64 " + l + "\n")
    emit(&mut cg, "  call ptr @memcpy(ptr " + slot + ", ptr " + bData + ", i64 " + bLen + ")\n")
    emit(&mut cg, "  store i64 " + newLen + ", ptr " + lPtr + "\n")
    let nulSlot = nextTemp(&mut cg)
    emit(&mut cg, "  " + nulSlot + " = getelementptr i8, ptr " + dd + ", i64 " + newLen + "\n")
    emit(&mut cg, "  store i8 0, ptr " + nulSlot + "\n")
}

// String equality via length check + memcmp. Returns i1.
// Lexicographic string comparison for < <= > >=. memcmp over min(len), then the
// shorter string is "less" on a shared prefix. Returns i1.
pub fn genStringCmp(cg: &mut Cgen, av: &string, bv: &string, op: &string): Val {
    ensureMemcmp(&mut cg)
    let aData = nextTemp(&mut cg)
    emit(&mut cg, "  " + aData + " = extractvalue %String " + av.clone() + ", 0\n")
    let aLen = nextTemp(&mut cg)
    emit(&mut cg, "  " + aLen + " = extractvalue %String " + av.clone() + ", 1\n")
    let bData = nextTemp(&mut cg)
    emit(&mut cg, "  " + bData + " = extractvalue %String " + bv.clone() + ", 0\n")
    let bLen = nextTemp(&mut cg)
    emit(&mut cg, "  " + bLen + " = extractvalue %String " + bv.clone() + ", 1\n")
    let aLtB = nextTemp(&mut cg)
    emit(&mut cg, "  " + aLtB + " = icmp ult i64 " + aLen + ", " + bLen + "\n")
    let minLen = nextTemp(&mut cg)
    emit(&mut cg, "  " + minLen + " = select i1 " + aLtB + ", i64 " + aLen + ", i64 " + bLen + "\n")
    let mc = nextTemp(&mut cg)
    emit(&mut cg, "  " + mc + " = call i32 @memcmp(ptr " + aData + ", ptr " + bData + ", i64 " + minLen + ")\n")
    let mc64 = nextTemp(&mut cg)
    emit(&mut cg, "  " + mc64 + " = sext i32 " + mc + " to i64\n")
    let mcNZ = nextTemp(&mut cg)
    emit(&mut cg, "  " + mcNZ + " = icmp ne i64 " + mc64 + ", 0\n")
    let lenDiff = nextTemp(&mut cg)
    emit(&mut cg, "  " + lenDiff + " = sub i64 " + aLen + ", " + bLen + "\n")
    // effective sign: memcmp result if the prefix differs, else the length delta
    let eff = nextTemp(&mut cg)
    emit(&mut cg, "  " + eff + " = select i1 " + mcNZ + ", i64 " + mc64 + ", i64 " + lenDiff + "\n")
    var pred = "slt"
    if op == "<=" {
        pred = "sle"
    } 
    else if op == ">" {
        pred = "sgt"
    } 
    else if op == ">=" {
        pred = "sge"
    }
    let r = nextTemp(&mut cg)
    emit(&mut cg, "  " + r + " = icmp " + pred + " i64 " + eff + ", 0\n")
    return Val {
        v: r, ty: "bool"
    }
}

pub fn genStringEq(cg: &mut Cgen, av: &string, bv: &string, wantEq: bool): Val {
    ensureMemcmp(&mut cg)
    let aLen = nextTemp(&mut cg)
    emit(&mut cg, "  " + aLen + " = extractvalue %String " + av + ", 1\n")
    let bLen = nextTemp(&mut cg)
    emit(&mut cg, "  " + bLen + " = extractvalue %String " + bv + ", 1\n")
    let lenEq = nextTemp(&mut cg)
    emit(&mut cg, "  " + lenEq + " = icmp eq i64 " + aLen + ", " + bLen + "\n")
    let aData = nextTemp(&mut cg)
    emit(&mut cg, "  " + aData + " = extractvalue %String " + av + ", 0\n")
    let bData = nextTemp(&mut cg)
    emit(&mut cg, "  " + bData + " = extractvalue %String " + bv + ", 0\n")
    // memcmp runs unconditionally (its result is AND-ed with lenEq), so it must
    // read only min(aLen,bLen) bytes — using aLen overflows the shorter buffer
    // when lengths differ (a global-buffer-overflow; opt-level-sensitive UB).
    let aLtB = nextTemp(&mut cg)
    emit(&mut cg, "  " + aLtB + " = icmp ult i64 " + aLen + ", " + bLen + "\n")
    let minLen = nextTemp(&mut cg)
    emit(&mut cg, "  " + minLen + " = select i1 " + aLtB + ", i64 " + aLen + ", i64 " + bLen + "\n")
    let mc = nextTemp(&mut cg)
    emit(&mut cg, "  " + mc + " = call i32 @memcmp(ptr " + aData + ", ptr " + bData + ", i64 " + minLen + ")\n")
    let mcZero = nextTemp(&mut cg)
    emit(&mut cg, "  " + mcZero + " = icmp eq i32 " + mc + ", 0\n")
    let combined = nextTemp(&mut cg)
    emit(&mut cg, "  " + combined + " = and i1 " + lenEq + ", " + mcZero + "\n")
    if wantEq {
        return Val {
            v: combined, ty: "bool"
        }
    }
    let neg = nextTemp(&mut cg)
    emit(&mut cg, "  " + neg + " = xor i1 " + combined + ", 1\n")
    return Val {
        v: neg, ty: "bool"
    }
}

// Integer → string via snprintf (two-pass: measure then format).
pub fn genIntToString(cg: &mut Cgen, val: &string, unsigned: bool): Val {
    ensureStringTy(&mut cg)
    ensureMalloc(&mut cg)
    if !cg.declaredSnprintf {
        emitG(&mut cg, "declare i32 @snprintf(ptr, i64, ptr, ...)\n")
        cg.declaredSnprintf = true
    }
    var fmtS = "%lld"
    if unsigned {
        fmtS = "%llu"
    }
    let fmt = emitStringLit(&mut cg, fmtS)
    let len = nextTemp(&mut cg)
    emit(&mut cg, "  " + len + " = call i32 (ptr, i64, ptr, ...) @snprintf(ptr null, i64 0, ptr " + fmt + ", i64 " + val + ")\n")
    let len64 = nextTemp(&mut cg)
    emit(&mut cg, "  " + len64 + " = sext i32 " + len + " to i64\n")
    let sz = nextTemp(&mut cg)
    emit(&mut cg, "  " + sz + " = add i64 " + len64 + ", 1\n")
    let buf = nextTemp(&mut cg)
    emit(&mut cg, "  " + buf + " = call ptr @malloc(i64 " + sz + ")\n")
    emit(&mut cg, "  call i32 (ptr, i64, ptr, ...) @snprintf(ptr " + buf + ", i64 " + sz + ", ptr " + fmt + ", i64 " + val + ")\n")
    let s0 = nextTemp(&mut cg)
    emit(&mut cg, "  " + s0 + " = insertvalue %String undef, ptr " + buf + ", 0\n")
    let s1 = nextTemp(&mut cg)
    emit(&mut cg, "  " + s1 + " = insertvalue %String " + s0 + ", i64 " + len64 + ", 1\n")
    // cap = allocated bytes so a later in-place append knows the true capacity.
    let s2 = nextTemp(&mut cg)
    emit(&mut cg, "  " + s2 + " = insertvalue %String " + s1 + ", i64 " + sz + ", 2\n")
    return Val {
        v: s2, ty: "string"
    }
}

// double.toString() — snprintf("%g") into an owned heap buffer
// The shortest decimal string that reads back as the bit-identical value — the same
// algorithm the oracle emits (codegen.ts ensureFloatFormatHelper), because the two must
// agree digit for digit. Plain "%g" is 6 significant digits and silently destroys data:
// pi printed as 3.14159, 123456789.123456 as 1.23457e+08.
//
// Two loops. The first counts integer digits by walking powers of ten; the second raises
// "%.*g" precision until the text parses back equal. Precision must START at the
// integer-digit count, not at 1: %g switches to exponent form once the exponent reaches
// the precision, so %.1g of 100.0 is the round-tripping but unreadable "1e+02".
//
// The digit walk uses only comparisons and a multiply, so it needs no libm. NaN makes
// every fcmp false, so it takes dig=1, never compares equal, and falls out at the cap as
// "nan"; infinity saturates the walk and prints "inf".
fn ensureFloatFmt(cg: &mut Cgen) {
    if cg.declaredFloatFmt {
        return
    }
    cg.declaredFloatFmt = true
    if !cg.declaredSnprintf {
        emitG(&mut cg, "declare i32 @snprintf(ptr, i64, ptr, ...)\n")
        cg.declaredSnprintf = true
    }
    // Reuse the shared guard: emitting the declaration unconditionally collided with the
    // one ensureStrtod already emits, and LLVM rejects a redefinition.
    ensureStrtod(&mut cg)
    let fmt = emitStringLit(&mut cg, "%.*g")
    emitG(&mut cg, "define private i64 @milo.fmt.f64(double %v, ptr %buf) {\n")
    emitG(&mut cg, "entry.bb:\n")
    emitG(&mut cg, "  %d = fadd double %v, 0.000000e+00\n")
    emitG(&mut cg, "  %isneg = fcmp olt double %d, 0.000000e+00\n")
    emitG(&mut cg, "  %negd = fneg double %d\n")
    emitG(&mut cg, "  %av = select i1 %isneg, double %negd, double %d\n")
    emitG(&mut cg, "  br label %dloop\n")
    emitG(&mut cg, "dloop:\n")
    emitG(&mut cg, "  %dig = phi i32 [ 1, %entry.bb ], [ %dignext, %dnext ]\n")
    emitG(&mut cg, "  %pow = phi double [ 1.000000e+01, %entry.bb ], [ %pownext, %dnext ]\n")
    emitG(&mut cg, "  %room = icmp slt i32 %dig, 17\n")
    emitG(&mut cg, "  %over = fcmp oge double %av, %pow\n")
    emitG(&mut cg, "  %grow = and i1 %room, %over\n")
    emitG(&mut cg, "  br i1 %grow, label %dnext, label %ploop\n")
    emitG(&mut cg, "dnext:\n")
    emitG(&mut cg, "  %dignext = add i32 %dig, 1\n")
    emitG(&mut cg, "  %pownext = fmul double %pow, 1.000000e+01\n")
    emitG(&mut cg, "  br label %dloop\n")
    emitG(&mut cg, "ploop:\n")
    emitG(&mut cg, "  %p = phi i32 [ %dig, %dloop ], [ %pnext, %again ]\n")
    emitG(&mut cg, "  %n = call i32 (ptr, i64, ptr, ...) @snprintf(ptr %buf, i64 64, ptr " + fmt + ", i32 %p, double %d)\n")
    emitG(&mut cg, "  %back = call double @strtod(ptr %buf, ptr null)\n")
    emitG(&mut cg, "  %exact = fcmp oeq double %back, %v\n")
    emitG(&mut cg, "  %last = icmp sge i32 %p, 17\n")
    emitG(&mut cg, "  %stop = or i1 %exact, %last\n")
    emitG(&mut cg, "  br i1 %stop, label %fin, label %again\n")
    emitG(&mut cg, "again:\n")
    emitG(&mut cg, "  %pnext = add i32 %p, 1\n")
    emitG(&mut cg, "  br label %ploop\n")
    emitG(&mut cg, "fin:\n")
    emitG(&mut cg, "  %n64 = sext i32 %n to i64\n")
    emitG(&mut cg, "  ret i64 %n64\n")
    emitG(&mut cg, "}\n")
}

// Naive substring search shared by every `lines()`/`splitView()` for-in loop: returns
// the byte offset of the needle in the haystack at or after `from`, or -1. Emitted
// once per module (like the float formatters above) — a Milo-level strIndexOfFrom
// can't be reused here because codegen cannot assume std/string is imported by the
// program being compiled.
pub fn ensureStrFind(cg: &mut Cgen) {
    if cg.declaredStrFind {
        return
    }
    cg.declaredStrFind = true
    ensureMemcmp(&mut cg)
    emitG(&mut cg, "define private i64 @milo.strfind(ptr %h, i64 %hlen, ptr %n, i64 %nlen, i64 %from) {\n")
    emitG(&mut cg, "entry:\n")
    // negative when the needle is longer than the haystack, which makes the first
    // comparison below fail and the search miss without a special case
    emitG(&mut cg, "  %limit = sub i64 %hlen, %nlen\n")
    emitG(&mut cg, "  br label %loop\n")
    emitG(&mut cg, "loop:\n")
    emitG(&mut cg, "  %i = phi i64 [ %from, %entry ], [ %inext, %next ]\n")
    emitG(&mut cg, "  %past = icmp sgt i64 %i, %limit\n")
    emitG(&mut cg, "  br i1 %past, label %miss, label %cmp\n")
    emitG(&mut cg, "cmp:\n")
    emitG(&mut cg, "  %p = getelementptr i8, ptr %h, i64 %i\n")
    emitG(&mut cg, "  %c = call i32 @memcmp(ptr %p, ptr %n, i64 %nlen)\n")
    emitG(&mut cg, "  %eq = icmp eq i32 %c, 0\n")
    emitG(&mut cg, "  br i1 %eq, label %hit, label %next\n")
    emitG(&mut cg, "next:\n")
    emitG(&mut cg, "  %inext = add i64 %i, 1\n")
    emitG(&mut cg, "  br label %loop\n")
    emitG(&mut cg, "hit:\n")
    emitG(&mut cg, "  ret i64 %i\n")
    emitG(&mut cg, "miss:\n")
    emitG(&mut cg, "  ret i64 -1\n")
    emitG(&mut cg, "}\n")
}

// f32 needs its own helper, not an fpext into the f64 one: the shortest string that
// round-trips a FLOAT is not the shortest that round-trips the double it widens to.
// 9 significant digits suffice for f32 (17 for f64), and the read-back must go through
// strtof so the comparison happens at float precision.
fn ensureFloatFmt32(cg: &mut Cgen) {
    if cg.declaredFloatFmt32 {
        return
    }
    cg.declaredFloatFmt32 = true
    if !cg.declaredSnprintf {
        emitG(&mut cg, "declare i32 @snprintf(ptr, i64, ptr, ...)\n")
        cg.declaredSnprintf = true
    }
    emitG(&mut cg, "declare float @strtof(ptr, ptr)\n")
    let fmt = emitStringLit(&mut cg, "%.*g")
    emitG(&mut cg, "define private i64 @milo.fmt.f32(float %v, ptr %buf) {\n")
    emitG(&mut cg, "entry.bb:\n")
    emitG(&mut cg, "  %d = fpext float %v to double\n")
    emitG(&mut cg, "  %isneg = fcmp olt double %d, 0.000000e+00\n")
    emitG(&mut cg, "  %negd = fneg double %d\n")
    emitG(&mut cg, "  %av = select i1 %isneg, double %negd, double %d\n")
    emitG(&mut cg, "  br label %dloop\n")
    emitG(&mut cg, "dloop:\n")
    emitG(&mut cg, "  %dig = phi i32 [ 1, %entry.bb ], [ %dignext, %dnext ]\n")
    emitG(&mut cg, "  %pow = phi double [ 1.000000e+01, %entry.bb ], [ %pownext, %dnext ]\n")
    emitG(&mut cg, "  %room = icmp slt i32 %dig, 9\n")
    emitG(&mut cg, "  %over = fcmp oge double %av, %pow\n")
    emitG(&mut cg, "  %grow = and i1 %room, %over\n")
    emitG(&mut cg, "  br i1 %grow, label %dnext, label %ploop\n")
    emitG(&mut cg, "dnext:\n")
    emitG(&mut cg, "  %dignext = add i32 %dig, 1\n")
    emitG(&mut cg, "  %pownext = fmul double %pow, 1.000000e+01\n")
    emitG(&mut cg, "  br label %dloop\n")
    emitG(&mut cg, "ploop:\n")
    emitG(&mut cg, "  %p = phi i32 [ %dig, %dloop ], [ %pnext, %again ]\n")
    emitG(&mut cg, "  %n = call i32 (ptr, i64, ptr, ...) @snprintf(ptr %buf, i64 64, ptr " + fmt + ", i32 %p, double %d)\n")
    emitG(&mut cg, "  %back = call float @strtof(ptr %buf, ptr null)\n")
    emitG(&mut cg, "  %exact = fcmp oeq float %back, %v\n")
    emitG(&mut cg, "  %last = icmp sge i32 %p, 9\n")
    emitG(&mut cg, "  %stop = or i1 %exact, %last\n")
    emitG(&mut cg, "  br i1 %stop, label %fin, label %again\n")
    emitG(&mut cg, "again:\n")
    emitG(&mut cg, "  %pnext = add i32 %p, 1\n")
    emitG(&mut cg, "  br label %ploop\n")
    emitG(&mut cg, "fin:\n")
    emitG(&mut cg, "  %n64 = sext i32 %n to i64\n")
    emitG(&mut cg, "  ret i64 %n64\n")
    emitG(&mut cg, "}\n")
}

pub fn genFloat32ToString(cg: &mut Cgen, val: &string): Val {
    ensureStringTy(&mut cg)
    ensureMalloc(&mut cg)
    ensureFloatFmt32(&mut cg)
    let buf = nextTemp(&mut cg)
    emit(&mut cg, "  " + buf + " = call ptr @malloc(i64 64)\n")
    let len64 = nextTemp(&mut cg)
    emit(&mut cg, "  " + len64 + " = call i64 @milo.fmt.f32(float " + val.clone() + ", ptr " + buf + ")\n")
    let s0 = nextTemp(&mut cg)
    emit(&mut cg, "  " + s0 + " = insertvalue %String undef, ptr " + buf + ", 0\n")
    let s1 = nextTemp(&mut cg)
    emit(&mut cg, "  " + s1 + " = insertvalue %String " + s0 + ", i64 " + len64 + ", 1\n")
    let s2 = nextTemp(&mut cg)
    emit(&mut cg, "  " + s2 + " = insertvalue %String " + s1 + ", i64 64, 2\n")
    return Val {
        v: s2, ty: "string"
    }
}

pub fn genFloatToString(cg: &mut Cgen, val: &string): Val {
    ensureStringTy(&mut cg)
    ensureMalloc(&mut cg)
    ensureFloatFmt(&mut cg)
    let buf = nextTemp(&mut cg)
    emit(&mut cg, "  " + buf + " = call ptr @malloc(i64 64)\n")
    let len64 = nextTemp(&mut cg)
    emit(&mut cg, "  " + len64 + " = call i64 @milo.fmt.f64(double " + val.clone() + ", ptr " + buf + ")\n")
    let s0 = nextTemp(&mut cg)
    emit(&mut cg, "  " + s0 + " = insertvalue %String undef, ptr " + buf + ", 0\n")
    let s1 = nextTemp(&mut cg)
    emit(&mut cg, "  " + s1 + " = insertvalue %String " + s0 + ", i64 " + len64 + ", 1\n")
    let s2 = nextTemp(&mut cg)
    emit(&mut cg, "  " + s2 + " = insertvalue %String " + s1 + ", i64 64, 2\n")
    return Val {
        v: s2, ty: "string"
    }
}

// String index: s[i] → load byte
pub fn genStringIndex(cg: &mut Cgen, sv: &string, idx: &string): Val {
    let data = nextTemp(&mut cg)
    emit(&mut cg, "  " + data + " = extractvalue %String " + sv + ", 0\n")
    let p = nextTemp(&mut cg)
    emit(&mut cg, "  " + p + " = getelementptr i8, ptr " + data + ", i64 " + idx + "\n")
    let v = nextTemp(&mut cg)
    emit(&mut cg, "  " + v + " = load i8, ptr " + p + "\n")
    return Val {
        v: v, ty: "u8"
    }
}

// Validate a substr/slice range before using it: without this, an inverted or
// out-of-range span becomes a negative length that malloc/memcpy/getelementptr
// turn into a silent crash (or a bogus view) with no diagnostic. Mirrors the
// oracle's emitStringRangeCheck (src/codegen.ts) — `what` names the operation
// ("slice" or "substr") for the panic message, since src-milo unifies both
// call shapes (and the `s[a..b]` operator) onto genStringSlice below, unlike
// the oracle's two separate codegen fns.
pub fn emitStringRangeCheck(cg: &mut Cgen, sv: &string, av: &string, bv: &string, what: &string) {
    let len = nextTemp(&mut cg)
    emit(&mut cg, "  " + len + " = extractvalue %String " + sv.clone() + ", 1\n")
    let badStart = nextTemp(&mut cg)
    emit(&mut cg, "  " + badStart + " = icmp slt i64 " + av.clone() + ", 0\n")
    let badOrder = nextTemp(&mut cg)
    emit(&mut cg, "  " + badOrder + " = icmp slt i64 " + bv.clone() + ", " + av.clone() + "\n")
    let badEnd = nextTemp(&mut cg)
    emit(&mut cg, "  " + badEnd + " = icmp sgt i64 " + bv.clone() + ", " + len + "\n")
    let bad0 = nextTemp(&mut cg)
    emit(&mut cg, "  " + bad0 + " = or i1 " + badStart + ", " + badOrder + "\n")
    let bad = nextTemp(&mut cg)
    emit(&mut cg, "  " + bad + " = or i1 " + bad0 + ", " + badEnd + "\n")
    let panicLbl = nextLabel(&mut cg, what.clone() + ".panic")
    let okLbl = nextLabel(&mut cg, what.clone() + ".ok")
    emit(&mut cg, "  br i1 " + bad + ", label %" + panicLbl + ", label %" + okLbl + "\n")
    emit(&mut cg, panicLbl + ":\n")
    let msg = "milo: " + what.clone() + " range out of bounds: %lld..%lld (len %lld)\n"
    emitPanic(&mut cg, msg, ", i64 " + av.clone() + ", i64 " + bv.clone() + ", i64 " + len)
    // emitLabel, not plain emit: an enclosing phi node picks its predecessor
    // from cg.curBlock, which must name the block this check falls through to.
    emitLabel(&mut cg, okLbl)
}

// String slice: s[a..b] / .slice(a,b) / .substr(a,b) → owned copy (malloc + memcpy).
pub fn genStringSlice(cg: &mut Cgen, sv: &string, av: &string, bv: &string, what: &string): Val {
    emitStringRangeCheck(&mut cg, sv, av, bv, what)
    ensureMalloc(&mut cg)
    ensureMemcpy(&mut cg)
    let data = nextTemp(&mut cg)
    emit(&mut cg, "  " + data + " = extractvalue %String " + sv + ", 0\n")
    let len = nextTemp(&mut cg)
    emit(&mut cg, "  " + len + " = sub i64 " + bv + ", " + av + "\n")
    let sz = nextTemp(&mut cg)
    emit(&mut cg, "  " + sz + " = add i64 " + len + ", 1\n")
    let buf = nextTemp(&mut cg)
    emit(&mut cg, "  " + buf + " = call ptr @malloc(i64 " + sz + ")\n")
    let srcP = nextTemp(&mut cg)
    emit(&mut cg, "  " + srcP + " = getelementptr i8, ptr " + data + ", i64 " + av + "\n")
    emit(&mut cg, "  call ptr @memcpy(ptr " + buf + ", ptr " + srcP + ", i64 " + len + ")\n")
    let np = nextTemp(&mut cg)
    emit(&mut cg, "  " + np + " = getelementptr i8, ptr " + buf + ", i64 " + len + "\n")
    emit(&mut cg, "  store i8 0, ptr " + np + "\n")
    let s0 = nextTemp(&mut cg)
    emit(&mut cg, "  " + s0 + " = insertvalue %String undef, ptr " + buf + ", 0\n")
    let s1 = nextTemp(&mut cg)
    emit(&mut cg, "  " + s1 + " = insertvalue %String " + s0 + ", i64 " + len + ", 1\n")
    // cap = allocated bytes so a later in-place append knows the true capacity.
    let s2 = nextTemp(&mut cg)
    emit(&mut cg, "  " + s2 + " = insertvalue %String " + s1 + ", i64 " + sz + ", 2\n")
    return Val {
        v: s2, ty: "string"
    }
}

// Append one byte to a %String through its address. Keeps the NUL terminator so
// the buffer stays printf-safe (print() passes the data pointer to %s).
pub fn genStringPush(cg: &mut Cgen, addr: &string, byteVal: &string): Val {
    ensureStringTy(&mut cg)
    ensureRealloc(&mut cg)
    let dPtr = nextTemp(&mut cg)
    emit(&mut cg, "  " + dPtr + " = getelementptr %String, ptr " + addr.clone() + ", i32 0, i32 0\n")
    let lPtr = nextTemp(&mut cg)
    emit(&mut cg, "  " + lPtr + " = getelementptr %String, ptr " + addr.clone() + ", i32 0, i32 1\n")
    let cPtr = nextTemp(&mut cg)
    emit(&mut cg, "  " + cPtr + " = getelementptr %String, ptr " + addr.clone() + ", i32 0, i32 2\n")
    let d = nextTemp(&mut cg)
    emit(&mut cg, "  " + d + " = load ptr, ptr " + dPtr + "\n")
    let l = nextTemp(&mut cg)
    emit(&mut cg, "  " + l + " = load i64, ptr " + lPtr + "\n")
    let cap = nextTemp(&mut cg)
    emit(&mut cg, "  " + cap + " = load i64, ptr " + cPtr + "\n")

    // need room for the new byte plus the NUL
    let need = nextTemp(&mut cg)
    emit(&mut cg, "  " + need + " = add i64 " + l + ", 2\n")
    let small = nextTemp(&mut cg)
    emit(&mut cg, "  " + small + " = icmp ult i64 " + cap + ", " + need + "\n")
    let growLbl = nextLabel(&mut cg, "str.grow")
    let storeLbl = nextLabel(&mut cg, "str.store")
    emit(&mut cg, "  br i1 " + small + ", label %" + growLbl + ", label %" + storeLbl + "\n")

    emit(&mut cg, growLbl + ":\n")
    let dbl = nextTemp(&mut cg)
    emit(&mut cg, "  " + dbl + " = mul i64 " + cap + ", 2\n")
    let bigger = nextTemp(&mut cg)
    emit(&mut cg, "  " + bigger + " = icmp ugt i64 " + dbl + ", " + need + "\n")
    let newCap = nextTemp(&mut cg)
    emit(&mut cg, "  " + newCap + " = select i1 " + bigger + ", i64 " + dbl + ", i64 " + need + "\n")
    // cap == 0 means the buffer is a string literal living in .rodata, not a
    // heap block — realloc'ing it is an invalid free. Copy it out instead.
    let isStatic = nextTemp(&mut cg)
    emit(&mut cg, "  " + isStatic + " = icmp eq i64 " + cap + ", 0\n")
    let copyLbl = nextLabel(&mut cg, "str.copy")
    let reallocLbl = nextLabel(&mut cg, "str.realloc")
    let grownLbl = nextLabel(&mut cg, "str.grown")
    emit(&mut cg, "  br i1 " + isStatic + ", label %" + copyLbl + ", label %" + reallocLbl + "\n")

    emit(&mut cg, copyLbl + ":\n")
    ensureMalloc(&mut cg)
    ensureMemcpy(&mut cg)
    let fresh = nextTemp(&mut cg)
    emit(&mut cg, "  " + fresh + " = call ptr @malloc(i64 " + newCap + ")\n")
    emit(&mut cg, "  call ptr @memcpy(ptr " + fresh + ", ptr " + d + ", i64 " + l + ")\n")
    emit(&mut cg, "  br label %" + grownLbl + "\n")

    emit(&mut cg, reallocLbl + ":\n")
    let grown = nextTemp(&mut cg)
    emit(&mut cg, "  " + grown + " = call ptr @realloc(ptr " + d + ", i64 " + newCap + ")\n")
    emit(&mut cg, "  br label %" + grownLbl + "\n")

    emit(&mut cg, grownLbl + ":\n")
    let nd = nextTemp(&mut cg)
    emit(&mut cg, "  " + nd + " = phi ptr [ " + fresh + ", %" + copyLbl + " ], [ " + grown + ", %" + reallocLbl + " ]\n")
    emit(&mut cg, "  store ptr " + nd + ", ptr " + dPtr + "\n")
    emit(&mut cg, "  store i64 " + newCap + ", ptr " + cPtr + "\n")
    emit(&mut cg, "  br label %" + storeLbl + "\n")

    emit(&mut cg, storeLbl + ":\n")
    let dd = nextTemp(&mut cg)
    emit(&mut cg, "  " + dd + " = load ptr, ptr " + dPtr + "\n")
    let slot = nextTemp(&mut cg)
    emit(&mut cg, "  " + slot + " = getelementptr i8, ptr " + dd + ", i64 " + l + "\n")
    emit(&mut cg, "  store i8 " + byteVal.clone() + ", ptr " + slot + "\n")
    let l1 = nextTemp(&mut cg)
    emit(&mut cg, "  " + l1 + " = add i64 " + l + ", 1\n")
    emit(&mut cg, "  store i64 " + l1 + ", ptr " + lPtr + "\n")
    let nulSlot = nextTemp(&mut cg)
    emit(&mut cg, "  " + nulSlot + " = getelementptr i8, ptr " + dd + ", i64 " + l1 + "\n")
    emit(&mut cg, "  store i8 0, ptr " + nulSlot + "\n")
    return Val {
        v: "0", ty: "void"
    }
}
