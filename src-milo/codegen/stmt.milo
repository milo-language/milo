// Statement codegen: let/var, assign, if, while, for, match, break/continue.
//
// The walk is over HStmt — the checker already decided every type and every loop shape
// here. Expressions still cross into the untyped walk through HExpr.Unlowered, and each
// crossing is a single explicit match: milo cannot RETURN the `&ExprNode` inside the
// bridge, so there is no one-line unwrap helper to hide it behind.
from "src-milo/ast.milo" import {
    Expr, ExprNode, Param, MiloType, LiteralKind, Span,
    cloneOptType, cloneSpan, cloneParams, cloneStmts
}
from "src-milo/hir.milo" import {
    HStmt, HExpr, HExprNode, HMatchArm, HPattern, HBinding, HIterKind, HStrViewMode,
    hexprAbort
}
from "src-milo/checker/types.milo" import {
    TypeKind, containsUnknown
}
from "src-milo/codegen/types.milo" import {
    Cgen, Val, Local, CgFnSig, RangeAnno, noRange, rangeOfTyK, tyStr,
    nextTemp, nextLabel, emit, emitG, emitLabel, llType, stripPercent, resolveTyStr, ensureMalloc,
    findLocal, hasLocal, genLoad, isVecTy, unwrapVec, hmEntryTy,
    lookupFieldIndex, lookupFieldType, lookupFieldRange, lookupVariantTag, lookupVariantPayload,
    isInlineArrTy, inlineArrElem, addrWasMoved, ensureStringTy
}
from "src-milo/codegen/expr.milo" import {
    genExpr, genLvalue, genHExpr, variantStructTy,
    genOptionWrapIfNeeded, genInterfaceCoerceIfNeeded, genOwnedArg,
    constFoldBool, emitRangeCheck
}
from "src-milo/codegen/drops.milo" import {
    emitDropValue, cgNeedsDrop, zeroStore
}
from "src-milo/codegen/strings.milo" import {
    genStringAppendInPlace, genStringEq, genStringLit, emitStringLit, ensureStrFind
}

// -- Assignment --

// Two lvalue exprs denote the same storage location (used to detect self-assign
// and the `place = place + rhs` append pattern). Conservative: only Ident and
// FieldAccess chains; anything else (index, deref) returns false.
pub fn lvalueMatches(a: &ExprNode, b: &ExprNode): bool {
    match a.kind {
        Expr.Ident(an) => {
            match b.kind {
                Expr.Ident(bn) => {
                    return an == bn
                }
                _ => {
                    return false
                }
            }
        }
        Expr.FieldAccess(aobj, afield) => {
            match b.kind {
                Expr.FieldAccess(bobj, bfield) => {
                    if afield != bfield {
                        return false
                    }
                    return lvalueMatches(*aobj, *bobj)
                }
                _ => {
                    return false
                }
            }
        }
        _ => {
            return false
        }
    }
}

// Resolve an lvalue's declared type WITHOUT emitting IR (so the append-opt can
// gate on `string` before committing to the fast path).
pub fn lvalueTypeStr(cg: &mut Cgen, e: &ExprNode, locs: &Vec<Local>): string {
    match e.kind {
        Expr.Ident(name) => {
            // a module global isn't in `locs`; findLocal would hit its locs[0]
            // fallback (out-of-bounds when locs is empty, e.g. in a global-only fn)
            if !hasLocal(locs, name) && cg.globalVars.contains(name) {
                return cg.globalVars.get(name)!
            }
            return findLocal(locs, name).ty.clone()
        }
        Expr.FieldAccess(object, field) => {
            let ot = lvalueTypeStr(&mut cg, *object, locs)
            let rawName = stripPercent(ot)
            let idx = lookupFieldIndex(cg, rawName, field)
            return lookupFieldType(cg, rawName, idx)
        }
        _ => {
            return ""
        }
    }
}

pub fn genAssign(cg: &mut Cgen, target: &HExprNode, value: &HExprNode, locs: &mut Vec<Local>, sigs: &Vec<CgFnSig>) {
    match target.kind {
        HExpr.Unlowered(t) => {
            match value.kind {
                HExpr.Unlowered(v) => {
                    genAssignAst(&mut cg, *t, *v, &mut locs, sigs, target.span)
                }
                _ => {
                    hexprAbort(value, "assignment value")
                }
            }
        }
        _ => {
            hexprAbort(target, "assignment target")
        }
    }
}

fn genAssignAst(cg: &mut Cgen, target: &ExprNode, value: &ExprNode, locs: &mut Vec<Local>, sigs: &Vec<CgFnSig>, stmtSpan: &Option<Span>) {
    // Fast path: `place = place + rhs` for strings → amortized in-place append.
    // The naive store path re-concats (fresh alloc + leaked old buffer) every
    // time, making an accumulator like `cg.body = cg.body + s` O(n^2) in time
    // AND memory. Bail on `x = x + x` (overlapping copy — let the slow path own).
    match value.kind {
        Expr.BinOp(op, left, right) => {
            if op == "+" && lvalueMatches(target, *left) && !lvalueMatches(target, *right) {
                if llType(lvalueTypeStr(&mut cg, target, locs)) == "%String" {
                    let bv = genExpr(&mut cg, *right, locs, sigs, "%String")
                    let lv = genLvalue(&mut cg, target, locs, sigs)
                    genStringAppendInPlace(&mut cg, lv.v, bv.v)
                    return
                }
            }
        }
        _ => {
        }
    }
    match target.kind {
        Expr.Ident(name) => {
            // a module global (not shadowed by a local) stores through @name
            if !hasLocal(locs, name) && cg.globalVars.contains(name) {
                let gty = cg.globalVars.get(name)!
                // eval + move RHS, THEN drop the old value (order matters: the RHS
                // may read the slot), THEN overwrite. Zeroed-on-move slots drop to
                // no-ops, so a moved-out or reassigned global never double-frees.
                let v0 = genOwnedArg(&mut cg, value, gty.clone(), locs, sigs)
                let v = genOptionWrapIfNeeded(&mut cg, v0, gty)
                if cgNeedsDrop(cg, gty) && !lvalueMatches(target, value) {
                    emitDropValue(&mut cg, "@" + name.clone(), gty)
                }
                emit(&mut cg, "  store " + llType(v.ty) + " " + v.v + ", ptr @" + name.clone() + "\n")
            } else {
                let local = findLocal(locs, name)
                let lty = local.ty.clone()
                let v0 = genOwnedArg(&mut cg, value, lty.clone(), locs, sigs)
                let v = genOptionWrapIfNeeded(&mut cg, v0, lty)
                emitRangeCheck(&mut cg, v, local.range, stmtSpan)
                if !local.isRef && cgNeedsDrop(cg, lty) && !lvalueMatches(target, value) {
                    emitDropValue(&mut cg, local.addr, lty)
                }
                emit(&mut cg, "  store " + llType(v.ty) + " " + v.v + ", ptr " + local.addr + "\n")
            }
        }
        Expr.FieldAccess(object, field) => {
            let lv = genLvalue(&mut cg, *object, locs, sigs)
            // `p.x = …` through a raw pointer: load the pointer to reach the struct,
            // gep the pointee field; otherwise gep the struct lvalue directly.
            var structAddr = lv.v.clone()
            var rawName = stripPercent(lv.ty)
            if lv.ty.len > 0 && lv.ty[0] == 42 {
                let pointee = lv.ty[1..lv.ty.len].clone()
                rawName = stripPercent(resolveTyStr(cg, pointee))
                let sa = nextTemp(&mut cg)
                emit(&mut cg, "  " + sa + " = load ptr, ptr " + lv.v + "\n")
                structAddr = sa
            }
            let idx = lookupFieldIndex(cg, rawName, field)
            let fty = lookupFieldType(cg, rawName, idx)
            let structTy = "%" + rawName
            let fp = nextTemp(&mut cg)
            emit(&mut cg, "  " + fp + " = getelementptr " + structTy + ", ptr " + structAddr + ", i32 0, i32 " + idx.toString() + "\n")
            // field takes ownership of the RHS → move it (zero the source place).
            // The old field value is not dropped yet (slice 2) — a leak, not a UAF.
            // Hint with the SURFACE field type ("Vec<f64>"), not its LLVM spelling
            // ("%Vec", which throws the element type away): `c.dem = Vec.filled(n,
            // 0.0)` needs the real element type to reach genVecFilled's fill-value
            // hint, or it silently fell back to Vec<i64> and stored a float literal
            // into an i64 slot ("store i64 0.0" — invalid IR).
            let v = genOwnedArg(&mut cg, value, fty.clone(), locs, sigs)
            let frange = lookupFieldRange(cg, rawName, idx)
            emitRangeCheck(&mut cg, v, frange, stmtSpan)
            emit(&mut cg, "  store " + llType(v.ty) + " " + v.v + ", ptr " + fp + "\n")
        }
        // A capitalized *variable* followed by `.field = value` parses identically
        // to a static enum-literal (mirrors genLvalue's own EnumLit case and the
        // checker's isRootMutable fallback) — `STORE.name = "milo"` (single dot,
        // no further FieldAccess wrapper around it) landed here as a bare EnumLit
        // and this arm was MISSING entirely, so the assignment silently matched
        // the `_` no-op below and did nothing: the field never changed and no
        // diagnostic said why. Guarded the same way as genLvalue's EnumLit case —
        // a GENUINE enum literal is never a legal assignment target (isRootMutable
        // already rejects it), so this should only ever see the variable case in a
        // program that type-checked, but the guard keeps that an invariant rather
        // than a hope: without it, a real enum name resolves as a local via
        // findLocal's "should not happen" fallback (locs[0], something unrelated)
        // and writes through whatever garbage field index that finds.
        Expr.EnumLit(enumName, variant, args) => {
            let isVar = !cg.enums.contains(enumName) && (hasLocal(locs, enumName) || cg.globalVars.contains(enumName))
            if isVar {
                // Plain string vars, not a reassigned Val — see genLvalue's EnumLit
                // arm for why (milo-self's own borrow checker over-rejects the
                // struct-reassignment shape; separately owned, not fixed here).
                var lvV = "0"
                var lvTy = ""
                if !hasLocal(locs, enumName) && cg.globalVars.contains(enumName) {
                    let surf = cg.globalVars.get(enumName)!
                    lvV = "@" + enumName.clone()
                    lvTy = surf
                } else {
                    let local = findLocal(locs, enumName)
                    lvV = local.addr.clone()
                    lvTy = local.ty.clone()
                }
                var structAddr = lvV.clone()
                var rawName = stripPercent(lvTy)
                if lvTy.len > 0 && lvTy[0] == 42 {
                    let pointee = lvTy[1..lvTy.len].clone()
                    rawName = stripPercent(resolveTyStr(cg, pointee))
                    let sa = nextTemp(&mut cg)
                    emit(&mut cg, "  " + sa + " = load ptr, ptr " + lvV + "\n")
                    structAddr = sa
                }
                let idx = lookupFieldIndex(cg, rawName, variant)
                let fty = lookupFieldType(cg, rawName, idx)
                let structTy = "%" + rawName
                let fp = nextTemp(&mut cg)
                emit(&mut cg, "  " + fp + " = getelementptr " + structTy + ", ptr " + structAddr + ", i32 0, i32 " + idx.toString() + "\n")
                let v = genOwnedArg(&mut cg, value, fty.clone(), locs, sigs)
                emit(&mut cg, "  store " + llType(v.ty) + " " + v.v + ", ptr " + fp + "\n")
            }
        }
        Expr.IndexAccess(obj, idx) => {
            // M3e: v[i] = x for Vec receivers (fixed arrays still pending)
            let lv = genLvalue(&mut cg, *obj, locs, sigs)
            if isVecTy(lv.ty) {
                let elemTy = unwrapVec(lv.ty)
                let elemLl = llType(elemTy)
                let dPtr = nextTemp(&mut cg)
                emit(&mut cg, "  " + dPtr + " = getelementptr %Vec, ptr " + lv.v + ", i32 0, i32 0\n")
                let d = nextTemp(&mut cg)
                emit(&mut cg, "  " + d + " = load ptr, ptr " + dPtr + "\n")
                let iv = genExpr(&mut cg, *idx, locs, sigs, "i64")
                let i64v = widenToI64(&mut cg, iv)
                let slot = nextTemp(&mut cg)
                emit(&mut cg, "  " + slot + " = getelementptr " + elemLl + ", ptr " + d + ", i64 " + i64v + "\n")
                let v = genOwnedArg(&mut cg, value, elemTy, locs, sigs)
                emit(&mut cg, "  store " + llType(v.ty) + " " + v.v + ", ptr " + slot + "\n")
            } else if lv.ty.len > 0 && lv.ty[0] == 42 {
                // Raw pointer `*T` (unsafe): lv.v is the alloca holding the
                // pointer, so load the pointer value before indexing.
                let elemTy = lv.ty[1..lv.ty.len].clone()
                let elemLl = llType(elemTy)
                let base = nextTemp(&mut cg)
                emit(&mut cg, "  " + base + " = load ptr, ptr " + lv.v + "\n")
                let iv = genExpr(&mut cg, *idx, locs, sigs, "i64")
                let i64v = widenToI64(&mut cg, iv)
                let slot = nextTemp(&mut cg)
                emit(&mut cg, "  " + slot + " = getelementptr " + elemLl + ", ptr " + base + ", i64 " + i64v + "\n")
                let v = genExpr(&mut cg, value, locs, sigs, elemTy)
                emit(&mut cg, "  store " + llType(v.ty) + " " + v.v + ", ptr " + slot + "\n")
            } else if isInlineArrTy(lv.ty) {
                // Inline struct-field array: lv.v is already the field's
                // address (genLvalue GEP'd into the enclosing struct) — index
                // it directly, no %Vec data ptr to extract.
                let elemTy = inlineArrElem(lv.ty)
                let elemLl = llType(elemTy)
                let arrLl = llType(lv.ty)
                let iv = genExpr(&mut cg, *idx, locs, sigs, "i64")
                let i64v = widenToI64(&mut cg, iv)
                let slot = nextTemp(&mut cg)
                emit(&mut cg, "  " + slot + " = getelementptr " + arrLl + ", ptr " + lv.v + ", i32 0, i64 " + i64v + "\n")
                let v = genOwnedArg(&mut cg, value, elemTy, locs, sigs)
                emit(&mut cg, "  store " + llType(v.ty) + " " + v.v + ", ptr " + slot + "\n")
            } else {
                eprint("codegen: cannot index-assign type " + lv.ty.clone())
                exit(1)
            }
        }
        // `*p = v` through a raw `*T` or a Heap<T> box. genLvalue already knows
        // this shape (it serves `(*p).field` and `&a[i]`), but genAssign had no
        // arm for it, so every deref store matched the `_` below and emitted
        // NOTHING — std/ws built an entire frame header that never reached the
        // buffer, and the reader blocked forever on bytes the writer never sent.
        Expr.UnaryOp(op, operand) => {
            if op != "*" {
                eprint("codegen: cannot assign through unary '" + op.clone() + "'")
                exit(1)
            }
            let lv = genLvalue(&mut cg, target, locs, sigs)
            let v = genOwnedArg(&mut cg, value, lv.ty.clone(), locs, sigs)
            emit(&mut cg, "  store " + llType(v.ty) + " " + v.v + ", ptr " + lv.v + "\n")
        }
        // Fail loudly. A place the checker accepted but codegen cannot lower is a
        // missing arm, not a no-op — silently dropping the store is the worst
        // possible outcome (see the UnaryOp arm above, which was exactly that).
        _ => {
            eprint("codegen: unsupported assignment target")
            exit(1)
        }
    }
}

// -- While loop --

pub fn genWhile(cg: &mut Cgen, cond: &HExprNode, body: &Vec<Heap<HStmt>>, locs: &mut Vec<Local>, sigs: &Vec<CgFnSig>, retTy: &string) {
    let condLbl = nextLabel(&mut cg, "wcond")
    let bodyLbl = nextLabel(&mut cg, "wbody")
    let endLbl = nextLabel(&mut cg, "wend")
    let savedBreak = cg.curBreakLbl.clone()
    let savedCont = cg.curContLbl.clone()
    let savedLoopScopeLen = cg.curLoopScopeLen
    cg.curBreakLbl = endLbl.clone()
    cg.curContLbl = condLbl.clone()
    emit(&mut cg, "  br label %" + condLbl + "\n")
    emit(&mut cg, condLbl + ":\n")
    let cv = genHExpr(&mut cg, cond, locs, sigs, "bool")
    emit(&mut cg, "  br i1 " + cv.v + ", label %" + bodyLbl + ", label %" + endLbl + "\n")
    emit(&mut cg, bodyLbl + ":\n")
    var bodyTerm = false
    // Same block scope as an if-branch, and doubly important in a loop: without it a
    // value declared in the body accumulates one un-dropped alloca per iteration.
    let bodyPreLen = locs.len
    cg.curLoopScopeLen = bodyPreLen
    for bi in 0..body.len {
        if genStmt(&mut cg, *body[bi], &mut locs, sigs, retTy) {
            bodyTerm = true
        }
    }
    if !bodyTerm {
        emitScopeDrops(&mut cg, locs, bodyPreLen, "")
    }
    while locs.len > bodyPreLen {
        let _ = locs.pop()
    }
    if !bodyTerm {
        emit(&mut cg, "  br label %" + condLbl + "\n")
    }
    emit(&mut cg, endLbl + ":\n")
    cg.curBreakLbl = savedBreak
    cg.curContLbl = savedCont
    cg.curLoopScopeLen = savedLoopScopeLen
}

// -- For-in loops (M3a): range, Vec, string bytes --

// Widen an integer Val to i64 so range bounds of any width share one compare.
pub fn widenToI64(cg: &mut Cgen, v: &Val): string {
    let ll = llType(v.ty)
    if ll == "i64" {
        return v.v.clone()
    }
    let w = nextTemp(&mut cg)
    emit(&mut cg, "  " + w + " = sext " + ll + " " + v.v + " to i64\n")
    return w
}

// A for-in binding is a VIEW: the slot holds a shallow copy of an element whose
// buffer the container still owns (for-in binds by reference — see the language
// reference). Recording the slot as already-moved is what keeps scope teardown
// from freeing the container's element out from under it; without it a `return`
// inside `for part in parts` dropped both `part` and `parts`.
fn markLoopBindingView(cg: &mut Cgen, addr: &string) {
    cg.movedLocalAddrs.push(addr.clone())
}

// Loop labels and the break/continue state one for-in shape saves for its enclosing loop.
struct ForLbls {
    cond: string,
    body: string,
    step: string,
    end: string,
    savedBreak: string,
    savedCont: string,
    savedScopeLen: i64,
}

fn enterForLoop(cg: &mut Cgen): ForLbls {
    let l = ForLbls {
        cond: nextLabel(&mut cg, "fcond"),
        body: nextLabel(&mut cg, "fbody"),
        step: nextLabel(&mut cg, "fstep"),
        end: nextLabel(&mut cg, "fend"),
        savedBreak: cg.curBreakLbl.clone(),
        savedCont: cg.curContLbl.clone(),
        savedScopeLen: cg.curLoopScopeLen,
    }
    // for-in doesn't scope-drop its body at all yet (a separate, pre-existing gap — the
    // loop-bound var is a borrow/copy, but a body-declared droppable local still leaks
    // here every iteration). -1 keeps break/continue from guessing at a scope length this
    // loop kind doesn't track, rather than reusing a stale value from an enclosing while
    // and dropping the wrong locals on a nested break.
    cg.curLoopScopeLen = -1
    cg.curBreakLbl = l.end.clone()
    // continue must run the increment, unlike while where it re-tests directly
    cg.curContLbl = l.step.clone()
    return l
}

fn exitForLoop(cg: &mut Cgen, l: &ForLbls) {
    cg.curBreakLbl = l.savedBreak.clone()
    cg.curContLbl = l.savedCont.clone()
    cg.curLoopScopeLen = l.savedScopeLen
}

// Emit one loop body, pop whatever it bound, and fall through to the step block unless
// every path out of it already terminated.
fn genLoopBody(cg: &mut Cgen, body: &Vec<Heap<HStmt>>, locs: &mut Vec<Local>, sigs: &Vec<CgFnSig>, retTy: &string, locsPreLen: i64, stepLbl: &string) {
    var term = false
    for bi in 0..body.len {
        if genStmt(&mut cg, *body[bi], &mut locs, sigs, retTy) {
            term = true
        }
    }
    while locs.len > locsPreLen {
        let _ = locs.pop()
    }
    if !term {
        emit(&mut cg, "  br label %" + stepLbl.clone() + "\n")
    }
}

// The step block of an index-counted loop: ++idx, then re-test.
fn emitIndexStep(cg: &mut Cgen, idxAddr: &string, stepLbl: &string, condLbl: &string) {
    emitLabel(&mut cg, stepLbl)
    let cur = nextTemp(&mut cg)
    emit(&mut cg, "  " + cur + " = load i64, ptr " + idxAddr.clone() + "\n")
    let inc = nextTemp(&mut cg)
    emit(&mut cg, "  " + inc + " = add i64 " + cur + ", 1\n")
    emit(&mut cg, "  store i64 " + inc + ", ptr " + idxAddr.clone() + "\n")
    emit(&mut cg, "  br label %" + condLbl.clone() + "\n")
}

// `for i in a..b`
pub fn genForRange(cg: &mut Cgen, varName: &string, startE: &HExprNode, endE: &HExprNode, body: &Vec<Heap<HStmt>>, locs: &mut Vec<Local>, sigs: &Vec<CgFnSig>, retTy: &string) {
    let l = enterForLoop(&mut cg)
    let idxAddr = nextTemp(&mut cg)
    emit(&mut cg, "  " + idxAddr + " = alloca i64\n")
    let sv = genHExpr(&mut cg, startE, locs, sigs, "i64")
    let ev = genHExpr(&mut cg, endE, locs, sigs, "i64")
    let s64 = widenToI64(&mut cg, sv)
    let e64 = widenToI64(&mut cg, ev)
    emit(&mut cg, "  store i64 " + s64 + ", ptr " + idxAddr + "\n")
    emit(&mut cg, "  br label %" + l.cond + "\n")
    emitLabel(&mut cg, l.cond)
    let cur = nextTemp(&mut cg)
    emit(&mut cg, "  " + cur + " = load i64, ptr " + idxAddr + "\n")
    let lt = nextTemp(&mut cg)
    emit(&mut cg, "  " + lt + " = icmp slt i64 " + cur + ", " + e64 + "\n")
    emit(&mut cg, "  br i1 " + lt + ", label %" + l.body + ", label %" + l.end + "\n")
    emitLabel(&mut cg, l.body)
    let locsPreLen = locs.len
    // The counter's own slot IS the binding, so it is i64 whatever width the checker gave
    // the loop variable — the bound compare and the increment are both i64.
    locs.push(Local {
        name: varName.clone(), ty: "i64", addr: idxAddr.clone(), isRef: false, isArr: false, range: noRange()
    })
    markLoopBindingView(&mut cg, idxAddr)
    genLoopBody(&mut cg, body, &mut locs, sigs, retTy, locsPreLen, l.step)
    emitIndexStep(&mut cg, idxAddr, l.step, l.cond)
    emitLabel(&mut cg, l.end)
    exitForLoop(&mut cg, l)
}

// `for x in <container>` / `for i, x in <container>`. Which container is NOT re-derived
// here — lowering carries the shape the checker picked, along with the binding types it
// declared. An `@iter` newtype has already been redirected to its delegate field, so
// nothing below knows a wrapper struct was ever involved.
pub fn genForEach(cg: &mut Cgen, varName: &string, varName2: &Option<string>, iterable: &HExprNode, kind: &HIterKind, body: &Vec<Heap<HStmt>>, locs: &mut Vec<Local>, sigs: &Vec<CgFnSig>, retTy: &string) {
    let l = enterForLoop(&mut cg)
    let idxAddr = nextTemp(&mut cg)
    emit(&mut cg, "  " + idxAddr + " = alloca i64\n")
    let obj = genHExpr(&mut cg, iterable, locs, sigs, "")
    match kind {
        HIterKind.IterHashMap => {
            genForInHashMap(&mut cg, varName, varName2, obj, body, &mut locs, sigs, retTy, l, idxAddr)
        }
        _ => {
            genForInIndexed(&mut cg, varName, varName2, obj, kind, body, &mut locs, sigs, retTy, l, idxAddr)
        }
    }
    emitIndexStep(&mut cg, idxAddr, l.step, l.cond)
    emitLabel(&mut cg, l.end)
    exitForLoop(&mut cg, l)
}

// `for key, value in map`: walk the flat entry array; body sees copies bound through
// hoisted allocas.
fn genForInHashMap(cg: &mut Cgen, varName: &string, varName2: &Option<string>, obj: &Val, body: &Vec<Heap<HStmt>>, locs: &mut Vec<Local>, sigs: &Vec<CgFnSig>, retTy: &string, l: &ForLbls, idxAddr: &string) {
    // Key and value types come off the MAP's own type, not the binding types the checker
    // declared: they size the entry slot this loop strides over, so they have to describe
    // the memory that is actually there. The checker and the backend do not always agree
    // on a container's element width (an inferred closure return can widen one), and where
    // they differ it is the container that is right about its own layout.
    let keyTy = hashMapKeyTy(obj.ty)
    let valTy = hashMapValTy(obj.ty)
    let entryTy = hmEntryTy(keyTy, valTy)
    let keyLl = llType(keyTy)
    let valLl = llType(valTy)
    let data = nextTemp(&mut cg)
    emit(&mut cg, "  " + data + " = extractvalue %HashMap " + obj.v + ", 0\n")
    let count = nextTemp(&mut cg)
    emit(&mut cg, "  " + count + " = extractvalue %HashMap " + obj.v + ", 1\n")
    let keyAddr = nextTemp(&mut cg)
    emit(&mut cg, "  " + keyAddr + " = alloca " + keyLl + "\n")
    let valAddr = nextTemp(&mut cg)
    emit(&mut cg, "  " + valAddr + " = alloca " + valLl + "\n")
    emit(&mut cg, "  store i64 0, ptr " + idxAddr.clone() + "\n")
    emit(&mut cg, "  br label %" + l.cond.clone() + "\n")
    emitLabel(&mut cg, l.cond)
    let cur = nextTemp(&mut cg)
    emit(&mut cg, "  " + cur + " = load i64, ptr " + idxAddr.clone() + "\n")
    let lt = nextTemp(&mut cg)
    emit(&mut cg, "  " + lt + " = icmp slt i64 " + cur + ", " + count + "\n")
    emit(&mut cg, "  br i1 " + lt + ", label %" + l.body.clone() + ", label %" + l.end.clone() + "\n")
    emitLabel(&mut cg, l.body)
    let slot = nextTemp(&mut cg)
    emit(&mut cg, "  " + slot + " = getelementptr " + entryTy + ", ptr " + data + ", i64 " + cur + "\n")
    let kp = nextTemp(&mut cg)
    emit(&mut cg, "  " + kp + " = getelementptr " + entryTy + ", ptr " + slot + ", i32 0, i32 0\n")
    let k = nextTemp(&mut cg)
    emit(&mut cg, "  " + k + " = load " + keyLl + ", ptr " + kp + "\n")
    emit(&mut cg, "  store " + keyLl + " " + k + ", ptr " + keyAddr + "\n")
    let vp = nextTemp(&mut cg)
    emit(&mut cg, "  " + vp + " = getelementptr " + entryTy + ", ptr " + slot + ", i32 0, i32 1\n")
    let v = nextTemp(&mut cg)
    emit(&mut cg, "  " + v + " = load " + valLl + ", ptr " + vp + "\n")
    emit(&mut cg, "  store " + valLl + " " + v + ", ptr " + valAddr + "\n")
    let locsPreLen = locs.len
    locs.push(Local {
        name: varName.clone(), ty: keyTy.clone(), addr: keyAddr.clone(), isRef: false, isArr: false, range: noRange()
    })
    markLoopBindingView(&mut cg, keyAddr)
    match varName2 {
        Option.Some(valName) => {
            locs.push(Local {
                name: valName.clone(), ty: valTy.clone(), addr: valAddr.clone(), isRef: false, isArr: false, range: noRange()
            })
            markLoopBindingView(&mut cg, valAddr)
        }
        Option.None => {
        }
    }
    genLoopBody(&mut cg, body, &mut locs, sigs, retTy, locsPreLen, l.step)
}

// Vec, fixed array, or string bytes: copy the 3-word header and walk by index.
fn genForInIndexed(cg: &mut Cgen, varName: &string, varName2: &Option<string>, obj: &Val, kind: &HIterKind, body: &Vec<Heap<HStmt>>, locs: &mut Vec<Local>, sigs: &Vec<CgFnSig>, retTy: &string, l: &ForLbls, idxAddr: &string) {
    // Element type off the CONTAINER, for the same reason genForInHashMap reads the map's:
    // it is the stride of the buffer being walked. resolveTyStr collapses Heap<Interface>
    // to Interface, so the element is the %Iface fat pointer, not a plain ptr.
    var elemTy = "u8"
    var container = "%String"
    match kind {
        HIterKind.IterString => {
        }
        _ => {
            elemTy = unwrapVec(resolveTyStr(cg, obj.ty))
            container = "%Vec"
        }
    }
    let elemLl = llType(elemTy)
    let data = nextTemp(&mut cg)
    emit(&mut cg, "  " + data + " = extractvalue " + container + " " + obj.v + ", 0\n")
    let count = nextTemp(&mut cg)
    emit(&mut cg, "  " + count + " = extractvalue " + container + " " + obj.v + ", 1\n")
    // element slot, hoisted out of the loop so the body can rebind it
    let elemAddr = nextTemp(&mut cg)
    emit(&mut cg, "  " + elemAddr + " = alloca " + elemLl + "\n")
    emit(&mut cg, "  store i64 0, ptr " + idxAddr.clone() + "\n")
    emit(&mut cg, "  br label %" + l.cond.clone() + "\n")
    emitLabel(&mut cg, l.cond)
    let cur = nextTemp(&mut cg)
    emit(&mut cg, "  " + cur + " = load i64, ptr " + idxAddr.clone() + "\n")
    let lt = nextTemp(&mut cg)
    emit(&mut cg, "  " + lt + " = icmp slt i64 " + cur + ", " + count + "\n")
    emit(&mut cg, "  br i1 " + lt + ", label %" + l.body.clone() + ", label %" + l.end.clone() + "\n")
    emitLabel(&mut cg, l.body)
    let slot = nextTemp(&mut cg)
    emit(&mut cg, "  " + slot + " = getelementptr " + elemLl + ", ptr " + data + ", i64 " + cur + "\n")
    let elem = nextTemp(&mut cg)
    emit(&mut cg, "  " + elem + " = load " + elemLl + ", ptr " + slot + "\n")
    emit(&mut cg, "  store " + elemLl + " " + elem + ", ptr " + elemAddr + "\n")
    let locsPreLen = locs.len
    // two-var form is `for index, value in vec` (index first), matching the checker's
    // binding order; single-var binds the element.
    match varName2 {
        Option.Some(valName) => {
            locs.push(Local {
                name: varName.clone(), ty: "i64", addr: idxAddr.clone(), isRef: false, isArr: false, range: noRange()
            })
            markLoopBindingView(&mut cg, idxAddr)
            locs.push(Local {
                name: valName.clone(), ty: elemTy.clone(), addr: elemAddr.clone(), isRef: false, isArr: false, range: noRange()
            })
            markLoopBindingView(&mut cg, elemAddr)
        }
        Option.None => {
            locs.push(Local {
                name: varName.clone(), ty: elemTy.clone(), addr: elemAddr.clone(), isRef: false, isArr: false, range: noRange()
            })
            markLoopBindingView(&mut cg, elemAddr)
        }
    }
    genLoopBody(&mut cg, body, &mut locs, sigs, retTy, locsPreLen, l.step)
}

// `for x in <iterator>` and `for x in <channel>`. One loop for both: a channel's recv()
// reports "kept going" as Result.Ok and an iterator's next() as Option.Some, and that
// variant name — recorded by the checker, not sniffed off a type string here — is the
// only difference between them.
pub fn genForIterator(cg: &mut Cgen, varName: &string, iterable: &HExprNode, nextMethod: &string, resultEnum: &string, okVariant: &string, body: &Vec<Heap<HStmt>>, locs: &mut Vec<Local>, sigs: &Vec<CgFnSig>, retTy: &string) {
    let l = enterForLoop(&mut cg)
    let obj = genHExpr(&mut cg, iterable, locs, sigs, "")
    let objLl = llType(obj.ty)
    let resTy = stripPercent(resolveTyStr(cg, resultEnum.clone()))
    let resLl = "%" + resTy.clone()
    let okTag = lookupVariantTag(cg, resTy, okVariant)
    // The payload slot of the variant being unpacked, not the binding type the checker
    // declared: this is the width of the load, and it has to match the enum as laid out.
    let payTypes = lookupVariantPayload(cg, resTy, okVariant)
    let elemTy = payTypes[0].clone()
    let elemLl = llType(elemTy)
    let itSlot = nextTemp(&mut cg)
    emit(&mut cg, "  " + itSlot + " = alloca " + objLl + "\n")
    emit(&mut cg, "  store " + objLl + " " + obj.v + ", ptr " + itSlot + "\n")
    let valAddr = nextTemp(&mut cg)
    emit(&mut cg, "  " + valAddr + " = alloca " + elemLl + "\n")
    emit(&mut cg, "  br label %" + l.cond + "\n")
    emitLabel(&mut cg, l.cond)
    let r = nextTemp(&mut cg)
    emit(&mut cg, "  " + r + " = call " + resLl + " @" + nextMethod.clone() + "(ptr " + itSlot + ")\n")
    let rslot = nextTemp(&mut cg)
    emit(&mut cg, "  " + rslot + " = alloca " + resLl + "\n")
    emit(&mut cg, "  store " + resLl + " " + r + ", ptr " + rslot + "\n")
    let tagP = nextTemp(&mut cg)
    emit(&mut cg, "  " + tagP + " = getelementptr " + resLl + ", ptr " + rslot + ", i32 0, i32 0\n")
    let tag = nextTemp(&mut cg)
    emit(&mut cg, "  " + tag + " = load i32, ptr " + tagP + "\n")
    let isOk = nextTemp(&mut cg)
    emit(&mut cg, "  " + isOk + " = icmp eq i32 " + tag + ", " + okTag.toString() + "\n")
    emit(&mut cg, "  br i1 " + isOk + ", label %" + l.body + ", label %" + l.end + "\n")
    emitLabel(&mut cg, l.body)
    let payP = nextTemp(&mut cg)
    emit(&mut cg, "  " + payP + " = getelementptr " + resLl + ", ptr " + rslot + ", i32 0, i32 1\n")
    let fp = nextTemp(&mut cg)
    emit(&mut cg, "  " + fp + " = getelementptr { " + elemLl + " }, ptr " + payP + ", i32 0, i32 0\n")
    let pv = nextTemp(&mut cg)
    emit(&mut cg, "  " + pv + " = load " + elemLl + ", ptr " + fp + "\n")
    emit(&mut cg, "  store " + elemLl + " " + pv + ", ptr " + valAddr + "\n")
    let locsPreLen = locs.len
    locs.push(Local {
        name: varName.clone(), ty: elemTy.clone(), addr: valAddr.clone(), isRef: false, isArr: false, range: noRange()
    })
    markLoopBindingView(&mut cg, valAddr)
    genLoopBody(&mut cg, body, &mut locs, sigs, retTy, locsPreLen, l.step)
    emitLabel(&mut cg, l.step)
    emit(&mut cg, "  br label %" + l.cond + "\n")
    emitLabel(&mut cg, l.end)
    exitForLoop(&mut cg, l)
}

// `for line in text.lines()` / `for f in text.splitView(sep)`. Each iteration stores
// a non-owning %String (cap 0, so drop glue skips it) pointing straight into the
// receiver's own buffer — the checker has frozen it for the whole loop (checked in
// checker/stmt.milo checkStringViewForIn, though this codegen doesn't itself enforce
// that; there is no freeze/unfreeze mechanism in this checker yet, so a program that
// mutates the receiver mid-loop is not rejected the way the TS oracle rejects it).
// A full self-contained loop, like the iterator drain above, because its step is "jump
// to the next found separator", not a plain index +1.
pub fn genForStrView(cg: &mut Cgen, varName: &string, varName2: &Option<string>, src: &HExprNode, sep: &Option<Heap<HExprNode>>, mode: &HStrViewMode, body: &Vec<Heap<HStmt>>, locs: &mut Vec<Local>, sigs: &Vec<CgFnSig>, retTy: &string) {
    ensureStringTy(&mut cg)
    let l = enterForLoop(&mut cg)
    var isSplit = false
    match mode {
        HStrViewMode.ViewSplit => {
            isSplit = true
        }
        HStrViewMode.ViewLines => {
        }
    }

    let srcVal = genHExpr(&mut cg, src, locs, sigs, "")
    let dataP = nextTemp(&mut cg)
    emit(&mut cg, "  " + dataP + " = extractvalue %String " + srcVal.v + ", 0\n")
    let lenV = nextTemp(&mut cg)
    emit(&mut cg, "  " + lenV + " = extractvalue %String " + srcVal.v + ", 1\n")

    // the separator: an explicit argument for splitView, a literal newline for lines
    var sepPtr = ""
    var sepLen = "1"
    match sep {
        Option.Some(sepExpr) => {
            let sepVal = genHExpr(&mut cg, *sepExpr, locs, sigs, "")
            let sp = nextTemp(&mut cg)
            emit(&mut cg, "  " + sp + " = extractvalue %String " + sepVal.v + ", 0\n")
            sepPtr = sp
            let sl = nextTemp(&mut cg)
            emit(&mut cg, "  " + sl + " = extractvalue %String " + sepVal.v + ", 1\n")
            sepLen = sl
        }
        Option.None => {
            let nlLabel = emitStringLit(&mut cg, "\n")
            let sp = nextTemp(&mut cg)
            emit(&mut cg, "  " + sp + " = getelementptr [2 x i8], ptr " + nlLabel + ", i32 0, i32 0\n")
            sepPtr = sp
            sepLen = "1"
        }
    }
    ensureStrFind(&mut cg)

    let posAddr = nextTemp(&mut cg)
    emit(&mut cg, "  " + posAddr + " = alloca i64\n")
    emit(&mut cg, "  store i64 0, ptr " + posAddr + "\n")
    let nextAddr = nextTemp(&mut cg)
    emit(&mut cg, "  " + nextAddr + " = alloca i64\n")
    let viewAddr = nextTemp(&mut cg)
    emit(&mut cg, "  " + viewAddr + " = alloca %String\n")

    // enumerate form: `for i, line in text.lines()` binds the piece to the second name
    var idxAddr = ""
    match varName2 {
        Option.Some(viewName) => {
            let ia = nextTemp(&mut cg)
            emit(&mut cg, "  " + ia + " = alloca i64\n")
            emit(&mut cg, "  store i64 0, ptr " + ia + "\n")
            idxAddr = ia
        }
        Option.None => {
        }
    }

    emit(&mut cg, "  br label %" + l.cond + "\n")
    emitLabel(&mut cg, l.cond)
    let pos = nextTemp(&mut cg)
    emit(&mut cg, "  " + pos + " = load i64, ptr " + posAddr + "\n")
    var more = ""
    if !isSplit {
        // a trailing newline ends the last line, it does not start an empty one
        let m = nextTemp(&mut cg)
        emit(&mut cg, "  " + m + " = icmp slt i64 " + pos + ", " + lenV + "\n")
        more = m
    } else {
        // `pos == len` still yields the piece after a trailing separator ("a," -> "a", "")
        let inRange = nextTemp(&mut cg)
        emit(&mut cg, "  " + inRange + " = icmp sle i64 " + pos + ", " + lenV + "\n")
        // an empty separator splits into single bytes, which run out one step earlier
        let sepEmpty = nextTemp(&mut cg)
        emit(&mut cg, "  " + sepEmpty + " = icmp eq i64 " + sepLen + ", 0\n")
        let emptyDone = nextTemp(&mut cg)
        emit(&mut cg, "  " + emptyDone + " = icmp sge i64 " + pos + ", " + lenV + "\n")
        let notEmptyDone = nextTemp(&mut cg)
        emit(&mut cg, "  " + notEmptyDone + " = xor i1 " + emptyDone + ", true\n")
        let okEmpty = nextTemp(&mut cg)
        emit(&mut cg, "  " + okEmpty + " = select i1 " + sepEmpty + ", i1 " + notEmptyDone + ", i1 true\n")
        let m = nextTemp(&mut cg)
        emit(&mut cg, "  " + m + " = and i1 " + inRange + ", " + okEmpty + "\n")
        more = m
    }
    emit(&mut cg, "  br i1 " + more + ", label %" + l.body + ", label %" + l.end + "\n")

    emitLabel(&mut cg, l.body)
    let found = nextTemp(&mut cg)
    emit(&mut cg, "  " + found + " = call i64 @milo.strfind(ptr " + dataP + ", i64 " + lenV + ", ptr " + sepPtr + ", i64 " + sepLen + ", i64 " + pos + ")\n")
    var sepIdx = found.clone()
    if isSplit {
        // an empty needle matches at `pos` and would never advance; treat the next byte
        // boundary as the separator instead, which is what strSplit("") yields
        let sepEmpty2 = nextTemp(&mut cg)
        emit(&mut cg, "  " + sepEmpty2 + " = icmp eq i64 " + sepLen + ", 0\n")
        let posPlus1 = nextTemp(&mut cg)
        emit(&mut cg, "  " + posPlus1 + " = add i64 " + pos + ", 1\n")
        let chosen = nextTemp(&mut cg)
        emit(&mut cg, "  " + chosen + " = select i1 " + sepEmpty2 + ", i64 " + posPlus1 + ", i64 " + found + "\n")
        sepIdx = chosen
    }
    let hasSep = nextTemp(&mut cg)
    emit(&mut cg, "  " + hasSep + " = icmp sge i64 " + sepIdx + ", 0\n")
    let pieceEnd = nextTemp(&mut cg)
    emit(&mut cg, "  " + pieceEnd + " = select i1 " + hasSep + ", i64 " + sepIdx + ", i64 " + lenV + "\n")

    var viewEnd = pieceEnd.clone()
    if !isSplit {
        // CRLF: the '\r' belongs to the line ending, not to the line
        let nonEmpty = nextTemp(&mut cg)
        emit(&mut cg, "  " + nonEmpty + " = icmp sgt i64 " + pieceEnd + ", " + pos + "\n")
        let prevIdx = nextTemp(&mut cg)
        emit(&mut cg, "  " + prevIdx + " = sub i64 " + pieceEnd + ", 1\n")
        // clamped so the load stays inside the buffer when the line is empty
        let probeIdx = nextTemp(&mut cg)
        emit(&mut cg, "  " + probeIdx + " = select i1 " + nonEmpty + ", i64 " + prevIdx + ", i64 " + pos + "\n")
        let probePtr = nextTemp(&mut cg)
        emit(&mut cg, "  " + probePtr + " = getelementptr i8, ptr " + dataP + ", i64 " + probeIdx + "\n")
        let probe = nextTemp(&mut cg)
        emit(&mut cg, "  " + probe + " = load i8, ptr " + probePtr + "\n")
        let isCR = nextTemp(&mut cg)
        emit(&mut cg, "  " + isCR + " = icmp eq i8 " + probe + ", 13\n")
        let strip = nextTemp(&mut cg)
        emit(&mut cg, "  " + strip + " = and i1 " + nonEmpty + ", " + isCR + "\n")
        let stripped = nextTemp(&mut cg)
        emit(&mut cg, "  " + stripped + " = select i1 " + strip + ", i64 " + prevIdx + ", i64 " + pieceEnd + "\n")
        viewEnd = stripped
    }

    // A real zero-copy view (bare pointer into `data`, no NUL at its own end) would
    // match the TS oracle exactly, but this codegen's `print` always emits a plain
    // libc "%s" for a %String argument (codegen/expr.milo genCall) — printf then
    // reads past the view's end to the SOURCE buffer's own terminator, printing every
    // remaining line instead of just this piece. Until print is made length-aware,
    // each piece has to be its own NUL-terminated copy, same as genStringSlice.
    // cap=0 (not sz): nothing takes ownership of a for-in loop var beyond the body,
    // and for-in doesn't scope-drop its locals yet (a separate, pre-existing gap —
    // see enterForLoop) — so this leaks per iteration either way. cap=0 at least keeps
    // it from ever being double-freed if that gap is closed later.
    ensureMalloc(&mut cg)
    ensureMemcpy(&mut cg)
    let viewLen = nextTemp(&mut cg)
    emit(&mut cg, "  " + viewLen + " = sub i64 " + viewEnd + ", " + pos + "\n")
    let sz = nextTemp(&mut cg)
    emit(&mut cg, "  " + sz + " = add i64 " + viewLen + ", 1\n")
    let buf = nextTemp(&mut cg)
    emit(&mut cg, "  " + buf + " = call ptr @malloc(i64 " + sz + ")\n")
    let srcP = nextTemp(&mut cg)
    emit(&mut cg, "  " + srcP + " = getelementptr i8, ptr " + dataP + ", i64 " + pos + "\n")
    emit(&mut cg, "  call ptr @memcpy(ptr " + buf + ", ptr " + srcP + ", i64 " + viewLen + ")\n")
    let np = nextTemp(&mut cg)
    emit(&mut cg, "  " + np + " = getelementptr i8, ptr " + buf + ", i64 " + viewLen + "\n")
    emit(&mut cg, "  store i8 0, ptr " + np + "\n")
    let v0 = nextTemp(&mut cg)
    emit(&mut cg, "  " + v0 + " = insertvalue %String undef, ptr " + buf + ", 0\n")
    let v1 = nextTemp(&mut cg)
    emit(&mut cg, "  " + v1 + " = insertvalue %String " + v0 + ", i64 " + viewLen + ", 1\n")
    let v2 = nextTemp(&mut cg)
    emit(&mut cg, "  " + v2 + " = insertvalue %String " + v1 + ", i64 0, 2\n")
    emit(&mut cg, "  store %String " + v2 + ", ptr " + viewAddr + "\n")

    // Computed here, where the search result is live, and read back in the increment
    // block — which `continue` can also reach, from blocks that do not see these values.
    let afterSep = nextTemp(&mut cg)
    emit(&mut cg, "  " + afterSep + " = add i64 " + pieceEnd + ", " + sepLen + "\n")
    let past = nextTemp(&mut cg)
    emit(&mut cg, "  " + past + " = add i64 " + lenV + ", 1\n")
    let nextPos = nextTemp(&mut cg)
    emit(&mut cg, "  " + nextPos + " = select i1 " + hasSep + ", i64 " + afterSep + ", i64 " + past + "\n")
    emit(&mut cg, "  store i64 " + nextPos + ", ptr " + nextAddr + "\n")

    let locsPreLen = locs.len
    match varName2 {
        Option.Some(viewName) => {
            locs.push(Local {
                name: varName.clone(), ty: "i64", addr: idxAddr.clone(), isRef: false, isArr: false, range: noRange()
            })
            markLoopBindingView(&mut cg, idxAddr)
            locs.push(Local {
                name: viewName.clone(), ty: "string", addr: viewAddr.clone(), isRef: false, isArr: false, range: noRange()
            })
            markLoopBindingView(&mut cg, viewAddr)
        }
        Option.None => {
            locs.push(Local {
                name: varName.clone(), ty: "string", addr: viewAddr.clone(), isRef: false, isArr: false, range: noRange()
            })
            markLoopBindingView(&mut cg, viewAddr)
        }
    }

    genLoopBody(&mut cg, body, &mut locs, sigs, retTy, locsPreLen, l.step)

    emitLabel(&mut cg, l.step)
    let advanced = nextTemp(&mut cg)
    emit(&mut cg, "  " + advanced + " = load i64, ptr " + nextAddr + "\n")
    emit(&mut cg, "  store i64 " + advanced + ", ptr " + posAddr + "\n")
    if idxAddr != "" {
        let curIdx = nextTemp(&mut cg)
        emit(&mut cg, "  " + curIdx + " = load i64, ptr " + idxAddr + "\n")
        let nextIdx = nextTemp(&mut cg)
        emit(&mut cg, "  " + nextIdx + " = add i64 " + curIdx + ", 1\n")
        emit(&mut cg, "  store i64 " + nextIdx + ", ptr " + idxAddr + "\n")
    }
    emit(&mut cg, "  br label %" + l.cond + "\n")

    emitLabel(&mut cg, l.end)
    exitForLoop(&mut cg, l)
}

// -- If statement --

pub fn genIf(cg: &mut Cgen, cond: &HExprNode, thenBody: &Vec<Heap<HStmt>>, elseBody: &Option<Vec<Heap<HStmt>>>, locs: &mut Vec<Local>, sigs: &Vec<CgFnSig>, retTy: &string): bool {
    // A statically-known condition (`@targetOs() == "…"`) emits ONLY the taken
    // arm. Required, not an optimization: the dead arm may call a symbol
    // that exists on no other target, and it must never reach the linker even
    // though it type-checked. The fold reads the SYNTAX, so it needs the AST node
    // rather than the value the condition evaluates to.
    var folded: Option<bool> = Option.None
    match cond.kind {
        HExpr.Unlowered(c) => {
            folded = constFoldBool(cg, *c)
        }
        _ => {
            hexprAbort(cond, "if condition")
        }
    }
    match folded {
        Option.Some(taken) => {
            var foldTerm = false
            let foldPreLen = locs.len
            if taken {
                for ti in 0..thenBody.len {
                    if genStmt(&mut cg, *thenBody[ti], &mut locs, sigs, retTy) {
                        foldTerm = true
                    }
                }
            } else {
                match elseBody {
                    Option.Some(stmts) => {
                        for ei in 0..stmts.len {
                            if genStmt(&mut cg, *stmts[ei], &mut locs, sigs, retTy) {
                                foldTerm = true
                            }
                        }
                    }
                    Option.None => {
                    }
                }
            }
            if !foldTerm {
                emitScopeDrops(&mut cg, locs, foldPreLen, "")
            }
            while locs.len > foldPreLen {
                let _ = locs.pop()
            }
            return foldTerm
        }
        Option.None => {
        }
    }
    let cv = genHExpr(&mut cg, cond, locs, sigs, "bool")
    let thenLbl = nextLabel(&mut cg, "then")
    let elseLbl = nextLabel(&mut cg, "else")
    let endLbl = nextLabel(&mut cg, "endif")
    emit(&mut cg, "  br i1 " + cv.v + ", label %" + thenLbl + ", label %" + elseLbl + "\n")
    emit(&mut cg, thenLbl + ":\n")
    var thenTerm = false
    // Block scope: a value declared inside the branch dies at the branch's end, not at
    // the function epilogue. Dropping it at the epilogue was also invalid IR — its alloca
    // lives in a conditional block, which does not dominate the epilogue.
    let thenPreLen = locs.len
    for ti in 0..thenBody.len {
        if genStmt(&mut cg, *thenBody[ti], &mut locs, sigs, retTy) {
            thenTerm = true
        }
    }
    if !thenTerm {
        emitScopeDrops(&mut cg, locs, thenPreLen, "")
        emit(&mut cg, "  br label %" + endLbl + "\n")
    }
    while locs.len > thenPreLen {
        let _ = locs.pop()
    }
    emit(&mut cg, elseLbl + ":\n")
    var elseTerm = false
    let elsePreLen = locs.len
    match elseBody {
        Option.Some(stmts) => {
            for ei in 0..stmts.len {
                if genStmt(&mut cg, *stmts[ei], &mut locs, sigs, retTy) {
                    elseTerm = true
                }
            }
        }
        Option.None => {
        }
    }
    if !elseTerm {
        emitScopeDrops(&mut cg, locs, elsePreLen, "")
        emit(&mut cg, "  br label %" + endLbl + "\n")
    }
    while locs.len > elsePreLen {
        let _ = locs.pop()
    }
    emit(&mut cg, endLbl + ":\n")
    if thenTerm && elseTerm {
        emit(&mut cg, "  unreachable\n")
    }
    return thenTerm && elseTerm
}

// -- Match statement --

// Does matching this subject BORROW it rather than consume it? Mirrors the
// oracle's checker.enumSubjectBorrow: a `&enum` binding and an enum *place*
// (s.field, v[i], *h) are read without being consumed, so a non-Copy payload
// must bind as a view into the still-owned subject. Only a whole owned value
// (a plain local or a temporary) hands its payload over.
fn matchSubjectBorrows(subject: &ExprNode, locs: &Vec<Local>): bool {
    match subject.kind {
        Expr.Ident(name) => {
            if hasLocal(locs, name) {
                return findLocal(locs, name).isRef
            }
            return false
        }
        Expr.FieldAccess(obj, field) => {
            return true
        }
        Expr.IndexAccess(obj, idx) => {
            return true
        }
        Expr.UnaryOp(op, operand) => {
            return op == "*"
        }
        _ => {
            return false
        }
    }
}

// Bind one arm's payload locals out of `payPtr` (the subject's payload slot).
// Two ownership regimes, exactly as the oracle's extractBindings:
//   * borrowed subject + droppable payload → bind a REF straight at the payload
//     address. No load, no drop: the subject still owns the buffer.
//   * owned subject + droppable payload → MOVE it: load into the binding's own
//     slot and zero the source, so the subject's drop chain no longer sees it.
// A Copy payload is a plain value copy under either regime.
fn bindArmPayloads(cg: &mut Cgen, payPtr: &string, payloadTypes: &Vec<string>, bindings: &Vec<HBinding>, subjBorrows: bool, locs: &mut Vec<Local>) {
    let vstructTy = variantStructTy(payloadTypes)
    for bi in 0..bindings.len {
        let pty = payloadTypes[bi].clone()
        let ftyLl = llType(pty)
        let fp = nextTemp(&mut cg)
        emit(&mut cg, "  " + fp + " = getelementptr " + vstructTy + ", ptr " + payPtr.clone() + ", i32 0, i32 " + bi.toString() + "\n")
        let droppable = cgNeedsDrop(cg, pty)
        if subjBorrows && droppable {
            locs.push(Local {
                name: bindings[bi].name.clone(), ty: pty.clone(), addr: fp, isRef: true, isArr: false, range: noRange()
            })
        } else {
            let loaded = nextTemp(&mut cg)
            emit(&mut cg, "  " + loaded + " = load " + ftyLl + ", ptr " + fp + "\n")
            let bindAddr = nextTemp(&mut cg)
            emit(&mut cg, "  " + bindAddr + " = alloca " + ftyLl + "\n")
            emit(&mut cg, "  store " + ftyLl + " " + loaded + ", ptr " + bindAddr + "\n")
            if droppable {
                zeroStore(&mut cg, fp, pty)
            }
            locs.push(Local {
                name: bindings[bi].name.clone(), ty: pty.clone(), addr: bindAddr, isRef: false, isArr: false, range: noRange()
            })
        }
    }
}

// Match-expression codegen result: a value-producing match (Expr.MatchExpr)
// needs the arm's Val alongside the usual "did this block terminate" bool;
// statement-mode match (Stmt.MatchStmt, wantValue=false) only ever reads
// `.terminated` and leaves `.val` at its zero value.
pub struct MatchGen {
    terminated: bool,
    val: Val,
}

// Runs one arm's body. In value mode (wantValue) the LAST statement supplies
// the arm's value: a bare ExprStmt is evaluated for its Val instead of run as
// a statement (the checker guarantees the only other legal tail is a
// diverging return/break/continue, which runs as an ordinary statement and
// contributes no value — never silently coerced to a zero/void Val).
pub fn genArmBody(cg: &mut Cgen, body: &Vec<Heap<HStmt>>, locs: &mut Vec<Local>, sigs: &Vec<CgFnSig>, retTy: &string, wantValue: bool, hintTy: string): MatchGen {
    var terminated = false
    var produced = false
    var val = Val {
        v: "0", ty: "void"
    }
    var i: i64 = 0
    while i < body.len {
        let isLast = i == body.len - 1
        if wantValue && isLast {
            match *body[i] {
                HStmt.ExprStmt(e) => {
                    val = genHExpr(&mut cg, *e, locs, sigs, hintTy.clone())
                    produced = true
                }
                _ => {
                    if genStmt(&mut cg, *body[i], &mut locs, sigs, retTy) {
                        terminated = true
                    }
                }
            }
        } else {
            if genStmt(&mut cg, *body[i], &mut locs, sigs, retTy) {
                terminated = true
            }
        }
        i = i + 1
    }
    if wantValue && !terminated && !produced {
        // Should be unreachable — the checker rejects an arm whose tail is
        // neither a value nor a diverging statement. Fail loudly rather than
        // synthesize a plausible-looking value if that guarantee ever slips.
        eprint("codegen: match-expression arm produced no value and did not diverge")
        exit(1)
    }
    return MatchGen {
        terminated: terminated, val: val
    }
}

// `match s { "a" => …, _ => … }` on a string subject: a chain of string-eq
// tests (literals are exclusive so a non-final wildcard is still the default).
pub fn genStringMatch(cg: &mut Cgen, subjValV: &string, arms: &Vec<HMatchArm>, locs: &mut Vec<Local>, sigs: &Vec<CgFnSig>, retTy: &string, wantValue: bool, hintTy: string): MatchGen {
    let endLbl = nextLabel(&mut cg, "smatch.end")
    var allTerminated = true
    var wildIdx: i64 = -1
    var phiVals: Vec<string> = Vec.new()
    var phiPreds: Vec<string> = Vec.new()
    var resultTy = hintTy.clone()
    for ai in 0..arms.len {
        match arms[ai].pattern {
            HPattern.HLiteralPattern(val, kind) => {
                let litV = genStringLit(&mut cg, val.clone())
                let eq = genStringEq(&mut cg, subjValV.clone(), litV.v, true)
                let armLbl = nextLabel(&mut cg, "smatch.arm")
                let nextLbl = nextLabel(&mut cg, "smatch.next")
                emit(&mut cg, "  br i1 " + eq.v + ", label %" + armLbl + ", label %" + nextLbl + "\n")
                emitLabel(&mut cg, armLbl)
                let res = genArmBody(&mut cg, arms[ai].body, &mut locs, sigs, retTy, wantValue, resultTy.clone())
                if !res.terminated {
                    if wantValue {
                        if resultTy.len == 0 {
                            resultTy = res.val.ty.clone()
                        }
                        phiVals.push(res.val.v.clone())
                        phiPreds.push(cg.curBlock.clone())
                    }
                    emit(&mut cg, "  br label %" + endLbl + "\n")
                    allTerminated = false
                }
                emitLabel(&mut cg, nextLbl)
            }
            _ => {
                wildIdx = ai
            }
        }
    }
    if wildIdx >= 0 {
        let res = genArmBody(&mut cg, arms[wildIdx].body, &mut locs, sigs, retTy, wantValue, resultTy.clone())
        if !res.terminated {
            if wantValue {
                if resultTy.len == 0 {
                    resultTy = res.val.ty.clone()
                }
                phiVals.push(res.val.v.clone())
                phiPreds.push(cg.curBlock.clone())
            }
            emit(&mut cg, "  br label %" + endLbl + "\n")
            allTerminated = false
        }
    } else {
        // exhaustive per the checker → no-match is unreachable (see genIntMatch)
        emit(&mut cg, "  unreachable\n")
    }
    emitLabel(&mut cg, endLbl)
    if allTerminated {
        emit(&mut cg, "  unreachable\n")
        return MatchGen {
            terminated: true, val: Val {
                v: "0", ty: "void"
            }
        }
    }
    return finishMatchPhi(&mut cg, wantValue, phiVals, phiPreds, resultTy)
}

// Shared phi emission for the value-producing forms of genStringMatch/genIntMatch/
// genMatch: one incoming pair per arm that reached the join block (a diverging arm
// never does, so it never appears here — same rule as if-expression branches).
pub fn finishMatchPhi(cg: &mut Cgen, wantValue: bool, phiVals: &Vec<string>, phiPreds: &Vec<string>, resultTy: &string): MatchGen {
    if !wantValue || phiVals.len == 0 {
        return MatchGen {
            terminated: false, val: Val {
                v: "0", ty: "void"
            }
        }
    }
    let r = nextTemp(&mut cg)
    let ll = llType(resultTy)
    var parts = ""
    var pi: i64 = 0
    while pi < phiVals.len {
        parts = parts + "[" + phiVals[pi] + ", %" + phiPreds[pi] + "]"
        if pi < phiVals.len - 1 {
            parts = parts + ", "
        }
        pi = pi + 1
    }
    emit(&mut cg, "  " + r + " = phi " + ll + " " + parts + "\n")
    return MatchGen {
        terminated: false, val: Val {
            v: r, ty: resultTy.clone()
        }
    }
}

// The integer constant for a literal pattern (char code / int / bool → 0/1).
pub fn litIntConst(val: &string, kind: &LiteralKind): string {
    match kind {
        LiteralKind.LitBool => {
            if val == "true" {
                return "1"
            }
            return "0"
        }
        _ => {
            return val.clone()
        }
    }
}

// match on an integer/char/bool subject: compare the value against each literal
// pattern (a switch would also work, but a compare chain handles any width).
pub fn genIntMatch(cg: &mut Cgen, subjV: &string, subjLl: &string, arms: &Vec<HMatchArm>, locs: &mut Vec<Local>, sigs: &Vec<CgFnSig>, retTy: &string, wantValue: bool, hintTy: string): MatchGen {
    let endLbl = nextLabel(&mut cg, "imatch.end")
    var allTerminated = true
    var wildIdx: i64 = -1
    var phiVals: Vec<string> = Vec.new()
    var phiPreds: Vec<string> = Vec.new()
    var resultTy = hintTy.clone()
    for ai in 0..arms.len {
        match arms[ai].pattern {
            HPattern.HLiteralPattern(val, kind) => {
                let eq = nextTemp(&mut cg)
                emit(&mut cg, "  " + eq + " = icmp eq " + subjLl.clone() + " " + subjV.clone() + ", " + litIntConst(val, kind) + "\n")
                let armLbl = nextLabel(&mut cg, "imatch.arm")
                let nextLbl = nextLabel(&mut cg, "imatch.next")
                emit(&mut cg, "  br i1 " + eq + ", label %" + armLbl + ", label %" + nextLbl + "\n")
                emitLabel(&mut cg, armLbl)
                let res = genArmBody(&mut cg, arms[ai].body, &mut locs, sigs, retTy, wantValue, resultTy.clone())
                if !res.terminated {
                    if wantValue {
                        if resultTy.len == 0 {
                            resultTy = res.val.ty.clone()
                        }
                        phiVals.push(res.val.v.clone())
                        phiPreds.push(cg.curBlock.clone())
                    }
                    emit(&mut cg, "  br label %" + endLbl + "\n")
                    allTerminated = false
                }
                emitLabel(&mut cg, nextLbl)
            }
            _ => {
                wildIdx = ai
            }
        }
    }
    if wildIdx >= 0 {
        let res = genArmBody(&mut cg, arms[wildIdx].body, &mut locs, sigs, retTy, wantValue, resultTy.clone())
        if !res.terminated {
            if wantValue {
                if resultTy.len == 0 {
                    resultTy = res.val.ty.clone()
                }
                phiVals.push(res.val.v.clone())
                phiPreds.push(cg.curBlock.clone())
            }
            emit(&mut cg, "  br label %" + endLbl + "\n")
            allTerminated = false
        }
    } else {
        // no wildcard: the checker proved the match exhaustive (e.g. bool true/false),
        // so the fall-off-the-end path is unreachable — don't force a fallthrough that
        // would hit the function's default `ret <T> 0` (invalid for aggregate returns).
        emit(&mut cg, "  unreachable\n")
    }
    emitLabel(&mut cg, endLbl)
    if allTerminated {
        emit(&mut cg, "  unreachable\n")
        return MatchGen {
            terminated: true, val: Val {
                v: "0", ty: "void"
            }
        }
    }
    return finishMatchPhi(&mut cg, wantValue, phiVals, phiPreds, resultTy)
}

// The name a block YIELDS, when its value is just a binding (`Result.Ok(j) => j`).
// Such an arm hands its payload binding to the match's result, so the arm-scope
// teardown must not drop it — jsonCursor's `let doc = match … { Ok(j) => j }`
// freed the document and then read it.
fn trailingIdentName(body: &Vec<Heap<HStmt>>): string {
    if body.len == 0 {
        return ""
    }
    match *body[body.len - 1] {
        HStmt.ExprStmt(e) => {
            match (*e).kind {
                HExpr.Unlowered(a) => {
                    match (*a).kind {
                        Expr.Ident(name) => {
                            return name.clone()
                        }
                        _ => {
                            return ""
                        }
                    }
                }
                _ => {
                    return ""
                }
            }
        }
        _ => {
            return ""
        }
    }
}

// Does any arm bind a payload that owns something? Only then is the subject consumed:
// a Copy payload is copied out and leaves the subject intact.
fn armMovesPayload(cg: &Cgen, arms: &Vec<HMatchArm>): bool {
    for ai in 0..arms.len {
        match arms[ai].pattern {
            HPattern.HEnumPattern(vname, bindings, vidx) => {
                for bi in 0..bindings.len {
                    if cgNeedsDrop(cg, tyStr(cg, bindings[bi].ty, "match binding")) {
                        return true
                    }
                }
            }
            _ => {
            }
        }
    }
    return false
}

pub fn genMatchAst(cg: &mut Cgen, subject: &ExprNode, arms: &Vec<HMatchArm>, locs: &mut Vec<Local>, sigs: &Vec<CgFnSig>, retTy: &string, wantValue: bool, hintTy: string): MatchGen {
    // Whether the subject is BORROWED rather than consumed is a question about the place
    // it names, which is still a syntactic one here — the checker records no equivalent of
    // the oracle's matchSubjectRef set, so HStmt.Match's own isRef flag is weaker (it only
    // reports a subject whose recorded type was still a `&T`) and is deliberately not used.
    let subjBorrows = matchSubjectBorrows(subject, locs)
    let subjLv = genLvalue(&mut cg, subject, locs, sigs)
    // An arm that MOVES a droppable payload out of an owned subject leaves that subject
    // dead. Zeroing the payload slot (bindArmPayloads) is not enough on its own: it makes
    // the subject's drop glue free a null pointer, which is a harmless no-op and is why
    // heap payloads looked correct — but a user `Drop` impl runs regardless and receives
    // the zeroed value. `Res { id: 1 }` therefore dropped twice, the second time printing
    // `drop 0`; for std/http's `Socket { fd: i32 }` that second drop is `close(0)`,
    // closing stdin on a socket already moved away.
    //
    // Only types whose fields are all Copy ever showed it, because a heap field's second
    // free was silently a no-op. Recording the subject's address as moved is the same
    // channel every other move-out already uses, so scope-end drops skip it.
    if !subjBorrows && armMovesPayload(cg, arms) {
        cg.movedLocalAddrs.push(subjLv.v.clone())
    }
    if llType(subjLv.ty) == "%String" {
        let sv = nextTemp(&mut cg)
        emit(&mut cg, "  " + sv + " = load %String, ptr " + subjLv.v + "\n")
        return genStringMatch(&mut cg, sv, arms, &mut locs, sigs, retTy, wantValue, hintTy)
    }
    // integer/char/bool subject → compare against literal patterns
    let subjLl0 = llType(subjLv.ty)
    if subjLl0.len > 0 && subjLl0[0] == 105 {
        let iv = nextTemp(&mut cg)
        emit(&mut cg, "  " + iv + " = load " + subjLl0 + ", ptr " + subjLv.v + "\n")
        return genIntMatch(&mut cg, iv, subjLl0, arms, &mut locs, sigs, retTy, wantValue, hintTy)
    }
    let rawName = stripPercent(subjLv.ty)
    let structTy = "%" + rawName
    let tagPtr = nextTemp(&mut cg)
    emit(&mut cg, "  " + tagPtr + " = getelementptr " + structTy + ", ptr " + subjLv.v + ", i32 0, i32 0\n")
    let tag = nextTemp(&mut cg)
    emit(&mut cg, "  " + tag + " = load i32, ptr " + tagPtr + "\n")
    let endLbl = nextLabel(&mut cg, "match.end")
    var switchCases = ""
    var armLabels: Vec<string> = Vec.new()
    // A wildcard/binding arm (`_ => …`) is the switch DEFAULT, not a numbered case
    // — numbering it collides with a real variant tag (duplicate switch case).
    var wildcardLbl = ""
    for i in 0..arms.len {
        let armLbl = nextLabel(&mut cg, "match.arm")
        match arms[i].pattern {
            HPattern.HEnumPattern(variant, bindings, tg0) => {
                // Keyed by the subject's (mangled) enum name. The pattern's own recorded
                // tag is NOT used: the checker numbers variants positionally and drops an
                // explicit `= 169` discriminant, which cg.enums honours.
                let tg = lookupVariantTag(cg, rawName, variant)
                switchCases = switchCases + "i32 " + tg.toString() + ", label %" + armLbl + " "
            }
            _ => {
                if wildcardLbl.len == 0 {
                    wildcardLbl = armLbl.clone()
                }
            }
        }
        armLabels.push(armLbl)
    }
    var defaultLbl = nextLabel(&mut cg, "match.default")
    var emitUnreachableDefault = true
    if wildcardLbl.len > 0 {
        defaultLbl = wildcardLbl.clone()
        emitUnreachableDefault = false
    }
    emit(&mut cg, "  switch i32 " + tag + ", label %" + defaultLbl + " [" + switchCases + "]\n")
    var allTerminated = true
    var phiVals: Vec<string> = Vec.new()
    var phiPreds: Vec<string> = Vec.new()
    var resultTy = hintTy.clone()
    for ai in 0..arms.len {
        emitLabel(&mut cg, armLabels[ai])
        let locsPreLen = locs.len
        // Extract payload bindings
        match arms[ai].pattern {
            HPattern.HEnumPattern(variant, bindings, tg0) => {
                if bindings.len > 0 {
                    let payloadTypes = lookupVariantPayload(cg, rawName, variant)
                    if payloadTypes.len > 0 {
                        let payPtr = nextTemp(&mut cg)
                        emit(&mut cg, "  " + payPtr + " = getelementptr " + structTy + ", ptr " + subjLv.v + ", i32 0, i32 1\n")
                        bindArmPayloads(&mut cg, payPtr, payloadTypes, bindings, subjBorrows, &mut locs)
                    }
                }
            }
            _ => {
            }
        }
        let res = genArmBody(&mut cg, arms[ai].body, &mut locs, sigs, retTy, wantValue, resultTy.clone())
        // A payload binding (`Result.Ok(t) => { … }`) is ARM-SCOPED: it dies at the arm's
        // end like any other block. locsPreLen is captured BEFORE the bindings are pushed,
        // which is why the drop belongs here and not inside genArmBody. A terminated arm
        // (return/break) already dropped its scope on the way out — dropping again would
        // double-count.
        if !res.terminated {
            var armSkip = ""
            if wantValue {
                armSkip = trailingIdentName(arms[ai].body)
            }
            emitScopeDrops(&mut cg, locs, locsPreLen, armSkip)
        }
        // Pop bindings
        while locs.len > locsPreLen {
            let _ = locs.pop()
        }
        if !res.terminated {
            if wantValue {
                if resultTy.len == 0 {
                    resultTy = res.val.ty.clone()
                }
                phiVals.push(res.val.v.clone())
                phiPreds.push(cg.curBlock.clone())
            }
            emit(&mut cg, "  br label %" + endLbl + "\n")
            allTerminated = false
        }
    }
    // Only emit a synthetic unreachable default when there was no wildcard arm
    // (a wildcard arm already serves as the default and emits its own body).
    if emitUnreachableDefault {
        emitLabel(&mut cg, defaultLbl)
        emit(&mut cg, "  unreachable\n")
    }
    emitLabel(&mut cg, endLbl)
    if allTerminated && arms.len > 0 {
        emit(&mut cg, "  unreachable\n")
        return MatchGen {
            terminated: true, val: Val {
                v: "0", ty: "void"
            }
        }
    }
    return finishMatchPhi(&mut cg, wantValue, phiVals, phiPreds, resultTy)
}

// Scope teardown: every owned local leaving this scope is dropped — builtin heap
// (string/Vec/Heap and anything transitively holding one) via emitDropValue, and
// a user `impl Drop` via the same path (emitDropValue calls Ty$Drop$drop and
// stops). Declaration order matches the oracle's observable behavior. skipName:
// a returned local is moved out of the scope, not dropped.
//
// Where the oracle keeps a per-local i1 alive-flag, this relies on the runtime
// sentinel that move-out zeroing already leaves behind (cap==0 / null data —
// see drops.milo's header) plus addrWasMoved for plain structs, which carry no
// sentinel of their own. Zeroing after the drop is what makes the drop
// idempotent: a `break` drops the loop-scoped locals and then falls through to
// the function epilogue, which walks the same slots from 0.
pub fn emitScopeDrops(cg: &mut Cgen, locs: &Vec<Local>, fromLen: i64, skipName: &string) {
    for i in fromLen..locs.len {
        if locs[i].isRef {
            continue
        }
        if locs[i].name == skipName {
            continue
        }
        // Already moved out (push/call/reassign zeroed this slot) — the user's
        // drop() must not run twice on a value that no longer lives here. Plain
        // structs have no null/cap sentinel of their own to catch this, unlike
        // Vec/String/Heap.
        if addrWasMoved(cg, locs[i].addr) {
            continue
        }
        if cgNeedsDrop(cg, locs[i].ty) {
            emitDropValue(&mut cg, locs[i].addr, locs[i].ty)
            zeroStore(&mut cg, locs[i].addr, locs[i].ty)
        }
    }
}

// The value form of `if`: both arms are expressions, so their bodies are walked for a
// value and joined with a phi. Bodies come from the block arena — see blockBase.
pub fn genIfExprValue(cg: &mut Cgen, cond: &ExprNode, thenBody: &Vec<Heap<HStmt>>, elseBody: &Vec<Heap<HStmt>>, locs: &mut Vec<Local>, sigs: &Vec<CgFnSig>, hintTy: string): Val {
    // Same compile-time fold as the statement form (genIf): the value comes from the
    // taken arm alone, and the dead arm is never emitted.
    match constFoldBool(cg, cond) {
        Option.Some(taken) => {
            let foldRetTy = cg.curRetTy.clone()
            if taken {
                return genArmBody(&mut cg, thenBody, &mut locs, sigs, foldRetTy, true, hintTy.clone()).val
            }
            return genArmBody(&mut cg, elseBody, &mut locs, sigs, foldRetTy, true, hintTy.clone()).val
        }
        Option.None => {
        }
    }
    let cv = genExpr(&mut cg, cond, locs, sigs, "bool")
    let thenLbl = nextLabel(&mut cg, "ifx.then")
    let elseLbl = nextLabel(&mut cg, "ifx.else")
    let endLbl = nextLabel(&mut cg, "ifx.end")
    let armRetTy = cg.curRetTy.clone()
    emit(&mut cg, "  br i1 " + cv.v + ", label %" + thenLbl + ", label %" + elseLbl + "\n")
    emitLabel(&mut cg, thenLbl)
    let a = genArmBody(&mut cg, thenBody, &mut locs, sigs, armRetTy, true, hintTy.clone())
    // the phi predecessor is wherever control actually is now — a nested if-expr
    // (`else if …`) ends in its OWN block, not thenLbl/elseLbl.
    let thenPred = cg.curBlock.clone()
    if !a.terminated {
        emit(&mut cg, "  br label %" + endLbl + "\n")
    }
    emitLabel(&mut cg, elseLbl)
    let b = genArmBody(&mut cg, elseBody, &mut locs, sigs, armRetTy, true, a.val.ty.clone())
    let elsePred = cg.curBlock.clone()
    if !b.terminated {
        emit(&mut cg, "  br label %" + endLbl + "\n")
    }
    emitLabel(&mut cg, endLbl)
    if a.terminated && b.terminated {
        emit(&mut cg, "  unreachable\n")
        return Val {
            v: "0", ty: "i64"
        }
    }
    // A diverging arm contributes no incoming edge, so the phi takes the type — and the
    // sole value — from the arm that survived.
    var resTy = a.val.ty.clone()
    if a.terminated {
        resTy = b.val.ty.clone()
    }
    let r = nextTemp(&mut cg)
    let ll = llType(resTy)
    if a.terminated {
        emit(&mut cg, "  " + r + " = phi " + ll + " [" + b.val.v + ", %" + elsePred + "]\n")
    } else if b.terminated {
        emit(&mut cg, "  " + r + " = phi " + ll + " [" + a.val.v + ", %" + thenPred + "]\n")
    } else {
        emit(&mut cg, "  " + r + " = phi " + ll + " [" + a.val.v + ", %" + thenPred + "], [" + b.val.v + ", %" + elsePred + "]\n")
    }
    return Val {
        v: r, ty: resTy
    }
}

// -- Lifted statement blocks --
//
// A Closure/IfExpr/MatchExpr in expression position had its body moved into the module's
// block arena at lowering, keyed by the node's id, and its AST body left empty. Codegen
// reads it back from there.

// Index of the FIRST block belonging to expression node `id`. Fatal on a miss: the AST
// body is empty by construction, so falling back to it would emit an empty function body
// and no diagnostic at all.
pub fn blockBase(cg: &Cgen, id: u32, what: &string): i64 {
    match cg.stmtBlockAt.get(id) {
        Option.Some(i) => {
            return i
        }
        Option.None => {
            eprint("internal error: " + what.clone() + " #" + id.toString() + ": lowering lifted no statement block for it")
            unsafe {
                exit(1)
            }
            return 0
        }
    }
}

// Blocks are MOVED out to be walked and moved back, never copied: reading an HStmt tree
// through a copy duplicates enum payloads whose variant the copy cannot see, which is one
// buffer with two owners.
pub fn takeBlock(cg: &mut Cgen, idx: i64): Vec<Heap<HStmt>> {
    return replace(cg.stmtBlocks[idx].stmts, Vec.new())
}

pub fn putBlock(cg: &mut Cgen, idx: i64, b: Vec<Heap<HStmt>>) {
    cg.stmtBlocks[idx].stmts = b
}

pub fn takeArms(cg: &mut Cgen, idx: i64): Vec<HMatchArm> {
    return replace(cg.stmtBlocks[idx].arms, Vec.new())
}

pub fn putArms(cg: &mut Cgen, idx: i64, a: Vec<HMatchArm>) {
    cg.stmtBlocks[idx].arms = a
}

// -- Main statement dispatch. Returns true if stmt terminates block. --

// A call in statement position still returns an OWNED value, and with nobody to bind it
// nothing else will ever free it: `v.remove(0)` as a statement destroyed nothing, so the
// element's destructor never ran and its heap went with it.
//
// Only call-shaped expressions qualify. A place expression — an identifier, a field, an
// index — names storage someone else owns, and dropping one of those would double-free.
// That is the whole distinction the oracle draws in isOwnedTempExpr, and getting it
// backwards is worse than the leak.
fn isOwnedTempNode(n: &HExprNode): bool {
    match n.kind {
        HExpr.Unlowered(a) => {
            match (*a).kind {
                Expr.Call(name, args, typeArgs) => {
                    return true
                }
                Expr.MethodCall(obj, method, args) => {
                    return true
                }
                Expr.EnumLit(en, va, args) => {
                    return true
                }
                Expr.StructLit(name, fields) => {
                    return true
                }
                _ => {
                    return false
                }
            }
        }
        _ => {
            return false
        }
    }
}

fn dropDiscardedTemp(cg: &mut Cgen, n: &HExprNode, v: &Val) {
    if !isOwnedTempNode(n) {
        return
    }
    if !cgNeedsDrop(cg, v.ty) {
        return
    }
    // llType, not the raw Val type: a struct-typed Val carries the bare name here and
    // LLVM needs the '%'. Emitting `alloca Res` fails to parse.
    let llTy = llType(v.ty)
    let addr = nextTemp(&mut cg) + ".tmpdrop"
    emit(&mut cg, "  " + addr + " = alloca " + llTy.clone() + "\n")
    emit(&mut cg, "  store " + llTy.clone() + " " + v.v.clone() + ", ptr " + addr + "\n")
    emitDropValue(&mut cg, addr, v.ty)
}

pub fn genStmt(cg: &mut Cgen, s: &HStmt, locs: &mut Vec<Local>, sigs: &Vec<CgFnSig>, retTy: &string): bool {
    match s {
        HStmt.Let(name, ty, value, mutable) => {
            genLetBinding(&mut cg, name, ty, *value, (*value).span, &mut locs, sigs)
            return false
        }
        HStmt.Assign(target, value, isInit) => {
            genAssign(&mut cg, *target, *value, &mut locs, sigs)
            return false
        }
        HStmt.Return(value, retType) => {
            match value {
                Option.Some(hv) => {
                    genReturnValue(&mut cg, *hv, (*hv).span, &mut locs, sigs, retTy)
                }
                Option.None => {
                    emitScopeDrops(&mut cg, locs, 0, "")
                    let fnRetLl = llType(retTy)
                    if fnRetLl == "void" {
                        emit(&mut cg, "  ret void\n")
                    } else {
                        // bare `return` in a non-void fn (main is forced to i32)
                        emit(&mut cg, "  ret " + fnRetLl + " 0\n")
                    }
                }
            }
            return true
        }
        HStmt.ExprStmt(e) => {
            let dv = genHExpr(&mut cg, *e, locs, sigs, "")
            dropDiscardedTemp(&mut cg, *e, dv)
            return false
        }
        HStmt.If(cond, thenBody, elseBody) => {
            return genIf(&mut cg, *cond, thenBody, elseBody, &mut locs, sigs, retTy)
        }
        HStmt.While(cond, body, invariants) => {
            genWhile(&mut cg, *cond, body, &mut locs, sigs, retTy)
            return false
        }
        HStmt.ForRange(varName, varTy, startE, endE, body, invariants) => {
            genForRange(&mut cg, varName, *startE, *endE, body, &mut locs, sigs, retTy)
            return false
        }
        HStmt.ForEach(varName, varName2, varTy, varTy2, iterable, kind, body, invariants) => {
            genForEach(&mut cg, varName, varName2, *iterable, kind, body, &mut locs, sigs, retTy)
            return false
        }
        HStmt.ForIterator(varName, varTy, iterable, nextMethod, resultEnum, body, invariants, okVariant) => {
            genForIterator(&mut cg, varName, *iterable, nextMethod, resultEnum, okVariant, body, &mut locs, sigs, retTy)
            return false
        }
        HStmt.ForStrView(varName, varName2, varTy, src, sep, mode, body, invariants) => {
            genForStrView(&mut cg, varName, varName2, *src, sep, mode, body, &mut locs, sigs, retTy)
            return false
        }
        HStmt.Match(subject, arms, enumName, isRef) => {
            match (*subject).kind {
                HExpr.Unlowered(sx) => {
                    return genMatchAst(&mut cg, *sx, arms, &mut locs, sigs, retTy, false, "").terminated
                }
                _ => {
                    hexprAbort(*subject, "match subject")
                    return true
                }
            }
        }
        HStmt.Break => {
            if cg.curBreakLbl.len > 0 {
                // Leaving the loop body early still owns whatever it declared —
                // same locals a normal iteration-end would drop (loopBreak in
                // dropAccounting: the live `t` at the break point was leaking).
                if cg.curLoopScopeLen >= 0 {
                    emitScopeDrops(&mut cg, locs, cg.curLoopScopeLen, "")
                }
                emit(&mut cg, "  br label %" + cg.curBreakLbl + "\n")
                let after = nextLabel(&mut cg, "afterBreak")
                emit(&mut cg, after + ":\n")
            }
            return false
        }
        HStmt.Continue => {
            if cg.curContLbl.len > 0 {
                // Same as break above: ending this iteration early still drops
                // whatever it declared, same as reaching the bottom would.
                if cg.curLoopScopeLen >= 0 {
                    emitScopeDrops(&mut cg, locs, cg.curLoopScopeLen, "")
                }
                emit(&mut cg, "  br label %" + cg.curContLbl + "\n")
                let after = nextLabel(&mut cg, "afterCont")
                emit(&mut cg, after + ":\n")
            }
            return false
        }
        HStmt.UnsafeBlock(body) => {
            var term = false
            for i in 0..body.len {
                if genStmt(&mut cg, *body[i], &mut locs, sigs, retTy) {
                    term = true
                }
            }
            return term
        }
    }
}

// `let`/`var`: evaluate the initializer in an owning position, range-check it, and bind
// the result. `let` and `var` differ only in the checker, so they share one path here.
// Every backend fact about the binding — its type, its bound, whether it is a fixed array
// — is read off the ONE TypeKind the checker gave it, rather than reconstructed from the
// annotation's syntax at three separate sites.
// Takes the HIR node, not the AST underneath it. The two syntax reads below (is this a
// bare `Vec.new()`? does this binding force a move?) still need the written form and match
// `Unlowered` inline for it; the value itself goes through genHExpr, which dispatches.
// Converting the seam BEFORE any kind is lowered is deliberate: while every node is still
// Unlowered this is behaviour-identical, so the corpus proves the plumbing separately from
// the first kind that flows through it.
fn genLetBinding(cg: &mut Cgen, name: &string, ty: &TypeKind, value: &HExprNode, span: &Option<Span>, locs: &mut Vec<Local>, sigs: &Vec<CgFnSig>) {
    // Left open only where the checker itself left it open — an un-annotated `Vec.new()`
    // whose element the first push supplies — and the push pre-scan answers that case.
    var hintTy = ""
    if !containsUnknown(ty) {
        hintTy = tyStr(cg, ty, "'" + name.clone() + "'")
    }
    if hintTy.len == 0 {
        // Reads the SYNTAX — "was this written as Vec.new()" — so it needs the AST node.
        // A lowered node is never a bare Vec.new(): lowering that kind will carry the
        // element type on the node and this hint disappears with it.
        match value.kind {
            HExpr.Unlowered(av) => {
                hintTy = vecNewHint(cg, name, *av)
            }
            _ => {
            }
        }
    }
    // A fixed-size array and a growable Vec share one runtime shape, so this bit is what
    // tells genOwnedArg to deep-clone instead of move at a by-value site. The checker
    // knows which it is; nothing here infers it from a callee's mangled return-type string
    // any more.
    let isArrAnno = isFixedArrayTy(ty)
    let lrange = rangeOfTyK(ty)
    // RHS is moved into the new binding → zero a source place (var→var move)
    var v0 = Val {
        v: "0", ty: "void"
    }
    match value.kind {
        HExpr.Unlowered(av) => {
            match forceMoveIfEscaping(cg, name, *av) {
                Option.Some(forced) => {
                    v0 = genOwnedArg(&mut cg, *forced, hintTy.clone(), locs, sigs)
                }
                Option.None => {
                    v0 = genOwnedArg(&mut cg, *av, hintTy.clone(), locs, sigs)
                }
            }
        }
        _ => {
            // genOwnedArg's job is the ownership decision — clone vs move, and zeroing the
            // source place. Only kinds with no ownership to decide may take this arm, which
            // today means the scalar literals. A kind that owns anything needs a typed
            // genOwnedArg before it may be lowered, not this shortcut.
            // Empty hint on purpose: a lowered node carries the type the checker gave it,
            // so consulting a hint here would be the very re-derivation being removed.
            v0 = genHExpr(&mut cg, value, locs, sigs, "")
        }
    }
    let v1 = genOptionWrapIfNeeded(&mut cg, v0, hintTy.clone())
    let v = genInterfaceCoerceIfNeeded(&mut cg, v1, hintTy)
    emitRangeCheck(&mut cg, v, lrange, span)
    let vtyLl = llType(v.ty)
    let addr = nextTemp(&mut cg)
    emit(&mut cg, "  " + addr + " = alloca " + vtyLl + "\n")
    emit(&mut cg, "  store " + vtyLl + " " + v.v + ", ptr " + addr + "\n")
    locs.push(Local {
        name: name.clone(), ty: v.ty.clone(), addr: addr, isRef: false, isArr: isArrAnno, range: lrange.clone()
    })
}

fn genReturnValue(cg: &mut Cgen, hexpr: &HExprNode, span: &Option<Span>, locs: &mut Vec<Local>, sigs: &Vec<CgFnSig>, retTy: &string) {
    // a returned local is moved out — everything else in scope drops
    var skipName = ""
    match hexpr.kind {
        HExpr.Unlowered(e) => {
            match (*e).kind {
                Expr.Ident(n) => {
                    skipName = n.clone()
                }
                _ => {
                }
            }
        }
        HExpr.Ident(n, isMove) => {
            skipName = n.clone()
        }
        _ => {
        }
    }
    // A directly-returned closure literal escapes this frame right here — force it to
    // `move` so its captures are heap-owned, not aliased into the frame that's about to
    // unwind (see forcedMoveClosure).
    //
    // A returned PLACE is moved out of this frame too: `return w.out` hands the string to
    // the caller, and without the move the scope teardown below frees it (deflate returned
    // a dangling buffer). A bare ident is additionally covered by skipName above; zeroing
    // it first is harmless — its drop is already skipped.
    var v00 = Val {
        v: "0", ty: "void"
    }
    match hexpr.kind {
        HExpr.Unlowered(e) => {
            match forcedMoveClosure(*e) {
                Option.Some(forced) => {
                    v00 = genOwnedArg(&mut cg, *forced, retTy.clone(), locs, sigs)
                }
                Option.None => {
                    v00 = genOwnedArg(&mut cg, *e, retTy.clone(), locs, sigs)
                }
            }
        }
        _ => {
            // Same rule as genLetBinding: only kinds with no ownership to decide take this
            // arm. forcedMoveClosure reads the written form, and a lowered closure literal
            // will carry its own capture mode when that kind is migrated.
            // Empty hint, same reason as genLetBinding: the node knows its own type.
            v00 = genHExpr(&mut cg, hexpr, locs, sigs, "")
        }
    }
    let v = genInterfaceCoerceIfNeeded(&mut cg, v00, retTy)
    let retRange = cg.curRetRange.clone()
    emitRangeCheck(&mut cg, v, retRange, span)
    emitScopeDrops(&mut cg, locs, 0, skipName)
    // unannotated closure body: the return type IS the value's type; record it
    // (genClosure reads it for the define header) and emit the ret with no coercion.
    if retTy == "__closureinfer__" {
        let vll = llType(v.ty)
        cg.closureRetTy = v.ty.clone()
        emit(&mut cg, "  ret " + vll + " " + v.v + "\n")
        return
    }
    let fnRetLl = llType(retTy)
    let valLl = llType(v.ty)
    if valLl == fnRetLl {
        emit(&mut cg, "  ret " + valLl + " " + v.v + "\n")
    } else {
        let cast = nextTemp(&mut cg)
        emit(&mut cg, "  " + cast + " = trunc " + valLl + " " + v.v + " to " + fnRetLl + "\n")
        emit(&mut cg, "  ret " + fnRetLl + " " + cast + "\n")
    }
}

// -- Closures --

// Every block a lifted-body node owns, walked for identifiers.
fn collectIdentsBlocks(cg: &Cgen, id: u32, count: i64, out: &mut Vec<string>) {
    let base = blockBase(cg, id, "expression")
    for b in 0..count {
        for j in 0..cg.stmtBlocks[base + b].stmts.len {
            collectIdentsStmt(cg, *cg.stmtBlocks[base + b].stmts[j], &mut out)
        }
    }
}

// Collect every identifier name referenced in an expression (over-approximate:
// the caller filters against the enclosing scope to find true captures).
pub fn collectIdentsExpr(cg: &Cgen, e: &ExprNode, out: &mut Vec<string>) {
    match e.kind {
        Expr.Ident(name) => {
            out.push(name.clone())
        }
        Expr.BinOp(op, l, r) => {
            collectIdentsExpr(cg, *l, &mut out)
            collectIdentsExpr(cg, *r, &mut out)
        }
        Expr.UnaryOp(op, x) => {
            collectIdentsExpr(cg, *x, &mut out)
        }
        Expr.Call(name, args, targs) => {
            out.push(name.clone())
            for i in 0..args.len {
                collectIdentsExpr(cg, *args[i], &mut out)
            }
        }
        Expr.StructLit(name, fields) => {
            for i in 0..fields.len {
                collectIdentsExpr(cg, *fields[i].value, &mut out)
            }
        }
        // Same shape as StructLit — its field values are arbitrary expressions, so a
        // closure whose body builds a JSON object out of an enclosing local captured
        // nothing and read a garbage frame slot.
        Expr.JsonObject(fields) => {
            for i in 0..fields.len {
                collectIdentsExpr(cg, *fields[i].value, &mut out)
            }
        }
        Expr.FieldAccess(obj, field) => {
            collectIdentsExpr(cg, *obj, &mut out)
        }
        Expr.ArrayLit(elems) => {
            for i in 0..elems.len {
                collectIdentsExpr(cg, *elems[i], &mut out)
            }
        }
        Expr.ArrayRepeat(x, n) => {
            collectIdentsExpr(cg, *x, &mut out)
        }
        Expr.IndexAccess(obj, idx) => {
            collectIdentsExpr(cg, *obj, &mut out)
            collectIdentsExpr(cg, *idx, &mut out)
        }
        Expr.EnumLit(en, va, args) => {
            for i in 0..args.len {
                collectIdentsExpr(cg, *args[i], &mut out)
            }
        }
        Expr.Unwrap(x) => {
            collectIdentsExpr(cg, *x, &mut out)
        }
        Expr.Propagate(x) => {
            collectIdentsExpr(cg, *x, &mut out)
        }
        Expr.DefaultValue(x, d) => {
            collectIdentsExpr(cg, *x, &mut out)
            collectIdentsExpr(cg, *d, &mut out)
        }
        Expr.CastExpr(x, ty) => {
            collectIdentsExpr(cg, *x, &mut out)
        }
        Expr.MethodCall(obj, m, args) => {
            collectIdentsExpr(cg, *obj, &mut out)
            for i in 0..args.len {
                collectIdentsExpr(cg, *args[i], &mut out)
            }
        }
        // The three body-carrying shapes were emptied at lowering, so the walk follows
        // the node's id into the block arena instead of its (now empty) AST body.
        Expr.Closure(params, rt, body, isMove) => {
            collectIdentsBlocks(cg, e.id, 1, &mut out)
        }
        Expr.RangeExpr(a, b) => {
            collectIdentsExpr(cg, *a, &mut out)
            collectIdentsExpr(cg, *b, &mut out)
        }
        Expr.IsExpr(x, pat) => {
            collectIdentsExpr(cg, *x, &mut out)
        }
        Expr.IfExpr(c, thenBody, elseBody) => {
            collectIdentsExpr(cg, *c, &mut out)
            collectIdentsBlocks(cg, e.id, 2, &mut out)
        }
        Expr.MatchExpr(subject, arms) => {
            collectIdentsExpr(cg, *subject, &mut out)
            let base = blockBase(cg, e.id, "match-expression")
            for ai in 0..cg.stmtBlocks[base].arms.len {
                for j in 0..cg.stmtBlocks[base].arms[ai].body.len {
                    collectIdentsStmt(cg, *cg.stmtBlocks[base].arms[ai].body[j], &mut out)
                }
            }
        }
        // Literals hold no identifiers. Spelled out rather than left to a `_` arm:
        // a capture walker that silently skips a new Expr variant produces a closure
        // reading an uncaptured frame slot, with nothing to point at. Exhaustive here
        // means adding a variant to the AST fails to compile until it is traversed.
        Expr.IntLit(n) => {
        }
        Expr.FloatLit(f) => {
        }
        Expr.BoolLit(b) => {
        }
        Expr.StringLit(s) => {
        }
        Expr.CharLit(c) => {
        }
    }
}

pub fn collectIdentsStmt(cg: &Cgen, s: &HStmt, out: &mut Vec<string>) {
    match s {
        HStmt.Let(name, ty, value, mutable) => {
            collectIdentsHExpr(cg, *value, &mut out)
        }
        HStmt.Assign(target, value, isInit) => {
            collectIdentsHExpr(cg, *target, &mut out)
            collectIdentsHExpr(cg, *value, &mut out)
        }
        HStmt.Return(value, retType) => {
            match value {
                Option.Some(e) => {
                    collectIdentsHExpr(cg, *e, &mut out)
                }
                Option.None => {
                }
            }
        }
        HStmt.If(cond, thenB, elseB) => {
            collectIdentsHExpr(cg, *cond, &mut out)
            for i in 0..thenB.len {
                collectIdentsStmt(cg, *thenB[i], &mut out)
            }
            match elseB {
                Option.Some(eb) => {
                    for i in 0..eb.len {
                        collectIdentsStmt(cg, *eb[i], &mut out)
                    }
                }
                Option.None => {
                }
            }
        }
        HStmt.While(cond, body, invariants) => {
            collectIdentsHExpr(cg, *cond, &mut out)
            for i in 0..body.len {
                collectIdentsStmt(cg, *body[i], &mut out)
            }
        }
        HStmt.ExprStmt(e) => {
            collectIdentsHExpr(cg, *e, &mut out)
        }
        HStmt.Match(subj, arms, enumName, isRef) => {
            collectIdentsHExpr(cg, *subj, &mut out)
            for i in 0..arms.len {
                for j in 0..arms[i].body.len {
                    collectIdentsStmt(cg, *arms[i].body[j], &mut out)
                }
            }
        }
        HStmt.UnsafeBlock(body) => {
            for i in 0..body.len {
                collectIdentsStmt(cg, *body[i], &mut out)
            }
        }
        HStmt.ForRange(varName, varTy, startE, endE, body, invariants) => {
            collectIdentsHExpr(cg, *startE, &mut out)
            collectIdentsHExpr(cg, *endE, &mut out)
            for i in 0..body.len {
                collectIdentsStmt(cg, *body[i], &mut out)
            }
        }
        HStmt.ForEach(varName, varName2, varTy, varTy2, iterable, kind, body, invariants) => {
            collectIdentsHExpr(cg, *iterable, &mut out)
            for i in 0..body.len {
                collectIdentsStmt(cg, *body[i], &mut out)
            }
        }
        HStmt.ForIterator(varName, varTy, iterable, nextMethod, resultEnum, body, invariants, okVariant) => {
            collectIdentsHExpr(cg, *iterable, &mut out)
            for i in 0..body.len {
                collectIdentsStmt(cg, *body[i], &mut out)
            }
        }
        HStmt.ForStrView(varName, varName2, varTy, src, sep, mode, body, invariants) => {
            collectIdentsHExpr(cg, *src, &mut out)
            match sep {
                Option.Some(sx) => {
                    collectIdentsHExpr(cg, *sx, &mut out)
                }
                Option.None => {
                }
            }
            for i in 0..body.len {
                collectIdentsStmt(cg, *body[i], &mut out)
            }
        }
        // No idents to collect — exhaustive on purpose, same reason as
        // collectIdentsExpr's literal arms.
        HStmt.Break => {
        }
        HStmt.Continue => {
        }
    }
}

// The bridge, for the read-only pre-scans: a lowered node has no AST to walk, and the two
// nodes lowering builds itself (an `@iter` delegate read) carry their receiver underneath.
fn collectIdentsHExpr(cg: &Cgen, n: &HExprNode, out: &mut Vec<string>) {
    match n.kind {
        HExpr.Unlowered(e) => {
            collectIdentsExpr(cg, *e, &mut out)
        }
        HExpr.FieldAccess(obj, field, isRefRead) => {
            collectIdentsHExpr(cg, *obj, &mut out)
        }
        _ => {
            hexprAbort(n, "expression in a capture pre-scan")
        }
    }
}

// Free variables of a closure body: referenced idents that live in the enclosing
// scope and aren't the closure's own params. By-reference capture (env holds the
// address of each), which is sound because these closures don't escape their call.
pub fn closureCaptures(cg: &Cgen, params: &Vec<Param>, body: &Vec<Heap<HStmt>>, locs: &Vec<Local>): Vec<Local> {
    var idents: Vec<string> = Vec.new()
    for i in 0..body.len {
        collectIdentsStmt(cg, *body[i], &mut idents)
    }
    var caps: Vec<Local> = Vec.new()
    var seen: Vec<string> = Vec.new()
    for i in 0..idents.len {
        let nm = idents[i].clone()
        var skip = false
        for pj in 0..params.len {
            if params[pj].name == nm {
                skip = true
            }
        }
        if skip {
            continue
        }
        if !hasLocal(locs, nm) {
            continue
        }
        var dup = false
        for sj in 0..seen.len {
            if seen[sj] == nm {
                dup = true
            }
        }
        if dup {
            continue
        }
        seen.push(nm.clone())
        caps.push(findLocal(locs, nm))
    }
    return caps
}

// Slot 0 of every closure environment is its drop glue, and captures start at 1.
// src-milo does not emit glue yet, so it stores NULL there -- but the slot itself is
// not optional: std/runtime reads slot 0 and calls it, and an env without the header
// hands it the first CAPTURE to call as a function pointer. That crashed every
// milo-self-compiled program that spawned a task or a detached thread, with no output
// at all. A null header means the runtime falls back to free()ing the block, which is
// what src-milo did before and still leaks the captures -- a leak, not a jump to
// garbage, and it keeps both compilers on ONE environment layout.
pub fn closureEnvTy(caps: &Vec<Local>): string {
    if caps.len == 0 {
        return "{}"
    }
    var ty = "{ ptr"
    for i in 0..caps.len {
        ty = ty + ", ptr"
    }
    return ty + " }"
}

// A move closure's env holds COPIES of the captured values (by-value), so it can
// outlive the spawning frame (e.g. run on another thread). By-ref env holds ptrs.
pub fn closureMoveEnvTy(caps: &Vec<Local>): string {
    if caps.len == 0 {
        return "{}"
    }
    var ty = "{ ptr"
    for i in 0..caps.len {
        ty = ty + ", " + llType(caps[i].ty)
    }
    return ty + " }"
}

// `return <name>` escapes whatever closure literal `name` was bound to earlier in
// this same body — that closure must own its captures (heap, not a pointer into
// this frame) same as a directly-returned closure literal. Recurses into every
// nested block a Return can hide in; codegen is a single forward pass over a
// function's statements, so this pre-scan is what lets the EARLIER `let f = ...`
// see the promotion before it emits the closure's env.
pub fn collectReturnEscapedIdentsInto(body: &Vec<Heap<HStmt>>, out: &mut Vec<string>) {
    for i in 0..body.len {
        match *body[i] {
            HStmt.Return(value, retType) => {
                match value {
                    Option.Some(hv) => {
                        match (*hv).kind {
                            HExpr.Unlowered(av) => {
                                match (*av).kind {
                                    Expr.Ident(n) => {
                                        out.push(n.clone())
                                    }
                                    _ => {
                                    }
                                }
                            }
                            _ => {
                            }
                        }
                    }
                    Option.None => {
                    }
                }
            }
            HStmt.If(cond, thenBody, elseBody) => {
                collectReturnEscapedIdentsInto(thenBody, &mut out)
                match elseBody {
                    Option.Some(eb) => {
                        collectReturnEscapedIdentsInto(eb, &mut out)
                    }
                    Option.None => {
                    }
                }
            }
            HStmt.While(cond, wbody, invariants) => {
                collectReturnEscapedIdentsInto(wbody, &mut out)
            }
            HStmt.Match(subject, arms, enumName, isRef) => {
                for ai in 0..arms.len {
                    collectReturnEscapedIdentsInto(arms[ai].body, &mut out)
                }
            }
            HStmt.UnsafeBlock(ubody) => {
                collectReturnEscapedIdentsInto(ubody, &mut out)
            }
            HStmt.ForRange(varName, varTy, startE, endE, fbody, invariants) => {
                collectReturnEscapedIdentsInto(fbody, &mut out)
            }
            HStmt.ForEach(varName, varName2, varTy, varTy2, iterable, kind, fbody, invariants) => {
                collectReturnEscapedIdentsInto(fbody, &mut out)
            }
            HStmt.ForIterator(varName, varTy, iterable, nextMethod, resultEnum, fbody, invariants, okVariant) => {
                collectReturnEscapedIdentsInto(fbody, &mut out)
            }
            HStmt.ForStrView(varName, varName2, varTy, src, sep, mode, fbody, invariants) => {
                collectReturnEscapedIdentsInto(fbody, &mut out)
            }
            _ => {
            }
        }
    }
}

pub fn returnEscapedIdents(body: &Vec<Heap<HStmt>>): Vec<string> {
    var out: Vec<string> = Vec.new()
    collectReturnEscapedIdentsInto(body, &mut out)
    return out
}

// The Milo source-syntax type name of a push argument, when it's cheap to read off
// the AST without evaluating anything (a literal, or a concrete struct literal's own
// name). Anything else (an Ident, a call, ...) returns "" — the pre-scan below just
// skips that push and leaves the Vec's element type to the existing i64 default,
// which is always safe: it never disagrees with what the checker already accepted
// (checker/expr.milo's push-on-unknown inference has this exact same blind spot).
pub fn pushArgStaticTy(e: &ExprNode): string {
    match e.kind {
        Expr.IntLit(n) => {
            return "i64"
        }
        Expr.FloatLit(f) => {
            return "f64"
        }
        Expr.BoolLit(b) => {
            return "bool"
        }
        Expr.StringLit(v) => {
            return "string"
        }
        Expr.StructLit(name, fields) => {
            return name.clone()
        }
        // `v.push(-1)` is a negation applied to a literal, not a literal — and a
        // sentinel-fill loop (`for _ in 0..n { v.push(-1) }`) is the single most
        // common way an un-annotated Vec gets its element type in std. Missing it
        // left the Vec <unknown> and broke four std/deflate consumers. Whatever
        // shapes this accepts, checker/expr.milo's push-on-unknown gate must
        // accept exactly the same set — see the comment there.
        Expr.UnaryOp(op, operand) => {
            if op == "-" {
                return pushArgStaticTy(*operand)
            }
            return ""
        }
        _ => {
            return ""
        }
    }
}

// `var v = Vec.new()` / `Vec.withCapacity(n)` with no type annotation carries no
// element type yet — take it from the first `v.push(x)` found anywhere later in this
// body, same rule the checker already applies (checker/expr.milo checkMethodCall's
// push-on-unknown branch). Recurses into every nested block a push could hide in,
// same shape as collectReturnEscapedIdentsInto above and for the same reason: this
// is a single forward pass, so the LetDecl/VarDecl needs the answer before it's seen
// the push that supplies it.
pub fn collectVecPushHintsInto(body: &Vec<Heap<HStmt>>, out: &mut HashMap<string, string>) {
    for i in 0..body.len {
        match *body[i] {
            HStmt.ExprStmt(e) => {
                match (*e).kind {
                    HExpr.Unlowered(av) => {
                        match (*av).kind {
                            Expr.MethodCall(object, method, args) => {
                                if method == "push" && args.len == 1 {
                                    match (*object).kind {
                                        Expr.Ident(vname) => {
                                            if !out.contains(vname) {
                                                let et = pushArgStaticTy(*args[0])
                                                if et.len > 0 {
                                                    out.insert(vname.clone(), et)
                                                }
                                            }
                                        }
                                        _ => {
                                        }
                                    }
                                }
                            }
                            _ => {
                            }
                        }
                    }
                    _ => {
                    }
                }
            }
            HStmt.If(cond, thenBody, elseBody) => {
                collectVecPushHintsInto(thenBody, &mut out)
                match elseBody {
                    Option.Some(eb) => {
                        collectVecPushHintsInto(eb, &mut out)
                    }
                    Option.None => {
                    }
                }
            }
            HStmt.While(cond, wbody, invariants) => {
                collectVecPushHintsInto(wbody, &mut out)
            }
            HStmt.Match(subject, arms, enumName, isRef) => {
                for ai in 0..arms.len {
                    collectVecPushHintsInto(arms[ai].body, &mut out)
                }
            }
            HStmt.UnsafeBlock(ubody) => {
                collectVecPushHintsInto(ubody, &mut out)
            }
            HStmt.ForRange(varName, varTy, startE, endE, fbody, invariants) => {
                collectVecPushHintsInto(fbody, &mut out)
            }
            HStmt.ForEach(varName, varName2, varTy, varTy2, iterable, kind, fbody, invariants) => {
                collectVecPushHintsInto(fbody, &mut out)
            }
            HStmt.ForIterator(varName, varTy, iterable, nextMethod, resultEnum, fbody, invariants, okVariant) => {
                collectVecPushHintsInto(fbody, &mut out)
            }
            HStmt.ForStrView(varName, varName2, varTy, src, sep, mode, fbody, invariants) => {
                collectVecPushHintsInto(fbody, &mut out)
            }
            _ => {
            }
        }
    }
}

pub fn inferVecPushHints(body: &Vec<Heap<HStmt>>): HashMap<string, string> {
    var out: HashMap<string, string> = HashMap.new()
    collectVecPushHintsInto(body, &mut out)
    return out
}

// A manual key/value rebuild rather than `.clone()` — mirrors snapshotMoves/
// restoreMoves in checker/state.milo, the existing convention for saving a
// HashMap<string, _> across a nested codegen scope in this codebase.
pub fn cloneStrMap(m: &HashMap<string, string>): HashMap<string, string> {
    var out: HashMap<string, string> = HashMap.new()
    for k, v in m {
        out.insert(k.clone(), v.clone())
    }
    return out
}

// hintTy for an unannotated `let`/`var` whose value is `Vec.new()`/`Vec.withCapacity`:
// the pre-scanned element type if one was found, else "" (existing i64 default).
pub fn vecNewHint(cg: &Cgen, name: &string, value: &ExprNode): string {
    match value.kind {
        Expr.EnumLit(enumName, variant, args) => {
            if enumName == "Vec" && (variant == "new" || variant == "withCapacity") {
                if cg.vecPushHints.contains(name) {
                    return "Vec<" + cg.vecPushHints.get(name)! + ">"
                }
            }
        }
        _ => {
        }
    }
    return ""
}

// Names this expression hands to someone else BY VALUE — a bare identifier in an
// owning argument position (call/method arg, struct or enum payload). Used to
// decide whether a closure literal must move-capture: a closure that passes a
// captured heap value on (`b.items.push(s)`) transfers ownership out of the
// enclosing frame, and if the capture stayed by-reference that frame's scope drop
// would free a buffer the callee now owns. The oracle gets this from the
// checker's isMove bit; with no HIR to carry one, it is re-derived here.
//
// Deliberately POSITIVE evidence: finding nothing means "no promotion", i.e. the
// old by-reference capture. An unhandled shape can only cost a leak, never a
// use-after-free. The arms are exhaustive for the same reason collectIdentsExpr's
// are — a new Expr variant should fail to compile until it is traversed.
fn collectMovedOutIdentsExpr(cg: &Cgen, e: &ExprNode, out: &mut Vec<string>) {
    match e.kind {
        Expr.Call(name, args, targs) => {
            for i in 0..args.len {
                pushIfBareIdent(*args[i], &mut out)
                collectMovedOutIdentsExpr(cg, *args[i], &mut out)
            }
        }
        Expr.MethodCall(obj, m, args) => {
            collectMovedOutIdentsExpr(cg, *obj, &mut out)
            for i in 0..args.len {
                pushIfBareIdent(*args[i], &mut out)
                collectMovedOutIdentsExpr(cg, *args[i], &mut out)
            }
        }
        Expr.StructLit(name, fields) => {
            for i in 0..fields.len {
                pushIfBareIdent(*fields[i].value, &mut out)
                collectMovedOutIdentsExpr(cg, *fields[i].value, &mut out)
            }
        }
        Expr.JsonObject(fields) => {
            for i in 0..fields.len {
                pushIfBareIdent(*fields[i].value, &mut out)
                collectMovedOutIdentsExpr(cg, *fields[i].value, &mut out)
            }
        }
        Expr.EnumLit(en, va, args) => {
            for i in 0..args.len {
                pushIfBareIdent(*args[i], &mut out)
                collectMovedOutIdentsExpr(cg, *args[i], &mut out)
            }
        }
        Expr.BinOp(op, l, r) => {
            collectMovedOutIdentsExpr(cg, *l, &mut out)
            collectMovedOutIdentsExpr(cg, *r, &mut out)
        }
        Expr.UnaryOp(op, x) => {
            collectMovedOutIdentsExpr(cg, *x, &mut out)
        }
        Expr.FieldAccess(obj, field) => {
            collectMovedOutIdentsExpr(cg, *obj, &mut out)
        }
        Expr.ArrayLit(elems) => {
            for i in 0..elems.len {
                pushIfBareIdent(*elems[i], &mut out)
                collectMovedOutIdentsExpr(cg, *elems[i], &mut out)
            }
        }
        Expr.ArrayRepeat(x, n) => {
            collectMovedOutIdentsExpr(cg, *x, &mut out)
        }
        Expr.IndexAccess(obj, idx) => {
            collectMovedOutIdentsExpr(cg, *obj, &mut out)
            collectMovedOutIdentsExpr(cg, *idx, &mut out)
        }
        Expr.Unwrap(x) => {
            collectMovedOutIdentsExpr(cg, *x, &mut out)
        }
        Expr.Propagate(x) => {
            collectMovedOutIdentsExpr(cg, *x, &mut out)
        }
        Expr.DefaultValue(x, d) => {
            collectMovedOutIdentsExpr(cg, *x, &mut out)
            collectMovedOutIdentsExpr(cg, *d, &mut out)
        }
        Expr.CastExpr(x, ty) => {
            collectMovedOutIdentsExpr(cg, *x, &mut out)
        }
        // Bodies were lifted at lowering — follow the id, same as collectIdentsExpr.
        Expr.Closure(params, rt, body, isMove) => {
            collectMovedOutIdentsBlocks(cg, e.id, 1, &mut out)
        }
        Expr.RangeExpr(a, b) => {
            collectMovedOutIdentsExpr(cg, *a, &mut out)
            collectMovedOutIdentsExpr(cg, *b, &mut out)
        }
        Expr.IsExpr(x, pat) => {
            collectMovedOutIdentsExpr(cg, *x, &mut out)
        }
        Expr.IfExpr(c, thenBody, elseBody) => {
            collectMovedOutIdentsExpr(cg, *c, &mut out)
            collectMovedOutIdentsBlocks(cg, e.id, 2, &mut out)
        }
        Expr.MatchExpr(subject, arms) => {
            collectMovedOutIdentsExpr(cg, *subject, &mut out)
            let base = blockBase(cg, e.id, "match-expression")
            for ai in 0..cg.stmtBlocks[base].arms.len {
                for j in 0..cg.stmtBlocks[base].arms[ai].body.len {
                    collectMovedOutIdentsStmt(cg, *cg.stmtBlocks[base].arms[ai].body[j], &mut out)
                }
            }
        }
        Expr.Ident(name) => {
        }
        Expr.IntLit(n) => {
        }
        Expr.FloatLit(f) => {
        }
        Expr.BoolLit(b) => {
        }
        Expr.StringLit(s) => {
        }
        Expr.CharLit(c) => {
        }
    }
}

fn collectMovedOutIdentsBlocks(cg: &Cgen, id: u32, count: i64, out: &mut Vec<string>) {
    let base = blockBase(cg, id, "expression")
    for b in 0..count {
        for j in 0..cg.stmtBlocks[base + b].stmts.len {
            collectMovedOutIdentsStmt(cg, *cg.stmtBlocks[base + b].stmts[j], &mut out)
        }
    }
}

fn pushIfBareIdent(e: &ExprNode, out: &mut Vec<string>) {
    match e.kind {
        Expr.Ident(name) => {
            out.push(name.clone())
        }
        _ => {
        }
    }
}

fn pushIfBareIdentH(n: &HExprNode, out: &mut Vec<string>) {
    match n.kind {
        HExpr.Unlowered(e) => {
            pushIfBareIdent(*e, &mut out)
        }
        _ => {
        }
    }
}

fn collectMovedOutIdentsHExpr(cg: &Cgen, n: &HExprNode, out: &mut Vec<string>) {
    match n.kind {
        HExpr.Unlowered(e) => {
            collectMovedOutIdentsExpr(cg, *e, &mut out)
        }
        HExpr.FieldAccess(obj, field, isRefRead) => {
            collectMovedOutIdentsHExpr(cg, *obj, &mut out)
        }
        _ => {
            hexprAbort(n, "expression in a move-out pre-scan")
        }
    }
}

fn collectMovedOutIdentsStmt(cg: &Cgen, s: &HStmt, out: &mut Vec<string>) {
    match s {
        HStmt.Let(name, ty, value, mutable) => {
            pushIfBareIdentH(*value, &mut out)
            collectMovedOutIdentsHExpr(cg, *value, &mut out)
        }
        HStmt.Assign(target, value, isInit) => {
            pushIfBareIdentH(*value, &mut out)
            collectMovedOutIdentsHExpr(cg, *value, &mut out)
        }
        HStmt.Return(value, retType) => {
            match value {
                Option.Some(e) => {
                    pushIfBareIdentH(*e, &mut out)
                    collectMovedOutIdentsHExpr(cg, *e, &mut out)
                }
                Option.None => {
                }
            }
        }
        HStmt.ExprStmt(e) => {
            collectMovedOutIdentsHExpr(cg, *e, &mut out)
        }
        HStmt.If(cond, thenB, elseB) => {
            collectMovedOutIdentsHExpr(cg, *cond, &mut out)
            for i in 0..thenB.len {
                collectMovedOutIdentsStmt(cg, *thenB[i], &mut out)
            }
            match elseB {
                Option.Some(eb) => {
                    for i in 0..eb.len {
                        collectMovedOutIdentsStmt(cg, *eb[i], &mut out)
                    }
                }
                Option.None => {
                }
            }
        }
        HStmt.While(cond, body, invariants) => {
            collectMovedOutIdentsHExpr(cg, *cond, &mut out)
            for i in 0..body.len {
                collectMovedOutIdentsStmt(cg, *body[i], &mut out)
            }
        }
        HStmt.ForRange(varName, varTy, startE, endE, body, invariants) => {
            collectMovedOutIdentsHExpr(cg, *startE, &mut out)
            collectMovedOutIdentsHExpr(cg, *endE, &mut out)
            for i in 0..body.len {
                collectMovedOutIdentsStmt(cg, *body[i], &mut out)
            }
        }
        HStmt.ForEach(varName, varName2, varTy, varTy2, iterable, kind, body, invariants) => {
            collectMovedOutIdentsHExpr(cg, *iterable, &mut out)
            for i in 0..body.len {
                collectMovedOutIdentsStmt(cg, *body[i], &mut out)
            }
        }
        HStmt.ForIterator(varName, varTy, iterable, nextMethod, resultEnum, body, invariants, okVariant) => {
            collectMovedOutIdentsHExpr(cg, *iterable, &mut out)
            for i in 0..body.len {
                collectMovedOutIdentsStmt(cg, *body[i], &mut out)
            }
        }
        HStmt.ForStrView(varName, varName2, varTy, src, sep, mode, body, invariants) => {
            collectMovedOutIdentsHExpr(cg, *src, &mut out)
            for i in 0..body.len {
                collectMovedOutIdentsStmt(cg, *body[i], &mut out)
            }
        }
        HStmt.Match(subj, arms, enumName, isRef) => {
            collectMovedOutIdentsHExpr(cg, *subj, &mut out)
            for i in 0..arms.len {
                for j in 0..arms[i].body.len {
                    collectMovedOutIdentsStmt(cg, *arms[i].body[j], &mut out)
                }
            }
        }
        HStmt.UnsafeBlock(body) => {
            for i in 0..body.len {
                collectMovedOutIdentsStmt(cg, *body[i], &mut out)
            }
        }
        _ => {
        }
    }
}

// A closure literal in an owning argument position that hands one of its own
// captures on by value must move-capture (heap-own) them: by-reference captures
// leave the value owned by a frame whose scope drop will free it out from under
// whoever the closure gave it to. Mirrors the oracle's checker rule that auto-moves
// a closure literal passed to an owned `fn` param, minus the mutated-capture
// exemption — the positive move-out evidence below already excludes the
// mutate-in-place shape that needs write-back.
//
// Answers with a bool rather than a rebuilt node: the promotion only flips the
// capture mode, and rebuilding the node used to clone it, which mints a fresh id and
// orphans the body lowering lifted under the old one.
pub fn autoMoveClosureArg(cg: &Cgen, nodeId: u32, params: &Vec<Param>, locs: &Vec<Local>): bool {
    let base = blockBase(cg, nodeId, "closure")
    var moved: Vec<string> = Vec.new()
    for i in 0..cg.stmtBlocks[base].stmts.len {
        collectMovedOutIdentsStmt(cg, *cg.stmtBlocks[base].stmts[i], &mut moved)
    }
    let caps = closureCaptures(cg, params, cg.stmtBlocks[base].stmts, locs)
    for ci in 0..caps.len {
        if caps[ci].isRef {
            continue
        }
        if !moved.contains(caps[ci].name) {
            continue
        }
        return true
    }
    return false
}

// A non-move closure literal rebuilt with `move` set, or None when there is nothing to
// promote. The rebuilt node KEEPS its id: its body was lifted into the block arena under
// that id, and mkExpr/clone() both mint a fresh one, which would orphan it.
pub fn forcedMoveClosure(value: &ExprNode): Option<Heap<ExprNode>> {
    match value.kind {
        Expr.Closure(params, retType, body, isMove) => {
            if isMove {
                return Option.None
            }
            return Option.Some(Heap(ExprNode {
                id: value.id,
                kind: Expr.Closure(cloneParams(params), cloneOptType(retType), cloneStmts(body), true),
                span: cloneSpan(value.span),
            }))
        }
        _ => {
            return Option.None
        }
    }
}

// If `name` is a local this body's pre-scan found escaping via `return name`, and
// `value` is a non-move closure literal, promote it. None means "emit it unchanged".
pub fn forceMoveIfEscaping(cg: &Cgen, name: &string, value: &ExprNode): Option<Heap<ExprNode>> {
    if !cg.forceMoveClosures.contains(name) {
        return Option.None
    }
    return forcedMoveClosure(value)
}

// Lift a closure to a top-level `@__closure_N(ptr %__env, <ptr params>)` and return
// a %Closure { fnptr, env }. Uniform ABI: params AND captures arrive by pointer.
pub fn genClosure(cg: &mut Cgen, nodeId: u32, params: &Vec<Param>, retType: &Option<MiloType>, isMove: bool, locs: &Vec<Local>, sigs: &Vec<CgFnSig>): Val {
    let cname = "__closure_" + cg.closureId.toString()
    cg.closureId = cg.closureId + 1

    // Snapshot + clear the caller's param-type hint (if any) right away: it's
    // meant for THIS closure's own unannotated params only, and must not leak
    // into a closure literal nested in this one's body.
    let paramHints = cg.closureParamHint.clone()
    cg.closureParamHint = Vec.new()
    let retHint = cg.closureRetHint.clone()
    cg.closureRetHint = ""

    var annotated = false
    var retTyStr = "void"
    match retType {
        Option.Some(rt) => {
            retTyStr = resolveAstTy(cg, rt)
            annotated = true
        }
        Option.None => {
        }
    }
    // No AST annotation, but the caller knows the exact expected type (e.g.
    // Option<T>.orElse's callback must return the SAME Option<T>) — treat it as
    // if annotated so the body walks against a real type, not the unresolvable
    // "__closureinfer__" sentinel.
    if !annotated && retHint.len > 0 {
        retTyStr = resolveTyStr(cg, retHint)
        annotated = true
    }

    // The body was lifted out of the AST at lowering; take it, walk it, put it back.
    let bodyIdx = blockBase(cg, nodeId, "closure")
    var body = takeBlock(&mut cg, bodyIdx)

    let caps = closureCaptures(cg, params, body, locs)
    // move closures heap-copy their captures (survive an escaping/threaded call);
    // by-ref closures point into the enclosing frame.
    var envTy = closureEnvTy(caps)
    if isMove {
        envTy = closureMoveEnvTy(caps)
    }

    // swap the emit buffer so the lifted define lands at module scope, not spliced
    // into the enclosing function we're mid-emitting. The `define` header needs the
    // return type up front, but an unannotated closure only learns it from its
    // `return` — so emit the body first, then prepend the header.
    let savedBody = cg.body.clone()
    // The lifted closure is a whole function emitted mid-stream; its emitLabel
    // calls would otherwise leave cg.curBlock naming a block INSIDE the closure,
    // and the interrupted caller then records that label as a phi predecessor.
    let savedBlock = cg.curBlock.clone()
    let savedTemp = cg.temp
    let savedLabel = cg.label
    let savedRet = cg.curRetTy.clone()
    let savedRetRange = cg.curRetRange.clone()
    let savedClosRet = cg.closureRetTy.clone()
    let savedForceMove = cg.forceMoveClosures.clone()
    let savedVecPushHints = cloneStrMap(cg.vecPushHints)
    // A closure is lifted to its OWN top-level function, so it must not land in the
    // enclosing function's buffer. Save and clear both, or `emit` writes the closure body
    // into the caller's fnBuf and the lifted function comes out with an empty body.
    let savedFnBuf = cg.fnBuf.clone()
    let savedInFn = cg.inFn
    cg.inFn = false
    cg.fnBuf = ""
    cg.body = ""
    cg.temp = 0
    cg.label = 0
    cg.curRetTy = retTyStr.clone()
    // a closure body is not the enclosing fn: its returns answer to no declared bound
    cg.curRetRange = noRange()
    cg.closureRetTy = "void"
    // this closure's OWN body gets its own escape pre-scan — a closure that itself
    // returns a locally-bound closure needs the same treatment, and it must not see
    // the enclosing function's set (a same-named local would be a false hit).
    let escaped = returnEscapedIdents(body)
    cg.forceMoveClosures = escaped
    let pushHints = inferVecPushHints(body)
    cg.vecPushHints = pushHints

    emit(&mut cg, "entry.bb:\n")
    var clocs: Vec<Local> = Vec.new()
    for ci in 0..caps.len {
        let gp = nextTemp(&mut cg)
        emit(&mut cg, "  " + gp + " = getelementptr " + envTy + ", ptr %__env, i32 0, i32 " + (ci + 1).toString() + "\n")
        if isMove {
            // env slot holds the value directly — gp IS the local's storage
            clocs.push(Local {
                name: caps[ci].name.clone(), ty: caps[ci].ty.clone(), addr: gp, isRef: true, isArr: false, range: noRange()
            })
        } else {
            // env slot holds a pointer to the original variable
            let ca = nextTemp(&mut cg)
            emit(&mut cg, "  " + ca + " = load ptr, ptr " + gp + "\n")
            clocs.push(Local {
                name: caps[ci].name.clone(), ty: caps[ci].ty.clone(), addr: ca, isRef: true, isArr: false, range: noRange()
            })
        }
    }
    for pj in 0..params.len {
        var pty = resolveAstTy(cg, params[pj].ty)
        // Unannotated param, no inferred type from the AST (empty string) — fall
        // back to the caller's hint (see closureParamHint's doc comment).
        if pty.len == 0 && pj < paramHints.len && paramHints[pj].len > 0 {
            pty = resolveTyStr(cg, paramHints[pj].clone())
        }
        clocs.push(Local {
            name: params[pj].name.clone(), ty: pty, addr: "%" + params[pj].name.clone(), isRef: true, isArr: false, range: noRange()
        })
    }

    // annotated → gen against the annotation; unannotated → sentinel so `return`
    // uses (and records) the value's own type.
    var walkRet = retTyStr.clone()
    if !annotated {
        walkRet = "__closureinfer__"
    }
    var term = false
    for si in 0..body.len {
        if genStmt(&mut cg, *body[si], &mut clocs, sigs, walkRet) {
            term = true
        }
    }
    if !annotated {
        retTyStr = cg.closureRetTy.clone()
    }
    let retLl = llType(retTyStr)
    if !term {
        if retLl == "void" {
            emit(&mut cg, "  ret void\n")
        } else {
            emit(&mut cg, "  ret " + retLl + " zeroinitializer\n")
        }
    }

    // now that retTyStr is settled, prepend the define header to the emitted body.
    var hdr = "define " + retLl + " @" + cname + "(ptr %__env"
    for pi in 0..params.len {
        hdr = hdr + ", ptr %" + params[pi].name.clone()
    }
    hdr = hdr + ") {\n"
    let closureIR = hdr + cg.body.clone() + "}\n\n"
    cg.body = savedBody
    cg.fnBuf = savedFnBuf
    cg.inFn = savedInFn
    cg.temp = savedTemp
    cg.label = savedLabel
    cg.curRetTy = savedRet
    cg.curRetRange = savedRetRange
    cg.closureRetTy = savedClosRet
    cg.curBlock = savedBlock
    cg.forceMoveClosures = savedForceMove
    cg.vecPushHints = savedVecPushHints
    cg.globals = cg.globals + closureIR
    putBlock(&mut cg, bodyIdx, body)

    // build the env at the call site, then the { fnptr, env } pair
    var envVal = "null"
    if caps.len > 0 {
        var ea = ""
        if isMove {
            // heap-allocate and COPY each captured value in (outlives this frame)
            ensureMalloc(&mut cg)
            let szp = nextTemp(&mut cg)
            emit(&mut cg, "  " + szp + " = getelementptr " + envTy + ", ptr null, i32 1\n")
            let szi = nextTemp(&mut cg)
            emit(&mut cg, "  " + szi + " = ptrtoint ptr " + szp + " to i64\n")
            ea = nextTemp(&mut cg)
            emit(&mut cg, "  " + ea + " = call ptr @malloc(i64 " + szi + ")\n")
            // slot 0: this env's drop glue. src-milo emits none, so null tells
            // std/runtime to free the block rather than call through it.
            let hdr0 = nextTemp(&mut cg)
            emit(&mut cg, "  " + hdr0 + " = getelementptr " + envTy + ", ptr " + ea + ", i32 0, i32 0\n")
            emit(&mut cg, "  store ptr null, ptr " + hdr0 + "\n")
            for ci in 0..caps.len {
                let cll = llType(caps[ci].ty)
                let cv = nextTemp(&mut cg)
                emit(&mut cg, "  " + cv + " = load " + cll + ", ptr " + caps[ci].addr.clone() + "\n")
                let gp = nextTemp(&mut cg)
                emit(&mut cg, "  " + gp + " = getelementptr " + envTy + ", ptr " + ea + ", i32 0, i32 " + (ci + 1).toString() + "\n")
                emit(&mut cg, "  store " + cll + " " + cv + ", ptr " + gp + "\n")
                // The bits now live in TWO places (this local's slot and the env
                // slot just stored above) but ownership was only ever meant to
                // transfer once — same move genOwnedArg performs for a by-value
                // call arg. Without zeroing+recording the source here, whatever
                // later drops this scope's locals (a loop-body end, a fn return)
                // finds the slot still looking "alive" and drops it AGAIN: for a
                // refcounted handle (AtomicI64, Channel, ...) that is an extra
                // decrement/free racing the thread this closure was just handed
                // to, which is exactly what turned battleConcurrency's atomic
                // counter into a silent lost-update generator. A ref capture
                // (isRef) borrows someone else's storage and must not be zeroed.
                if !caps[ci].isRef && cgNeedsDrop(cg, caps[ci].ty) {
                    zeroStore(&mut cg, caps[ci].addr, caps[ci].ty)
                    cg.movedLocalAddrs.push(caps[ci].addr.clone())
                }
            }
        } else {
            ea = nextTemp(&mut cg)
            emit(&mut cg, "  " + ea + " = alloca " + envTy + "\n")
            // slot 0: this env's drop glue. src-milo emits none, so null tells
            // std/runtime to free the block rather than call through it.
            let hdr1 = nextTemp(&mut cg)
            emit(&mut cg, "  " + hdr1 + " = getelementptr " + envTy + ", ptr " + ea + ", i32 0, i32 0\n")
            emit(&mut cg, "  store ptr null, ptr " + hdr1 + "\n")
            for ci in 0..caps.len {
                let gp = nextTemp(&mut cg)
                emit(&mut cg, "  " + gp + " = getelementptr " + envTy + ", ptr " + ea + ", i32 0, i32 " + (ci + 1).toString() + "\n")
                emit(&mut cg, "  store ptr " + caps[ci].addr.clone() + ", ptr " + gp + "\n")
            }
        }
        envVal = ea
    }
    let c0 = nextTemp(&mut cg)
    emit(&mut cg, "  " + c0 + " = insertvalue %Closure undef, ptr @" + cname + ", 0\n")
    let c1 = nextTemp(&mut cg)
    emit(&mut cg, "  " + c1 + " = insertvalue %Closure " + c0 + ", ptr " + envVal + ", 1\n")
    // carry the return type in the surface ty ("Closure:R") so a generic call site
    // can disambiguate which monomorphization to invoke (arenaWith_T_R).
    return Val {
        v: c1, ty: "Closure:" + retTyStr.clone()
    }
}

// Indirect call of a %Closure-typed local: load { fnptr, env }, pass every arg BY
// POINTER (uniform ABI). retHint supplies R since "fn" drops the return type.
pub fn genClosureCall(cg: &mut Cgen, lc: &Local, args: &Vec<Heap<ExprNode>>, locs: &Vec<Local>, sigs: &Vec<CgFnSig>, retHint: &string): Val {
    let clv = nextTemp(&mut cg)
    emit(&mut cg, "  " + clv + " = load %Closure, ptr " + lc.addr.clone() + "\n")
    let fp = nextTemp(&mut cg)
    emit(&mut cg, "  " + fp + " = extractvalue %Closure " + clv + ", 0\n")
    let env = nextTemp(&mut cg)
    emit(&mut cg, "  " + env + " = extractvalue %Closure " + clv + ", 1\n")

    var argStr = "ptr " + env
    for i in 0..args.len {
        let alv = genLvalue(&mut cg, *args[i], locs, sigs)
        argStr = argStr + ", ptr " + alv.v
    }
    // the closure param's own type carries R ("fn:Response" / "Closure:Response");
    // it's the declared return type, so prefer it over the (often empty) call hint.
    var retTyStr = ""
    if lc.ty.len > 3 && lc.ty[0] == 102 && lc.ty[1] == 110 && lc.ty[2] == 58 {
        retTyStr = lc.ty[3..lc.ty.len].clone()
    } else if lc.ty.len > 8 && lc.ty[0] == 67 && lc.ty[7] == 58 {
        retTyStr = lc.ty[8..lc.ty.len].clone()
    }
    if retTyStr.len == 0 {
        retTyStr = retHint.clone()
    }
    if retTyStr.len == 0 {
        // The closure's own type carried no return type and no hint supplied one. i64 does
        // not make the call return an integer — it makes this site READ whatever came back
        // as one, so a returned String arrives as a pointer-sized integer and every use of
        // it is garbage. The twin of this site in genFieldClosureCall was failed closed
        // first; this one was missed until a census went looking for the shape rather than
        // the symbol.
        eprint("internal error: closure call has no recoverable return type (closure type '" + lc.ty.clone() + "'), so its result cannot be typed")
        unsafe {
            exit(1)
        }
    }
    let retLl = llType(resolveTyStr(cg, retTyStr))
    let retTyResolved = resolveTyStr(cg, retTyStr)
    if retLl == "void" {
        emit(&mut cg, "  call void " + fp + "(" + argStr + ")\n")
        return Val {
            v: "0", ty: "void"
        }
    }
    let t = nextTemp(&mut cg)
    emit(&mut cg, "  " + t + " = call " + retLl + " " + fp + "(" + argStr + ")\n")
    return Val {
        v: t, ty: retTyResolved
    }
}
