// Recursive drop-glue emission: frees the heap owned by a value when it goes out
// of scope, is reassigned, or is redeclared. Mirrors the TS compiler's
// emitDropValue/ensureDropHelper (src/codegen.ts). Without this the self-host
// leaks every builtin heap allocation (see docs/self-hosting.md).
//
// Safety rests on move-out zeroing (genOwnedArg in expr.milo): a value moved by
// value has its source slot zeroed, so a later drop sees cap==0 / null and is a
// no-op. Every drop below is guarded by that runtime check, so dropping a
// moved-from or never-initialized slot is always safe.
from "src-milo/ast.milo" import {
    Expr
}
from "src-milo/codegen/types.milo" import {
    Cgen, Val, Local, CgFnSig, FieldInfo, CgVariantInfo,
    emit, emitG, emitLabel, nextTemp, nextLabel, llType, isVecTy, unwrapVec, isHashMapTy,
    unwrapHeap, stripPercent, resolveTyStr, lookupFieldIndex, lookupFieldType,
    lookupVariantPayload, hasLocal, findLocal, ensureFree,
    isInlineArrTy, inlineArrElem, addrWasMoved,
}

// A type owns heap that must be freed. HashMap is deferred to a later slice
// (its entries leak for now) — everything else that carries a heap buffer is
// covered: string, Vec (data + droppable elements), Heap<T>, and any struct or
// enum transitively containing one. Recursion terminates because self-reference
// only ever goes through Heap<T> (a bare ptr), which returns true without
// recursing into its pointee.
pub fn cgNeedsDrop(cg: &Cgen, tyRaw: &string): bool {
    let ty = resolveTyStr(cg, tyRaw)
    // Inline struct-field array (see isInlineArrTy): its bytes live inside the
    // enclosing struct, not a separate heap buffer, so there is nothing here to
    // free. But an element type that itself owns heap (e.g. a hypothetical
    // `[Tracked; 3]`) would need each slot dropped individually — unimplemented,
    // so refuse loudly instead of silently leaking/skipping it.
    if isInlineArrTy(ty) {
        if cgNeedsDrop(cg, inlineArrElem(ty)) {
            eprint("codegen: struct field array of a Drop-needing element type is not supported (inline array elements are never dropped)")
            exit(1)
        }
        return false
    }
    if ty == "string" {
        return true
    }
    if isVecTy(ty) {
        return true
    }
    if isHashMapTy(ty) {
        return false
    }
    if unwrapHeap(ty).len > 0 {
        return true
    }
    let raw = stripPercent(ty)
    if cg.fnRets.contains(raw + "$Drop$drop") {
        return true
    }
    if cg.structs.contains(raw) {
        let fields = cg.structs.get(raw)!
        for i in 0..fields.len {
            if cgNeedsDrop(cg, fields[i].ty) {
                return true
            }
        }
        return false
    }
    if cg.enums.contains(raw) {
        let info = cg.enums.get(raw)!
        for vi in 0..info.variants.len {
            for pi in 0..info.variants[vi].payloadTypes.len {
                if cgNeedsDrop(cg, info.variants[vi].payloadTypes[pi]) {
                    return true
                }
            }
        }
        return false
    }
    return false
}

// Zero the slot at `addr` (typed `ty`), so a subsequent drop of it is a no-op.
pub fn zeroStore(cg: &mut Cgen, addr: &string, ty: &string) {
    emit(&mut cg, "  store " + llType(resolveTyStr(cg, ty)) + " zeroinitializer, ptr " + addr.clone() + "\n")
}

// Emit code that drops the value stored at `addr` (a pointer to a value of type
// `tyRaw`). Guarded so a zeroed/uninitialized slot is a safe no-op.
pub fn emitDropValue(cg: &mut Cgen, addr: &string, tyRaw: &string) {
    // This exact slot was already move-zeroed by genOwnedArg. Vec/String/Heap
    // would catch this via their own null/cap check below, but a plain struct
    // with a user `impl Drop` has no such sentinel — it must not run the
    // user's drop() a second time on a value that no longer lives here.
    if addrWasMoved(cg, addr) {
        return
    }
    ensureFree(&mut cg)
    let ty = resolveTyStr(cg, tyRaw)
    if ty == "string" {
        let old = nextTemp(&mut cg)
        emit(&mut cg, "  " + old + " = load %String, ptr " + addr.clone() + "\n")
        let cap = nextTemp(&mut cg)
        emit(&mut cg, "  " + cap + " = extractvalue %String " + old + ", 2\n")
        let owned = nextTemp(&mut cg)
        emit(&mut cg, "  " + owned + " = icmp ugt i64 " + cap + ", 0\n")
        let d = nextLabel(&mut cg, "drop")
        let s = nextLabel(&mut cg, "dropskip")
        emit(&mut cg, "  br i1 " + owned + ", label %" + d + ", label %" + s + "\n")
        emitLabel(&mut cg, d)
        let p = nextTemp(&mut cg)
        emit(&mut cg, "  " + p + " = extractvalue %String " + old + ", 0\n")
        emit(&mut cg, "  call void @free(ptr " + p + ")\n")
        emit(&mut cg, "  br label %" + s + "\n")
        emitLabel(&mut cg, s)
        return
    }
    if isVecTy(ty) {
        let elem = unwrapVec(ty)
        let vv = nextTemp(&mut cg)
        emit(&mut cg, "  " + vv + " = load %Vec, ptr " + addr.clone() + "\n")
        let data = nextTemp(&mut cg)
        emit(&mut cg, "  " + data + " = extractvalue %Vec " + vv + ", 0\n")
        let isnull = nextTemp(&mut cg)
        emit(&mut cg, "  " + isnull + " = icmp eq ptr " + data + ", null\n")
        let d = nextLabel(&mut cg, "vdrop")
        let s = nextLabel(&mut cg, "vskip")
        emit(&mut cg, "  br i1 " + isnull + ", label %" + s + ", label %" + d + "\n")
        emitLabel(&mut cg, d)
        if cgNeedsDrop(cg, elem) {
            let len = nextTemp(&mut cg)
            emit(&mut cg, "  " + len + " = extractvalue %Vec " + vv + ", 1\n")
            let elemLl = llType(resolveTyStr(cg, elem))
            let ia = nextTemp(&mut cg)
            emit(&mut cg, "  " + ia + " = alloca i64\n")
            emit(&mut cg, "  store i64 0, ptr " + ia + "\n")
            let cond = nextLabel(&mut cg, "vdc")
            let body = nextLabel(&mut cg, "vdb")
            let end = nextLabel(&mut cg, "vde")
            emit(&mut cg, "  br label %" + cond + "\n")
            emitLabel(&mut cg, cond)
            let iv = nextTemp(&mut cg)
            emit(&mut cg, "  " + iv + " = load i64, ptr " + ia + "\n")
            let cmp = nextTemp(&mut cg)
            emit(&mut cg, "  " + cmp + " = icmp ult i64 " + iv + ", " + len + "\n")
            emit(&mut cg, "  br i1 " + cmp + ", label %" + body + ", label %" + end + "\n")
            emitLabel(&mut cg, body)
            let ep = nextTemp(&mut cg)
            emit(&mut cg, "  " + ep + " = getelementptr " + elemLl + ", ptr " + data + ", i64 " + iv + "\n")
            emitDropValue(&mut cg, ep, elem)
            let ni = nextTemp(&mut cg)
            emit(&mut cg, "  " + ni + " = add i64 " + iv + ", 1\n")
            emit(&mut cg, "  store i64 " + ni + ", ptr " + ia + "\n")
            emit(&mut cg, "  br label %" + cond + "\n")
            emitLabel(&mut cg, end)
        }
        emit(&mut cg, "  call void @free(ptr " + data + ")\n")
        emit(&mut cg, "  br label %" + s + "\n")
        emitLabel(&mut cg, s)
        return
    }
    let inner = unwrapHeap(ty)
    if inner.len > 0 {
        let hp = nextTemp(&mut cg)
        emit(&mut cg, "  " + hp + " = load ptr, ptr " + addr.clone() + "\n")
        let isnull = nextTemp(&mut cg)
        emit(&mut cg, "  " + isnull + " = icmp eq ptr " + hp + ", null\n")
        let d = nextLabel(&mut cg, "hdrop")
        let s = nextLabel(&mut cg, "hskip")
        emit(&mut cg, "  br i1 " + isnull + ", label %" + s + ", label %" + d + "\n")
        emitLabel(&mut cg, d)
        if cgNeedsDrop(cg, inner) {
            emitDropValue(&mut cg, hp, inner)
        }
        emit(&mut cg, "  call void @free(ptr " + hp + ")\n")
        emit(&mut cg, "  br label %" + s + "\n")
        emitLabel(&mut cg, s)
        return
    }
    let raw = stripPercent(ty)
    // A user `impl Drop` owns its own teardown — call it and stop (matches the
    // pre-existing emitScopeDrops behavior; do not also auto-drop its fields).
    if cg.fnRets.contains(raw + "$Drop$drop") {
        emit(&mut cg, "  call void @" + raw + "$Drop$drop(ptr " + addr.clone() + ")\n")
        return
    }
    if cg.structs.contains(raw) {
        ensureStructDropHelper(&mut cg, raw)
        emit(&mut cg, "  call void @milo.drop.struct." + raw + "(ptr " + addr.clone() + ")\n")
        return
    }
    if cg.enums.contains(raw) {
        ensureEnumDropHelper(&mut cg, raw)
        emit(&mut cg, "  call void @milo.drop.enum." + raw + "(ptr " + addr.clone() + ")\n")
        return
    }
}

// Whether a drop helper of this name has already been emitted this module.
pub fn dropHelperEmitted(cg: &Cgen, hn: &string): bool {
    for i in 0..cg.dropHelpers.len {
        if cg.dropHelpers[i] == hn {
            return true
        }
    }
    return false
}

// Emit `define void @milo.drop.struct.NAME(ptr %self)` — drops each droppable
// field in declaration order. Reuses genClosure's body-buffer save/swap so the
// helper is emitted as its own top-level function into cg.globals.
pub fn ensureStructDropHelper(cg: &mut Cgen, name: &string) {
    let hn = "milo.drop.struct." + name.clone()
    if dropHelperEmitted(cg, hn) {
        return
    }
    cg.dropHelpers.push(hn.clone()) // mark BEFORE emit to break cycles
    let savedBody = cg.body.clone()
    // The helper is a whole function emitted mid-stream: its emitLabel calls would
    // otherwise leave cg.curBlock pointing at a block inside the HELPER, and the
    // interrupted caller then recorded that label as a phi predecessor.
    let savedBlock = cg.curBlock.clone()
    let savedTemp = cg.temp
    let savedLabel = cg.label
    // A drop helper is its own top-level function — it must not land in the enclosing
    // function's buffer, or it is emitted with an empty body.
    let savedFnBuf = cg.fnBuf.clone()
    let savedInFn = cg.inFn
    cg.inFn = false
    cg.fnBuf = ""
    cg.body = ""
    cg.temp = 0
    cg.label = 0
    emit(&mut cg, "entry.bb:\n")
    let fields = cg.structs.get(name)!
    for i in 0..fields.len {
        if cgNeedsDrop(cg, fields[i].ty) {
            let fp = nextTemp(&mut cg)
            emit(&mut cg, "  " + fp + " = getelementptr %" + name.clone() + ", ptr %self, i32 0, i32 " + i.toString() + "\n")
            emitDropValue(&mut cg, fp, fields[i].ty)
        }
    }
    emit(&mut cg, "  ret void\n")
    let helperIR = "define void @" + hn + "(ptr %self) {\n" + cg.body.clone() + "}\n\n"
    cg.body = savedBody
    cg.curBlock = savedBlock
    cg.fnBuf = savedFnBuf
    cg.inFn = savedInFn
    cg.temp = savedTemp
    cg.label = savedLabel
    cg.globals = cg.globals + helperIR
}

// Emit `define void @milo.drop.enum.NAME(ptr %self)` — switches on the tag and
// drops the droppable payload fields of the active variant. Enum layout is
// `{ i32 tag, [slots x i64] payload }`; the payload blob is reinterpreted as the
// variant's struct type, exactly as genMatch binds payloads.
pub fn ensureEnumDropHelper(cg: &mut Cgen, name: &string) {
    let hn = "milo.drop.enum." + name.clone()
    if dropHelperEmitted(cg, hn) {
        return
    }
    cg.dropHelpers.push(hn.clone())
    let savedBody = cg.body.clone()
    // The helper is a whole function emitted mid-stream: its emitLabel calls would
    // otherwise leave cg.curBlock pointing at a block inside the HELPER, and the
    // interrupted caller then recorded that label as a phi predecessor.
    let savedBlock = cg.curBlock.clone()
    let savedTemp = cg.temp
    let savedLabel = cg.label
    // A drop helper is its own top-level function — it must not land in the enclosing
    // function's buffer, or it is emitted with an empty body.
    let savedFnBuf = cg.fnBuf.clone()
    let savedInFn = cg.inFn
    cg.inFn = false
    cg.fnBuf = ""
    cg.body = ""
    cg.temp = 0
    cg.label = 0
    emit(&mut cg, "entry.bb:\n")
    let tp = nextTemp(&mut cg)
    emit(&mut cg, "  " + tp + " = getelementptr %" + name.clone() + ", ptr %self, i32 0, i32 0\n")
    let tag = nextTemp(&mut cg)
    emit(&mut cg, "  " + tag + " = load i32, ptr " + tp + "\n")
    let done = nextLabel(&mut cg, "edone")

    var caseLines = ""
    var dropIdx: Vec<i64> = Vec.new()
    var dropLbls: Vec<string> = Vec.new()
    let info = cg.enums.get(name)!
    for vi in 0..info.variants.len {
        let payloadTypes = lookupVariantPayload(cg, name, info.variants[vi].name)
        var anyDrop = false
        for pi in 0..payloadTypes.len {
            if cgNeedsDrop(cg, payloadTypes[pi]) {
                anyDrop = true
            }
        }
        if anyDrop {
            let lbl = nextLabel(&mut cg, "edrop")
            caseLines = caseLines + "    i32 " + info.variants[vi].tag.toString() + ", label %" + lbl + "\n"
            dropIdx.push(vi)
            dropLbls.push(lbl)
        }
    }
    if dropIdx.len > 0 {
        emit(&mut cg, "  switch i32 " + tag + ", label %" + done + " [\n" + caseLines + "  ]\n")
        for k in 0..dropIdx.len {
            let vi = dropIdx[k]
            emit(&mut cg, dropLbls[k].clone() + ":\n")
            let payloadTypes = lookupVariantPayload(cg, name, info.variants[vi].name)
            let pay = nextTemp(&mut cg)
            emit(&mut cg, "  " + pay + " = getelementptr %" + name.clone() + ", ptr %self, i32 0, i32 1\n")
            let vstructTy = variantStructTyDrop(payloadTypes)
            for pi in 0..payloadTypes.len {
                if cgNeedsDrop(cg, payloadTypes[pi]) {
                    let fp = nextTemp(&mut cg)
                    emit(&mut cg, "  " + fp + " = getelementptr " + vstructTy + ", ptr " + pay + ", i32 0, i32 " + pi.toString() + "\n")
                    emitDropValue(&mut cg, fp, payloadTypes[pi])
                }
            }
            emit(&mut cg, "  br label %" + done + "\n")
        }
    } else {
        emit(&mut cg, "  br label %" + done + "\n")
    }
    emit(&mut cg, done + ":\n  ret void\n")
    let helperIR = "define void @" + hn + "(ptr %self) {\n" + cg.body.clone() + "}\n\n"
    cg.body = savedBody
    cg.curBlock = savedBlock
    cg.fnBuf = savedFnBuf
    cg.inFn = savedInFn
    cg.temp = savedTemp
    cg.label = savedLabel
    cg.globals = cg.globals + helperIR
}

// Payload struct type `{ ty0, ty1, ... }` — a local copy of expr.milo's
// variantStructTy (that file imports this one, so it can't be imported back).
pub fn variantStructTyDrop(payloadTypes: &Vec<string>): string {
    var s = "{ "
    for i in 0..payloadTypes.len {
        if i > 0 {
            s = s + ", "
        }
        s = s + llType(payloadTypes[i])
    }
    s = s + " }"
    return s
}
