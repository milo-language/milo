// The stdlib root is the directory *containing* `std/` (resolvePath joins it with
// "std/io.milo"), not `std/` itself. Mirrors src/resolver.ts: MILO_ROOT wins,
// otherwise walk up from the source file looking for std/prelude.milo.
// Intermediate artifact paths must be unique per process: `bun test` compiles
// fixtures concurrently, and a shared /tmp/milo_out.ll had every milo-self build
// clobbering its neighbours.
pub extern fn getpid(): i32

// "compiled <src> -> <out> in <t>" with colour on a TTY, plain when piped or
// redirected. Mirrors reportCompiled in src/main.ts — the two compilers are
// supposed to be indistinguishable from the outside, and a missing timing plus
// missing colour is the kind of difference a user notices immediately even
// though no test compares CLI output.
pub fn reportCompiled(source: &string, out: &string, elapsedMs: i64) {
    var t = elapsedMs.toString() + "ms"
    if elapsedMs >= 1000 {
        // Two decimal places, without a float formatter: 7523ms -> "7.52s".
        let whole = elapsedMs / 1000
        let hundredths = (elapsedMs % 1000) / 10
        var frac = hundredths.toString()
        if hundredths < 10 {
            frac = "0" + frac
        }
        t = whole.toString() + "." + frac + "s"
    }
    // fd 1 is stdout. Piping must stay plain so `| tail` and log capture do not
    // collect escape codes.
    if fdIsTerminal(1) {
        let green = "\u{1b}[32m"
        let bold = "\u{1b}[1m"
        let dim = "\u{1b}[2m"
        let reset = "\u{1b}[0m"
        print(green + bold + "compiled" + reset + " " + source.clone() + " " + dim + "->" + reset + " " + bold + out.clone() + reset + " " + dim + "in" + reset + " " + green + t + reset)
    } else {
        print("compiled " + source.clone() + " -> " + out.clone() + " in " + t)
    }
}

// Mirrors src/version.ts. MILO_BUILD is "dev" in a checkout; the release workflow
// rewrites it. Unlike the TS driver we do NOT shell out to git for the commit — a
// compiler that runs a subprocess just to print its own version is a surprise in
// sandboxes and hooks, and "dev" alone is still true.
pub let MILO_VERSION = "0.1.0"

pub let MILO_BUILD = "dev"

// Render a token's text on one line: the lex dump is tab-separated, so a raw
// newline or tab inside a string literal would split one token across two rows.
pub fn escapeTokenValue(v: &string): string {
    var out = ""
    for i in 0..v.len {
        let c = v[i]
        if c == 10 {
            out = out + "\\n"
        } else if c == 9 {
            out = out + "\\t"
        } else if c == 13 {
            out = out + "\\r"
        } else if c == 0 {
            out = out + "\\0"
        } else if c < 32 || c == 127 {
            out = out + "\\x" + hexByte(c)
        } else {
            out = out + v[i..i + 1].clone()
        }
    }
    return out
}

pub fn hexByte(c: u8): string {
    let digits = "0123456789abcdef"
    let hi = (c / 16) as i64
    let lo = (c % 16) as i64
    return digits[hi..hi + 1].clone() + digits[lo..lo + 1].clone()
}

pub fn versionString(): string {
    return "milo " + MILO_VERSION + " (" + MILO_BUILD + ", self-hosted)"
}

pub fn tmpPath(stem: &string, ext: &string): string {
    var p = "/tmp/milo_"
    p = p + stem.clone()
    p = p + "_"
    p = p + getpid().toString()
    return p + ext.clone()
}

pub fn findStdlibRoot(sourceDir: &string): string {
    match Env.get("MILO_ROOT") {
        Option.Some(root) => {
            return root
        }
        Option.None => {
        }
    }
    var dir = sourceDir.clone()
    var depth: i64 = 0
    while depth < 32 {
        if pathExists(Path.join(dir, "std/prelude.milo")) {
            return dir
        }
        let parent = Path.dirname(dir.clone())
        if parent == dir {
            break
        }
        dir = parent
        depth = depth + 1
    }
    return sourceDir.clone()
}

// compile() has to hand back more than the IR text: `@link` names are discovered
// during resolution and are needed by the LINK step, which happens in the driver.
// Returning them alongside keeps the discovery in one place rather than having the
// driver re-scan emitted IR for library names it can only guess at.
pub struct Compiled {
    ir: string,
    linkLibs: Vec<string>,
}

// Render the parse errors the parser collected, then stop. `expect` recovers by
// continuing, so a file with parse errors still yields a Program — one built from
// guesses. Type-checking that produces cascading nonsense at best and a clean bill of
// health at worst: a broken file once printed six parse errors and then "ok — no
// errors" and exited 0.
//
// Source context (carets) needs the file each span came from, which is not necessarily
// the entry file — a broken import reports against its own path. Files are read lazily
// and once each; a file that has since become unreadable degrades to the plain form
// rather than losing the diagnostic.
pub fn reportParseDiagnostics(diags: &Vec<Diagnostic>) {
    let color = fdIsTerminal(2)
    var seenFiles: Vec<string> = Vec.new()
    var seenSources: Vec<string> = Vec.new()
    for i in 0..diags.len {
        let d = cloneDiagnostic(diags[i])
        var file = ""
        match d.span {
            Option.Some(sp) => {
                file = sp.file.clone()
            }
            Option.None => {
            }
        }
        if !color || file.len == 0 {
            eprint(formatDiagnosticPlain(d, file))
        } else {
            var src = ""
            var found = false
            for j in 0..seenFiles.len {
                if seenFiles[j] == file {
                    src = seenSources[j].clone()
                    found = true
                }
            }
            if !found {
                match readFile(file.clone()) {
                    Result.Ok(text) => {
                        src = text
                    }
                    Result.Err(e) => {
                        src = ""
                    }
                }
                seenFiles.push(file.clone())
                seenSources.push(src.clone())
            }
            if src.len == 0 {
                eprint(formatDiagnosticPlain(d, file))
            } else {
                eprint(formatDiagnostic(d, src, file))
            }
        }
    }
    eprint("error: " + diags.len.toString() + " parse error(s); not type-checking")
}

// Parsed `build`/`run` command line. Anything the self-hosted compiler cannot
// actually honour is REJECTED in parseBuildOpts rather than ignored: the TS driver
// accepts a wider flag set, and quietly dropping the difference is how
// `build --release` came to produce an -O2 binary while reporting success.
pub struct BuildOpts {
    output: string,
    // "-O0".."-O3", passed to clang/llc.
    optFlag: string,
    emitDebug: bool,
    sanitize: bool,
    // Companion translation units (.c/.o/.a/.cpp) and raw linker flags, forwarded
    // verbatim — the struct-by-value ABI tests link a C peer alongside the IR.
    extra: string,
    // `run` only: argv for the compiled program, everything after `--`.
    childArgs: string,
}

// Flags the TS driver understands that this compiler does not implement. Naming them
// individually (rather than falling through to "unknown flag") is the difference
// between "milo-self can't do that yet" and "you typo'd", which are different bugs.
pub fn unsupportedBuildFlag(a: &string): string {
    if a == "--target" || a.startsWith("--target=") {
        return "cross-compilation (no target selection in the self-hosted driver)"
    }
    if a == "--emit-header" {
        return "C header generation"
    }
    if a == "--contract-checks" || a == "--no-contract-checks" {
        return "contract checking (contract clauses are parsed and discarded)"
    }
    if a == "--strip-panic-locations" {
        return "panic-location stripping"
    }
    if a == "--no-entry" {
        return "entry-point suppression"
    }
    if a == "--heap-size" || a.startsWith("--heap-size=") {
        return "bare-metal heap sizing"
    }
    if a == "--max-stack-array" || a.startsWith("--max-stack-array=") {
        return "stack-array limits"
    }
    if a == "--safety" || a == "--allow" || a == "--deny" || a == "--deny-all" {
        return "the capability/safety policy engine"
    }
    if a == "--overflow-checks" || a == "--no-overflow-checks" {
        return "overflow-check selection (always on except in @wrapping fns)"
    }
    return ""
}

// `start` is the argv index of the first option (past the command and source file).
// `forRun` splits trailing positionals into child argv instead of linker inputs.
pub fn parseBuildOpts(argv: &Vec<string>, start: i64, forRun: bool): BuildOpts {
    var o = BuildOpts {
        output: "a.out", optFlag: "-O2", emitDebug: false, sanitize: false, extra: "", childArgs: "",
    }
    var i = start
    var afterSep = false
    while i < argv.len {
        let a = argv[i].clone()
        if afterSep {
            o.childArgs = o.childArgs + " " + a
            i = i + 1
            continue
        }
        if a == "--" {
            afterSep = true
            i = i + 1
            continue
        }
        if a == "-o" && (i + 1) < argv.len {
            o.output = argv[i + 1].clone()
            i = i + 2
            continue
        }
        if a == "--release" {
            o.optFlag = "-O3"
            i = i + 1
            continue
        }
        if a == "--debug" {
            o.optFlag = "-O0"
            i = i + 1
            continue
        }
        // --fast is -O0 plus check elision in the TS driver; only the -O0 half is
        // implemented here, so it is not offered under that name at all.
        if a == "-O0" || a == "-O1" || a == "-O2" || a == "-O3" {
            o.optFlag = a.clone()
            i = i + 1
            continue
        }
        if a == "-O" && (i + 1) < argv.len {
            o.optFlag = "-O" + argv[i + 1].clone()
            i = i + 2
            continue
        }
        if a == "-g" {
            o.emitDebug = true
            i = i + 1
            continue
        }
        if a == "--sanitize" {
            o.sanitize = true
            i = i + 1
            continue
        }
        if a == "--static-deps" {
            // Accepted and ignored: the self-hosted driver has no separate dynamic
            // path to switch away from. Stated rather than silent.
            eprint("note: --static-deps has no effect in the self-hosted driver")
            i = i + 1
            continue
        }
        let why = unsupportedBuildFlag(a)
        if why.len > 0 {
            eprint("error: '" + a + "' is not supported by the self-hosted compiler: " + why)
            eprint("  hint: use the TypeScript driver (bun run src/main.ts) for this flag")
            exit(2)
        }
        if a.len > 1 && a[0] == '-' {
            // `run` forwards an unrecognized flag to the compiled program — it is far
            // more likely to be the program's own option than a typo, and that is what
            // the TS driver does. `build` has no child to forward to, so there the
            // same token can only be a mistake.
            if forRun {
                o.childArgs = o.childArgs + " " + a
                i = i + 1
                continue
            }
            eprint("error: unknown option '" + a + "'")
            exit(2)
        }
        // A bare positional: a link input for both commands, since a C peer is
        // never something the child program should see on its argv.
        if a.endsWith(".c") || a.endsWith(".o") || a.endsWith(".a") || a.endsWith(".cpp") {
            o.extra = o.extra + " " + a
        } else if forRun {
            o.childArgs = o.childArgs + " " + a
        } else {
            o.extra = o.extra + " " + a
        }
        i = i + 1
    }
    return o
}

// Hand the checker's monomorphized declarations to the program codegen and lowering
// walk, in the order they were instantiated.
//
// This MOVES them. Cloning — which is what this used to do — mints a fresh ExprNode id
// for every node in every copied body, and the checker's side tables (exprTypes, forIns)
// are keyed by those ids, so every copied statement would arrive at lowering with no
// recorded type and no recorded loop shape. Popping into a scratch Vec and popping back
// out is a move that preserves declaration order.
pub fn mergeMonomorphized(ck: &mut Checker, prog: &mut Program) {
    var enumRev: Vec<EnumDecl> = Vec.new()
    while ck.monomorphizedEnums.len > 0 {
        enumRev.push(ck.monomorphizedEnums.pop()!)
    }
    while enumRev.len > 0 {
        prog.enums.push(enumRev.pop()!)
    }
    var structRev: Vec<StructDecl> = Vec.new()
    while ck.monomorphizedStructs.len > 0 {
        structRev.push(ck.monomorphizedStructs.pop()!)
    }
    while structRev.len > 0 {
        prog.structs.push(structRev.pop()!)
    }
    var fnRev: Vec<Function> = Vec.new()
    while ck.monomorphizedFns.len > 0 {
        fnRev.push(ck.monomorphizedFns.pop()!)
    }
    while fnRev.len > 0 {
        prog.functions.push(fnRev.pop()!)
    }
}

pub fn compile(path: string): Compiled {
    var source = ""
    match readFile(path.clone()) {
        Result.Ok(s) => {
            source = s
        }
        Result.Err(e) => {
            eprint("error: cannot read file '" + path + "'")
            exit(1)
        }
    }

    // Lex
    let tokens = tokenize(source)

    // Parse
    var parser = newParser(tokens, path.clone())
    let program = parse(&mut parser)

    // Resolve imports
    let target = getHostTarget()
    let sourceDir = Path.dirname(path.clone())
    let stdlibDir = findStdlibRoot(sourceDir.clone())
    let resolved = resolveImports(program, sourceDir.clone(), stdlibDir, target.os)

    if resolved.parseDiagnostics.len > 0 {
        reportParseDiagnostics(resolved.parseDiagnostics)
        exit(1)
    }

    // Type check
    var checker = newChecker()
    checkProgram(&mut checker, resolved)
    if hasErrors(checker) {
        for i in 0..checker.diagnostics.len {
            let d = checker.diagnostics[i]
            if d.severity == "error" {
                var loc = ""
                match d.span {
                    Option.Some(s) => {
                        // s.file is the span's OWN file — a diagnostic from an imported
                        // module (e.g. std/strconv.milo) must render against that file,
                        // not the entry point `path`, or the location lies.
                        loc = s.file.clone() + ":" + s.line.toString() + ":" + s.col.toString() + ": "
                    }
                    Option.None => {
                    }
                }
                eprint(loc + "error: " + d.message.clone())
                if d.hint.len > 0 {
                    eprint("  hint: " + d.hint.clone())
                }
            }
        }
        exit(1)
    }

    // Codegen: monomorphized decls become ordinary program declarations, then the whole
    // program is lowered. lowerProgram CONSUMES the AST — after this line the only syntax
    // left anywhere is what rides inside HExpr.Unlowered.
    var finalProg = resolved
    mergeMonomorphized(&mut checker, &mut finalProg)
    let hir = lowerProgram(finalProg, checker)
    let libs = hir.linkLibs.clone()
    return Compiled {
        ir: genProgram(hir, sourceDir), linkLibs: libs
    }
}

// Scan the emitted IR for extern symbols that need a link library, mirroring the
// TS driver's detectLibs. Only SSL/crypto/sqlite are auto-linked.
pub fn detectLibs(ir: &string, os: &string, declared: &Vec<string>, sdlFlags: &string): string {
    var libs = ""
    // Libraries the SOURCE asked for via `@link("SDL2")`. Sniffing the IR for known
    // symbol prefixes (below) can only ever recognise libraries the compiler was
    // taught about by name; `@link` lets a program name its own, which is what every
    // SDL example relies on. On darwin the Homebrew prefix is not on the default
    // search path, so it has to be added or the -l resolves to nothing.
    for i in 0..declared.len {
        let name = declared[i].clone()
        // `@link("framework:OpenGL")` is a darwin framework, not a `-l` name — it
        // takes `-framework Foo`, and there is no archive to name so it is never
        // static. Mirrors declaredLibSpec in src/main.ts. Emitting `-lframework:OpenGL`
        // is what a partial port of that function produced, and ld reported it as a
        // missing library named "framework:OpenGL".
        if name.startsWith("framework:") {
            let fw = name.substr(10, name.len)
            if os != "darwin" {
                eprint("error: @link(\"framework:" + fw.clone() + "\") targets " + os.clone() + ", but frameworks exist only on darwin")
                eprint("  hint: put the framework link in a '.darwin.milo' arm and the '-l' spelling in the others")
                exit(1)
            }
            libs = libs + " -framework " + fw
        } else if name == "SDL2" && sdlFlags.len > 0 {
            // sdl2-config knows the framework soup SDL2 needs on darwin; a bare
            // -lSDL2 links but leaves Cocoa/Metal symbols undefined.
            libs = libs + " " + sdlFlags.clone()
        } else if os == "darwin" {
            libs = libs + " -L/opt/homebrew/lib -l" + name
        } else {
            libs = libs + " -l" + name
        }
    }
    if ir.contains("@SSL_") || ir.contains("@TLS_client_method") {
        if os == "darwin" {
            libs = libs + " -L/opt/homebrew/opt/openssl@3/lib -lssl -lcrypto"
        } else {
            libs = libs + " -lssl -lcrypto"
        }
    }
    if !libs.contains("-lcrypto") && (ir.contains("@SHA256") || ir.contains("@MD5")) {
        libs = libs + " -lcrypto"
    }
    if ir.contains("@sqlite3_") {
        if os == "darwin" {
            libs = libs + " -L/opt/homebrew/opt/sqlite/lib -lsqlite3"
        } else {
            libs = libs + " -lsqlite3"
        }
    }
    return libs
}

// `sdl2-config --libs` is the only reliable source for SDL2's darwin link line —
// it expands to the Cocoa/Metal/CoreAudio frameworks the dylib actually needs.
// Empty string when SDL2 was not requested or the tool is absent, in which case
// detectLibs falls back to a plain -lSDL2.
pub fn sdlConfigFlags(declared: &Vec<string>): string {
    var wants = false
    for i in 0..declared.len {
        if declared[i] == "SDL2" {
            wants = true
        }
    }
    if !wants {
        return ""
    }
    let out = tmpPath("sdlcfg", ".txt")
    match run("sdl2-config --libs > " + out.clone() + " 2>/dev/null") {
        Result.Ok(code) => {
            if code != 0 {
                return ""
            }
        }
        Result.Err(_) => {
            return ""
        }
    }
    match readFile(out) {
        Result.Ok(text) => {
            return text.trim()
        }
        Result.Err(_) => {
            return ""
        }
    }
}

// Link LLVM IR with clang when available, otherwise mirror the TS driver's
// llc + system C compiler path. Some Linux dev hosts ship LLVM tools without a
// clang frontend; linking already-emitted IR does not require that frontend.
// `extra` mirrors src/main.ts's extraLinkFlags: raw, space-prefixed text spliced
// straight into the link command (companion .c/.o/.a translation units, mainly).
// `optFlag` is "-O0".."-O3". It used to be hardcoded to -O2 here, which meant
// `build --release` silently produced an -O2 binary: the flag parsed, the build
// succeeded, and nothing said the request had been dropped.
pub fn linkIr(irFile: &string, output: &string, libs: &string, extra: &string, optFlag: &string, emitDebug: bool, sanitize: bool): i32 {
    let objFile = irFile.clone() + ".o"
    var cflags = optFlag.clone()
    if emitDebug {
        cflags = cflags + " -g"
    }
    if sanitize {
        cflags = cflags + " -fsanitize=address,undefined -fno-omit-frame-pointer"
    }
    let command = "if command -v clang >/dev/null 2>&1; then clang -Wno-override-module " + cflags.clone() + " -o " + output.clone() + " " + irFile.clone() + libs.clone() + extra.clone() + "; else llc -filetype=obj " + optFlag.clone() + " " + irFile.clone() + " -o " + objFile.clone() + " && cc " + cflags + " -o " + output.clone() + " " + objFile + libs.clone() + extra.clone() + "; fi"
    match run(command) {
        Result.Ok(code) => {
            return code
        }
        Result.Err(_) => {
            return 127
        }
    }
}

// A checker Diagnostic, as one JSON object — the wire format `check-lsp` prints
// on stdout for the LSP server (see src-milo/lsp/diagnostics.milo) to consume
// from a guarded child process. JSON instead of the `check` command's
// human-readable stderr lines because a subprocess boundary is the only way
// to survive a fatal lex error (src-milo/lexer.milo's lexError calls exit(1)
// directly — an in-process lex of a mid-edit buffer can hit that on every
// keystroke that leaves a string unterminated) without taking the whole LSP
// session down with it, and free-text scraping across three different
// lex/parse/check error formats is far more fragile than one JSON shape.
//
// Hoisting (see hoistIfImported in src-milo/lsp/diagnostics.milo, mirroring
// src/lsp.ts) happens here rather than in the parent process: this is where
// the span's own file is still cheaply comparable to docPath, before it is
// flattened to text. A hoisted diagnostic reports at line 1 col 1 with the
// real location folded into the message — never a raw sentinel line/col that
// could be mistaken for "diagnostic at line 1 col 1 of THIS file".
pub fn diagnosticToJsonObj(d: Diagnostic, docPath: &string): JsonObj {
    var line: i64 = 1
    var col: i64 = 1
    var message = d.message.clone()
    match d.span {
        Option.Some(sp) => {
            if sp.file == docPath {
                line = sp.line as i64
                col = sp.col as i64
            } else {
                message = "in imported file " + sp.file.clone() + ":" + sp.line.toString() + ":" + sp.col.toString() + ": " + d.message.clone()
            }
        }
        Option.None => {
        }
    }
    return Json.obj().str("severity", d.severity.clone()).str("message", message).str("hint", d.hint.clone()).int("line", line).int("col", col)
}

pub fn main() {
    let argv = args()
    if argv.len < 2 {
        print("usage: milo <command> <file> [options]")
        print("commands: build, run, emit-ir, check, lsp")
        exit(1)
    }

    let cmd = argv[1].clone()
    if cmd == "version" || cmd == "--version" || cmd == "-V" {
        print(versionString())
        exit(0)
    }
    if cmd == "help" || cmd == "--help" || cmd == "-h" {
        print("milo — self-hosted Milo compiler")
        print("")
        print("usage: milo <command> <file> [options]")
        print("")
        print("commands:")
        print("  build <file> [-o out]  compile to executable")
        print("  run <file> [-- args]   compile and run")
        print("  emit-obj <file>        compile to a relocatable object (.o)")
        print("  emit-ir <file>         print LLVM IR to stdout")
        print("  emit-hir <file>        print a typed-HIR summary (counts, per-fn stmts)")
        print("  check <file>           type-check only")
        print("  lex <file>             print the token stream")
        print("  fmt <file...>          format source files (-w to write in place)")
        print("  lsp                    start the language server (stdio, JSON-RPC)")
        print("  version                print the compiler version")
        print("")
        print("build options:")
        print("  -o <path>              output path")
        print("  --release              -O3      --debug   -O0      -O0..-O3")
        print("  -g                     emit debug info")
        print("  --sanitize             link with ASan/UBSan")
        print("")
        // The gap is stated rather than left for a user to discover by having a flag
        // silently do nothing. These are implemented in the TypeScript driver only.
        print("not implemented here (use `bun run src/main.ts`):")
        print("  emit-ast, emit-js, build-lib, test, prove, verify, wcet, safety")
        print("  api, doc")
        print("  --target, --emit-header, --heap-size, --safety/--allow/--deny")
        exit(0)
    }

    if cmd == "lsp" {
        startServer()
        exit(0)
    }

    // `fmt` shells out to the ONE formatter (examples/cli-tools/fmt.milo), never a
    // second implementation — a divergent fallback silently rewrites source on save.
    //
    // The TS driver caches the built formatter in bin/milo-fmt and guards it with an
    // mtime staleness check. std/fs exposes no mtime, so this driver cannot prove a
    // cached binary is fresh — and a stale formatter is not a degraded formatter, it
    // is a wrong one (one already shipped a bug into 16 files via the pre-commit
    // hook). So it rebuilds every time and pays ~300ms rather than guess.
    if cmd == "fmt" {
        var files: Vec<string> = Vec.new()
        var write = false
        var fi: i64 = 2
        while fi < argv.len {
            if argv[fi] == "-w" {
                write = true
            } else if argv[fi].len > 1 && argv[fi][0] == '-' {
                eprint("error: unknown option '" + argv[fi].clone() + "'")
                exit(2)
            } else {
                files.push(argv[fi].clone())
            }
            fi = fi + 1
        }
        if files.len == 0 {
            eprint("error: no files to format")
            exit(1)
        }
        // The formatter source lives with the COMPILER, not with the file being
        // formatted — `milo fmt /tmp/x.milo` must still find it. Try the file's own
        // project root first (a checkout formatting its own sources), then walk up
        // from this executable.
        var fmtSrc = Path.join(findStdlibRoot(Path.dirname(files[0].clone())), "examples/cli-tools/fmt.milo")
        if !pathExists(fmtSrc) {
            match exePath() {
                Result.Ok(exe) => {
                    var dir = Path.dirname(exe)
                    var depth: i64 = 0
                    while depth < 32 {
                        let candidate = Path.join(dir.clone(), "examples/cli-tools/fmt.milo")
                        if pathExists(candidate) {
                            fmtSrc = candidate
                            break
                        }
                        let parent = Path.dirname(dir.clone())
                        if parent == dir {
                            break
                        }
                        dir = parent
                        depth = depth + 1
                    }
                }
                Result.Err(e) => {
                }
            }
        }
        if !pathExists(fmtSrc) {
            eprint("error: formatter source (examples/cli-tools/fmt.milo) not found")
            eprint("  hint: set MILO_ROOT to the checkout containing it")
            exit(1)
        }
        let fmtBin = tmpPath("fmt", "")
        let built = compile(fmtSrc.clone())
        let fmtIr = tmpPath("fmtir", ".ll")
        let _ = writeFile(fmtIr, built.ir)
        let bstatus = linkIr(fmtIr, fmtBin, detectLibs(built.ir, getHostTarget().os, built.linkLibs, sdlConfigFlags(built.linkLibs)), "", "-O2", false, false)
        if bstatus != 0 {
            eprint("error: could not build the formatter from " + fmtSrc)
            exit(1)
        }
        // Prove the formatter this compiler just built actually works before pointing
        // it at the user's source. milo-self currently MISCOMPILES fmt.milo — the
        // binary emits a run of NUL bytes instead of formatted text — and `fmt -w`
        // rewrites in place, so an unchecked run would silently destroy every file
        // named on the command line. Fail closed: a formatter that cannot reproduce a
        // canonical probe is not a degraded formatter, it is a corrupting one.
        let probePath = tmpPath("fmtprobe", ".milo")
        let probe = "fn main() {\n    print(\"ok\")\n}\n"
        let _p = writeFile(probePath, probe.clone())
        var probeOut = ""
        match capture(fmtBin.clone() + " " + probePath.clone()) {
            Result.Ok(t) => {
                probeOut = t
            }
            Result.Err(e) => {
                probeOut = ""
            }
        }
        if probeOut != probe {
            eprint("error: the formatter built by this compiler failed its self-check")
            eprint("  the built binary did not reproduce a canonical input, so running it")
            eprint("  could corrupt your source (fmt -w rewrites files in place)")
            eprint("  hint: format with the TypeScript driver — bun run src/main.ts fmt")
            exit(1)
        }
        var cmdline = fmtBin.clone()
        if write {
            cmdline = cmdline + " -w"
        }
        for i in 0..files.len {
            cmdline = cmdline + " " + files[i].clone()
        }
        var st: i32 = 127
        match run(cmdline) {
            Result.Ok(c) => {
                st = c
            }
            Result.Err(e) => {
            }
        }
        exit(st)
    }

    if argv.len < 3 {
        eprint("error: missing source file")
        exit(1)
    }

    let source = argv[2].clone()

    if cmd == "check-lsp" {
        // Internal: `check-lsp <buffer-file> <doc-path>` — read the (possibly
        // unsaved) buffer from `buffer-file` but label every span with
        // `doc-path`, the real on-disk location, so imports resolve from the
        // real directory and hoistIfImported's file comparison means something.
        // Always exits 0 with a JSON array on stdout (even a single-element
        // array of one hard error) — a nonzero exit here means the pipeline
        // itself died (lex/parse hard failure), which the LSP-side caller
        // detects by the absence of parseable JSON, not by exit code.
        if argv.len < 4 {
            eprint("error: check-lsp requires <buffer-file> <doc-path>")
            exit(1)
        }
        let bufferPath = argv[2].clone()
        let docPath = argv[3].clone()
        var src = ""
        match readFile(bufferPath.clone()) {
            Result.Ok(s) => {
                src = s
            }
            Result.Err(e) => {
                eprint("error: cannot read buffer file '" + bufferPath + "'")
                exit(1)
            }
        }
        let tokens = tokenize(src)
        var parser = newParser(tokens, docPath.clone())
        let program = parse(&mut parser)
        let target = getHostTarget()
        let sourceDir = Path.dirname(docPath.clone())
        let stdlibDir = findStdlibRoot(sourceDir.clone())
        let resolved = resolveImports(program, sourceDir, stdlibDir, target.os)
        var arr = Json.arr()
        // Parse errors first, and INSTEAD of type-checking: the AST after a parse error
        // is a guess, so the checker's opinion of it is noise that would bury the one
        // diagnostic the editor should show. Reporting them at all is new — they used to
        // go straight to the compiler's own stderr, where no LSP client ever saw them.
        for i in 0..resolved.parseDiagnostics.len {
            let d = resolved.parseDiagnostics[i]
            arr = arr.obj(diagnosticToJsonObj(d, docPath))
        }
        if resolved.parseDiagnostics.len == 0 {
            var checker = newChecker()
            checkProgram(&mut checker, resolved)
            for i in 0..checker.diagnostics.len {
                let d = checker.diagnostics[i]
                arr = arr.obj(diagnosticToJsonObj(d, docPath))
            }
        }
        print(arr.build())
        exit(0)
    }

    // `lex` and `fmt` take a file but do not go through compile(), so they sit before
    // the check/build family. Output format mirrors src/main.ts's `lex` exactly —
    // tab-separated KIND, escaped value, line:col — because scripts diff the two.
    if cmd == "lex" {
        var src = ""
        match readFile(source.clone()) {
            Result.Ok(t) => {
                src = t
            }
            Result.Err(e) => {
                eprint("error: cannot read file '" + source + "'")
                exit(1)
            }
        }
        let toks = tokenize(src)
        for i in 0..toks.len {
            for t in 0..toks[i].leadingTrivia.len {
                match toks[i].leadingTrivia[t].kind {
                    TriviaKind.Blank => {
                        print("L_BLANK\t\t" + toks[i].leadingTrivia[t].line.toString())
                    }
                    TriviaKind.Comment => {
                        print("L_COMMENT\t" + escapeTokenValue(toks[i].leadingTrivia[t].text) + "\t" + toks[i].leadingTrivia[t].line.toString())
                    }
                }
            }
            print(tokKindName(toks[i].kind) + "\t" + escapeTokenValue(toks[i].value) + "\t" + toks[i].line.toString() + ":" + toks[i].col.toString())
            for t in 0..toks[i].trailingTrivia.len {
                match toks[i].trailingTrivia[t].kind {
                    TriviaKind.Comment => {
                        print("T_COMMENT\t" + escapeTokenValue(toks[i].trailingTrivia[t].text) + "\t" + toks[i].trailingTrivia[t].line.toString())
                    }
                    TriviaKind.Blank => {
                    }
                }
            }
        }
        exit(0)
    }

    if cmd == "check" {
        // Type-check only, no codegen
        var src = ""
        match readFile(source.clone()) {
            Result.Ok(s) => {
                src = s
            }
            Result.Err(e) => {
                eprint("error: cannot read file '" + source + "'")
                exit(1)
            }
        }
        let tokens = tokenize(src)
        var parser = newParser(tokens, source.clone())
        let program = parse(&mut parser)
        let target = getHostTarget()
        let sourceDir = Path.dirname(source.clone())
        let stdlibDir = findStdlibRoot(sourceDir)
        let resolved = resolveImports(program, sourceDir, stdlibDir, target.os)
        if resolved.parseDiagnostics.len > 0 {
            reportParseDiagnostics(resolved.parseDiagnostics)
            exit(1)
        }
        var checker = newChecker()
        checkProgram(&mut checker, resolved)
        if hasErrors(checker) {
            for i in 0..checker.diagnostics.len {
                let d = checker.diagnostics[i]
                if d.severity == "error" {
                    var loc = ""
                    match d.span {
                        Option.Some(sp) => {
                            // sp.file — the span's own file, not necessarily `source`
                            // (the entry point) — see the `compile()` diagnostic loop.
                            loc = sp.file.clone() + ":" + sp.line.toString() + ":" + sp.col.toString() + ": "
                        }
                        Option.None => {
                        }
                    }
                    eprint(loc + "error: " + d.message.clone())
                }
            }
            exit(1)
        }
        print("ok — no errors")
        exit(0)
    }

    // A smoke command and a differential-debug hook for the HIR lowering pass, not a
    // serializer: it proves lower.milo runs over a real program without aborting, and
    // gives a place to compare shapes against the oracle's `emit-hir`. It re-checks the
    // program rather than reusing compile(), which stays on the AST path until codegen
    // itself takes an HIRModule.
    if cmd == "emit-hir" {
        var src = ""
        match readFile(source.clone()) {
            Result.Ok(s) => {
                src = s
            }
            Result.Err(e) => {
                eprint("error: cannot read file '" + source + "'")
                exit(1)
            }
        }
        let tokens = tokenize(src)
        var parser = newParser(tokens, source.clone())
        let program = parse(&mut parser)
        let target = getHostTarget()
        let sourceDir = Path.dirname(source.clone())
        let stdlibDir = findStdlibRoot(sourceDir)
        let resolved = resolveImports(program, sourceDir, stdlibDir, target.os)
        if resolved.parseDiagnostics.len > 0 {
            reportParseDiagnostics(resolved.parseDiagnostics)
            exit(1)
        }
        var checker = newChecker()
        checkProgram(&mut checker, resolved)
        if hasErrors(checker) {
            for i in 0..checker.diagnostics.len {
                let d = checker.diagnostics[i]
                if d.severity == "error" {
                    var loc = ""
                    match d.span {
                        Option.Some(sp) => {
                            loc = sp.file.clone() + ":" + sp.line.toString() + ":" + sp.col.toString() + ": "
                        }
                        Option.None => {
                        }
                    }
                    eprint(loc + "error: " + d.message.clone())
                }
            }
            exit(1)
        }
        var finalProg = resolved
        mergeMonomorphized(&mut checker, &mut finalProg)
        let hir = lowerProgram(finalProg, checker)
        print("structs " + hir.structs.len.toString())
        print("enums " + hir.enums.len.toString())
        print("functions " + hir.functions.len.toString())
        print("globals " + hir.globals.len.toString())
        for i in 0..hir.functions.len {
            print("fn " + hir.functions[i].name.clone() + " " + hir.functions[i].body.len.toString())
        }
        exit(0)
    }

    if cmd == "emit-ir" {
        let comp = compile(source.clone())
        print(comp.ir)
        exit(0)
    }

    if cmd == "build" {
        let buildStart = now()
        // Parse the command line BEFORE compiling: a rejected flag should fail in
        // milliseconds, not after a full compile whose result is then discarded.
        let opts = parseBuildOpts(argv, 3, false)
        let comp = compile(source.clone())
        // Write IR to a temp file and link it with the available LLVM/C tools.
        let irFile = tmpPath("out", ".ll")
        let _ = writeFile(irFile, comp.ir)
        let status = linkIr(irFile, opts.output, detectLibs(comp.ir, getHostTarget().os, comp.linkLibs, sdlConfigFlags(comp.linkLibs)), opts.extra, opts.optFlag, opts.emitDebug, opts.sanitize)
        if status != 0 {
            eprint("error: linker failed (exit " + status.toString() + ")")
            exit(1)
        }
        reportCompiled(source.clone(), opts.output, elapsed(buildStart, now()).toMillis())
        exit(0)
    }

    // Compile to a relocatable object without linking, so a Milo module can be fed
    // to someone else's link step.
    if cmd == "emit-obj" {
        let opts = parseBuildOpts(argv, 3, false)
        var out = opts.output.clone()
        if out == "a.out" {
            out = Path.basename(source.clone())
            if out.endsWith(".milo") {
                out = out.substr(0, out.len - 5)
            }
            out = out + ".o"
        }
        let comp = compile(source.clone())
        let irFile = tmpPath("out", ".ll")
        let _ = writeFile(irFile, comp.ir)
        let cmdline = "if command -v clang >/dev/null 2>&1; then clang -Wno-override-module " + opts.optFlag.clone() + " -c -o " + out.clone() + " " + irFile.clone() + "; else llc -filetype=obj " + opts.optFlag.clone() + " " + irFile.clone() + " -o " + out.clone() + "; fi"
        var status: i32 = 127
        match run(cmdline) {
            Result.Ok(c) => {
                status = c
            }
            Result.Err(e) => {
            }
        }
        if status != 0 {
            eprint("error: object emission failed (exit " + status.toString() + ")")
            exit(1)
        }
        print("compiled " + source.clone() + " -> " + out)
        exit(0)
    }

    if cmd == "run" {
        let opts = parseBuildOpts(argv, 3, true)
        let comp = compile(source.clone())
        let irFile = tmpPath("out", ".ll")
        let _ = writeFile(irFile, comp.ir)
        let binary = tmpPath("run", "")
        let extra = opts.extra.clone()
        let childArgs = opts.childArgs.clone()
        let status = linkIr(irFile, binary, detectLibs(comp.ir, getHostTarget().os, comp.linkLibs, sdlConfigFlags(comp.linkLibs)), extra, opts.optFlag, opts.emitDebug, opts.sanitize)
        if status != 0 {
            eprint("error: linker failed")
            exit(1)
        }
        var runStatus: i32 = 127
        match run(binary + childArgs) {
            Result.Ok(c) => {
                runStatus = c
            }
            Result.Err(e) => {
            }
        }
        exit(runStatus)
    }

    eprint("error: unknown command '" + cmd + "'")
    exit(1)
}
