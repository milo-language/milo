// Recursive descent parser — port of src/parser.ts
from "src-milo/tokens.milo" import {
    TokKind, Token, tokKindName
}
from "src-milo/ast.milo" import {
    MiloType, Param, Expr, Stmt, Function, Program, StructDecl, StructField,
    EnumDecl, EnumVariant, Pattern, MatchArm, Span, ImportDecl, TraitDecl,
    TraitMethod, ImplDecl, Attribute, TypeParam, StructLitField, LiteralKind,
    GlobalDecl, simpleType, ptrType, Diagnostic, cloneDiagnostic
}

pub struct Parser {
    tokens: Vec<Token>,
    pos: i64,
    // When true, `Name {` is NOT a struct literal — the `{` opens a block. Set
    // while parsing an if/while/match condition so `if x == CONST {` doesn't
    // consume the block brace as a struct-literal body (Rust's no-struct-literal
    // restriction). Restored before the body is parsed.
    noStructLit: bool,
    // Statements a desugaring produced that the caller must emit after the one it asked
    // for. `let P = E else {}` becomes three ordinary statements, and parseStmt can only
    // hand back one — parseStmts drains this after each call.
    pending: Vec<Heap<Stmt>>,
    // Bumped each time `for .. in ..codePoints()` fires, both to mint unique cursor/
    // decoded-value names (so nested loops can't collide) and to gate the implicit
    // `std/unicode` import — only paid for when the construct is actually used.
    codePointLoopCounter: i64,
    // Stamped onto every span this parser produces (see span()) — the file a
    // diagnostic should render against, not necessarily the entry file.
    filePath: string,
    // Set by a file-level `@!wrapping` directive — every (non-extern) fn parsed
    // for the rest of this file gets an implicit `wrapping` attribute (see the
    // top-level parse loop). Per-file: only fns parsed by THIS Parser see it.
    moduleWrapping: bool,
    // Parse errors seen so far, collected rather than printed at the point of failure.
    // `expect` is deliberately soft — it recovers and keeps going — so nothing
    // downstream could tell a clean parse from a broken one, and `check` once printed
    // six parse errors followed by "ok — no errors" and exited 0. Collecting (like the
    // checker does) also means these can be rendered with source context by
    // formatDiagnostic and served to the LSP, neither of which a bare eprint allows.
    diagnostics: Vec<Diagnostic>,
}

pub fn newParser(tokens: Vec<Token>, filePath: string): Parser {
    return Parser {
        tokens: tokens, pos: 0, noStructLit: false, pending: Vec.new(), codePointLoopCounter: 0, filePath: filePath, moduleWrapping: false, diagnostics: Vec.new()
    }
}

// -- Navigation helpers --

// The token stream always ends with an Eof token, so clamping to the last token
// is the same as "there is nothing more". Without this, lookahead past the end
// (atAdjacent's `<<`/`>>` probe does exactly that on a trailing operand) indexes
// one past the array and trips the bounds check.
pub fn peek(p: &Parser): Token {
    if p.pos >= p.tokens.len {
        return p.tokens[p.tokens.len - 1]
    }
    return p.tokens[p.pos]
}

pub fn peekN(p: &Parser, n: i64): Token {
    let i = p.pos + n
    if i >= p.tokens.len {
        return p.tokens[p.tokens.len - 1]
    }
    return p.tokens[i]
}

pub fn advance(p: &mut Parser): Token {
    if p.pos >= p.tokens.len {
        return p.tokens[p.tokens.len - 1]
    }
    let tok = p.tokens[p.pos]
    p.pos = p.pos + 1
    return tok
}

pub fn span(p: &Parser, tok: &Token): Option<Span> {
    return Option.Some(Span {
        line: tok.line, col: tok.col, file: p.filePath.clone()
    }
    )
}

// Record a parse error against `tok`. Never prints: the driver renders the collected
// list once, so ordering is stable and the LSP can serve the same values.
pub fn parseError(p: &mut Parser, tok: &Token, message: string, hint: string) {
    let sp = span(p, tok)
    p.diagnostics.push(Diagnostic {
        severity: "error", message: message, hint: hint, span: sp
    }
    )
}

pub fn cloneDiagnostics(ds: &Vec<Diagnostic>): Vec<Diagnostic> {
    var out: Vec<Diagnostic> = Vec.new()
    for i in 0..ds.len {
        out.push(cloneDiagnostic(ds[i]))
    }
    return out
}

pub fn at(p: &Parser, kind: TokKind): bool {
    return peek(p).kind == kind
}

pub fn matchTok(p: &mut Parser, kind: TokKind): bool {
    if at(p, kind) {
        p.pos = p.pos + 1
        return true
    }
    return false
}

pub fn expect(p: &mut Parser, kind: TokKind): Token {
    let tok = advance(&mut p)
    // Soft validation: on a kind mismatch this prints but still returns the token, so
    // parsing continues (no recovery yet). That tolerance is required and also
    // dangerous — a caller expecting the wrong kind still gets correct output, so the
    // only symptom is the diagnostic. Exactly that hid a parseAttribute bug for 42
    // errors per self-build. Include the token text: a bare line:col names neither the
    // file nor the token, which is most of what made that one hard to place.
    if !(tok.kind == kind) {
        parseError(&mut p, tok, "unexpected token '" + tok.value.clone() + "'", "expected " + tokKindName(kind))
    }
    return tok
}

// Adjacent same-kind tokens with no whitespace (for << and >>)
pub fn atAdjacent(p: &Parser, kind: TokKind): bool {
    let a = peek(p)
    let b = peekN(p, 1)
    return a.kind == kind && b.kind == kind && a.line == b.line && b.col == a.col + 1
}

// -- Type parsing --

pub fn isFnType(p: &mut Parser): bool {
    var i = p.pos + 1
    var depth = 1
    while depth > 0 && i < p.tokens.len {
        if p.tokens[i].kind == TokKind.LParen {
            depth = depth + 1
        } 
        else if p.tokens[i].kind == TokKind.RParen {
            depth = depth - 1
        }
        i = i + 1
    }
    return i < p.tokens.len && p.tokens[i].kind == TokKind.FatArrow
}

pub fn parseType(p: &mut Parser): MiloType {
    // &T or &mut T
    if matchTok(&mut p, TokKind.Amp) {
        let isMut = matchTok(&mut p, TokKind.Mut)
        var inner = parseType(&mut p)
        if isMut {
            inner.isRefMut = true
        } else {
            inner.isRef = true
        }
        return inner
    }
    // *T, **T, ... — the lexer emits one Star token per '*', so **T is two
    // Star tokens; recursing and incrementing (not just setting a bool)
    // is what lets depth > 1 survive instead of collapsing to *T.
    if matchTok(&mut p, TokKind.Star) {
        var inner = parseType(&mut p)
        inner.ptrDepth = inner.ptrDepth + 1
        return inner
    }
    // [T] or [T; N]
    if matchTok(&mut p, TokKind.LBracket) {
        var inner = parseType(&mut p)
        var arraySize: Option<i64> = Option.None
        if matchTok(&mut p, TokKind.Semicolon) {
            let sizeTok = expect(&mut p, TokKind.Int)
            arraySize = sizeTok.value.parseInt()
        }
        expect(&mut p, TokKind.RBracket)
        inner.isArray = true
        inner.arraySize = arraySize
        return inner
    }
    // move (T1, T2) => R — an owning closure type. Same keyword as the closure
    // EXPRESSION form because it marks the same thing on both sides. Without this arm
    // `std/runtime.milo`'s `fn spawn(f: move () => void)` failed to parse, which took
    // the whole self-host fixpoint red on every commit that touched std/.
    if matchTok(&mut p, TokKind.Move) {
        var inner = parseType(&mut p)
        inner.isMoveFn = true
        return inner
    }
    // (T1, T2) => R  — function type
    if at(p, TokKind.LParen) && isFnType(&mut p) {
        advance(&mut p)
        var fnParams: Vec<MiloType> = Vec.new()
        while !at(p, TokKind.RParen) && !at(p, TokKind.Eof) {
            fnParams.push(parseType(&mut p))
            if !at(p, TokKind.RParen) {
                expect(&mut p, TokKind.Comma)
            }
        }
        expect(&mut p, TokKind.RParen)
        expect(&mut p, TokKind.FatArrow)
        let fnRet = parseType(&mut p)
        return MiloType {
            name: "fn",
            typeArgs: Vec.new(),
            ptrDepth: 0,
            isRef: false,
            isRefMut: false,
            isArray: false,
            arraySize: Option.None,
            isFn: true,
            isMoveFn: false,
            fnParams: fnParams,
            fnRet: Option.Some(Heap(fnRet)),
            rangeMin: Option.None,
            rangeMax: Option.None,
        }
    }
    // Named type
    let tok = advance(&mut p)
    var typeArgs: Vec<MiloType> = Vec.new()
    if matchTok(&mut p, TokKind.Lt) {
        typeArgs.push(parseType(&mut p))
        while matchTok(&mut p, TokKind.Comma) {
            typeArgs.push(parseType(&mut p))
        }
        expect(&mut p, TokKind.Gt)
    }
    let hadTypeArgs = typeArgs.len > 0
    var result = MiloType {
        name: tok.value,
        typeArgs: typeArgs,
        ptrDepth: 0,
        isRef: false,
        isRefMut: false,
        isArray: false,
        arraySize: Option.None,
        isFn: false,
        isMoveFn: false,
        fnParams: Vec.new(),
        fnRet: Option.None,
        rangeMin: Option.None,
        rangeMax: Option.None,
    }
    // i32(0..100) — range constraint on an integer type. The same-line guard is
    // what keeps a following statement that merely STARTS with '(' from being
    // swallowed as a constraint (`let x: i32` newline `(a + b).foo()`).
    if at(p, TokKind.LParen) && !hadTypeArgs && isRangeableIntName(result.name) && peek(p).line == tok.line {
        advance(&mut p)
        let lo = parseRangeBound(&mut p)
        expect(&mut p, TokKind.DotDot)
        let hi = parseRangeBound(&mut p)
        expect(&mut p, TokKind.RParen)
        result.rangeMin = Option.Some(lo)
        result.rangeMax = Option.Some(hi)
    }
    // T? desugars to Option<T>
    if matchTok(&mut p, TokKind.Question) {
        var optArgs: Vec<MiloType> = Vec.new()
        optArgs.push(result)
        result = MiloType {
            name: "Option",
            typeArgs: optArgs,
            ptrDepth: 0,
            isRef: false,
            isRefMut: false,
            isArray: false,
            arraySize: Option.None,
            isFn: false,
            isMoveFn: false,
            fnParams: Vec.new(),
            fnRet: Option.None,
            rangeMin: Option.None,
            rangeMax: Option.None,
        }
    }
    return result
}

// Only the built-in integer names can carry a range constraint — everything
// else keeps '(' meaning whatever it meant before.
pub fn isRangeableIntName(name: &string): bool {
    return name == "i8" || name == "i16" || name == "i32" || name == "i64" ||
    name == "u8" || name == "u16" || name == "u32" || name == "u64" ||
    name == "int" || name == "byte"
}

// One end of a range constraint: an integer literal, optionally negated.
pub fn parseRangeBound(p: &mut Parser): i64 {
    let negative = matchTok(&mut p, TokKind.Minus)
    let tok = expect(&mut p, TokKind.Int)
    var n: i64 = 0
    match tok.value.parseInt() {
        Option.Some(v) => {
            n = v
        }
        Option.None => {
        }
    }
    if negative {
        return 0 - n
    }
    return n
}

// -- Type parameters --

pub fn parseOneTypeParam(p: &mut Parser): TypeParam {
    let name = expect(&mut p, TokKind.Ident).value
    var bounds: Vec<string> = Vec.new()
    if matchTok(&mut p, TokKind.Colon) {
        bounds.push(expect(&mut p, TokKind.Ident).value)
        while matchTok(&mut p, TokKind.Plus) {
            bounds.push(expect(&mut p, TokKind.Ident).value)
        }
    }
    return TypeParam {
        name: name, bounds: bounds
    }
}

pub fn parseTypeParams(p: &mut Parser): Vec<TypeParam> {
    var typeParams: Vec<TypeParam> = Vec.new()
    if matchTok(&mut p, TokKind.Lt) {
        typeParams.push(parseOneTypeParam(&mut p))
        while matchTok(&mut p, TokKind.Comma) {
            typeParams.push(parseOneTypeParam(&mut p))
        }
        expect(&mut p, TokKind.Gt)
    }
    return typeParams
}

// -- Attributes --

// An attribute arg is either a bare ident (`@derive(Copy)`) or a string literal
// (`@cSig("unistd.h", "int close(int)")`). Demanding Ident for both is why every
// self-build printed 42 parse errors for std/os.milo's @cSig args.
pub fn parseAttributeArg(p: &mut Parser): string {
    if at(p, TokKind.String) {
        return advance(&mut p).value
    }
    return expect(&mut p, TokKind.Ident).value
}

pub fn parseAttribute(p: &mut Parser): Attribute {
    expect(&mut p, TokKind.At)
    let name = expect(&mut p, TokKind.Ident).value
    var args: Vec<string> = Vec.new()
    if matchTok(&mut p, TokKind.LParen) {
        args.push(parseAttributeArg(&mut p))
        while matchTok(&mut p, TokKind.Comma) {
            args.push(parseAttributeArg(&mut p))
        }
        expect(&mut p, TokKind.RParen)
    }
    return Attribute {
        name: name, args: args
    }
}

// -- Import --

pub fn atFromKeyword(p: &Parser): bool {
    return at(p, TokKind.Ident) && peek(p).value == "from" && peekN(p, 1).kind == TokKind.String
}

pub fn parseImport(p: &mut Parser): ImportDecl {
    if atFromKeyword(p) {
        let tok = advance(&mut p)
        let pathTok = expect(&mut p, TokKind.String)
        expect(&mut p, TokKind.Import)
        // from "path" import { a, b, c }
        expect(&mut p, TokKind.LBrace)
        var names: Vec<string> = Vec.new()
        var aliases: Vec<Option<string>> = Vec.new()
        while !at(p, TokKind.RBrace) && !at(p, TokKind.Eof) {
            names.push(expect(&mut p, TokKind.Ident).value)
            // `import { foo as bar }` — bind the exported `foo` under local name
            // `bar`. `as` is already a token kind (cast); reuse it in import
            // position too (mirrors src/parser.ts's parseImport).
            if at(p, TokKind.As) {
                let _ = advance(&mut p)
                aliases.push(Option.Some(expect(&mut p, TokKind.Ident).value))
            } else {
                aliases.push(Option.None)
            }
            matchTok(&mut p, TokKind.Comma)
        }
        expect(&mut p, TokKind.RBrace)
        return ImportDecl {
            path: pathTok.value,
            names: Option.Some(names),
            aliases: aliases,
            span: span(p, tok),
        }
    }
    // bare import "path" — error
    let tok = advance(&mut p)
    let pathTok = expect(&mut p, TokKind.String)
    return ImportDecl {
        path: pathTok.value, names: Option.None, aliases: Vec.new(), span: span(p, tok)
    }
}

// -- Struct --

pub fn parseStruct(p: &mut Parser): StructDecl {
    expect(&mut p, TokKind.Struct)
    let name = expect(&mut p, TokKind.Ident).value
    let typeParams = parseTypeParams(&mut p)
    expect(&mut p, TokKind.LBrace)
    var fields: Vec<StructField> = Vec.new()
    while !at(p, TokKind.RBrace) && !at(p, TokKind.Eof) {
        // Field attributes (`@iter inner: HashMap<T, bool>` in std/set.milo, or
        // `@json("wire_name")` for a @derive(Json) rename). Kept only for the
        // deriver to read — codegen/most of the checker still ignores them.
        var fieldAttrs: Vec<Attribute> = Vec.new()
        while at(p, TokKind.At) {
            fieldAttrs.push(parseAttribute(&mut p))
        }
        let fieldName = expect(&mut p, TokKind.Ident).value
        expect(&mut p, TokKind.Colon)
        let fieldType = parseType(&mut p)
        fields.push(StructField {
            name: fieldName, ty: fieldType, attributes: fieldAttrs
        }
        )
        matchTok(&mut p, TokKind.Comma)
    }
    expect(&mut p, TokKind.RBrace)
    return StructDecl {
        name: name,
        typeParams: typeParams,
        fields: fields,
        attributes: Vec.new(),
    }
}

// -- Enum --

pub fn parseEnum(p: &mut Parser): EnumDecl {
    expect(&mut p, TokKind.Enum)
    let name = expect(&mut p, TokKind.Ident).value
    let typeParams = parseTypeParams(&mut p)
    // Integer-repr enum: `enum LogLevel: i32 { … }`. The repr type is consumed and
    // dropped — milo0 lays every enum out as { i32 tag, payload } already, so the tag it
    // emits matches an i32 repr; a narrower repr would differ and is not used in std.
    if matchTok(&mut p, TokKind.Colon) {
        parseType(&mut p)
    }
    expect(&mut p, TokKind.LBrace)
    var variants: Vec<EnumVariant> = Vec.new()
    while !at(p, TokKind.RBrace) && !at(p, TokKind.Eof) {
        let variantName = expect(&mut p, TokKind.Ident).value
        // Explicit discriminant (`LDA = 169`, `Neg = -1`).
        var disc: Option<i64> = Option.None
        if matchTok(&mut p, TokKind.Eq) {
            var neg = false
            if matchTok(&mut p, TokKind.Minus) {
                neg = true
            }
            let numTok = expect(&mut p, TokKind.Int)
            var dv = intLiteralBits(numTok.value)
            if neg {
                dv = 0 - dv
            }
            disc = Option.Some(dv)
        }
        var fields: Vec<MiloType> = Vec.new()
        if matchTok(&mut p, TokKind.LParen) {
            while !at(p, TokKind.RParen) && !at(p, TokKind.Eof) {
                fields.push(parseType(&mut p))
                matchTok(&mut p, TokKind.Comma)
            }
            expect(&mut p, TokKind.RParen)
        }
        variants.push(EnumVariant {
            name: variantName, fields: fields, discriminant: disc
        }
        )
        matchTok(&mut p, TokKind.Comma)
    }
    expect(&mut p, TokKind.RBrace)
    return EnumDecl {
        name: name,
        typeParams: typeParams,
        variants: variants,
        attributes: Vec.new(),
    }
}

// -- Functions --

pub fn parseParam(p: &mut Parser): Param {
    let name = expect(&mut p, TokKind.Ident).value
    // the type is optional for closure params (`(x) => …`) — inferred by the checker
    var ty = simpleType("")
    if at(p, TokKind.Colon) {
        advance(&mut p)
        ty = parseType(&mut p)
    }
    return Param {
        name: name, ty: ty
    }
}

pub struct ParamResult {
    params: Vec<Param>,
    variadic: bool,
}

pub fn parseParamList(p: &mut Parser): ParamResult {
    expect(&mut p, TokKind.LParen)
    var params: Vec<Param> = Vec.new()
    var variadic = false
    while !at(p, TokKind.RParen) && !at(p, TokKind.Eof) {
        if at(p, TokKind.DotDotDot) {
            advance(&mut p)
            variadic = true
            break
        }
        params.push(parseParam(&mut p))
        matchTok(&mut p, TokKind.Comma)
    }
    expect(&mut p, TokKind.RParen)
    return ParamResult {
        params: params, variadic: variadic
    }
}

pub fn parseReturnType(p: &mut Parser): MiloType {
    if matchTok(&mut p, TokKind.Colon) {
        return parseType(&mut p)
    }
    return simpleType("void")
}

pub fn parseExternFn(p: &mut Parser): Function {
    expect(&mut p, TokKind.Extern)
    expect(&mut p, TokKind.Fn)
    let name = expect(&mut p, TokKind.Ident).value
    let pl = parseParamList(&mut p)
    let retType = parseReturnType(&mut p)
    return Function {
        name: name,
        typeParams: Vec.new(),
        params: pl.params,
        retType: retType,
        body: Vec.new(),
        isExtern: true,
        isVariadic: pl.variadic,
        attributes: Vec.new(),
    }
}

// Contract clauses (`requires` / `ensures`) sit between a function's signature and
// its body. They are plain identifiers to milo0's lexer. milo0 neither verifies nor
// emits contracts — the TS compiler does — but it must parse past them or the body
// never starts, and the clause tokens get read as a bogus expression.
// The clause expression is parsed with noStructLit set: `ensures result == SQUAD_DRONES`
// followed by the body's `{` otherwise reads as a struct literal named SQUAD_DRONES and
// swallows the whole function body.
pub fn skipContractClauses(p: &mut Parser) {
    let savedNS = p.noStructLit
    while at(p, TokKind.Ident) && (peek(p).value == "requires" || peek(p).value == "ensures") {
        advance(&mut p)
        p.noStructLit = true
        var discarded = parseExpr(&mut p)
    }
    p.noStructLit = savedNS
}

pub fn parseFn(p: &mut Parser): Function {
    expect(&mut p, TokKind.Fn)
    let name = expect(&mut p, TokKind.Ident).value
    let typeParams = parseTypeParams(&mut p)
    let pl = parseParamList(&mut p)
    let retType = parseReturnType(&mut p)
    skipContractClauses(&mut p)
    expect(&mut p, TokKind.LBrace)
    let body = parseStmts(&mut p)
    expect(&mut p, TokKind.RBrace)
    return Function {
        name: name,
        typeParams: typeParams,
        params: pl.params,
        retType: retType,
        body: body,
        isExtern: false,
        isVariadic: pl.variadic,
        attributes: Vec.new(),
    }
}

// -- Traits + Impls --

pub fn parseTraitMethod(p: &mut Parser): TraitMethod {
    let tok = expect(&mut p, TokKind.Fn)
    let name = expect(&mut p, TokKind.Ident).value
    let pl = parseParamList(&mut p)
    let retType = parseReturnType(&mut p)
    var body: Option<Vec<Heap<Stmt>>> = Option.None
    if at(p, TokKind.LBrace) {
        advance(&mut p)
        body = Option.Some(parseStmts(&mut p))
        expect(&mut p, TokKind.RBrace)
    }
    return TraitMethod {
        name: name,
        params: pl.params,
        retType: retType,
        body: body,
        span: span(p, tok),
    }
}

pub fn parseTraitDecl(p: &mut Parser): TraitDecl {
    let tok = expect(&mut p, TokKind.Trait)
    let name = expect(&mut p, TokKind.Ident).value
    let typeParams = parseTypeParams(&mut p)
    var supertraits: Vec<string> = Vec.new()
    if matchTok(&mut p, TokKind.Colon) {
        supertraits.push(expect(&mut p, TokKind.Ident).value)
        while matchTok(&mut p, TokKind.Plus) {
            supertraits.push(expect(&mut p, TokKind.Ident).value)
        }
    }
    expect(&mut p, TokKind.LBrace)
    var methods: Vec<TraitMethod> = Vec.new()
    while !at(p, TokKind.RBrace) && !at(p, TokKind.Eof) {
        methods.push(parseTraitMethod(&mut p))
    }
    expect(&mut p, TokKind.RBrace)
    return TraitDecl {
        name: name,
        typeParams: typeParams,
        supertraits: supertraits,
        methods: methods,
        span: span(p, tok),
    }
}

pub fn parseImplDecl(p: &mut Parser, isUnsafe: bool): ImplDecl {
    let tok = expect(&mut p, TokKind.Impl)
    let firstName = expect(&mut p, TokKind.Ident).value
    var typeParams = parseTypeParams(&mut p)
    var traitName: Option<string> = Option.None
    var typeName = firstName.clone()
    if matchTok(&mut p, TokKind.For) {
        traitName = Option.Some(firstName)
        typeName = expect(&mut p, TokKind.Ident).value
        let targetTypeParams = parseTypeParams(&mut p)
        if targetTypeParams.len > 0 {
            typeParams = targetTypeParams
        }
    }
    expect(&mut p, TokKind.LBrace)
    var methods: Vec<Function> = Vec.new()
    while !at(p, TokKind.RBrace) && !at(p, TokKind.Eof) {
        // Attributes are legal on an impl method (`@pure fn sqrt`), not just on top-level
        // declarations. Without this the FIRST `@pure` in std/math.milo was a parse error,
        // which meant `struct Math` never registered and every `Math.abs(x)` in any program
        // reported "unknown enum 'Math'" — the namespace-object model looked unimplemented
        // when it was one missing attribute loop.
        // Parsed and dropped: milo0's Function carries no attributes (top-level fns
        // discard them too), and the only ones that appear on methods are verification
        // hints like @pure, which milo0 does not act on.
        while at(p, TokKind.At) {
            parseAttribute(&mut p)
        }
        methods.push(parseFn(&mut p))
    }
    expect(&mut p, TokKind.RBrace)
    return ImplDecl {
        traitName: traitName,
        typeName: typeName,
        typeParams: typeParams,
        methods: methods,
        isUnsafe: isUnsafe,
        span: span(p, tok),
    }
}

// -- Statements --

pub fn parseStmts(p: &mut Parser): Vec<Heap<Stmt>> {
    var stmts: Vec<Heap<Stmt>> = Vec.new()
    while !at(p, TokKind.RBrace) && !at(p, TokKind.Eof) {
        stmts.push(Heap(parseStmt(&mut p)))
        if p.pending.len > 0 {
            let drained = cloneStmts(p.pending)
            p.pending = Vec.new()
            for i in 0..drained.len {
                stmts.push(Heap((*drained[i]).clone()))
            }
        }
    }
    return stmts
}

// `let Option.Some(v) = E else { B }` desugars into three statements milo0 already has:
//
//     let __letelse_N = E
//     if __letelse_N.isNone() { B }
//     let v = __letelse_N!
//
// which is why this is a parser change rather than a new Stmt threaded through checker,
// lowering and codegen. Only Option and Result are handled — for any other enum the
// `isNone`/`isErr` guard does not exist, so this reports the limitation instead of
// desugaring into something that would not type-check.
//
// One gap versus the real compiler: the TS checker REQUIRES the else block to diverge.
// Here a non-diverging block falls through to the `!`, which aborts at runtime instead of
// being a compile error.
// Decimal digits to the i64 BIT PATTERN, accumulating in u64. `parseInt()` tops out at
// i64, so `18446744073709551615` (u64 max) and the magnitude of i64 MIN both fell off the
// end — and with a `?? 0` fallback they became a silent zero, which is worse than the
// compile error they used to be. u64 covers every literal the language admits; the
// checker is what decides whether the value fits the annotated type.
pub fn intLiteralBits(digits: &string): i64 {
    var acc: u64 = 0
    for i in 0..digits.len {
        let c = digits[i]
        if c >= 48 && c <= 57 {
            acc = acc * 10 + (c - 48) as u64
        }
    }
    return acc as i64
}

pub fn parseLetElse(p: &mut Parser, s: &Option<Span>): Stmt {
    let enumName = expect(&mut p, TokKind.Ident).value
    expect(&mut p, TokKind.Dot)
    // The variant name is consumed but unused: the desugaring keys off the ENUM
    // (Option -> isNone, Result -> isErr), and `!` unwraps the success variant either way.
    let _variant = expect(&mut p, TokKind.Ident).value
    expect(&mut p, TokKind.LParen)
    let binding = expect(&mut p, TokKind.Ident).value
    expect(&mut p, TokKind.RParen)
    expect(&mut p, TokKind.Eq)
    let subject = parseExpr(&mut p)
    expect(&mut p, TokKind.Else)
    expect(&mut p, TokKind.LBrace)
    let elseBody = parseStmts(&mut p)
    expect(&mut p, TokKind.RBrace)

    var emptyName = "isNone"
    if enumName == "Result" {
        emptyName = "isErr"
    }
    if enumName != "Option" && enumName != "Result" {
        parseError(&mut p, peek(p), "let-else on '" + enumName.clone() + "' is not supported in milo0", "only Option and Result support let-else here")
    }

    // Unique per source position, so two let-else statements in one scope cannot collide.
    var tmp = "__letelse"
    match s {
        Option.Some(sp) => {
            tmp = tmp + "_" + sp.line.toString() + "_" + sp.col.toString()
        }
        Option.None => {
        }
    }

    var noArgs: Vec<Heap<ExprNode>> = Vec.new()
    let guard = mkExpr(Expr.MethodCall(mkExpr(Expr.Ident(tmp.clone()), cloneSpan(s)), emptyName, noArgs), cloneSpan(s))
    p.pending.push(Heap(Stmt.IfStmt(guard, elseBody, Option.None, cloneSpan(s))))
    let bound = mkExpr(Expr.Unwrap(mkExpr(Expr.Ident(tmp.clone()), cloneSpan(s))), cloneSpan(s))
    p.pending.push(Heap(Stmt.LetDecl(binding, Option.None, bound, cloneSpan(s))))
    return Stmt.LetDecl(tmp, Option.None, subject, cloneSpan(s))
}

pub fn parseLet(p: &mut Parser): Stmt {
    let s = span(p, peek(p))
    expect(&mut p, TokKind.Let)
    // `let Enum.Variant(x) = ... else { ... }` — a destructuring bind, not a name.
    if at(p, TokKind.Ident) && peekN(p, 1).kind == TokKind.Dot {
        return parseLetElse(&mut p, s)
    }
    let name = expect(&mut p, TokKind.Ident).value
    var ty: Option<MiloType> = Option.None
    if matchTok(&mut p, TokKind.Colon) {
        ty = Option.Some(parseType(&mut p))
    }
    expect(&mut p, TokKind.Eq)
    let value = parseExpr(&mut p)
    return Stmt.LetDecl(name, ty, value, s)
}

pub fn parseVar(p: &mut Parser): Stmt {
    let s = span(p, peek(p))
    expect(&mut p, TokKind.Var)
    let name = expect(&mut p, TokKind.Ident).value
    var ty: Option<MiloType> = Option.None
    if matchTok(&mut p, TokKind.Colon) {
        ty = Option.Some(parseType(&mut p))
    }
    expect(&mut p, TokKind.Eq)
    let value = parseExpr(&mut p)
    return Stmt.VarDecl(name, ty, value, s)
}

pub fn parseReturn(p: &mut Parser): Stmt {
    let s = span(p, peek(p))
    expect(&mut p, TokKind.Return)
    if at(p, TokKind.RBrace) {
        return Stmt.Return(Option.None, s)
    }
    return Stmt.Return(Option.Some(parseExpr(&mut p)), s)
}

pub fn parseIf(p: &mut Parser): Stmt {
    let s = span(p, peek(p))
    expect(&mut p, TokKind.If)
    if at(p, TokKind.Let) {
        return parseIfLet(&mut p, s)
    }
    let savedNS = p.noStructLit
    p.noStructLit = true
    let cond = parseExpr(&mut p)
    p.noStructLit = savedNS
    expect(&mut p, TokKind.LBrace)
    let thenBody = parseStmts(&mut p)
    expect(&mut p, TokKind.RBrace)
    var elseBody: Option<Vec<Heap<Stmt>>> = Option.None
    if matchTok(&mut p, TokKind.Else) {
        if at(p, TokKind.If) {
            var elseStmts: Vec<Heap<Stmt>> = Vec.new()
            elseStmts.push(Heap(parseIf(&mut p)))
            elseBody = Option.Some(elseStmts)
        } else {
            expect(&mut p, TokKind.LBrace)
            elseBody = Option.Some(parseStmts(&mut p))
            expect(&mut p, TokKind.RBrace)
        }
    }
    return Stmt.IfStmt(cond, thenBody, elseBody, s)
}

pub fn parseIfLet(p: &mut Parser, s: Option<Span>): Stmt {
    expect(&mut p, TokKind.Let)
    let pattern = parsePattern(&mut p)
    expect(&mut p, TokKind.Eq)
    let subject = parseExpr(&mut p)
    expect(&mut p, TokKind.LBrace)
    let thenBody = parseStmts(&mut p)
    expect(&mut p, TokKind.RBrace)
    var elseBody: Option<Vec<Heap<Stmt>>> = Option.None
    if matchTok(&mut p, TokKind.Else) {
        expect(&mut p, TokKind.LBrace)
        elseBody = Option.Some(parseStmts(&mut p))
        expect(&mut p, TokKind.RBrace)
    }
    return Stmt.IfLetStmt(Heap(pattern), subject, thenBody, elseBody, s)
}

// `while let P = subj { body }` loops while subj matches P, rebinding the
// payload each iteration. Desugars straight to existing statements (no new
// checker/codegen support needed): `while true { if let P = subj { body }
// else { break } }`.
pub fn parseWhileLet(p: &mut Parser, s: Option<Span>): Stmt {
    expect(&mut p, TokKind.Let)
    let pattern = parsePattern(&mut p)
    expect(&mut p, TokKind.Eq)
    let savedNS = p.noStructLit
    p.noStructLit = true
    let subject = parseExpr(&mut p)
    p.noStructLit = savedNS
    expect(&mut p, TokKind.LBrace)
    let thenBody = parseStmts(&mut p)
    expect(&mut p, TokKind.RBrace)
    var breakBody: Vec<Heap<Stmt>> = Vec.new()
    breakBody.push(Heap(Stmt.BreakStmt(cloneSpan(s))))
    let ifLet = Stmt.IfLetStmt(Heap(pattern), subject, thenBody, Option.Some(breakBody), cloneSpan(s))
    var loopBody: Vec<Heap<Stmt>> = Vec.new()
    loopBody.push(Heap(ifLet))
    return Stmt.WhileStmt(mkExpr(Expr.BoolLit(true), cloneSpan(s)), loopBody, s)
}

pub fn parseWhile(p: &mut Parser): Stmt {
    let s = span(p, peek(p))
    expect(&mut p, TokKind.While)
    if at(p, TokKind.Let) {
        return parseWhileLet(&mut p, s)
    }
    let savedNS = p.noStructLit
    p.noStructLit = true
    let cond = parseExpr(&mut p)
    // loop invariant clauses (verification hints, no runtime effect) sit between
    // the condition and the body — parse past them like fn requires/ensures.
    while at(p, TokKind.Ident) && peek(p).value == "invariant" {
        advance(&mut p)
        var discarded = parseExpr(&mut p)
    }
    p.noStructLit = savedNS
    expect(&mut p, TokKind.LBrace)
    let body = parseStmts(&mut p)
    expect(&mut p, TokKind.RBrace)
    return Stmt.WhileStmt(cond, body, s)
}

pub fn parseFor(p: &mut Parser): Stmt {
    let s = span(p, peek(p))
    expect(&mut p, TokKind.For)
    let varName = expect(&mut p, TokKind.Ident).value
    var varName2: Option<string> = Option.None
    if matchTok(&mut p, TokKind.Comma) {
        varName2 = Option.Some(expect(&mut p, TokKind.Ident).value)
    }
    if at(p, TokKind.Ident) && peek(p).value == "in" {
        advance(&mut p)
    } else {
        parseError(&mut p, peek(p), "expected 'in' in for-loop", "")
    }
    let savedNS = p.noStructLit
    p.noStructLit = true
    let iterableOrStart = parseExpr(&mut p)
    var iterable: Heap<ExprNode> = Heap(iterableOrStart.clone())
    if matchTok(&mut p, TokKind.DotDot) {
        let end = parseExpr(&mut p)
        iterable = mkExpr(Expr.RangeExpr(iterableOrStart, end), cloneSpan(s))
    }
    p.noStructLit = savedNS
    expect(&mut p, TokKind.LBrace)
    let body = parseStmts(&mut p)
    expect(&mut p, TokKind.RBrace)
    let cpSubject = asCodePointsSubject(*iterable)
    match cpSubject {
        Option.Some(subj) => {
            return desugarCodePointsLoop(&mut p, varName, varName2, subj, body, s)
        }
        Option.None => {
        }
    }
    return Stmt.ForInStmt(varName, varName2, iterable, body, s)
}

// `for cp in EXPR.codePoints() { .. }` is the only shape this desugar fires on —
// returns the receiver of a zero-arg `.codePoints()` call, or None otherwise.
pub fn asCodePointsSubject(e: &ExprNode): Option<Heap<ExprNode>> {
    match e.kind {
        Expr.MethodCall(obj, m, a) => {
            if m == "codePoints" && a.len == 0 {
                return Option.Some(Heap(obj.clone()))
            }
            return Option.None
        }
        _ => {
            return Option.None
        }
    }
}

// A place expression is read in situ; anything else is a temporary that must be
// bound once, or `.len` and each decode would re-evaluate it (and a borrow could
// not be bound to a local at all).
pub fn isPlaceExpr(e: &ExprNode): bool {
    match e.kind {
        Expr.Ident(n) => {
            return true
        }
        Expr.FieldAccess(o, f) => {
            return true
        }
        Expr.IndexAccess(o, i) => {
            return true
        }
        _ => {
            return false
        }
    }
}

// `for cp in s.codePoints() { .. }` -> a byte-cursor while loop over
// decodeCodepoint (std/unicode). Iterating a string directly yields BYTES (the
// right default for scanning ASCII delimiters); this form yields decoded
// codepoints without materializing a Vec<i32> — no more expensive to write than
// the byte shortcut. Mirrors src/parser.ts desugarCodePointsLoop.
//
// Desugared here rather than in the checker because `for` has no iterator
// protocol to hook — every iterable shape is hardcoded per builtin type. The
// cost is that `codePoints` is effectively reserved as a for-in iterable method
// name: a user type defining one gets this rewrite instead.
//
// Wrapped in `if true { .. }` (there is no bare-block statement in milo0's AST)
// so the cursor and any subject temporary stay scoped to the loop and cannot
// leak into the enclosing block.
pub fn desugarCodePointsLoop(p: &mut Parser, varName: string, varName2: Option<string>, subject: Heap<ExprNode>, body: Vec<Heap<Stmt>>, s: Option<Span>): Stmt {
    p.codePointLoopCounter = p.codePointLoopCounter + 1
    let uid = p.codePointLoopCounter
    let cursor = "__cpAt" + uid.toString()
    let decoded = "__cp" + uid.toString()

    var pre: Vec<Heap<Stmt>> = Vec.new()
    var src = Heap(subject.clone())
    if !isPlaceExpr(*subject) {
        let tmp = "__cpSrc" + uid.toString()
        pre.push(Heap(Stmt.LetDecl(tmp.clone(), Option.None, subject, cloneSpan(s))))
        src = mkExpr(Expr.Ident(tmp), cloneSpan(s))
    }
    pre.push(Heap(Stmt.VarDecl(cursor.clone(), Option.Some(simpleType("i64")), mkExpr(Expr.IntLit(0), cloneSpan(s)), cloneSpan(s))))

    var loopBody: Vec<Heap<Stmt>> = Vec.new()
    var decodeArgs: Vec<Heap<ExprNode>> = Vec.new()
    decodeArgs.push(Heap(src.clone()))
    decodeArgs.push(mkExpr(Expr.Ident(cursor.clone()), cloneSpan(s)))
    var noTypeArgs: Vec<MiloType> = Vec.new()
    loopBody.push(Heap(Stmt.LetDecl(decoded.clone(), Option.None, mkExpr(Expr.Call("decodeCodepoint", decodeArgs, noTypeArgs), cloneSpan(s)), cloneSpan(s))))

    // The index binding is the offset of the codepoint just decoded, so it must
    // be taken BEFORE the cursor advances.
    match varName2 {
        Option.Some(v2) => {
            loopBody.push(Heap(Stmt.LetDecl(varName.clone(), Option.None, mkExpr(Expr.Ident(cursor.clone()), cloneSpan(s)), cloneSpan(s))))
            loopBody.push(Heap(Stmt.LetDecl(v2, Option.None, mkExpr(Expr.FieldAccess(mkExpr(Expr.Ident(decoded.clone()), cloneSpan(s)), "value"), cloneSpan(s)), cloneSpan(s))))
        }
        Option.None => {
            loopBody.push(Heap(Stmt.LetDecl(varName.clone(), Option.None, mkExpr(Expr.FieldAccess(mkExpr(Expr.Ident(decoded.clone()), cloneSpan(s)), "value"), cloneSpan(s)), cloneSpan(s))))
        }
    }

    // Advance BEFORE the body: a `continue` in the body would otherwise skip the
    // increment and spin forever.
    let advance = mkExpr(Expr.BinOp("+", mkExpr(Expr.Ident(cursor.clone()), cloneSpan(s)), mkExpr(Expr.FieldAccess(mkExpr(Expr.Ident(decoded.clone()), cloneSpan(s)), "size"), cloneSpan(s))), cloneSpan(s))
    loopBody.push(Heap(Stmt.Assign(mkExpr(Expr.Ident(cursor.clone()), cloneSpan(s)), advance, cloneSpan(s))))

    for i in 0..body.len {
        loopBody.push(Heap((*body[i]).clone()))
    }

    let cond = mkExpr(Expr.BinOp("<", mkExpr(Expr.Ident(cursor.clone()), cloneSpan(s)), mkExpr(Expr.FieldAccess(Heap(src.clone()), "len"), cloneSpan(s))), cloneSpan(s))
    pre.push(Heap(Stmt.WhileStmt(cond, loopBody, cloneSpan(s))))

    return Stmt.IfStmt(mkExpr(Expr.BoolLit(true), cloneSpan(s)), pre, Option.None, cloneSpan(s))
}

pub fn parseMatch(p: &mut Parser): Stmt {
    let s = span(p, peek(p))
    expect(&mut p, TokKind.Match)
    let savedNS = p.noStructLit
    p.noStructLit = true
    let subject = parseExpr(&mut p)
    p.noStructLit = savedNS
    expect(&mut p, TokKind.LBrace)
    var arms: Vec<MatchArm> = Vec.new()
    while !at(p, TokKind.RBrace) && !at(p, TokKind.Eof) {
        let pattern = parsePattern(&mut p)
        expect(&mut p, TokKind.FatArrow)
        expect(&mut p, TokKind.LBrace)
        let body = parseStmts(&mut p)
        expect(&mut p, TokKind.RBrace)
        arms.push(MatchArm {
            pattern: pattern, body: body
        }
        )
    }
    expect(&mut p, TokKind.RBrace)
    return Stmt.MatchStmt(subject, arms, s)
}

pub fn parseStmt(p: &mut Parser): Stmt {
    if at(p, TokKind.Let) {
        return parseLet(&mut p)
    }
    if at(p, TokKind.Var) {
        return parseVar(&mut p)
    }
    if at(p, TokKind.Return) {
        return parseReturn(&mut p)
    }
    if at(p, TokKind.If) {
        return parseIf(&mut p)
    }
    if at(p, TokKind.While) {
        return parseWhile(&mut p)
    }
    if at(p, TokKind.For) {
        return parseFor(&mut p)
    }
    if at(p, TokKind.Match) {
        return parseMatch(&mut p)
    }
    if at(p, TokKind.Break) {
        let s = span(p, advance(&mut p))
        return Stmt.BreakStmt(s)
    }
    if at(p, TokKind.Continue) {
        let s = span(p, advance(&mut p))
        return Stmt.ContinueStmt(s)
    }
    if at(p, TokKind.Unsafe) {
        let s = span(p, advance(&mut p))
        expect(&mut p, TokKind.LBrace)
        let body = parseStmts(&mut p)
        expect(&mut p, TokKind.RBrace)
        return Stmt.UnsafeBlock(body, s)
    }

    let s0 = span(p, peek(p))
    let expr = parseExpr(&mut p)
    // assignment
    if at(p, TokKind.Eq) {
        advance(&mut p)
        let value = parseExpr(&mut p)
        return Stmt.Assign(expr, value, s0)
    }
    // compound assignment `x <op>= v` desugars to `x = x <op> v`
    let cop = compoundOp(peek(p).kind)
    if cop.len > 0 {
        advance(&mut p)
        let rhs = parseExpr(&mut p)
        let value = mkExpr(Expr.BinOp(cop, Heap(expr.clone()), rhs), cloneSpan(s0))
        return Stmt.Assign(expr, value, s0)
    }
    return Stmt.ExprStmt(expr, s0)
}

// maps a compound-assign token to its binary operator, or "" if not compound
pub fn compoundOp(k: TokKind): string {
    match k {
        TokKind.PlusEq => {
            return "+"
        }
        TokKind.MinusEq => {
            return "-"
        }
        TokKind.StarEq => {
            return "*"
        }
        TokKind.SlashEq => {
            return "/"
        }
        TokKind.PercentEq => {
            return "%"
        }
        TokKind.AmpEq => {
            return "&"
        }
        TokKind.PipeEq => {
            return "|"
        }
        TokKind.CaretEq => {
            return "^"
        }
        _ => {
            return ""
        }
    }
}

// -- Patterns --

pub fn parsePattern(p: &mut Parser): Pattern {
    let tok = peek(p)
    let s = span(p, tok)

    // Wildcard _
    if tok.kind == TokKind.Ident && tok.value == "_" {
        advance(&mut p)
        return Pattern.WildcardPattern(s)
    }
    // Literal patterns
    if tok.kind == TokKind.Int {
        advance(&mut p)
        return Pattern.LiteralPattern(tok.value, LiteralKind.LitInt, s)
    }
    if tok.kind == TokKind.Float {
        advance(&mut p)
        return Pattern.LiteralPattern(tok.value, LiteralKind.LitFloat, s)
    }
    if tok.kind == TokKind.String {
        advance(&mut p)
        return Pattern.LiteralPattern(tok.value, LiteralKind.LitString, s)
    }
    if tok.kind == TokKind.Char {
        advance(&mut p)
        return Pattern.LiteralPattern(tok.value, LiteralKind.LitChar, s)
    }
    if tok.kind == TokKind.True {
        advance(&mut p)
        return Pattern.LiteralPattern("true", LiteralKind.LitBool, s)
    }
    if tok.kind == TokKind.False {
        advance(&mut p)
        return Pattern.LiteralPattern("false", LiteralKind.LitBool, s)
    }
    // Negative numeric literal
    if tok.kind == TokKind.Minus {
        let next = peekN(p, 1)
        if next.kind == TokKind.Int || next.kind == TokKind.Float {
            advance(&mut p)
            let numTok = advance(&mut p)
            let litKind = if numTok.kind == TokKind.Int {
                LiteralKind.LitInt
            } else {
                LiteralKind.LitFloat
            }
            return Pattern.LiteralPattern("-" + numTok.value, litKind, s)
        }
    }
    // Enum pattern: Name.Variant or Name.Variant(bindings) — or, when the enum
    // is obvious from the match subject, a bare Variant/Variant(bindings). An
    // elided prefix is left blank here (the parser has no types to resolve it
    // with) and filled in by the checker from the subject's real enum name;
    // codegen never reads this field at all — it re-derives the mangled enum
    // name from the subject's own codegen'd type, so leaving it blank is safe.
    let first = expect(&mut p, TokKind.Ident).value
    var enumName = ""
    var variant = first.clone()
    if at(p, TokKind.Dot) {
        advance(&mut p)
        enumName = first.clone()
        variant = expect(&mut p, TokKind.Ident).value
    }
    var bindings: Vec<string> = Vec.new()
    if matchTok(&mut p, TokKind.LParen) {
        while !at(p, TokKind.RParen) && !at(p, TokKind.Eof) {
            bindings.push(expect(&mut p, TokKind.Ident).value)
            matchTok(&mut p, TokKind.Comma)
        }
        expect(&mut p, TokKind.RParen)
    }
    return Pattern.EnumPattern(enumName, variant, bindings, s)
}

// -- Expression parsing (precedence climbing) --

pub fn parseExpr(p: &mut Parser): Heap<ExprNode> {
    var left = parseOr(&mut p)
    if at(p, TokKind.QuestionQuestion) {
        advance(&mut p)
        let defaultExpr = parseOr(&mut p)
        left = mkExpr(Expr.DefaultValue(left, defaultExpr), Option.None)
    }
    return left
}

pub fn parseOr(p: &mut Parser): Heap<ExprNode> {
    var left = parseAnd(&mut p)
    while at(p, TokKind.PipePipe) {
        advance(&mut p)
        let right = parseAnd(&mut p)
        left = mkExpr(Expr.BinOp("||", left, right), Option.None)
    }
    return left
}

pub fn parseAnd(p: &mut Parser): Heap<ExprNode> {
    var left = parseBitOr(&mut p)
    while at(p, TokKind.AmpAmp) {
        advance(&mut p)
        let right = parseBitOr(&mut p)
        left = mkExpr(Expr.BinOp("&&", left, right), Option.None)
    }
    return left
}

pub fn parseBitOr(p: &mut Parser): Heap<ExprNode> {
    var left = parseBitXor(&mut p)
    while at(p, TokKind.Pipe) {
        advance(&mut p)
        let right = parseBitXor(&mut p)
        left = mkExpr(Expr.BinOp("|", left, right), Option.None)
    }
    return left
}

pub fn parseBitXor(p: &mut Parser): Heap<ExprNode> {
    var left = parseBitAnd(&mut p)
    while at(p, TokKind.Caret) {
        advance(&mut p)
        let right = parseBitAnd(&mut p)
        left = mkExpr(Expr.BinOp("^", left, right), Option.None)
    }
    return left
}

pub fn parseBitAnd(p: &mut Parser): Heap<ExprNode> {
    var left = parseComparison(&mut p)
    // single & between exprs (&& already consumed at higher level)
    while at(p, TokKind.Amp) && peekN(p, 1).kind != TokKind.Mut {
        advance(&mut p)
        let right = parseComparison(&mut p)
        left = mkExpr(Expr.BinOp("&", left, right), Option.None)
    }
    return left
}

pub fn parseComparison(p: &mut Parser): Heap<ExprNode> {
    var left = parseShift(&mut p)
    if at(p, TokKind.Is) {
        advance(&mut p)
        let pattern = parsePattern(&mut p)
        return mkExpr(Expr.IsExpr(left, Heap(pattern)), Option.None)
    }
    while peek(p).kind == TokKind.EqEq || peek(p).kind == TokKind.Neq ||
    peek(p).kind == TokKind.LtEq || peek(p).kind == TokKind.GtEq ||
    (peek(p).kind == TokKind.Lt && !atAdjacent(p, TokKind.Lt)) ||
    (peek(p).kind == TokKind.Gt && !atAdjacent(p, TokKind.Gt)) {
        let opTok = advance(&mut p)
        let right = parseShift(&mut p)
        left = mkExpr(Expr.BinOp(opTok.value, left, right), Option.None)
    }
    return left
}

pub fn parseShift(p: &mut Parser): Heap<ExprNode> {
    var left = parseAdditive(&mut p)
    while atAdjacent(p, TokKind.Lt) || atAdjacent(p, TokKind.Gt) {
        let isLeft = peek(p).kind == TokKind.Lt
        advance(&mut p)
        advance(&mut p)
        let right = parseAdditive(&mut p)
        let op = if isLeft {
            "<<"
        } else {
            ">>"
        }
        left = mkExpr(Expr.BinOp(op, left, right), Option.None)
    }
    return left
}

pub fn parseAdditive(p: &mut Parser): Heap<ExprNode> {
    var left = parseMultiplicative(&mut p)
    while peek(p).kind == TokKind.Plus || peek(p).kind == TokKind.Minus {
        let opTok = advance(&mut p)
        let right = parseMultiplicative(&mut p)
        left = mkExpr(Expr.BinOp(opTok.value, left, right), Option.None)
    }
    return left
}

pub fn parseMultiplicative(p: &mut Parser): Heap<ExprNode> {
    var left = parseUnary(&mut p)
    while peek(p).kind == TokKind.Star || peek(p).kind == TokKind.Slash || peek(p).kind == TokKind.Percent {
        // * on new line = unary deref, not multiply
        if peek(p).kind == TokKind.Star && p.pos > 0 && p.tokens[p.pos - 1].line < peek(p).line {
            break
        }
        let opTok = advance(&mut p)
        let right = parseUnary(&mut p)
        left = mkExpr(Expr.BinOp(opTok.value, left, right), Option.None)
    }
    return left
}

// A call argument: `&mut x` is the explicit mutable-borrow marker and is dropped here,
// so the checker, lowering and codegen see the argument exactly as the bare form. The
// TS checker also diagnoses `&mut` on a parameter that is not `&mut T`; milo-self
// accepts it silently (the TS compiler is the oracle for error programs). The operand
// is a unary expression, as in src/parser.ts, so `&mut x + 1` is a parse error rather
// than a borrow of a sum.
pub fn parseArg(p: &mut Parser): Heap<ExprNode> {
    if at(p, TokKind.Amp) && peekN(p, 1).kind == TokKind.Mut {
        advance(&mut p)
        advance(&mut p)
        return parseUnary(&mut p)
    }
    return parseExpr(&mut p)
}

pub fn parseUnary(p: &mut Parser): Heap<ExprNode> {
    // `&mut` outside an argument position: kept as its own operator so the checker can
    // say what it is instead of tripping over the `mut` keyword.
    if at(p, TokKind.Amp) && peekN(p, 1).kind == TokKind.Mut {
        let tok = advance(&mut p)
        advance(&mut p)
        let operand = parseUnary(&mut p)
        let s = span(p, tok)
        return mkExpr(Expr.UnaryOp("&mut", operand), s)
    }
    if peek(p).kind == TokKind.Minus || peek(p).kind == TokKind.Bang ||
    peek(p).kind == TokKind.Star || peek(p).kind == TokKind.Tilde ||
    peek(p).kind == TokKind.Amp {
        let tok = advance(&mut p)
        let operand = parseUnary(&mut p)
        // span() borrows tok, so take it before tok.value moves out of the struct.
        let s = span(p, tok)
        return mkExpr(Expr.UnaryOp(tok.value, operand), s)
    }
    return parsePostfix(&mut p)
}

pub fn parsePostfix(p: &mut Parser): Heap<ExprNode> {
    // Every node built below carries this span. They used to be built with
    // Option.None while `startSpan` sat unused, so a diagnostic about a method call,
    // field access, or index — "cannot call 'add' on 'h' because it is borrowed" —
    // printed with no file or line at all, and had to be located by bisecting the
    // source. The span is the whole postfix chain's start, which is what a reader
    // needs to find the expression.
    let startSpan = span(p, peek(p))
    var expr = parsePrimary(&mut p)
    while true {
        if at(p, TokKind.Dot) {
            advance(&mut p)
            let field = expect(&mut p, TokKind.Ident).value
            if at(p, TokKind.LParen) {
                advance(&mut p)
                var args: Vec<Heap<ExprNode>> = Vec.new()
                while !at(p, TokKind.RParen) && !at(p, TokKind.Eof) {
                    args.push(parseArg(&mut p))
                    matchTok(&mut p, TokKind.Comma)
                }
                expect(&mut p, TokKind.RParen)
                expr = mkExpr(Expr.MethodCall(expr, field, args), cloneSpan(startSpan))
            } else {
                expr = mkExpr(Expr.FieldAccess(expr, field), cloneSpan(startSpan))
            }
        } else if at(p, TokKind.LBracket) {
            advance(&mut p)
            let first = parseExpr(&mut p)
            if at(p, TokKind.DotDot) {
                advance(&mut p)
                let end = parseExpr(&mut p)
                expect(&mut p, TokKind.RBracket)
                // s[a..b] → .slice(a, b)
                var sliceArgs: Vec<Heap<ExprNode>> = Vec.new()
                sliceArgs.push(first)
                sliceArgs.push(end)
                expr = mkExpr(Expr.MethodCall(expr, "slice", sliceArgs), cloneSpan(startSpan))
            } else {
                expect(&mut p, TokKind.RBracket)
                expr = mkExpr(Expr.IndexAccess(expr, first), cloneSpan(startSpan))
            }
        } else if at(p, TokKind.Bang) {
            // span of the whole unwrapped expression (its start), matching the
            // oracle's `error at L:C` — not the `!` token position.
            advance(&mut p)
            expr = mkExpr(Expr.Unwrap(expr), cloneSpan(startSpan))
        } else if at(p, TokKind.Question) {
            advance(&mut p)
            expr = mkExpr(Expr.Propagate(expr), Option.None)
        } else if at(p, TokKind.As) {
            advance(&mut p)
            let targetType = parseType(&mut p)
            expr = mkExpr(Expr.CastExpr(expr, targetType), Option.None)
        } else {
            break
        }
    }
    return expr
}

// Lookahead: is this ( the start of an arrow closure?
pub fn isArrowClosure(p: &mut Parser): bool {
    // scan to the ) matching the ( at p.pos; a closure follows with `=>` (or a
    // `:` return type then `=>`). Handles untyped params `(x) => …` too.
    var i = p.pos + 1
    var depth = 1
    while depth > 0 && i < p.tokens.len {
        if p.tokens[i].kind == TokKind.LParen {
            depth = depth + 1
        } 
        else if p.tokens[i].kind == TokKind.RParen {
            depth = depth - 1
        }
        i = i + 1
    }
    if i >= p.tokens.len {
        return false
    }
    if p.tokens[i].kind == TokKind.FatArrow {
        return true
    }
    if p.tokens[i].kind == TokKind.Colon {
        return true
    }
    return false
}

pub fn parseClosure(p: &mut Parser, s: Option<Span>, isMove: bool): Heap<ExprNode> {
    expect(&mut p, TokKind.LParen)
    var params: Vec<Param> = Vec.new()
    while !at(p, TokKind.RParen) && !at(p, TokKind.Eof) {
        params.push(parseParam(&mut p))
        if !at(p, TokKind.RParen) {
            expect(&mut p, TokKind.Comma)
        }
    }
    expect(&mut p, TokKind.RParen)
    var retType: Option<MiloType> = Option.None
    if at(p, TokKind.Colon) {
        advance(&mut p)
        retType = Option.Some(parseType(&mut p))
    }
    expect(&mut p, TokKind.FatArrow)
    var body: Vec<Heap<Stmt>> = Vec.new()
    if matchTok(&mut p, TokKind.LBrace) {
        body = parseStmts(&mut p)
        expect(&mut p, TokKind.RBrace)
    } else {
        let expr = parseExpr(&mut p)
        body.push(Heap(Stmt.Return(Option.Some(expr), Option.None)))
    }
    return mkExpr(Expr.Closure(params, retType, body, isMove), s)
}

// Rewrite a block's trailing statement-form if/else into an if-expression, in
// place, recursing so deeply-nested arms convert too. Needed because an
// if-expression arm is parsed as a statement block: a tail `if a {…} else {…}`
// comes back as an IfStmt, which carries no value, yet in this position it is
// the arm's value.
fn valueTailToExpr(body: &mut Vec<Heap<Stmt>>) {
    if body.len == 0 {
        return
    }
    let lastIdx = body.len - 1
    // Built inside the match but installed after it, so the scrutinee isn't
    // written while it is still borrowed.
    var rewritten: Option<Heap<Stmt>> = Option.None
    match *body[lastIdx] {
        Stmt.IfStmt(cond, thenB, elseB, sp) => {
            match elseB {
                Option.Some(eb) => {
                    var t = cloneStmts(thenB)
                    var e = cloneStmts(eb)
                    valueTailToExpr(&mut t)
                    valueTailToExpr(&mut e)
                    let asExpr = mkExpr(Expr.IfExpr(Heap((*cond).clone()), t, e), cloneSpan(sp))
                    rewritten = Option.Some(Heap(Stmt.ExprStmt(asExpr, cloneSpan(sp))))
                }
                Option.None => {
                }
            }
        }
        _ => {
        }
    }
    match rewritten {
        Option.Some(st) => {
            body[lastIdx] = st
        }
        Option.None => {
        }
    }
}

// if-else in expression position: `if cond { stmts… value } else { … }`. Split
// out of parsePrimary so an `else if` chain recurses straight back in rather
// than round-tripping through primary dispatch.
pub fn parseIfExprTail(p: &mut Parser, s: Option<Span>): Heap<ExprNode> {
    expect(&mut p, TokKind.If)
    // Same no-struct-literal rule the STATEMENT form uses, which this arm was
    // missing: without it `if n - pos < MAXMATCH {` reads `MAXMATCH { n - pos }` as a
    // struct literal and dies on the `-`, so every `let x = if …` in std failed.
    let savedNoStruct = p.noStructLit
    p.noStructLit = true
    let cond = parseExpr(&mut p)
    p.noStructLit = savedNoStruct
    expect(&mut p, TokKind.LBrace)
    var thenBody = parseStmts(&mut p)
    expect(&mut p, TokKind.RBrace)
    expect(&mut p, TokKind.Else)
    var elseBody: Vec<Heap<Stmt>> = Vec.new()
    if at(p, TokKind.If) {
        let innerSpan = span(p, peek(p))
        let chained = parseIfExprTail(&mut p, cloneSpan(innerSpan))
        elseBody.push(Heap(Stmt.ExprStmt(chained, cloneSpan(innerSpan))))
    } else {
        expect(&mut p, TokKind.LBrace)
        elseBody = parseStmts(&mut p)
        expect(&mut p, TokKind.RBrace)
    }
    valueTailToExpr(&mut thenBody)
    valueTailToExpr(&mut elseBody)
    return mkExpr(Expr.IfExpr(cond, thenBody, elseBody), s)
}

pub fn parsePrimary(p: &mut Parser): Heap<ExprNode> {
    let tok = peek(p)
    let s = span(p, tok)

    // `@embedFile("path")` — sigil spelling of the compile-time embed builtin.
    // Drop the '@' and re-enter: the bare and sigil forms lower identically, and
    // the deprecation warning for the bare form lives in the TS checker only.
    if tok.kind == TokKind.At && peekN(p, 1).kind == TokKind.Ident && (peekN(p, 1).value == "embedFile" || peekN(p, 1).value == "targetOs") {
        advance(&mut p)
        return parsePrimary(&mut p)
    }

    if tok.kind == TokKind.If {
        return parseIfExprTail(&mut p, s)
    }

    // match expression: each arm yields a value — bare `P => v` (wrapped in a
    // one-statement ExprStmt body, same shape checker/codegen already handle for
    // Stmt.MatchStmt) or a braced block `P => { .. v }` whose LAST statement is the
    // value (an ExprStmt) or a diverging stmt (return/break/continue), which simply
    // contributes no value — mirrors the statement-match arm-body shape exactly, so
    // pattern binding, exhaustiveness and move-checking are reused, not reimplemented.
    if tok.kind == TokKind.Match {
        advance(&mut p)
        let savedNoStruct = p.noStructLit
        p.noStructLit = true
        let subject = parseExpr(&mut p)
        p.noStructLit = savedNoStruct
        expect(&mut p, TokKind.LBrace)
        var arms: Vec<MatchArm> = Vec.new()
        while !at(p, TokKind.RBrace) && !at(p, TokKind.Eof) {
            let pattern = parsePattern(&mut p)
            expect(&mut p, TokKind.FatArrow)
            var body: Vec<Heap<Stmt>> = Vec.new()
            if at(p, TokKind.LBrace) {
                advance(&mut p)
                body = parseStmts(&mut p)
                expect(&mut p, TokKind.RBrace)
            } else {
                let es = span(p, peek(p))
                let ve = parseExpr(&mut p)
                body.push(Heap(Stmt.ExprStmt(ve, es)))
            }
            arms.push(MatchArm {
                pattern: pattern, body: body
            }
            )
            // optional separator between bare arms (`0 => "zero", 1 => "one"`);
            // braced arms need none, so this is a no-op when absent.
            matchTok(&mut p, TokKind.Comma)
        }
        expect(&mut p, TokKind.RBrace)
        return mkExpr(Expr.MatchExpr(subject, arms), s)
    }

    if tok.kind == TokKind.Int {
        advance(&mut p)
        return mkExpr(Expr.IntLit(intLiteralBits(tok.value)), s)
    }
    if tok.kind == TokKind.Float {
        advance(&mut p)
        return mkExpr(Expr.FloatLit(tok.value.parseF64() ?? 0.0), s)
    }
    if tok.kind == TokKind.True {
        advance(&mut p)
        return mkExpr(Expr.BoolLit(true), s)
    }
    if tok.kind == TokKind.False {
        advance(&mut p)
        return mkExpr(Expr.BoolLit(false), s)
    }
    if tok.kind == TokKind.Null {
        advance(&mut p)
        var emptyArgs: Vec<Heap<ExprNode>> = Vec.new()
        var emptyTypeArgs: Vec<MiloType> = Vec.new()
        return mkExpr(Expr.EnumLit("Option", "None", emptyArgs), s)
    }
    if tok.kind == TokKind.String {
        advance(&mut p)
        return mkExpr(Expr.StringLit(tok.value), s)
    }
    if tok.kind == TokKind.FString {
        advance(&mut p)
        return parseFString(tok.value, s)
    }
    if tok.kind == TokKind.Char {
        advance(&mut p)
        return mkExpr(Expr.CharLit(intLiteralBits(tok.value) as i32), s)
    }
    if tok.kind == TokKind.Ident {
        advance(&mut p)
        // Enum variant: Name.Variant
        if at(p, TokKind.Dot) && tok.value[0] >= 65 && tok.value[0] <= 90 {
            advance(&mut p)
            let variant = expect(&mut p, TokKind.Ident).value
            var args: Vec<Heap<ExprNode>> = Vec.new()
            if matchTok(&mut p, TokKind.LParen) {
                while !at(p, TokKind.RParen) && !at(p, TokKind.Eof) {
                    args.push(parseArg(&mut p))
                    matchTok(&mut p, TokKind.Comma)
                }
                expect(&mut p, TokKind.RParen)
            }
            return mkExpr(Expr.EnumLit(tok.value, variant, args), s)
        }
        // Struct literal: Name { ... } — but not in condition position, where the
        // `{` opens the if/while/match block, not a struct-literal body.
        if at(p, TokKind.LBrace) && !p.noStructLit && tok.value[0] >= 65 && tok.value[0] <= 90 {
            return parseStructLit(&mut p, tok.value, s)
        }
        // Function call: name(args) or name<T>(args). A '(' on a NEW line is
        // the next statement, not call args — milo has no semicolons.
        if at(p, TokKind.LParen) && peek(p).line == tok.line {
            return parseCall(&mut p, tok.value, s)
        }
        if isTypeArgCall(p) {
            advance(&mut p)
            var typeArgs: Vec<MiloType> = Vec.new()
            typeArgs.push(parseType(&mut p))
            while matchTok(&mut p, TokKind.Comma) {
                typeArgs.push(parseType(&mut p))
            }
            expect(&mut p, TokKind.Gt)
            // Type<Args>.method(args) — static call on an instantiated type,
            // encoded as Call("Type.method", args, typeArgs)
            var callName = tok.value.clone()
            if at(p, TokKind.Dot) {
                advance(&mut p)
                let methodName = expect(&mut p, TokKind.Ident).value
                callName = callName + "." + methodName
            }
            expect(&mut p, TokKind.LParen)
            var args: Vec<Heap<ExprNode>> = Vec.new()
            while !at(p, TokKind.RParen) && !at(p, TokKind.Eof) {
                if at(p, TokKind.Eof) {
                    break
                }
                args.push(parseArg(&mut p))
                matchTok(&mut p, TokKind.Comma)
            }
            expect(&mut p, TokKind.RParen)
            return mkExpr(Expr.Call(callName, args, typeArgs), s)
        }
        return mkExpr(Expr.Ident(tok.value), s)
    }
    // Array literal: [a, b, c]
    if tok.kind == TokKind.LBracket {
        return parseArrayLit(&mut p)
    }
    // move closure
    if tok.kind == TokKind.Move {
        advance(&mut p)
        if at(p, TokKind.LParen) && isArrowClosure(&mut p) {
            return parseClosure(&mut p, s, true)
        }
        // error: move must precede closure
        parseError(&mut p, tok, "'move' must precede a closure", "")
        return mkExpr(Expr.Ident("error_move"), s)
    }
    // Parenthesized expr or closure
    if tok.kind == TokKind.LParen {
        if isArrowClosure(&mut p) {
            return parseClosure(&mut p, s, false)
        }
        advance(&mut p)
        let expr = parseExpr(&mut p)
        expect(&mut p, TokKind.RParen)
        return expr
    }

    // Anonymous JSON object literal `{ key: value, … }` (or empty `{}`)
    if tok.kind == TokKind.LBrace {
        let n1 = peekN(p, 1)
        let n2 = peekN(p, 2)
        if n1.kind == TokKind.RBrace || (n1.kind == TokKind.Ident && n2.kind == TokKind.Colon) {
            return parseJsonObject(&mut p, s)
        }
    }

    // Fallback — should not reach here in valid input. This used to return the
    // sentinel silently: no diagnostic here meant the ONLY signal was a later
    // "undefined variable 'error_unexpected'" from the checker — confusing, and
    // worse, a program that genuinely declares a variable named `error_unexpected`
    // would have this sentinel silently resolve to it instead of erroring at all
    // (the "generated names a user could also write" defect species). Report the
    // real cause here, same wording as expect()'s mismatch diagnostic.
    parseError(&mut p, tok, "unexpected token '" + tok.value.clone() + "'", "")
    advance(&mut p)
    return mkExpr(Expr.Ident("error_unexpected"), s)
}

pub fn parseStructLit(p: &mut Parser, name: string, s: Option<Span>): Heap<ExprNode> {
    expect(&mut p, TokKind.LBrace)
    var fields: Vec<StructLitField> = Vec.new()
    while !at(p, TokKind.RBrace) && !at(p, TokKind.Eof) {
        let nameTok = expect(&mut p, TokKind.Ident)
        // Span captured before moving `.value` out — partial move would bar the borrow.
        let fieldSpan = span(p, nameTok)
        let fieldName = nameTok.value
        // Field shorthand: `{ x }` desugars to `{ x: x }` (value is the binding named `x`).
        let value = if matchTok(&mut p, TokKind.Colon) {
            parseExpr(&mut p)
        } else {
            mkExpr(Expr.Ident(fieldName.clone()), fieldSpan)
        }
        fields.push(StructLitField {
            name: fieldName, value: value
        }
        )
        matchTok(&mut p, TokKind.Comma)
    }
    expect(&mut p, TokKind.RBrace)
    return mkExpr(Expr.StructLit(name, fields), s)
}

// Anonymous JSON object literal `{ key: value, … }` (no type name). Serializes
// to a JSON string; used by `ctx.json({...})`.
pub fn parseJsonObject(p: &mut Parser, s: Option<Span>): Heap<ExprNode> {
    expect(&mut p, TokKind.LBrace)
    var fields: Vec<StructLitField> = Vec.new()
    while !at(p, TokKind.RBrace) && !at(p, TokKind.Eof) {
        if at(p, TokKind.Eof) {
            break
        }
        let nameTok = expect(&mut p, TokKind.Ident)
        let fieldSpan = span(p, nameTok)
        let fieldName = nameTok.value
        let value = if matchTok(&mut p, TokKind.Colon) {
            parseExpr(&mut p)
        } else {
            mkExpr(Expr.Ident(fieldName.clone()), fieldSpan)
        }
        fields.push(StructLitField {
            name: fieldName, value: value
        }
        )
        matchTok(&mut p, TokKind.Comma)
    }
    expect(&mut p, TokKind.RBrace)
    return mkExpr(Expr.JsonObject(fields), s)
}

pub fn parseCall(p: &mut Parser, name: string, s: Option<Span>): Heap<ExprNode> {
    expect(&mut p, TokKind.LParen)
    var args: Vec<Heap<ExprNode>> = Vec.new()
    while !at(p, TokKind.RParen) && !at(p, TokKind.Eof) {
        // a desynced parse must not spin at EOF forever
        if at(p, TokKind.Eof) {
            break
        }
        args.push(parseArg(&mut p))
        matchTok(&mut p, TokKind.Comma)
    }
    expect(&mut p, TokKind.RParen)
    var typeArgs: Vec<MiloType> = Vec.new()
    return mkExpr(Expr.Call(name, args, typeArgs), s)
}

// Lookahead for `name<T, U>(` — distinguishes a type-arg call from a
// comparison chain without consuming tokens.
pub fn isTypeArgCall(p: &Parser): bool {
    if peek(p).kind != TokKind.Lt {
        return false
    }
    var i: i64 = 1
    var depth: i64 = 1
    while depth > 0 {
        let t = peekN(p, i)
        if t.kind == TokKind.Eof {
            return false
        }
        if t.kind == TokKind.Lt {
            depth = depth + 1
        }
        if t.kind == TokKind.Gt {
            depth = depth - 1
        }
        if depth > 0 {
            // only type-ish tokens may appear inside the angle brackets; Lt/Gt are
            // allowed so NESTED generics parse (`Channel<Vec<T>>.new`).
            if t.kind != TokKind.Ident && t.kind != TokKind.Comma &&
            t.kind != TokKind.Star && t.kind != TokKind.LBracket &&
            t.kind != TokKind.RBracket && t.kind != TokKind.Semicolon &&
            t.kind != TokKind.Int && t.kind != TokKind.Amp &&
            t.kind != TokKind.Lt && t.kind != TokKind.Gt {
                return false
            }
        }
        i = i + 1
    }
    // `(` = generic call; `.` = static method on an instantiated type
    let after = peekN(p, i).kind
    return after == TokKind.LParen || after == TokKind.Dot
}

pub fn parseArrayLit(p: &mut Parser): Heap<ExprNode> {
    let s = span(p, peek(p))
    expect(&mut p, TokKind.LBracket)
    var elements: Vec<Heap<ExprNode>> = Vec.new()
    while !at(p, TokKind.RBracket) && !at(p, TokKind.Eof) {
        elements.push(parseExpr(&mut p))
        // [value; count] repeat syntax
        if elements.len == 1 && matchTok(&mut p, TokKind.Semicolon) {
            let countTok = expect(&mut p, TokKind.Int)
            expect(&mut p, TokKind.RBracket)
            return mkExpr(Expr.ArrayRepeat(elements[0], intLiteralBits(countTok.value)), s)
        }
        matchTok(&mut p, TokKind.Comma)
    }
    expect(&mut p, TokKind.RBracket)
    return mkExpr(Expr.ArrayLit(elements), s)
}

// F-string: $"hello {name}" → format("hello ", name)
pub fn parseFString(raw: string, s: &Option<Span>): Heap<ExprNode> {
    var args: Vec<Heap<ExprNode>> = Vec.new()
    var lit = ""
    var hadInterp = false
    var i: i64 = 0
    // The embedded `${expr}` gets its own sub-parser (see below); it inherits
    // the f-string's own file rather than defaulting to "" so a diagnostic
    // inside the interpolation still attributes correctly.
    var subFile = ""
    match s {
        Option.Some(sp) => {
            subFile = sp.file.clone()
        }
        Option.None => {
        }
    }
    while i < raw.len {
        if raw[i] == 123 { // '{'
            hadInterp = true
            if lit.len > 0 {
                args.push(mkExpr(Expr.StringLit(lit), cloneSpan(s)))
                lit = ""
            }
            i = i + 1
            var depth = 1
            var exprStr = ""
            while i < raw.len && depth > 0 {
                if raw[i] == 123 {
                    depth = depth + 1
                } 
                else if raw[i] == 125 { // '}'
                    depth = depth - 1
                    if depth == 0 {
                        i = i + 1
                        break
                    }
                }
                exprStr.push(raw[i])
                i = i + 1
            }
            // Re-lex and parse the embedded expression
            let exprTokens = tokenize(exprStr)
            var subParser = newParser(exprTokens, subFile.clone())
            args.push(parseExpr(&mut subParser))
        } else if i + 2 < raw.len && raw[i] == 0xEF && raw[i + 1] == 0x9D && (raw[i + 2] == 0xBB || raw[i + 2] == 0xBD) {
            // Resolve the lexer's escaped-brace sentinel (U+F77B/U+F77D, UTF-8
            // EF 9D BB / EF 9D BD — see lexFString) back to a real brace, but
            // only here, in a literal run. Doing it earlier would put a real
            // `{`/`}` back into `raw` and reopen the exact ambiguity the
            // sentinel exists to remove (the brace-scan above would then treat
            // an escaped `\{` as an interpolation opener again).
            if raw[i + 2] == 0xBB {
                lit.push(123 as u8)
            } else {
                lit.push(125 as u8)
            }
            i = i + 3
        } else {
            lit.push(raw[i])
            i = i + 1
        }
    }
    if lit.len > 0 {
        args.push(mkExpr(Expr.StringLit(lit), cloneSpan(s)))
    }
    // Only short-circuit a pure-text f-string (`$"hello"` → "hello"). A single
    // INTERPOLATION (`$"{x}"`) must still go through format() to stringify x —
    // returning the raw expr yielded its own type (e.g. f64), not a string.
    if args.len == 1 && !hadInterp {
        return Heap(args[0].clone())
    }
    var typeArgs: Vec<MiloType> = Vec.new()
    return mkExpr(Expr.Call("format", args, typeArgs), cloneSpan(s))
}

// -- Top-level parse entry point --

pub fn parse(p: &mut Parser): Program {
    var structs: Vec<StructDecl> = Vec.new()
    var enums: Vec<EnumDecl> = Vec.new()
    var functions: Vec<Function> = Vec.new()
    var imports: Vec<ImportDecl> = Vec.new()
    var traits: Vec<TraitDecl> = Vec.new()
    var impls: Vec<ImplDecl> = Vec.new()
    var globals: Vec<GlobalDecl> = Vec.new()
    var typeAliases: Vec<TypeAlias> = Vec.new()
    var linkLibs: Vec<string> = Vec.new()
    var pubNames: Vec<string> = Vec.new()

    while !at(p, TokKind.Eof) {
        // Collect attributes. `@!name` is a MODULE-level directive, not a declaration
        // attribute — it attaches to the file, so it is consumed here. The only one in
        // use is `@!wrapping` (std/sha512.milo): now that arithmetic IS checked by
        // default, this sets p.moduleWrapping so every (non-extern) fn parsed for the
        // rest of THIS file is stamped as if it carried a per-fn `@wrapping` — see the
        // Fn/Extern dispatch below. Was previously dropped outright, back when milo0
        // emitted no overflow traps at all and wrapping was every fn's behavior anyway.
        var attrs: Vec<Attribute> = Vec.new()
        while at(p, TokKind.At) {
            if peekN(p, 1).kind == TokKind.Bang {
                advance(&mut p)
                advance(&mut p)
                let directive = expect(&mut p, TokKind.Ident).value
                if directive == "wrapping" {
                    p.moduleWrapping = true
                }
            } else {
                let a = parseAttribute(&mut p)
                // `@link("SDL2")` names a library for the LINK step, so it belongs to
                // the module rather than to whatever declaration happens to follow it.
                // It still stays in `attrs` — dropping it here would change how the
                // following decl is parsed.
                if a.name == "link" {
                    for ai in 0..a.args.len {
                        linkLibs.push(a.args[ai].clone())
                    }
                }
                attrs.push(a)
            }
        }

        // `pub` carries no meaning for milo0 (visibility is oracle-only), so it is
        // dropped here rather than modeled as a keyword. It must be skipped BEFORE
        // the dispatch below, not after: previously an unrecognized leading `pub`
        // fell through to the "skip unexpected token" catch-all, which restarted
        // the loop and silently dropped any attrs (e.g. `@derive(Eq)`) already
        // collected above — attrs are local to one iteration and only get attached
        // to a decl parsed in that same iteration.
        var isPub = false
        if at(p, TokKind.Ident) && peek(p).value == "pub" {
            advance(&mut p)
            isPub = true
        }

        if at(p, TokKind.Import) || atFromKeyword(p) {
            imports.push(parseImport(&mut p))
        } else if at(p, TokKind.Struct) {
            var s = parseStruct(&mut p)
            if attrs.len > 0 {
                s.attributes = attrs
            }
            structs.push(s)
        } else if at(p, TokKind.Enum) {
            var e = parseEnum(&mut p)
            if attrs.len > 0 {
                e.attributes = attrs
            }
            enums.push(e)
        } else if at(p, TokKind.Extern) {
            // `extern struct` is a C-ABI struct — parse it as a normal struct
            // (milo's manual layout already targets the C ABI).
            if peekN(p, 1).kind == TokKind.Struct {
                advance(&mut p)
                structs.push(parseStruct(&mut p))
            } else if peekN(p, 1).kind == TokKind.Ident && peekN(p, 1).value == "type" {
                // `extern type Name` — an opaque C type, modeled as an empty struct
                // used only through a pointer (`*Name`).
                advance(&mut p)
                advance(&mut p)
                let tyName = expect(&mut p, TokKind.Ident).value
                structs.push(StructDecl {
                    name: tyName, typeParams: Vec.new(), fields: Vec.new(), attributes: Vec.new()
                }
                )
            } else {
                functions.push(parseExternFn(&mut p))
            }
        } else if at(p, TokKind.Fn) {
            var fnDecl = parseFn(&mut p)
            if attrs.len > 0 {
                fnDecl.attributes = attrs
            }
            if p.moduleWrapping {
                var hasWrapping = false
                for wi in 0..fnDecl.attributes.len {
                    if fnDecl.attributes[wi].name == "wrapping" {
                        hasWrapping = true
                    }
                }
                if !hasWrapping {
                    fnDecl.attributes.push(Attribute {
                        name: "wrapping", args: Vec.new()
                    }
                    )
                }
            }
            if isPub {
                pubNames.push(fnDecl.name.clone())
            }
            functions.push(fnDecl)
        } else if at(p, TokKind.Trait) {
            traits.push(parseTraitDecl(&mut p))
        } else if at(p, TokKind.Impl) {
            impls.push(parseImplDecl(&mut p, false))
        } else if at(p, TokKind.Unsafe) && peekN(p, 1).kind == TokKind.Impl {
            advance(&mut p)
            impls.push(parseImplDecl(&mut p, true))
        } else if at(p, TokKind.Let) || at(p, TokKind.Var) {
            let g = parseGlobal(&mut p)
            if isPub {
                pubNames.push(g.name.clone())
            }
            globals.push(g)
        } else if at(p, TokKind.Ident) && peek(p).value == "type" {
            // `type Name = <type>` — a type alias (incl. ranged `i32(min..max)`).
            advance(&mut p)
            let aliasName = expect(&mut p, TokKind.Ident).value
            expect(&mut p, TokKind.Eq)
            let base = parseType(&mut p)
            // optional refinement range `(min..max)` — parsed then discarded here
            // (kept out of parseType so it can't misfire on ordinary annotations)
            if at(p, TokKind.LParen) {
                advance(&mut p)
                if at(p, TokKind.Minus) {
                    advance(&mut p)
                }
                expect(&mut p, TokKind.Int)
                expect(&mut p, TokKind.DotDot)
                if at(p, TokKind.Minus) {
                    advance(&mut p)
                }
                expect(&mut p, TokKind.Int)
                expect(&mut p, TokKind.RParen)
            }
            typeAliases.push(TypeAlias {
                name: aliasName, base: base
            }
            )
        } else {
            // Skip unexpected token
            advance(&mut p)
        }
    }

    // Injected only when a `for .. in ..codePoints()` desugar actually fired —
    // paying the parse/check cost of std/unicode on every module would be wasted
    // for the vast majority that never use the construct.
    if p.codePointLoopCounter > 0 {
        var hasUnicodeImport = false
        for i in 0..imports.len {
            if imports[i].path == "std/unicode" {
                hasUnicodeImport = true
            }
        }
        if !hasUnicodeImport {
            var unicodeNames: Vec<string> = Vec.new()
            unicodeNames.push("CodePoint")
            unicodeNames.push("decodeCodepoint")
            // `aliases` must be index-aligned with `names` (see ImportDecl's doc
            // comment) — an empty Vec here read past its end in collectAliasPairs
            // (resolver.milo), silently tolerated only because nothing bounds-checked
            // that read before this compiler had array bounds checks at all.
            var unicodeAliases: Vec<Option<string>> = Vec.new()
            unicodeAliases.push(Option.None)
            unicodeAliases.push(Option.None)
            imports.push(ImportDecl {
                path: "std/unicode", names: Option.Some(unicodeNames), aliases: unicodeAliases, span: Option.None
            }
            )
        }
    }

    return Program {
        structs: structs,
        enums: enums,
        functions: functions,
        imports: imports,
        traits: traits,
        impls: impls,
        globals: globals,
        typeAliases: typeAliases,
        linkLibs: linkLibs,
        pubNames: pubNames,
        parseDiagnostics: cloneDiagnostics(p.diagnostics),
    }
}

// Module-scope `let NAME[: T] = <const-expr>`.
pub fn parseGlobal(p: &mut Parser): GlobalDecl {
    let s = span(p, peek(p))
    var mutable = false
    if at(p, TokKind.Var) {
        expect(&mut p, TokKind.Var)
        mutable = true
    } else {
        expect(&mut p, TokKind.Let)
    }
    let name = expect(&mut p, TokKind.Ident).value
    var ty: Option<MiloType> = Option.None
    if matchTok(&mut p, TokKind.Colon) {
        ty = Option.Some(parseType(&mut p))
    }
    expect(&mut p, TokKind.Eq)
    let value = parseExpr(&mut p)
    return GlobalDecl {
        name: name, ty: ty, value: value, mutable: mutable, span: s
    }
}
