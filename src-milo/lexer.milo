// Milo lexer — self-hosted port of src/lexer.ts
from "src-milo/tokens.milo" import {
    TokKind, TriviaKind, Trivia, Token, keywordKind
}

pub struct Lexer {
    src: string,
    pos: i64,
    line: i32,
    col: i32,
}

pub fn newLexer(src: string): Lexer {
    return Lexer {
        src: src, pos: 0, line: 1, col: 1
    }
}

// -- helpers --

pub fn isDigit(c: u8): bool {
    return c >= 48 && c <= 57
}

pub fn isAlpha(c: u8): bool {
    return (c >= 65 && c <= 90) || (c >= 97 && c <= 122) || c == 95
}

pub fn isAlnum(c: u8): bool {
    return isDigit(c) || isAlpha(c)
}

pub fn isHexDigit(c: u8): bool {
    return isDigit(c) || (c >= 65 && c <= 70) || (c >= 97 && c <= 102)
}

pub fn hexVal(c: u8): i64 {
    if c >= 48 && c <= 57 {
        return (c - 48) as i64
    }
    if c >= 65 && c <= 70 {
        return (c - 55) as i64
    }
    if c >= 97 && c <= 102 {
        return (c - 87) as i64
    }
    return 0
}

pub fn peekChar(lex: &Lexer): u8 {
    if lex.pos < lex.src.len {
        return lex.src[lex.pos]
    }
    return 0
}

pub fn peekCharAt(lex: &Lexer, offset: i64): u8 {
    let idx = lex.pos + offset
    if idx < lex.src.len {
        return lex.src[idx]
    }
    return 0
}

pub fn advanceChar(lex: &mut Lexer): u8 {
    let ch = lex.src[lex.pos]
    lex.pos = lex.pos + 1
    if ch == 10 {
        lex.line = lex.line + 1
        lex.col = 1
    } else if ch < 128 || ch >= 192 {
        // only count non-continuation bytes (matches TS character-based col tracking)
        lex.col = lex.col + 1
    }
    return ch
}

pub fn lexError(msg: &string, line: i32, col: i32) {
    eprint($"error[lex]: {line}:{col}: {msg}")
    unsafe {
        exit(1)
    }
}

// -- trivia --

pub fn readLeadingTrivia(lex: &mut Lexer): Vec<Trivia> {
    var trivia: Vec<Trivia> = Vec.new()
    var newlines: i32 = 0
    var emittedBlank = false
    while lex.pos < lex.src.len {
        let ch = peekChar(lex)
        if ch == 10 {
            newlines = newlines + 1
            advanceChar(&mut lex)
            if newlines >= 2 && !emittedBlank {
                trivia.push(Trivia {
                    kind: TriviaKind.Blank, text: "", line: lex.line
                })
                emittedBlank = true
            }
        } else if ch == 32 || ch == 9 || ch == 13 {
            advanceChar(&mut lex)
        } else if ch == 47 && peekCharAt(lex, 1) == 47 {
            let commentLine = lex.line
            var text: string = ""
            while lex.pos < lex.src.len && peekChar(lex) != 10 {
                text.push(advanceChar(&mut lex))
            }
            trivia.push(Trivia {
                kind: TriviaKind.Comment, text: text, line: commentLine
            })
            newlines = 0
            emittedBlank = false
        } else {
            break
        }
    }
    return trivia
}

pub fn readTrailingTrivia(lex: &mut Lexer): Vec<Trivia> {
    while lex.pos < lex.src.len {
        let ch = peekChar(lex)
        if ch == 32 || ch == 9 || ch == 13 {
            advanceChar(&mut lex)
        } else {
            break
        }
    }
    if peekChar(lex) == 47 && peekCharAt(lex, 1) == 47 {
        let commentLine = lex.line
        var text: string = ""
        while lex.pos < lex.src.len && peekChar(lex) != 10 {
            text.push(advanceChar(&mut lex))
        }
        var result: Vec<Trivia> = Vec.new()
        result.push(Trivia {
            kind: TriviaKind.Comment, text: text, line: commentLine
        })
        return result
    }
    var empty: Vec<Trivia> = Vec.new()
    return empty
}

// -- literal lexing --

pub fn lexHexEscape(lex: &mut Lexer): u8 {
    let h1 = advanceChar(&mut lex)
    let h2 = advanceChar(&mut lex)
    return (hexVal(h1) * 16 + hexVal(h2)) as u8
}

// `\u{H..}` — a Unicode scalar, appended as its UTF-8 bytes. Distinct from `\xNN`,
// which names one raw byte and bypasses UTF-8 entirely. Returns the scalar so the
// char-literal caller can reject the ones that need more than a byte.
pub fn lexUnicodeEscape(lex: &mut Lexer, line: i32, col: i32): i32 {
    if advanceChar(&mut lex) != 123 {
        lexError("expected '{' after \\u", line, col)
    }
    var hex: string = ""
    while lex.pos < lex.src.len && peekChar(lex) != 125 {
        hex.push(advanceChar(&mut lex))
    }
    if lex.pos >= lex.src.len {
        lexError("unterminated \\u{...} escape", line, col)
    }
    advanceChar(&mut lex)
    if hex.len == 0 || hex.len > 6 {
        lexError("invalid \\u{" + hex.clone() + "}: expected 1-6 hex digits", line, col)
    }
    var cp: i32 = 0
    var hi: i64 = 0
    while hi < hex.len {
        let d = hex[hi]
        if !((d >= 48 && d <= 57) || (d >= 97 && d <= 102) || (d >= 65 && d <= 70)) {
            lexError("invalid \\u{" + hex.clone() + "}: expected 1-6 hex digits", line, col)
        }
        cp = cp * 16 + (hexVal(d) as i32)
        hi = hi + 1
    }
    // Surrogates are not scalars; UTF-8 has no encoding for them, so accepting one
    // would emit bytes no decoder will accept back.
    if cp > 0x10FFFF || (cp >= 0xD800 && cp <= 0xDFFF) {
        lexError("invalid \\u{" + hex.clone() + "}: not a Unicode scalar value", line, col)
    }
    return cp
}

pub fn pushUtf8(value: &mut string, cp: i32) {
    if cp < 0x80 {
        value.push(cp as u8)
    } else if cp < 0x800 {
        value.push((0xC0 + (cp / 64)) as u8)
        value.push((0x80 + (cp % 64)) as u8)
    } else if cp < 0x10000 {
        value.push((0xE0 + (cp / 4096)) as u8)
        value.push((0x80 + ((cp / 64) % 64)) as u8)
        value.push((0x80 + (cp % 64)) as u8)
    } else {
        value.push((0xF0 + (cp / 262144)) as u8)
        value.push((0x80 + ((cp / 4096) % 64)) as u8)
        value.push((0x80 + ((cp / 64) % 64)) as u8)
        value.push((0x80 + (cp % 64)) as u8)
    }
}

// An escape this lexer does not know is a lex error, never a silently-dropped
// backslash: `"\u{1b}[32m"` used to lex as the literal text `u{1b}[32m` and ship
// escape codes into stdout as garbage, with nothing to look at but the output.
pub fn isKnownEscape(c: u8, inFString: bool): bool {
    // 39 is `\'`: pointless in a string but legal in Rust, and GLSL/shader source
    // embedded as a Milo string carries it in prose comments.
    if c == 110 || c == 116 || c == 114 || c == 92 || c == 34 || c == 39 || c == 48 || c == 120 || c == 117 {
        return true
    }
    return inFString && (c == 123 || c == 125)
}

pub fn escapeName(c: u8): string {
    var s: string = "\\"
    s.push(c)
    return s
}

pub fn resolveEscape(c: u8): u8 {
    if c == 110 {
        return 10
    }
    if c == 116 {
        return 9
    }
    if c == 114 {
        return 13
    }
    if c == 92 {
        return 92
    }
    if c == 34 {
        return 34
    }
    if c == 48 {
        return 0
    }
    return c
}

pub fn lexString(lex: &mut Lexer, line: i32, col: i32): Token {
    advanceChar(&mut lex)
    var value: string = ""
    while peekChar(lex) != 34 {
        if lex.pos >= lex.src.len {
            lexError("unterminated string", line, col)
        }
        let ch = advanceChar(&mut lex)
        if ch == 92 {
            let esc = advanceChar(&mut lex)
            if esc == 120 {
                value.push(lexHexEscape(&mut lex))
            } else if esc == 117 {
                pushUtf8(&mut value, lexUnicodeEscape(&mut lex, line, col))
            } else if isKnownEscape(esc, false) {
                value.push(resolveEscape(esc))
            } else {
                lexError("unknown escape sequence '" + escapeName(esc) + "'", line, col)
            }
        } else {
            value.push(ch)
        }
    }
    advanceChar(&mut lex)
    var lt: Vec<Trivia> = Vec.new()
    var tt: Vec<Trivia> = Vec.new()
    return Token {
        kind: TokKind.String, value: value, line: line, col: col, leadingTrivia: lt, trailingTrivia: tt
    }
}

pub fn lexChar(lex: &mut Lexer, line: i32, col: i32): Token {
    advanceChar(&mut lex)
    if lex.pos >= lex.src.len {
        lexError("unterminated char literal", line, col)
    }
    var value: i32 = 0
    if peekChar(lex) == 92 {
        advanceChar(&mut lex)
        let esc = advanceChar(&mut lex)
        if esc == 110 {
            value = 10
        } else if esc == 116 {
            value = 9
        } else if esc == 114 {
            value = 13
        } else if esc == 92 {
            value = 92
        } else if esc == 39 {
            value = 39
        } else if esc == 48 {
            value = 0
        } else if esc == 120 {
            value = lexHexEscape(&mut lex) as i32
        } else if esc == 117 {
            // A char is one byte, so only the Latin-1 range has a single-byte form.
            value = lexUnicodeEscape(&mut lex, line, col)
            if value > 0xFF {
                lexError("\\u{...} does not fit in a char (one byte); use a string", line, col)
            }
        } else {
            lexError("unknown escape sequence '" + escapeName(esc) + "'", line, col)
        }
    } else {
        value = advanceChar(&mut lex) as i32
    }
    if peekChar(lex) != 39 {
        lexError("unterminated char literal", line, col)
    }
    advanceChar(&mut lex)
    var lt: Vec<Trivia> = Vec.new()
    var tt: Vec<Trivia> = Vec.new()
    return Token {
        kind: TokKind.Char, value: value.toString(), line: line, col: col, leadingTrivia: lt, trailingTrivia: tt
    }
}

pub fn lexFString(lex: &mut Lexer, line: i32, col: i32): Token {
    advanceChar(&mut lex)
    advanceChar(&mut lex)
    var value: string = ""
    var braceDepth: i32 = 0
    while true {
        if lex.pos >= lex.src.len {
            lexError("unterminated string", line, col)
        }
        let ch = advanceChar(&mut lex)
        if braceDepth == 0 {
            if ch == 92 {
                let esc = advanceChar(&mut lex)
                if esc == 120 {
                    value.push(lexHexEscape(&mut lex))
                } else if esc == 110 {
                    value.push(10 as u8)
                } else if esc == 116 {
                    value.push(9 as u8)
                } else if esc == 114 {
                    value.push(13 as u8)
                } else if esc == 92 {
                    value.push(92 as u8)
                } else if esc == 34 {
                    value.push(34 as u8)
                } else if esc == 39 {
                    value.push(39 as u8)
                } else if esc == 48 {
                    value.push(0 as u8)
                } else if esc == 123 {
                    // `\{` must NOT become a literal `{` here: the parser's brace
                    // scan (parseFString) re-walks this token's value looking for
                    // '{'/'}' bytes to find interpolation openers, and a real `{`
                    // is indistinguishable from one the author escaped. That made
                    // `$"\{\"id\": \"{id}\"}"` swallow the whole JSON-looking
                    // prefix as an expression instead of printing it literally.
                    // Emit a private-use-area sentinel instead (U+F77B, UTF-8
                    // EF 9D BB — same codepoint the oracle's lexer.ts uses); the
                    // parser converts it back to a real `{` only when flushing a
                    // literal run, never while brace-scanning.
                    value.push(0xEF as u8)
                    value.push(0x9D as u8)
                    value.push(0xBB as u8)
                } else if esc == 125 {
                    // `\}` mirror of `\{` above — U+F77D, UTF-8 EF 9D BD.
                    value.push(0xEF as u8)
                    value.push(0x9D as u8)
                    value.push(0xBD as u8)
                } else if esc == 117 {
                    // A `\u{7b}` must land on the same sentinel `\{` does, or it
                    // reopens the interpolation hole the sentinels exist to close.
                    let cp = lexUnicodeEscape(&mut lex, line, col)
                    if cp == 0x7B {
                        value.push(0xEF as u8)
                        value.push(0x9D as u8)
                        value.push(0xBB as u8)
                    } else if cp == 0x7D {
                        value.push(0xEF as u8)
                        value.push(0x9D as u8)
                        value.push(0xBD as u8)
                    } else {
                        pushUtf8(&mut value, cp)
                    }
                } else {
                    lexError("unknown escape sequence '" + escapeName(esc) + "'", line, col)
                }
                continue
            }
            if ch == 34 {
                break
            }
            if ch == 123 {
                braceDepth = braceDepth + 1
                value.push(ch)
                continue
            }
            value.push(ch)
        } else {
            if ch == 123 {
                braceDepth = braceDepth + 1
            }
            if ch == 125 {
                braceDepth = braceDepth - 1
            }
            value.push(ch)
        }
    }
    var lt: Vec<Trivia> = Vec.new()
    var tt: Vec<Trivia> = Vec.new()
    return Token {
        kind: TokKind.FString, value: value, line: line, col: col, leadingTrivia: lt, trailingTrivia: tt
    }
}

// Accumulate in u64, not i64: a 64-bit constant like 0xFFFFFFFFFFFFFFFF is a legal thing
// to WRITE (the checker is what decides whether it fits the annotated type, and says so
// with a range diagnostic). Accumulating in i64 made the lexer itself trap on overflow
// while converting, so the program died before that diagnostic could be produced — and
// with checked arithmetic on by default, that is a crash, not a wrong number.
pub fn hexToDecStr(raw: &string): string {
    var val: u64 = 0
    for i in 0..raw.len {
        val = val * 16 + hexVal(raw[i]) as u64
    }
    return val.toString()
}

pub fn binToDecStr(raw: &string): string {
    var val: u64 = 0
    for i in 0..raw.len {
        val = val * 2 + (raw[i] - 48) as u64
    }
    return val.toString()
}

pub fn lexNumber(lex: &mut Lexer, line: i32, col: i32): Token {
    var lt: Vec<Trivia> = Vec.new()
    var tt: Vec<Trivia> = Vec.new()
    // hex
    if peekChar(lex) == 48 && (peekCharAt(lex, 1) == 120 || peekCharAt(lex, 1) == 88) {
        advanceChar(&mut lex)
        advanceChar(&mut lex)
        var raw: string = ""
        while lex.pos < lex.src.len && (isHexDigit(peekChar(lex)) || peekChar(lex) == 95) {
            let c = advanceChar(&mut lex)
            if c != 95 {
                raw.push(c)
            }
        }
        if raw.len == 0 {
            lexError("hex literal needs at least one digit", line, col)
        }
        return Token {
            kind: TokKind.Int, value: hexToDecStr(raw), line: line, col: col, leadingTrivia: lt, trailingTrivia: tt
        }
    }
    // binary
    if peekChar(lex) == 48 && (peekCharAt(lex, 1) == 98 || peekCharAt(lex, 1) == 66) {
        advanceChar(&mut lex)
        advanceChar(&mut lex)
        var raw: string = ""
        while lex.pos < lex.src.len && (peekChar(lex) == 48 || peekChar(lex) == 49 || peekChar(lex) == 95) {
            let c = advanceChar(&mut lex)
            if c != 95 {
                raw.push(c)
            }
        }
        if raw.len == 0 {
            lexError("binary literal needs at least one digit", line, col)
        }
        return Token {
            kind: TokKind.Int, value: binToDecStr(raw), line: line, col: col, leadingTrivia: lt, trailingTrivia: tt
        }
    }
    // decimal
    var value: string = ""
    while lex.pos < lex.src.len && (isDigit(peekChar(lex)) || peekChar(lex) == 95) {
        let c = advanceChar(&mut lex)
        if c != 95 {
            value.push(c)
        }
    }
    // float: digit(s) then '.' then digit
    if peekChar(lex) == 46 && isDigit(peekCharAt(lex, 1)) {
        value.push(advanceChar(&mut lex))
        while lex.pos < lex.src.len && (isDigit(peekChar(lex)) || peekChar(lex) == 95) {
            let c = advanceChar(&mut lex)
            if c != 95 {
                value.push(c)
            }
        }
        // `1.5e-3` — the exponent belongs to the fractional form too, not only to `1e16`.
        if peekChar(lex) == 101 || peekChar(lex) == 69 {
            let sgn = peekCharAt(lex, 1)
            if isDigit(sgn) || ((sgn == 43 || sgn == 45) && isDigit(peekCharAt(lex, 2))) {
                value.push(advanceChar(&mut lex))
                if peekChar(lex) == 43 || peekChar(lex) == 45 {
                    value.push(advanceChar(&mut lex))
                }
                while lex.pos < lex.src.len && isDigit(peekChar(lex)) {
                    value.push(advanceChar(&mut lex))
                }
            }
        }
        return Token {
            kind: TokKind.Float, value: value, line: line, col: col, leadingTrivia: lt, trailingTrivia: tt
        }
    }
    // Exponent form with no decimal point (`1e16`, `2E+8`): still a float. Without this
    // the lexer stopped at the digits and handed the parser a stray `e16` identifier.
    if peekChar(lex) == 101 || peekChar(lex) == 69 {
        let signCh = peekCharAt(lex, 1)
        let afterSign = peekCharAt(lex, 2)
        if isDigit(signCh) || ((signCh == 43 || signCh == 45) && isDigit(afterSign)) {
            value.push(advanceChar(&mut lex))
            if peekChar(lex) == 43 || peekChar(lex) == 45 {
                value.push(advanceChar(&mut lex))
            }
            while lex.pos < lex.src.len && isDigit(peekChar(lex)) {
                value.push(advanceChar(&mut lex))
            }
            return Token {
                kind: TokKind.Float, value: value, line: line, col: col, leadingTrivia: lt, trailingTrivia: tt
            }
        }
    }
    return Token {
        kind: TokKind.Int, value: value, line: line, col: col, leadingTrivia: lt, trailingTrivia: tt
    }
}

pub fn lexIdent(lex: &mut Lexer, line: i32, col: i32): Token {
    var value: string = ""
    while lex.pos < lex.src.len && isAlnum(peekChar(lex)) {
        value.push(advanceChar(&mut lex))
    }
    let kind = keywordKind(value)
    var lt: Vec<Trivia> = Vec.new()
    var tt: Vec<Trivia> = Vec.new()
    return Token {
        kind: kind, value: value, line: line, col: col, leadingTrivia: lt, trailingTrivia: tt
    }
}

// -- main dispatch --

pub fn makeToken(kind: TokKind, value: string, line: i32, col: i32): Token {
    var lt: Vec<Trivia> = Vec.new()
    var tt: Vec<Trivia> = Vec.new()
    return Token {
        kind: kind, value: value, line: line, col: col, leadingTrivia: lt, trailingTrivia: tt
    }
}

pub fn nextToken(lex: &mut Lexer): Token {
    if lex.pos >= lex.src.len {
        return makeToken(TokKind.Eof, "", lex.line, lex.col)
    }

    let line = lex.line
    let col = lex.col
    let ch = peekChar(lex)

    // f-string
    if ch == 36 && peekCharAt(lex, 1) == 34 {
        return lexFString(&mut lex, line, col)
    }
    // string
    if ch == 34 {
        return lexString(&mut lex, line, col)
    }
    // char
    if ch == 39 {
        return lexChar(&mut lex, line, col)
    }
    // number
    if isDigit(ch) {
        return lexNumber(&mut lex, line, col)
    }
    // ident/keyword
    if isAlpha(ch) {
        return lexIdent(&mut lex, line, col)
    }

    let next = peekCharAt(lex, 1)
    let next2 = peekCharAt(lex, 2)

    // three-char: ...
    if ch == 46 && next == 46 && next2 == 46 {
        advanceChar(&mut lex)
        advanceChar(&mut lex)
        advanceChar(&mut lex)
        return makeToken(TokKind.DotDotDot, "...", line, col)
    }
    // two-char: ..
    if ch == 46 && next == 46 {
        advanceChar(&mut lex)
        advanceChar(&mut lex)
        return makeToken(TokKind.DotDot, "..", line, col)
    }
    // ->
    if ch == 45 && next == 62 {
        advanceChar(&mut lex)
        advanceChar(&mut lex)
        return makeToken(TokKind.Arrow, "->", line, col)
    }
    // ==
    if ch == 61 && next == 61 {
        advanceChar(&mut lex)
        advanceChar(&mut lex)
        return makeToken(TokKind.EqEq, "==", line, col)
    }
    // =>
    if ch == 61 && next == 62 {
        advanceChar(&mut lex)
        advanceChar(&mut lex)
        return makeToken(TokKind.FatArrow, "=>", line, col)
    }
    // ::
    if ch == 58 && next == 58 {
        advanceChar(&mut lex)
        advanceChar(&mut lex)
        return makeToken(TokKind.ColonColon, "::", line, col)
    }
    // !=
    if ch == 33 && next == 61 {
        advanceChar(&mut lex)
        advanceChar(&mut lex)
        return makeToken(TokKind.Neq, "!=", line, col)
    }
    // <=
    if ch == 60 && next == 61 {
        advanceChar(&mut lex)
        advanceChar(&mut lex)
        return makeToken(TokKind.LtEq, "<=", line, col)
    }
    // >=
    if ch == 62 && next == 61 {
        advanceChar(&mut lex)
        advanceChar(&mut lex)
        return makeToken(TokKind.GtEq, ">=", line, col)
    }
    // ??
    if ch == 63 && next == 63 {
        advanceChar(&mut lex)
        advanceChar(&mut lex)
        return makeToken(TokKind.QuestionQuestion, "??", line, col)
    }
    // compound assignment: += -= *= /= %= &= |= ^= (must precede single-char ops)
    if ch == 43 && next == 61 {
        advanceChar(&mut lex)
        advanceChar(&mut lex)
        return makeToken(TokKind.PlusEq, "+=", line, col)
    }
    if ch == 45 && next == 61 {
        advanceChar(&mut lex)
        advanceChar(&mut lex)
        return makeToken(TokKind.MinusEq, "-=", line, col)
    }
    if ch == 42 && next == 61 {
        advanceChar(&mut lex)
        advanceChar(&mut lex)
        return makeToken(TokKind.StarEq, "*=", line, col)
    }
    if ch == 47 && next == 61 {
        advanceChar(&mut lex)
        advanceChar(&mut lex)
        return makeToken(TokKind.SlashEq, "/=", line, col)
    }
    if ch == 37 && next == 61 {
        advanceChar(&mut lex)
        advanceChar(&mut lex)
        return makeToken(TokKind.PercentEq, "%=", line, col)
    }
    if ch == 38 && next == 61 {
        advanceChar(&mut lex)
        advanceChar(&mut lex)
        return makeToken(TokKind.AmpEq, "&=", line, col)
    }
    if ch == 124 && next == 61 {
        advanceChar(&mut lex)
        advanceChar(&mut lex)
        return makeToken(TokKind.PipeEq, "|=", line, col)
    }
    if ch == 94 && next == 61 {
        advanceChar(&mut lex)
        advanceChar(&mut lex)
        return makeToken(TokKind.CaretEq, "^=", line, col)
    }
    // &&
    if ch == 38 && next == 38 {
        advanceChar(&mut lex)
        advanceChar(&mut lex)
        return makeToken(TokKind.AmpAmp, "&&", line, col)
    }
    // ||
    if ch == 124 && next == 124 {
        advanceChar(&mut lex)
        advanceChar(&mut lex)
        return makeToken(TokKind.PipePipe, "||", line, col)
    }

    // single-char operators
    advanceChar(&mut lex)
    if ch == 40 {
        return makeToken(TokKind.LParen, "(", line, col)
    }
    if ch == 41 {
        return makeToken(TokKind.RParen, ")", line, col)
    }
    if ch == 123 {
        return makeToken(TokKind.LBrace, "{", line, col)
    }
    if ch == 125 {
        return makeToken(TokKind.RBrace, "}", line, col)
    }
    if ch == 91 {
        return makeToken(TokKind.LBracket, "[", line, col)
    }
    if ch == 93 {
        return makeToken(TokKind.RBracket, "]", line, col)
    }
    if ch == 58 {
        return makeToken(TokKind.Colon, ":", line, col)
    }
    if ch == 59 {
        return makeToken(TokKind.Semicolon, ";", line, col)
    }
    if ch == 44 {
        return makeToken(TokKind.Comma, ",", line, col)
    }
    if ch == 46 {
        return makeToken(TokKind.Dot, ".", line, col)
    }
    if ch == 42 {
        return makeToken(TokKind.Star, "*", line, col)
    }
    if ch == 43 {
        return makeToken(TokKind.Plus, "+", line, col)
    }
    if ch == 45 {
        return makeToken(TokKind.Minus, "-", line, col)
    }
    if ch == 47 {
        return makeToken(TokKind.Slash, "/", line, col)
    }
    if ch == 37 {
        return makeToken(TokKind.Percent, "%", line, col)
    }
    if ch == 38 {
        return makeToken(TokKind.Amp, "&", line, col)
    }
    if ch == 61 {
        return makeToken(TokKind.Eq, "=", line, col)
    }
    if ch == 60 {
        return makeToken(TokKind.Lt, "<", line, col)
    }
    if ch == 62 {
        return makeToken(TokKind.Gt, ">", line, col)
    }
    if ch == 33 {
        return makeToken(TokKind.Bang, "!", line, col)
    }
    if ch == 63 {
        return makeToken(TokKind.Question, "?", line, col)
    }
    if ch == 124 {
        return makeToken(TokKind.Pipe, "|", line, col)
    }
    if ch == 94 {
        return makeToken(TokKind.Caret, "^", line, col)
    }
    if ch == 126 {
        return makeToken(TokKind.Tilde, "~", line, col)
    }
    if ch == 64 {
        return makeToken(TokKind.At, "@", line, col)
    }

    lexError("unexpected character", line, col)
    return makeToken(TokKind.Eof, "", line, col)
}

// -- public API --

pub fn tokenize(src: string): Vec<Token> {
    var lex = newLexer(src)
    var tokens: Vec<Token> = Vec.new()
    var pendingLeading = readLeadingTrivia(&mut lex)
    while true {
        var tok = nextToken(&mut lex)
        tok.leadingTrivia = pendingLeading
        if tok.kind
        is
        TokKind.Eof {
            tokens.push(tok)
            break
        }
        tok.trailingTrivia = readTrailingTrivia(&mut lex)
        pendingLeading = readLeadingTrivia(&mut lex)
        tokens.push(tok)
    }
    return tokens
}
