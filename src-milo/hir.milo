// Typed HIR — the boundary the backend reads instead of re-deriving types from syntax.
// Transcribed variant-for-variant from src/hir.ts, which is the spec: same taxonomy, same
// names, so a milo-self bug can be diffed against the oracle on the same input.
from "src-milo/ast.milo" import {
    Span, ExprNode, LiteralKind, TypeAlias, TraitDecl, StructDecl, Function
}
from "src-milo/checker/types.milo" import {
    TypeKind
}

// A lowered expression, its type, and where it came from.
//
// `ty` is Option, not a bare TypeKind, and that is deliberate. Milo has no per-field
// visibility (field-level visibility is all-or-nothing per struct), so an accessor that
// "should" be used instead of the field is convention only — across 9574 lines of
// codegen/expr.milo somebody writes `n.ty`. A bare field on an Unlowered node would have
// to hold something, and the something available is TypeKind.TUnknown: a real, plausible
// value that propagates silently and bottoms out in whatever TUnknown lowers to. That is
// how a type-less node ends up defaulting to i64 with every read returning garbage.
//
// Option has no such sentinel. `n.ty` hands back Option<TypeKind>, which is unusable as a
// type without unwrapping, so the type checker enforces what privacy cannot. The lazy path
// (`n.ty!` instead of hirType) still traps with a panic location rather than going quiet.
//
// Deliberately NOT symmetric with ast.milo's ExprNode, which carries no type at all — an
// AST node is untyped by definition; a HIR node is exactly the thing that isn't.
pub struct HExprNode {
    ty: Option<TypeKind>,
    kind: HExpr,
    span: Option<Span>,
}

// The only blessed read. Aborts naming the node kind rather than inventing a type, so a
// codegen path that reaches an unlowered node during the migration fails loudly at the
// exact node instead of miscompiling around it.
pub fn hirType(n: &HExprNode): TypeKind {
    match n.ty {
        Option.Some(t) => {
            return t.clone()
        }
        Option.None => {
            // exit() before the return, not a returned sentinel: the process dies here.
            // The trailing return exists only because the checker does not know exit()
            // diverges, and TUnknown is precisely the value that must never escape — it
            // is reachable only if exit stopped working.
            eprint("internal error: no type for unlowered " + hexprKindName(n.kind))
            unsafe {
                exit(1)
            }
            return TypeKind.TUnknown
        }
    }
}

pub fn mkHExpr(kind: HExpr, ty: TypeKind, span: Option<Span>): Heap<HExprNode> {
    return Heap(HExprNode {
        ty: Option.Some(ty), kind: kind, span: span
    })
}

// The migration's one sanctioned escape hatch: an AST node codegen has not been taught to
// consume as HIR yet. No type, by construction. When the last construction site is gone,
// `ty` becomes a bare TypeKind and this variant is deleted — and that edit will not compile
// while a single one survives, so the type checker retires the bridge, not a script.
pub fn mkUnlowered(e: Heap<ExprNode>, span: Option<Span>): Heap<HExprNode> {
    return Heap(HExprNode {
        ty: Option.None, kind: HExpr.Unlowered(e), span: span
    })
}

// The one thing a backend path may do when the node it holds is NOT the bridge.
// Milo cannot RETURN the `&ExprNode` inside an Unlowered — second-class references
// — so every seam matches the variant inline and calls this on the other arm.
// Never defaults: a lowered node reaching the untyped walk is a node whose type
// that walk is about to reconstruct from syntax, which is the bug being removed.
pub fn hexprAbort(n: &HExprNode, what: &string) {
    eprint("internal error: " + what.clone() + " reached the untyped backend as a lowered " + hexprKindName(n.kind))
    unsafe {
        exit(1)
    }
}

// -- Arguments --

pub struct HArg {
    expr: Heap<HExprNode>,
    passByRef: bool,
    refMut: bool,
}

// -- Sub-shapes --

pub struct HParam {
    name: string,
    ty: TypeKind,
}

pub struct HCapture {
    name: string,
    ty: TypeKind,
    mutable: bool,
}

pub struct HFieldInit {
    name: string,
    value: Heap<HExprNode>,
}

// `?` on a Propagate whose error type needs wrapping on the way out.
pub struct HPropagateConv {
    targetEnumName: string,
    wrapVariant: string,
    wrapTag: i64,
}

pub enum HMapField {
    MapKey,
    MapValue,
}

pub enum HIterKind {
    IterVec,
    IterString,
    IterHashMap,
    IterArray,
}

pub enum HStrViewMode {
    ViewLines,
    ViewSplit,
}

// -- Expressions --

pub enum HExpr {
    IntLit(i64),
    // Wraps a value flowing into a ranged-int target; codegen emits the value then a
    // runtime bound check on it, yielding the value.
    RangeCheck(Heap<HExprNode>, i64, i64, string),
    FloatLit(f64),
    BoolLit(bool),
    CharLit(i64),
    StringLit(string),
    Ident(string, bool),
    BinOp(string, Heap<HExprNode>, Heap<HExprNode>),
    UnaryOp(string, Heap<HExprNode>),
    Call(string, Vec<HArg>, bool),
    StructLit(string, Vec<HFieldInit>),
    FieldAccess(Heap<HExprNode>, string, bool),
    ArrayLit(Vec<Heap<HExprNode>>),
    ArrayRepeat(Heap<HExprNode>, i64),
    IndexAccess(Heap<HExprNode>, Heap<HExprNode>, bool, bool),
    EnumLit(string, string, Vec<Heap<HExprNode>>),
    ArrayLen(Heap<HExprNode>),
    StringLen(Heap<HExprNode>),
    StringCstr(Heap<HExprNode>),
    VecPtr(Heap<HExprNode>),
    Unwrap(Heap<HExprNode>, string),
    Propagate(Heap<HExprNode>, string, TypeKind, Option<HPropagateConv>),
    DefaultValue(Heap<HExprNode>, Heap<HExprNode>, string),
    Cast(Heap<HExprNode>, TypeKind),
    // `replace(place, value)`: stores value into place WITHOUT dropping the old occupant —
    // it is moved out and returned instead.
    MemReplace(Heap<HExprNode>, Heap<HExprNode>),
    // `swap(a, b)`: exchanges two places in place; drops nothing.
    MemSwap(Heap<HExprNode>, Heap<HExprNode>),
    // `Kind.tryFrom(n)` on a repr'd enum. A fieldless enum's value IS its tag, so the
    // matched integer reconstructs the variant directly.
    EnumTryFrom(string, string, Heap<HExprNode>, Vec<i64>),
    IsCheck(Heap<HExprNode>, i64),
    HeapCreate(Heap<HExprNode>),
    HeapDeref(Heap<HExprNode>),
    PtrDeref(Heap<HExprNode>),
    MatchExpr(Heap<HExprNode>, Vec<HMatchArm>, string, bool),
    VecNew(TypeKind),
    VecWithCapacity(Heap<HExprNode>, TypeKind),
    VecFilled(Heap<HExprNode>, Heap<HExprNode>, TypeKind),
    VecPush(Heap<HExprNode>, Heap<HExprNode>),
    VecPop(Heap<HExprNode>, TypeKind, string),
    VecLen(Heap<HExprNode>),
    VecClone(Heap<HExprNode>, TypeKind),
    HashMapNew(TypeKind, TypeKind),
    HashMapInsert(Heap<HExprNode>, Heap<HExprNode>, Heap<HExprNode>),
    HashMapGet(Heap<HExprNode>, Heap<HExprNode>, string),
    HashMapGetOrDefault(Heap<HExprNode>, Heap<HExprNode>, Heap<HExprNode>),
    HashMapContains(Heap<HExprNode>, Heap<HExprNode>),
    HashMapRemove(Heap<HExprNode>, Heap<HExprNode>),
    HashMapLen(Heap<HExprNode>),
    HashMapWithCapacity(Heap<HExprNode>, TypeKind, TypeKind),
    HashMapClone(Heap<HExprNode>),
    HashMapClear(Heap<HExprNode>),
    // `keys()`/`values()` snapshot the occupied slots into a fresh Vec (deep-cloned — the
    // map keeps its own copy).
    HashMapEntries(Heap<HExprNode>, HMapField),
    StringWithCapacity(Heap<HExprNode>),
    StringPush(Heap<HExprNode>, Heap<HExprNode>),
    StringPushStr(Heap<HExprNode>, Heap<HExprNode>),
    StringSubstr(Heap<HExprNode>, Heap<HExprNode>, Heap<HExprNode>),
    StringSlice(Heap<HExprNode>, Heap<HExprNode>, Heap<HExprNode>),
    VecSlice(Heap<HExprNode>, Heap<HExprNode>, Heap<HExprNode>, TypeKind),
    StringFind(Heap<HExprNode>, Heap<HExprNode>, Option<Heap<HExprNode>>, bool, string),
    StringClone(Heap<HExprNode>),
    NumberToString(Heap<HExprNode>, TypeKind),
    BoolToString(Heap<HExprNode>),
    JsonStringify(Heap<HExprNode>, TypeKind),
    Closure(Vec<HParam>, Vec<Heap<HStmt>>, Vec<HCapture>, TypeKind, bool),
    // indirect call through a bare C function pointer: no env argument
    CFnCall(Heap<HExprNode>, Vec<HArg>),
    ClosureCall(Heap<HExprNode>, Vec<HArg>),
    VecMap(Heap<HExprNode>, Heap<HExprNode>, TypeKind, TypeKind),
    VecFilter(Heap<HExprNode>, Heap<HExprNode>, TypeKind),
    VecEach(Heap<HExprNode>, Heap<HExprNode>, TypeKind),
    VecFind(Heap<HExprNode>, Heap<HExprNode>, TypeKind, string),
    VecAny(Heap<HExprNode>, Heap<HExprNode>, TypeKind),
    VecSum(Heap<HExprNode>, TypeKind),
    VecAll(Heap<HExprNode>, Heap<HExprNode>, TypeKind),
    VecFold(Heap<HExprNode>, Heap<HExprNode>, Heap<HExprNode>, TypeKind),
    VecIsEmpty(Heap<HExprNode>),
    VecEnumerate(Heap<HExprNode>, Heap<HExprNode>, TypeKind),
    VecReverse(Heap<HExprNode>, TypeKind),
    VecSwap(Heap<HExprNode>, Heap<HExprNode>, Heap<HExprNode>, TypeKind),
    VecInsert(Heap<HExprNode>, Heap<HExprNode>, Heap<HExprNode>, TypeKind),
    VecRemove(Heap<HExprNode>, Heap<HExprNode>, TypeKind),
    VecTruncate(Heap<HExprNode>, Heap<HExprNode>, TypeKind),
    VecContains(Heap<HExprNode>, Heap<HExprNode>, TypeKind),
    // Total indexed read: `get(i)`, and the `first()`/`last()` sugar that lowers to it.
    // Out of range yields None instead of the panic `v[i]` raises.
    VecGetOpt(Heap<HExprNode>, Heap<HExprNode>, TypeKind, string),
    VecMinMax(Heap<HExprNode>, TypeKind, bool, string),
    VecIndexOf(Heap<HExprNode>, Heap<HExprNode>, TypeKind, string),
    VecPosition(Heap<HExprNode>, Heap<HExprNode>, TypeKind, string),
    VecExtend(Heap<HExprNode>, Heap<HExprNode>, TypeKind),
    VecRetain(Heap<HExprNode>, Heap<HExprNode>, TypeKind),
    VecCapacity(Heap<HExprNode>),
    VecReserve(Heap<HExprNode>, Heap<HExprNode>, TypeKind),
    VecSort(Heap<HExprNode>, TypeKind),
    VecSortBy(Heap<HExprNode>, Heap<HExprNode>, TypeKind),
    VecSortByKey(Heap<HExprNode>, Heap<HExprNode>, TypeKind, TypeKind),
    WrappingArith(string, Heap<HExprNode>, Heap<HExprNode>),
    SaturatingArith(string, Heap<HExprNode>, Heap<HExprNode>),
    CheckedArith(string, Heap<HExprNode>, Heap<HExprNode>, string),
    BitIntrinsic(string, Heap<HExprNode>, Option<Heap<HExprNode>>),
    OptionOp(string, Heap<HExprNode>, Option<Heap<HExprNode>>, string),
    SizeOf(TypeKind),
    OffsetOf(TypeKind, string),
    Zeroed(TypeKind),
    InterfaceCoerce(Heap<HExprNode>, string, string),
    InterfaceMethodCall(Heap<HExprNode>, string, i64, Vec<HArg>),
    IfExpr(Heap<HExprNode>, Vec<Heap<HStmt>>, Vec<Heap<HStmt>>),
    // An AST node not yet lowered. Carries no type — see mkUnlowered.
    Unlowered(Heap<ExprNode>),
}

// -- Statements --

pub enum HStmt {
    Let(string, TypeKind, Heap<HExprNode>, bool),
    // `isInit` marks a first write into a slot that holds no value yet (the generated
    // module-global initializer). The slot is still zeroinitializer, so running Drop on it
    // would hand a null pointer to a `drop` that dereferences.
    Assign(Heap<HExprNode>, Heap<HExprNode>, bool),
    Return(Option<Heap<HExprNode>>, TypeKind),
    If(Heap<HExprNode>, Vec<Heap<HStmt>>, Option<Vec<Heap<HStmt>>>),
    While(Heap<HExprNode>, Vec<Heap<HStmt>>, Vec<HContract>),
    Break,
    Continue,
    ExprStmt(Heap<HExprNode>),
    Match(Heap<HExprNode>, Vec<HMatchArm>, string, bool),
    UnsafeBlock(Vec<Heap<HStmt>>),
    ForRange(string, TypeKind, Heap<HExprNode>, Heap<HExprNode>, Vec<Heap<HStmt>>, Vec<HContract>),
    ForEach(string, Option<string>, TypeKind, Option<TypeKind>, Heap<HExprNode>, HIterKind, Vec<Heap<HStmt>>, Vec<HContract>),
    // Trailing `okVariant` is a deliberate divergence from src/hir.ts, which has no
    // channel loop at all. src-milo's `for x in ch` drains a Channel via recv() and stops
    // on the closed report, so the sentinel that means "kept going" is Result.Ok there and
    // Option.Some for an ordinary `next()` iterator. Both shapes are otherwise the same
    // loop, so they share this variant rather than growing a second one.
    ForIterator(string, TypeKind, Heap<HExprNode>, string, string, Vec<Heap<HStmt>>, Vec<HContract>, string),
    // `for line in text.lines()` / `for f in text.splitView(sep)`: the loop variable is a
    // `&string` view into src, so no piece is ever copied or allocated.
    ForStrView(string, Option<string>, TypeKind, Heap<HExprNode>, Option<Heap<HExprNode>>, HStrViewMode, Vec<Heap<HStmt>>, Vec<HContract>),
}

pub struct HBinding {
    name: string,
    ty: TypeKind,
}

pub enum HPattern {
    HEnumPattern(string, Vec<HBinding>, i64),
    HLiteralPattern(string, LiteralKind),
    HWildcardPattern,
}

pub struct HMatchArm {
    pattern: HPattern,
    body: Vec<Heap<HStmt>>,
}

// -- Top level --

// Contracts reach codegen so debug builds can assert them at runtime (requires at entry,
// ensures at returns, invariant at the loop header).
pub struct HContract {
    kind: string,
    expr: Heap<HExprNode>,
    span: Option<Span>,
}

pub struct HFnParam {
    name: string,
    ty: TypeKind,
    isRef: bool,
    isRefMut: bool,
}

pub struct HFunction {
    name: string,
    params: Vec<HFnParam>,
    retType: TypeKind,
    body: Vec<Heap<HStmt>>,
    contracts: Vec<HContract>,
    // `let __oldN = <expr>` bindings for every `old(...)` an ensures mentions, emitted at
    // entry ahead of the body — but only in a contract-checking build, so a release binary
    // pays nothing for a clause it never evaluates.
    oldSnapshots: Vec<Heap<HStmt>>,
    isExtern: bool,
    isVariadic: bool,
    // @wrapping: this routine's + - * -x, div INT_MIN/-1 and over-shifts use defined
    // modular arithmetic instead of trapping. Correctness dial only — bounds, div-by-zero
    // and ranged still trap, `as` conversions unchanged.
    isWrapping: bool,
    // Drives what the generated C header declares: the header is the library's published
    // API, so a helper the author never marked `pub` has no business in it.
    isPub: bool,
    // Origin file — DWARF DIFile/DISubprogram, and the partition key for per-module codegen.
    sourceFile: string,
    line: i64,
}

pub struct HStructField {
    name: string,
    ty: TypeKind,
    cOpaque: bool,
}

// From `@cLayout(...)`: verify these field offsets against the real C header at build time.
pub struct HCLayout {
    cType: string,
    header: string,
}

pub struct HStruct {
    name: string,
    fields: Vec<HStructField>,
    isExtern: bool,
    cLayout: Option<HCLayout>,
}

pub struct HEnumVariant {
    name: string,
    tag: i64,
    fields: Vec<TypeKind>,
}

pub struct HEnum {
    name: string,
    variants: Vec<HEnumVariant>,
}

pub struct HGlobal {
    name: string,
    // Declaring file, same role as HFunction.sourceFile: a global must be DEFINED in
    // exactly one object file and declared external in the others, so per-module codegen
    // cannot work without knowing which module owns it.
    sourceFile: string,
    ty: TypeKind,
    value: Heap<HExprNode>,
    mutable: bool,
    threadLocal: bool,
}

pub struct HItable {
    concreteType: string,
    ifaceName: string,
    methods: Vec<string>,
}

// From `@cSig(...)`: extern fn signatures to verify against real C headers at build time.
pub struct HCSig {
    fnName: string,
    header: string,
    sig: string,
    retType: TypeKind,
    params: Vec<TypeKind>,
}

// From `@cValue(...)`: integer constants to verify against the C macros they transcribe.
pub struct HCValue {
    global: string,
    cName: string,
    header: string,
    value: string,
    signed: bool,
}

// One slot of the lifted-body arena. A Closure or an IfExpr arm fills `stmts`; a
// MatchExpr fills `arms` instead, since its bodies only mean anything paired with the
// pattern that selects them. A named struct rather than bare inner Vecs so codegen can
// `replace` a slot's contents out by naming the place.
pub struct HStmtBlock {
    stmts: Vec<Heap<HStmt>>,
    arms: Vec<HMatchArm>,
}

pub struct HIRModule {
    structs: Vec<HStruct>,
    enums: Vec<HEnum>,
    functions: Vec<HFunction>,
    globals: Vec<HGlobal>,
    dropImpls: Vec<string>,
    itables: Vec<HItable>,
    userFnNames: Vec<string>,
    // opaque extern struct names (dropped from `structs` since they have no body) — kept so
    // the C header generator can emit forward `typedef struct X X;` declarations
    opaqueTypes: Vec<string>,
    cSigs: Vec<HCSig>,
    cValues: Vec<HCValue>,
    // From `@link("SDL2")` on extern fns: native libs to pass to the linker.
    linkLibs: Vec<string>,
    // Statement blocks lifted out of the expression-position `Closure`, `IfExpr` and
    // `MatchExpr` nodes reachable from an Unlowered subtree. They cannot be lowered
    // later, on demand: lowering CONSUMES the AST and codegen only ever holds a
    // borrow, so the bodies are moved out here and the AST node left with an empty
    // one. An empty body in the AST is therefore not "no statements" but "look it up",
    // and a missing entry is fatal — never an empty function quietly emitted.
    //
    // A flat arena plus an index, not a map straight to the blocks: HashMap.get hands
    // back a deep COPY, and copying an HStmt means copying enum payloads whose variant
    // the copy cannot see. Blocks are moved out and back, never cloned.
    stmtBlocks: Vec<HStmtBlock>,
    // Owning ExprNode id -> index of its FIRST slot. A node's slots are contiguous and in
    // a fixed order: Closure = one slot (the body); IfExpr = two (then, else); MatchExpr =
    // one, holding all its arms.
    stmtBlockAt: HashMap<u32, i64>,
    // -- transitional --
    //
    // src-milo's backend resolves types as STRINGS, through
    // `resolveTyStr(astTypeStr(...))`, and that pair needs the syntax a TypeKind no
    // longer carries: the alias table to expand a named refinement, the trait decls to
    // name a method's owner, and the per-struct/per-field attributes (@derive, @cLayout,
    // @iter) the checker's StructInfo drops. Carried as the AST decls themselves so no
    // new shape has to be kept in sync with the parser. Deleted when tyStr(cg, &TypeKind)
    // replaces resolveTyStr(astTypeStr(...)) and the backend stops reading syntax.
    astTypeAliases: Vec<TypeAlias>,
    astTraits: Vec<TraitDecl>,
    astStructs: Vec<StructDecl>,
    // Generic function TEMPLATES, unlowered. They have no body to emit — only their
    // instantiations do — but a generic CALL still names the template, and the backend
    // reads that declaration to learn which parameters are by-reference. Get it wrong and
    // the call passes a struct where the callee's definition expects a pointer. Goes when
    // HIRArg carries passByRef and the call site stops asking.
    astGenericFns: Vec<Function>,
}

// Names the node an abort is about. Exhaustive by construction: a new HExpr variant
// without an arm here is a compile error, so the fail-closed path can never go anonymous.
pub fn hexprKindName(k: &HExpr): string {
    match k {
        HExpr.IntLit(_a0) => {
            return "IntLit"
        }
        HExpr.RangeCheck(_a0, _a1, _a2, _a3) => {
            return "RangeCheck"
        }
        HExpr.FloatLit(_a0) => {
            return "FloatLit"
        }
        HExpr.BoolLit(_a0) => {
            return "BoolLit"
        }
        HExpr.CharLit(_a0) => {
            return "CharLit"
        }
        HExpr.StringLit(_a0) => {
            return "StringLit"
        }
        HExpr.Ident(_a0, _a1) => {
            return "Ident"
        }
        HExpr.BinOp(_a0, _a1, _a2) => {
            return "BinOp"
        }
        HExpr.UnaryOp(_a0, _a1) => {
            return "UnaryOp"
        }
        HExpr.Call(_a0, _a1, _a2) => {
            return "Call"
        }
        HExpr.StructLit(_a0, _a1) => {
            return "StructLit"
        }
        HExpr.FieldAccess(_a0, _a1, _a2) => {
            return "FieldAccess"
        }
        HExpr.ArrayLit(_a0) => {
            return "ArrayLit"
        }
        HExpr.ArrayRepeat(_a0, _a1) => {
            return "ArrayRepeat"
        }
        HExpr.IndexAccess(_a0, _a1, _a2, _a3) => {
            return "IndexAccess"
        }
        HExpr.EnumLit(_a0, _a1, _a2) => {
            return "EnumLit"
        }
        HExpr.ArrayLen(_a0) => {
            return "ArrayLen"
        }
        HExpr.StringLen(_a0) => {
            return "StringLen"
        }
        HExpr.StringCstr(_a0) => {
            return "StringCstr"
        }
        HExpr.VecPtr(_a0) => {
            return "VecPtr"
        }
        HExpr.Unwrap(_a0, _a1) => {
            return "Unwrap"
        }
        HExpr.Propagate(_a0, _a1, _a2, _a3) => {
            return "Propagate"
        }
        HExpr.DefaultValue(_a0, _a1, _a2) => {
            return "DefaultValue"
        }
        HExpr.Cast(_a0, _a1) => {
            return "Cast"
        }
        HExpr.MemReplace(_a0, _a1) => {
            return "MemReplace"
        }
        HExpr.MemSwap(_a0, _a1) => {
            return "MemSwap"
        }
        HExpr.EnumTryFrom(_a0, _a1, _a2, _a3) => {
            return "EnumTryFrom"
        }
        HExpr.IsCheck(_a0, _a1) => {
            return "IsCheck"
        }
        HExpr.HeapCreate(_a0) => {
            return "HeapCreate"
        }
        HExpr.HeapDeref(_a0) => {
            return "HeapDeref"
        }
        HExpr.PtrDeref(_a0) => {
            return "PtrDeref"
        }
        HExpr.MatchExpr(_a0, _a1, _a2, _a3) => {
            return "MatchExpr"
        }
        HExpr.VecNew(_a0) => {
            return "VecNew"
        }
        HExpr.VecWithCapacity(_a0, _a1) => {
            return "VecWithCapacity"
        }
        HExpr.VecFilled(_a0, _a1, _a2) => {
            return "VecFilled"
        }
        HExpr.VecPush(_a0, _a1) => {
            return "VecPush"
        }
        HExpr.VecPop(_a0, _a1, _a2) => {
            return "VecPop"
        }
        HExpr.VecLen(_a0) => {
            return "VecLen"
        }
        HExpr.VecClone(_a0, _a1) => {
            return "VecClone"
        }
        HExpr.HashMapNew(_a0, _a1) => {
            return "HashMapNew"
        }
        HExpr.HashMapInsert(_a0, _a1, _a2) => {
            return "HashMapInsert"
        }
        HExpr.HashMapGet(_a0, _a1, _a2) => {
            return "HashMapGet"
        }
        HExpr.HashMapGetOrDefault(_a0, _a1, _a2) => {
            return "HashMapGetOrDefault"
        }
        HExpr.HashMapContains(_a0, _a1) => {
            return "HashMapContains"
        }
        HExpr.HashMapRemove(_a0, _a1) => {
            return "HashMapRemove"
        }
        HExpr.HashMapLen(_a0) => {
            return "HashMapLen"
        }
        HExpr.HashMapWithCapacity(_a0, _a1, _a2) => {
            return "HashMapWithCapacity"
        }
        HExpr.HashMapClone(_a0) => {
            return "HashMapClone"
        }
        HExpr.HashMapClear(_a0) => {
            return "HashMapClear"
        }
        HExpr.HashMapEntries(_a0, _a1) => {
            return "HashMapEntries"
        }
        HExpr.StringWithCapacity(_a0) => {
            return "StringWithCapacity"
        }
        HExpr.StringPush(_a0, _a1) => {
            return "StringPush"
        }
        HExpr.StringPushStr(_a0, _a1) => {
            return "StringPushStr"
        }
        HExpr.StringSubstr(_a0, _a1, _a2) => {
