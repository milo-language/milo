// Checker state — scopes, variable info, diagnostic tracking, type tables
from "src-milo/ast.milo" import {
    Span, Function, StructDecl, EnumDecl, Program, Stmt, ImplDecl, MiloType, Attribute, Diagnostic
}
from "src-milo/checker/types.milo" import {
    TypeKind, typeEq, typeName, tyVoid, isCopy
}

// -- Variable info in scope --

pub struct VarInfo {
    ty: TypeKind,
    mutable: bool,
    moved: bool,
    borrowed: bool,
    read: bool,
    span: Option<Span>,
}

// -- Function signature --

pub struct FnSig {
    params: Vec<FnParam>,
    ret: TypeKind,
    variadic: bool,
    isExtern: bool,
}

pub struct FnParam {
    name: string,
    ty: TypeKind,
}

// -- Struct info (post-resolution) --

pub struct CkStructField {
    name: string,
    ty: TypeKind,
    // `@iter` on this field: `for x in wrapper` walks this field instead of
    // requiring a `next` method — see checkForIn's iterDelegate substitution.
    iterDelegate: bool,
}

pub struct StructInfo {
    fields: Vec<CkStructField>,
    baseName: string,
    // `@noCopy`: move-track this struct even though every field is itself Copy
    // (a resource handle wrapping a bare integer, e.g. a file descriptor or a GL
    // name). Without this, isCopyCk's all-fields-Copy rule makes the struct
    // Copy too, and `f.close()` — a `self: Self` method that consumes the
    // handle — never actually consumes it: the release-then-use double-free
    // this attribute exists to catch would compile clean.
    noCopy: bool,
}

// Whether `attrs` contains a bare attribute named `name` (`@noCopy`, no args).
pub fn hasAttr(attrs: &Vec<Attribute>, name: &string): bool {
    for i in 0..attrs.len {
        if attrs[i].name == name {
            return true
        }
    }
    return false
}

// -- Enum info (post-resolution) --

pub struct VariantInfo {
    tag: i32,
    fields: Vec<TypeKind>,
}

pub struct EnumInfo {
    baseName: string,
    variants: HashMap<string, VariantInfo>,
}

// -- Trait info --

pub struct TraitMethodInfo {
    params: Vec<FnParam>,
    ret: TypeKind,
    hasDefault: bool,
}

pub struct TraitInfo {
    name: string,
    supertraits: Vec<string>,
    methods: HashMap<string, TraitMethodInfo>,
}

pub struct ImplInfo {
    traitName: Option<string>,
    typeName: string,
    methods: HashMap<string, FnSig>,
}

// -- for-in classification --

// Which loop shape a `for x in e` compiles to. The checker already decides this to
// declare the binding's type; recording the answer is what stops the backend deciding
// it a second time from the syntax (see docs/plans/hir-migration.md).
pub enum ForInKind {
    FRange,
    FVec,
    FString,
    FHashMap,
    FArray,
    // a struct with `Type$next(&mut Self): Option<T>`
    FIterator,
    // `for x in ch` drains a Channel via recv() until it reports closed. src/hir.ts has
    // no variant of its own for this — it lowers onto ForIterator, which is why
    // okVariant exists below: the sentinel is Result.Ok here and Option.Some there.
    FChannel,
    // `for line in s.lines()` / `for f in s.splitView(sep)`
    FStrView,
}

// Everything lowering needs to build the HStmt for a `for-in`, keyed by the ITERABLE
// expression's node id. Statements have no id of their own, and the iterable is unique
// per loop, so it stands in as the key.
//
// A missing entry is fail-closed, not a default: lowering aborts naming the loop rather
// than guessing a shape, because every wrong guess here is a miscompile (iterating a
// HashMap's raw slot array as if it were a Vec) and not a diagnostic.
pub struct ForInInfo {
    kind: ForInKind,
    // the loop bindings, exactly as declared into the loop scope
    varTy: TypeKind,
    varTy2: Option<TypeKind>,
    // FIterator/FChannel: the mangled advance method and the enum it hands back
    nextMethod: string,
    resultEnum: string,
    // the variant that means "kept going" — "Some" for an iterator, "Ok" for a channel
    okVariant: string,
    // FStrView: "lines" or "splitView"
    mode: string,
    // `@iter`: the field the loop actually walks. Empty when the iterable is walked
    // directly. Recorded rather than re-derived so a newtype over a container is
    // resolved once, on the checker's own field table.
    delegateField: string,
    delegateFieldTy: TypeKind,
}

pub fn forInInfo(kind: ForInKind, varTy: TypeKind): ForInInfo {
    return ForInInfo {
        kind: kind,
        varTy: varTy,
        varTy2: Option.None,
        nextMethod: "",
        resultEnum: "",
        okVariant: "",
        mode: "",
        delegateField: "",
        delegateFieldTy: TypeKind.TUnknown,
    }
}

// A monomorphized struct instantiation, recorded so generic impls that
// register later (phase 2) can replay against it.
pub struct StructInst {
    base: string,
    mangled: string,
    args: Vec<TypeKind>,
}

// -- Checker state --

// Generic declarations parked until a use site provides concrete type args.
// Live on the Checker (not a separate MonoState) so checkExpr can
// monomorphize on demand at call/literal sites.
pub struct GenericFnInfo {
    typeParams: Vec<string>,
    decl: Function,
}

pub struct GenericStructInfo {
    typeParams: Vec<string>,
    decl: StructDecl,
    fields: Vec<CkStructField>,
}

pub struct GenericEnumInfo {
    typeParams: Vec<string>,
    decl: EnumDecl,
    variants: HashMap<string, VariantInfo>,
}

pub struct PendingVecInfer {
    name: string,
    span: Option<Span>,
}

pub struct Checker {
    diagnostics: Vec<Diagnostic>,
    // Mangled instance name -> the name a user wrote (`Result_P_string` ->
    // `Result<P, string>`). Filled by monomorphizeStruct/Enum, applied to every
    // diagnostic in error()/warn(), so messages match the TS checker's text.
    displayNames: HashMap<string, string>,
    functions: HashMap<string, FnSig>,
    structs: HashMap<string, StructInfo>,
    enums: HashMap<string, EnumInfo>,
    traits: HashMap<string, TraitInfo>,
    traitImpls: HashMap<string, Vec<ImplInfo>>,
    inherentImpls: HashMap<string, ImplInfo>,
    // Raw (unresolved) alias base — resolveAstType expands it LAZILY, at each use
    // site, the same way it resolves any other type annotation. Pre-resolving here
    // with typeFromAst (as this used to) ran during Phase 0, before enums/generic
    // enums are registered, so an aliased enum (`type Parsed = Result<i32, E>`)
    // came back tagged TStruct("Result") with its type args silently dropped —
    // typeFromAst only understands non-generic base types.
    typeAliases: HashMap<string, MiloType>,
    scopes: Vec<HashMap<string, VarInfo>>,
    currentFnRetType: TypeKind,
    loopDepth: i32,
    unsafeDepth: i32,
    monomorphizedFns: Vec<Function>,
    monomorphizedEnums: Vec<EnumDecl>,
    monomorphizedStructs: Vec<StructDecl>,
    dropImpls: HashMap<string, bool>,
    genericFns: HashMap<string, GenericFnInfo>,
    genericStructs: HashMap<string, GenericStructInfo>,
    genericEnums: HashMap<string, GenericEnumInfo>,
    // impl blocks with type params, instantiated when their type monomorphizes
    genericImpls: Vec<ImplDecl>,
    structInsts: Vec<StructInst>,
    // moves inside a return expression never poison later paths — the fn
    // exits, so a flow-insensitive walk must not carry them forward (mirrors
    // the TS checker's returnOnlyMoves)
    inReturn: bool,
    // Expected type at the current expression (from a let annotation), used to
    // infer a generic call's type params when the args don't determine them
    // (`let a: Arena<X> = arenaNew()`).
    expectedType: Option<TypeKind>,
    // Return type captured while checking an unannotated closure body (a Return
    // whose enclosing fnRetType is unknown records its value type here).
    pendingClosureRet: Option<TypeKind>,
    // Structs that are (or will be) JSON-capable: every struct with
    // @derive(Json), pre-marked before any derive body is generated. Without
    // this a self-referential derive (a struct whose own field is Vec<Self>)
    // can't validate its own field type, since its toJson/fromJsonNode don't
    // exist yet at the point its plan is computed — mirrors the TS oracle's
    // jsonCapableStructs pre-pass.
    // Unannotated `var v = Vec.new()` bindings whose element type nothing has
    // supplied yet. An entry is cleared the moment `setVarType` refines the local
    // (which is what a first `push` does); whatever is still here when the program
    // finishes never had an element to infer, and is an error rather than a silently
    // element-less Vec. Mirrors the oracle's pendingInferVecs.
    pendingVecInfer: Vec<PendingVecInfer>,
    jsonCapableStructs: HashMap<string, bool>,
    // The type checkExpr computed for each expression, keyed by ExprNode.id. The backend
    // otherwise re-derives this from syntax as a string, through a partial function whose
    // failure value is read as "skip" — see docs/plans/hir-migration.md. Recorded here so
    // lowering can hand it to codegen instead. Last write wins: a node the checker walks
    // more than once (speculative re-walks) ends up with the type from its final walk,
    // which is the one the rest of the pass acted on.
    exprTypes: HashMap<u32, TypeKind>,
    // The loop shape checkForIn picked, keyed by the ITERABLE expression's node id —
    // see ForInInfo. Statements carry no id, and lowering needs this to choose between
    // the four HStmt for-loop variants without re-running the classification.
    forIns: HashMap<u32, ForInInfo>,
    // Borrow-liveness tracking for views (&[T]/&string) — see checker/borrow.milo.
    // Name-keyed rather than living on VarInfo: VarInfo is looked up BY VALUE
    // (lookup returns a copy; mutation goes through setVar*-and-reinsert), so a
    // side table here avoids threading two more fields through every VarInfo
    // literal in the file. Value is the list of field-paths borrowed off that
    // root; an empty inner path means "whole variable, or an imprecise (index)
    // borrow" — both collapse to the same "conflicts with everything" answer.
    borrowedPaths: HashMap<string, Vec<Vec<string>>>,
    // Index-aligned with `scopes`. A freeze taken to compute a let/var RHS is
    // released immediately UNLESS the binding itself is a view type, in which
    // case it transfers to the new binding's lifetime — release deferred to
    // when the scope holding that binding pops. Mirrors the oracle's
    // VarInfo.freezes, keyed by scope depth instead of by binding identity.
    scopeFreezes: Vec<Vec<string>>,
    // Field chain (from `self`) a view-returning method's body actually reads,
    // keyed by its mangled name ("Ring$items") — recorded by
    // checkViewReturnProvenance before any CALL site is checked, so `r.items()`
    // freezes only `r.data` and leaves `r.b` writable (viewFieldPrecision).
    // Absent means "unknown" (several disagreeing returns, or none at all) —
    // callers then fall back to freezing the whole receiver.
    viewReturnFields: HashMap<string, Vec<string>>,
    // Field-only places moved out of an OWNED struct binding, keyed by the
    // binding's name — the field-level counterpart of VarInfo.moved (which only
    // answers the question for the WHOLE variable). Same by-value-VarInfo
    // constraint as borrowedPaths above, so it's a second name-keyed side
    // table rather than a field on VarInfo. Each entry is a dotted chain off
    // the root (".a", ".inner.s") — see checker/moves.milo.
    movedFields: HashMap<string, Vec<string>>,
    // Depth counter raised while checking the OBJECT of a FieldAccess/IndexAccess
    // — i.e. while `p` is only being used as the base of a narrower place like
    // `p.b`, not read as a whole value. Mirrors the oracle's placeBaseDepth:
    // without it, every `p.b` would first check `p` as an Ident and wrongly
    // report "p is incomplete" even though only the untouched field is read.
    placeBaseDepth: i32,
    // Depth counter raised while checking an assignment's OWN target expression
    // (`p.a = ...`) — the field about to be overwritten doesn't care whether it
    // was already moved, so the read-time "use of moved value" check is
    // suppressed for exactly that walk (checkAssign clears the place right after).
    inAssignTargetDepth: i32,
    // Depth counter raised while checking a `sortByKey` key extractor's body.
    // sortByKey reads the key to compare and never stores or drops it, so
    // taking a field out of its `&T` receiver never actually aliases anything
    // past the call — the one exemption to the move-out-of-borrow rule (see
    // checker/expr.milo's fieldMoveOutOfBorrow and tests/fixtures/sortByKeyString.milo).
    keyExtractorDepth: i32,
}

pub fn newChecker(): Checker {
    return Checker {
        pendingVecInfer: Vec.new(),
        diagnostics: Vec.new(),
        displayNames: HashMap.new(),
        functions: HashMap.new(),
        structs: HashMap.new(),
        enums: HashMap.new(),
        traits: HashMap.new(),
        traitImpls: HashMap.new(),
        inherentImpls: HashMap.new(),
        typeAliases: HashMap.new(),
        scopes: Vec.new(),
        currentFnRetType: TypeKind.TVoid,
        loopDepth: 0,
        unsafeDepth: 0,
        monomorphizedFns: Vec.new(),
        monomorphizedEnums: Vec.new(),
        monomorphizedStructs: Vec.new(),
        dropImpls: HashMap.new(),
        genericFns: HashMap.new(),
        genericStructs: HashMap.new(),
        genericEnums: HashMap.new(),
        genericImpls: Vec.new(),
        structInsts: Vec.new(),
        inReturn: false,
        expectedType: Option.None,
        pendingClosureRet: Option.None,
        jsonCapableStructs: HashMap.new(),
        exprTypes: HashMap.new(),
        forIns: HashMap.new(),
        borrowedPaths: HashMap.new(),
        scopeFreezes: Vec.new(),
        viewReturnFields: HashMap.new(),
        movedFields: HashMap.new(),
        placeBaseDepth: 0,
        inAssignTargetDepth: 0,
        keyExtractorDepth: 0,
    }
}

// -- Error/warning emission --

// Rewrite every mangled instance name in `text` to its written form. Identifier
// runs are looked up whole, so `Result_P_string` never matches inside a longer name.
pub fn displayText(ck: &Checker, text: &string): string {
    if ck.displayNames.len == 0 {
        return text.clone()
    }
    var out = ""
    var i: i64 = 0
    while i < text.len {
        let c = text[i]
        if isIdentByte(c) {
            var j = i
            while j < text.len && isIdentByte(text[j]) {
                j = j + 1
            }
            let word = text.substr(i, j)
            match ck.displayNames.get(word) {
                Option.Some(pretty) => {
                    out = out + pretty
                }
                Option.None => {
                    out = out + word
                }
            }
            i = j
        } else {
            out = out + text.substr(i, i + 1)
            i = i + 1
        }
    }
    return out
}

fn isIdentByte(c: u8): bool {
    return (c >= 48 && c <= 57) || (c >= 65 && c <= 90) || (c >= 97 && c <= 122) || c == 95 || c == 36
}

// typeName with instance names written the way the user spelled them.
pub fn displayType(ck: &Checker, t: &TypeKind): string {
    return displayText(ck, typeName(t))
}

pub fn error(ck: &mut Checker, msg: string, span: Option<Span>) {
    let shown = displayText(ck, msg)
    ck.diagnostics.push(Diagnostic {
        severity: "error",
        message: shown,
        hint: "",
        span: span,
    })
}

pub fn errorHint(ck: &mut Checker, msg: string, hint: string, span: Option<Span>) {
    let shownMsg = displayText(ck, msg)
    let shownHint = displayText(ck, hint)
    ck.diagnostics.push(Diagnostic {
        severity: "error",
        message: shownMsg,
        hint: shownHint,
        span: span,
    })
}

pub fn warn(ck: &mut Checker, msg: string, span: Option<Span>) {
    let shown = displayText(ck, msg)
    ck.diagnostics.push(Diagnostic {
        severity: "warning",
        message: shown,
        hint: "",
        span: span,
    })
}

// -- Scope management --

pub fn pushScope(ck: &mut Checker) {
    ck.scopes.push(HashMap.new())
    ck.scopeFreezes.push(Vec.new())
}

pub fn popScope(ck: &mut Checker) {
    let _ = ck.scopes.pop()
    // Release any freeze a view binding declared in this scope was holding —
    // the analog of the oracle's `for (const src of vi.freezes) unfreeze(src)`
    // at scope pop, keyed by name here instead of by VarInfo identity.
    match ck.scopeFreezes.pop() {
        Option.Some(names) => {
            // Insert-empty rather than HashMap.remove: this checker (compiled
            // by the oracle, not itself) has no other caller of
            // HashMap<_, Vec<_>>.remove, and it miscompiles the value's drop
            // glue into a bogus void alloca — see borrow.milo's unfreezeName.
            for i in 0..names.len {
                ck.borrowedPaths.insert(names[i].clone(), Vec.new())
            }
        }
        Option.None => {
        }
    }
}

pub fn declare(ck: &mut Checker, name: string, info: VarInfo) {
    let depth = ck.scopes.len - 1
    // A fresh binding owns nothing moved yet. Without this reset, a name reused
    // across two unrelated functions (`self`, `p`, ...) would see the PREVIOUS
    // function's partial-move state, since movedFields is name-keyed rather
    // than scope-keyed (see the field's doc comment on Checker).
    ck.movedFields.insert(name.clone(), Vec.new())
    ck.scopes[depth].insert(name, info)
}

// References can't be returned anymore — lookup returns a copy of the VarInfo,
// and mutations go through the setVar* helpers which write the copy back.
pub fn lookup(ck: &Checker, name: &string): Option<VarInfo> {
    var i: i64 = ck.scopes.len - 1
    while i >= 0 {
        if ck.scopes[i].contains(name) {
            return ck.scopes[i].get(name)
        }
        i = i - 1
    }
    return Option.None
}

// Refine a local's recorded type in place. Used to give `var w = Vec.new()` its element
// type from the first `push`.
pub fn setVarType(ck: &mut Checker, name: &string, ty: TypeKind) {
    // Refining the local IS the resolution a pending Vec was waiting for.
    var kept: Vec<PendingVecInfer> = Vec.new()
    for pv in ck.pendingVecInfer {
        if pv.name != name {
            kept.push(PendingVecInfer {
                name: pv.name.clone(), span: cloneSpan(pv.span)
            })
        }
    }
    ck.pendingVecInfer = kept
    var i: i64 = ck.scopes.len - 1
    while i >= 0 {
        if ck.scopes[i].contains(name) {
            match ck.scopes[i].get(name) {
                Option.Some(v) => {
                    var updated = v
                    updated.ty = ty
                    ck.scopes[i].insert(name.clone(), updated)
                }
                Option.None => {
                }
            }
            return
        }
        i = i - 1
    }
}

pub fn setVarMoved(ck: &mut Checker, name: &string, moved: bool) {
    var i: i64 = ck.scopes.len - 1
    while i >= 0 {
        if ck.scopes[i].contains(name) {
            match ck.scopes[i].get(name) {
                Option.Some(v) => {
                    var updated = v
                    updated.moved = moved
                    ck.scopes[i].insert(name.clone(), updated)
                }
                Option.None => {
                }
            }
            return
        }
        i = i - 1
    }
}

pub fn setVarRead(ck: &mut Checker, name: &string) {
    var i: i64 = ck.scopes.len - 1
    while i >= 0 {
        if ck.scopes[i].contains(name) {
            match ck.scopes[i].get(name) {
                Option.Some(v) => {
                    var updated = v
                    updated.read = true
                    ck.scopes[i].insert(name.clone(), updated)
                }
                Option.None => {
                }
            }
            return
        }
        i = i - 1
    }
}

// -- Has errors check --

pub fn hasErrors(ck: &Checker): bool {
    for i in 0..ck.diagnostics.len {
        if ck.diagnostics[i].severity == "error" {
            return true
        }
    }
    return false
}

// -- Clone impls (no auto-derive in modern Milo) --

impl Clone for FnParam {
    fn clone(self: &Self): Self {
        return FnParam {
            name: self.name.clone(), ty: self.ty.clone()
        }
    }
}

impl Clone for FnSig {
    fn clone(self: &Self): Self {
        var params: Vec<FnParam> = Vec.new()
        for i in 0..self.params.len {
            params.push(self.params[i].clone())
        }
        return FnSig {
            params: params, ret: self.ret.clone(), variadic: self.variadic, isExtern: self.isExtern
        }
    }
}

// typeFromName cannot know whether a bare name is a struct or an enum —
// annotations like `fn f(): TokKind` come back as TStruct("TokKind") and then
// fail typeEq against the TEnum the body produces. Rewrite anywhere an enum
// with that name is registered.
pub fn normalizeEnumNames(ck: &Checker, t: &TypeKind): TypeKind {
    match t {
        TypeKind.TStruct(name) => {
            if ck.enums.contains(name) {
                return TypeKind.TEnum(name.clone())
            }
            return t.clone()
        }
        TypeKind.TRef(inner, m) => {
            return TypeKind.TRef(Heap(normalizeEnumNames(ck, *inner)), m)
        }
        TypeKind.THeap(inner) => {
            return TypeKind.THeap(Heap(normalizeEnumNames(ck, *inner)))
        }
        TypeKind.TVec(elem) => {
            return TypeKind.TVec(Heap(normalizeEnumNames(ck, *elem)))
        }
        TypeKind.THashMap(k, v) => {
            return TypeKind.THashMap(Heap(normalizeEnumNames(ck, *k)), Heap(normalizeEnumNames(ck, *v)))
        }
        TypeKind.TArray(elem, size) => {
            var sz: Option<i64> = Option.None
            match size {
                Option.Some(n) => {
                    sz = Option.Some(n)
                }
                Option.None => {
                }
            }
            return TypeKind.TArray(Heap(normalizeEnumNames(ck, *elem)), sz)
        }
        // recurse into fn types: a `(&ExprNode) => Expr` param built from a bare name
        // otherwise keeps its inner Expr as the TStruct fallback and fails typeEq
        // against a closure whose own type resolved the name to TEnum.
        TypeKind.TFn(params, ret) => {
            var nps: Vec<TypeKind> = Vec.new()
            for i in 0..params.len {
                nps.push(normalizeEnumNames(ck, params[i]))
            }
            return TypeKind.TFn(nps, Heap(normalizeEnumNames(ck, *ret)))
        }
        _ => {
            return t.clone()
        }
    }
}

// -- Branch-terminating move merges --

// A branch that ends in break/continue/return never falls through, so its
// moves must not poison the code after the branch (flow-insensitive walk).
pub fn stmtTerminates(s: &Stmt): bool {
    match s {
        Stmt.BreakStmt(sp) => {
            return true
        }
        Stmt.ContinueStmt(sp) => {
            return true
        }
        Stmt.Return(v, sp) => {
            return true
        }
        _ => {
            return false
        }
    }
}

// A branch's whole move state: the per-scope `moved` bools (as before) PLUS a
// copy of the name-keyed movedFields table. Both have to travel together —
// movedFields is flat/global on the Checker (not scope-indexed), so without
// its own copy here a move recorded inside one `if` arm would leak straight
// past restoreMoves into the sibling arm's read of the same place: `if !have {
// x = res.ty } else if ... res.ty ...` in checkMatchExpr's own arm-join loop
// marked '.ty' moved in the THEN arm, and the ELSE arm (checked from the
// restored, pre-branch state for everything else) still saw it as gone —
// milo-self rejected its own source over this. Same class of bug as the
// borrow lane's name-keyed freeze table: a side table keyed by name rather
// than by VarInfo identity has no scope boundary for free, so every place
// that resets/restores/joins move state has to carry it explicitly.
pub struct MoveSnapshot {
    scopeMoved: Vec<HashMap<string, bool>>,
    movedFields: HashMap<string, Vec<string>>,
}

pub fn snapshotMoves(ck: &Checker): MoveSnapshot {
    var out: Vec<HashMap<string, bool>> = Vec.new()
    for i in 0..ck.scopes.len {
        var m: HashMap<string, bool> = HashMap.new()
        for name, info in ck.scopes[i] {
            m.insert(name.clone(), info.moved)
        }
        out.push(m)
    }
    return MoveSnapshot {
        scopeMoved: out, movedFields: ck.movedFields.clone()
    }
}

pub fn restoreMoves(ck: &mut Checker, snap: &MoveSnapshot) {
    var i: i64 = 0
    while i < ck.scopes.len && i < snap.scopeMoved.len {
        for name, moved in snap.scopeMoved[i] {
            match ck.scopes[i].get(name) {
                Option.Some(v) => {
                    var updated = v
                    updated.moved = moved
                    ck.scopes[i].insert(name.clone(), updated)
                }
                Option.None => {
                }
            }
        }
        i = i + 1
    }
    ck.movedFields = snap.movedFields.clone()
}

// Re-apply a branch's moves on top of the current state (any-path-moved
// stays moved after the join) — both the whole-variable bools and the
// per-field places.
pub fn orMoves(ck: &mut Checker, snap: &MoveSnapshot) {
    var i: i64 = 0
    while i < ck.scopes.len && i < snap.scopeMoved.len {
        for name, moved in snap.scopeMoved[i] {
            if moved {
                match ck.scopes[i].get(name) {
                    Option.Some(v) => {
                        var updated = v
                        updated.moved = true
                        ck.scopes[i].insert(name.clone(), updated)
                    }
                    Option.None => {
                    }
                }
            }
        }
        i = i + 1
    }
    for root, paths in snap.movedFields {
        var existing: Vec<string> = Vec.new()
        match ck.movedFields.get(root) {
            Option.Some(v) => {
                existing = v
            }
            Option.None => {
            }
        }
        for k in 0..paths.len {
            if !vecContainsStr(existing, paths[k]) {
                existing.push(paths[k].clone())
            }
        }
        ck.movedFields.insert(root.clone(), existing)
    }
}

// Enums/structs whose payloads are all Copy are themselves Copy (mirrors the
// oracle's isAllCopyEnum/isAllCopyStruct): an Option<Span> never moves.
// Recursion terminates because recursive types go through Heap (not Copy).
pub fn isCopyCk(ck: &Checker, t: &TypeKind): bool {
    if isCopy(t) {
        return true
    }
    match t {
        TypeKind.TEnum(name) => {
            if !ck.enums.contains(name) {
                return false
            }
            let info = ck.enums.get(name)!
            for vn, vi in info.variants {
                for i in 0..vi.fields.len {
                    if !isCopyCk(ck, vi.fields[i]) {
                        return false
                    }
                }
            }
            return true
        }
        TypeKind.TStruct(name) => {
            if !ck.structs.contains(name) {
                return false
            }
            let info = ck.structs.get(name)!
            if info.noCopy {
                return false
            }
            for i in 0..info.fields.len {
                if !isCopyCk(ck, info.fields[i].ty) {
                    return false
                }
            }
            return true
        }
        // A fixed-size array of Copy elements is itself Copy (Rust: `[T; N]: Copy
        // where T: Copy`) — same no-heap, no-drop-glue reasoning as the struct case
        // above, and it composes with it: `[Pt; 2]` is Copy exactly when Pt is.
        TypeKind.TArray(inner, size) => {
            return isCopyCk(ck, *inner)
        }
        _ => {
            return false
        }
    }
}

// Whether `t` stores a reference somewhere inside a collection/box (Vec<&T>,
// [&T;N], Heap<&T>, HashMap<_,&T>, or an enum payload like Option<&T>) — a
// reference stored this way outlives whatever freeze the call site took for
// it, since nothing marks the CONTAINER as borrowed the way a bare `&T`
// binding is. A DIRECT `&T` at the top level is a different, narrower rule
// (checked separately at the call site — "references cannot be stored in
// structs" vs this one's "...in a collection").
pub fn nestedRef(ck: &Checker, t: &TypeKind): bool {
    let seen: Vec<string> = Vec.new()
    return nestedRefSeen(ck, t, seen)
}

fn vecContainsStr(v: &Vec<string>, target: &string): bool {
    for i in 0..v.len {
        if v[i] == target {
            return true
        }
    }
    return false
}

// `seen` guards a self-referential enum reached through Heap — exactly
// JsonValue's shape (`Object(HashMap<string, Heap<JsonValue>>)`): Object's
// field is a HashMap whose VALUE recurses back into JsonValue, and unlike a
// struct (whose isCopyCk deliberately stops at THeap) this walk has to look
// INSIDE the Heap, because that is exactly where a smuggled `&T` would hide.
// Without the guard this recursed until the call stack for `milo-self check`
// itself segfaulted — a real crash, not a slow pass, so this has to be fixed
// here rather than papered over with a recursion-depth cap: a depth cap would
// have to pick an arbitrary cutoff and then either false-negative (silently
// stop looking, letting a reference-in-storage slip through — the fail-open
// direction this checker's whole ethos rejects) or false-positive (report an
// error against a legitimately deep but acyclic type). A cycle in the TYPE
// GRAPH is decidable exactly, so decide it exactly instead of bounding it.
fn nestedRefSeen(ck: &Checker, t: &TypeKind, seen: &Vec<string>): bool {
    match t {
        TypeKind.TVec(inner) => {
            return isRefTy(*inner) || nestedRefSeen(ck, *inner, seen)
        }
        TypeKind.TArray(inner, size) => {
            return isRefTy(*inner) || nestedRefSeen(ck, *inner, seen)
        }
        TypeKind.THeap(inner) => {
            return isRefTy(*inner) || nestedRefSeen(ck, *inner, seen)
        }
        TypeKind.THashMap(k, v) => {
            return isRefTy(*k) || isRefTy(*v) || nestedRefSeen(ck, *k, seen) || nestedRefSeen(ck, *v, seen)
        }
        TypeKind.TEnum(name) => {
            if vecContainsStr(seen, name) {
                return false
            }
            if !ck.enums.contains(name) {
                return false
            }
            var seen2 = seen.clone()
            seen2.push(name.clone())
            let info = ck.enums.get(name)!
            for vn, vi in info.variants {
                for i in 0..vi.fields.len {
                    if isRefTy(vi.fields[i]) || nestedRefSeen(ck, vi.fields[i], seen2) {
                        return true
                    }
                }
            }
            return false
        }
        _ => {
            return false
        }
    }
}

fn isRefTy(t: &TypeKind): bool {
    match t {
        TypeKind.TRef(inner, mutable) => {
            return true
        }
        _ => {
            return false
        }
    }
}
