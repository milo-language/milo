// @derive(Json) synthesis — mirrors src/derive-json.ts (the oracle).
//
// Unlike deriveEq (which hand-builds a trivial one-expression AST), this
// generates Milo SOURCE text and reparses it with milo0's own lexer/parser —
// the control flow (loops, matches, let-else early returns) is too varied to
// hand-assemble as AST nodes without silently drifting from what a human
// would type. Reparsing means the derived code is checked by exactly the
// same rules as hand-written code.
//
// Everything generated here calls only std/json's cursor API and
// JsonError/JsonMismatch, already implemented in Milo (std/json.milo) and
// unchanged by this file.
from "src-milo/ast.milo" import {
    Attribute, StructDecl, ImplDecl, Program, cloneSpan,
}
from "src-milo/checker/types.milo" import {
    TypeKind, typeName,
}
from "src-milo/checker/state.milo" import {
    Checker, StructInfo, CkStructField, EnumInfo, VariantInfo, error,
}
from "src-milo/lexer.milo" import {
    tokenize
}
from "src-milo/parser.milo" import {
    newParser, parseImplDecl
}

// -- Source-line accumulator (mirrors the TS `Gen` class) --

pub struct JGen {
    indent: string,
    n: i64,
    lines: Vec<string>,
}

pub fn jgenNew(indent: string): JGen {
    return JGen {
        indent: indent, n: 0, lines: Vec.new()
    }
}

pub fn jgenTmp(g: &mut JGen, prefix: string): string {
    let s = prefix + g.n.toString()
    g.n = g.n + 1
    return s
}

fn repeatStr(s: &string, n: i64): string {
    var out = ""
    var i: i64 = 0
    while i < n {
        out = out + s.clone()
        i = i + 1
    }
    return out
}

pub fn jgenPush(g: &mut JGen, depth: i64, line: string) {
    g.lines.push(g.indent.clone() + repeatStr("    ", depth) + line)
}

// Milo string literal (belt-and-braces escaping — field/variant names are
// identifiers so nothing here should ever need it in practice).
pub fn jlit(s: &string): string {
    var out = "\""
    var i: i64 = 0
    while i < s.len {
        let c = s[i]
        if c == 92 {
            out = out + "\\\\"
        } else if c == 34 {
            out = out + "\\\""
        } else {
            out.push(c)
        }
        i = i + 1
    }
    out = out + "\""
    return out
}

// -- Field-type plan (mirrors JsonPlan in derive-json.ts) --

// PInt's range-check needs 5 pieces of data; boxed into its own struct (rather
// than a 5-field enum variant) so every JsonPlan variant stays at 0-2 fields,
// matching the shape every other enum in this compiler already uses (TypeKind
// included) — a wide variant on this specific enum was observed to corrupt
// the tag of OTHER instances (reproduced with a plain PString value; see the
// derive/trait task report).
pub struct PIntSpec {
    ty: string,
    unsigned64: bool,
    hasRange: bool,
    lo: string,
    hi: string,
}

pub struct PUnitEnumSpec {
    name: string,
    variants: Vec<string>, // declaration order
}

pub enum JsonPlan {
    PString,
    PBool,
    PInt(Heap<PIntSpec>),
    PFloat(string), // ty
    PStruct(string), // struct name
    PUnitEnum(Heap<PUnitEnumSpec>),
    PVec(string, Heap<JsonPlan>), // Milo type spelling, element plan
    POption(string, Heap<JsonPlan>), // Milo type spelling, inner plan
}

pub struct JsonFieldPlan {
    field: string,
    key: string,
    plan: JsonPlan,
}

// Matching directly on an owned JsonPlan moves it; going through a `&JsonPlan`
// param borrows instead, so the caller can keep using the value afterward.
fn isOptionPlan(p: &JsonPlan): bool {
    match p {
        JsonPlan.POption(_pty, _ph) => {
            return true
        }
        _ => {
            return false
        }
    }
}

// -- Serialize (mirrors emitSer) --

pub fn jemitSer(p: &JsonPlan, val: &string, g: &mut JGen, d: i64): string {
    match p {
        JsonPlan.PString => {
            return "jsonQuote(" + val.clone() + ")"
        }
        JsonPlan.PBool => {
            return "jsonBoolStr(" + val.clone() + ")"
        }
        JsonPlan.PInt(_spec) => {
            return val.clone() + ".toString()"
        }
        JsonPlan.PFloat(ty) => {
            return val.clone() + ".toString()"
        }
        JsonPlan.PStruct(name) => {
            return val.clone() + ".toJson()"
        }
        JsonPlan.PUnitEnum(specH) => {
            let spec = *specH
            let s = jgenTmp(&mut g, "s")
            jgenPush(&mut g, d, "var " + s.clone() + ": string = \"\"")
            jgenPush(&mut g, d, "match " + val.clone() + " {")
            for i in 0..spec.variants.len {
                jgenPush(&mut g, d + 1, spec.name.clone() + "." + spec.variants[i].clone() + " => {")
                // jlit() escapes for MILO SOURCE; the wire value itself must ALSO be a
                // JSON string (quoted), so wrap in quotes BEFORE jlit-escaping — two
                // layers, or the generated code assigns the bare variant name with no
                // surrounding quotes and emits invalid JSON (`"role":Admin`).
                jgenPush(&mut g, d + 2, s.clone() + " = " + jlit("\"" + spec.variants[i] + "\""))
                jgenPush(&mut g, d + 1, "}")
            }
            jgenPush(&mut g, d, "}")
            return s
        }
        JsonPlan.PVec(ty, elemH) => {
            let s = jgenTmp(&mut g, "s")
            let ii = jgenTmp(&mut g, "i")
            let e = jgenTmp(&mut g, "e")
            jgenPush(&mut g, d, "var " + s.clone() + ": string = \"[\"")
            jgenPush(&mut g, d, "var " + ii.clone() + ": i64 = 0")
            jgenPush(&mut g, d, "for " + e.clone() + " in " + val.clone() + " {")
            jgenPush(&mut g, d + 1, "if " + ii.clone() + " > 0 {")
            jgenPush(&mut g, d + 2, s.clone() + " = " + s.clone() + " + \",\"")
            jgenPush(&mut g, d + 1, "}")
            let inner = jemitSer(*elemH, e, &mut g, d + 1)
            jgenPush(&mut g, d + 1, s.clone() + " = " + s.clone() + " + " + inner)
            jgenPush(&mut g, d + 1, ii.clone() + " = " + ii.clone() + " + 1")
            jgenPush(&mut g, d, "}")
            jgenPush(&mut g, d, s.clone() + " = " + s.clone() + " + \"]\"")
            return s
        }
        JsonPlan.POption(ty, innerH) => {
            let s = jgenTmp(&mut g, "s")
            let x = jgenTmp(&mut g, "x")
            jgenPush(&mut g, d, "var " + s.clone() + ": string = \"null\"")
            jgenPush(&mut g, d, "match " + val.clone() + " {")
            jgenPush(&mut g, d + 1, "Option.Some(" + x.clone() + ") => {")
            let inner = jemitSer(*innerH, x, &mut g, d + 2)
            jgenPush(&mut g, d + 2, s.clone() + " = " + inner)
            jgenPush(&mut g, d + 1, "}")
            jgenPush(&mut g, d + 1, "Option.None => {")
            jgenPush(&mut g, d + 1, "}")
            jgenPush(&mut g, d, "}")
            return s
        }
    }
}

// -- Deserialize (mirrors emitDe) --

pub fn jmismatch(path: &string, expected: &string, node: &string): string {
    return "Result.Err(JsonError.Mismatch(JsonMismatch { path: " + path.clone() + ", expected: " + jlit(expected) + ", actual: jsonKindName(doc.curKind(" + node.clone() + ")) }))"
}

pub fn jemitScalarDe(accessor: &string, expected: &string, node: &string, path: &string, g: &mut JGen, d: i64): string {
    let t = jgenTmp(&mut g, "v")
    jgenPush(&mut g, d, "let Option.Some(" + t.clone() + ") = doc." + accessor.clone() + "(" + node.clone() + ") else {")
    jgenPush(&mut g, d + 1, "return " + jmismatch(path, expected, node))
    jgenPush(&mut g, d, "}")
    return t
}

pub fn jemitDe(p: &JsonPlan, node: &string, path: &string, g: &mut JGen, d: i64): string {
    match p {
        JsonPlan.PString => {
            return jemitScalarDe("curStr", "string", node, path, &mut g, d)
        }
        JsonPlan.PBool => {
            return jemitScalarDe("curBool", "bool", node, path, &mut g, d)
        }
        JsonPlan.PFloat(ty) => {
            let raw = jemitScalarDe("curFloat", "number", node, path, &mut g, d)
            if ty == "f64" {
                return raw
            }
            let t = jgenTmp(&mut g, "v")
            jgenPush(&mut g, d, "let " + t.clone() + " = " + raw + " as " + ty.clone())
            return t
        }
        JsonPlan.PInt(specH) => {
            let spec = *specH
            var accessor = "curInt"
            if spec.unsigned64 {
                accessor = "curUint"
            }
            let raw = jemitScalarDe(accessor, "integer", node, path, &mut g, d)
            if !spec.hasRange {
                return raw
            }
            jgenPush(&mut g, d, "if " + raw.clone() + " < " + spec.lo.clone() + " || " + raw.clone() + " > " + spec.hi.clone() + " {")
            jgenPush(&mut g, d + 1, "return Result.Err(JsonError.Mismatch(JsonMismatch { path: " + path.clone() + ", expected: " + jlit(spec.ty) + ", actual: \"out-of-range number\" }))")
            jgenPush(&mut g, d, "}")
            let t = jgenTmp(&mut g, "v")
            jgenPush(&mut g, d, "let " + t.clone() + " = " + raw + " as " + spec.ty.clone())
            return t
        }
        JsonPlan.PStruct(name) => {
            // NOT `let t = match … { Ok(x) => x, Err(e) => { return … } }` — milo0's
            // parser mis-terminates a let-bound match expression whose arms mix a
            // bare-expression arm with a block arm (reproduced standalone; see the
            // derive/trait task report). Statement-form match, guarded so the
            // checker sees the branch that consumes `mr` as always-diverging, then
            // `!`-unwrap: works around it without touching the parser.
            let mr = jgenTmp(&mut g, "mr")
            let er = jgenTmp(&mut g, "er")
            let ok = jgenTmp(&mut g, "ok")
            let t = jgenTmp(&mut g, "v")
            jgenPush(&mut g, d, "let " + mr.clone() + " = " + name.clone() + ".fromJsonNode(doc, " + node.clone() + ")")
            jgenPush(&mut g, d, "if " + mr.clone() + ".isErr() {")
            jgenPush(&mut g, d + 1, "match " + mr.clone() + " {")
            jgenPush(&mut g, d + 2, "Result.Err(" + er.clone() + ") => {")
            jgenPush(&mut g, d + 3, "return Result.Err(" + er.clone() + ".under(" + path.clone() + "))")
            jgenPush(&mut g, d + 2, "}")
            jgenPush(&mut g, d + 2, "Result.Ok(" + ok.clone() + ") => {")
            jgenPush(&mut g, d + 3, "return Result.Err(JsonError.Syntax(\"unreachable\"))")
            jgenPush(&mut g, d + 2, "}")
            jgenPush(&mut g, d + 1, "}")
            jgenPush(&mut g, d, "}")
            jgenPush(&mut g, d, "let " + t.clone() + " = " + mr.clone() + "!")
            return t
        }
        JsonPlan.PUnitEnum(specH) => {
            let spec = *specH
            let s = jemitScalarDe("curStr", "string", node, path, &mut g, d)
            let t = jgenTmp(&mut g, "v")
            let ok = jgenTmp(&mut g, "ok")
            jgenPush(&mut g, d, "var " + t.clone() + ": " + spec.name.clone() + " = " + spec.name.clone() + "." + spec.variants[0].clone())
            jgenPush(&mut g, d, "var " + ok.clone() + ": bool = false")
            for i in 0..spec.variants.len {
                jgenPush(&mut g, d, "if " + s.clone() + " == " + jlit(spec.variants[i]) + " {")
                jgenPush(&mut g, d + 1, t.clone() + " = " + spec.name.clone() + "." + spec.variants[i].clone())
                jgenPush(&mut g, d + 1, ok.clone() + " = true")
                jgenPush(&mut g, d, "}")
            }
            jgenPush(&mut g, d, "if !" + ok.clone() + " {")
            var oneOf = ""
            for i in 0..spec.variants.len {
                if i > 0 {
                    oneOf = oneOf + ", "
                }
                oneOf = oneOf + "\"" + spec.variants[i].clone() + "\""
            }
            jgenPush(&mut g, d + 1, "return Result.Err(JsonError.Mismatch(JsonMismatch { path: " + path.clone() + ", expected: " + jlit("one of " + oneOf) + ", actual: \"\\\"\" + " + s.clone() + " + \"\\\"\" }))")
            jgenPush(&mut g, d, "}")
            return t
        }
        JsonPlan.PVec(ty, elemH) => {
            let t = jgenTmp(&mut g, "v")
            let ii = jgenTmp(&mut g, "i")
            let c = jgenTmp(&mut g, "c")
            jgenPush(&mut g, d, "if doc.curKind(" + node.clone() + ") != 4 {")
            jgenPush(&mut g, d + 1, "return " + jmismatch(path, "array", node))
            jgenPush(&mut g, d, "}")
            jgenPush(&mut g, d, "var " + t.clone() + ": " + ty.clone() + " = Vec.new()")
            jgenPush(&mut g, d, "var " + ii.clone() + ": i64 = 0")
            jgenPush(&mut g, d, "while " + ii.clone() + " < doc.curLen(" + node.clone() + ") {")
            jgenPush(&mut g, d + 1, "let " + c.clone() + " = doc.curChild(" + node.clone() + ", " + ii.clone() + ")")
            let elemPath = path.clone() + " + \"[\" + " + ii.clone() + ".toString() + \"]\""
            let inner = jemitDe(*elemH, c, elemPath, &mut g, d + 1)
            jgenPush(&mut g, d + 1, t.clone() + ".push(" + inner + ")")
            jgenPush(&mut g, d + 1, ii.clone() + " = " + ii.clone() + " + 1")
            jgenPush(&mut g, d, "}")
            return t
        }
        JsonPlan.POption(ty, innerH) => {
            let t = jgenTmp(&mut g, "v")
            jgenPush(&mut g, d, "var " + t.clone() + ": " + ty.clone() + " = Option.None")
            jgenPush(&mut g, d, "if " + node.clone() + " >= 0 && doc.curKind(" + node.clone() + ") != 0 {")
            let inner = jemitDe(*innerH, node, path, &mut g, d + 1)
            jgenPush(&mut g, d + 1, t.clone() + " = Option.Some(" + inner + ")")
            jgenPush(&mut g, d, "}")
            return t
        }
    }
}

// -- Type -> plan reduction (mirrors jsonPlanFor / jsonTypeSpelling) --

// Some(inner) if `name` is the monomorphized Option_<T> enum (Some(T)/None),
// distinguishing it from Result_<T>_<E> (Ok/Err) which shares the "one
// payload variant" shape but is not JSON-representable this way.
pub fn jsonOptionInner(ck: &Checker, name: &string): Option<TypeKind> {
    if !ck.enums.contains(name) {
        return Option.None
    }
    let info = ck.enums.get(name)!
    if info.variants.contains("Some") && info.variants.contains("None") {
        let sv = info.variants.get("Some")!
        if sv.fields.len == 1 {
            return Option.Some(sv.fields[0].clone())
        }
    }
    return Option.None
}

// A struct is JSON-capable if it has both toJson and fromJsonNode, derived or
// hand-written (deriveJsonHandWritten relies on the hand-written case), OR is
// pre-marked as about to derive one (see Checker.jsonCapableStructs — handles
// a struct whose own field refers to itself, or to a struct derived later in
// the file).
pub fn jsonHasCodec(ck: &Checker, structName: &string): bool {
    if ck.jsonCapableStructs.contains(structName) {
        return true
    }
    if !ck.inherentImpls.contains(structName) {
        return false
    }
    let info = ck.inherentImpls.get(structName)!
    return info.methods.contains("toJson") && info.methods.contains("fromJsonNode")
}

pub fn jsonTypeSpelling(ck: &Checker, t: &TypeKind): string {
    match t {
        TypeKind.TVec(elem) => {
            return "Vec<" + jsonTypeSpelling(ck, *elem) + ">"
        }
        TypeKind.TEnum(name) => {
            match jsonOptionInner(ck, name) {
                Option.Some(inner) => {
                    return "Option<" + jsonTypeSpelling(ck, inner) + ">"
                }
                Option.None => {
                }
            }
            return name.clone()
        }
        _ => {
            return typeName(t)
        }
    }
}

// Tag-ordered variant names of a payload-free enum, or an error message
// naming the first payload-carrying variant found.
fn jsonUnitVariants(info: &EnumInfo): Result<Vec<string>, string> {
    var tags: Vec<i32> = Vec.new()
    var names: Vec<string> = Vec.new()
    for vn, vi in info.variants {
        if vi.fields.len > 0 {
            return Result.Err("carries a payload in '" + vn.clone() + "' — only payload-free enums have a JSON form (the variant name as a string)")
        }
        tags.push(vi.tag)
        names.push(vn.clone())
    }
    // insertion sort by tag — variant counts are tiny, and this keeps derived
    // wire text (and error messages) in declaration order regardless of the
    // HashMap's own iteration order.
    var i: i64 = 1
    while i < names.len {
        let keyTag = tags[i]
        let keyName = names[i].clone()
        var j = i - 1
        while j >= 0 && tags[j] > keyTag {
            tags[j + 1] = tags[j]
            names[j + 1] = names[j].clone()
            j = j - 1
        }
        tags[j + 1] = keyTag
        names[j + 1] = keyName
        i = i + 1
    }
    return Result.Ok(names)
}

pub fn jsonPlanFor(ck: &mut Checker, t: &TypeKind, structName: &string, fieldName: &string): Option<JsonPlan> {
    match t {
        TypeKind.TString => {
            return Option.Some(JsonPlan.PString)
        }
        TypeKind.TBool => {
            return Option.Some(JsonPlan.PBool)
        }
        TypeKind.TInt(bits, signed, _, _) => {
            var ty = "u" + bits.toString()
            if signed {
                ty = "i" + bits.toString()
            }
            if bits == 64 {
                return Option.Some(JsonPlan.PInt(Heap(PIntSpec {
                    ty: ty, unsigned64:!signed, hasRange: false, lo: "0", hi: "0"
                })))
            }
            // Narrower than the i64 the cursor hands back, so the value has to be
            // range-checked before the cast — bits is always 8/16/32 here (64 is
            // handled above), so a lookup table beats shift-by-variable.
            var hi: i64 = 0
            var lo: i64 = 0
            if signed {
                if bits == 8 {
                    hi = 127
                    lo = 0 - 128
                } else if bits == 16 {
                    hi = 32767
                    lo = 0 - 32768
                } else {
                    hi = 2147483647
                    lo = 0 - 2147483648
                }
            } else {
                if bits == 8 {
                    hi = 255
                } else if bits == 16 {
                    hi = 65535
                } else {
                    hi = 4294967295
                }
            }
            return Option.Some(JsonPlan.PInt(Heap(PIntSpec {
                ty: ty, unsigned64: false, hasRange: true, lo: lo.toString(), hi: hi.toString()
            })))
        }
        TypeKind.TFloat(bits) => {
            return Option.Some(JsonPlan.PFloat("f" + bits.toString()))
        }
        TypeKind.TStruct(name) => {
            if !jsonHasCodec(ck, name) {
                error(&mut ck, "cannot derive Json for '" + structName.clone() + "': field '" + fieldName.clone() + "': struct '" + name.clone() + "' has no JSON codec — add @derive(Json) to it", Option.None)
                return Option.None
            }
            return Option.Some(JsonPlan.PStruct(name.clone()))
        }
        TypeKind.TEnum(name) => {
            match jsonOptionInner(ck, name) {
                Option.Some(inner) => {
                    match jsonPlanFor(&mut ck, inner, structName, fieldName) {
                        Option.Some(p) => {
                            if isOptionPlan(p) {
                                error(&mut ck, "cannot derive Json for '" + structName.clone() + "': field '" + fieldName.clone() + "': Option<Option<T>> has no distinct JSON encoding — 'Some(None)' and an absent field are both null", Option.None)
                                return Option.None
                            }
                            let spelling = "Option<" + jsonTypeSpelling(ck, inner) + ">"
                            return Option.Some(JsonPlan.POption(spelling, Heap(p)))
                        }
                        Option.None => {
                            return Option.None
                        }
                    }
                }
                Option.None => {
                }
            }
            if !ck.enums.contains(name) {
                error(&mut ck, "cannot derive Json for '" + structName.clone() + "': field '" + fieldName.clone() + "': unknown enum '" + name.clone() + "'", Option.None)
                return Option.None
            }
            let info = ck.enums.get(name)!
            match jsonUnitVariants(info) {
                Result.Ok(variants) => {
                    if variants.len == 0 {
                        error(&mut ck, "cannot derive Json for '" + structName.clone() + "': field '" + fieldName.clone() + "': enum '" + name.clone() + "' has no variants", Option.None)
                        return Option.None
                    }
                    return Option.Some(JsonPlan.PUnitEnum(Heap(PUnitEnumSpec {
                        name: name.clone(), variants: variants
                    })))
                }
                Result.Err(msg) => {
                    error(&mut ck, "cannot derive Json for '" + structName.clone() + "': field '" + fieldName.clone() + "': enum '" + name.clone() + "' " + msg, Option.None)
                    return Option.None
                }
            }
        }
        TypeKind.TVec(elem) => {
            match jsonPlanFor(&mut ck, *elem, structName, fieldName) {
                Option.Some(p) => {
                    let spelling = "Vec<" + jsonTypeSpelling(ck, *elem) + ">"
                    return Option.Some(JsonPlan.PVec(spelling, Heap(p)))
                }
                Option.None => {
                    return Option.None
                }
            }
        }
        _ => {
            error(&mut ck, "cannot derive Json for '" + structName.clone() + "': field '" + fieldName.clone() + "': type '" + typeName(t) + "' has no JSON form", Option.None)
            return Option.None
        }
    }
}

// -- Source assembly (mirrors deriveJsonSource) --

fn jsonDeriveSource(structName: &string, fields: &Vec<JsonFieldPlan>): string {
    var out: Vec<string> = Vec.new()
    out.push("impl " + structName.clone() + " {")

    // toJson
    var gSer = jgenNew("        ")
    for i in 0..fields.len {
        let f = fields[i]
        let expr = jemitSer(f.plan, "self." + f.field.clone(), &mut gSer, 0)
        var prefix = ","
        if i == 0 {
            prefix = ""
        }
        let keyLit = jlit(prefix + "\"" + f.key.clone() + "\":")
        jgenPush(&mut gSer, 0, "out = out + " + keyLit + " + " + expr)
    }
    out.push("    fn toJson(self: &Self): string {")
    out.push("        var out: string = \"{\"")
    for li in 0..gSer.lines.len {
        out.push(gSer.lines[li].clone())
    }
    out.push("        out = out + \"}\"")
    out.push("        return out")
    out.push("    }")

    // fromJsonNode
    var vals: Vec<string> = Vec.new()
    var gDe = jgenNew("        ")
    for i in 0..fields.len {
        let f = fields[i]
        let node = jgenTmp(&mut gDe, "n")
        jgenPush(&mut gDe, 0, "let " + node.clone() + " = doc.curField(cur, " + jlit(f.key) + ")")
        // f.plan is read again below (jemitDe) — must not move it out here.
        if !isOptionPlan(f.plan) {
            jgenPush(&mut gDe, 0, "if " + node.clone() + " < 0 {")
            jgenPush(&mut gDe, 1, "return Result.Err(JsonError.Missing(" + jlit(f.key) + "))")
            jgenPush(&mut gDe, 0, "}")
        }
        let de = jemitDe(f.plan, node, jlit(f.key), &mut gDe, 0)
        vals.push(f.field.clone() + ": " + de)
    }
    out.push("    fn fromJsonNode(doc: &Json, cur: i64): Result<" + structName.clone() + ", JsonError> {")
    out.push("        if doc.curKind(cur) != 5 {")
    let rootPath = "\"\""
    out.push("            return " + jmismatch(rootPath, "object", "cur"))
    out.push("        }")
    for li in 0..gDe.lines.len {
        out.push(gDe.lines[li].clone())
    }
    var valsJoined = ""
    for i in 0..vals.len {
        if i > 0 {
            valsJoined = valsJoined + ", "
        }
        valsJoined = valsJoined + vals[i].clone()
    }
    out.push("        return Result.Ok(" + structName.clone() + " { " + valsJoined + " })")
    out.push("    }")

    // fromJson
    out.push("    fn fromJson(text: string): Result<" + structName.clone() + ", JsonError> {")
    out.push("        match Json.parse(text) {")
    out.push("            Result.Ok(doc) => {")
    out.push("                return " + structName.clone() + ".fromJsonNode(doc, doc.curRoot())")
    out.push("            }")
    out.push("            Result.Err(e) => {")
    out.push("                return Result.Err(JsonError.Syntax(e))")
    out.push("            }")
    out.push("        }")
    out.push("    }")

    out.push("}")

    var result = ""
    for i in 0..out.len {
        result = result + out[i].clone() + "\n"
    }
    return result
}

// -- Entry point (mirrors deriveJson) --

pub fn deriveJson(ck: &mut Checker, s: &StructDecl): Option<ImplDecl> {
    if !ck.structs.contains(s.name) {
        error(&mut ck, "cannot derive Json for '" + s.name.clone() + "': unknown struct", Option.None)
        return Option.None
    }
    let sinfo = ck.structs.get(s.name)!
    var fields: Vec<JsonFieldPlan> = Vec.new()
    var seenKeys: Vec<string> = Vec.new()
    for i in 0..s.fields.len {
        let fname = s.fields[i].name.clone()
        let fty = sinfo.fields[i].ty.clone()
        match jsonPlanFor(&mut ck, fty, s.name, fname) {
            Option.Some(plan) => {
                var key = fname.clone()
                for ai in 0..s.fields[i].attributes.len {
                    if s.fields[i].attributes[ai].name == "json" {
                        let attr = s.fields[i].attributes[ai]
                        if attr.args.len != 1 {
                            error(&mut ck, "@json on '" + s.name.clone() + "." + fname.clone() + "': expects one string, e.g. @json(\"user_id\")", Option.None)
                            return Option.None
                        }
                        key = attr.args[0].clone()
                        if key.len == 0 {
                            error(&mut ck, "@json on '" + s.name.clone() + "." + fname.clone() + "': the name must be non-empty", Option.None)
                            return Option.None
                        }
                    }
                }
                for si in 0..seenKeys.len {
                    if seenKeys[si] == key {
                        error(&mut ck, "cannot derive Json for '" + s.name.clone() + "': two fields map to the JSON name '" + key.clone() + "'", Option.None)
                        return Option.None
                    }
                }
                seenKeys.push(key.clone())
                fields.push(JsonFieldPlan {
                    field: fname, key: key, plan: plan
                })
            }
            Option.None => {
                return Option.None
            }
        }
    }
    var reservedNames: Vec<string> = Vec.new()
    reservedNames.push("toJson")
    reservedNames.push("fromJson")
    reservedNames.push("fromJsonNode")
    for ri in 0..reservedNames.len {
        if resolveMethodExists(ck, s.name, reservedNames[ri]) {
            error(&mut ck, "cannot derive Json for '" + s.name.clone() + "': it already defines '" + reservedNames[ri].clone() + "'", Option.None)
            return Option.None
        }
    }

    let src = jsonDeriveSource(s.name, fields)
    var tokens = tokenize(src)
    // Synthesized source has no real file — label it rather than silently
    // inheriting whatever the caller's filePath happened to be.
    var p = newParser(tokens, "<derive(Json)>")
    // Parse just the impl block, not a full top-level parse() — cheaper, and
    // avoids building a whole Program (structs/enums/functions/imports/
    // globals, all empty here) that would just be dropped unused right after.
    let implDecl = parseImplDecl(&mut p, false)
    return Option.Some(implDecl)
}

// Whether `structName` already has a hand-written `name` method BEFORE the
// derive registers its own — inherent impls are the only place a plain
// method name lives.
fn resolveMethodExists(ck: &Checker, structName: &string, name: &string): bool {
    if !ck.inherentImpls.contains(structName) {
        return false
    }
    let info = ck.inherentImpls.get(structName)!
    return info.methods.contains(name)
}
