// -- Move tracking --

// Which variable(s) does moving `expr` actually consume? A fork (if/match
// used as a value) doesn't own storage itself — which arm ran is a runtime
// fact, so BOTH tails are moved: a binding consumed on either path is
// unusable afterward, mirroring the oracle's moveTargets/tryMove split.
// Pass-throughs (`!`, `?`, `??`) forward to the operand(s) whose storage the
// result actually came from. Everything else either names storage directly
// (Ident, handled as a leaf below) or is a fresh value with no upstream
// owner to poison.
// The value expression of a block arm, cloned out. Callers that only need to
// inspect the tail should match it in place — this exists for the few spots that
// must pass it on as an owned Expr.
pub fn blockTailExpr(body: &Vec<Heap<Stmt>>): Option<Heap<ExprNode>> {
    if body.len > 0 {
        match *body[body.len - 1] {
            Stmt.ExprStmt(e, espan) => {
                return Option.Some(Heap(e.clone()))
            }
            _ => {
            }
        }
    }
    return Option.None
}

// Type one if-expression arm: a statement block whose trailing ExprStmt supplies
// the value. Any other tail must diverge (return/break/continue) and yields no
// type, so the arm reports unknown and the other arm decides. Mirrors
// checkMatchArmValue minus the pattern binding.
pub fn checkIfArmValue(ck: &mut Checker, body: &Vec<Heap<Stmt>>, fnRetType: &TypeKind, span: &Option<Span>): TypeKind {
    pushScope(&mut ck)
    var result = tyUnknown()
    var i: i64 = 0
    while i < body.len {
        let isLast = i == body.len - 1
        if isLast {
            match *body[i] {
                Stmt.ExprStmt(e, espan) => {
                    result = checkExpr(&mut ck, *e)
                }
                _ => {
                    if !stmtTerminates(*body[i]) {
                        error(&mut ck, "if-expression arm must end in a value or return/break/continue", cloneSpan(span))
                    }
                    checkStmt(&mut ck, *body[i], fnRetType)
                }
            }
        } else {
            checkStmt(&mut ck, *body[i], fnRetType)
        }
        i = i + 1
    }
    popScope(&mut ck)
    return result
}

// The value an if-expression arm hands back is its trailing ExprStmt; any other
// tail diverges and contributes nothing to move. Same rule match arms use.
pub fn tryMoveBlockTail(ck: &mut Checker, body: &Vec<Heap<Stmt>>) {
    if body.len > 0 {
        match *body[body.len - 1] {
            Stmt.ExprStmt(e, espan) => {
                tryMove(&mut ck, *e)
            }
            _ => {
            }
        }
    }
}

pub fn errorIfMovingBlockTail(ck: &mut Checker, body: &Vec<Heap<Stmt>>, span: &Option<Span>) {
    if body.len > 0 {
        match *body[body.len - 1] {
            Stmt.ExprStmt(e, espan) => {
                errorIfMovingBorrowedNonCopy(&mut ck, *e, span)
            }
            _ => {
            }
        }
    }
}

pub fn tryMove(ck: &mut Checker, expr: &ExprNode) {
    if ck.inReturn {
        return
    }
    match expr.kind {
        Expr.Ident(name) => {
            match lookup(ck, name) {
                Option.Some(v) => {
                    // Moving in an owned position through a borrow (`&T`, T non-Copy)
                    // would shallow-copy the pointee — e.g. a String's heap buffer —
                    // aliasing it with the real owner and double-freeing on drop.
                    match v.ty.clone() {
                        TypeKind.TRef(inner, mutable) => {
                            if !isCopyCk(ck, *inner) {
                                errorHint(&mut ck, "cannot move the borrowed value out of '" + name.clone() + "'", "'" + name.clone() + "' is a reference — call .clone() to take an owned copy", cloneSpan(expr.span))
                                return
                            }
                        }
                        _ => {
                        }
                    }
                    if isCopyCk(ck, v.ty) {
                        return
                    }
                    // Partial move: a field already left, so the binding sitting here
                    // is no longer the whole value. Handing it on would pass a zeroed
                    // field off as real data.
                    match firstMovedField(ck, name) {
                        Option.Some(partial) => {
                            errorHint(&mut ck, "cannot move '" + name.clone() + "' because '" + name.clone() + partial.clone() + "' was already moved out of it", "move the remaining fields individually, or clone '" + name.clone() + partial.clone() + "' at the point it was transferred so '" + name.clone() + "' stays whole", cloneSpan(expr.span))
                            return
                        }
                        Option.None => {
                        }
                    }
                    setVarMoved(&mut ck, name, true)
                }
                Option.None => {
                }
            }
        }
        Expr.FieldAccess(obj, field) => {
            tryMoveField(&mut ck, expr, expr.span)
        }
        Expr.IfExpr(cond, thenBody, elseBody) => {
            tryMoveBlockTail(&mut ck, thenBody)
            tryMoveBlockTail(&mut ck, elseBody)
        }
        Expr.MatchExpr(subject, arms) => {
            for i in 0..arms.len {
                if arms[i].body.len > 0 {
                    match *arms[i].body[arms[i].body.len - 1] {
                        Stmt.ExprStmt(e, espan) => {
                            tryMove(&mut ck, *e)
                        }
                        _ => {
                        }
                    }
                }
            }
        }
        Expr.Unwrap(operand) => {
            tryMove(&mut ck, *operand)
        }
        Expr.Propagate(operand) => {
            tryMove(&mut ck, *operand)
        }
        Expr.DefaultValue(operand, default) => {
            tryMove(&mut ck, *operand)
            tryMove(&mut ck, *default)
        }
        _ => {
        }
    }
}

// Struct field-chain resolution: walks `root`+`fields` (a field-only place)
// through struct definitions, returning the chain's final type together with
// the name of the first Drop-implementing struct found strictly ABOVE the
// final field (an ancestor container, never the field's own type) — the two
// facts every field-move check needs, computed in one walk. This checker
// doesn't cache expression types, so this replays the oracle's exprTypes
// lookup on demand instead.
pub struct FieldChainInfo {
    finalType: TypeKind,
    dropAncestor: Option<string>,
}

fn resolveFieldChain(ck: &Checker, root: &string, fields: &Vec<string>): Option<FieldChainInfo> {
    var curType = tyUnknown()
    match lookup(ck, root) {
        Option.Some(v) => {
            curType = deref(v.ty)
        }
        Option.None => {
            return Option.None
        }
    }
    var dropAncestor: Option<string> = Option.None
    var i: i64 = 0
    while i < fields.len {
        match curType.clone() {
            TypeKind.TStruct(sname) => {
                match dropAncestor {
                    Option.None => {
                        if ck.dropImpls.contains(sname) {
                            dropAncestor = Option.Some(sname.clone())
                        }
                    }
                    _ => {
                    }
                }
                if !ck.structs.contains(sname) {
                    return Option.None
                }
                let info = ck.structs.get(sname)!
                var found = false
                for fi in 0..info.fields.len {
                    if info.fields[fi].name == fields[i] {
                        curType = info.fields[fi].ty.clone()
                        found = true
                    }
                }
                if !found {
                    return Option.None
                }
            }
            _ => {
                return Option.None
            }
        }
        i = i + 1
    }
    return Option.Some(FieldChainInfo {
        finalType: curType, dropAncestor: dropAncestor
    }
    )
}

// Whether `e` (a move position) is a field-only place off a `&T`/`&mut T`
// binding — and if so, reports "cannot move '<place>' out of the borrowed
// '<root>'" (unless exempted) and returns true, so callers know not to fall
// through to the owned-move path. A Copy field is exempt outright (nothing is
// owned to transfer); a sortByKey key extractor is exempt too — it reads the
// key to compare and never stores or drops it, so a field taken from its
// borrowed receiver never actually aliases anything past the call. Every other
// closure combinator (map, filter, ...) DOES retain what its closure returns,
// so the exemption stays keyed to sortByKey alone rather than to closures in
// general (tests/fixtures/sortByKeyString.milo; mapMoveFieldOutOfBorrow is the
// negative fixture proving `.map` does NOT get it).
fn fieldMoveOutOfBorrow(ck: &mut Checker, e: &ExprNode, span: &Option<Span>): bool {
    match staticFieldPlace(e) {
        Option.Some(p) => {
            match lookup(ck, p.root) {
                Option.Some(v) => {
                    match v.ty.clone() {
                        TypeKind.TRef(inner, mutable) => {
                            match resolveFieldChain(ck, p.root, p.fields) {
                                Option.Some(info) => {
                                    if isCopyCk(ck, info.finalType) {
                                        return false
                                    }
                                }
                                Option.None => {
                                    return false
                                }
                            }
                            if ck.keyExtractorDepth > 0 {
                                return true
                            }
                            let path = fieldPathString(p.fields)
                            var swap = ""
                            if mutable {
                                swap = ", or 'replace(" + p.root.clone() + path.clone() + ", ...)' to take the field and leave something in its place"
                            }
                            errorHint(&mut ck, "cannot move '" + p.root.clone() + path.clone() + "' out of the borrowed '" + p.root.clone() + "'", "'" + p.root.clone() + "' is a reference — call .clone() to take an owned copy" + swap, cloneSpan(span))
                            return true
                        }
                        _ => {
                            return false
                        }
                    }
                }
                Option.None => {
                    return false
                }
            }
        }
        Option.None => {
            return false
        }
    }
}

// The owned-root counterpart of fieldMoveOutOfBorrow: `e` is a field-only
// place whose root is NOT a borrow, so the field really is transferred out. A
// Drop impl on any container along the chain makes that illegal outright (its
// destructor runs against the whole value); otherwise record which field left
// so a later whole-value use, or a later move of the SAME field, is caught
// (checkIdent / checkFieldMoveState below).
fn tryMoveField(ck: &mut Checker, e: &ExprNode, span: &Option<Span>) {
    if fieldMoveOutOfBorrow(&mut ck, e, span) {
        return
    }
    match staticFieldPlace(e) {
        Option.Some(p) => {
            match resolveFieldChain(ck, p.root, p.fields) {
                Option.Some(info) => {
                    if isCopyCk(ck, info.finalType) {
                        return
                    }
                    let path = fieldPathString(p.fields)
                    match info.dropAncestor {
                        Option.Some(tyname) => {
                            errorHint(&mut ck, "cannot move '" + p.root.clone() + path.clone() + "' out of '" + tyname.clone() + "', which implements Drop", "a Drop impl runs against the whole value, so taking a field out of it would leave the destructor reading an empty one — clone the field, or consume the '" + tyname.clone() + "' whole", cloneSpan(span))
                            return
                        }
                        Option.None => {
                        }
                    }
                    markFieldMoved(&mut ck, p.root, path)
                }
                Option.None => {
                }
            }
        }
        Option.None => {
        }
    }
}

// The field's own move state, the counterpart of the whole-variable `moved`
// check on a plain Ident. Called from every field READ (checkFieldAccess);
// suppressed while checking an assignment's own target — the field about to
// be overwritten doesn't care whether it was already moved, and checkAssign
// clears the place right after (ck.inAssignTargetDepth).
fn checkFieldMoveState(ck: &mut Checker, obj: &ExprNode, field: &string, span: &Option<Span>) {
    if ck.inAssignTargetDepth > 0 {
        return
    }
    match accessPath(obj) {
        Option.Some(op) => {
            if op.tainted {
                return
            }
            var fields = op.fields.clone()
            fields.push(field.clone())
            let path = fieldPathString(fields)
            match movedFieldCovering(ck, op.root, path) {
                Option.Some(gone) => {
                    if gone == path {
                        errorHint(&mut ck, "use of moved value '" + op.root.clone() + path.clone() + "'", "ownership of '" + op.root.clone() + path.clone() + "' was transferred earlier — the field is empty now. Clone it at the point of transfer: '" + op.root.clone() + path.clone() + ".clone()'.", cloneSpan(span))
                    } else {
                        errorHint(&mut ck, "use of moved value '" + op.root.clone() + path.clone() + "'", "'" + op.root.clone() + gone.clone() + "' was moved out earlier, which took '" + op.root.clone() + path.clone() + "' with it. Clone at the point of transfer: '" + op.root.clone() + gone.clone() + ".clone()'.", cloneSpan(span))
                    }
                }
                Option.None => {
                }
            }
        }
        Option.None => {
        }
    }
}

// A `&T` local (T non-Copy) moved into an owned position would shallow-copy
// the pointee — e.g. a string-view for-in loop variable is second-class and
// second-class means "lives inside the loop that borrowed it, nowhere else":
// `for line in s.lines() { return line }` would hand back a `&string` whose
// receiver's freeze ends the moment the loop (and the function) exits.
// Separate from tryMove (which also marks the variable moved for later
// use-after-move checks): checkReturn deliberately never calls tryMove — see
// its own comment — so this only ever REPORTS, never mutates move state.
pub fn errorIfMovingBorrowedNonCopy(ck: &mut Checker, expr: &ExprNode, span: &Option<Span>) {
    match expr.kind {
        Expr.Ident(name) => {
            match lookup(ck, name) {
                Option.Some(v) => {
                    match v.ty.clone() {
                        TypeKind.TRef(inner, mutable) => {
                            if !isCopyCk(ck, *inner) {
                                error(&mut ck, "cannot move the borrowed value out of '" + name.clone() + "'", cloneSpan(span))
                            }
                        }
                        _ => {
                        }
                    }
                }
                Option.None => {
                }
            }
        }
        Expr.FieldAccess(obj, field) => {
            let _ = fieldMoveOutOfBorrow(&mut ck, expr, span)
        }
        Expr.IfExpr(cond, thenBody, elseBody) => {
            errorIfMovingBlockTail(&mut ck, thenBody, span)
            errorIfMovingBlockTail(&mut ck, elseBody, span)
        }
        Expr.MatchExpr(subject, arms) => {
            for i in 0..arms.len {
                if arms[i].body.len > 0 {
                    match *arms[i].body[arms[i].body.len - 1] {
                        Stmt.ExprStmt(e, espan) => {
                            errorIfMovingBorrowedNonCopy(&mut ck, *e, span)
                        }
                        _ => {
                        }
                    }
                }
            }
        }
        Expr.Unwrap(operand) => {
            errorIfMovingBorrowedNonCopy(&mut ck, *operand, span)
        }
        Expr.Propagate(operand) => {
            errorIfMovingBorrowedNonCopy(&mut ck, *operand, span)
        }
        Expr.DefaultValue(operand, default) => {
            errorIfMovingBorrowedNonCopy(&mut ck, *operand, span)
            errorIfMovingBorrowedNonCopy(&mut ck, *default, span)
        }
        _ => {
        }
    }
}

pub fn isRootMutable(ck: &Checker, expr: &ExprNode): bool {
    match expr.kind {
        Expr.Ident(name) => {
            let info = lookup(ck, name)
            match info {
                Option.Some(v) => {
                    return v.mutable
                }
                Option.None => {
                    return false
                }
            }
        }
        Expr.FieldAccess(obj, field) => {
            // `p.x = …` where p is a raw pointer is an unsafe-gated store THROUGH the
            // pointer, not mutation of `p` — a `let p = buf as *Point` is a legal target
            match (*obj).kind {
                Expr.Ident(pname) => {
                    match lookup(ck, pname) {
                        Option.Some(v) => {
                            match deref(v.ty) {
                                TypeKind.TPtr(inner) => {
                                    return true
                                }
                                _ => {
                                }
                            }
                        }
                        Option.None => {
                        }
                    }
                }
                _ => {
                }
            }
            return isRootMutable(ck, *obj)
        }
        Expr.IndexAccess(obj, idx) => {
            // writes through a raw-pointer index are unsafe-gated pointer
            // stores, not variable mutation — a `let p = buf as *i64` is a
            // legal write target
            match (*obj).kind {
                Expr.Ident(pname) => {
                    match lookup(ck, pname) {
                        Option.Some(v) => {
                            match deref(v.ty) {
                                TypeKind.TPtr(inner) => {
                                    return true
                                }
                                _ => {
                                }
                            }
                        }
                        Option.None => {
                        }
                    }
                }
                _ => {
                }
            }
            return isRootMutable(ck, *obj)
        }
        // writes through a deref target (*p).f / *p — raw pointers are gated
        // by unsafe, heap boxes own their pointee
        Expr.UnaryOp(op, operand) => {
            if op == "*" {
                return true
            }
            return false
        }
        // A capitalized *variable* followed by `.field` parses identically to a
        // static enum-literal/struct-call — the parser has no type info to tell
        // them apart (see checkEnumLit's own "variable fallback", which this
        // mirrors). Without this case, `STORE.inner.n = x` and `STORE.items.push(x)`
        // fell through to the `_` arm below and reported every module-level
        // struct/Vec global as immutable, however it was declared.
        Expr.EnumLit(enumName, variant, args) => {
            if !ck.enums.contains(enumName) {
                match lookup(ck, enumName) {
                    Option.Some(v) => {
                        return v.mutable
                    }
                    Option.None => {
                    }
                }
            }
            return false
        }
        _ => {
            return false
        }
    }
}

// -- Deref through references --

pub fn deref(t: &TypeKind): TypeKind {
    match t {
        // `inner` is &Heap<TypeKind> — a pointer to the Heap slot. `inner.clone()`
        // would clone through the wrong level and reinterpret the pointer bytes as
        // a TypeKind (garbage tag). Deref to the pointee first.
        TypeKind.TRef(inner, mutable) => {
            return (*inner).clone()
        }
        _ => {
            return t.clone()
        }
    }
}

// -- Main expression checker --

// Records the type before handing it back. The walk already computed it; dropping it on
// the floor is why the backend has to reconstruct types from syntax.
pub fn checkExpr(ck: &mut Checker, expr: &ExprNode): TypeKind {
    let ty = checkExprInner(&mut ck, expr)
    ck.exprTypes.insert(expr.id, ty.clone())
    return ty
}

fn checkExprInner(ck: &mut Checker, expr: &ExprNode): TypeKind {
    match expr.kind {
        Expr.IntLit(val) => {
            return tyI64()
        }
        Expr.FloatLit(val) => {
            return TypeKind.TFloat(64)
        }
        Expr.BoolLit(val) => {
            return tyBool()
        }
        Expr.CharLit(val) => {
            return tyU8()
        }
        Expr.StringLit(val) => {
            return tyString()
        }
        Expr.Ident(name) => {
            return checkIdent(&mut ck, name, expr.span)
        }
        Expr.BinOp(op, left, right) => {
            return checkBinOp(&mut ck, op, *left, *right, expr.span)
        }
        Expr.UnaryOp(op, operand) => {
            return checkUnaryOp(&mut ck, op, *operand, expr.span)
        }
        Expr.Call(func, args, typeArgs) => {
            return checkCall(&mut ck, func, args, typeArgs, expr.span)
        }
        Expr.StructLit(name, fields) => {
            return checkStructLit(&mut ck, name, fields, expr.span)
        }
        Expr.JsonObject(fields) => {
            // a JSON object literal type-checks its field values and is a string
            for i in 0..fields.len {
                let ft = checkExpr(&mut ck, *fields[i].value)
                if !isNumeric(ft) && !typeEq(ft, tyString()) && !typeEq(ft, tyBool()) && !typeEq(ft, tyUnknown()) {
                    error(&mut ck, "JSON object field '" + fields[i].name.clone() + "' must be string/number/bool", cloneSpan(expr.span))
                }
            }
            return tyString()
        }
        Expr.FieldAccess(obj, field) => {
            return checkFieldAccess(&mut ck, *obj, field, expr.span)
        }
        Expr.ArrayLit(elements) => {
            return checkArrayLit(&mut ck, elements, expr.span)
        }
        Expr.ArrayRepeat(value, count) => {
            let elemType = checkExpr(&mut ck, *value)
            return TypeKind.TArray(Heap(elemType), Option.Some(count))
        }
        Expr.IndexAccess(obj, index) => {
            return checkIndexAccess(&mut ck, *obj, *index, expr.span)
        }
        Expr.EnumLit(enumName, variant, args) => {
            return checkEnumLit(&mut ck, enumName, variant, args, expr.span)
        }
        Expr.Unwrap(operand) => {
            return checkUnwrap(&mut ck, *operand, expr.span)
        }
        Expr.Propagate(operand) => {
            return checkPropagate(&mut ck, *operand, expr.span)
        }
        Expr.DefaultValue(operand, default) => {
            return checkDefaultValue(&mut ck, *operand, *default, expr.span)
        }
        Expr.CastExpr(operand, targetType) => {
            return checkCast(&mut ck, *operand, targetType, expr.span)
        }
        Expr.MethodCall(obj, method, args) => {
            return checkMethodCall(&mut ck, *obj, method, args, expr.span)
        }
        Expr.Closure(params, retType, body, isMove) => {
            return checkClosure(&mut ck, params, retType, body)
        }
        Expr.RangeExpr(start, end) => {
            let startType = checkExpr(&mut ck, *start)
            let endType = checkExpr(&mut ck, *end)
            if !isInteger(startType) {
                error(&mut ck, "range bounds must be integer", cloneSpan(expr.span))
            }
            return tyVoid()
        }
        Expr.IsExpr(operand, pattern) => {
            checkExpr(&mut ck, *operand)
            return tyBool()
        }
        Expr.IfExpr(cond, thenBody, elseBody) => {
            let condType = checkExpr(&mut ck, *cond)
            if !typeEq(condType, tyBool()) && !typeEq(condType, tyUnknown()) {
                error(&mut ck, "if-expression condition must be bool, got " + typeName(condType), cloneSpan(expr.span))
            }
            // Branches are checked in isolation from the pre-state (a move inside
            // one arm must not poison the other arm's read of the same name —
            // only one arm actually runs), then joined: either arm's moves must
            // survive to the code after, since which one ran is a runtime fact.
            // Mirrors checkIf's branch isolation (stmt.milo), generalized to
            // fork-as-value.
            let fnRetType = ck.currentFnRetType.clone()
            let preSnap = snapshotMoves(ck)
            let thenType = checkIfArmValue(&mut ck, thenBody, fnRetType, expr.span)
            let afterThen = snapshotMoves(ck)
            restoreMoves(&mut ck, preSnap)
            let elseType = checkIfArmValue(&mut ck, elseBody, fnRetType, expr.span)
            let afterElse = snapshotMoves(ck)
            restoreMoves(&mut ck, preSnap)
            orMoves(&mut ck, afterThen)
            orMoves(&mut ck, afterElse)
            // A bare int literal on the ELSE side (`if c { flags() } else { 0 }`) has no
            // intrinsic width — codegen already coerces it (genExpr's IfExpr passes the
            // THEN branch's type down as elseE's hint), so the checker must accept it
            // too instead of reporting a bogus i32-vs-i64 mismatch. Only this direction:
            // codegen's phi always takes its type from thenE, so a literal on the THEN
            // side with a concrete elseE would build a phi with a mismatched incoming
            // value — that stays a hard error rather than silently miscompiling.
            var disagree = !typeEq(thenType, elseType) && !containsUnknown(thenType) && !containsUnknown(elseType)
            if disagree {
                // The clone is why this is guarded: only the mismatch path pays it.
                match blockTailExpr(elseBody) {
                    Option.Some(tail) => {
                        if intCoercible(thenType, elseType, *tail) {
                            disagree = false
                        }
                    }
                    Option.None => {
                    }
                }
            }
            if disagree {
                error(&mut ck, "if-expression branches disagree: " + typeName(thenType) + " vs " + typeName(elseType), cloneSpan(expr.span))
            }
            // A diverging arm types as unknown and lets the other arm decide.
            if containsUnknown(thenType) {
                return elseType
            }
            return thenType
        }
        Expr.MatchExpr(subject, arms) => {
            let fnRetType = ck.currentFnRetType.clone()
            return checkMatchExpr(&mut ck, *subject, arms, fnRetType, expr.span)
        }
    }
}

// -- Identifier --

pub fn checkIdent(ck: &mut Checker, name: &string, span: &Option<Span>): TypeKind {
    setVarRead(&mut ck, name)
    match lookup(ck, name) {
        Option.Some(v) => {
            if v.moved {
                error(&mut ck, "use of moved variable '" + name.clone() + "'", cloneSpan(span))
                return deref(v.ty)
            }
            // A use of the WHOLE value while one of its places is missing. Reading
            // `p.b` after `p.a` left is fine — a different place — and that read
            // reaches here with placeBaseDepth raised, because `p` is only the base
            // of a narrower place there. Anything else names the value itself: an
            // argument, a receiver, a return, a print — handing that on shows the
            // zeroed field as if it were data.
            if ck.placeBaseDepth == 0 {
                match firstMovedField(ck, name) {
                    Option.Some(gone) => {
                        errorHint(&mut ck, "'" + name.clone() + "' is incomplete: '" + name.clone() + gone.clone() + "' was moved out of it", "using '" + name.clone() + "' as a whole would show that field as empty — clone it at the point of transfer, or use the fields that are still there", cloneSpan(span))
                    }
                    Option.None => {
                    }
                }
            }
            return deref(v.ty)
        }
        Option.None => {
            // Check if it's a function name used as value
            if ck.functions.contains(name) {
                let sig = ck.functions.get(name)!
                var params: Vec<TypeKind> = Vec.new()
                for i in 0..sig.params.len {
                    params.push(sig.params[i].ty.clone())
                }
                return TypeKind.TFn(params, Heap(sig.ret.clone()))
            }
            error(&mut ck, "undefined variable '" + name.clone() + "'", cloneSpan(span))
            return tyUnknown()
        }
    }
}

// -- Ranged integers --

// The literal value of `e`, when it is one. Deliberately narrower than
// isConstIntExpr: a range violation is reported with the offending NUMBER, so
// only forms whose value is knowable without folding qualify.
pub fn constIntValue(e: &ExprNode): Option<i64> {
    match e.kind {
        Expr.IntLit(v) => {
            return Option.Some(v)
        }
        Expr.UnaryOp(op, operand) => {
            if op == "-" {
                match (*operand).kind {
                    Expr.IntLit(v) => {
                        return Option.Some(0 - v)
                    }
                    _ => {
                    }
                }
            }
            return Option.None
        }
        _ => {
            return Option.None
        }
    }
}

// Enforce a ranged integer target against a value flowing into it — at a
// let/var, an assignment, a call argument, or a `return`. A literal outside the
// bound is a compile error here; anything else is left to codegen, which emits
// the runtime check. Without this the bound would only ever constrain the
// declaration it was written on, and `f(500)` into an `i32(0..100)` parameter
// would pass silently.
pub fn enforceRangeInto(ck: &mut Checker, value: &ExprNode, target: &TypeKind, span: &Option<Span>) {
    match intRangeOf(target) {
        Option.Some(r) => {
            match constIntValue(value) {
                Option.Some(v) => {
                    if v < r.min || v > r.max {
                        error(&mut ck, "value " + v.toString() + " is out of range for " + typeName(target) + " (" + r.min.toString() + ".." + r.max.toString() + ")", cloneSpan(span))
                    }
                }
                Option.None => {
                }
            }
        }
        Option.None => {
        }
    }
}

// The bounds an arithmetic result is known to satisfy, given both operands
// carry bounds. Returns None when the operation can't be bounded (an unhandled
// operator, or a divisor whose range spans zero).
pub fn propagateRange(lt: &TypeKind, rt: &TypeKind, op: &string): TypeKind {
    var bits: i32 = 0
    var signed = false
    match lt {
        TypeKind.TInt(b, s, _, _) => {
            bits = b
            signed = s
        }
        _ => {
            return tyUnknown()
        }
    }
    var lo = IntRange {
        min: 0, max: 0
    }
    var hi = IntRange {
        min: 0, max: 0
    }
    match intRangeOf(lt) {
        Option.Some(r) => {
            lo = r
        }
        Option.None => {
            return tyUnknown()
        }
    }
    match intRangeOf(rt) {
        Option.Some(r) => {
            hi = r
        }
        Option.None => {
            return tyUnknown()
        }
    }
    var outMin: i64 = 0
    var outMax: i64 = 0
    if op == "+" {
        outMin = lo.min + hi.min
        outMax = lo.max + hi.max
    } else if op == "-" {
        outMin = lo.min - hi.max
        outMax = lo.max - hi.min
    } else if op == "*" {
        let a = lo.min * hi.min
        let b = lo.min * hi.max
        let c = lo.max * hi.min
        let d = lo.max * hi.max
        outMin = minOf4(a, b, c, d)
        outMax = maxOf4(a, b, c, d)
    } else if op == "/" {
        // A divisor range straddling zero says nothing about the quotient.
        if hi.min <= 0 && hi.max >= 0 {
            return tyUnknown()
        }
        let a = lo.min / hi.min
        let b = lo.min / hi.max
        let c = lo.max / hi.min
        let d = lo.max / hi.max
        outMin = minOf4(a, b, c, d)
        outMax = maxOf4(a, b, c, d)
    } else {
        return tyUnknown()
    }
    // A propagated range can never outgrow what the representation holds.
    let typMin = intTypeMin(bits, signed)
    let typMax = intTypeMax(bits, signed)
    if outMin < typMin {
        outMin = typMin
    }
    if outMax > typMax {
        outMax = typMax
    }
    return TypeKind.TInt(bits, signed, Option.Some(outMin), Option.Some(outMax))
}

pub fn minOf4(a: i64, b: i64, c: i64, d: i64): i64 {
    var m = a
    if b < m {
        m = b
    }
    if c < m {
        m = c
    }
    if d < m {
        m = d
    }
    return m
}

pub fn maxOf4(a: i64, b: i64, c: i64, d: i64): i64 {
    var m = a
    if b > m {
        m = b
    }
    if c > m {
        m = c
    }
    if d > m {
        m = d
    }
    return m
}

// -- Binary operators --

// An integer literal (or a const expression built only from integer literals) has
// no intrinsic width — it takes its type from the context. Mirrors the TS
// checker's const-subexpression coercion, without which `pos + 1` on an i64 and
// `b != 0` on a u8 are both type errors.
// An if-expression arm is width-free only when it is a single const-int
// expression — any leading statement means the arm does real work and its type
// is whatever that work produced.
fn isConstIntBlock(body: &Vec<Heap<Stmt>>): bool {
    if body.len != 1 {
        return false
    }
    match *body[0] {
        Stmt.ExprStmt(e, span) => {
            return isConstIntExpr(*e)
        }
        _ => {
            return false
        }
    }
}

pub fn isConstIntExpr(e: &ExprNode): bool {
    match e.kind {
        Expr.IntLit(v) => {
            return true
        }
        // A char literal has no intrinsic width either — `'A' as u8` and a bare
        // 65 should coerce the same way.
        Expr.CharLit(v) => {
            return true
        }
        // ANY operator over constant ints, not just the arithmetic five. Listing
        // operators here made this rule narrower than the property it stands for
        // ("this subtree has no intrinsic width"), and the omitted ones were the
        // bitwise operators — so `pixel | (0xFF << 24)` refused to coerce against a
        // u32 and every framebuffer-packing example failed to compile. Widening a
        // comparison in by accident is harmless: `1 < 2` types as bool, and every
        // caller (intCoercible) requires the source type to be an integer first.
        Expr.UnaryOp(op, operand) => {
            return isConstIntExpr(*operand)
        }
        Expr.BinOp(op, l, r) => {
            return isConstIntExpr(*l) && isConstIntExpr(*r)
        }
        // `if c { 16 } else { 8 }` has no intrinsic width either, same as a bare
        // literal — needed so `let u: u8 = if c {200} else {12}` coerces instead
        // of reporting a bogus u8-vs-i64 mismatch against the whole if-expression
        // (codegen already threads the outer hint into both arms unconditionally;
        // only the checker was refusing to call this const). Recurses through an
        // `else if` chain since its else-arm is itself an Expr.IfExpr.
        Expr.IfExpr(cond, thenBody, elseBody) => {
            return isConstIntBlock(thenBody) && isConstIntBlock(elseBody)
        }
        _ => {
            return false
        }
    }
}

// The float mirror of isConstIntExpr: a float literal (or +/-/*// arithmetic
// built only from float literals) has no intrinsic width and adopts a
// context type — same generalization intCoercible gets from isConstIntExpr,
// needed so a PARENTHESIZED literal subexpression (`(1.0 + 3.0) * w`) retypes
// as a whole, not just a lone `FloatLit` leaf.
pub fn isConstFloatExpr(e: &ExprNode): bool {
    match e.kind {
        Expr.FloatLit(v) => {
            return true
        }
        Expr.UnaryOp(op, operand) => {
            if op == "-" {
                return isConstFloatExpr(*operand)
            }
            return false
        }
        Expr.BinOp(op, l, r) => {
            if op == "+" || op == "-" || op == "*" || op == "/" || op == "%" {
                return isConstFloatExpr(*l) && isConstFloatExpr(*r)
            }
            return false
        }
        _ => {
            return false
        }
    }
}

// A bare float literal (or const-float subtree) defaults to f64 but coerces
// into an f32 (or any float) target the same way an int literal coerces
// between integer widths.
pub fn floatLitCoercible(to: &TypeKind, src: &TypeKind, srcExpr: &ExprNode): bool {
    if !isFloat(to) {
        return false
    }
    if !isFloat(src) {
        return false
    }
    return isConstFloatExpr(srcExpr)
}

// Whether a value of type `src`, produced by `srcExpr`, may be used where `to`
// is expected: only when both are integers and `srcExpr` is a const int.
pub fn intCoercible(to: &TypeKind, src: &TypeKind, srcExpr: &ExprNode): bool {
    if !isInteger(to) {
        return false
    }
    if !isInteger(src) {
        return false
    }
    return isConstIntExpr(srcExpr)
}

// A string argument passed where *u8 is expected reads as its data pointer
// (extern cstr boundary). An int-element array literal takes its element
// width from the annotation, like scalar const-int coercion.
pub fn ptrCoercible(to: &TypeKind, src: &TypeKind): bool {
    match to {
        TypeKind.TPtr(inner) => {
            // string data pointer at the cstr boundary
            match *inner {
                TypeKind.TInt(bits, signed, _, _) => {
                    if bits == 8 && typeEq(src, tyString()) {
                        return true
                    }
                }
                _ => {
                }
            }
            // array-to-pointer decay: [T; N] (and its Vec lowering) where *T
            // is expected — a borrow of the buffer, not a move
            match src {
                TypeKind.TArray(srcElem, size) => {
                    return typeEq(*inner, *srcElem) || (isInteger(*inner) && isInteger(*srcElem))
                }
                TypeKind.TVec(srcElem2) => {
                    return typeEq(*inner, *srcElem2) || (isInteger(*inner) && isInteger(*srcElem2))
                }
                _ => {
                }
            }
            return false
        }
        _ => {
            return false
        }
    }
}

pub fn arrayIntCoercible(to: &TypeKind, src: &TypeKind): bool {
    match to {
        TypeKind.TArray(toElem, toSize) => {
            match src {
                TypeKind.TArray(srcElem, srcSize) => {
                    return isInteger(*toElem) && isInteger(*srcElem)
                }
                TypeKind.TVec(srcElem2) => {
                    return isInteger(*toElem) && isInteger(*srcElem2)
                }
                _ => {
                    return false
                }
            }
        }
        _ => {
            return false
        }
    }
}

// `let v: Vec<T> = [a, b, c]` — an array literal coerces to a Vec when the
// declared type is Vec<T> and element types match (incl. int-width coercion).
pub fn arrayToVecCoercible(to: &TypeKind, src: &TypeKind): bool {
    match to {
        TypeKind.TVec(toElem) => {
            match src {
                TypeKind.TArray(srcElem, srcSize) => {
                    return typeEq(*toElem, *srcElem) || (isInteger(*toElem) && isInteger(*srcElem))
                }
                _ => {
                    return false
                }
            }
        }
        _ => {
            return false
        }
    }
}

// operator → overload method name (Add/Sub/Mul/Div traits), or "" if not overloadable
pub fn opMethodName(op: &string): string {
    if op == "+" {
        return "add"
    }
    if op == "-" {
        return "sub"
    }
    if op == "*" {
        return "mul"
    }
    if op == "/" {
        return "div"
    }
    return ""
}

// True if a value of type `valType` (a concrete struct, or Heap<Concrete>) coerces
// to interface `hint` — i.e. hint is an interface and the concrete implements it.
pub fn interfaceCoercible(ck: &Checker, hint: &TypeKind, valType: &TypeKind): bool {
    match hint {
        TypeKind.TStruct(iface) => {
            if !ck.traits.contains(iface) {
                return false
            }
            match valType {
                TypeKind.TStruct(cn) => {
                    return structImplementsInterface(ck, cn, iface)
                }
                TypeKind.THeap(inner) => {
                    match *inner {
                        TypeKind.TStruct(cn2) => {
                            return structImplementsInterface(ck, cn2, iface)
                        }
                        _ => {
                            return false
                        }
                    }
                }
                _ => {
                    return false
                }
            }
        }
        _ => {
            return false
        }
    }
}

// True if `sname` (a concrete struct) implements every method of interface `iface`
// (a registered trait) — the requirement to coerce it to an `&iface` trait object.
pub fn structImplementsInterface(ck: &Checker, sname: &string, iface: &string): bool {
    if !ck.traits.contains(iface) {
        return false
    }
    if !ck.structs.contains(sname) {
        return false
    }
    let tinfo = ck.traits.get(iface)!
    for mname, minfo in tinfo.methods {
        if !structHasMethod(ck, sname, mname) {
            return false
        }
    }
    return true
}

// does struct `sname` define method `method` via an inherent or trait impl?
pub fn structHasMethod(ck: &Checker, sname: &string, method: &string): bool {
    if method.len == 0 {
        return false
    }
    if ck.inherentImpls.contains(sname) {
        // extract ONCE: inline `get(sname)!.methods.contains()` clones the nested-Vec
        // ImplDecl on the temporary and hangs (the documented HashMap.get gotcha).
        let implD = ck.inherentImpls.get(sname)!
        if implD.methods.contains(method) {
            return true
        }
    }
    if ck.traitImpls.contains(sname) {
        let impls = ck.traitImpls.get(sname)!
        for i in 0..impls.len {
            if impls[i].methods.contains(method) {
                return true
            }
        }
    }
    return false
}

pub fn checkBinOp(ck: &mut Checker, op: &string, left: &ExprNode, right: &ExprNode, span: &Option<Span>): TypeKind {
    // Logical operators
    if op == "&&" || op == "||" {
        let lt = checkExpr(&mut ck, left)
        let rt = checkExpr(&mut ck, right)
        if !typeEq(lt, tyBool()) {
            error(&mut ck, "operator '" + op.clone() + "' requires bool, got " + typeName(lt), cloneSpan(span))
        }
        if !typeEq(rt, tyBool()) {
            error(&mut ck, "operator '" + op.clone() + "' requires bool, got " + typeName(rt), cloneSpan(span))
        }
        return tyBool()
    }

    let lt = checkExpr(&mut ck, left)
    let rt = checkExpr(&mut ck, right)

    // String concatenation
    if op == "+" && typeEq(lt, tyString()) && typeEq(rt, tyString()) {
        return tyString()
    }
    // String equality
    if (op == "==" || op == "!=") && typeEq(lt, tyString()) && typeEq(rt, tyString()) {
        return tyBool()
    }

    // Operator overloading: `a + b` on a struct implementing Add/Sub/Mul/Div
    // desugars to a.<op>(b); the result is the struct type.
    if op == "+" || op == "-" || op == "*" || op == "/" {
        let opm = opMethodName(op)
        match lt.clone() {
            TypeKind.TStruct(sname) => {
                if structHasMethod(ck, sname, opm) {
                    return lt.clone()
                }
            }
            _ => {
            }
        }
    }

    // Arithmetic
    if op == "+" || op == "-" || op == "*" || op == "/" || op == "%" {
        if !isNumeric(lt) && !typeEq(lt, tyUnknown()) {
            error(&mut ck, "operator '" + op.clone() + "' requires numeric type, got " + typeName(lt), cloneSpan(span))
        }
        if !typeEq(lt, rt) && !typeEq(lt, tyUnknown()) && !typeEq(rt, tyUnknown()) {
            if intCoercible(lt, rt, right) {
                return lt
            }
            if intCoercible(rt, lt, left) {
                return rt.clone()
            }
            if floatLitCoercible(lt, rt, right) {
                return lt
            }
            if floatLitCoercible(rt, lt, left) {
                return rt.clone()
            }
            error(&mut ck, "type mismatch in '" + op.clone() + "': " + typeName(lt) + " vs " + typeName(rt), cloneSpan(span))
        }
        // Both operands bounded → the result is bounded too, which is what lets
        // `a + b` on two i32(0..100) land in an i32(0..200) without a check.
        let propagated = propagateRange(lt, rt, op)
        if !typeEq(propagated, tyUnknown()) {
            return propagated
        }
        return lt
    }

    // Bitwise
    if op == "&" || op == "|" || op == "^" || op == "<<" || op == ">>" {
        if !isInteger(lt) && !typeEq(lt, tyUnknown()) {
            error(&mut ck, "operator '" + op.clone() + "' requires integer type, got " + typeName(lt), cloneSpan(span))
        }
        if !typeEq(lt, rt) && !typeEq(lt, tyUnknown()) && !typeEq(rt, tyUnknown()) {
            if intCoercible(lt, rt, right) {
                return lt
            }
            if intCoercible(rt, lt, left) {
                return rt.clone()
            }
            error(&mut ck, "type mismatch in '" + op.clone() + "': " + typeName(lt) + " vs " + typeName(rt), cloneSpan(span))
        }
        return lt
    }

    // Comparison
    if op == "==" || op == "!=" || op == "<" || op == ">" || op == "<=" || op == ">=" {
        if !typeEq(lt, rt) && !typeEq(lt, tyUnknown()) && !typeEq(rt, tyUnknown())
        && !intCoercible(lt, rt, right) && !intCoercible(rt, lt, left)
        && !floatLitCoercible(lt, rt, right) && !floatLitCoercible(rt, lt, left) {
            error(&mut ck, "type mismatch in '" + op.clone() + "': " + typeName(lt) + " vs " + typeName(rt), cloneSpan(span))
        }
        if op == "<" || op == ">" || op == "<=" || op == ">=" {
            // strings compare lexicographically (codegen emits a memcmp-based compare)
            if !isNumeric(lt) && !typeEq(lt, tyString()) && !typeEq(lt, tyUnknown()) {
                error(&mut ck, "operator '" + op.clone() + "' requires numeric or string type, got " + typeName(lt), cloneSpan(span))
            }
        }
        return tyBool()
    }

    error(&mut ck, "unknown operator '" + op.clone() + "'", cloneSpan(span))
    return tyUnknown()
}

// -- Unary operators --

pub fn checkUnaryOp(ck: &mut Checker, op: &string, operand: &ExprNode, span: &Option<Span>): TypeKind {
    let ot = checkExpr(&mut ck, operand)

    if op == "*" {
        match ot {
            TypeKind.THeap(inner) => {
                return (*inner).clone()
            }
            TypeKind.TPtr(inner) => {
                if ck.unsafeDepth == 0 {
                    error(&mut ck, "pointer dereference requires 'unsafe' block", cloneSpan(span))
                }
                return inner.clone()
            }
            _ => {
                error(&mut ck, "cannot dereference type '" + typeName(ot) + "'", cloneSpan(span))
                return tyUnknown()
            }
        }
    }
    if op == "-" {
        if !isNumeric(ot) && !typeEq(ot, tyUnknown()) {
            error(&mut ck, "unary '-' requires numeric type, got " + typeName(ot), cloneSpan(span))
        }
        return ot
    }
    if op == "!" {
        if !typeEq(ot, tyBool()) && !typeEq(ot, tyUnknown()) {
            error(&mut ck, "unary '!' requires bool, got " + typeName(ot), cloneSpan(span))
        }
        return tyBool()
    }
    if op == "~" {
        if !isInteger(ot) && !typeEq(ot, tyUnknown()) {
            error(&mut ck, "unary '~' requires integer type, got " + typeName(ot), cloneSpan(span))
        }
        return ot
    }
    if op == "&mut" {
        // Only reached outside a call argument: the parser drops the marker there.
        error(&mut ck, "'&mut' marks an argument to a '&mut' parameter; it is not a value", cloneSpan(span))
        return ot
    }
    if op == "&" {
        // `&` is a borrow marker that appears only in a TYPE (`&T`), never an
        // expression. Shared borrows are implicit; only `&mut` is spelled at a call
        // site. Raw pointers come from `v.ptr()` / `x.addrOf()`.
        error(&mut ck, "'&x' is not an expression: shared borrows are implicit (pass 'x' bare). Only a '&mut' argument is spelled out: 'f(&mut x)'. For a raw pointer use 'v.ptr()' or 'x.addrOf()'.", cloneSpan(span))
        return TypeKind.TPtr(Heap(ot))
    }
    return tyUnknown()
}

// -- Function calls --

// Is `name` bound in local scope to something callable (a closure/fn-typed
// param or local)? Used to let a local shadow a same-named global function —
// see checkCall's comment on the paramShadowsGlobal fixture.
pub fn isLocalCallableFn(ck: &Checker, name: &string): bool {
    match lookup(ck, name) {
        Option.Some(v) => {
            match v.ty {
                TypeKind.TFn(params, ret) => {
                    return true
                }
                _ => {
                    return false
                }
            }
        }
        Option.None => {
            return false
        }
    }
}

pub fn checkCall(ck: &mut Checker, func: &string, args: &Vec<Heap<ExprNode>>, typeArgs: &Vec<MiloType>, span: &Option<Span>): TypeKind {
    // Static method on an instantiated generic type: Type<Args>.method(...)
    var dotIdx: i64 = -1
    for di in 0..func.len {
        if func[di] == 46 {
            dotIdx = di
            break
        }
    }
    if dotIdx > 0 && typeArgs.len > 0 {
        let base = func[0..dotIdx].clone()
        let methodName = func[dotIdx + 1..func.len].clone()
        // resolveAstType, not typeFromAst: an explicit type argument can itself be a
        // generic instantiation (`Promise<Shard<T>>.blocking(...)`), and typeFromAst
        // drops the inner type arguments — the outer name then mangled as
        // `Promise_Shard` instead of `Promise_Shard_u32`, and every use of the result
        // reported "expected () => Shard, got () => Shard_u32".
        var tks: Vec<TypeKind> = Vec.new()
        for ti in 0..typeArgs.len {
            tks.push(normalizeEnumNames(ck, resolveAstType(&mut ck, typeArgs[ti])))
        }
        var mangled = ""
        if ck.genericStructs.contains(base) {
            mangled = monomorphizeStruct(&mut ck, base, tks)
        } else if ck.genericEnums.contains(base) {
            mangled = monomorphizeEnum(&mut ck, base, tks)
        }
        if mangled.len > 0 {
            match resolveMethod(ck, mangled, methodName) {
                Option.Some(fnName) => {
                    var noTypeArgs: Vec<MiloType> = Vec.new()
                    return checkCall(&mut ck, fnName, args, noTypeArgs, span)
                }
                Option.None => {
                    error(&mut ck, "no method '" + methodName.clone() + "' on '" + mangled.clone() + "'", cloneSpan(span))
                    return tyUnknown()
                }
            }
        }
    }

    // Heap constructor
    if func == "Heap" {
        if args.len != 1 {
            error(&mut ck, "Heap() expects 1 argument, got " + args.len.toString(), cloneSpan(span))
            return tyUnknown()
        }
        let argType = checkExpr(&mut ck, *args[0])
        tryMove(&mut ck, *args[0])
        return TypeKind.THeap(Heap(argType))
    }

    // f-strings lower to `format(parts...)` in parseFString; it is a builtin, not
    // a prelude function. Variadic, any displayable part, yields a string.
    if func == "format" {
        for arg in args {
            checkExpr(&mut ck, *arg)
        }
        return tyString()
    }

    // jsonStringify(struct): compiler intrinsic → JSON string of a struct's
    // scalar fields (string/bool/int/float). Not a prelude fn.
    if func == "jsonStringify" {
        if args.len != 1 {
            error(&mut ck, "jsonStringify() expects 1 argument, got " + args.len.toString(), cloneSpan(span))
            return tyString()
        }
        let argType = checkExpr(&mut ck, *args[0])
        match argType {
            TypeKind.TStruct(sname) => {
                if ck.structs.contains(sname) {
                    let sinfo = ck.structs.get(sname)!
                    for fi in 0..sinfo.fields.len {
                        let ft = sinfo.fields[fi].ty
                        if !isInteger(ft) && !isFloat(ft) && !typeEq(ft, tyBool()) && !typeEq(ft, tyString()) {
                            error(&mut ck, "jsonStringify: field '" + sinfo.fields[fi].name.clone() + "' has unsupported type '" + typeName(ft) + "' (only string/bool/int/float)", cloneSpan(span))
                        }
                    }
                }
            }
            _ => {
                error(&mut ck, "jsonStringify: unsupported type '" + typeName(argType) + "' (expects a struct)", cloneSpan(span))
            }
        }
        return tyString()
    }

    // flush() — flush stdout (fflush(null)); a void builtin. Guarded on there being
    // no user function of the same name: a module-private `fn flush(...)` (std/deflate's
    // bit-writer flush, for one) would otherwise always resolve to this builtin instead —
    // wrong arg count silently accepted, wrong (empty) behavior codegen'd, no diagnostic.
    if func == "flush" && !ck.functions.contains(func) {
        return tyVoid()
    }
    // embedFile("path"): compile-time file embed → string literal (codegen reads
    // the file relative to the source dir). Argument must be a string literal.
    // `@targetOs()` is a compile-time constant string; codegen folds it to a literal.
    if func == "targetOs" {
        if args.len != 0 {
            error(&mut ck, "targetOs() takes no arguments, got " + args.len.toString(), cloneSpan(span))
        }
        return tyString()
    }
    if func == "embedFile" {
        if args.len != 1 {
            error(&mut ck, "embedFile() expects 1 argument, got " + args.len.toString(), cloneSpan(span))
        }
        if args.len >= 1 {
            match (*args[0]).kind {
                Expr.StringLit(s) => {
                }
                _ => {
                    error(&mut ck, "embedFile() argument must be a string literal", cloneSpan(span))
                }
            }
        }
        return tyString()
    }

    // print/println/eprint are compiler builtins (codegen/expr.milo genCall), not
    // prelude functions — the checker has to know them or every call is
    // "undefined function". Variadic; any displayable argument.
    if func == "print" || func == "println" || func == "eprint" {
        for arg in args {
            checkExpr(&mut ck, *arg)
        }
        return tyVoid()
    }

    // forget(x) — consume a value and suppress its drop. This compiler does not yet
    // emit the owning-closure drop glue that `forget` exists to suppress, so checking
    // the argument and yielding void IS the whole behaviour here; std/runtime.milo
    // calls it and without this arm the fixpoint died at "undefined function 'forget'".
    //
    // Guarded on there being no user function of the name, exactly as src/checker.ts is.
    // Without the guard the builtin SHADOWS a user's own `forget`: the milo-gl package
    // defines `fn forget(v: &mut Vec<u32>, id: u32)` and every call to it was rejected
    // with "'forget' takes exactly one argument" — a builtin quietly winning against the
    // program's own function, which is the one thing a name-matched builtin must not do.
    if func == "forget" && !ck.functions.contains(func) {
        if args.len != 1 {
            error(&mut ck, "'forget' takes exactly one argument", cloneSpan(span))
            return tyVoid()
        }
        checkExpr(&mut ck, *args[0])
        return tyVoid()
    }

    // assert builtin
    if func == "assert" {
        if args.len < 1 || args.len > 2 {
            error(&mut ck, "assert() expects 1-2 arguments, got " + args.len.toString(), cloneSpan(span))
            return tyVoid()
        }
        let condType = checkExpr(&mut ck, *args[0])
        if !typeEq(condType, tyBool()) && !typeEq(condType, tyUnknown()) {
            error(&mut ck, "assert() condition must be bool, got " + typeName(condType), cloneSpan(span))
        }
        if args.len == 2 {
            let msgType = checkExpr(&mut ck, *args[1])
            if !typeEq(msgType, tyString()) && !typeEq(msgType, tyUnknown()) {
                error(&mut ck, "assert() message must be a string, got " + typeName(msgType), cloneSpan(span))
            }
        }
        return tyVoid()
    }

    // max/min builtins
    if func == "max" || func == "min" {
        if args.len != 2 {
            error(&mut ck, func.clone() + "() expects 2 arguments, got " + args.len.toString(), cloneSpan(span))
            return tyUnknown()
        }
        let aType = checkExpr(&mut ck, *args[0])
        let bType = checkExpr(&mut ck, *args[1])
        if !isNumeric(aType) && !typeEq(aType, tyUnknown()) {
            error(&mut ck, func.clone() + "() arguments must be numeric", cloneSpan(span))
            return tyUnknown()
        }
        if !typeEq(aType, bType) && !typeEq(bType, tyUnknown()) && !typeEq(aType, tyUnknown()) {
            error(&mut ck, func.clone() + "() arguments must be same type", cloneSpan(span))
        }
        return aType
    }

    // Regular function call. A callable in local scope wins over a global
    // function of the same name — innermost binding, as everywhere else in the
    // language. Globals used to be consulted first (this block only ran when
    // `func` was NOT a global at all), so a parameter could never shadow one:
    // a user defining `fn handler` broke std/http's *internal* `handler(ctx)`
    // call against its own param, reporting a type error inside a file the
    // user never opened (see the paramShadowsGlobal fixture). Widening entry
    // into this block to "no global OR a local fn-typed var exists" lets the
    // closure-variable check below win the race without disturbing anything
    // else this block already handles (generic fns, sizeOf, replace, …) for
    // the plain global-call case, which still skips this block entirely.
    if !ck.functions.contains(func) || isLocalCallableFn(ck, func) {
        // Check if it's a closure variable
        let info = lookup(ck, func)
        match info {
            Option.Some(v) => {
                match v.ty {
                    TypeKind.TFn(params, ret) => {
                        if args.len != params.len {
                            error(&mut ck, "closure expects " + params.len.toString() + " args, got " + args.len.toString(), cloneSpan(span))
                        }
                        var i: i64 = 0
                        while i < args.len && i < params.len {
                            let argType = checkExpr(&mut ck, *args[i])
                            // a &T param auto-borrows a T argument, like a normal call
                            var pMatch = typeEq(params[i], argType) || typeEq(argType, tyUnknown())
                            if !pMatch {
                                match params[i] {
                                    TypeKind.TRef(inner, m) => {
                                        if typeEq(*inner, argType) {
                                            pMatch = true
                                        }
                                    }
                                    _ => {
                                    }
                                }
                            }
                            // A bare int literal argument defaults to i64 (Expr.IntLit
                            // always returns tyI64 — there is no hint-threading into it
                            // the way a struct field or let-binding gets via ck.expectedType),
                            // so calling an `(i32) => i32` closure with a plain `3` failed
                            // here even though every other call site (fn params, struct
                            // fields, let bindings) accepts the same literal via
                            // intCoercible. Same fallback, applied here too.
                            if !pMatch && intCoercible(params[i], argType, *args[i]) {
                                pMatch = true
                            }
                            if !pMatch {
                                error(&mut ck, "closure argument " + (i + 1).toString() + ": expected " + typeName(params[i]) + ", got " + typeName(argType), cloneSpan(span))
                            }
                            i = i + 1
                        }
                        return ret.clone()
                    }
                    _ => {
                    }
                }
            }
            Option.None => {
            }
        }
        // Generic function call: infer type args from argument types
        if ck.genericFns.contains(func) {
            return checkGenericCall(&mut ck, func, args, span)
        }
        // sizeOf<T>() is a compiler builtin: size of the instantiated type
        if func == "sizeOf" {
            return tyI64()
        }
        // offsetOf<T>("field") — byte offset of a field within a struct type
        if func == "offsetOf" {
            if args.len >= 1 {
                checkExpr(&mut ck, *args[0])
            }
            return tyI64()
        }
        // zeroed<T>() — a zero value of the instantiated type
        if func == "zeroed" && typeArgs.len == 1 {
            return normalizeEnumNames(ck, typeFromAst(typeArgs[0]))
        }
        // `replace(place, value)` / `swap(a, b)`: memory intrinsics whose bodies can't be
        // written in safe Milo (they move a value out of a place and refill it). Gated on
        // the name being otherwise unbound so a user fn of the same name wins. std/io's
        // BufReader/BufWriter flush paths use `replace` to swap out an owned buffer
        // without a temporary; every fixture importing std/io hit "undefined function".
        if func == "replace" {
            if args.len != 2 {
                error(&mut ck, "replace(place, value) takes exactly two arguments", cloneSpan(span))
                return tyUnknown()
            }
            if !isRootMutable(ck, *args[0]) {
                error(&mut ck, "cannot replace through an immutable place", cloneSpan(span))
            }
            let placeTy = checkExpr(&mut ck, *args[0])
            let valTy = checkExpr(&mut ck, *args[1])
            if !typeEq(valTy, placeTy) && !typeEq(valTy, tyUnknown()) && !typeEq(placeTy, tyUnknown()) && !intCoercible(placeTy, valTy, *args[1]) {
                error(&mut ck, "replace: value type " + typeName(valTy) + " does not match place type " + typeName(placeTy), cloneSpan(span))
            }
            tryMove(&mut ck, *args[1])
            return placeTy
        }
        if func == "swap" {
            if args.len != 2 {
                error(&mut ck, "swap(a, b) takes exactly two arguments", cloneSpan(span))
                return tyVoid()
            }
            if !isRootMutable(ck, *args[0]) {
                error(&mut ck, "cannot swap through an immutable place", cloneSpan(span))
            }
            if !isRootMutable(ck, *args[1]) {
                error(&mut ck, "cannot swap through an immutable place", cloneSpan(span))
            }
            let aTy = checkExpr(&mut ck, *args[0])
            let bTy = checkExpr(&mut ck, *args[1])
            if !typeEq(aTy, bTy) && !typeEq(aTy, tyUnknown()) && !typeEq(bTy, tyUnknown()) {
                error(&mut ck, "swap: operands have different types " + typeName(aTy) + " and " + typeName(bTy), cloneSpan(span))
            }
            return tyVoid()
        }
        // _cstrToString(ptr) — compiler builtin at the extern cstr boundary
        if func == "_cstrToString" {
            if args.len >= 1 {
                checkExpr(&mut ck, *args[0])
            }
            return tyString()
        }
        // _bytesToString(ptr, len) — compiler builtin, (*u8, i64) -> string. std/io's
        // readAll uses it and then pipes the result straight into `result.pushStr(...)`,
        // which hard-requires a string arg; falling through to the generic underscore
        // fallback below (which returns unknown) failed that check on every fixture
        // that transitively imports std/io.
        if func == "_bytesToString" {
            for arg in args {
                checkExpr(&mut ck, *arg)
            }
            return tyString()
        }
        // Builtins that codegen implements and the checker has to know the TYPE of.
        // These all used to fall through to the catch-all underscore rule below and
        // come back `unknown`, which is permissive enough to go unnoticed until
        // something needs a real type: `_strDataPtr(s).addrOf()` produced
        // `*<unknown>` instead of `**u8`, so every `glShaderSource` call in the GL
        // package failed its extern argument check and no GPU example compiled.
        // Signatures mirror src/checker.ts's registerBuiltins exactly.
        if func == "_strDataPtr" {
            for arg in args {
                checkExpr(&mut ck, *arg)
            }
            return TypeKind.TPtr(Heap(tyU8()))
        }
        if func == "_loadU8" {
            for arg in args {
                checkExpr(&mut ck, *arg)
            }
            return tyU8()
        }
        if func == "_loadI32" {
            for arg in args {
                checkExpr(&mut ck, *arg)
            }
            return tyI32()
        }
        if func == "_miloArgCount" {
            return tyI64()
        }
        if func == "_miloArgAt" {
            for arg in args {
                checkExpr(&mut ck, *arg)
            }
            return tyString()
        }
        if func == "_putByte" || func == "_callClosureVoid" {
            for arg in args {
                checkExpr(&mut ck, *arg)
            }
            return tyVoid()
        }
        // Atomics and scheduler hooks. Note the compare-and-swap family does NOT
        // return bool for the integer widths — Cas{I32,I64} return the OLD VALUE and
        // only CasBool returns a bool. Taken from src/checker.ts rather than inferred
        // from the names, which would have got exactly that wrong.
        if func == "_atomicLoadI64" || func == "_atomicAddI64" || func == "_atomicSubI64"
        || func == "_atomicSwapI64" || func == "_atomicCasI64" {
            for arg in args {
                checkExpr(&mut ck, *arg)
            }
            return tyI64()
        }
        if func == "_atomicLoadI32" || func == "_atomicAddI32" || func == "_atomicSubI32"
        || func == "_atomicSwapI32" || func == "_atomicCasI32" {
            for arg in args {
                checkExpr(&mut ck, *arg)
            }
            return tyI32()
        }
        if func == "_atomicLoadBool" || func == "_atomicSwapBool" || func == "_atomicCasBool" {
            for arg in args {
                checkExpr(&mut ck, *arg)
            }
            return tyBool()
        }
        if func == "_atomicStoreI64" || func == "_atomicStoreI32" || func == "_atomicStoreBool"
        || func == "_schedulerSet" {
            for arg in args {
                checkExpr(&mut ck, *arg)
            }
            return tyVoid()
        }
        if func == "_schedulerGet" {
            return TypeKind.TPtr(Heap(tyU8()))
        }
        // runtime-support builtins (_atomic*, _callClosure*, scheduler hooks)
        // exist in the oracle's codegen only; accept them so std checks
        if func.len > 1 && func[0] == 95 {
            for arg in args {
                checkExpr(&mut ck, *arg)
            }
            return tyUnknown()
        }
        // exit is a compiler builtin when std/os is not imported
        if func == "exit" {
            if args.len >= 1 {
                checkExpr(&mut ck, *args[0])
            }
            return tyVoid()
        }
        // Promise(fn) desugars to Promise<T>.run(fn) with T = the fn's return type.
        if func == "Promise" && args.len == 1 && ck.genericStructs.contains("Promise") {
            let argT = checkExpr(&mut ck, *args[0])
            var retT = tyUnknown()
            match argT {
                TypeKind.TFn(fparams, fret) => {
                    retT = (*fret).clone()
                }
                _ => {
                    error(&mut ck, "Promise() argument must be a function", cloneSpan(span))
                }
            }
            var targs: Vec<TypeKind> = Vec.new()
            targs.push(retT)
            let mangled = monomorphizeStruct(&mut ck, "Promise", targs)
            return TypeKind.TStruct(mangled)
        }
        error(&mut ck, "undefined function '" + func.clone() + "'", cloneSpan(span))
        return tyUnknown()
    }

    let sig = ck.functions.get(func)!
    // Deep-copy param types + ret NOW: `ck.functions.get` returns a shallow copy
    // whose nested Heap/string buffers alias the map's storage, and checking an
    // argument below can insert into ck.functions (e.g. registering a struct's
    // interface impl), rehashing the map and dangling `sig`. TypeKind.clone is deep.
    var ownedParams: Vec<TypeKind> = Vec.new()
    for pci in 0..sig.params.len {
        ownedParams.push(sig.params[pci].ty.clone())
    }
    let ownedRet = sig.ret.clone()
    let paramCount = sig.params.len
    let isVariadicSig = sig.variadic
    if isVariadicSig {
        if args.len < paramCount {
            error(&mut ck, "function '" + func.clone() + "' expects at least " + paramCount.toString() + " args, got " + args.len.toString(), cloneSpan(span))
        }
    } else if args.len != paramCount {
        error(&mut ck, "function '" + func.clone() + "' expects " + paramCount.toString() + " args, got " + args.len.toString(), cloneSpan(span))
    }

    // Call-site exclusivity: every arg landing in a `&`/`&mut` param below is a
    // borrow taken FOR THIS CALL — collected here, checked once all args are
    // seen (see checkCallSiteExclusivity).
    var callMuts: Vec<BorrowArg> = Vec.new()
    var callShared: Vec<BorrowArg> = Vec.new()
    var i: i64 = 0
    while i < args.len && i < paramCount {
        let paramType = ownedParams[i].clone()
        // compute the param's display name BEFORE matching: destructuring the TRef
        // arm below MOVES its inner Heap into `inner`, leaving `paramType` unusable
        // (typeName on it then reads a moved-out buffer → runaway alloc).
        let ptName = typeName(paramType)
        // Steer const-int enum-lit payload widths to the param (see
        // checkGenericEnumLit); reset after, matching the struct-field idiom.
        // Borrows are implicit, so an argument for a `&T`/`&mut T` param is
        // written bare and the expression being checked has type T, not &T —
        // hand the hint the pointee. Every consumer matches the bare shape, so
        // an un-stripped TRef reads as "no hint": `f(v: &Vec<f32>)` called with
        // `Vec.filled(n, 0.0)` fell back to the literal's own f64 and reported a
        // Vec<f64>-vs-&Vec<f32> mismatch.
        var hint = paramType.clone()
        match paramType.clone() {
            TypeKind.TRef(pointee, m) => {
                hint = (*pointee).clone()
            }
            _ => {
            }
        }
        ck.expectedType = Option.Some(hint)
        let argType = checkExpr(&mut ck, *args[i])
        ck.expectedType = Option.None
        match paramType {
            TypeKind.TRef(inner, mutable) => {
                // interface coercion: a concrete struct implementing interface `inner`
                // may be passed as `&inner` (codegen builds the fat pointer).
                var ifaceOk = false
                match (*inner).clone() {
                    TypeKind.TStruct(ifn) => {
                        match argType.clone() {
                            TypeKind.TStruct(an) => {
                                if structImplementsInterface(ck, an, ifn) {
                                    ifaceOk = true
                                }
                            }
                            _ => {
                            }
                        }
                    }
                    _ => {
                    }
                }
                // `&[T]` (an unsized-array slice param) also accepts a Vec<T> or a
                // fixed [T;N] argument — a fixed array lowers onto the same %Vec
                // runtime rep (see codegen astTypeStr), so at the call boundary
                // they're interchangeable; only the element type has to line up.
                var arrOk = false
                match (*inner).clone() {
                    TypeKind.TArray(reqElem, reqSize) => {
                        match reqSize {
                            Option.None => {
                                match argType.clone() {
                                    TypeKind.TVec(argElem) => {
                                        if typeEq(*reqElem, *argElem) {
                                            arrOk = true
                                        }
                                    }
                                    TypeKind.TArray(argElem, argSize) => {
                                        if typeEq(*reqElem, *argElem) {
                                            arrOk = true
                                        }
                                    }
                                    _ => {
                                    }
                                }
                            }
                            _ => {
                            }
                        }
                    }
                    _ => {
                    }
                }
                // A view passed straight through (the arg is ALREADY a matching &T,
                // e.g. a method that returns &string/&[T]) has to be accepted too —
                // comparing only the unwrapped inner rejected it even when both sides
                // print identically as "&string", because the arg's own ref wrapper
                // was never stripped before the comparison.
                //
                // Mutability is deliberately NOT compared here — matches the oracle
                // (src/checker.ts: `argType.tag === "ref" && typeEq(paramType.inner,
                // argType.inner)`, no `.mutable` check). `.slice()` always returns an
                // immutable-tagged &[T] regardless of the source's own mutability
                // (checker/expr.milo `method == "slice"`, mirroring the TS oracle's
                // hardcoded `mutable: false`), so a mutable Vec's own disjoint windows
                // (`fill(v[0..2], v[2..4])` into two `&mut [T]` params) would otherwise
                // be rejected as "&[T] where &mut [T] expected" even though the source
                // is mutable. The oracle instead enforces real mutability (rejecting a
                // `let`-rooted Vec passed as `&mut`) at the auto-borrow site, not here.
                var refPassThrough = false
                match argType.clone() {
                    TypeKind.TRef(argInner, argMutable) => {
                        if typeEq(*inner, *argInner) {
                            refPassThrough = true
                        }
                    }
                    _ => {
                    }
                }
                // auto-borrow: don't type-error, just check inner matches
                if !ifaceOk && !arrOk && !refPassThrough && !typeEq(*inner, argType) && !typeEq(argType, tyUnknown()) && !intCoercible(*inner, argType, *args[i]) {
                    error(&mut ck, "argument " + (i + 1).toString() + " of '" + func.clone() + "': expected " + ptName + ", got " + typeName(argType), cloneSpan(span))
                }
                // Auto-borrowing a `&mut` param mutates the source through the
                // call — same hazard a mutating method receiver already rejects.
                // A `let` binding claims immutability; feeding it to `&mut`
                // would let the callee write through it anyway. Also reject
                // passing a var that's frozen by a live slice/loop borrow: the
                // callee may realloc/free it out from under that borrow.
                if mutable {
                    match rootIdentName(*args[i]) {
                        Option.Some(rname) => {
                            match lookup(ck, rname) {
                                Option.Some(rinfo) => {
                                    var isRefTy = false
                                    match rinfo.ty.clone() {
                                        TypeKind.TRef(rinner, rmut) => {
                                            isRefTy = true
                                        }
                                        _ => {
                                        }
                                    }
                                    if !rinfo.mutable && !isRefTy {
                                        error(&mut ck, "cannot pass immutable '" + rname.clone() + "' as a '&mut' argument", cloneSpan(span))
                                    }
                                }
                                Option.None => {
                                }
                            }
                        }
                        Option.None => {
                        }
                    }
                    // An argument that is ALREADY a reference (a slice like
                    // `v[0..2]`) is not competing with the freeze, it IS one —
                    // checkCallSiteExclusivity below is what decides whether two
                    // of them may coexist.
                    var argIsRef = false
                    match argType.clone() {
                        TypeKind.TRef(ainner, amut) => {
                            argIsRef = true
                        }
                        _ => {
                        }
                    }
                    if !argIsRef {
                        errorIfFrozenRoot(&mut ck, *args[i], "pass", span)
                    }
                }
                match borrowArgOf(*args[i]) {
                    Option.Some(ba) => {
                        if mutable {
                            callMuts.push(ba)
                        } else {
                            callShared.push(ba)
                        }
                    }
                    Option.None => {
                    }
                }
            }
            _ => {
                if !typeEq(paramType, argType) && !typeEq(argType, tyUnknown()) && !intCoercible(paramType, argType, *args[i]) &&
                !floatLitCoercible(paramType, argType, *args[i]) &&
                !ptrCoercible(paramType, argType) && !optionWrapCoercible(ck, paramType, argType) {
                    error(&mut ck, "argument " + (i + 1).toString() + " of '" + func.clone() + "': expected " + ptName + ", got " + typeName(argType), cloneSpan(span))
                }
                enforceRangeInto(&mut ck, *args[i], paramType, span)
                // pointer decay borrows the buffer; it must not move it
                if !ptrCoercible(paramType, argType) {
                    tryMove(&mut ck, *args[i])
                }
            }
        }
        i = i + 1
    }
    checkCallSiteExclusivity(&mut ck, callMuts, callShared, span)

    // Check remaining variadic args
    while i < args.len {
        checkExpr(&mut ck, *args[i])
        i = i + 1
    }

    return ownedRet
}

// -- Struct literals --

pub fn checkStructLit(ck: &mut Checker, name: &string, fields: &Vec<StructLitField>, span: &Option<Span>): TypeKind {
    var structName = name.clone()
    // A bare generic-struct literal (`Arena { ... }` inside arenaNew<T>) isn't a
    // registered struct on its own; if the expected type is a monomorphized
    // instance whose base is this name, use that instance (Arena → Arena_DLNode).
    if !ck.structs.contains(structName) {
        match ck.expectedType {
            Option.Some(et) => {
                match et {
                    TypeKind.TStruct(mangled) => {
                        for inst in ck.structInsts {
                            if inst.mangled == mangled && inst.base == structName {
                                structName = mangled.clone()
                            }
                        }
                    }
                    _ => {
                    }
                }
            }
            Option.None => {
            }
        }
    }
    // A generic-struct literal with no annotation (`Heap { value: 42 }`) infers its
    // type args from the field values, then monomorphizes (Heap → Heap_i32).
    if !ck.structs.contains(structName) && ck.genericStructs.contains(structName) {
        let g = ck.genericStructs.get(structName)!
        var tparams: Vec<string> = Vec.new()
        var declNames: Vec<string> = Vec.new()
        var declTys: Vec<MiloType> = Vec.new()
        for ti in 0..g.typeParams.len {
            tparams.push(g.typeParams[ti].clone())
        }
        for fi in 0..g.decl.fields.len {
            declNames.push(g.decl.fields[fi].name.clone())
            declTys.push(g.decl.fields[fi].ty.clone())
        }
        var inferred: HashMap<string, TypeKind> = HashMap.new()
        let snap = snapshotMoves(ck)
        for di in 0..declNames.len {
            for lf in 0..fields.len {
                if fields[lf].name == declNames[di] {
                    let vt = checkExpr(&mut ck, *fields[lf].value)
                    inferFromAst(ck, tparams, declTys[di], vt, &mut inferred)
                }
            }
        }
        restoreMoves(&mut ck, snap)
        var typeArgs: Vec<TypeKind> = Vec.new()
        for tp in 0..tparams.len {
            match inferred.get(tparams[tp]) {
                Option.Some(t) => {
                    typeArgs.push(t)
                }
                Option.None => {
                    typeArgs.push(tyUnknown())
                }
            }
        }
        structName = monomorphizeStruct(&mut ck, structName, typeArgs)
    }

    if !ck.structs.contains(structName) {
        error(&mut ck, "unknown struct '" + structName.clone() + "'", cloneSpan(span))
        return tyUnknown()
    }

    let info = ck.structs.get(structName)!
    for i in 0..fields.len {
        var found = false
        for j in 0..info.fields.len {
            if info.fields[j].name == fields[i].name {
                found = true
                // the field's declared type is the expected type for its
                // initializer (drives generic inference, e.g. `arena: arenaNew()`).
                ck.expectedType = Option.Some(info.fields[j].ty.clone())
                let valType = checkExpr(&mut ck, *fields[i].value)
                ck.expectedType = Option.None
                if !typeEq(info.fields[j].ty, valType) && !containsUnknown(valType) &&
                !(isConstIntExpr(*fields[i].value) && isInteger(info.fields[j].ty)) &&
                !floatLitCoercible(info.fields[j].ty, valType, *fields[i].value) &&
                !arrayIntCoercible(info.fields[j].ty, valType) && !interfaceCoercible(ck, info.fields[j].ty, valType) {
                    error(&mut ck, "field '" + fields[i].name.clone() + "' of '" + name.clone() + "': expected " + typeName(info.fields[j].ty) + ", got " + typeName(valType), cloneSpan(span))
                }
                tryMove(&mut ck, *fields[i].value)
            }
        }
        if !found {
            error(&mut ck, "struct '" + name.clone() + "' has no field '" + fields[i].name.clone() + "'", cloneSpan(span))
        }
    }

    // Check all required fields present
    for k in 0..info.fields.len {
        var present = false
        for m in 0..fields.len {
            if fields[m].name == info.fields[k].name {
                present = true
            }
        }
        if !present {
            error(&mut ck, "missing field '" + info.fields[k].name.clone() + "' in struct '" + structName.clone() + "'", cloneSpan(span))
        }
    }

    return TypeKind.TStruct(structName.clone())
}

// -- Field access --

// `f64.NAN` / `f64.INF` / `f64.NEG_INF` (and f32) are FieldAccess nodes whose object is a
// TYPE name, not a variable — so they have to be recognized before the object is checked,
// or `f64` resolves as an undefined variable. Mirrors `floatNamespaceConst` in the oracle's
// ast.ts; the two must agree on the exact IEEE value.
pub fn floatNamespaceBits(obj: &ExprNode, field: &string): i32 {
    match obj.kind {
        Expr.Ident(name) => {
            if field != "NAN" && field != "INF" && field != "NEG_INF" {
                return 0
            }
            if name == "f64" {
                return 64
            }
            if name == "f32" {
                return 32
            }
            return 0
        }
        _ => {
            return 0
        }
    }
}

pub fn checkFieldAccess(ck: &mut Checker, obj: &ExprNode, field: &string, span: &Option<Span>): TypeKind {
    let fbits = floatNamespaceBits(obj, field)
    if fbits > 0 {
        return TypeKind.TFloat(fbits)
    }
    // Checking `obj` here is checking the BASE of this place, not a whole-value
    // use of it — `p.b` must not trip `p`'s "used incomplete" diagnostic just
    // because some OTHER field of `p` was moved.
    ck.placeBaseDepth = ck.placeBaseDepth + 1
    var objType = checkExpr(&mut ck, obj)
    ck.placeBaseDepth = ck.placeBaseDepth - 1
    // auto-deref references; and raw pointers (`p.x` on a *Struct), which is an
    // unsafe-gated deref-and-access
    match objType.clone() {
        TypeKind.TRef(inner, mutable) => {
            objType = inner.clone()
        }
        TypeKind.TPtr(inner) => {
            if ck.unsafeDepth == 0 {
                error(&mut ck, "pointer field access requires 'unsafe' block", cloneSpan(span))
            }
            objType = inner.clone()
        }
        _ => {
        }
    }

    match objType.clone() {
        TypeKind.TStruct(name) => {
            if !ck.structs.contains(name) {
                error(&mut ck, "unknown struct '" + name.clone() + "'", cloneSpan(span))
                return tyUnknown()
            }
            let info = ck.structs.get(name)!
            for i in 0..info.fields.len {
                if info.fields[i].name == field {
                    // The field's own move state — the counterpart of the whole-
                    // variable `moved` check on a plain Ident.
                    checkFieldMoveState(&mut ck, obj, field, span)
                    return info.fields[i].ty.clone()
                }
            }
            error(&mut ck, "struct '" + name.clone() + "' has no field '" + field.clone() + "'", cloneSpan(span))
            return tyUnknown()
        }
        TypeKind.TEnum(name) => {
            error(&mut ck, "cannot access field on enum — use match to extract values", cloneSpan(span))
            return tyUnknown()
        }
        TypeKind.TArray(elem, size) => {
            if field == "len" {
                // fixed arrays: compile-time i32 constant; slices (size None): runtime i64,
                // matching the TS oracle (checker.ts FieldAccess "len").
                match size {
                    Option.Some(n) => {
                        return TypeKind.TInt(32, true, Option.None, Option.None)
                    }
                    Option.None => {
                        return TypeKind.TInt(64, true, Option.None, Option.None)
                    }
                }
            }
            error(&mut ck, "cannot access field '" + field.clone() + "' on array", cloneSpan(span))
            return tyUnknown()
        }
        TypeKind.TString => {
            if field == "len" {
                return TypeKind.TInt(64, true, Option.None, Option.None)
            }
            error(&mut ck, "cannot access field '" + field.clone() + "' on string", cloneSpan(span))
            return tyUnknown()
        }
        TypeKind.TVec(elem) => {
            if field == "len" {
                return TypeKind.TInt(64, true, Option.None, Option.None)
            }
            error(&mut ck, "cannot access field '" + field.clone() + "' on Vec", cloneSpan(span))
            return tyUnknown()
        }
        TypeKind.THashMap(key, val) => {
            if field == "len" {
                return TypeKind.TInt(64, true, Option.None, Option.None)
            }
            error(&mut ck, "cannot access field '" + field.clone() + "' on HashMap", cloneSpan(span))
            return tyUnknown()
        }
        _ => {
            error(&mut ck, "cannot access field '" + field.clone() + "' on type " + typeName(objType), cloneSpan(span))
            return tyUnknown()
        }
    }
}

// -- Array literals --

pub fn checkArrayLit(ck: &mut Checker, elements: &Vec<Heap<ExprNode>>, span: &Option<Span>): TypeKind {
    // A Vec<T>-typed hint (let/var annotation, struct field, call/push arg,
    // assignment RHS, return) turns `[a, b, c]` into a Vec literal instead of a
    // fixed [T; N] — mirrors the TS oracle's checkExprWithHint ArrayLit branch.
    // Capture what the hint says BEFORE touching ck.expectedType again below:
    // leaving the OUTER hint live while checking each element would misattribute
    // it one level too shallow for nested literals (`Vec<Vec<string>>`'s inner
    // `["x"]` would see the outer Vec<Vec<string>> hint instead of its own
    // element's Vec<string>).
    var isVecHint = false
    var elemType: TypeKind = tyUnknown()
    var haveTarget = false
    match ck.expectedType {
        Option.Some(et) => {
            match et {
                TypeKind.TVec(ve) => {
                    elemType = (*ve).clone()
                    haveTarget = true
                    isVecHint = true
                }
                TypeKind.TArray(ae, asz) => {
                    elemType = (*ae).clone()
                    haveTarget = true
                }
                _ => {
                }
            }
        }
        Option.None => {
        }
    }
    ck.expectedType = Option.None

    if elements.len == 0 {
        // an empty `[]` carries no element type — adopt the annotation's Vec/Array
        // type from the enclosing let/assignment (`var xs: Vec<string> = []`).
        if haveTarget {
            if isVecHint {
                return TypeKind.TVec(Heap(elemType))
            }
            return TypeKind.TArray(Heap(elemType), Option.Some(0))
        }
        error(&mut ck, "cannot infer type of empty array literal", cloneSpan(span))
        return tyUnknown()
    }
    // an annotation (`[i64; N] = [...]`, `Vec<T> = [...]`) fixes the element type
    // up front, so int-literal elements coerce to it (and nested array-literal
    // elements see THEIR OWN element hint) instead of pinning it to the first
    // element's default width/shape.
    for i in 0..elements.len {
        if haveTarget {
            ck.expectedType = Option.Some(elemType.clone())
        }
        let t = checkExpr(&mut ck, *elements[i])
        ck.expectedType = Option.None
        if !haveTarget && i == 0 {
            elemType = t.clone()
        }
        if !typeEq(elemType, t) && !typeEq(t, tyUnknown()) &&
        !(isConstIntExpr(*elements[i]) && isInteger(elemType)) &&
        !floatLitCoercible(elemType, t, *elements[i]) {
            error(&mut ck, "array element " + i.toString() + ": expected " + typeName(elemType) + ", got " + typeName(t), cloneSpan(span))
        }
        // A Vec literal's elements move into the Vec's heap storage — same as a
        // push loop would. The fixed-array literal path never did this (its
        // elements copy into stack slots), so it's scoped to the Vec branch only.
        if isVecHint {
            tryMove(&mut ck, *elements[i])
        }
    }
    if isVecHint {
        return TypeKind.TVec(Heap(elemType))
    }
    return TypeKind.TArray(Heap(elemType), Option.Some(elements.len))
}

// -- Index access --

pub fn checkIndexAccess(ck: &mut Checker, obj: &ExprNode, index: &ExprNode, span: &Option<Span>): TypeKind {
    ck.placeBaseDepth = ck.placeBaseDepth + 1
    var objType = checkExpr(&mut ck, obj)
    ck.placeBaseDepth = ck.placeBaseDepth - 1
    match objType.clone() {
        TypeKind.TRef(inner, mutable) => {
            objType = inner.clone()
        }
        _ => {
        }
    }
    let idxType = checkExpr(&mut ck, index)
    if !isInteger(idxType) && !typeEq(idxType, tyUnknown()) {
        error(&mut ck, "index must be integer, got " + typeName(idxType), cloneSpan(span))
    }

    match objType.clone() {
        TypeKind.TArray(elem, size) => {
            return elem.clone()
        }
        TypeKind.TVec(elem) => {
            return elem.clone()
        }
        TypeKind.TString => {
            return tyU8()
        }
        TypeKind.TPtr(inner) => {
            if ck.unsafeDepth == 0 {
                error(&mut ck, "pointer indexing requires 'unsafe' block", cloneSpan(span))
            }
            return inner.clone()
        }
        _ => {
            error(&mut ck, "cannot index type " + typeName(objType), cloneSpan(span))
            return tyUnknown()
        }
    }
}

// -- Enum literals --

pub fn checkEnumLit(ck: &mut Checker, enumName: &string, variant: &string, args: &Vec<Heap<ExprNode>>, span: &Option<Span>): TypeKind {
    // Vec.new() / HashMap.new() without type annotation
    // `Vec.new()` / `HashMap.new()` carry no element type. checkLetDecl overwrites
    // an unknown value type with the declared annotation, so return unknown quietly
    // rather than erroring on the idiomatic `var v: Vec<string> = Vec.new()`.
    if enumName == "Vec" && variant == "new" {
        if args.len != 0 {
            error(&mut ck, "'Vec.new' takes no arguments", cloneSpan(span))
        }
        return tyUnknown()
    }
    // `Vec.withCapacity(n)` and `Vec.filled(n, v)`. std/io uses both, so without them
    // every program that touches std/io lost its Vec types and produced a cascade of
    // "no method 'push' on <unknown>" against the CALLER.
    if enumName == "Vec" && variant == "withCapacity" {
        if args.len != 1 {
            error(&mut ck, "'Vec.withCapacity' expects 1 argument", cloneSpan(span))
        }
        if args.len >= 1 {
            checkExpr(&mut ck, *args[0])
        }
        return tyUnknown()
    }
    if enumName == "Vec" && variant == "filled" {
        if args.len != 2 {
            error(&mut ck, "'Vec.filled' expects 2 arguments", cloneSpan(span))
        }
        // Capture the enclosing expected element type (`let x: Vec<u8> = Vec.filled(n, 0)`)
        // before checking arg 0 clobbers ck.expectedType. Without this, the fill-value
        // literal's own type (always i64, see Expr.IntLit) becomes the Vec's element type,
        // so `Vec<u8> = Vec.filled(n, 0)` reports a bogus Vec<u8>-vs-Vec<i64> mismatch —
        // std/io's read-buffer allocation does exactly this, so the bug cascaded into
        // every fixture that transitively imports std/io.
        var expectedElem = tyUnknown()
        var haveExpectedElem = false
        match ck.expectedType {
            Option.Some(et) => {
                match et {
                    TypeKind.TVec(inner) => {
                        expectedElem = (*inner).clone()
                        haveExpectedElem = true
                    }
                    _ => {
                    }
                }
            }
            Option.None => {
            }
        }
        if args.len >= 1 {
            checkExpr(&mut ck, *args[0])
        }
        if args.len >= 2 {
            let elemT = checkExpr(&mut ck, *args[1])
            if haveExpectedElem && intCoercible(expectedElem, elemT, *args[1]) {
                return TypeKind.TVec(Heap(expectedElem))
            }
            if haveExpectedElem && floatLitCoercible(expectedElem, elemT, *args[1]) {
                return TypeKind.TVec(Heap(expectedElem))
            }
            return TypeKind.TVec(Heap(elemT))
        }
        return tyUnknown()
    }
    if enumName == "HashMap" && variant == "new" {
        if args.len != 0 {
            error(&mut ck, "'HashMap.new' takes no arguments", cloneSpan(span))
        }
        return tyUnknown()
    }
    // HashMap.withCapacity(n) — sized so `capacity` inserts never rehash. Same
    // shape as HashMap.new above: no expected-type inference, just arity + arg
    // checking (mirrors the oracle's checker.ts:6813, which treats new/withCapacity
    // identically).
    if enumName == "HashMap" && variant == "withCapacity" {
        if args.len != 1 {
            error(&mut ck, "'HashMap.withCapacity' expects 1 argument", cloneSpan(span))
        }
        if args.len >= 1 {
            checkExpr(&mut ck, *args[0])
        }
        return tyUnknown()
    }
    // String statics are compiler builtins
    if enumName == "String" && variant == "withCapacity" {
        if args.len >= 1 {
            checkExpr(&mut ck, *args[0])
        }
        return tyString()
    }
    // Promise.all(v)/Promise.race(v) → the generic free fns promiseAll/promiseRace;
    // T is inferred from the Vec<Promise<T>> arg by checkGenericCall.
    if enumName == "Promise" && (variant == "all" || variant == "race") {
        var pfn = "promiseAll"
        if variant == "race" {
            pfn = "promiseRace"
        }
        if ck.genericFns.contains(pfn) {
            var noTypeArgs: Vec<MiloType> = Vec.new()
            return checkCall(&mut ck, pfn, args, noTypeArgs, span)
        }
    }

    if !ck.enums.contains(enumName) {
        // Generic enum literal: infer type args from the payload arguments
        if ck.genericEnums.contains(enumName) {
            return checkGenericEnumLit(&mut ck, enumName, variant, args, span)
        }
        // Static method on a GENERIC struct with no turbofish: `Pair.new(1, "x")`,
        // `Promise.blocking(f)`. Every such call used to die at "unknown enum 'Pair'",
        // because the arm below only knows monomorphized structs and the type arguments
        // were never written.
        //
        // Infer them the way a generic enum literal does — unify each declared parameter
        // against the actual argument — then monomorphize and let the concrete path
        // resolve the method. Recording the RESULT type is what lets lowering bake the
        // concrete name in for codegen; see hoistKind's EnumLit case.
        if ck.genericStructs.contains(enumName) {
            match findGenericStaticMethod(ck, enumName, variant) {
                Option.Some(gm) => {
                    var inferred: HashMap<string, TypeKind> = HashMap.new()
                    var tps: Vec<string> = Vec.new()
                    for ti in 0..gm.typeParams.len {
                        tps.push(gm.typeParams[ti].clone())
                    }
                    let lim = if args.len < gm.params.len {
                        args.len
                    } else {
                        gm.params.len
                    }
                    for ai in 0..lim {
                        let at = checkExpr(&mut ck, *args[ai])
                        inferInto(tps, typeFromAst(gm.params[ai]), at, &mut inferred)
                    }
                    var typeArgs: Vec<TypeKind> = Vec.new()
                    var complete = true
                    for ti2 in 0..tps.len {
                        if inferred.contains(tps[ti2]) {
                            typeArgs.push(inferred.get(tps[ti2])!.clone())
                        } else {
                            complete = false
                        }
                    }
                    if complete {
                        let monoName = monomorphizeStruct(&mut ck, enumName, typeArgs)
                        match resolveMethod(ck, monoName, variant) {
                            Option.Some(fnName2) => {
                                var noTA2: Vec<MiloType> = Vec.new()
                                return checkCall(&mut ck, fnName2, args, noTA2, span)
                            }
                            Option.None => {
                            }
                        }
                    }
                }
                Option.None => {
                }
            }
        }
        // Static method on a struct: File.open(...) parses as an enum literal
        if ck.structs.contains(enumName) {
            match resolveMethod(ck, enumName, variant) {
                Option.Some(fnName) => {
                    var noTypeArgs: Vec<MiloType> = Vec.new()
                    return checkCall(&mut ck, fnName, args, noTypeArgs, span)
                }
                Option.None => {
                }
            }
        }
        // A capitalized *variable* followed by `.thing` parses identically to a
        // static enum-literal/struct-call (the parser has no type info to tell
        // them apart). If enumName isn't a type at all but IS a bound variable,
        // fall back to a real field/method access on its value. Field wins only
        // when there's an exact field of that name and no call args — fields
        // aren't callable, so any args mean it has to be a method.
        match lookup(ck, enumName) {
            Option.Some(v) => {
                let objTy = deref(v.ty.clone())
                let objExpr = mkExpr(Expr.Ident(enumName.clone()), cloneSpan(span))
                var isField = false
                match objTy.clone() {
                    TypeKind.TStruct(sname) => {
                        if ck.structs.contains(sname) {
                            let info = ck.structs.get(sname)!
                            for fi in 0..info.fields.len {
                                if info.fields[fi].name == variant {
                                    isField = true
                                }
                            }
                        }
                    }
                    _ => {
                    }
                }
                if isField && args.len == 0 {
                    return checkFieldAccess(&mut ck, *objExpr, variant, span)
                }
                return checkMethodCall(&mut ck, *objExpr, variant, args, span)
            }
            Option.None => {
            }
        }
        error(&mut ck, "unknown enum '" + enumName.clone() + "'", cloneSpan(span))
        return tyUnknown()
    }

    let info = ck.enums.get(enumName)!
    // `Kind.tryFrom(n)` on a payload-free enum -> Option<Kind>: the partial reverse
    // of `k as i32` (most integers aren't a variant, so the honest signature is
    // Option, not a trap). "tryFrom" is not itself a variant name, so this has to
    // run before the "no variant" check below rejects it.
    if variant == "tryFrom" {
        var allPayloadFree = true
        for vname, vinfo in info.variants {
            if vinfo.fields.len > 0 {
                allPayloadFree = false
            }
        }
        if allPayloadFree {
            if args.len != 1 {
                error(&mut ck, "'" + enumName.clone() + ".tryFrom' expects 1 argument, got " + args.len.toString(), cloneSpan(span))
                return tyUnknown()
            }
            let argTy = checkExpr(&mut ck, *args[0])
            if !isInteger(argTy) && !typeEq(argTy, tyUnknown()) {
                error(&mut ck, "'" + enumName.clone() + ".tryFrom': expected an integer, got " + typeName(argTy), cloneSpan(span))
            }
            var optArgs: Vec<TypeKind> = Vec.new()
            optArgs.push(TypeKind.TEnum(enumName.clone()))
            let mangled = monomorphizeEnum(&mut ck, "Option", optArgs)
            return TypeKind.TEnum(mangled)
        }
    }
    if !info.variants.contains(variant) {
        error(&mut ck, "enum '" + enumName.clone() + "' has no variant '" + variant.clone() + "'", cloneSpan(span))
        return tyUnknown()
    }

    let variantInfo = info.variants.get(variant)!
    if args.len != variantInfo.fields.len {
        error(&mut ck, "variant '" + enumName.clone() + "." + variant.clone() + "' expects " + variantInfo.fields.len.toString() + " args, got " + args.len.toString(), cloneSpan(span))
    }

    let limit = if args.len < variantInfo.fields.len {
        args.len
    } else {
        variantInfo.fields.len
    }
    for i in 0..limit {
        let argType = checkExpr(&mut ck, *args[i])
        if !typeEq(variantInfo.fields[i], argType) && !containsUnknown(argType) &&
        !intCoercible(variantInfo.fields[i], argType, *args[i]) {
            error(&mut ck, "argument " + (i + 1).toString() + " of '" + enumName.clone() + "." + variant.clone() + "': expected " + typeName(variantInfo.fields[i]) + ", got " + typeName(argType), cloneSpan(span))
        }
        tryMove(&mut ck, *args[i])
    }

    return TypeKind.TEnum(enumName.clone())
}

// -- Generic instantiation at use sites --

pub fn typeParamIndex(typeParams: &Vec<string>, name: &string): i64 {
    for i in 0..typeParams.len {
        if typeParams[i] == name {
            return i
        }
    }
    return -1
}

// Single-level inference: a declared type that IS a type parameter (T) takes
// the argument's type; T one level under &, Heap, or Vec also unifies.
// Unresolved type-param names parse as TStruct(param).
pub fn inferInto(typeParams: &Vec<string>, declTy: &TypeKind, argTy: &TypeKind, inferred: &mut HashMap<string, TypeKind>) {
    match declTy {
        TypeKind.TStruct(name) => {
            if typeParamIndex(typeParams, name) >= 0 && !inferred.contains(name) && !typeEq(argTy, tyUnknown()) {
                inferred.insert(name.clone(), argTy.clone())
            }
        }
        TypeKind.TRef(inner, m) => {
            match argTy {
                TypeKind.TRef(ai, am) => {
                    inferInto(typeParams, *inner, *ai, &mut inferred)
                }
                _ => {
                    inferInto(typeParams, *inner, argTy, &mut inferred)
                }
            }
        }
        TypeKind.THeap(inner) => {
            match argTy {
                TypeKind.THeap(ai) => {
                    inferInto(typeParams, *inner, *ai, &mut inferred)
                }
                _ => {
                }
            }
        }
        TypeKind.TVec(inner) => {
            match argTy {
                TypeKind.TVec(ai) => {
                    inferInto(typeParams, *inner, *ai, &mut inferred)
                }
                _ => {
                }
            }
        }
        // A function type carries type parameters in its params AND its return, and
        // without this arm none of them were recoverable: `Promise.blocking(f: move () => T)`
        // could not learn T from the closure it was handed, so every bare
        // `Promise.blocking(...)` failed to resolve.
        TypeKind.TFn(dparams, dret) => {
            match argTy {
                TypeKind.TFn(aparams, aret) => {
                    let lim = if dparams.len < aparams.len {
                        dparams.len
                    } else {
                        aparams.len
                    }
                    for pi in 0..lim {
                        inferInto(typeParams, dparams[pi], aparams[pi], &mut inferred)
                    }
                    inferInto(typeParams, *dret, *aret, &mut inferred)
                }
                _ => {
                }
            }
        }
        _ => {
        }
    }
}

// AST-driven inference: walks the param's declared MiloType (which still carries
// user-generic type args like `Arena<T>`, unlike the arg-only inferInto whose
// typeFromAst drops them) against the concrete argument type. A generic struct
// `Arena<T>` matched against a monomorphized `Arena_DLNode` recovers T via the
// structInsts (base/mangled/args) recorded at monomorphization.
pub fn inferFromAst(ck: &Checker, typeParams: &Vec<string>, declAst: &MiloType, argTy: &TypeKind, inferred: &mut HashMap<string, TypeKind>) {
    // Unwrap a declared ref (&Arena<T>) against a possibly-TRef argument.
    var concrete = argTy.clone()
    if declAst.isRef || declAst.isRefMut || declAst.ptrDepth > 0 {
        match argTy {
            TypeKind.TRef(inner, m) => {
                concrete = (*inner).clone()
            }
            TypeKind.TPtr(inner) => {
                concrete = (*inner).clone()
            }
            _ => {
            }
        }
    }
    // A bare type parameter (`T`) binds directly.
    if typeParamIndex(typeParams, declAst.name) >= 0 {
        if !inferred.contains(declAst.name) && !typeEq(concrete, tyUnknown()) {
            inferred.insert(declAst.name.clone(), concrete.clone())
        }
        return
    }
    // Function-type param (`f: (&T) => R`): match against the closure's TFn to
    // bind params + return (R from a closure's declared return type).
    if declAst.isFn {
        match concrete {
            TypeKind.TFn(argParams, argRet) => {
                var fi: i64 = 0
                while fi < declAst.fnParams.len && fi < argParams.len {
                    let cp = argParams[fi].clone()
                    inferFromAst(ck, typeParams, declAst.fnParams[fi], cp, &mut inferred)
                    fi = fi + 1
                }
                match declAst.fnRet {
                    Option.Some(dr) => {
                        let cr = (*argRet).clone()
                        inferFromAst(ck, typeParams, *dr, cr, &mut inferred)
                    }
                    Option.None => {
                    }
                }
            }
            _ => {
            }
        }
        return
    }
    if declAst.typeArgs.len == 0 {
        return
    }
    // Builtins carry their args structurally in TypeKind.
    match concrete {
        TypeKind.TVec(elem) => {
            if declAst.name == "Vec" && declAst.typeArgs.len == 1 {
                inferFromAst(ck, typeParams, declAst.typeArgs[0], *elem, &mut inferred)
            }
            return
        }
        TypeKind.THeap(inner) => {
            if declAst.name == "Heap" && declAst.typeArgs.len == 1 {
                inferFromAst(ck, typeParams, declAst.typeArgs[0], *inner, &mut inferred)
            }
            return
        }
        TypeKind.TStruct(mangled) => {
            // Look up the monomorphized instance's concrete args.
            for inst in ck.structInsts {
                if inst.mangled == mangled {
                    // Clone each arg; binding `let x = inst.args`
                    // would move the Vec out and empty it for later lookups.
                    var ai: i64 = 0
                    while ai < declAst.typeArgs.len && ai < inst.args.len {
                        let ca = inst.args[ai].clone()
                        inferFromAst(ck, typeParams, declAst.typeArgs[ai], ca, &mut inferred)
                        ai = ai + 1
                    }
                    return
                }
            }
            return
        }
        _ => {
        }
    }
}

pub fn checkGenericCall(ck: &mut Checker, func: &string, args: &Vec<Heap<ExprNode>>, span: &Option<Span>): TypeKind {
    let generic = ck.genericFns.get(func)!
    if args.len != generic.decl.params.len {
        error(&mut ck, "function '" + func.clone() + "' expects " + generic.decl.params.len.toString() + " args, got " + args.len.toString(), cloneSpan(span))
        return tyUnknown()
    }
    var declParams: Vec<TypeKind> = Vec.new()
    for i in 0..generic.decl.params.len {
        declParams.push(typeFromAst(generic.decl.params[i].ty))
    }
    var inferred: HashMap<string, TypeKind> = HashMap.new()
    for i in 0..args.len {
        let argType = checkExpr(&mut ck, *args[i])
        inferInto(generic.typeParams, declParams[i], argType, &mut inferred)
        // Also try AST-driven inference, which recovers T from user-generic args
        // (`&Arena<T>`) that typeFromAst flattened for inferInto.
        inferFromAst(ck, generic.typeParams, generic.decl.params[i].ty, argType, &mut inferred)
        match declParams[i] {
            TypeKind.TRef(inner, m) => {
            }
            _ => {
                tryMove(&mut ck, *args[i])
            }
        }
    }
    // Params not fixed by args: infer from the expected type (a let annotation)
    // against the declared return type — e.g. `let a: Arena<X> = arenaNew()`.
    var anyUnbound = false
    for i in 0..generic.typeParams.len {
        if !inferred.contains(generic.typeParams[i]) {
            anyUnbound = true
        }
    }
    if anyUnbound {
        match ck.expectedType {
            Option.Some(et) => {
                inferFromAst(ck, generic.typeParams, generic.decl.retType, et, &mut inferred)
            }
            Option.None => {
            }
        }
    }

    var typeArgs: Vec<TypeKind> = Vec.new()
    for i in 0..generic.typeParams.len {
        if inferred.contains(generic.typeParams[i]) {
            typeArgs.push(inferred.get(generic.typeParams[i])!.clone())
        } else {
            error(&mut ck, "cannot infer type parameter '" + generic.typeParams[i].clone() + "' for '" + func.clone() + "'", cloneSpan(span))
            return tyUnknown()
        }
    }
    let mangled = monomorphizeFn(&mut ck, func, typeArgs)
    if !ck.functions.contains(mangled) {
        return tyUnknown()
    }
    let sig = ck.functions.get(mangled)!
    return sig.ret.clone()
}

// The declared shape of a static method on a generic struct, before monomorphization:
// the impl's type parameters and the parameter types as written. Used to infer type
// arguments for a call that supplied none.
pub struct GenericStaticMethod {
    typeParams: Vec<string>,
    params: Vec<MiloType>,
}

pub fn findGenericStaticMethod(ck: &Checker, typeName: &string, method: &string): Option<GenericStaticMethod> {
    for ii in 0..ck.genericImpls.len {
        let gi = ck.genericImpls[ii].clone()
        if gi.typeName != typeName {
            continue
        }
        for mi in 0..gi.methods.len {
            if gi.methods[mi].name != method {
                continue
            }
            // A static method takes no self; an instance method is unreachable through
            // `Type.method(...)`.
            var isStatic = true
            if gi.methods[mi].params.len > 0 {
                if gi.methods[mi].params[0].name == "self" {
                    isStatic = false
                }
            }
            if !isStatic {
                continue
            }
            var tps: Vec<string> = Vec.new()
            for ti in 0..gi.typeParams.len {
                tps.push(gi.typeParams[ti].name.clone())
            }
            var ps: Vec<MiloType> = Vec.new()
            for pi in 0..gi.methods[mi].params.len {
                ps.push(gi.methods[mi].params[pi].ty.clone())
            }
            return Option.Some(GenericStaticMethod {
                typeParams: tps, params: ps
            }
            )
        }
    }
    return Option.None
}

pub fn checkGenericEnumLit(ck: &mut Checker, enumName: &string, variant: &string, args: &Vec<Heap<ExprNode>>, span: &Option<Span>): TypeKind {
    let generic = ck.genericEnums.get(enumName)!
    if !generic.variants.contains(variant) {
        error(&mut ck, "enum '" + enumName.clone() + "' has no variant '" + variant.clone() + "'", cloneSpan(span))
        return tyUnknown()
    }
    let variantInfo = generic.variants.get(variant)!
    if args.len != variantInfo.fields.len {
        error(&mut ck, "variant '" + enumName.clone() + "." + variant.clone() + "' expects " + variantInfo.fields.len.toString() + " args, got " + args.len.toString(), cloneSpan(span))
    }
    // Hint-driven const-int narrowing: when a concrete enum of this base is the
    // expected type (a let annotation or a call param), an int-literal payload
    // takes the declared field's width instead of forcing the enum to
    // monomorphize at the i64 default (`let a: i32? = Option.Some(21)` should be
    // Option_i32, not Option_i64). src-milo has no per-node retyping, so we steer
    // inference at the source. Snapshot the expected enum name first — checkExpr
    // below clobbers ck.expectedType.
    var expEnum: Option<string> = Option.None
    match ck.expectedType {
        Option.Some(et) => {
            match et {
                TypeKind.TEnum(monoName) => {
                    expEnum = Option.Some(monoName.clone())
                }
                _ => {
                }
            }
        }
        Option.None => {
        }
    }
    var haveHint = false
    var hintFields: Vec<TypeKind> = Vec.new()
    match expEnum {
        Option.Some(monoName) => {
            if ck.enums.contains(monoName) {
                let einfo = ck.enums.get(monoName)!
                if einfo.baseName == enumName && einfo.variants.contains(variant) {
                    let srcFields = einfo.variants.get(variant)!.fields
                    for fi in 0..srcFields.len {
                        hintFields.push(srcFields[fi].clone())
                    }
                    haveHint = true
                }
            }
        }
        Option.None => {
        }
    }

    var inferred: HashMap<string, TypeKind> = HashMap.new()
    let limit = if args.len < variantInfo.fields.len {
        args.len
    } else {
        variantInfo.fields.len
    }
    for i in 0..limit {
        let argType = checkExpr(&mut ck, *args[i])
        var effType = argType.clone()
        if haveHint && i < hintFields.len && isConstIntExpr(*args[i]) && isInteger(argType) && isInteger(hintFields[i]) {
            effType = hintFields[i].clone()
        }
        inferInto(generic.typeParams, variantInfo.fields[i], effType, &mut inferred)
        tryMove(&mut ck, *args[i])
    }
    var typeArgs: Vec<TypeKind> = Vec.new()
    for i in 0..generic.typeParams.len {
        if inferred.contains(generic.typeParams[i]) {
            typeArgs.push(inferred.get(generic.typeParams[i])!.clone())
        } else {
            // No evidence (e.g. Option.None): give unknown and let the
            // let-annotation resolve it, exactly like Vec.new().
            return tyUnknown()
        }
    }
    let mangled = monomorphizeEnum(&mut ck, enumName, typeArgs)
    return TypeKind.TEnum(mangled)
}

// -- Unwrap (!) --

pub fn unwrapableInner(ck: &Checker, t: &TypeKind): Option<TypeKind> {
    // Option<T> is monomorphized as Option_T with Some(T)/None variants
    match t {
        TypeKind.TEnum(name) => {
            if ck.enums.contains(name) {
                let info = ck.enums.get(name)!
                if info.variants.contains("Some") {
                    let someVariant = info.variants.get("Some")!
                    if someVariant.fields.len == 1 {
                        return Option.Some(someVariant.fields[0].clone())
                    }
                }
                // Result<T, E> — Ok(T) variant
                if info.variants.contains("Ok") {
                    let okVariant = info.variants.get("Ok")!
                    if okVariant.fields.len == 1 {
                        return Option.Some(okVariant.fields[0].clone())
                    }
                }
            }
            return Option.None
        }
        _ => {
            return Option.None
        }
    }
}

// A bare `T` argument coerces to an `Option<T>` param (auto-wrap in Some), e.g.
// `serve(port: u16?, …)` called with a plain u16.
pub fn optionWrapCoercible(ck: &Checker, paramType: &TypeKind, argType: &TypeKind): bool {
    match paramType {
        TypeKind.TEnum(name) => {
            if !ck.enums.contains(name) {
                return false
            }
            let info = ck.enums.get(name)!
            if !info.variants.contains("Some") {
                return false
            }
            let sv = info.variants.get("Some")!
            if sv.fields.len != 1 {
                return false
            }
            return typeEq(sv.fields[0], argType)
        }
        _ => {
            return false
        }
    }
}

// `let x: T? = <intlit>` / `x = <intlit>` — wrap a bare value into Option<T>, with
// integer-width coercion of the payload (42:i32 into Option<u16>). Broader than
// optionWrapCoercible (used at call sites where codegen requires an exact ll match).
pub fn optionIntWrapCoercible(ck: &Checker, optType: &TypeKind, valType: &TypeKind): bool {
    match optType {
        TypeKind.TEnum(name) => {
            if !ck.enums.contains(name) {
                return false
            }
            let info = ck.enums.get(name)!
            if !info.variants.contains("Some") {
                return false
            }
            let sv = info.variants.get("Some")!
            if sv.fields.len != 1 {
                return false
            }
            if typeEq(sv.fields[0], valType) {
                return true
            }
            return isInteger(sv.fields[0]) && isInteger(valType)
        }
        _ => {
            return false
        }
    }
}

// Err(E) variant's payload (Result<T,E> only) — mirrors unwrapableInner but reads
// the "Err" variant instead of "Some"/"Ok".
pub fn unwrapableErrType(ck: &Checker, t: &TypeKind): Option<TypeKind> {
    match t {
        TypeKind.TEnum(name) => {
            if ck.enums.contains(name) {
                let info = ck.enums.get(name)!
                if info.variants.contains("Err") {
                    let errVariant = info.variants.get("Err")!
                    if errVariant.fields.len == 1 {
                        return Option.Some(errVariant.fields[0].clone())
                    }
                }
            }
            return Option.None
        }
        _ => {
            return Option.None
        }
    }
}

// The baseName of an enum type, if it is a (monomorphized) generic enum.
pub fn enumBaseName(ck: &Checker, t: &TypeKind): Option<string> {
    match t {
        TypeKind.TEnum(name) => {
            if ck.enums.contains(name) {
                return Option.Some(ck.enums.get(name)!.baseName.clone())
            }
            return Option.None
        }
        _ => {
            return Option.None
        }
    }
}

// A combinator that copies one variant's payload straight into its result leaves
// that payload owned twice over (mirrors the oracle's consumeForwardedPayload).
// Consuming the receiver keeps a single owner; a Copy payload is safe to
// duplicate so it stays non-consuming there (same gate as unwrapOr).
pub fn consumeForwardedPayload(ck: &mut Checker, obj: &ExprNode, forwarded: &TypeKind) {
    if !isCopyCk(ck, forwarded) {
        tryMove(&mut ck, obj)
    }
}

// -- Option/Result combinators --
//
// isSome/isNone/isOk/isErr/unwrapOr/map/andThen/orElse/mapErr/unwrapOrElse.
// Gated on the receiver enum's baseName so a user enum's own inherent method of
// the same name still resolves normally via checkStructMethod (the caller falls
// through to it on Option.None here). Mirrors src/checker.ts's Option/Result
// combinator block almost line for line.
pub fn checkOptionResultMethod(ck: &mut Checker, obj: &ExprNode, objType: &TypeKind, method: &string, args: &Vec<Heap<ExprNode>>, span: &Option<Span>): Option<TypeKind> {
    var enumName = ""
    match objType {
        TypeKind.TEnum(n) => {
            enumName = n.clone()
        }
        _ => {
            return Option.None
        }
    }
    if !ck.enums.contains(enumName) {
        return Option.None
    }
    let baseName = ck.enums.get(enumName)!.baseName.clone()
    let isOption = baseName == "Option"
    let isResult = baseName == "Result"
    if !isOption && !isResult {
        return Option.None
    }

    // isSome/isNone/isOk/isErr/unwrapOr are handled by checkStructMethod's own
    // Option/Result gate (this dispatcher runs first and falls through — Option.None
    // — for those names so checkStructMethod's existing logic is the sole owner).

    // unwrapOrElse(f): unwrapOr with a lazily-computed default. Option's f takes no
    // args (None carries nothing); Result's f takes the error by ref. Same Copy
    // gate as unwrapOr, for the same reason.
    if method == "unwrapOrElse" {
        if args.len != 1 {
            error(&mut ck, "'unwrapOrElse' expects 1 argument", cloneSpan(span))
            return Option.Some(tyUnknown())
        }
        let inner = unwrapableInner(ck, objType)
        match inner {
            Option.Some(t) => {
                if !isCopyCk(ck, t) {
                    error(&mut ck, "'unwrapOrElse' on a non-Copy " + baseName.clone() + "<" + typeName(t) + "> — use 'match' to move the value out", cloneSpan(span))
                    return Option.Some(t)
                }
                var fparams: Vec<TypeKind> = Vec.new()
                if isResult {
                    let errT = unwrapableErrType(ck, objType)
                    match errT {
                        Option.Some(e) => {
                            fparams.push(TypeKind.TRef(Heap(e), false))
                        }
                        Option.None => {
                        }
                    }
                }
                ck.expectedType = Option.Some(TypeKind.TFn(fparams, Heap(t.clone())))
                let cbTy = checkExpr(&mut ck, *args[0])
                ck.expectedType = Option.None
                match cbTy {
                    TypeKind.TFn(cp, cr) => {
                        if !typeEq(t, *cr) && !typeEq(*cr, tyUnknown()) {
                            error(&mut ck, "'unwrapOrElse': callback must return " + typeName(t) + ", got " + typeName(*cr), cloneSpan(span))
                        }
                    }
                    _ => {
                        error(&mut ck, "'unwrapOrElse' argument must be a function", cloneSpan(span))
                    }
                }
                return Option.Some(t)
            }
            Option.None => {
                return Option.Some(tyUnknown())
            }
        }
    }

    // map(f): T -> U through the payload by REF — never moves it out, so no Copy
    // gate. Option forwards nothing on None (no consume); Result forwards the Err
    // payload untouched, so a non-Copy E consumes the receiver.
    if method == "map" {
        if args.len != 1 {
            error(&mut ck, "'map' expects 1 argument", cloneSpan(span))
            return Option.Some(tyUnknown())
        }
        let inner = unwrapableInner(ck, objType)
        match inner {
            Option.None => {
                return Option.Some(tyUnknown())
            }
            Option.Some(t) => {
                var fparams: Vec<TypeKind> = Vec.new()
                fparams.push(TypeKind.TRef(Heap(t.clone()), false))
                ck.expectedType = Option.Some(TypeKind.TFn(fparams, Heap(tyUnknown())))
                let cbTy = checkExpr(&mut ck, *args[0])
                ck.expectedType = Option.None
                var retTy = tyUnknown()
                match cbTy {
                    TypeKind.TFn(cp, cr) => {
                        retTy = (*cr).clone()
                    }
                    _ => {
                        error(&mut ck, "'map' argument must be a function", cloneSpan(span))
                        return Option.Some(tyUnknown())
                    }
                }
                if typeEq(retTy, tyVoid()) {
                    error(&mut ck, "'map': callback must return a value — use 'match' for a side effect", cloneSpan(span))
                    return Option.Some(tyUnknown())
                }
                if isResult {
                    let errT = unwrapableErrType(ck, objType)
                    match errT {
                        Option.Some(e) => {
                            consumeForwardedPayload(&mut ck, obj, e)
                            var targs: Vec<TypeKind> = Vec.new()
                            targs.push(retTy)
                            targs.push(e)
                            let mangled = monomorphizeEnum(&mut ck, "Result", targs)
                            return Option.Some(TypeKind.TEnum(mangled))
                        }
                        Option.None => {
                            return Option.Some(tyUnknown())
                        }
                    }
                }
                var targs: Vec<TypeKind> = Vec.new()
                targs.push(retTy)
                let mangled = monomorphizeEnum(&mut ck, "Option", targs)
                return Option.Some(TypeKind.TEnum(mangled))
            }
        }
    }

    // mapErr(f): Result<T,E> -> Result<T,F> — the mirror of map, callback on the Err
    // side. The Ok payload is forwarded untouched, so a non-Copy T consumes the
    // receiver.
    if isResult && method == "mapErr" {
        if args.len != 1 {
            error(&mut ck, "'mapErr' expects 1 argument", cloneSpan(span))
            return Option.Some(tyUnknown())
        }
        let inner = unwrapableInner(ck, objType)
        let errT = unwrapableErrType(ck, objType)
        match inner {
            Option.None => {
                return Option.Some(tyUnknown())
            }
            Option.Some(t) => {
                match errT {
                    Option.None => {
                        return Option.Some(tyUnknown())
                    }
                    Option.Some(e) => {
                        var fparams: Vec<TypeKind> = Vec.new()
                        fparams.push(TypeKind.TRef(Heap(e), false))
                        ck.expectedType = Option.Some(TypeKind.TFn(fparams, Heap(tyUnknown())))
                        let cbTy = checkExpr(&mut ck, *args[0])
                        ck.expectedType = Option.None
                        var retTy = tyUnknown()
                        match cbTy {
                            TypeKind.TFn(cp, cr) => {
                                retTy = (*cr).clone()
                            }
                            _ => {
                                error(&mut ck, "'mapErr' argument must be a function", cloneSpan(span))
                                return Option.Some(tyUnknown())
                            }
                        }
                        if typeEq(retTy, tyVoid()) {
                            error(&mut ck, "'mapErr': callback must return a value — use 'match' for a side effect", cloneSpan(span))
                            return Option.Some(tyUnknown())
                        }
                        consumeForwardedPayload(&mut ck, obj, t)
                        var targs: Vec<TypeKind> = Vec.new()
                        targs.push(t)
                        targs.push(retTy)
                        let mangled = monomorphizeEnum(&mut ck, "Result", targs)
                        return Option.Some(TypeKind.TEnum(mangled))
                    }
                }
            }
        }
    }

    // andThen(f): T -> Option<U>/Result<U,E>, f itself returning the whole enum —
    // the chaining form. Same no-Copy-gate/no-consume story as map for the ok
    // payload; Result's Err payload is forwarded untouched (consume on non-Copy E).
    if method == "andThen" {
        if args.len != 1 {
            error(&mut ck, "'andThen' expects 1 argument", cloneSpan(span))
            return Option.Some(tyUnknown())
        }
        let inner = unwrapableInner(ck, objType)
        match inner {
            Option.None => {
                return Option.Some(tyUnknown())
            }
            Option.Some(t) => {
                var fparams: Vec<TypeKind> = Vec.new()
                fparams.push(TypeKind.TRef(Heap(t.clone()), false))
                ck.expectedType = Option.Some(TypeKind.TFn(fparams, Heap(tyUnknown())))
                let cbTy = checkExpr(&mut ck, *args[0])
                ck.expectedType = Option.None
                var retTy = tyUnknown()
                match cbTy {
                    TypeKind.TFn(cp, cr) => {
                        retTy = (*cr).clone()
                    }
                    _ => {
                        error(&mut ck, "'andThen' argument must be a function", cloneSpan(span))
                        return Option.Some(tyUnknown())
                    }
                }
                let retBase = enumBaseName(ck, retTy)
                match retBase {
                    Option.Some(rb) => {
                        if isOption && rb != "Option" {
                            error(&mut ck, "'andThen': callback must return an Option, got " + typeName(retTy), cloneSpan(span))
                            return Option.Some(tyUnknown())
                        }
                        if isResult && rb != "Result" {
                            error(&mut ck, "'andThen': callback must return a Result, got " + typeName(retTy), cloneSpan(span))
                            return Option.Some(tyUnknown())
                        }
                    }
                    Option.None => {
                        error(&mut ck, "'andThen': callback must return " + baseName.clone(), cloneSpan(span))
                        return Option.Some(tyUnknown())
                    }
                }
                if isResult {
                    let errT = unwrapableErrType(ck, objType)
                    match errT {
                        Option.Some(e) => {
                            let cbErr = unwrapableErrType(ck, retTy)
                            match cbErr {
                                Option.Some(ce) => {
                                    if !typeEq(ce, e) {
                                        error(&mut ck, "'andThen': callback's error type must be " + typeName(e) + ", got " + typeName(ce), cloneSpan(span))
                                        return Option.Some(tyUnknown())
                                    }
                                }
                                Option.None => {
                                }
                            }
                            consumeForwardedPayload(&mut ck, obj, e)
                        }
                        Option.None => {
                        }
                    }
                }
                return Option.Some(retTy)
            }
        }
    }

    // orElse(f): the None/Err-side andThen — f: () -> Option<T> (Option) or
    // (&E) -> Result<T,F> (Result). The ok payload is forwarded on the ok branch,
    // so a non-Copy T consumes the receiver (same rule as map/andThen above).
    if method == "orElse" {
        if args.len != 1 {
            error(&mut ck, "'orElse' expects 1 argument", cloneSpan(span))
            return Option.Some(tyUnknown())
        }
        let inner = unwrapableInner(ck, objType)
        match inner {
            Option.None => {
                return Option.Some(tyUnknown())
            }
            Option.Some(t) => {
                var fparams: Vec<TypeKind> = Vec.new()
                if isResult {
                    let errT = unwrapableErrType(ck, objType)
                    match errT {
                        Option.Some(e) => {
                            fparams.push(TypeKind.TRef(Heap(e), false))
                        }
                        Option.None => {
                        }
                    }
                }
                ck.expectedType = Option.Some(TypeKind.TFn(fparams, Heap(tyUnknown())))
                let cbTy = checkExpr(&mut ck, *args[0])
                ck.expectedType = Option.None
                var retTy = tyUnknown()
                match cbTy {
                    TypeKind.TFn(cp, cr) => {
                        retTy = (*cr).clone()
                    }
                    _ => {
                        error(&mut ck, "'orElse' argument must be a function", cloneSpan(span))
                        return Option.Some(objType.clone())
                    }
                }
                if !typeEq(retTy, tyUnknown()) {
                    let cbOk = unwrapableInner(ck, retTy)
                    var okMatches = false
                    match cbOk {
                        Option.Some(co) => {
                            okMatches = typeEq(co, t)
                        }
                        Option.None => {
                        }
                    }
                    let retBase = enumBaseName(ck, retTy)
                    var baseMatches = false
                    match retBase {
                        Option.Some(rb) => {
                            baseMatches = rb == baseName
                        }
                        Option.None => {
                        }
                    }
                    if !okMatches || !baseMatches {
                        error(&mut ck, "'orElse': callback must return " + baseName.clone() + "<" + typeName(t) + ", ...>, got " + typeName(retTy), cloneSpan(span))
                        return Option.Some(objType.clone())
                    }
                }
                consumeForwardedPayload(&mut ck, obj, t)
                // The result type is the CALLBACK's return type, not the receiver's own
                // — that's the whole point of orElse for Result (F can legitimately
                // differ from E). Returning objType here silently kept the OLD error
                // type on any retype, which the checker would then wrongly accept.
                //
                // checkClosure never threads ck.expectedType's return side into an
                // unannotated closure's own body walk (only params), so a bare
                // zero-arg variant (`() => Option.None`) can't infer T bottom-up and
                // comes back tyUnknown() here. For OPTION specifically that's still a
                // sound answer — T can't change across orElse — so fall back to the
                // receiver's own (T is exact); for Result, F genuinely can differ, so
                // there's nothing safe to substitute and unknown must propagate.
                if typeEq(retTy, tyUnknown()) && !isResult {
                    return Option.Some(objType.clone())
                }
                return Option.Some(retTy)
            }
        }
    }

    return Option.None
}

pub fn checkUnwrap(ck: &mut Checker, operand: &ExprNode, span: &Option<Span>): TypeKind {
    let operandType = checkExpr(&mut ck, operand)
    let inner = unwrapableInner(ck, operandType)
    match inner {
        Option.Some(t) => {
            return t
        }
        Option.None => {
            error(&mut ck, "'!' requires Option or Result type, got " + typeName(operandType), cloneSpan(span))
            return tyUnknown()
        }
    }
}

// -- Propagate (?) --

pub fn checkPropagate(ck: &mut Checker, operand: &ExprNode, span: &Option<Span>): TypeKind {
    let operandType = checkExpr(&mut ck, operand)
    let inner = unwrapableInner(ck, operandType)
    match inner {
        Option.Some(t) => {
            let retInner = unwrapableInner(ck, ck.currentFnRetType)
            match retInner {
                Option.None => {
                    error(&mut ck, "'?' requires function to return Option or Result", cloneSpan(span))
                }
                _ => {
                }
            }
            return t
        }
        Option.None => {
            error(&mut ck, "'?' requires Option or Result type, got " + typeName(operandType), cloneSpan(span))
            return tyUnknown()
        }
    }
}

// -- Default value (??) --

pub fn checkDefaultValue(ck: &mut Checker, operand: &ExprNode, default: &ExprNode, span: &Option<Span>): TypeKind {
    let operandType = checkExpr(&mut ck, operand)
    let inner = unwrapableInner(ck, operandType)
    match inner {
        Option.Some(t) => {
            let defaultType = checkExpr(&mut ck, default)
            // a bare int-literal default (`?? 0`) defaults to i32; coerce it to the
            // Option's integer inner type rather than reject the width mismatch.
            if !typeEq(t, defaultType) && !typeEq(defaultType, tyUnknown()) &&
            !(isConstIntExpr(default) && isInteger(t)) {
                error(&mut ck, "'??' default type mismatch: expected " + typeName(t) + ", got " + typeName(defaultType), cloneSpan(span))
            }
            return t
        }
        Option.None => {
            error(&mut ck, "'??' requires Option or Result type, got " + typeName(operandType), cloneSpan(span))
            return tyUnknown()
        }
    }
}

// -- Cast expressions --

pub fn checkCast(ck: &mut Checker, operand: &ExprNode, targetType: &MiloType, span: &Option<Span>): TypeKind {
    let fromType = checkExpr(&mut ck, operand)
    let toType = typeFromAst(targetType)

    var fromCastable = false
    match fromType.clone() {
        TypeKind.TPtr(inner) => {
            fromCastable = true
        }
        TypeKind.TArray(elem, size) => {
            fromCastable = true
        }
        TypeKind.TFn(params, ret) => {
            fromCastable = true
        }
        TypeKind.TUnknown => {
            fromCastable = true
        }
        // string as *u8 — cstr data pointer at extern boundaries
        TypeKind.TString => {
            fromCastable = true
        }
        _ => {
        }
    }
    // A payload-free (integer-repr) enum casts to an integer: the value IS its
    // discriminant, which milo0 already stores as the i32 tag in field 0.
    match fromType.clone() {
        TypeKind.TEnum(ename) => {
            fromCastable = true
        }
        _ => {
        }
    }
    let fromOk = isNumeric(fromType) || typeEq(fromType, tyBool()) || fromCastable
    var toCastable = false
    match toType.clone() {
        TypeKind.TPtr(inner) => {
            toCastable = true
        }
        _ => {
        }
    }
    let toOk = isNumeric(toType) || toCastable

    if !fromOk {
        error(&mut ck, "cannot cast from " + typeName(fromType), cloneSpan(span))
    }
    if !toOk {
        error(&mut ck, "cannot cast to " + typeName(toType), cloneSpan(span))
    }

    match toType.clone() {
        TypeKind.TPtr(inner) => {
            // `0 as *T` is the null-pointer constant — safe (making a null pointer
            // can't cause UB; dereferencing it still requires unsafe). Mirror the
            // oracle (checker.ts isNullPtrConst) so std's `0 as *u8` initializers
            // aren't spuriously unsafe-gated.
            var isNullPtrConst = false
            match operand.kind {
                Expr.IntLit(v) => {
                    if v == 0 {
                        isNullPtrConst = true
                    }
                }
                _ => {
                }
            }
            if ck.unsafeDepth == 0 && !isNullPtrConst {
                error(&mut ck, "cast to pointer type requires 'unsafe' block", cloneSpan(span))
            }
        }
        _ => {
        }
    }

    return toType
}

// -- Method calls --

// The combinator names an array or slice may borrow from Vec. Kept as two functions
// rather than one set because a fixed array must not re-tag `clone` — see checkMethodCall.
fn isArrayCombinator(m: &string): bool {
    return m == "sum" || m == "map" || m == "filter" || m == "fold" || m == "reduce"
    || m == "each" || m == "enumerate" || m == "find" || m == "position"
    || m == "indexOf" || m == "any" || m == "all" || m == "contains"
    || m == "isEmpty" || m == "join" || m == "first" || m == "last"
    || m == "min" || m == "max"
}

fn isSliceCombinator(m: &string): bool {
    return isArrayCombinator(m) || m == "get" || m == "clone"
}

pub fn checkMethodCall(ck: &mut Checker, obj: &ExprNode, method: &string, args: &Vec<Heap<ExprNode>>, span: &Option<Span>): TypeKind {
    var objType = checkExpr(&mut ck, obj)
    // auto-deref references
    match objType.clone() {
        TypeKind.TRef(inner, mutable) => {
            objType = inner.clone()
        }
        _ => {
        }
    }

    // A fixed array or a slice reaches the same combinator set a Vec does, so re-tag it
    // and let the Vec arm below be the only implementation. src/checker.ts does exactly
    // this; without it `[i64]` had no `sum`, `isEmpty`, `map` or `fold` at all, which is
    // three fixtures and any program that calls a combinator on an array.
    //
    // `clone` is deliberately NOT in the fixed-array set: cloning a fixed array should
    // yield an array, and re-tagging would change the result type to a Vec.
    match objType.clone() {
        TypeKind.TArray(elem, size) => {
            var retag = false
            match size {
                Option.None => {
                    retag = isSliceCombinator(method)
                }
                Option.Some(_n) => {
                    retag = isArrayCombinator(method)
                }
            }
            if retag {
                objType = TypeKind.TVec(Heap(elem.clone()))
            }
        }
        _ => {
        }
    }

    // x.addrOf(): *T — raw address of any lvalue (the replacement for `&x`).
    // Universal, requires unsafe. 'addrOf' is a reserved method name.
    if method == "addrOf" {
        if args.len != 0 {
            error(&mut ck, "'addrOf' takes no arguments", cloneSpan(span))
        }
        if ck.unsafeDepth == 0 {
            error(&mut ck, "'addrOf' (raw address-of) requires 'unsafe' block", cloneSpan(span))
        }
        return TypeKind.TPtr(Heap(objType.clone()))
    }

    // bool.toString() — prints "true"/"false", same as interpolating one.
    if method == "toString" {
        match objType {
            TypeKind.TBool => {
                if args.len != 0 {
                    error(&mut ck, "'toString' takes no arguments", cloneSpan(span))
                }
                return tyString()
            }
            _ => {
            }
        }
    }
    // Bit rotation. Distinct from a shift: the bits that fall off one end come back in
    // the other, so the WIDTH of the receiver is part of the semantics.
    if isInteger(objType) && (method == "rotateLeft" || method == "rotateRight") {
        if args.len != 1 {
            error(&mut ck, "'" + method.clone() + "' expects 1 argument", cloneSpan(span))
        }
        if args.len >= 1 {
            checkExpr(&mut ck, *args[0])
        }
        return objType.clone()
    }
    // numeric.toString()
    if (isInteger(objType) || isFloat(objType)) && method == "toString" {
        if args.len != 0 {
            error(&mut ck, "'toString' takes no arguments", cloneSpan(span))
        }
        return tyString()
    }
    // x.checkedAdd/Sub/Mul/Div/Rem(y) → Option<T>, None on overflow (or div-by-zero)
    if isInteger(objType) && (method == "checkedAdd" || method == "checkedSub" || method == "checkedMul" || method == "checkedDiv" || method == "checkedRem") {
        if args.len != 1 {
            error(&mut ck, "'" + method.clone() + "' expects 1 argument", cloneSpan(span))
        }
        if args.len >= 1 {
            checkExpr(&mut ck, *args[0])
        }
        var oargs: Vec<TypeKind> = Vec.new()
        oargs.push(objType.clone())
        let mangled = monomorphizeEnum(&mut ck, "Option", oargs)
        return TypeKind.TEnum(mangled)
    }
    // x.wrapping{Add,Sub,Mul}/saturating{Add,Sub,Mul}(y) → T (same int type)
    if isInteger(objType) && (method == "wrappingAdd" || method == "wrappingSub" || method == "wrappingMul" || method == "saturatingAdd" || method == "saturatingSub" || method == "saturatingMul") {
        if args.len != 1 {
            error(&mut ck, "'" + method.clone() + "' expects 1 argument", cloneSpan(span))
        }
        if args.len >= 1 {
            checkExpr(&mut ck, *args[0])
        }
        return objType.clone()
    }
    // x.wrappingNeg() → T (same int type); x.checkedNeg() → Option<T>, None only at
    // signed INT_MIN (no representable positive) or on any nonzero unsigned value.
    if isInteger(objType) && method == "wrappingNeg" {
        if args.len != 0 {
            error(&mut ck, "'wrappingNeg' takes no arguments", cloneSpan(span))
        }
        return objType.clone()
    }
    if isInteger(objType) && method == "checkedNeg" {
        if args.len != 0 {
            error(&mut ck, "'checkedNeg' takes no arguments", cloneSpan(span))
        }
        var oargs: Vec<TypeKind> = Vec.new()
        oargs.push(objType.clone())
        let mangled = monomorphizeEnum(&mut ck, "Option", oargs)
        return TypeKind.TEnum(mangled)
    }
    // x.countOnes/leadingZeros/trailingZeros() → i64 — 0-arg, count fits any width
    if isInteger(objType) && (method == "countOnes" || method == "leadingZeros" || method == "trailingZeros") {
        if args.len != 0 {
            error(&mut ck, "'" + method.clone() + "' takes no arguments", cloneSpan(span))
        }
        return tyI64()
    }
    // x.reverseBits() → T (same int type)
    if isInteger(objType) && method == "reverseBits" {
        if args.len != 0 {
            error(&mut ck, "'reverseBits' takes no arguments", cloneSpan(span))
        }
        return objType.clone()
    }

    // Vec methods
    match objType.clone() {
        TypeKind.TVec(elem) => {
            return checkVecMethod(&mut ck, obj, *elem, method, args, span)
        }
        _ => {
        }
    }

    // HashMap methods
    match objType.clone() {
        TypeKind.THashMap(key, val) => {
            return checkHashMapMethod(&mut ck, obj, *key, *val, method, args, span)
        }
        _ => {
        }
    }

    // Fixed-size array `.slice(a,b)` — the `arr[a..b]` range-index desugar
    // (parser.milo). A fixed array lowers onto the Vec runtime (same {ptr,len,cap}
    // header — see codegen astTypeStr), so the view's runtime rep is just a Vec<T>,
    // exactly like Vec.slice; no separate codegen path is needed. The TYPE stays
    // a `&[T]` view (TArray with size None), same reasoning as Vec.slice above.
    match objType.clone() {
        TypeKind.TArray(elem, size) => {
            if method == "slice" {
                if args.len != 2 {
                    error(&mut ck, "'slice' expects 2 arguments (start, end)", cloneSpan(span))
                }
                for si in 0..args.len {
                    let it = checkExpr(&mut ck, *args[si])
                    if !isInteger(it) && !typeEq(it, tyUnknown()) {
                        error(&mut ck, "'slice' bounds must be integer", cloneSpan(span))
                    }
                }
                // The view points into the array's own storage — mutating it
                // (a var-typed fixed array can still e.g. be reassigned whole)
                // while the view is live must be rejected.
                freezePlace(&mut ck, obj)
                return TypeKind.TRef(Heap(TypeKind.TArray(elem, Option.None)), false)
            }
            // `.len()` (parens) is only offered on a slice (size None); a fixed-size
            // array only has the field form `arr.len`, matching the TS oracle.
            if method == "len" {
                match size {
                    Option.None => {
                        if args.len != 0 {
                            error(&mut ck, "'len' takes no arguments", cloneSpan(span))
                        }
                        return TypeKind.TInt(64, true, Option.None, Option.None)
                    }
                    Option.Some(n) => {
                    }
                }
            }
        }
        _ => {
        }
    }

    // String methods
    match objType.clone() {
        TypeKind.TString => {
            return checkStringMethod(&mut ck, obj, method, args, span)
        }
        _ => {
        }
    }

    // Struct/trait methods
    match objType.clone() {
        TypeKind.TStruct(name) => {
            return checkStructMethod(&mut ck, obj, name, method, args, span)
        }
        _ => {
        }
    }

    // Enum methods resolve through the same name-keyed impl tables — but Option/
    // Result get their combinators first (isSome/unwrapOr/map/andThen/orElse/
    // mapErr/unwrapOrElse), gated on baseName so a user enum's own same-named
    // inherent method still resolves via checkStructMethod below.
    match objType.clone() {
        TypeKind.TEnum(name) => {
            match checkOptionResultMethod(&mut ck, obj, objType, method, args, span) {
                Option.Some(t) => {
                    return t
                }
                Option.None => {
                }
            }
            return checkStructMethod(&mut ck, obj, name, method, args, span)
        }
        _ => {
        }
    }

    // Heap<T> receivers auto-deref to the pointee's methods
    match objType.clone() {
        TypeKind.THeap(inner) => {
            match *inner {
                TypeKind.TStruct(name) => {
                    return checkStructMethod(&mut ck, obj, name, method, args, span)
                }
                TypeKind.TEnum(name) => {
                    return checkStructMethod(&mut ck, obj, name, method, args, span)
                }
                _ => {
                }
            }
        }
        _ => {
        }
    }

    // `var w = Vec.new()` with no annotation has no element type yet; take it from the
    // first `push`. std/sha1, std/hmac and std/totp all open this way, and without the
    // inference the Vec stayed <unknown> and every later use produced a cascade of errors
    // against the CALLER of those modules rather than against the line at fault.
    //
    // Restricted to a push argument codegen can ALSO statically re-derive without
    // running the checker (collectVecPushHintsInto in codegen/stmt.milo, which reads
    // the AST directly): a bare int/bool/string literal, or a concrete struct literal
    // whose name matches the checked type exactly (rules out a generic struct literal
    // whose element got resolved through inference codegen's simpler pass can't repeat).
    // Accepting a wider shape here would make codegen agree on the TYPE while silently
    // disagreeing about the runtime element SIZE — the checker and codegen must decide
    // this from the same evidence, or one of them is lying to the other.
    if method == "push" && args.len == 1 {
        match obj.kind {
            Expr.Ident(vname) => {
                match objType {
                    TypeKind.TUnknown => {
                        let elemT = checkExpr(&mut ck, *args[0])
                        var codegenCanSeeIt = false
                        match (*args[0]).kind {
                            Expr.IntLit(iv) => {
                                codegenCanSeeIt = true
                            }
                            Expr.BoolLit(bv) => {
                                codegenCanSeeIt = true
                            }
                            Expr.StringLit(sv) => {
                                codegenCanSeeIt = true
                            }
                            Expr.FloatLit(fv) => {
                                codegenCanSeeIt = true
                            }
                            Expr.StructLit(sname, sfields) => {
                                match elemT.clone() {
                                    TypeKind.TStruct(rn) => {
                                        if rn == sname {
                                            codegenCanSeeIt = true
                                        }
                                    }
                                    _ => {
                                    }
                                }
                            }
                            // `-1` is a negation of a literal, not a literal. The
                            // sentinel-fill loop `for _ in 0..n { v.push(-1) }` is how
                            // several std modules give an un-annotated Vec its element
                            // type, so rejecting it left those Vecs <unknown>. codegen's
                            // pushArgStaticTy recurses through unary `-` for exactly
                            // this reason — the two gates must accept the same set.
                            Expr.UnaryOp(uop, uoperand) => {
                                if uop == "-" {
                                    match (*uoperand).kind {
                                        Expr.IntLit(niv) => {
                                            codegenCanSeeIt = true
                                        }
                                        Expr.FloatLit(nfv) => {
                                            codegenCanSeeIt = true
                                        }
                                        _ => {
                                        }
                                    }
                                }
                            }
                            _ => {
                            }
                        }
                        if codegenCanSeeIt {
                            setVarType(&mut ck, vname, TypeKind.TVec(Heap(elemT)))
                            return tyVoid()
                        }
                    }
                    _ => {
                    }
                }
            }
            _ => {
            }
        }
    }
    // `.clone()` on a Copy scalar is the identity — it exists so generic code can
    // be written once: `fn get<T>(w: &Wrapper<T>): T { return w.val.clone() }` has
    // to compile for T = i64 as well as T = string, and the move-out-of-a-borrow
    // rule leaves clone as the only way to spell it (mirrors the oracle's
    // checker.ts:8366). Gated last, after every real method has had a chance to
    // match, same as the oracle.
    if method == "clone" && args.len == 0 && isCopyCk(ck, objType) {
        return objType.clone()
    }
    error(&mut ck, "no method '" + method.clone() + "' on type " + typeName(objType), cloneSpan(span))
    return tyUnknown()
}

// -- Vec methods --

pub fn checkVecMethod(ck: &mut Checker, obj: &ExprNode, elem: &TypeKind, method: &string, args: &Vec<Heap<ExprNode>>, span: &Option<Span>): TypeKind {
    // v.ptr(): *T — the Vec's backing data pointer. Safe to obtain (mirrors cstr).
    if method == "ptr" {
        if args.len != 0 {
            error(&mut ck, "'ptr' takes no arguments", cloneSpan(span))
        }
        return TypeKind.TPtr(Heap(elem.clone()))
    }
    if method == "push" {
        if args.len != 1 {
            error(&mut ck, "'push' expects 1 argument, got " + args.len.toString(), cloneSpan(span))
            return tyVoid()
        }
        if !isRootMutable(ck, obj) {
            error(&mut ck, "cannot push to immutable Vec", cloneSpan(span))
        }
        // A push may realloc — illegal while a slice/loop borrow into this
        // Vec is live, since that borrow's memory could move out from under it.
        errorIfFrozenRoot(&mut ck, obj, "call 'push' on", span)
        // Give the element type as context so a phantom-typed generic struct
        // literal (Handle<T>'s T isn't stored in any field) can infer its type
        // arg from the Vec's declared element type instead of failing to unknown.
        ck.expectedType = Option.Some(elem.clone())
        let argType = checkExpr(&mut ck, *args[0])
        ck.expectedType = Option.None
        if !typeEq(elem, argType) && !typeEq(argType, tyUnknown()) &&
        !(isConstIntExpr(*args[0]) && isInteger(elem)) && !interfaceCoercible(ck, elem, argType) {
            error(&mut ck, "push: expected " + typeName(elem) + ", got " + typeName(argType), cloneSpan(span))
        }
        tryMove(&mut ck, *args[0])
        return tyVoid()
    }
    if method == "reverse" {
        if args.len != 0 {
            error(&mut ck, "'reverse' takes no arguments", cloneSpan(span))
        }
        if !isRootMutable(ck, obj) {
            error(&mut ck, "cannot reverse immutable Vec", cloneSpan(span))
        }
        errorIfFrozenRoot(&mut ck, obj, "call 'reverse' on", span)
        return tyVoid()
    }
    if method == "pop" {
        if args.len != 0 {
            error(&mut ck, "'pop' takes no arguments", cloneSpan(span))
        }
        if !isRootMutable(ck, obj) {
            error(&mut ck, "cannot pop from immutable Vec", cloneSpan(span))
        }
        errorIfFrozenRoot(&mut ck, obj, "call 'pop' on", span)
        // pop returns Option<T> — Some(last) / None on empty, matching the TS oracle
        var optArgs: Vec<TypeKind> = Vec.new()
        optArgs.push(elem.clone())
        let mangled = monomorphizeEnum(&mut ck, "Option", optArgs)
        return TypeKind.TEnum(mangled)
    }
    if method == "remove" {
        if args.len != 1 {
            error(&mut ck, "'remove' expects 1 argument (index)", cloneSpan(span))
        }
        if args.len >= 1 {
            let it = checkExpr(&mut ck, *args[0])
            if !isInteger(it) {
                error(&mut ck, "'remove' index must be integer", cloneSpan(span))
            }
        }
        if !isRootMutable(ck, obj) {
            error(&mut ck, "cannot remove from immutable Vec", cloneSpan(span))
        }
        errorIfFrozenRoot(&mut ck, obj, "call 'remove' on", span)
        return elem.clone()
    }
    if method == "clone" {
        if args.len != 0 {
            error(&mut ck, "'clone' takes no arguments", cloneSpan(span))
        }
        return TypeKind.TVec(Heap(elem.clone()))
    }
    // v[a..b] desugars to v.slice(a,b): a `&[T]` view, not an owned Vec — same
    // element type, same runtime %Vec rep (cap=0, non-owning), but the checker has
    // to keep the two apart or a fn declared to RETURN a view accepts (and a caller
    // expecting a view rejects) a plain Vec with an identical-looking element type.
    if method == "slice" {
        if args.len != 2 {
            error(&mut ck, "'slice' expects 2 arguments (start, end)", cloneSpan(span))
        }
        for si in 0..args.len {
            let it = checkExpr(&mut ck, *args[si])
            if !isInteger(it) && !typeEq(it, tyUnknown()) {
                error(&mut ck, "'slice' bounds must be integer", cloneSpan(span))
            }
        }
        // Freeze the receiver's ROOT (walking through field/index steps) — the
        // view points into whatever storage the root variable owns, so any
        // mutation reachable from that root could realloc/free it.
        freezePlace(&mut ck, obj)
        return TypeKind.TRef(Heap(TypeKind.TArray(Heap(elem.clone()), Option.None)), false)
    }
    if method == "contains" {
        if args.len != 1 {
            error(&mut ck, "'contains' expects 1 argument", cloneSpan(span))
        }
        if args.len >= 1 {
            checkExpr(&mut ck, *args[0])
        }
        return tyBool()
    }
    if method == "remove" {
        if args.len != 1 {
            error(&mut ck, "'remove' expects 1 argument", cloneSpan(span))
        }
        if args.len >= 1 {
            let idxType = checkExpr(&mut ck, *args[0])
            if !isInteger(idxType) {
                error(&mut ck, "'remove' index must be integer", cloneSpan(span))
            }
        }
        if !isRootMutable(ck, obj) {
            error(&mut ck, "cannot remove from immutable Vec", cloneSpan(span))
        }
        return elem.clone()
    }
    if method == "each" {
        if args.len != 1 {
            error(&mut ck, "'each' expects 1 argument (callback)", cloneSpan(span))
        }
        // The callback runs once per element by (shared) reference — mutating
        // the receiver from inside it (e.g. a nested push) can realloc the
        // buffer those element references point into.
        let cbBorrow = borrowDuringCallback(&mut ck, obj)
        if args.len >= 1 {
            checkExpr(&mut ck, *args[0])
        }
        match cbBorrow {
            Option.Some(bname) => {
                unfreezeName(&mut ck, bname)
            }
            Option.None => {
            }
        }
        return tyVoid()
    }
    // map((T) => R): Vec<R>; filter((T) => bool): Vec<T>. The closure's param type
    // is the element type (expectedType drives unannotated-param inference).
    if method == "map" || method == "filter" {
        if args.len != 1 {
            error(&mut ck, "'" + method.clone() + "' expects 1 argument (callback)", cloneSpan(span))
        }
        var fparams: Vec<TypeKind> = Vec.new()
        fparams.push(elem.clone())
        var fret = tyUnknown()
        if method == "filter" {
            fret = tyBool()
        }
        ck.expectedType = Option.Some(TypeKind.TFn(fparams, Heap(fret)))
        var closureTy = tyUnknown()
        if args.len >= 1 {
            closureTy = checkExpr(&mut ck, *args[0])
        }
        ck.expectedType = Option.None
        if method == "filter" {
            return TypeKind.TVec(Heap(elem.clone()))
        }
        // map: element type is the closure's return type
        var rTy = elem.clone()
        match closureTy {
            TypeKind.TFn(cp, cr) => {
                rTy = (*cr).clone()
            }
            _ => {
            }
        }
        return TypeKind.TVec(Heap(rTy))
    }
    // find((&T) => bool): Option<T>; any/all((&T) => bool): bool
    if method == "find" || method == "any" || method == "all" {
        if args.len != 1 {
            error(&mut ck, "'" + method.clone() + "' expects 1 argument (predicate)", cloneSpan(span))
        }
        var fparams: Vec<TypeKind> = Vec.new()
        fparams.push(TypeKind.TRef(Heap(elem.clone()), false))
        ck.expectedType = Option.Some(TypeKind.TFn(fparams, Heap(tyBool())))
        if args.len >= 1 {
            checkExpr(&mut ck, *args[0])
        }
        ck.expectedType = Option.None
        if method == "find" {
            var optArgs: Vec<TypeKind> = Vec.new()
            optArgs.push(elem.clone())
            let mangled = monomorphizeEnum(&mut ck, "Option", optArgs)
            return TypeKind.TEnum(mangled)
        }
        return tyBool()
    }
    // isEmpty(): the oracle has it on Vec, arrays and slices; milo-self only had it on
    // HashMap, so `v.isEmpty()` was "no method 'isEmpty' on Vec".
    if method == "isEmpty" {
        if args.len != 0 {
            error(&mut ck, "'isEmpty' takes no arguments", cloneSpan(span))
        }
        return tyBool()
    }
    if method == "len" {
        if args.len != 0 {
            error(&mut ck, "'len' takes no arguments", cloneSpan(span))
        }
        return TypeKind.TInt(64, true, Option.None, Option.None)
    }
    if method == "swap" {
        if args.len != 2 {
            error(&mut ck, "'swap' expects 2 arguments (indices)", cloneSpan(span))
        }
        for si in 0..args.len {
            let it = checkExpr(&mut ck, *args[si])
            if !isInteger(it) {
                error(&mut ck, "'swap' indices must be integer", cloneSpan(span))
            }
        }
        if !isRootMutable(ck, obj) {
            error(&mut ck, "cannot swap in immutable Vec", cloneSpan(span))
        }
        return tyVoid()
    }
    if method == "insert" {
        if args.len != 2 {
            error(&mut ck, "'insert' expects 2 arguments (index, value)", cloneSpan(span))
        }
        if args.len >= 1 {
            let it = checkExpr(&mut ck, *args[0])
            if !isInteger(it) {
                error(&mut ck, "'insert' index must be integer", cloneSpan(span))
            }
        }
        if args.len >= 2 {
            checkExpr(&mut ck, *args[1])
        }
        if !isRootMutable(ck, obj) {
            error(&mut ck, "cannot insert into immutable Vec", cloneSpan(span))
        }
        return tyVoid()
    }
    if method == "clear" {
        if args.len != 0 {
            error(&mut ck, "'clear' takes no arguments", cloneSpan(span))
        }
        if !isRootMutable(ck, obj) {
            error(&mut ck, "cannot clear an immutable Vec", cloneSpan(span))
        }
        return tyVoid()
    }
    // truncate(n) drops everything at index >= n (a no-op past the end, empties on
    // a negative n — codegen clamps). Mirrors 'clear' above but keeps the tail.
    if method == "truncate" {
        if args.len != 1 {
            error(&mut ck, "'truncate' expects 1 argument", cloneSpan(span))
        }
        if args.len == 1 {
            let nType = checkExpr(&mut ck, *args[0])
            if !isInteger(nType) && !typeEq(nType, tyUnknown()) {
                error(&mut ck, "'truncate': expected an integer length, got " + typeName(nType), cloneSpan(span))
            }
        }
        if !isRootMutable(ck, obj) {
            error(&mut ck, "cannot truncate an immutable Vec", cloneSpan(span))
        }
        return tyVoid()
    }
    // join(sep): Vec<string> only — concatenates elements with `sep` between them.
    if method == "join" {
        if args.len != 1 {
            error(&mut ck, "'join' expects 1 argument (separator)", cloneSpan(span))
            return tyUnknown()
        }
        if !typeEq(elem, tyString()) {
            error(&mut ck, "'join' is only available on Vec<string>", cloneSpan(span))
            return tyUnknown()
        }
        let sepType = checkExpr(&mut ck, *args[0])
        if !typeEq(sepType, tyString()) && !typeEq(sepType, tyUnknown()) {
            error(&mut ck, "'join' separator must be a string, got " + typeName(sepType), cloneSpan(span))
        }
        return tyString()
    }
    // fold(init, (acc, elem) => acc) — the accumulate half of the functional set.
    // 'reduce' is accepted as the same operation (mirrors the oracle's checker.ts).
    if method == "fold" || method == "reduce" {
        if args.len != 2 {
            error(&mut ck, "'" + method.clone() + "' expects 2 arguments (initial value, callback)", cloneSpan(span))
            return tyUnknown()
        }
        // The accumulator's type comes from the initial value. The oracle also
        // retypes a bare-int seed from the callback's own annotation when the two
        // disagree (`fold(0, (a: i64, b) => ...)` on a Vec<i32>) — skipped here:
        // every seed this checker sees is a literal that already defaults to the
        // width the callback declares, so the narrower case is a known, unhit gap.
        let accType = checkExpr(&mut ck, *args[0])
        var fparams: Vec<TypeKind> = Vec.new()
        fparams.push(accType.clone())
        fparams.push(TypeKind.TRef(Heap(elem.clone()), false))
        ck.expectedType = Option.Some(TypeKind.TFn(fparams, Heap(accType.clone())))
        let cbType = checkExpr(&mut ck, *args[1])
        ck.expectedType = Option.None
        match cbType.clone() {
            TypeKind.TFn(cp, cr) => {
                let retType = (*cr).clone()
                if !typeEq(retType, accType) && !typeEq(retType, tyUnknown()) && !typeEq(accType, tyUnknown()) {
                    error(&mut ck, "'" + method.clone() + "' callback must return " + typeName(accType) + " to match the initial value, got " + typeName(retType), cloneSpan(span))
                }
            }
            _ => {
                error(&mut ck, "'" + method.clone() + "' argument 2 must be a function", cloneSpan(span))
            }
        }
        return accType
    }
    // sum(): accumulates every element — ints and floats only.
    if method == "sum" {
        if args.len != 0 {
            error(&mut ck, "'sum' takes no arguments", cloneSpan(span))
        }
        if !isInteger(elem) && !isFloat(elem) {
            error(&mut ck, "'sum' requires a Vec of integers or floats, got Vec<" + typeName(elem) + ">", cloneSpan(span))
            return tyUnknown()
        }
        return elem.clone()
    }
    // sort(): sorts a Vec of a directly-comparable element type in place.
    if method == "sort" {
        if args.len != 0 {
            error(&mut ck, "'sort' takes no arguments", cloneSpan(span))
        }
        if !isRootMutable(ck, obj) {
            error(&mut ck, "cannot sort immutable Vec", cloneSpan(span))
        }
        if !isInteger(elem) && !isFloat(elem) && !typeEq(elem, tyString()) && !typeEq(elem, tyBool()) {
            error(&mut ck, "'sort' requires Vec of a comparable type (int, float, string, bool)", cloneSpan(span))
        }
        return tyVoid()
    }
    // sortBy((&T, &T) => i32): sorts in place by a custom comparator, same
    // contract as qsort/Ord::cmp — negative means the first arg sorts earlier.
    if method == "sortBy" {
        if args.len != 1 {
            error(&mut ck, "'sortBy' expects 1 argument (comparator)", cloneSpan(span))
            return tyUnknown()
        }
        if !isRootMutable(ck, obj) {
            error(&mut ck, "cannot sort immutable Vec", cloneSpan(span))
        }
        var fparams: Vec<TypeKind> = Vec.new()
        fparams.push(TypeKind.TRef(Heap(elem.clone()), false))
        fparams.push(TypeKind.TRef(Heap(elem.clone()), false))
        ck.expectedType = Option.Some(TypeKind.TFn(fparams, Heap(tyI32())))
        let cbBorrowType = checkExpr(&mut ck, *args[0])
        ck.expectedType = Option.None
        match cbBorrowType {
            TypeKind.TFn(cp, cr) => {
            }
            _ => {
                error(&mut ck, "'sortBy' argument must be a comparator function", cloneSpan(span))
            }
        }
        return tyVoid()
    }
    // sortByKey((&T) => K): sorts in place by a comparable key extracted from each
    // element. The closure's param is hinted &T (like find/any/all); its inferred
    // return type becomes the sort key and must itself be comparable.
    if method == "sortByKey" {
        if args.len != 1 {
            error(&mut ck, "'sortByKey' expects 1 argument (key extractor)", cloneSpan(span))
            return tyUnknown()
        }
        if !isRootMutable(ck, obj) {
            error(&mut ck, "cannot sort immutable Vec", cloneSpan(span))
        }
        var fparams: Vec<TypeKind> = Vec.new()
        fparams.push(TypeKind.TRef(Heap(elem.clone()), false))
        ck.expectedType = Option.Some(TypeKind.TFn(fparams, Heap(tyUnknown())))
        // sortByKey reads the key to compare and never stores or drops it, so a
        // field taken from its borrowed receiver never actually aliases anything
        // past the call — see fieldMoveOutOfBorrow's exemption.
        ck.keyExtractorDepth = ck.keyExtractorDepth + 1
        let cbType = checkExpr(&mut ck, *args[0])
        ck.keyExtractorDepth = ck.keyExtractorDepth - 1
        ck.expectedType = Option.None
        match cbType.clone() {
            TypeKind.TFn(cp, cr) => {
                let keyType = (*cr).clone()
                if !isInteger(keyType) && !isFloat(keyType) && !typeEq(keyType, tyString()) && !typeEq(keyType, tyBool()) {
                    error(&mut ck, "'sortByKey' key must be a comparable type (int, float, string, bool), got " + typeName(keyType), cloneSpan(span))
                }
            }
            _ => {
                error(&mut ck, "'sortByKey' argument must be a function", cloneSpan(span))
            }
        }
        return tyVoid()
    }
    // `v[i]` panics out of range; get/first/last are the total reads. The
    // element comes back cloned — a reference into the buffer could not
    // outlive a later push (matches the oracle's Vec.get/first/last).
    if method == "get" || method == "first" || method == "last" {
        var want: i64 = 0
        if method == "get" {
            want = 1
        }
        if args.len != want {
            error(&mut ck, "'" + method.clone() + "' expects " + want.toString() + " argument(s), got " + args.len.toString(), cloneSpan(span))
        }
        if method == "get" && args.len >= 1 {
            let idxType = checkExpr(&mut ck, *args[0])
            if !isInteger(idxType) && !typeEq(idxType, tyUnknown()) {
                error(&mut ck, "'get' index must be an integer, got " + typeName(idxType), cloneSpan(span))
            }
        }
        var readOptArgs: Vec<TypeKind> = Vec.new()
        readOptArgs.push(elem.clone())
        let readMangled = monomorphizeEnum(&mut ck, "Option", readOptArgs)
        return TypeKind.TEnum(readMangled)
    }
    // Same comparable-element gate `sort` uses. Milo has no ordering trait, so
    // rather than invent an ordering for structs, min/max are refused on them
    // outright (matches the oracle).
    if method == "min" || method == "max" {
        if args.len != 0 {
            error(&mut ck, "'" + method.clone() + "' takes no arguments", cloneSpan(span))
        }
        if !isInteger(elem) && !isFloat(elem) && !typeEq(elem, tyString()) && !typeEq(elem, tyBool()) {
            error(&mut ck, "'" + method.clone() + "' requires a Vec of a comparable type (int, float, string, bool), got Vec<" + typeName(elem) + ">", cloneSpan(span))
            return tyUnknown()
        }
        var mmOptArgs: Vec<TypeKind> = Vec.new()
        mmOptArgs.push(elem.clone())
        let mmMangled = monomorphizeEnum(&mut ck, "Option", mmOptArgs)
        return TypeKind.TEnum(mmMangled)
    }
    // `find` answers "which value"; `indexOf`/`position` answer "where".
    if method == "indexOf" {
        if args.len != 1 {
            error(&mut ck, "'indexOf' expects 1 argument", cloneSpan(span))
            return tyUnknown()
        }
        if !isInteger(elem) && !isFloat(elem) && !typeEq(elem, tyString()) && !typeEq(elem, tyBool()) {
            error(&mut ck, "'indexOf' requires a Vec of a comparable type (int, float, string, bool), got Vec<" + typeName(elem) + ">", cloneSpan(span))
            return tyUnknown()
        }
        let idxArgType = checkExpr(&mut ck, *args[0])
        if !typeEq(elem, idxArgType) && !typeEq(idxArgType, tyUnknown()) {
            error(&mut ck, "'indexOf': expected " + typeName(elem) + ", got " + typeName(idxArgType), cloneSpan(span))
        }
        var idxOptArgs: Vec<TypeKind> = Vec.new()
        idxOptArgs.push(TypeKind.TInt(64, true, Option.None, Option.None))
        let idxMangled = monomorphizeEnum(&mut ck, "Option", idxOptArgs)
        return TypeKind.TEnum(idxMangled)
    }
    if method == "position" {
        if args.len != 1 {
            error(&mut ck, "'position' expects 1 argument", cloneSpan(span))
            return tyUnknown()
        }
        var posParams: Vec<TypeKind> = Vec.new()
        posParams.push(TypeKind.TRef(Heap(elem.clone()), false))
        ck.expectedType = Option.Some(TypeKind.TFn(posParams, Heap(tyBool())))
        checkExpr(&mut ck, *args[0])
        ck.expectedType = Option.None
        var posOptArgs: Vec<TypeKind> = Vec.new()
        posOptArgs.push(TypeKind.TInt(64, true, Option.None, Option.None))
        let posMangled = monomorphizeEnum(&mut ck, "Option", posOptArgs)
        return TypeKind.TEnum(posMangled)
    }
    // extend moves the other Vec in — its elements are transplanted, not copied,
    // so there is no clone and no way to touch the source afterwards.
    if method == "extend" {
        if args.len != 1 {
            error(&mut ck, "'extend' expects 1 argument (a Vec to append)", cloneSpan(span))
            return tyVoid()
        }
        if !isRootMutable(ck, obj) {
            error(&mut ck, "cannot extend an immutable Vec", cloneSpan(span))
        }
        let vecOfElem = TypeKind.TVec(Heap(elem.clone()))
        ck.expectedType = Option.Some(vecOfElem.clone())
        let otherType = checkExpr(&mut ck, *args[0])
        ck.expectedType = Option.None
        match otherType {
            TypeKind.TRef(inner, mutable) => {
                error(&mut ck, "'extend' takes ownership of the other Vec", cloneSpan(span))
            }
            _ => {
                if !typeEq(vecOfElem, otherType) && !typeEq(otherType, tyUnknown()) {
                    error(&mut ck, "'extend': expected Vec<" + typeName(elem) + ">, got " + typeName(otherType), cloneSpan(span))
                }
            }
        }
        tryMove(&mut ck, *args[0])
        return tyVoid()
    }
    // retain is filter's in-place twin: one pass, no second buffer — the
    // rejected elements are dropped where they sit rather than copied aside.
    if method == "retain" {
        if args.len != 1 {
            error(&mut ck, "'retain' expects 1 argument (predicate)", cloneSpan(span))
            return tyVoid()
        }
        if !isRootMutable(ck, obj) {
            error(&mut ck, "cannot retain on an immutable Vec", cloneSpan(span))
        }
        var retParams: Vec<TypeKind> = Vec.new()
        retParams.push(TypeKind.TRef(Heap(elem.clone()), false))
        ck.expectedType = Option.Some(TypeKind.TFn(retParams, Heap(tyBool())))
        checkExpr(&mut ck, *args[0])
        ck.expectedType = Option.None
        return tyVoid()
    }
    if method == "capacity" {
        if args.len != 0 {
            error(&mut ck, "'capacity' takes no arguments", cloneSpan(span))
        }
        return TypeKind.TInt(64, true, Option.None, Option.None)
    }
    if method == "reserve" {
        if args.len != 1 {
            error(&mut ck, "'reserve' expects 1 argument (extra capacity)", cloneSpan(span))
            return tyVoid()
        }
        if !isRootMutable(ck, obj) {
            error(&mut ck, "cannot reserve on an immutable Vec", cloneSpan(span))
        }
        let nType = checkExpr(&mut ck, *args[0])
        if !isInteger(nType) && !typeEq(nType, tyUnknown()) {
            error(&mut ck, "'reserve': expected an integer, got " + typeName(nType), cloneSpan(span))
        }
        return tyVoid()
    }
    error(&mut ck, "no method '" + method.clone() + "' on Vec", cloneSpan(span))
    return tyUnknown()
}

// -- HashMap methods --

pub fn checkHashMapMethod(ck: &mut Checker, obj: &ExprNode, key: &TypeKind, val: &TypeKind, method: &string, args: &Vec<Heap<ExprNode>>, span: &Option<Span>): TypeKind {
    if method == "insert" {
        if args.len != 2 {
            error(&mut ck, "'insert' expects 2 arguments (key, value)", cloneSpan(span))
            return tyVoid()
        }
        if !isRootMutable(ck, obj) {
            error(&mut ck, "cannot insert to immutable HashMap", cloneSpan(span))
        }
        let keyType = checkExpr(&mut ck, *args[0])
        let valType = checkExpr(&mut ck, *args[1])
        if !typeEq(key, keyType) && !typeEq(keyType, tyUnknown()) &&
        !(isConstIntExpr(*args[0]) && isInteger(key)) {
            error(&mut ck, "insert key: expected " + typeName(key) + ", got " + typeName(keyType), cloneSpan(span))
        }
        if !typeEq(val, valType) && !typeEq(valType, tyUnknown()) &&
        !(isConstIntExpr(*args[1]) && isInteger(val)) {
            error(&mut ck, "insert value: expected " + typeName(val) + ", got " + typeName(valType), cloneSpan(span))
        }
        tryMove(&mut ck, *args[0])
        tryMove(&mut ck, *args[1])
        return tyVoid()
    }
    if method == "get" {
        if args.len != 1 {
            error(&mut ck, "'get' expects 1 argument (key)", cloneSpan(span))
        }
        if args.len >= 1 {
            checkExpr(&mut ck, *args[0])
        }
        // get returns Option<V>, matching the TS oracle
        var optArgs: Vec<TypeKind> = Vec.new()
        optArgs.push(val.clone())
        let mangled = monomorphizeEnum(&mut ck, "Option", optArgs)
        return TypeKind.TEnum(mangled)
    }
    if method == "contains" {
        if args.len != 1 {
            error(&mut ck, "'contains' expects 1 argument (key)", cloneSpan(span))
        }
        if args.len >= 1 {
            checkExpr(&mut ck, *args[0])
        }
        return tyBool()
    }
    if method == "getOrDefault" {
        if args.len != 2 {
            error(&mut ck, "'getOrDefault' expects 2 arguments (key, default)", cloneSpan(span))
            return val.clone()
        }
        let keyType = checkExpr(&mut ck, *args[0])
        let defType = checkExpr(&mut ck, *args[1])
        if !typeEq(key, keyType) && !typeEq(keyType, tyUnknown()) &&
        !(isConstIntExpr(*args[0]) && isInteger(key)) {
            error(&mut ck, "getOrDefault key: expected " + typeName(key) + ", got " + typeName(keyType), cloneSpan(span))
        }
        if !typeEq(val, defType) && !typeEq(defType, tyUnknown()) &&
        !(isConstIntExpr(*args[1]) && isInteger(val)) {
            error(&mut ck, "getOrDefault default: expected " + typeName(val) + ", got " + typeName(defType), cloneSpan(span))
        }
        return val.clone()
    }
    if method == "remove" {
        if args.len != 1 {
            error(&mut ck, "'remove' expects 1 argument (key)", cloneSpan(span))
        }
        if !isRootMutable(ck, obj) {
            error(&mut ck, "cannot remove from immutable HashMap", cloneSpan(span))
        }
        if args.len >= 1 {
            checkExpr(&mut ck, *args[0])
        }
        return tyBool()
    }
    if method == "clone" {
        if args.len != 0 {
            error(&mut ck, "'clone' takes no arguments", cloneSpan(span))
        }
        return TypeKind.THashMap(Heap(key.clone()), Heap(val.clone()))
    }
    if method == "len" {
        if args.len != 0 {
            error(&mut ck, "'len' takes no arguments", cloneSpan(span))
        }
        return TypeKind.TInt(64, true, Option.None, Option.None)
    }
    if method == "isEmpty" {
        if args.len != 0 {
            error(&mut ck, "'isEmpty' takes no arguments", cloneSpan(span))
        }
        return tyBool()
    }
    if method == "clear" {
        if args.len != 0 {
            error(&mut ck, "'clear' takes no arguments", cloneSpan(span))
        }
        if !isRootMutable(ck, obj) {
            error(&mut ck, "cannot clear an immutable HashMap", cloneSpan(span))
        }
        return tyVoid()
    }
    // keys(): snapshot the map's keys into a Vec — iteration order is unspecified
    // (hash seed is randomized per process), so this is the supported way to get
    // a stable order (collect, then sort).
    if method == "keys" {
        if args.len != 0 {
            error(&mut ck, "'keys' takes no arguments", cloneSpan(span))
        }
        return TypeKind.TVec(Heap(key.clone()))
    }
    // values(): same snapshot-into-a-Vec deal as keys(), just the other column.
    if method == "values" {
        if args.len != 0 {
            error(&mut ck, "'values' takes no arguments", cloneSpan(span))
        }
        return TypeKind.TVec(Heap(val.clone()))
    }
    error(&mut ck, "no method '" + method.clone() + "' on HashMap", cloneSpan(span))
    return tyUnknown()
}

// -- String methods --

pub fn checkStringMethod(ck: &mut Checker, obj: &ExprNode, method: &string, args: &Vec<Heap<ExprNode>>, span: &Option<Span>): TypeKind {
    // `lines`/`splitView` are loop-only forms (checkForIn's peekPathType
    // intercepts them there, before this generic method dispatch ever runs).
    // Reaching them here means they were used OUTSIDE a `for ... in` — each
    // piece is a `&string` view into the receiver, with nowhere to live once
    // the loop that would have frozen the receiver for it doesn't exist.
    if method == "lines" || method == "splitView" {
        error(&mut ck, "'" + method.clone() + "' is only valid as the iterable of a 'for ... in' loop over a named string", cloneSpan(span))
        return tyUnknown()
    }
    if method == "clone" {
        if args.len != 0 {
            error(&mut ck, "'clone' takes no arguments", cloneSpan(span))
        }
        return tyString()
    }
    if method == "contains" || method == "startsWith" || method == "endsWith" {
        if args.len != 1 {
            error(&mut ck, "'" + method.clone() + "' expects 1 argument", cloneSpan(span))
        }
        if args.len >= 1 {
            let argType = checkExpr(&mut ck, *args[0])
            if !typeEq(argType, tyString()) && !typeEq(argType, tyUnknown()) {
                error(&mut ck, "'" + method.clone() + "' argument must be string", cloneSpan(span))
            }
        }
        return tyBool()
    }
    if method == "split" {
        if args.len != 1 {
            error(&mut ck, "'split' expects 1 argument", cloneSpan(span))
        }
        if args.len >= 1 {
            checkExpr(&mut ck, *args[0])
        }
        return TypeKind.TVec(Heap(tyString()))
    }
    if method == "splitWords" || method == "splitWhitespace" {
        if args.len != 0 {
            error(&mut ck, "'" + method.clone() + "' takes no arguments", cloneSpan(span))
        }
        return TypeKind.TVec(Heap(tyString()))
    }
    if method == "reverse" {
        if args.len != 0 {
            error(&mut ck, "'reverse' takes no arguments", cloneSpan(span))
        }
        return tyString()
    }
    if method == "trim" || method == "trimStart" || method == "trimEnd" ||
    method == "toLower" || method == "toUpper" {
        if args.len != 0 {
            error(&mut ck, "'" + method.clone() + "' takes no arguments", cloneSpan(span))
        }
        return tyString()
    }
    if method == "substr" {
        if args.len != 2 {
            error(&mut ck, "'substr' expects 2 arguments (start, end)", cloneSpan(span))
        }
        if args.len >= 1 {
            checkExpr(&mut ck, *args[0])
        }
        if args.len >= 2 {
            checkExpr(&mut ck, *args[1])
        }
        return tyString()
    }
    if method == "cstr" {
        if args.len != 0 {
            error(&mut ck, "'cstr' takes no arguments", cloneSpan(span))
        }
        return TypeKind.TPtr(Heap(tyU8()))
    }
    if method == "substring" {
        if args.len != 2 {
            error(&mut ck, "'substring' expects 2 arguments (start, end)", cloneSpan(span))
        }
        if args.len >= 1 {
            checkExpr(&mut ck, *args[0])
        }
        if args.len >= 2 {
            checkExpr(&mut ck, *args[1])
        }
        return tyString()
    }
    // s[a..b] desugars to s.slice(a,b): a `&string` view into the receiver's own
    // buffer, not an owned copy — same reasoning as Vec.slice above.
    if method == "slice" {
        if args.len != 2 {
            error(&mut ck, "'slice' expects 2 arguments (start, end)", cloneSpan(span))
        }
        if args.len >= 1 {
            let startType = checkExpr(&mut ck, *args[0])
            if !isInteger(startType) && !typeEq(startType, tyUnknown()) {
                error(&mut ck, "slice start: expected integer, got " + typeName(startType), cloneSpan(span))
            }
        }
        if args.len >= 2 {
            let endType = checkExpr(&mut ck, *args[1])
            if !isInteger(endType) && !typeEq(endType, tyUnknown()) {
                error(&mut ck, "slice end: expected integer, got " + typeName(endType), cloneSpan(span))
            }
        }
        // Freeze the receiver's root: appending/pushing can realloc the buffer
        // this view points into.
        freezePlace(&mut ck, obj)
        return TypeKind.TRef(Heap(tyString()), false)
    }
    // Option<i64>, matching the oracle: -1 "not found" was a sentinel colliding
    // with real data (nothing distinguishes "found at -1" from "not found" once
    // the caller only sees a bare int). indexOfFrom already made this move below.
    if method == "indexOf" || method == "lastIndexOf" {
        var idxOptArgs: Vec<TypeKind> = Vec.new()
        idxOptArgs.push(TypeKind.TInt(64, true, Option.None, Option.None))
        let idxMangled = monomorphizeEnum(&mut ck, "Option", idxOptArgs)
        if args.len != 1 {
            error(&mut ck, "'" + method.clone() + "' expects 1 argument", cloneSpan(span))
            return TypeKind.TEnum(idxMangled)
        }
        let idxArgType = checkExpr(&mut ck, *args[0])
        if !typeEq(idxArgType, tyString()) && !typeEq(idxArgType, tyUnknown()) {
            error(&mut ck, "'" + method.clone() + "': expected string, got " + typeName(idxArgType), cloneSpan(span))
        }
        return TypeKind.TEnum(idxMangled)
    }
    if method == "len" {
        if args.len != 0 {
            error(&mut ck, "'len' takes no arguments", cloneSpan(span))
        }
        return TypeKind.TInt(64, true, Option.None, Option.None)
    }
    if method == "replace" {
        if args.len != 2 {
            error(&mut ck, "'replace' expects 2 arguments", cloneSpan(span))
        }
        if args.len >= 1 {
            checkExpr(&mut ck, *args[0])
        }
        if args.len >= 2 {
            checkExpr(&mut ck, *args[1])
        }
        return tyString()
    }
    if method == "push" {
        if args.len != 1 {
            error(&mut ck, "'push' expects 1 argument", cloneSpan(span))
        }
        if !isRootMutable(ck, obj) {
            error(&mut ck, "cannot push to immutable string", cloneSpan(span))
        }
        errorIfFrozenRoot(&mut ck, obj, "call 'push' on", span)
        if args.len >= 1 {
            checkExpr(&mut ck, *args[0])
        }
        return tyVoid()
    }
    // `s.pushStr(other)` appends a whole string in place; `push` appends one byte.
    if method == "pushStr" {
        if args.len != 1 {
            error(&mut ck, "'pushStr' expects 1 argument", cloneSpan(span))
        }
        if !isRootMutable(ck, obj) {
            error(&mut ck, "cannot pushStr to immutable string", cloneSpan(span))
        }
        errorIfFrozenRoot(&mut ck, obj, "call 'pushStr' on", span)
        if args.len >= 1 {
            let argTy = checkExpr(&mut ck, *args[0])
            if !typeEq(argTy, tyString()) {
                error(&mut ck, "string.pushStr: expected string", cloneSpan(span))
            }
        }
        return tyVoid()
    }
    // toInt is a dead legacy alias (unused anywhere in std/examples/tests) — left
    // as a bare i64 rather than risking a signature no caller depends on.
    if method == "toInt" {
        return TypeKind.TInt(64, true, Option.None, Option.None)
    }
    // Option<i64>, matching the oracle and — critically — matching what CODEGEN
    // emits: the call goes to std/string.milo's strParseInt, which already
    // returns Option<i64> (same disagreement class as parseF64/toFloat below —
    // codegen was right, the checker was declaring a bare i64).
    if method == "parseInt" {
        if args.len != 0 {
            error(&mut ck, "'parseInt' takes no arguments", cloneSpan(span))
        }
        var iOptArgs: Vec<TypeKind> = Vec.new()
        iOptArgs.push(TypeKind.TInt(64, true, Option.None, Option.None))
        let iMangled = monomorphizeEnum(&mut ck, "Option", iOptArgs)
        return TypeKind.TEnum(iMangled)
    }
    // Option<f64>, matching the oracle and — critically — matching what CODEGEN emits.
    // These disagreed: codegen was returning an Option while the checker said bare f64, so
    // `s.parseF64() ?? 0.0` type-checked as "?? on an f64" and was rejected. Registering
    // the monomorphization here is what makes `Option_f64` exist for codegen to build.
    if method == "toFloat" || method == "parseFloat" || method == "parseF64" {
        var fOptArgs: Vec<TypeKind> = Vec.new()
        fOptArgs.push(TypeKind.TFloat(64))
        let fMangled = monomorphizeEnum(&mut ck, "Option", fOptArgs)
        return TypeKind.TEnum(fMangled)
    }
    if method == "chars" || method == "bytes" {
        return TypeKind.TVec(Heap(tyU8()))
    }
    if method == "repeat" {
        if args.len != 1 {
            error(&mut ck, "'repeat' expects 1 argument", cloneSpan(span))
        }
        if args.len >= 1 {
            let argType = checkExpr(&mut ck, *args[0])
            if !isInteger(argType) && !typeEq(argType, tyUnknown()) {
                error(&mut ck, "'repeat': expected integer, got " + typeName(argType), cloneSpan(span))
            }
        }
        return tyString()
    }
    // like indexOf but starts the search at byte offset `from`; returns Option<i64>
    // to match the oracle (indexOf/lastIndexOf still return a bare i64 here — a
    // pre-existing gap versus the oracle, out of scope for this change).
    if method == "indexOfFrom" {
        var optArgs: Vec<TypeKind> = Vec.new()
        optArgs.push(TypeKind.TInt(64, true, Option.None, Option.None))
        let mangled = monomorphizeEnum(&mut ck, "Option", optArgs)
        if args.len != 2 {
            error(&mut ck, "'indexOfFrom' expects 2 arguments (needle, from)", cloneSpan(span))
        }
        if args.len >= 1 {
            let nType = checkExpr(&mut ck, *args[0])
            if !typeEq(nType, tyString()) && !typeEq(nType, tyUnknown()) {
                error(&mut ck, "'indexOfFrom' arg 1: expected string, got " + typeName(nType), cloneSpan(span))
            }
        }
        if args.len >= 2 {
            let fromType = checkExpr(&mut ck, *args[1])
            if !isInteger(fromType) && !typeEq(fromType, tyUnknown()) {
                error(&mut ck, "'indexOfFrom' arg 2: expected integer, got " + typeName(fromType), cloneSpan(span))
            }
        }
        return TypeKind.TEnum(mangled)
    }
    error(&mut ck, "no method '" + method.clone() + "' on string", cloneSpan(span))
    return tyUnknown()
}

// -- Struct/trait method calls --

pub fn checkStructMethod(ck: &mut Checker, obj: &ExprNode, structName: &string, method: &string, args: &Vec<Heap<ExprNode>>, span: &Option<Span>): TypeKind {
    // Look up inherent implDecl method
    if ck.inherentImpls.contains(structName) {
        let implDecl = ck.inherentImpls.get(structName)!
        if implDecl.methods.contains(method) {
            let sig = implDecl.methods.get(method)!
            // First param is self (skip it in user args)
            let userParams = sig.params.len - 1
            if args.len != userParams {
                error(&mut ck, "method '" + method.clone() + "' expects " + userParams.toString() + " args, got " + args.len.toString(), cloneSpan(span))
            }
            // A `self: &mut Self` method may mutate the receiver — same hazard
            // a mutating builtin (push, etc) already rejects on a frozen var.
            // A `self: Self` method CONSUMES it — same as any other by-value move
            // position (the free-function call path below already does this for
            // its args). Missing this let a @noCopy handle's `.close()`/`.free()`
            // be called twice: the receiver was never marked moved, so the second
            // call's "use of moved variable" check never fired.
            if sig.params.len > 0 {
                match sig.params[0].ty.clone() {
                    TypeKind.TRef(sinner, smut) => {
                        if smut {
                            errorIfFrozenRoot(&mut ck, obj, "call '" + method.clone() + "' on", span)
                        }
                    }
                    _ => {
                        tryMove(&mut ck, obj)
                    }
                }
            }
            var i: i64 = 0
            while i < args.len && (i + 1) < sig.params.len {
                let argType = checkExpr(&mut ck, *args[i])
                let paramType = sig.params[i + 1].ty
                // display name computed BEFORE the match: the TRef arm moves the
                // inner Heap out, leaving `paramType` zeroed (same hazard as the
                // free-function path above)
                let ptName = typeName(paramType)
                match paramType {
                    TypeKind.TRef(inner, mutable) => {
                        // A view passed straight through (the arg is ALREADY a matching
                        // &T, e.g. a method that returns &string/&[T]) has to be accepted
                        // too — see the identical fix on the free-function call path
                        // above for why comparing only the unwrapped inner rejects it,
                        // and why mutability is deliberately not compared here.
                        var refPassThrough = false
                        match argType.clone() {
                            TypeKind.TRef(argInner, argMutable) => {
                                if typeEq(*inner, *argInner) {
                                    refPassThrough = true
                                }
                            }
                            _ => {
                            }
                        }
                        if !refPassThrough && !typeEq(*inner, argType) && !typeEq(argType, tyUnknown()) && !intCoercible(*inner, argType, *args[i]) {
                            error(&mut ck, "argument " + (i + 1).toString() + " of '" + method.clone() + "': expected " + ptName + ", got " + typeName(argType), cloneSpan(span))
                        }
                    }
                    _ => {
                        if !typeEq(paramType, argType) && !typeEq(argType, tyUnknown()) && !intCoercible(paramType, argType, *args[i]) && !ptrCoercible(paramType, argType) {
                            // `sink.json(entry)` auto-stringifies a struct argument
                            // passed to a 'json'-named method's string param — mirrors
                            // ctx.json(user) in the oracle (checker.ts). codegen
                            // re-derives this exact condition itself (method name +
                            // param/arg types) rather than reading a decision off a
                            // side table, since src-milo has no Expr-keyed side table
                            // to carry it (see derive_json's jsonHasCodec + genMethodCall's
                            // "json"-named-method arm).
                            var isJsonAutoStringify = false
                            if method == "json" {
                                match paramType.clone() {
                                    TypeKind.TString => {
                                        match argType.clone() {
                                            TypeKind.TStruct(sn) => {
                                                isJsonAutoStringify = true
                                                if !jsonHasCodec(ck, sn) {
                                                    if ck.structs.contains(sn) {
                                                        let sinfo = ck.structs.get(sn)!
                                                        for f in sinfo.fields {
                                                            var scalar = false
                                                            match f.ty {
                                                                TypeKind.TString => {
                                                                    scalar = true
                                                                }
                                                                TypeKind.TBool => {
                                                                    scalar = true
                                                                }
                                                                TypeKind.TInt(bits, signed, _, _) => {
                                                                    scalar = true
                                                                }
                                                                TypeKind.TFloat(bits) => {
                                                                    scalar = true
                                                                }
                                                                _ => {
                                                                }
                                                            }
                                                            if !scalar {
                                                                errorHint(&mut ck, "'json': '" + sn.clone() + "." + f.name.clone() + "' has type " + typeName(f.ty) + ", which the built-in stringifier cannot serialize", "add '@derive(Json)' to '" + sn.clone() + "' — the derived codec handles nested structs, Vec and Option", cloneSpan(span))
                                                            }
                                                        }
                                                    }
                                                }
                                            }
                                            _ => {
                                            }
                                        }
                                    }
                                    _ => {
                                    }
                                }
                            }
                            if !isJsonAutoStringify {
                                error(&mut ck, "argument " + (i + 1).toString() + " of '" + method.clone() + "': expected " + typeName(paramType) + ", got " + typeName(argType), cloneSpan(span))
                            }
                        }
                        tryMove(&mut ck, *args[i])
                    }
                }
                i = i + 1
            }
            // `lx.word(...)`: a `&[T]`/`&string` return is a view into the
            // receiver's own storage — the call site freezes it for the
            // result's life, same as `v[a..b]`. A receiver with no named
            // root (a temporary) can't be frozen long enough to matter.
            if isViewReturnType(sig.ret) {
                let mangled = structName.clone() + "$" + method.clone()
                var extraFields: Vec<string> = Vec.new()
                match ck.viewReturnFields.get(mangled) {
                    Option.Some(fs) => {
                        extraFields = fs
                    }
                    Option.None => {
                    }
                }
                freezeViewMethodSource(&mut ck, obj, extraFields, span)
            }
            return sig.ret.clone()
        }
    }

    // Look up trait methods
    if ck.traitImpls.contains(structName) {
        let impls = ck.traitImpls.get(structName)!
        for i in 0..impls.len {
            if impls[i].methods.contains(method) {
                let sig = impls[i].methods.get(method)!
                let userParams = sig.params.len - 1
                if args.len != userParams {
                    error(&mut ck, "method '" + method.clone() + "' expects " + userParams.toString() + " args, got " + args.len.toString(), cloneSpan(span))
                }
                var j: i64 = 0
                while j < args.len && (j + 1) < sig.params.len {
                    checkExpr(&mut ck, *args[j])
                    j = j + 1
                }
                return sig.ret.clone()
            }
        }
    }

    // clone() is always available
    if method == "clone" {
        if args.len != 0 {
            error(&mut ck, "'clone' takes no arguments", cloneSpan(span))
        }
        return TypeKind.TStruct(structName.clone())
    }

    // fn-typed struct field called like a method: h.apply(x) where apply: (T)=>R
    if ck.structs.contains(structName) {
        let sinfo = ck.structs.get(structName)!
        for fi in 0..sinfo.fields.len {
            if sinfo.fields[fi].name == method {
                match sinfo.fields[fi].ty {
                    TypeKind.TFn(fparams, fret) => {
                        if args.len != fparams.len {
                            error(&mut ck, "'" + method.clone() + "' expects " + fparams.len.toString() + " argument(s), got " + args.len.toString(), cloneSpan(span))
                        }
                        var ai: i64 = 0
                        while ai < args.len && ai < fparams.len {
                            checkExpr(&mut ck, *args[ai])
                            ai = ai + 1
                        }
                        return (*fret).clone()
                    }
                    _ => {
                    }
                }
            }
        }
    }

    // interface/trait-object dispatch: `g.method()` where g's type is an interface
    // (a registered trait used as a type). The method resolves against the trait;
    // codegen dispatches through the fat pointer's itable.
    if ck.traits.contains(structName) {
        let tinfo = ck.traits.get(structName)!
        if tinfo.methods.contains(method) {
            let m = tinfo.methods.get(method)!
            // user args skip the implicit self (trait method's first param)
            for arg in args {
                checkExpr(&mut ck, *arg)
            }
            return m.ret.clone()
        }
        error(&mut ck, "interface '" + structName.clone() + "' has no method '" + method.clone() + "'", cloneSpan(span))
        return tyUnknown()
    }

    // Option/Result queries. These are monomorphized enums (Option_i64, Result_i32_string),
    // so they arrive here as TStruct(mangled) and would otherwise be "no method on struct".
    // Payload-free predicates plus `unwrapOr` only: the combinators that take a closure
    // (map/andThen/orElse) need generic closure typing and are deliberately left out
    // rather than half-supported.
    if ck.enums.contains(structName) {
        let einfo = ck.enums.get(structName)!
        let base = einfo.baseName.clone()
        if base == "Option" || base == "Result" {
            var okName = "Some"
            var isYes = "isSome"
            var isNo = "isNone"
            if base == "Result" {
                okName = "Ok"
                isYes = "isOk"
                isNo = "isErr"
            }
            if method == isYes || method == isNo {
                if args.len != 0 {
                    error(&mut ck, "'" + method.clone() + "' takes no arguments", cloneSpan(span))
                }
                return tyBool()
            }
            if method == "unwrapOr" {
                if args.len != 1 {
                    error(&mut ck, "'unwrapOr' expects 1 argument", cloneSpan(span))
                }
                if args.len >= 1 {
                    checkExpr(&mut ck, *args[0])
                }
                if einfo.variants.contains(okName) {
                    let vi = einfo.variants.get(okName)!
                    if vi.fields.len > 0 {
                        return vi.fields[0].clone()
                    }
                }
                return tyUnknown()
            }
        }
    }

    error(&mut ck, "no method '" + method.clone() + "' on struct '" + structName.clone() + "'", cloneSpan(span))
    return tyUnknown()
}

// -- Closures --

// A closure's return type: an annotation wins; otherwise it's inferred from a
// `return <expr>` in the body (captured via ck.pendingClosureRet while walking).
pub fn checkClosure(ck: &mut Checker, params: &Vec<Param>, retType: &Option<MiloType>, body: &Vec<Heap<Stmt>>): TypeKind {
    pushScope(&mut ck)

    var paramTypes: Vec<TypeKind> = Vec.new()
    for i in 0..params.len {
        var pType = resolveMonoType(&mut ck, params[i].ty)
        // an unannotated closure param (`(x) => …`, an empty-name MiloType) infers
        // its type from the expected fn type (e.g. Vec.map's `(T) => R`).
        let unannotated = params[i].ty.name.len == 0 && params[i].ty.typeArgs.len == 0 && !params[i].ty.isFn
        if unannotated || containsUnknown(pType) {
            match ck.expectedType {
                Option.Some(et) => {
                    match et {
                        TypeKind.TFn(fparams, fret) => {
                            if i < fparams.len {
                                pType = fparams[i].clone()
                            }
                        }
                        _ => {
                        }
                    }
                }
                Option.None => {
                }
            }
        }
        // a `&mut T` closure param makes the pointee assignable through the ref
        var pMut = false
        match pType.clone() {
            TypeKind.TRef(inner, m) => {
                pMut = m
            }
            _ => {
            }
        }
        declare(&mut ck, params[i].name.clone(), VarInfo {
            ty: pType.clone(),
            mutable: pMut,
            moved: false,
            borrowed: false,
            read: false,
            span: Option.None,
        }
        )
        paramTypes.push(pType)
    }

    var inferredRet = tyVoid()
    var annotated = false
    match retType {
        Option.Some(rt) => {
            inferredRet = resolveMonoType(&mut ck, rt)
            annotated = true
        }
        Option.None => {
        }
    }

    // Walk the body so inner locals (`var updated = n`) are declared and checked.
    // Unannotated closures pass an unknown return type so `return` statements don't
    // mismatch and instead record their value type into ck.pendingClosureRet.
    var walkRet = inferredRet.clone()
    if !annotated {
        walkRet = tyUnknown()
    }
    ck.pendingClosureRet = Option.None
    let snap = snapshotMoves(ck)
    for i in 0..body.len {
        checkStmt(&mut ck, *body[i], walkRet)
    }
    restoreMoves(&mut ck, snap)
    if !annotated {
        match ck.pendingClosureRet {
            Option.Some(t) => {
                inferredRet = t.clone()
            }
            Option.None => {
            }
        }
    }

    popScope(&mut ck)
    return TypeKind.TFn(paramTypes, Heap(inferredRet))
}
