// Partial/field move tracking — ports src/checker.ts's movedPlaces machinery
// (staticFieldPath, markPlaceMoved, movedPlaceCovering, clearMovedPlace) so
// that moving a FIELD out of a struct is tracked per-field, not just
// per-binding: `let a = p.a` must not make a LATER `let b = p.b` illegal, but
// it must make a later whole-value use of `p` illegal (the field is gone).
//
// Same design constraint as borrow.milo: VarInfo lives in the scope table BY
// VALUE (`lookup` returns a copy; mutation goes through explicit setVar*-and-
// reinsert helpers), so this can't hang a field off VarInfo directly — a
// name-keyed side table on the Checker instead (`movedFields`). See
// borrow.milo's header and state.milo's Checker struct for the fuller
// rationale. Built on the SAME `accessPath` the borrow checker uses, rather
// than a second Expr-chain walker, so an index anywhere in a place (accessPath's
// `tainted`) is treated identically by both move and borrow tracking.
from "src-milo/ast.milo" import {
    Expr, ExprNode
}
from "src-milo/checker/state.milo" import {
    Checker
}
from "src-milo/checker/borrow.milo" import {
    AccessPath, accessPath
}

// Dotted rendering of a field-only chain: ["a"] -> ".a", ["inner","s"] -> ".inner.s".
pub fn fieldPathString(fields: &Vec<string>): string {
    var out = ""
    for i in 0..fields.len {
        out = out + "." + fields[i].clone()
    }
    return out
}

// The field-only place `e` names, if any — a chain of plain field steps off a
// named root, with no index/deref anywhere in it (an index offset is a runtime
// value, so there's no static place to mark or check). Mirrors the oracle's
// staticFieldPath.
pub fn staticFieldPlace(e: &ExprNode): Option<AccessPath> {
    match accessPath(e) {
        Option.Some(p) => {
            if p.tainted || p.fields.len == 0 {
                return Option.None
            }
            return Option.Some(p)
        }
        Option.None => {
            return Option.None
        }
    }
}

fn vecContainsStr(v: &Vec<string>, target: &string): bool {
    for i in 0..v.len {
        if v[i] == target {
            return true
        }
    }
    return false
}

// Records that `root`+`path` (a dotted chain from fieldPathString) has left its
// binding. Idempotent — re-marking the same place is a no-op, matching the
// oracle's Set<string>.
pub fn markFieldMoved(ck: &mut Checker, root: &string, path: &string) {
    var existing: Vec<string> = Vec.new()
    match ck.movedFields.get(root) {
        Option.Some(v) => {
            existing = v
        }
        Option.None => {
        }
    }
    if !vecContainsStr(existing, path) {
        existing.push(path.clone())
    }
    ck.movedFields.insert(root.clone(), existing)
}

// The moved entry that covers `path` — the path itself, or any prefix of it
// (once `.a` left so did `.a.b`, since the buffer they share left with it).
pub fn movedFieldCovering(ck: &Checker, root: &string, path: &string): Option<string> {
    match ck.movedFields.get(root) {
        Option.Some(v) => {
            for i in 0..v.len {
                if v[i] == path || path.startsWith(v[i].clone() + ".") {
                    return Option.Some(v[i].clone())
                }
            }
            return Option.None
        }
        Option.None => {
            return Option.None
        }
    }
}

// The first recorded moved field for `root`, for the "used as a whole while
// incomplete" diagnostic — any entry is enough, same as the oracle picking the
// Set's first member.
pub fn firstMovedField(ck: &Checker, root: &string): Option<string> {
    match ck.movedFields.get(root) {
        Option.Some(v) => {
            if v.len > 0 {
                return Option.Some(v[0].clone())
            }
            return Option.None
        }
        Option.None => {
            return Option.None
        }
    }
}

// Assigning to a place puts a value back — clear it and everything nested
// under it. `path = None` clears the whole variable (an Ident target replacing
// the entire binding). Mirrors the oracle's clearMovedPlace.
pub fn clearMovedFields(ck: &mut Checker, root: &string, path: Option<string>) {
    match ck.movedFields.get(root) {
        Option.Some(existing) => {
            match path {
                Option.None => {
                    ck.movedFields.insert(root.clone(), Vec.new())
                }
                Option.Some(p) => {
                    var kept: Vec<string> = Vec.new()
                    for i in 0..existing.len {
                        if existing[i] != p && !existing[i].startsWith(p.clone() + ".") {
                            kept.push(existing[i].clone())
                        }
                    }
                    ck.movedFields.insert(root.clone(), kept)
                }
            }
        }
        Option.None => {
        }
    }
}
