// Monomorphization — instantiate generic functions, structs, enums with concrete types
from "src-milo/ast.milo" import {
    Function, Stmt, Expr, MiloType, StructDecl, EnumDecl, EnumVariant,
    Param, StructField, TypeParam, Span, StructLitField, MatchArm, Pattern, ImplDecl, Attribute,
    cloneOptI64,
}
from "src-milo/checker/traits.milo" import {
    registerImpl
}
from "src-milo/checker/types.milo" import {
    TypeKind, typeEq, typeName, typeFromAst, typeFromName, tyUnknown,
    isNumeric, isInteger,
}
from "src-milo/checker/state.milo" import {
    Checker, FnSig, FnParam, StructInfo, CkStructField,
    EnumInfo, VariantInfo, error, normalizeEnumNames,
    GenericFnInfo, GenericStructInfo, GenericEnumInfo, StructInst, hasAttr, displayType,
}
from "src-milo/checker/derive_json.milo" import {
    deriveJson
}

pub fn cloneTypeArgs(v: &Vec<TypeKind>): Vec<TypeKind> {
    var out: Vec<TypeKind> = Vec.new()
    for i in 0..v.len {
        out.push(v[i].clone())
    }
    return out
}

// -- Type name mangling --

pub fn mangleTypeName(t: &TypeKind): string {
    match t {
        TypeKind.TInt(bits, signed, _, _) => {
            if signed {
                return "i" + bits.toString()
            } else {
                return "u" + bits.toString()
            }
        }
        TypeKind.TFloat(bits) => {
            return "f" + bits.toString()
        }
        TypeKind.TBool => {
            return "bool"
        }
        TypeKind.TVoid => {
            return "void"
        }
        TypeKind.TString => {
            return "string"
        }
        TypeKind.TStruct(name) => {
            return name.clone()
        }
        TypeKind.TEnum(name) => {
            return name.clone()
        }
        TypeKind.TPtr(inner) => {
            return "ptr_" + mangleTypeName(*inner)
        }
        TypeKind.THeap(inner) => {
            return "Heap_" + mangleTypeName(*inner)
        }
        TypeKind.TVec(elem) => {
            return "Vec_" + mangleTypeName(*elem)
        }
        TypeKind.THashMap(key, val) => {
            return "HashMap_" + mangleTypeName(*key) + "_" + mangleTypeName(*val)
        }
        TypeKind.TArray(elem, size) => {
            var s = "arr_" + mangleTypeName(*elem)
            match size {
                Option.Some(n) => {
                    s = s + "_" + n.toString()
                }
                Option.None => {
                }
            }
            return s
        }
        TypeKind.TRef(inner, mutable) => {
            return "ref_" + mangleTypeName(*inner)
        }
        TypeKind.TFn(params, ret) => {
            var s = "fn"
            for i in 0..params.len {
                s = s + "_" + mangleTypeName(params[i])
            }
            s = s + "_ret_" + mangleTypeName(*ret)
            return s
        }
        TypeKind.TUnknown => {
            return "unknown"
        }
    }
}

// -- Type substitution in TypeKind --

pub fn substituteTypeKind(t: &TypeKind, typeMap: &HashMap<string, TypeKind>): TypeKind {
    match t {
        TypeKind.TStruct(name) => {
            if typeMap.contains(name) {
                return typeMap.get(name)!.clone()
            }
            return t.clone()
        }
        TypeKind.TArray(elem, size) => {
            return TypeKind.TArray(Heap(substituteTypeKind(*elem, typeMap)), cloneOptI64(size))
        }
        TypeKind.TRef(inner, mutable) => {
            return TypeKind.TRef(Heap(substituteTypeKind(*inner, typeMap)), mutable)
        }
        TypeKind.TPtr(inner) => {
            return TypeKind.TPtr(Heap(substituteTypeKind(*inner, typeMap)))
        }
        TypeKind.THeap(inner) => {
            return TypeKind.THeap(Heap(substituteTypeKind(*inner, typeMap)))
        }
        TypeKind.TVec(elem) => {
            return TypeKind.TVec(Heap(substituteTypeKind(*elem, typeMap)))
        }
        TypeKind.THashMap(key, val) => {
            return TypeKind.THashMap(Heap(substituteTypeKind(*key, typeMap)), Heap(substituteTypeKind(*val, typeMap)),)
        }
        TypeKind.TFn(params, ret) => {
            var newParams: Vec<TypeKind> = Vec.new()
            for i in 0..params.len {
                newParams.push(substituteTypeKind(params[i], typeMap))
            }
            return TypeKind.TFn(newParams, Heap(substituteTypeKind(*ret, typeMap)))
        }
        _ => {
            return t.clone()
        }
    }
}

// -- Type substitution in MiloType AST nodes --

// Faithfully reconstruct a MiloType (AST form) from a resolved TypeKind so that
// substituting a compound type param (T -> Vec<i64>) keeps a real nested type,
// NOT a flattened name string. typeName() renders `Vec<i64>` with angle brackets,
// which would corrupt both mangling (Channel_Vec<i64>) and re-resolution.
pub fn typeKindToMiloType(t: &TypeKind): MiloType {
    match t {
        TypeKind.TVec(elem) => {
            var r = simpleType("Vec")
            r.typeArgs.push(typeKindToMiloType(*elem))
            return r
        }
        TypeKind.THashMap(key, val) => {
            var r = simpleType("HashMap")
            r.typeArgs.push(typeKindToMiloType(*key))
            r.typeArgs.push(typeKindToMiloType(*val))
            return r
        }
        TypeKind.THeap(inner) => {
            var r = simpleType("Heap")
            r.typeArgs.push(typeKindToMiloType(*inner))
            return r
        }
        TypeKind.TPtr(inner) => {
            // Recursion already accumulates depth: a nested TPtr(TPtr(u8))
            // walks in twice, incrementing once per level.
            var r = typeKindToMiloType(*inner)
            r.ptrDepth = r.ptrDepth + 1
            return r
        }
        TypeKind.TRef(inner, mutable) => {
            var r = typeKindToMiloType(*inner)
            if mutable {
                r.isRefMut = true
            } else {
                r.isRef = true
            }
            return r
        }
        TypeKind.TArray(elem, size) => {
            var r = typeKindToMiloType(*elem)
            r.isArray = true
            r.arraySize = cloneOptI64(size)
            return r
        }
        TypeKind.TStruct(name) => {
            return simpleType(name.clone())
        }
        TypeKind.TEnum(name) => {
            return simpleType(name.clone())
        }
        // Spelled out rather than left to the typeName fallback below: typeName
        // renders a ranged int as "i32(0..100)", which is a type EXPRESSION, not
        // a name — round-tripping it through simpleType would produce a MiloType
        // nothing can resolve.
        TypeKind.TInt(bits, signed, lo, hi) => {
            var prefix = "u"
            if signed {
                prefix = "i"
            }
            var r = simpleType(prefix + bits.toString())
            r.rangeMin = cloneOptI64(lo)
            r.rangeMax = cloneOptI64(hi)
            return r
        }
        // scalars (float/bool/void/string) have no angle-bracket forms
        _ => {
            return simpleType(typeName(t))
        }
    }
}

pub fn substituteMiloType(ty: &MiloType, typeParams: &Vec<string>, typeArgs: &Vec<TypeKind>): MiloType {
    // Check if this type name is a type parameter
    for i in 0..typeParams.len {
        if ty.name == typeParams[i] {
            // Replace with the concrete type. For a compound arg (Vec<i64>) build a
            // faithful nested MiloType; monomorphization then subsumes any user-generic
            // args into the mangled name (Box<T> -> Box_string) via resolveMonoType.
            var result = typeKindToMiloType(typeArgs[i])
            // carry the spelled ptr/ref-ness of the param slot (`&T`, `*T`, `**T`)
            if ty.ptrDepth > 0 {
                result.ptrDepth = result.ptrDepth + ty.ptrDepth
            }
            if ty.isRef {
                result.isRef = true
            }
            if ty.isRefMut {
                result.isRefMut = true
            }
            return result
        }
    }

    // Recurse into type args
    if ty.typeArgs.len > 0 {
        var result = ty.clone()
        for j in 0..result.typeArgs.len {
            result.typeArgs[j] = substituteMiloType(result.typeArgs[j], typeParams, typeArgs)
        }
        return result
    }

    // Function types
    if ty.isFn {
        var result = ty.clone()
        for k in 0..result.fnParams.len {
            result.fnParams[k] = substituteMiloType(result.fnParams[k], typeParams, typeArgs)
        }
        match ty.fnRet {
            Option.Some(ret) => {
                result.fnRet = Option.Some(Heap(substituteMiloType(*ret, typeParams, typeArgs)))
            }
            Option.None => {
            }
        }
        return result
    }

    return ty.clone()
}

// -- Type substitution inside monomorphized bodies --
// cloneStmts alone leaves T inside bodies (sizeOf<T>(), `x as T`, `let v: T`).
// These mirror the ast clone helpers with substituteMiloType at every
// MiloType touchpoint.

pub fn substOptType(t: &Option<MiloType>, tps: &Vec<string>, tas: &Vec<TypeKind>): Option<MiloType> {
    match t {
        Option.Some(ty) => {
            return Option.Some(substituteMiloType(ty, tps, tas))
        }
        Option.None => {
            return Option.None
        }
    }
}

pub fn substExprs(v: &Vec<Heap<ExprNode>>, tps: &Vec<string>, tas: &Vec<TypeKind>): Vec<Heap<ExprNode>> {
    var out: Vec<Heap<ExprNode>> = Vec.new()
    for i in 0..v.len {
        let n = substExpr(*v[i], tps, tas)
        copyExplicitMut((*v[i]).id, (*n).id)
        out.push(n)
    }
    return out
}

pub fn substExpr(e: &ExprNode, tps: &Vec<string>, tas: &Vec<TypeKind>): Heap<ExprNode> {
    match e.kind {
        Expr.BinOp(op, l, r) => {
            return mkExpr(Expr.BinOp(op.clone(), substExpr(*l, tps, tas), substExpr(*r, tps, tas)), cloneSpan(e.span))
        }
        Expr.UnaryOp(op, operand) => {
            return mkExpr(Expr.UnaryOp(op.clone(), substExpr(*operand, tps, tas)), cloneSpan(e.span))
        }
        Expr.Call(name, args, typeArgs) => {
            var ta2: Vec<MiloType> = Vec.new()
            for i in 0..typeArgs.len {
                ta2.push(substituteMiloType(typeArgs[i], tps, tas))
            }
            return mkExpr(Expr.Call(name.clone(), substExprs(args, tps, tas), ta2), cloneSpan(e.span))
        }
        Expr.StructLit(name, fields) => {
            // a struct literal naming a substituted type (e.g. Self's base
            // inside a generic impl) renames to the concrete instantiation
            var litName = name.clone()
            for ni in 0..tps.len {
                if tps[ni] == name {
                    litName = typeName(tas[ni])
                }
            }
            var fs: Vec<StructLitField> = Vec.new()
            for i in 0..fields.len {
                fs.push(StructLitField {
                    name: fields[i].name.clone(), value: substExpr(*fields[i].value, tps, tas)
                })
            }
            return mkExpr(Expr.StructLit(litName, fs), cloneSpan(e.span))
        }
        Expr.FieldAccess(obj, field) => {
            return mkExpr(Expr.FieldAccess(substExpr(*obj, tps, tas), field.clone()), cloneSpan(e.span))
        }
        Expr.ArrayLit(elems) => {
            return mkExpr(Expr.ArrayLit(substExprs(elems, tps, tas)), cloneSpan(e.span))
        }
        Expr.ArrayRepeat(value, count) => {
            return mkExpr(Expr.ArrayRepeat(substExpr(*value, tps, tas), count), cloneSpan(e.span))
        }
        Expr.IndexAccess(obj, index) => {
            return mkExpr(Expr.IndexAccess(substExpr(*obj, tps, tas), substExpr(*index, tps, tas)), cloneSpan(e.span))
        }
        Expr.EnumLit(enumName, variant, args) => {
            var litName = enumName.clone()
            for ni in 0..tps.len {
                if tps[ni] == enumName {
                    litName = typeName(tas[ni])
                }
            }
            return mkExpr(Expr.EnumLit(litName, variant.clone(), substExprs(args, tps, tas)), cloneSpan(e.span))
        }
        Expr.Unwrap(operand) => {
            return mkExpr(Expr.Unwrap(substExpr(*operand, tps, tas)), cloneSpan(e.span))
        }
        Expr.Propagate(operand) => {
            return mkExpr(Expr.Propagate(substExpr(*operand, tps, tas)), cloneSpan(e.span))
        }
        Expr.DefaultValue(operand, default) => {
            return mkExpr(Expr.DefaultValue(substExpr(*operand, tps, tas), substExpr(*default, tps, tas)), cloneSpan(e.span))
        }
        Expr.CastExpr(operand, targetType) => {
            return mkExpr(Expr.CastExpr(substExpr(*operand, tps, tas), substituteMiloType(targetType, tps, tas)), cloneSpan(e.span))
        }
        Expr.MethodCall(obj, method, args) => {
            return mkExpr(Expr.MethodCall(substExpr(*obj, tps, tas), method.clone(), substExprs(args, tps, tas)), cloneSpan(e.span))
        }
        Expr.Closure(params, retType, body, isMove) => {
            var ps: Vec<Param> = Vec.new()
            for i in 0..params.len {
                ps.push(Param {
                    name: params[i].name.clone(), ty: substituteMiloType(params[i].ty, tps, tas)
                })
            }
            return mkExpr(Expr.Closure(ps, substOptType(retType, tps, tas), substStmts(body, tps, tas), isMove), cloneSpan(e.span))
        }
        Expr.RangeExpr(start, end) => {
            return mkExpr(Expr.RangeExpr(substExpr(*start, tps, tas), substExpr(*end, tps, tas)), cloneSpan(e.span))
        }
        Expr.IsExpr(subject, pattern) => {
            return mkExpr(Expr.IsExpr(substExpr(*subject, tps, tas), Heap((*pattern).clone())), cloneSpan(e.span))
        }
        Expr.IfExpr(cond, thenBody, elseBody) => {
            return mkExpr(Expr.IfExpr(substExpr(*cond, tps, tas), substStmts(thenBody, tps, tas), substStmts(elseBody, tps, tas)), cloneSpan(e.span))
        }
        Expr.MatchExpr(subject, arms) => {
            var as2: Vec<MatchArm> = Vec.new()
            for i in 0..arms.len {
                as2.push(MatchArm {
                    pattern: arms[i].pattern.clone(), body: substStmts(arms[i].body, tps, tas)
                })
            }
            return mkExpr(Expr.MatchExpr(substExpr(*subject, tps, tas), as2), cloneSpan(e.span))
        }
        Expr.IntLit(v) => {
            return mkExpr(Expr.IntLit(v), cloneSpan(e.span))
        }
        Expr.FloatLit(v) => {
            return mkExpr(Expr.FloatLit(v), cloneSpan(e.span))
        }
        Expr.BoolLit(v) => {
            return mkExpr(Expr.BoolLit(v), cloneSpan(e.span))
        }
        Expr.StringLit(v) => {
            return mkExpr(Expr.StringLit(v.clone()), cloneSpan(e.span))
        }
        Expr.CharLit(v) => {
            return mkExpr(Expr.CharLit(v), cloneSpan(e.span))
        }
        Expr.Ident(name) => {
            return mkExpr(Expr.Ident(name.clone()), cloneSpan(e.span))
        }
        Expr.JsonObject(fields) => {
            var fs: Vec<StructLitField> = Vec.new()
            for i in 0..fields.len {
                fs.push(StructLitField {
                    name: fields[i].name.clone(), value: substExpr(*fields[i].value, tps, tas)
                })
            }
            return mkExpr(Expr.JsonObject(fs), cloneSpan(e.span))
        }
    }
}

pub fn substStmts(v: &Vec<Heap<Stmt>>, tps: &Vec<string>, tas: &Vec<TypeKind>): Vec<Heap<Stmt>> {
    var out: Vec<Heap<Stmt>> = Vec.new()
    for i in 0..v.len {
        out.push(Heap(substStmt(*v[i], tps, tas)))
    }
    return out
}

pub fn substOptStmts(v: &Option<Vec<Heap<Stmt>>>, tps: &Vec<string>, tas: &Vec<TypeKind>): Option<Vec<Heap<Stmt>>> {
    match v {
        Option.Some(stmts) => {
            return Option.Some(substStmts(stmts, tps, tas))
        }
        Option.None => {
            return Option.None
        }
    }
}

pub fn substStmt(s: &Stmt, tps: &Vec<string>, tas: &Vec<TypeKind>): Stmt {
    match s {
        Stmt.LetDecl(name, typeAnno, value, span) => {
            return Stmt.LetDecl(name.clone(), substOptType(typeAnno, tps, tas), substExpr(*value, tps, tas), cloneSpan(span))
        }
        Stmt.VarDecl(name, typeAnno, value, span) => {
            return Stmt.VarDecl(name.clone(), substOptType(typeAnno, tps, tas), substExpr(*value, tps, tas), cloneSpan(span))
        }
        Stmt.Assign(target, value, span) => {
            return Stmt.Assign(substExpr(*target, tps, tas), substExpr(*value, tps, tas), cloneSpan(span))
        }
        Stmt.Return(value, span) => {
            match value {
                Option.Some(e) => {
                    return Stmt.Return(Option.Some(substExpr(*e, tps, tas)), cloneSpan(span))
                }
                Option.None => {
                    return Stmt.Return(Option.None, cloneSpan(span))
                }
            }
        }
        Stmt.IfStmt(cond, thenBody, elseBody, span) => {
            return Stmt.IfStmt(substExpr(*cond, tps, tas), substStmts(thenBody, tps, tas), substOptStmts(elseBody, tps, tas), cloneSpan(span))
        }
        Stmt.WhileStmt(cond, body, span) => {
            return Stmt.WhileStmt(substExpr(*cond, tps, tas), substStmts(body, tps, tas), cloneSpan(span))
        }
        Stmt.ExprStmt(e, span) => {
            return Stmt.ExprStmt(substExpr(*e, tps, tas), cloneSpan(span))
        }
        Stmt.MatchStmt(subject, arms, span) => {
            var as2: Vec<MatchArm> = Vec.new()
            for i in 0..arms.len {
                as2.push(MatchArm {
                    pattern: arms[i].pattern.clone(), body: substStmts(arms[i].body, tps, tas)
                })
            }
            return Stmt.MatchStmt(substExpr(*subject, tps, tas), as2, cloneSpan(span))
        }
        Stmt.IfLetStmt(pattern, subject, thenBody, elseBody, span) => {
            return Stmt.IfLetStmt(Heap((*pattern).clone()), substExpr(*subject, tps, tas), substStmts(thenBody, tps, tas), substOptStmts(elseBody, tps, tas), cloneSpan(span))
        }
        Stmt.UnsafeBlock(body, span) => {
            return Stmt.UnsafeBlock(substStmts(body, tps, tas), cloneSpan(span))
        }
        Stmt.ForInStmt(varName, varName2, iterable, body, span) => {
            return Stmt.ForInStmt(varName.clone(), cloneOptString(varName2), substExpr(*iterable, tps, tas), substStmts(body, tps, tas), cloneSpan(span))
        }
        Stmt.BreakStmt(span) => {
            return Stmt.BreakStmt(cloneSpan(span))
        }
        Stmt.ContinueStmt(span) => {
            return Stmt.ContinueStmt(cloneSpan(span))
        }
    }
}

// A generic impl that registers after its type already monomorphized (impls
// land in phase 2, annotations monomorphize in phase 1) replays here.
pub fn replayImplForInsts(ck: &mut Checker, gi: &ImplDecl) {
    var ii: i64 = 0
    while ii < ck.structInsts.len {
        if ck.structInsts[ii].base == gi.typeName {
            let mangled = ck.structInsts[ii].mangled.clone()
            let typeArgs = cloneTypeArgs(ck.structInsts[ii].args)
            instantiateImpl(&mut ck, gi, mangled, typeArgs)
        }
        ii = ii + 1
    }
}

pub fn instantiateImpl(ck: &mut Checker, gi: &ImplDecl, mangled: &string, typeArgs: &Vec<TypeKind>) {
    var tps: Vec<string> = Vec.new()
    for ti in 0..gi.typeParams.len {
        tps.push(gi.typeParams[ti].name.clone())
    }
    var tas2: Vec<TypeKind> = Vec.new()
    for ti2 in 0..typeArgs.len {
        tas2.push(typeArgs[ti2].clone())
    }
    tps.push(gi.typeName.clone())
    tas2.push(TypeKind.TStruct(mangled.clone()))
    var monoMethods: Vec<Function> = Vec.new()
    for mi in 0..gi.methods.len {
        var mParams: Vec<Param> = Vec.new()
        for pi in 0..gi.methods[mi].params.len {
            mParams.push(Param {
                name: gi.methods[mi].params[pi].name.clone(),
                ty: substituteMiloType(gi.methods[mi].params[pi].ty, tps, tas2),
            })
        }
        monoMethods.push(Function {
            name: gi.methods[mi].name.clone(),
            typeParams: Vec.new(),
            params: mParams,
            retType: substituteMiloType(gi.methods[mi].retType, tps, tas2),
            body: substStmts(gi.methods[mi].body, tps, tas2),
            isExtern: false,
            isVariadic: false,
            attributes: gi.methods[mi].attributes.clone(),
        })
    }
    var cTraitName: Option<string> = Option.None
    match gi.traitName {
        Option.Some(t) => {
            cTraitName = Option.Some(t.clone())
        }
        Option.None => {
        }
    }
    let concrete = ImplDecl {
        traitName: cTraitName,
        typeName: mangled.clone(),
        typeParams: Vec.new(),
        methods: monoMethods,
        isUnsafe: gi.isUnsafe,
        span: Option.None,
    }
    registerImpl(&mut ck, concrete)
}

// -- Monomorphize a generic enum --

// `Result_P_string` displays as `Result<P, string>`. Args are rendered through
// displayText so an arg that is itself an instance is already pretty.
fn registerDisplayName(ck: &mut Checker, mangled: &string, baseName: &string, typeArgs: &Vec<TypeKind>): void {
    var args = ""
    for i in 0..typeArgs.len {
        if i > 0 {
            args = args + ", "
        }
        args = args + displayType(ck, typeArgs[i])
    }
    ck.displayNames.insert(mangled.clone(), baseName.clone() + "<" + args + ">")
}

pub fn monomorphizeEnum(ck: &mut Checker, baseName: &string, typeArgsIn: &Vec<TypeKind>): string {
    // Result<T> sugar: the error type defaults to string
    var typeArgs: Vec<TypeKind> = Vec.new()
    for ai in 0..typeArgsIn.len {
        typeArgs.push(typeArgsIn[ai].clone())
    }
    if baseName == "Result" && typeArgs.len == 1 {
        typeArgs.push(TypeKind.TString)
    }
    var mangled = baseName.clone() + "_"
    var i: i64 = 0
    while i < typeArgs.len {
        if i > 0 {
            mangled = mangled + "_"
        }
        mangled = mangled + mangleTypeName(typeArgs[i])
        i = i + 1
    }

    if ck.enums.contains(mangled) {
        return mangled
    }

    if !ck.genericEnums.contains(baseName) {
        error(&mut ck, "unknown generic enum '" + baseName.clone() + "'", Option.None)
        return mangled
    }

    let generic = ck.genericEnums.get(baseName)!

    // Build type map
    var typeMap: HashMap<string, TypeKind> = HashMap.new()
    i = 0
    while i < generic.typeParams.len && i < typeArgs.len {
        typeMap.insert(generic.typeParams[i].clone(), typeArgs[i].clone())
        i = i + 1
    }

    // Create concrete variants
    var variants: HashMap<string, VariantInfo> = HashMap.new()
    for vname, vinfo in generic.variants {
        var fields: Vec<TypeKind> = Vec.new()
        for j in 0..vinfo.fields.len {
            fields.push(substituteTypeKind(vinfo.fields[j], typeMap))
        }
        variants.insert(vname.clone(), VariantInfo {
            tag: vinfo.tag, fields: fields
        })
    }

    ck.enums.insert(mangled.clone(), EnumInfo {
        baseName: baseName.clone(), variants: variants
    })
    registerDisplayName(&mut ck, mangled, baseName, typeArgs)

    // Create monomorphized EnumDecl for codegen
    var monoVariants: Vec<EnumVariant> = Vec.new()
    for vi in 0..generic.decl.variants.len {
        let v = generic.decl.variants[vi]
        var monoFields: Vec<MiloType> = Vec.new()
        for fi in 0..v.fields.len {
            monoFields.push(substituteMiloType(v.fields[fi], generic.typeParams, typeArgs))
        }
        monoVariants.push(EnumVariant {
            name: v.name.clone(), fields: monoFields, discriminant: cloneOptI64(v.discriminant)
        })
    }
    ck.monomorphizedEnums.push(EnumDecl {
        name: mangled.clone(),
        typeParams: Vec.new(),
        variants: monoVariants,
        attributes: Vec.new(),
    })

    return mangled
}

// -- Monomorphize a generic struct --

pub fn monomorphizeStruct(ck: &mut Checker, baseName: &string, typeArgs: &Vec<TypeKind>): string {
    var mangled = baseName.clone() + "_"
    var i: i64 = 0
    while i < typeArgs.len {
        if i > 0 {
            mangled = mangled + "_"
        }
        mangled = mangled + mangleTypeName(typeArgs[i])
        i = i + 1
    }

    if ck.structs.contains(mangled) {
        return mangled
    }

    if !ck.genericStructs.contains(baseName) {
        error(&mut ck, "unknown generic struct '" + baseName.clone() + "'", Option.None)
        return mangled
    }

    let generic = ck.genericStructs.get(baseName)!

    // Build type map
    var typeMap: HashMap<string, TypeKind> = HashMap.new()
    i = 0
    while i < generic.typeParams.len && i < typeArgs.len {
        typeMap.insert(generic.typeParams[i].clone(), typeArgs[i].clone())
        i = i + 1
    }

    // Create concrete fields
    var fields: Vec<CkStructField> = Vec.new()
    // Register the (empty) mangled struct first so a field that references it
    // recursively resolves; fields are filled in below.
    ck.structs.insert(mangled.clone(), StructInfo {
        fields: Vec.new(), baseName: baseName.clone(), noCopy: hasAttr(generic.decl.attributes, "noCopy")
    })
    for fi in 0..generic.fields.len {
        // Resolve from the AST field type (which keeps `<T>`): substituteTypeKind on
        // the stored TypeKind can't recover a user-generic arg (TStruct holds only a
        // name), so `Channel<T>` would collapse to `Channel` instead of `Channel_i64`.
        var fty = substituteTypeKind(generic.fields[fi].ty, typeMap)
        if fi < generic.decl.fields.len {
            fty = resolveMonoType(&mut ck, substituteMiloType(generic.decl.fields[fi].ty, generic.typeParams, typeArgs))
        }
        fields.push(CkStructField {
            name: generic.fields[fi].name.clone(),
            ty: fty,
            iterDelegate: generic.fields[fi].iterDelegate,
        })
    }

    ck.structs.insert(mangled.clone(), StructInfo {
        fields: fields, baseName: baseName.clone(), noCopy: hasAttr(generic.decl.attributes, "noCopy")
    })
    registerDisplayName(&mut ck, mangled, baseName, typeArgs)

    // Create monomorphized StructDecl
    var monoFields: Vec<StructField> = Vec.new()
    for si in 0..generic.decl.fields.len {
        var fieldAttrs: Vec<Attribute> = Vec.new()
        for ai in 0..generic.decl.fields[si].attributes.len {
            fieldAttrs.push(generic.decl.fields[si].attributes[ai].clone())
        }
        monoFields.push(StructField {
            name: generic.decl.fields[si].name.clone(),
            ty: substituteMiloType(generic.decl.fields[si].ty, generic.typeParams, typeArgs),
            attributes: fieldAttrs,
        })
    }
    let monoDecl = StructDecl {
        name: mangled.clone(),
        typeParams: Vec.new(),
        fields: monoFields,
        attributes: Vec.new(),
    }
    ck.monomorphizedStructs.push(monoDecl.clone())

    ck.structInsts.push(StructInst {
        base: baseName.clone(), mangled: mangled.clone(), args: cloneTypeArgs(typeArgs)
    })

    // @derive(Json) on a generic struct has to be resynthesized per
    // monomorphization (Box<T> -> Box_i64): the derive body is field-by-field
    // Milo source keyed to concrete types, and processDerives skips generic
    // decls entirely (it runs before any instantiation exists to derive for).
    for gdi in 0..generic.decl.attributes.len {
        if generic.decl.attributes[gdi].name == "derive" {
            for gdk in 0..generic.decl.attributes[gdi].args.len {
                if generic.decl.attributes[gdi].args[gdk] == "Json" {
                    ck.jsonCapableStructs.insert(mangled.clone(), true)
                    match deriveJson(&mut ck, monoDecl) {
                        Option.Some(decl) => {
                            registerImpl(&mut ck, decl)
                        }
                        Option.None => {
                        }
                    }
                }
            }
        }
    }

    // Instantiate any parked generic impls for this type
    var gii: i64 = 0
    while gii < ck.genericImpls.len {
        if ck.genericImpls[gii].typeName == baseName {
            let gi = ck.genericImpls[gii].clone()
            instantiateImpl(&mut ck, gi, mangled, typeArgs)
        }
        gii = gii + 1
    }

    return mangled
}

// -- Monomorphize a generic function --

// Resolve a MiloType to its monomorphized TypeKind, KEEPING user-generic type
// args (Arena<Node> → TStruct("Arena_Node")) that typeFromAst flattens away.
pub fn resolveMonoType(ck: &mut Checker, ty: &MiloType): TypeKind {
    if ty.typeArgs.len > 0 && !ty.isFn {
        var base = tyUnknown()
        var isGeneric = false
        // Builtin containers must still recurse through resolveMonoType (not
        // typeFromAst) on their element types, or a user generic nested inside
        // one (Vec<Handle<T>>) never gets monomorphized: typeFromAst has no
        // knowledge of genericStructs/genericEnums and just returns the raw
        // unmangled base name (TStruct("Handle")) instead of Handle_string.
        if ty.name == "Vec" && ty.typeArgs.len == 1 {
            base = TypeKind.TVec(Heap(resolveMonoType(&mut ck, ty.typeArgs[0])))
            isGeneric = true
        } else if ty.name == "Heap" && ty.typeArgs.len == 1 {
            base = TypeKind.THeap(Heap(resolveMonoType(&mut ck, ty.typeArgs[0])))
            isGeneric = true
        } else if ty.name == "HashMap" && ty.typeArgs.len == 2 {
            base = TypeKind.THashMap(Heap(resolveMonoType(&mut ck, ty.typeArgs[0])), Heap(resolveMonoType(&mut ck, ty.typeArgs[1])))
            isGeneric = true
        } else if ck.genericEnums.contains(ty.name) {
            var targs: Vec<TypeKind> = Vec.new()
            for i in 0..ty.typeArgs.len {
                targs.push(resolveMonoType(&mut ck, ty.typeArgs[i]))
            }
            base = TypeKind.TEnum(monomorphizeEnum(&mut ck, ty.name, targs))
            isGeneric = true
        } else if ck.genericStructs.contains(ty.name) {
            var targs: Vec<TypeKind> = Vec.new()
            for i in 0..ty.typeArgs.len {
                targs.push(resolveMonoType(&mut ck, ty.typeArgs[i]))
            }
            base = TypeKind.TStruct(monomorphizeStruct(&mut ck, ty.name, targs))
            isGeneric = true
        }
        if isGeneric {
            if ty.isRef {
                return TypeKind.TRef(Heap(base), false)
            }
            if ty.isRefMut {
                return TypeKind.TRef(Heap(base), true)
            }
            if ty.ptrDepth > 0 {
                var i: i32 = 0
                while i < ty.ptrDepth {
                    base = TypeKind.TPtr(Heap(base))
                    i = i + 1
                }
                return base
            }
            return base
        }
    }
    // A function type carries types in its params and its return, and the guard at the
    // top of this function skips it (`!ty.isFn`), so none of them were ever monomorphized:
    // `f: (Shard<T>) => Shard<T>` inside a monomorphized fn kept the raw base name and
    // calling `f(w)` reported "expected Shard, got Shard_u32". typeFromAst cannot do it —
    // it has no knowledge of genericStructs and drops type arguments outright.
    if ty.isFn {
        var mparams: Vec<TypeKind> = Vec.new()
        for pi in 0..ty.fnParams.len {
            mparams.push(resolveMonoType(&mut ck, ty.fnParams[pi]))
        }
        var mret = tyVoid()
        match ty.fnRet {
            Option.Some(r) => {
                mret = resolveMonoType(&mut ck, *r)
            }
            Option.None => {
            }
        }
        return TypeKind.TFn(mparams, Heap(mret))
    }
    // normalize so a bare enum name (NodeKind) becomes TEnum, not the uppercase
    // TStruct fallback — otherwise Option<NodeKind>'s payload mismatches the enum.
    return normalizeEnumNames(ck, typeFromAst(ty))
}

pub fn monomorphizeFn(ck: &mut Checker, baseName: &string, typeArgs: &Vec<TypeKind>): string {
    var mangled = baseName.clone() + "_"
    var i: i64 = 0
    while i < typeArgs.len {
        if i > 0 {
            mangled = mangled + "_"
        }
        mangled = mangled + mangleTypeName(typeArgs[i])
        i = i + 1
    }

    if ck.functions.contains(mangled) {
        return mangled
    }

    if !ck.genericFns.contains(baseName) {
        error(&mut ck, "unknown generic function '" + baseName.clone() + "'", Option.None)
        return mangled
    }

    let generic = ck.genericFns.get(baseName)!

    // Register the concrete signature first (allow recursive calls)
    var params: Vec<FnParam> = Vec.new()
    for pi in 0..generic.decl.params.len {
        let subType = substituteMiloType(generic.decl.params[pi].ty, generic.typeParams, typeArgs)
        params.push(FnParam {
            name: generic.decl.params[pi].name.clone(),
            ty: resolveMonoType(&mut ck, subType),
        })
    }
    let subRetType = substituteMiloType(generic.decl.retType, generic.typeParams, typeArgs)
    let ret = resolveMonoType(&mut ck, subRetType)
    ck.functions.insert(mangled.clone(), FnSig {
        params: params,
        ret: ret,
        variadic: false,
        isExtern: false,
    })

    // Create concrete function declaration
    var monoParams: Vec<Param> = Vec.new()
    for pi in 0..generic.decl.params.len {
        monoParams.push(Param {
            name: generic.decl.params[pi].name.clone(),
            ty: substituteMiloType(generic.decl.params[pi].ty, generic.typeParams, typeArgs),
        })
    }

    let concreteDecl = Function {
        name: mangled.clone(),
        typeParams: Vec.new(),
        params: monoParams,
        retType: subRetType,
        body: substStmts(generic.decl.body, generic.typeParams, typeArgs),
        isExtern: false,
        isVariadic: false,
        attributes: generic.decl.attributes.clone(),
    }
    ck.monomorphizedFns.push(concreteDecl)

    return mangled
}

// -- Register generic declarations --

pub fn registerGenericFn(ck: &mut Checker, f: &Function) {
    var typeParams: Vec<string> = Vec.new()
    for i in 0..f.typeParams.len {
        typeParams.push(f.typeParams[i].name.clone())
    }
    ck.genericFns.insert(f.name.clone(), GenericFnInfo {
        typeParams: typeParams,
        decl: f.clone(),
    })
}

pub fn registerGenericStruct(ck: &mut Checker, s: &StructDecl) {
    var typeParams: Vec<string> = Vec.new()
    for i in 0..s.typeParams.len {
        typeParams.push(s.typeParams[i].name.clone())
    }
    var fields: Vec<CkStructField> = Vec.new()
    for j in 0..s.fields.len {
        fields.push(CkStructField {
            name: s.fields[j].name.clone(),
            ty: typeFromAst(s.fields[j].ty),
            iterDelegate: hasAttr(s.fields[j].attributes, "iter"),
        })
    }
    ck.genericStructs.insert(s.name.clone(), GenericStructInfo {
        typeParams: typeParams,
        decl: s.clone(),
        fields: fields,
    })
}

pub fn registerGenericEnum(ck: &mut Checker, e: &EnumDecl) {
    var typeParams: Vec<string> = Vec.new()
    for i in 0..e.typeParams.len {
        typeParams.push(e.typeParams[i].name.clone())
    }
    var variants: HashMap<string, VariantInfo> = HashMap.new()
    var nextTag: i64 = 0
    for vi in 0..e.variants.len {
        var fields: Vec<TypeKind> = Vec.new()
        for fi in 0..e.variants[vi].fields.len {
            fields.push(typeFromAst(e.variants[vi].fields[fi]))
        }
        match e.variants[vi].discriminant {
            Option.Some(d) => {
                nextTag = d
            }
            Option.None => {
            }
        }
        variants.insert(e.variants[vi].name.clone(), VariantInfo {
            tag: nextTag as i32, fields: fields
        })
        nextTag = nextTag + 1
    }
    ck.genericEnums.insert(e.name.clone(), GenericEnumInfo {
        typeParams: typeParams,
        decl: e.clone(),
        variants: variants,
    })
}
