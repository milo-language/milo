// Statement type checking
from "src-milo/ast.milo" import {
    Stmt, Expr, MiloType, Span, MatchArm, Pattern, Param, Function, Program,
    EnumDecl, EnumVariant, TypeParam, simpleType,
}
from "src-milo/checker/types.milo" import {
    TypeKind, typeEq, typeName, typeFromAst, typeFromName,
    tyI32, tyI64, tyU8, tyBool, tyVoid, tyString, tyUnknown,
    isNumeric, isInteger, isFloat, isCopy, needsDrop, containsUnknown, isViewReturnType,
}
from "src-milo/checker/state.milo" import {
    Checker, VarInfo, FnSig, FnParam, StructInfo, EnumInfo, VariantInfo, ForInKind, ForInInfo, forInInfo,
    Diagnostic, error, errorHint, warn, pushScope, popScope, declare, lookup, setVarMoved, setVarRead, hasErrors,
    normalizeEnumNames, stmtTerminates, snapshotMoves, restoreMoves, orMoves, nestedRef, hasAttr, MoveSnapshot,
}
from "src-milo/checker/expr.milo" import {
    intCoercible, floatLitCoercible, arrayIntCoercible, arrayToVecCoercible, checkExpr, tryMove, isRootMutable, deref,
    errorIfMovingBorrowedNonCopy, enforceRangeInto,
}
from "src-milo/checker/traits.milo" import {
    registerBuiltinTraits, registerAllImpls, synthesizeDefaultMethods, processDerives, typeImplementsTrait, resolveMethod
}
from "src-milo/checker/mono.milo" import {
    registerGenericFn, registerGenericStruct, registerGenericEnum, monomorphizeFn, monomorphizeStruct, monomorphizeEnum
}
from "src-milo/checker/borrow.milo" import {
    accessPath, rootIdentName, freezeName, unfreezeName, isFrozen, frozenAgainst,
    freezePlace, freezeViewMethodSource, errorIfFrozenRoot, describePlace,
    assignTargetPath, errorIfAssignFrozen, borrowDuringCallback, BorrowArg,
    borrowArgOf, checkCallSiteExclusivity, snapshotFrozenNames, releaseOrRetainFreezes,
}
from "src-milo/checker/moves.milo" import {
    staticFieldPlace, clearMovedFields, fieldPathString,
}

// -- Statement checker --

pub fn checkStmt(ck: &mut Checker, stmt: &Stmt, fnRetType: &TypeKind) {
    match stmt {
        Stmt.LetDecl(name, typeAnno, value, span) => {
            checkLetDecl(&mut ck, name, typeAnno, *value, false, span)
        }
        Stmt.VarDecl(name, typeAnno, value, span) => {
            checkLetDecl(&mut ck, name, typeAnno, *value, true, span)
        }
        Stmt.Assign(target, value, span) => {
            checkAssign(&mut ck, *target, *value, span)
        }
        Stmt.Return(value, span) => {
            checkReturn(&mut ck, value, fnRetType, span)
        }
        Stmt.IfStmt(cond, thenBody, elseBody, span) => {
            checkIf(&mut ck, *cond, thenBody, elseBody, fnRetType, span)
        }
        Stmt.WhileStmt(cond, body, span) => {
            checkWhile(&mut ck, *cond, body, fnRetType, span)
        }
        Stmt.ExprStmt(expr, span) => {
            // A view produced by a discarded expression (`print(lx.word(0, 5))`)
            // has no binding to outlive the statement, so its freeze must not
            // survive it either — same reasoning as the RHS snapshot in
            // checkAssign/checkLetDecl, which this mirrors.
            let frozenBefore = snapshotFrozenNames(ck)
            checkExpr(&mut ck, *expr)
            releaseOrRetainFreezes(&mut ck, frozenBefore, false)
        }
        Stmt.MatchStmt(subject, arms, span) => {
            checkMatch(&mut ck, *subject, arms, fnRetType)
        }
        Stmt.BreakStmt(span) => {
            if ck.loopDepth == 0 {
                error(&mut ck, "'break' outside of loop", cloneSpan(span))
            }
        }
        Stmt.ContinueStmt(span) => {
            if ck.loopDepth == 0 {
                error(&mut ck, "'continue' outside of loop", cloneSpan(span))
            }
        }
        Stmt.IfLetStmt(pattern, expr, thenBody, elseBody, span) => {
            checkIfLet(&mut ck, *pattern, *expr, thenBody, elseBody, fnRetType)
        }
        Stmt.UnsafeBlock(body, span) => {
            ck.unsafeDepth = ck.unsafeDepth + 1
            pushScope(&mut ck)
            for i in 0..body.len {
                checkStmt(&mut ck, *body[i], fnRetType)
            }
            popScope(&mut ck)
            ck.unsafeDepth = ck.unsafeDepth - 1
        }
        Stmt.ForInStmt(varName, varName2, iterable, body, span) => {
            checkForIn(&mut ck, varName, varName2, *iterable, body, fnRetType, span)
        }
    }
}

// -- Let/Var declarations --

pub fn checkLetDecl(ck: &mut Checker, name: &string, typeAnno: &Option<MiloType>, value: &ExprNode, mutable: bool, span: &Option<Span>) {
    // Resolve the annotation first and expose it as the expected type, so a
    // generic call whose type params aren't determined by args can infer from it
    // (`let a: Arena<X> = arenaNew()`).
    var hasHint = false
    var hint = tyUnknown()
    match typeAnno {
        Option.Some(ty) => {
            hint = resolveAstType(&mut ck, ty)
            hasHint = true
        }
        Option.None => {
        }
    }
    // A reference stored inside a local collection (Vec<&T> etc) outlives
    // whatever freeze the call site took for it — a bare `&T` local is fine
    // (second-class, can't escape the function), but nothing marks a
    // CONTAINER as borrowed the way a plain reference binding is.
    if hasHint && nestedRef(ck, hint) {
        error(&mut ck, "'" + name.clone() + "': references cannot be stored in a collection", cloneSpan(span))
    }
    if hasHint {
        ck.expectedType = Option.Some(hint.clone())
    }
    // A borrow taken to compute the RHS (`s[0..n]`, `lx.word(...)`) is eager —
    // freezePlace/freezeViewMethodSource fire on every slice/view-method check,
    // not just ones that land in a binding. Snapshot what's already frozen so
    // only what THIS statement newly froze is in scope for the keep/release
    // decision below.
    let frozenBefore = snapshotFrozenNames(ck)
    var valType = checkExpr(&mut ck, value)
    ck.expectedType = Option.None

    if hasHint {
        if !typeEq(hint, valType) && !typeEq(valType, tyUnknown()) && !intCoercible(hint, valType, value) &&
        !floatLitCoercible(hint, valType, value) &&
        !arrayIntCoercible(hint, valType) && !arrayToVecCoercible(hint, valType) &&
        !optionIntWrapCoercible(ck, hint, valType) && !interfaceCoercible(ck, hint, valType) {
            error(&mut ck, "type mismatch: '" + name.clone() + "' declared as " + typeName(hint) + " but got " + typeName(valType), cloneSpan(span))
        }
        enforceRangeInto(&mut ck, value, hint, span)
        valType = hint
        // Re-record the initializer node's type as the DECLARED one. Lowering keys
        // HStmt.Let's type off this node, and checkExpr answers a bare `5` with i64 no
        // matter what is expected of it — so `let c: i32 = 5` would otherwise hand the
        // backend an i64 and size the binding's slot wrong.
        ck.exprTypes.insert(value.id, valType.clone())
    }

    // A view-typed binding (`let view = s[0..5]`) keeps whatever it froze
    // alive for its own scope's life; anything else (the borrow was fully
    // consumed within this statement, e.g. `s[0..n].len`) releases now.
    var isRefBinding = false
    match valType.clone() {
        TypeKind.TRef(vinner, vmut) => {
            isRefBinding = true
        }
        _ => {
        }
    }
    releaseOrRetainFreezes(&mut ck, frozenBefore, isRefBinding)

    declare(&mut ck, name.clone(), VarInfo {
        ty: valType,
        mutable: mutable,
        moved: false,
        borrowed: false,
        read: false,
        span: cloneSpan(span),
    })
    // An unannotated `Vec.new()` has no element type yet. Record it so that never
    // acquiring one is reported, instead of leaving a Vec whose element is unknown to
    // flow onward and fail somewhere unrelated.
    if !hasHint {
        match value.kind {
            Expr.EnumLit(en, vr, eargs) => {
                if en == "Vec" && (vr == "new" || vr == "withCapacity") {
                    ck.pendingVecInfer.push(PendingVecInfer {
                        name: name.clone(), span: cloneSpan(span),
                    })
                }
            }
            _ => {
            }
        }
    }
    tryMove(&mut ck, value)
}

// -- Assignment --

pub fn checkAssign(ck: &mut Checker, target: &ExprNode, value: &ExprNode, span: &Option<Span>) {
    if !isRootMutable(ck, target) {
        error(&mut ck, "cannot assign to immutable variable", cloneSpan(span))
        return
    }
    // Whole-place assignment (`x = ...`, `x.f = ...`) drops the old value and
    // frees its buffer, so a live view into it would dangle. An in-place
    // element write (`v[i] = x`) is exempt — see errorIfAssignFrozen.
    errorIfAssignFrozen(&mut ck, target, span)

    // A plain `x = ...` target is written, not read. Routing it through checkExpr
    // would hit checkIdent's use-after-move check and report "use of moved
    // variable 'x'" for the very statement that un-moves it.
    // Two views of the target's type. `targetType` is dereferenced so writing
    // *through* a `&mut T` param compares against T. `targetDeclType` keeps the
    // wrapper, because a var can also legitimately HOLD a `&T` — a string/slice
    // view (`var v = s[0..5]`) is rebindable to another view of the same type, and
    // deref alone would report "cannot assign &string to string" on `v = s[6..11]`.
    var targetType = tyUnknown()
    var targetDeclType = tyUnknown()
    match target.kind {
        Expr.Ident(name) => {
            match lookup(ck, name) {
                Option.Some(v) => {
                    targetType = deref(v.ty)
                    targetDeclType = v.ty.clone()
                }
                Option.None => {
                    error(&mut ck, "undefined variable '" + name.clone() + "'", cloneSpan(span))
                }
            }
        }
        _ => {
            // A field target (`p.a = ...`) is written, not read, same reasoning as
            // the Ident case above — the field about to be overwritten doesn't care
            // whether it was already moved. checkFieldMoveState reads this depth to
            // suppress its "use of moved value" check for exactly this walk.
            ck.inAssignTargetDepth = ck.inAssignTargetDepth + 1
            targetType = checkExpr(&mut ck, target)
            ck.inAssignTargetDepth = ck.inAssignTargetDepth - 1
            targetDeclType = targetType.clone()
        }
    }
    // Expose the target's type as the hint so an array literal RHS (`v = [a, b]`)
    // coerces to Vec<T> when the target is one, same as let/var and struct fields.
    ck.expectedType = Option.Some(targetType.clone())
    // A borrow the RHS takes to compute its value (`s[0..n].clone()`) is
    // consumed within this statement — no binding outlives it — so it must
    // not leak a freeze onto the next statement.
    let frozenBeforeRhs = snapshotFrozenNames(ck)
    let valType = checkExpr(&mut ck, value)
    ck.expectedType = Option.None
    releaseOrRetainFreezes(&mut ck, frozenBeforeRhs, false)
    if !typeEq(targetDeclType, valType) &&
    !typeEq(targetType, valType) && !typeEq(valType, tyUnknown()) && !intCoercible(targetType, valType, value) &&
    !arrayToVecCoercible(targetType, valType) && !floatLitCoercible(targetType, valType, value) &&
    !optionIntWrapCoercible(ck, targetType, valType) {
        error(&mut ck, "type mismatch: cannot assign " + typeName(valType) + " to " + typeName(targetType), cloneSpan(span))
    }
    enforceRangeInto(&mut ck, value, targetType, span)

    // Re-assigning un-moves the variable — or, for a field target, un-moves just
    // that place and anything nested under it (a different field was never
    // touched by this write).
    match target.kind {
        Expr.Ident(name) => {
            setVarMoved(&mut ck, name, false)
        }
        _ => {
            match staticFieldPlace(target) {
                Option.Some(p) => {
                    clearMovedFields(&mut ck, p.root, Option.Some(fieldPathString(p.fields)))
                }
                Option.None => {
                }
            }
        }
    }
    tryMove(&mut ck, value)
}

// -- Return --

pub fn checkReturn(ck: &mut Checker, value: &Option<Heap<ExprNode>>, fnRetType: &TypeKind, span: &Option<Span>) {
    match value {
        Option.Some(expr) => {
            ck.inReturn = true
            // expose the declared return type so a bare generic struct/enum literal
            // (`return HashSet { … }` in setNew<T>) resolves to the right instance
            if !typeEq(fnRetType, tyUnknown()) {
                ck.expectedType = Option.Some(fnRetType.clone())
            }
            // A borrow taken to compute the return value (`self.data[0..n]`
            // inside a view-returning method) is consumed within this
            // statement — the function exits, nothing after can observe it —
            // so it must not leak past this check. Unlike moved-state this
            // side table isn't per-call-instance, so an unreleased freeze here
            // would otherwise survive into the NEXT function checked that
            // happens to reuse the same local/param name (e.g. every method's
            // "self").
            let frozenBeforeReturn = snapshotFrozenNames(ck)
            let valType = checkExpr(&mut ck, *expr)
            releaseOrRetainFreezes(&mut ck, frozenBeforeReturn, false)
            ck.expectedType = Option.None
            ck.inReturn = false
            // inside an unannotated closure (fnRetType unknown) this Return's type
            // is the inferred closure return type.
            if typeEq(fnRetType, tyUnknown()) {
                ck.pendingClosureRet = Option.Some(valType.clone())
            }
            if !typeEq(fnRetType, valType) && !typeEq(valType, tyUnknown()) && !typeEq(fnRetType, tyUnknown())
            && !intCoercible(fnRetType, valType, *expr) && !floatLitCoercible(fnRetType, valType, *expr) && !interfaceCoercible(ck, fnRetType, valType) {
                error(&mut ck, "return type mismatch: expected " + typeName(fnRetType) + ", got " + typeName(valType), cloneSpan(span))
            }
            enforceRangeInto(&mut ck, *expr, fnRetType, span)
            // Deliberately no tryMove here: this checker is flow-insensitive, so
            // marking the returned variable moved poisons every later use of it
            // (`if cond { return result }` ... `result.push(x)`), which is exactly
            // what the TS checker's returnOnlyMoves bookkeeping exists to avoid.
            // The function exits, so nothing after can observe the move.
            // The borrowed-value-escape check is still needed though — a `&T` loop
            // variable (e.g. `for line in s.lines()`) is second-class and lives only
            // inside the loop that borrowed it; unlike ordinary move tracking this
            // only reports, it never marks anything moved, so it can't poison later
            // reads the same way.
            errorIfMovingBorrowedNonCopy(&mut ck, *expr, span)
        }
        Option.None => {
            if !typeEq(fnRetType, tyVoid()) {
                error(&mut ck, "return without value in function returning " + typeName(fnRetType), cloneSpan(span))
            }
        }
    }
}

// -- If statement --

pub fn checkIf(ck: &mut Checker, cond: &ExprNode, thenBody: &Vec<Heap<Stmt>>, elseBody: &Option<Vec<Heap<Stmt>>>, fnRetType: &TypeKind, span: &Option<Span>) {
    // A borrow taken to compute the condition (`s.slice(0,1).len > 0`) is
    // consumed evaluating the bool — no binding outlives it — so it must not
    // leak into the branches, let alone past this whole statement.
    let frozenBeforeCond = snapshotFrozenNames(ck)
    let condType = checkExpr(&mut ck, cond)
    releaseOrRetainFreezes(&mut ck, frozenBeforeCond, false)
    if !typeEq(condType, tyBool()) && !typeEq(condType, tyUnknown()) {
        error(&mut ck, "if condition must be bool, got " + typeName(condType), cloneSpan(span))
    }

    // Branches are checked in isolation from the pre-state (a sibling arm
    // must not see this arm's moves), then joined: any-path moves survive,
    // except from branches that terminate (break/continue/return).
    let preSnap = snapshotMoves(ck)
    pushScope(&mut ck)
    for i in 0..thenBody.len {
        checkStmt(&mut ck, *thenBody[i], fnRetType)
    }
    popScope(&mut ck)
    var thenTerm = false
    if thenBody.len > 0 {
        thenTerm = stmtTerminates(*thenBody[thenBody.len - 1])
    }
    let afterThen = snapshotMoves(ck)
    restoreMoves(&mut ck, preSnap)

    match elseBody {
        Option.Some(body) => {
            pushScope(&mut ck)
            for j in 0..body.len {
                checkStmt(&mut ck, *body[j], fnRetType)
            }
            popScope(&mut ck)
            var elseTerm = false
            if body.len > 0 {
                elseTerm = stmtTerminates(*body[body.len - 1])
            }
            if elseTerm {
                restoreMoves(&mut ck, preSnap)
            }
        }
        Option.None => {
        }
    }
    if !thenTerm {
        orMoves(&mut ck, afterThen)
    }
}

// -- While statement --

pub fn checkWhile(ck: &mut Checker, cond: &ExprNode, body: &Vec<Heap<Stmt>>, fnRetType: &TypeKind, span: &Option<Span>) {
    // Same reasoning as checkIf's condition: a borrow taken to compute a
    // `while` condition is re-evaluated fresh each iteration at runtime, so
    // nothing should carry it forward past this one static check either.
    let frozenBeforeCond = snapshotFrozenNames(ck)
    let condType = checkExpr(&mut ck, cond)
    releaseOrRetainFreezes(&mut ck, frozenBeforeCond, false)
    if !typeEq(condType, tyBool()) && !typeEq(condType, tyUnknown()) {
        error(&mut ck, "while condition must be bool, got " + typeName(condType), cloneSpan(span))
    }

    pushScope(&mut ck)
    ck.loopDepth = ck.loopDepth + 1
    for i in 0..body.len {
        checkStmt(&mut ck, *body[i], fnRetType)
    }
    ck.loopDepth = ck.loopDepth - 1
    popScope(&mut ck)
}

// -- Match statement --

pub fn checkMatch(ck: &mut Checker, subject: &ExprNode, arms: &Vec<MatchArm>, fnRetType: &TypeKind) {
    // Same reasoning as checkIf's condition — a borrow taken to compute the
    // subject must not leak past this statement.
    let frozenBeforeSubj = snapshotFrozenNames(ck)
    let subjType = checkExpr(&mut ck, subject)
    releaseOrRetainFreezes(&mut ck, frozenBeforeSubj, false)

    // Arms are mutually exclusive: each checks from the pre-state, then the
    // join keeps any-path moves (terminated arms drop out) — same rules as
    // if/else branches.
    let preSnap = snapshotMoves(ck)
    var armSnaps: Vec<MoveSnapshot> = Vec.new()
    var armTerms: Vec<bool> = Vec.new()
    for i in 0..arms.len {
        restoreMoves(&mut ck, preSnap)
        checkMatchArm(&mut ck, arms[i], subjType, fnRetType)
        armSnaps.push(snapshotMoves(ck))
        var term = false
        if arms[i].body.len > 0 {
            term = stmtTerminates(*arms[i].body[arms[i].body.len - 1])
        }
        armTerms.push(term)
    }
    restoreMoves(&mut ck, preSnap)
    for i in 0..armSnaps.len {
        if !armTerms[i] {
            orMoves(&mut ck, armSnaps[i])
        }
    }
}

pub fn checkMatchArm(ck: &mut Checker, arm: &MatchArm, subjType: &TypeKind, fnRetType: &TypeKind) {
    pushScope(&mut ck)

    // Bind pattern variables into scope
    match arm.pattern {
        Pattern.EnumPattern(enumName, variant, bindings, pspan) => {
            match subjType {
                TypeKind.TEnum(name) => {
                    if ck.enums.contains(name) {
                        let enumInfo = ck.enums.get(name)!
                        if enumInfo.variants.contains(variant) {
                            let variantInfo = enumInfo.variants.get(variant)!
                            // Binding-count mismatch used to bind silently up to
                            // min(bindings.len, fields.len) with no diagnostic — an
                            // extra binding stayed undeclared and use of it later
                            // read as "undefined variable" (or, in the if-let sibling
                            // below, reached codegen and indexed the payload array
                            // out of bounds). Report it here, same as the oracle,
                            // then keep the min-length bind so the rest of the arm
                            // still type-checks against real slots.
                            if bindings.len != variantInfo.fields.len {
                                error(&mut ck, "variant '" + variant.clone() + "' has " + variantInfo.fields.len.toString() + " fields, but pattern has " + bindings.len.toString() + " bindings", cloneSpan(pspan))
                            }
                            var k: i64 = 0
                            while k < bindings.len && k < variantInfo.fields.len {
                                if bindings[k] != "_" {
                                    declare(&mut ck, bindings[k].clone(), VarInfo {
                                        ty: variantInfo.fields[k].clone(),
                                        mutable: false,
                                        moved: false,
                                        borrowed: false,
                                        read: false,
                                        span: cloneSpan(pspan),
                                    })
                                }
                                k = k + 1
                            }
                        } else {
                            error(&mut ck, "enum '" + name.clone() + "' has no variant '" + variant.clone() + "'", cloneSpan(pspan))
                        }
                    }
                }
                _ => {
                    error(&mut ck, "cannot use enum pattern when matching on " + typeName(subjType), cloneSpan(pspan))
                }
            }
        }
        Pattern.LiteralPattern(value, kind, pspan) => {
        }
        Pattern.WildcardPattern(pspan) => {
        }
    }

    // Check arm body
    for j in 0..arm.body.len {
        checkStmt(&mut ck, *arm.body[j], fnRetType)
    }

    popScope(&mut ck)
}

// -- Match expression --

pub struct MatchArmCheck {
    produced: bool,
    ty: TypeKind,
}

// Like checkMatchArm, but the arm's LAST statement is the arm's value rather
// than an ordinary statement: a bare ExprStmt supplies it, a diverging stmt
// (return/break/continue) supplies none (the arm never reaches the join), and
// anything else is a real error — no silent "treat as void" fallback.
pub fn checkMatchArmValue(ck: &mut Checker, arm: &MatchArm, subjType: &TypeKind, fnRetType: &TypeKind, span: &Option<Span>): MatchArmCheck {
    pushScope(&mut ck)

    match arm.pattern {
        Pattern.EnumPattern(enumName, variant, bindings, pspan) => {
            match subjType {
                TypeKind.TEnum(name) => {
                    if ck.enums.contains(name) {
                        let enumInfo = ck.enums.get(name)!
                        if enumInfo.variants.contains(variant) {
                            let variantInfo = enumInfo.variants.get(variant)!
                            if bindings.len != variantInfo.fields.len {
                                error(&mut ck, "variant '" + variant.clone() + "' has " + variantInfo.fields.len.toString() + " fields, but pattern has " + bindings.len.toString() + " bindings", cloneSpan(pspan))
                            }
                            var k: i64 = 0
                            while k < bindings.len && k < variantInfo.fields.len {
                                if bindings[k] != "_" {
                                    declare(&mut ck, bindings[k].clone(), VarInfo {
                                        ty: variantInfo.fields[k].clone(),
                                        mutable: false,
                                        moved: false,
                                        borrowed: false,
                                        read: false,
                                        span: cloneSpan(pspan),
                                    })
                                }
                                k = k + 1
                            }
                        } else {
                            error(&mut ck, "enum '" + name.clone() + "' has no variant '" + variant.clone() + "'", cloneSpan(pspan))
                        }
                    }
                }
                _ => {
                    error(&mut ck, "cannot use enum pattern when matching on " + typeName(subjType), cloneSpan(pspan))
                }
            }
        }
        Pattern.LiteralPattern(value, kind, pspan) => {
        }
        Pattern.WildcardPattern(pspan) => {
        }
    }

    var result = MatchArmCheck {
        produced: false, ty: tyUnknown()
    }
    var i: i64 = 0
    while i < arm.body.len {
        let isLast = i == arm.body.len - 1
        if isLast {
            match *arm.body[i] {
                Stmt.ExprStmt(e, espan) => {
                    result = MatchArmCheck {
                        produced: true, ty: checkExpr(&mut ck, *e)
                    }
                }
                _ => {
                    if stmtTerminates(*arm.body[i]) {
                        checkStmt(&mut ck, *arm.body[i], fnRetType)
                    } else {
                        error(&mut ck, "match-expression arm must end in a value or return/break/continue", cloneSpan(span))
                        checkStmt(&mut ck, *arm.body[i], fnRetType)
                    }
                }
            }
        } else {
            checkStmt(&mut ck, *arm.body[i], fnRetType)
        }
        i = i + 1
    }

    popScope(&mut ck)
    return result
}

// match in expression position. Reuses statement-match's per-arm move
// snapshot/join (an arm that diverges must not poison post-match moves), but
// additionally unifies each producing arm's value type — same rule as
// if-expression branches, with the same const-int coercion.
pub fn checkMatchExpr(ck: &mut Checker, subject: &ExprNode, arms: &Vec<MatchArm>, fnRetType: &TypeKind, span: &Option<Span>): TypeKind {
    let subjType = checkExpr(&mut ck, subject)

    let preSnap = snapshotMoves(ck)
    var armSnaps: Vec<MoveSnapshot> = Vec.new()
    var armTerms: Vec<bool> = Vec.new()
    var resultTy = tyUnknown()
    var haveResult = false
    for i in 0..arms.len {
        restoreMoves(&mut ck, preSnap)
        let res = checkMatchArmValue(&mut ck, arms[i], subjType, fnRetType, span)
        armSnaps.push(snapshotMoves(ck))
        var term = false
        if arms[i].body.len > 0 {
            term = stmtTerminates(*arms[i].body[arms[i].body.len - 1])
        }
        armTerms.push(term)
        if res.produced {
            if !haveResult {
                resultTy = res.ty
                haveResult = true
            } else if !typeEq(resultTy, res.ty) && !containsUnknown(resultTy) && !containsUnknown(res.ty) {
                error(&mut ck, "match-expression arms disagree: " + typeName(resultTy) + " vs " + typeName(res.ty), cloneSpan(span))
            }
        }
    }
    restoreMoves(&mut ck, preSnap)
    for i in 0..armSnaps.len {
        if !armTerms[i] {
            orMoves(&mut ck, armSnaps[i])
        }
    }
    return resultTy
}

// -- If-let statement --

pub fn checkIfLet(ck: &mut Checker, pattern: &Pattern, expr: &ExprNode, thenBody: &Vec<Heap<Stmt>>, elseBody: &Option<Vec<Heap<Stmt>>>, fnRetType: &TypeKind) {
    // Same reasoning as checkIf's condition — a borrow taken to compute the
    // scrutinee must not leak past this statement.
    let frozenBeforeScrutinee = snapshotFrozenNames(ck)
    let exprType = checkExpr(&mut ck, expr)
    releaseOrRetainFreezes(&mut ck, frozenBeforeScrutinee, false)

    pushScope(&mut ck)

    // Bind pattern variables
    match pattern {
        Pattern.EnumPattern(enumName, variant, bindings, pspan) => {
            match exprType {
                TypeKind.TEnum(name) => {
                    if ck.enums.contains(name) {
                        let enumInfo = ck.enums.get(name)!
                        if enumInfo.variants.contains(variant) {
                            let variantInfo = enumInfo.variants.get(variant)!
                            if bindings.len != variantInfo.fields.len {
                                error(&mut ck, "variant '" + variant.clone() + "' has " + variantInfo.fields.len.toString() + " fields, but pattern has " + bindings.len.toString() + " bindings", cloneSpan(pspan))
                            }
                            var k: i64 = 0
                            while k < bindings.len && k < variantInfo.fields.len {
                                if bindings[k] != "_" {
                                    declare(&mut ck, bindings[k].clone(), VarInfo {
                                        ty: variantInfo.fields[k].clone(),
                                        mutable: false,
                                        moved: false,
                                        borrowed: false,
                                        read: false,
                                        span: cloneSpan(pspan),
                                    })
                                }
                                k = k + 1
                            }
                        }
                    }
                }
                _ => {
                }
            }
        }
        _ => {
        }
    }

    for s in thenBody {
        checkStmt(&mut ck, *s, fnRetType)
    }
    popScope(&mut ck)

    match elseBody {
        Option.Some(body) => {
            pushScope(&mut ck)
            for s in body {
                checkStmt(&mut ck, *s, fnRetType)
            }
            popScope(&mut ck)
        }
        Option.None => {
        }
    }
}

// -- For-in statement --

// One TRef unwrap. Kept separate from checker/expr.milo's `deref` so this file's
// side-effect-free peek below never accidentally inherits a change made there for
// some other caller's contract.
fn peekDeref(t: TypeKind): TypeKind {
    match t {
        TypeKind.TRef(inner, mutable) => {
            return (*inner).clone()
        }
        _ => {
            return t
        }
    }
}

// Side-effect-free type of a variable/field/index path — used only to decide
// whether `for x in EXPR` is the string-view loop form (`text.lines()` /
// `text.splitView(sep)`) before EXPR is checked as an ordinary call, which would
// report the wrong error. Deliberately partial: a None answer means "ask the real
// checker", never "not a string".
pub fn peekPathType(ck: &Checker, e: &ExprNode): Option<TypeKind> {
    match e.kind {
        // a literal's bytes are a module constant, so views into it outlive any loop
        Expr.StringLit(v) => {
            return Option.Some(tyString())
        }
        Expr.Ident(name) => {
            match lookup(ck, name) {
                Option.Some(info) => {
                    return Option.Some(info.ty)
                }
                Option.None => {
                    return Option.None
                }
            }
        }
        Expr.FieldAccess(obj, field) => {
            match peekPathType(ck, *obj) {
                Option.Some(baseTy) => {
                    match peekDeref(baseTy) {
                        TypeKind.TStruct(sname) => {
                            if ck.structs.contains(sname) {
                                let info = ck.structs.get(sname)!
                                for i in 0..info.fields.len {
                                    if info.fields[i].name == field {
                                        return Option.Some(info.fields[i].ty.clone())
                                    }
                                }
                            }
                            return Option.None
                        }
                        _ => {
                            return Option.None
                        }
                    }
                }
                Option.None => {
                    return Option.None
                }
            }
        }
        // `rows[i].lines()` — an element read, so the freeze on the root container
        // still covers the storage the pieces point into
        Expr.IndexAccess(obj, idx) => {
            match peekPathType(ck, *obj) {
                Option.Some(baseTy) => {
                    match peekDeref(baseTy) {
                        TypeKind.TVec(elem) => {
                            return Option.Some((*elem).clone())
                        }
                        TypeKind.TArray(elem, size) => {
                            return Option.Some((*elem).clone())
                        }
                        TypeKind.THashMap(key, val) => {
                            return Option.Some((*val).clone())
                        }
                        _ => {
                            return Option.None
                        }
                    }
                }
                Option.None => {
                    return Option.None
                }
            }
        }
        _ => {
            return Option.None
        }
    }
}

// `for line in text.lines()` / `for f in text.splitView(sep)`. Each piece is a
// `&string` view into the receiver's own buffer — loop-only, matching the
// second-class reference rule: a view can't travel through the `next(): Option<T>`
// iterator protocol, since a reference inside an enum payload is a rejected return.
pub fn checkStringViewForIn(ck: &mut Checker, varName: &string, varName2: &Option<string>, recv: &ExprNode, mode: &string, args: &Vec<Heap<ExprNode>>, body: &Vec<Heap<Stmt>>, fnRetType: &TypeKind, span: &Option<Span>) {
    checkExpr(&mut ck, recv)
    if mode == "splitView" {
        if args.len != 1 {
            error(&mut ck, "'splitView' expects 1 argument, got " + args.len.toString(), cloneSpan(span))
        } else {
            let sepType = checkExpr(&mut ck, *args[0])
            if !typeEq(sepType, tyString()) && !typeEq(sepType, tyUnknown()) {
                error(&mut ck, "'splitView': expected string, got " + typeName(sepType), cloneSpan(span))
            }
        }
    } else if args.len != 0 {
        error(&mut ck, "'lines' takes no arguments", cloneSpan(span))
    }

    let viewType = TypeKind.TRef(Heap(tyString()), false)
    // Every piece points into the receiver's buffer, so it must not be
    // mutated, moved or reallocated for the whole loop — same freeze a
    // `s[a..b]` slice takes, held for the loop body's life instead of one
    // statement's.
    var frozenRoot: Option<string> = Option.None
    match accessPath(recv) {
        Option.Some(p) => {
            freezeName(&mut ck, p.root, p.fields)
            frozenRoot = Option.Some(p.root)
        }
        Option.None => {
        }
    }
    pushScope(&mut ck)
    match varName2 {
        Option.Some(name2) => {
            declare(&mut ck, varName.clone(), VarInfo {
                ty: tyI64(), mutable: false, moved: false, borrowed: false, read: false, span: cloneSpan(span)
            })
            declare(&mut ck, name2.clone(), VarInfo {
                ty: viewType, mutable: false, moved: false, borrowed: false, read: false, span: cloneSpan(span)
            })
        }
        Option.None => {
            declare(&mut ck, varName.clone(), VarInfo {
                ty: viewType, mutable: false, moved: false, borrowed: false, read: false, span: cloneSpan(span)
            })
        }
    }
    ck.loopDepth = ck.loopDepth + 1
    for s in body {
        checkStmt(&mut ck, *s, fnRetType)
    }
    ck.loopDepth = ck.loopDepth - 1
    popScope(&mut ck)
    match frozenRoot {
        Option.Some(r) => {
            unfreezeName(&mut ck, r)
        }
        Option.None => {
        }
    }
}

// Mangled name of the enum an inherent method returns ("Option_i64", "Result_u8_string").
// Empty when the method or its enum return can't be found — the caller only reaches here
// having already confirmed the method exists, so empty means the return isn't an enum at
// all, which lowering treats as fatal rather than guessing a tag layout.
fn enumNameOf(ck: &Checker, typeName: &string, method: &string): string {
    if !ck.inherentImpls.contains(typeName) {
        return ""
    }
    let impls = ck.inherentImpls.get(typeName)!
    if !impls.methods.contains(method) {
        return ""
    }
    match impls.methods.get(method)!.ret {
        TypeKind.TEnum(n) => {
            return n.clone()
        }
        _ => {
            return ""
        }
    }
}

pub fn checkForIn(ck: &mut Checker, varName: &string, varName2: &Option<string>, iterable: &ExprNode, body: &Vec<Heap<Stmt>>, fnRetType: &TypeKind, span: &Option<Span>) {
    // Range expression handled specially
    match iterable.kind {
        Expr.RangeExpr(start, end) => {
            let startType = checkExpr(&mut ck, *start)
            let endType = checkExpr(&mut ck, *end)
            if !isInteger(startType) && !typeEq(startType, tyUnknown()) {
                error(&mut ck, "for range start must be integer, got " + typeName(startType), cloneSpan(span))
            }
            if !isInteger(endType) && !typeEq(endType, tyUnknown()) {
                error(&mut ck, "for range end must be integer, got " + typeName(endType), cloneSpan(span))
            }

            // Use wider of start/end types
            var varType = startType.clone()
            match startType {
                TypeKind.TInt(bitsA, signedA, _, _) => {
                    match endType {
                        TypeKind.TInt(bitsB, signedB, _, _) => {
                            if bitsB > bitsA {
                                varType = endType.clone()
                            }
                        }
                        _ => {
                        }
                    }
                }
                _ => {
                }
            }

            ck.forIns.insert(iterable.id, forInInfo(ForInKind.FRange, varType.clone()))
            pushScope(&mut ck)
            declare(&mut ck, varName.clone(), VarInfo {
                ty: varType,
                mutable: false,
                moved: false,
                borrowed: false,
                read: false,
                span: cloneSpan(span),
            })
            ck.loopDepth = ck.loopDepth + 1
            for s in body {
                checkStmt(&mut ck, *s, fnRetType)
            }
            ck.loopDepth = ck.loopDepth - 1
            popScope(&mut ck)
            return
        }
        _ => {
        }
    }

    // `for line in text.lines()` / `for f in text.splitView(sep)` — a text pass that
    // allocates nothing. The receiver type has to be known BEFORE the call is checked
    // as an ordinary expression: checking the whole MethodCall generically would hit
    // checkStringMethod and report "no method 'lines' on string" (lines/splitView are
    // for-loop-only forms, not real methods) — peekPathType answers side-effect-free,
    // without checking (and thereby misreporting on) the call itself.
    match iterable.kind {
        Expr.MethodCall(mObj, mMethod, mArgs) => {
            if mMethod == "lines" || mMethod == "splitView" {
                var recvIsString = false
                match peekPathType(ck, *mObj) {
                    Option.Some(t) => {
                        match peekDeref(t) {
                            TypeKind.TString => {
                                recvIsString = true
                            }
                            _ => {
                            }
                        }
                    }
                    Option.None => {
                    }
                }
                if recvIsString {
                    // Keyed by the METHOD CALL node even though that node is never
                    // checked as an expression (lines/splitView are loop-only forms,
                    // not real methods) — it is still the `iterable` lowering will
                    // hand to this lookup.
                    var svi = forInInfo(ForInKind.FStrView, TypeKind.TRef(Heap(tyString()), false))
                    svi.mode = mMethod.clone()
                    ck.forIns.insert(iterable.id, svi)
                    checkStringViewForIn(&mut ck, varName, varName2, *mObj, mMethod, mArgs, body, fnRetType, span)
                    return
                }
            }
        }
        _ => {
        }
    }

    var iterType = checkExpr(&mut ck, iterable)
    // slices (&[T]) and &Vec iterate like the owned collection — same loop shapes,
    // just borrowed instead of moved.
    match iterType.clone() {
        TypeKind.TRef(inner, mutable) => {
            match (*inner).clone() {
                TypeKind.TArray(e, s) => {
                    iterType = (*inner).clone()
                }
                TypeKind.TVec(e) => {
                    iterType = (*inner).clone()
                }
                _ => {
                }
            }
        }
        _ => {
        }
    }

    // `@iter` on a field redirects the loop to that field: a newtype over a
    // container (HashSet over HashMap) iterates exactly as the container does —
    // same bindings, same borrow, no snapshot — instead of needing a `next`
    // method it cannot write (an iterator would have to hold a reference into
    // the wrapper, and references are second-class). Re-derived here from the
    // struct's own field list rather than stashed in a side table keyed by this
    // statement: codegen re-derives it the same way from the struct name, so
    // there is nothing checker-only to thread through and no by-value VarInfo
    // hazard to worry about.
    var structTyForIter = iterType.clone()
    match iterType.clone() {
        TypeKind.TRef(inner, mutable) => {
            match (*inner).clone() {
                TypeKind.TStruct(sname) => {
                    structTyForIter = (*inner).clone()
                }
                _ => {
                }
            }
        }
        _ => {
        }
    }
    var delegField = ""
    var delegFieldTy = tyUnknown()
    match structTyForIter {
        TypeKind.TStruct(sname) => {
            if ck.structs.contains(sname) {
                let sinfo = ck.structs.get(sname)!
                for fi in 0..sinfo.fields.len {
                    if sinfo.fields[fi].iterDelegate {
                        iterType = sinfo.fields[fi].ty.clone()
                        delegField = sinfo.fields[fi].name.clone()
                        delegFieldTy = sinfo.fields[fi].ty.clone()
                    }
                }
            }
        }
        _ => {
        }
    }

    // Iterating a Vec/Array/HashMap hands out element references into its own
    // storage; a push/insert mid-loop can realloc that storage out from under
    // them. Freeze the iterable's root for the loop body's life — same
    // mechanism a slice takes, held longer. Not applied to a byte-iterated
    // string (no element references escape a copy) or a user `next()`
    // iterator (owned values, not borrows).
    var iterFrozenRoot: Option<string> = Option.None
    var needsIterFreeze = false
    match iterType.clone() {
        TypeKind.TVec(e) => {
            needsIterFreeze = true
        }
        TypeKind.TArray(e, s) => {
            needsIterFreeze = true
        }
        TypeKind.THashMap(k, v) => {
            needsIterFreeze = true
        }
        _ => {
        }
    }
    if needsIterFreeze {
        match accessPath(iterable) {
            Option.Some(p) => {
                freezeName(&mut ck, p.root, p.fields)
                iterFrozenRoot = Option.Some(p.root)
            }
            Option.None => {
            }
        }
    }

    pushScope(&mut ck)
    ck.loopDepth = ck.loopDepth + 1

    // Filled in by whichever branch below claims this loop, then recorded against the
    // iterable's node id. Seeded with the "cannot iterate" shape so a branch that
    // errors out leaves no entry claiming a shape it never picked — lowering treats a
    // missing entry as fatal, and an already-errored program never reaches lowering.
    var finfo = forInInfo(ForInKind.FVec, tyUnknown())
    var finfoValid = false
    finfo.delegateField = delegField
    finfo.delegateFieldTy = delegFieldTy

    // Determine loop variable type based on collection type
    match iterType {
        TypeKind.TVec(elem) => {
            let elemRef = TypeKind.TRef(Heap(elem.clone()), false)
            finfoValid = true
            finfo.kind = ForInKind.FVec
            match varName2 {
                Option.Some(name2) => {
                    finfo.varTy = tyI64()
                    finfo.varTy2 = Option.Some(elemRef.clone())
                }
                Option.None => {
                    finfo.varTy = elemRef.clone()
                }
            }
            match varName2 {
                Option.Some(name2) => {
                    declare(&mut ck, varName.clone(), VarInfo {
                        ty: tyI64(), mutable: false, moved: false, borrowed: false, read: false, span: cloneSpan(span)
                    })
                    declare(&mut ck, name2.clone(), VarInfo {
                        ty: elemRef, mutable: false, moved: false, borrowed: false, read: false, span: cloneSpan(span)
                    })
                }
                Option.None => {
                    declare(&mut ck, varName.clone(), VarInfo {
                        ty: elemRef, mutable: false, moved: false, borrowed: false, read: false, span: cloneSpan(span)
                    })
                }
            }
        }
        TypeKind.TString => {
            let byteType = tyU8()
            finfoValid = true
            finfo.kind = ForInKind.FString
            match varName2 {
                Option.Some(name2) => {
                    finfo.varTy = tyI64()
                    finfo.varTy2 = Option.Some(tyU8())
                }
                Option.None => {
                    finfo.varTy = tyU8()
                }
            }
            match varName2 {
                Option.Some(name2) => {
                    declare(&mut ck, varName.clone(), VarInfo {
                        ty: tyI64(), mutable: false, moved: false, borrowed: false, read: false, span: cloneSpan(span)
                    })
                    declare(&mut ck, name2.clone(), VarInfo {
                        ty: byteType, mutable: false, moved: false, borrowed: false, read: false, span: cloneSpan(span)
                    })
                }
                Option.None => {
                    declare(&mut ck, varName.clone(), VarInfo {
                        ty: byteType, mutable: false, moved: false, borrowed: false, read: false, span: cloneSpan(span)
                    })
                }
            }
        }
        TypeKind.THashMap(key, val) => {
            let keyRef = TypeKind.TRef(Heap(key.clone()), false)
            let valRef = TypeKind.TRef(Heap(val.clone()), false)
            finfoValid = true
            finfo.kind = ForInKind.FHashMap
            finfo.varTy = keyRef.clone()
            finfo.varTy2 = Option.Some(valRef.clone())
            declare(&mut ck, varName.clone(), VarInfo {
                ty: keyRef, mutable: false, moved: false, borrowed: false, read: false, span: cloneSpan(span)
            })
            match varName2 {
                Option.Some(name2) => {
                    declare(&mut ck, name2.clone(), VarInfo {
                        ty: valRef, mutable: false, moved: false, borrowed: false, read: false, span: cloneSpan(span)
                    })
                }
                Option.None => {
                }
            }
        }
        TypeKind.TArray(elem, size) => {
            let elemRef = TypeKind.TRef(Heap(elem.clone()), false)
            finfoValid = true
            finfo.kind = ForInKind.FArray
            match varName2 {
                Option.Some(name2) => {
                    finfo.varTy = tyI64()
                    finfo.varTy2 = Option.Some(elemRef.clone())
                }
                Option.None => {
                    finfo.varTy = elemRef.clone()
                }
            }
            match varName2 {
                Option.Some(name2) => {
                    declare(&mut ck, varName.clone(), VarInfo {
                        ty: tyI64(), mutable: false, moved: false, borrowed: false, read: false, span: cloneSpan(span)
                    })
                    declare(&mut ck, name2.clone(), VarInfo {
                        ty: elemRef, mutable: false, moved: false, borrowed: false, read: false, span: cloneSpan(span)
                    })
                }
                Option.None => {
                    declare(&mut ck, varName.clone(), VarInfo {
                        ty: elemRef, mutable: false, moved: false, borrowed: false, read: false, span: cloneSpan(span)
                    })
                }
            }
        }
        TypeKind.TStruct(sname) => {
            // Channel<T> is iterable — `for x in ch` drains via recv() until closed.
            var isChan = false
            var elemTy = tyUnknown()
            for ii in 0..ck.structInsts.len {
                if ck.structInsts[ii].mangled == sname && ck.structInsts[ii].base == "Channel" {
                    isChan = true
                    if ck.structInsts[ii].args.len > 0 {
                        elemTy = ck.structInsts[ii].args[0].clone()
                    }
                }
            }
            if isChan {
                finfoValid = true
                finfo.kind = ForInKind.FChannel
                finfo.varTy = elemTy.clone()
                finfo.nextMethod = sname.clone() + "$recv"
                finfo.resultEnum = enumNameOf(ck, sname, "recv")
                finfo.okVariant = "Ok"
                declare(&mut ck, varName.clone(), VarInfo {
                    ty: elemTy, mutable: false, moved: false, borrowed: false, read: false, span: cloneSpan(span)
                })
            } else {
                var iterElem: Option<TypeKind> = Option.None
                if ck.inherentImpls.contains(sname) {
                    let implD = ck.inherentImpls.get(sname)!
                    if implD.methods.contains("next") {
                        iterElem = unwrapableInner(ck, implD.methods.get("next")!.ret)
                    }
                }
                match iterElem {
                    Option.Some(t) => {
                        finfoValid = true
                        finfo.kind = ForInKind.FIterator
                        finfo.varTy = t.clone()
                        finfo.nextMethod = sname.clone() + "$next"
                        finfo.resultEnum = enumNameOf(ck, sname, "next")
                        finfo.okVariant = "Some"
                        declare(&mut ck, varName.clone(), VarInfo {
                            ty: t, mutable: false, moved: false, borrowed: false, read: false, span: cloneSpan(span)
                        })
                    }
                    Option.None => {
                        error(&mut ck, "cannot iterate over type '" + sname.clone() + "'", cloneSpan(span))
                    }
                }
            }
        }
        _ => {
            if !typeEq(iterType, tyUnknown()) {
                error(&mut ck, "cannot iterate over type '" + typeName(iterType) + "'", cloneSpan(span))
            }
        }
    }

    if finfoValid {
        ck.forIns.insert(iterable.id, finfo)
    }

    for s in body {
        checkStmt(&mut ck, *s, fnRetType)
    }

    ck.loopDepth = ck.loopDepth - 1
    popScope(&mut ck)
    match iterFrozenRoot {
        Option.Some(r) => {
            unfreezeName(&mut ck, r)
        }
        Option.None => {
        }
    }
}

// -- Top-level: check a function body --

// A reference tucked inside a return type's storage (Option<&[T]>, a Vec<&T>
// return, ...) outlives whatever freeze the call site took for the call
// itself — nothing marks the OUTER value as borrowed the way a bare `&T`
// return does. `outer` is the enum's source name for a nicer message
// ("...inside 'Option'" rather than the mangled "...inside 'Option_i64'").
fn errorIfNestedRefReturn(ck: &mut Checker, func: &Function, retType: &TypeKind) {
    match retType {
        TypeKind.TRef(inner, mutable) => {
            return
        }
        _ => {
        }
    }
    if !nestedRef(ck, retType) {
        return
    }
    var outer = typeName(retType)
    match retType {
        TypeKind.TEnum(name) => {
            if ck.enums.contains(name) {
                outer = ck.enums.get(name)!.baseName.clone()
            }
        }
        _ => {
        }
    }
    error(&mut ck, "function '" + func.name.clone() + "': cannot return a reference stored inside '" + outer + "'", Option.None)
}

// A view-returning method (`&[T]`/`&string` receiver getter) may only hand
// back storage reachable from `self` — the call site freezes the receiver
// and nothing else, so a view into a method-local or another param would
// dangle the moment that storage goes away. AST-level walk (not through the
// type-checked expression path): only needs the raw shape of each `return`.
fn viewReturnRoot(e: &ExprNode): Option<string> {
    match e.kind {
        Expr.Ident(name) => {
            return Option.Some(name.clone())
        }
        Expr.FieldAccess(obj, field) => {
            return viewReturnRoot(*obj)
        }
        Expr.IndexAccess(obj, idx) => {
            return viewReturnRoot(*obj)
        }
        Expr.MethodCall(obj, method, args) => {
            return viewReturnRoot(*obj)
        }
        _ => {
            return Option.None
        }
    }
}

// The field chain from `self` a return value points into (`self.a[0..n]` ->
// `["a"]`, `self.data` -> `["data"]`, bare `self` -> `[]`). None when the
// value isn't rooted at self at all — that's already an error, reported by
// checkViewReturnStmt separately, so provenance recording just declines.
fn viewFieldChain(e: &ExprNode): Option<Vec<string>> {
    match e.kind {
        Expr.Ident(name) => {
            if name == "self" {
                return Option.Some(Vec.new())
            }
            return Option.None
        }
        Expr.FieldAccess(obj, field) => {
            match viewFieldChain(*obj) {
                Option.Some(fs) => {
                    var nf = fs.clone()
                    nf.push(field.clone())
                    return Option.Some(nf)
                }
                Option.None => {
                    return Option.None
                }
            }
        }
        Expr.IndexAccess(obj, idx) => {
            return viewFieldChain(*obj)
        }
        Expr.MethodCall(obj, method, args) => {
            return viewFieldChain(*obj)
        }
        _ => {
            return Option.None
        }
    }
}

fn stringVecEq(a: &Vec<string>, b: &Vec<string>): bool {
    if a.len != b.len {
        return false
    }
    for i in 0..a.len {
        if a[i] != b[i] {
            return false
        }
    }
    return true
}

fn checkViewReturnStmt(ck: &mut Checker, s: &Stmt, chains: &mut Vec<Vec<string>>) {
    match s {
        Stmt.Return(v, sp) => {
            match v {
                Option.Some(e) => {
                    match viewReturnRoot(*e) {
                        Option.Some(root) => {
                            if root != "self" {
                                error(&mut ck, "cannot return a view of '" + root.clone() + "'", cloneSpan(sp))
                            }
                        }
                        Option.None => {
                        }
                    }
                    match viewFieldChain(*e) {
                        Option.Some(chain) => {
                            chains.push(chain)
                        }
                        Option.None => {
                        }
                    }
                }
                Option.None => {
                }
            }
        }
        Stmt.IfStmt(cond, thenBody, elseBody, sp) => {
            for s2 in thenBody {
                checkViewReturnStmt(&mut ck, *s2, &mut chains)
            }
            match elseBody {
                Option.Some(eb) => {
                    for s2 in eb {
                        checkViewReturnStmt(&mut ck, *s2, &mut chains)
                    }
                }
                Option.None => {
                }
            }
        }
        Stmt.MatchStmt(subj, arms, sp) => {
            for a in arms {
                for s2 in a.body {
                    checkViewReturnStmt(&mut ck, *s2, &mut chains)
                }
            }
        }
        _ => {
        }
    }
}

fn checkViewReturnProvenance(ck: &mut Checker, func: &Function, retType: &TypeKind) {
    if !isViewReturnType(retType) {
        return
    }
    if func.params.len == 0 || func.params[0].name != "self" {
        return
    }
    var chains: Vec<Vec<string>> = Vec.new()
    for s in func.body {
        checkViewReturnStmt(&mut ck, *s, &mut chains)
    }
    // Record provenance only when every `return` agrees on the same field
    // chain — a fork whose arms return different fields has no single answer,
    // so the call site falls back to freezing the whole receiver (still sound,
    // just less precise).
    if chains.len > 0 {
        var allSame = true
        for i in 1..chains.len {
            if !stringVecEq(chains[0], chains[i]) {
                allSame = false
            }
        }
        if allSame {
            ck.viewReturnFields.insert(func.name.clone(), chains[0].clone())
        }
    }
}

pub fn checkFunction(ck: &mut Checker, func: &Function) {
    pushScope(&mut ck)
    let retType = resolveAstType(&mut ck, func.retType)
    ck.currentFnRetType = retType.clone()
    errorIfNestedRefReturn(&mut ck, func, retType)

    // Declare parameters
    for param in func.params {
        let pType = resolveAstType(&mut ck, param.ty)
        // a &mut param makes the pointee assignable through the ref
        var pMut = false
        match pType.clone() {
            TypeKind.TRef(inner, m) => {
                pMut = m
            }
            _ => {
            }
        }
        declare(&mut ck, param.name.clone(), VarInfo {
            ty: pType,
            mutable: pMut,
            moved: false,
            borrowed: false,
            read: false,
            span: Option.None,
        })
    }

    // Check body
    for s in func.body {
        checkStmt(&mut ck, *s, retType)
    }

    popScope(&mut ck)
}

// -- Top-level: register declarations and check program --

pub fn registerFunction(ck: &mut Checker, func: &Function) {
    var params: Vec<FnParam> = Vec.new()
    for param in func.params {
        params.push(FnParam {
            name: param.name.clone(),
            ty: resolveAstType(&mut ck, param.ty),
        })
    }
    let sig = FnSig {
        params: params,
        ret: resolveAstType(&mut ck, func.retType),
        variadic: func.isVariadic,
        isExtern: func.isExtern,
    }
    ck.functions.insert(func.name.clone(), sig)
}

pub fn registerStruct(ck: &mut Checker, decl: &StructDecl) {
    var fields: Vec<CkStructField> = Vec.new()
    var iterFieldCount = 0
    for field in decl.fields {
        let fty = resolveAstType(&mut ck, field.ty)
        // References are second-class: they can only live in a param or a local
        // binding, never in storage that outlives the call that took the borrow.
        // A struct field is exactly that kind of storage, direct or nested
        // (Vec<&T> etc — see nestedRef). Checked against a clone: matching `fty`
        // itself would move its payload out of the TRef arm, leaving it unusable
        // below for the field record and the nestedRef fallback.
        var isDirectRef = false
        match fty.clone() {
            TypeKind.TRef(inner, mutable) => {
                isDirectRef = true
            }
            _ => {
            }
        }
        if isDirectRef {
            error(&mut ck, "struct '" + decl.name.clone() + "' field '" + field.name.clone() + "': references cannot be stored in structs", Option.None)
        } else if nestedRef(ck, fty) {
            error(&mut ck, "struct '" + decl.name.clone() + "' field '" + field.name.clone() + "': references cannot be stored in a collection", Option.None)
        }
        let isIterDelegate = hasAttr(field.attributes, "iter")
        if isIterDelegate {
            iterFieldCount = iterFieldCount + 1
            if iterFieldCount > 1 {
                error(&mut ck, "'" + decl.name.clone() + "' has more than one @iter field", Option.None)
            }
        }
        fields.push(CkStructField {
            name: field.name.clone(),
            ty: fty,
            iterDelegate: isIterDelegate,
        })
    }
    let info = StructInfo {
        fields: fields,
        baseName: decl.name.clone(),
        noCopy: hasAttr(decl.attributes, "noCopy"),
    }
    ck.structs.insert(decl.name.clone(), info)
}

pub fn registerEnum(ck: &mut Checker, decl: &EnumDecl) {
    var variants: HashMap<string, VariantInfo> = HashMap.new()
    var i: i64 = 0
    // `LDA = 169` sets the tag and counting RESUMES from it — the same rule
    // registerGenericEnum already applies, and the tag recorded here is the one codegen
    // emits, so a positional index would make a match arm compare against a number the
    // constructor never stored.
    var nextTag: i64 = 0
    while i < decl.variants.len {
        var fields: Vec<TypeKind> = Vec.new()
        for vfield in decl.variants[i].fields {
            fields.push(resolveAstType(&mut ck, vfield))
        }
        match decl.variants[i].discriminant {
            Option.Some(d) => {
                nextTag = d
            }
            Option.None => {
            }
        }
        variants.insert(decl.variants[i].name.clone(), VariantInfo {
            tag: nextTag as i32,
            fields: fields,
        })
        nextTag = nextTag + 1
        i = i + 1
    }
    let info = EnumInfo {
        baseName: decl.name.clone(),
        variants: variants,
    }
    ck.enums.insert(decl.name.clone(), info)
}

// Whether struct `name` embeds itself BY VALUE, directly or through other
// by-value structs or fixed-size arrays (mirrors the oracle's embedsSelf in
// src/checker.ts). Heap<T>/Vec<T>/&T/*T fields all break the chain — those are
// pointer-sized regardless of what they point to — so only TStruct and TArray
// keep walking. `stack` is the set of struct names on the current walk; hitting
// one already on it means an unindirected cycle, i.e. infinite size.
pub fn structEmbedsSelf(ck: &Checker, name: &string, stack: &mut Vec<string>): bool {
    for i in 0..stack.len {
        if stack[i] == name {
            return true
        }
    }
    if !ck.structs.contains(name) {
        return false
    }
    let info = ck.structs.get(name)!
    stack.push(name.clone())
    var found = false
    for i in 0..info.fields.len {
        if structFieldEmbedsSelf(ck, info.fields[i].ty, &mut stack) {
            found = true
        }
    }
    let _ = stack.pop()
    return found
}

fn structFieldEmbedsSelf(ck: &Checker, t: &TypeKind, stack: &mut Vec<string>): bool {
    match t {
        TypeKind.TArray(inner, size) => {
            return structFieldEmbedsSelf(ck, *inner, &mut stack)
        }
        TypeKind.TStruct(name) => {
            return structEmbedsSelf(ck, name, &mut stack)
        }
        _ => {
            return false
        }
    }
}

// Option<T> and Result<T, E> are compiler builtins with no source declaration;
// synthesize generic EnumDecls so the normal mono machinery instantiates them.
pub fn registerBuiltinGenericEnums(ck: &mut Checker) {
    var someFields: Vec<MiloType> = Vec.new()
    someFields.push(simpleType("T"))
    var optVariants: Vec<EnumVariant> = Vec.new()
    optVariants.push(EnumVariant {
        name: "Some", fields: someFields, discriminant: Option.None
    })
    optVariants.push(EnumVariant {
        name: "None", fields: Vec.new(), discriminant: Option.None
    })
    var optParams: Vec<TypeParam> = Vec.new()
    optParams.push(TypeParam {
        name: "T", bounds: Vec.new()
    })
    registerGenericEnum(&mut ck, EnumDecl {
        name: "Option",
        typeParams: optParams,
        variants: optVariants,
        attributes: Vec.new(),
    })

    var okFields: Vec<MiloType> = Vec.new()
    okFields.push(simpleType("T"))
    var errFields: Vec<MiloType> = Vec.new()
    errFields.push(simpleType("E"))
    var resVariants: Vec<EnumVariant> = Vec.new()
    resVariants.push(EnumVariant {
        name: "Ok", fields: okFields, discriminant: Option.None
    })
    resVariants.push(EnumVariant {
        name: "Err", fields: errFields, discriminant: Option.None
    })
    var resParams: Vec<TypeParam> = Vec.new()
    resParams.push(TypeParam {
        name: "T", bounds: Vec.new()
    })
    resParams.push(TypeParam {
        name: "E", bounds: Vec.new()
    })
    registerGenericEnum(&mut ck, EnumDecl {
        name: "Result",
        typeParams: resParams,
        variants: resVariants,
        attributes: Vec.new(),
    })
}

// Annotation-side generic instantiation: `Option<i32>` must resolve to the
// monomorphized enum/struct, not TStruct("Option").
pub fn resolveAstType(ck: &mut Checker, ty: &MiloType): TypeKind {
    // Resolve a type alias name to its base (preserving any &/&mut/* wrapper the
    // USE site spelled). The base is resolved lazily, through this SAME function,
    // so an aliased generic enum (`type Parsed = Result<i32, AppError>`) goes
    // through the typeArgs>0 branch below and comes back correctly monomorphized
    // — unlike resolving it once eagerly at registration (Phase 0, before enums
    // exist), which can only ever produce a bare, non-generic TStruct.
    if !ty.isFn && ty.typeArgs.len == 0 && ck.typeAliases.contains(ty.name) {
        let rawBase = ck.typeAliases.get(ty.name)!
        var base = resolveAstType(&mut ck, rawBase)
        if ty.ptrDepth > 0 {
            var i: i32 = 0
            while i < ty.ptrDepth {
                base = TypeKind.TPtr(Heap(base))
                i = i + 1
            }
            return base
        }
        if ty.isRef {
            return TypeKind.TRef(Heap(base), false)
        }
        if ty.isRefMut {
            return TypeKind.TRef(Heap(base), true)
        }
        return base
    }
    if ty.typeArgs.len > 0 && !ty.isFn {
        var base = tyUnknown()
        var matched = false
        if ck.genericEnums.contains(ty.name) {
            var typeArgs: Vec<TypeKind> = Vec.new()
            for i in 0..ty.typeArgs.len {
                typeArgs.push(resolveAstType(&mut ck, ty.typeArgs[i]))
            }
            base = TypeKind.TEnum(monomorphizeEnum(&mut ck, ty.name, typeArgs))
            matched = true
        } else if ck.genericStructs.contains(ty.name) {
            var typeArgs: Vec<TypeKind> = Vec.new()
            for i in 0..ty.typeArgs.len {
                typeArgs.push(resolveAstType(&mut ck, ty.typeArgs[i]))
            }
            base = TypeKind.TStruct(monomorphizeStruct(&mut ck, ty.name, typeArgs))
            matched = true
        } else if ty.name == "Vec" && ty.typeArgs.len == 1 {
            base = TypeKind.TVec(Heap(resolveAstType(&mut ck, ty.typeArgs[0])))
            matched = true
        } else if ty.name == "Heap" && ty.typeArgs.len == 1 {
            let hinner = resolveAstType(&mut ck, ty.typeArgs[0])
            // Heap<Interface> collapses to the interface type (a trait object fat
            // pointer whose data ptr is heap-allocated).
            var isIface = false
            match hinner.clone() {
                TypeKind.TStruct(nm) => {
                    if ck.traits.contains(nm) {
                        isIface = true base = hinner.clone()
                    }
                }
                _ => {
                }
            }
            if !isIface {
                base = TypeKind.THeap(Heap(hinner))
            }
            matched = true
        } else if ty.name == "HashMap" && ty.typeArgs.len == 2 {
            base = TypeKind.THashMap(Heap(resolveAstType(&mut ck, ty.typeArgs[0])), Heap(resolveAstType(&mut ck, ty.typeArgs[1])))
            matched = true
        }
        if matched {
            // Preserve any &/&mut/* wrapper the annotation spelled — dropping it
            // made a `&mut Arena<T>` param non-mutable and un-derefable.
            if ty.isArray {
                base = TypeKind.TArray(Heap(base), ty.arraySize)
            }
            if ty.ptrDepth > 0 {
                var i: i32 = 0
                while i < ty.ptrDepth {
                    base = TypeKind.TPtr(Heap(base))
                    i = i + 1
                }
                return base
            }
            if ty.isRef {
                return TypeKind.TRef(Heap(base), false)
            }
            if ty.isRefMut {
                return TypeKind.TRef(Heap(base), true)
            }
            return base
        }
    }
    return normalizeEnumNames(ck, typeFromAst(ty))
}

pub fn checkProgram(ck: &mut Checker, program: &Program) {
    // Phase 0: register builtin traits and generic types
    registerBuiltinTraits(&mut ck)
    registerBuiltinGenericEnums(&mut ck)
    // type aliases (`type Altitude = i32(0..N)`) — store the RAW base AST; it is
    // resolved lazily by resolveAstType at each use site (see that fn's alias
    // branch), same as any other annotation. Eagerly resolving here with
    // typeFromAst ran before enums/generics exist and cannot express generics
    // at all — see the field comment on Checker.typeAliases.
    for ai in 0..program.typeAliases.len {
        ck.typeAliases.insert(program.typeAliases[ai].name.clone(), program.typeAliases[ai].base.clone())
    }
    // Register user-declared traits/interfaces BEFORE structs/fns so a trait name used
    // as a type (`&Iface`, `Heap<Iface>` struct fields) resolves during registration.
    for ti in 0..program.traits.len {
        let td = program.traits[ti]
        var tmethods: HashMap<string, TraitMethodInfo> = HashMap.new()
        for mi in 0..td.methods.len {
            var mparams: Vec<FnParam> = Vec.new()
            for pi in 0..td.methods[mi].params.len {
                mparams.push(FnParam {
                    name: td.methods[mi].params[pi].name.clone(), ty: resolveAstType(&mut ck, td.methods[mi].params[pi].ty)
                })
            }
            var hasDef = false
            match td.methods[mi].body {
                Option.Some(b) => {
                    hasDef = true
                }
                Option.None => {
                }
            }
            tmethods.insert(td.methods[mi].name.clone(), TraitMethodInfo {
                params: mparams, ret: resolveAstType(&mut ck, td.methods[mi].retType), hasDefault: hasDef
            })
        }
        var stps: Vec<string> = Vec.new()
        for si in 0..td.supertraits.len {
            stps.push(td.supertraits[si].clone())
        }
        ck.traits.insert(td.name.clone(), TraitInfo {
            name: td.name.clone(), supertraits: stps, methods: tmethods
        })
    }

    // Phase 1: register all declarations (generics park on ck.generic* until
    // a use site provides concrete type args). Register ALL generic structs/enums
    // FIRST, so a concrete struct/enum whose field references a generic defined
    // later (e.g. `arena: Arena<Node>`) resolves it to the monomorphized name
    // rather than the flattened base.
    var i: i64 = 0
    for s in program.structs {
        if s.typeParams.len > 0 {
            registerGenericStruct(&mut ck, s)
        }
    }
    for e in program.enums {
        if e.typeParams.len > 0 {
            registerGenericEnum(&mut ck, e)
        }
    }
    for s in program.structs {
        if s.typeParams.len == 0 {
            registerStruct(&mut ck, s)
        }
    }
    for e in program.enums {
        if e.typeParams.len == 0 {
            registerEnum(&mut ck, e)
        }
    }
    for f in program.functions {
        if f.typeParams.len > 0 {
            registerGenericFn(&mut ck, f)
        } else {
            registerFunction(&mut ck, f)
        }
    }

    // Phase 1.5: enum payloads and struct fields were converted before every
    // enum name was registered — normalize TStruct(enumName) → TEnum(enumName)
    // now that the full name set is known.
    var enumNames: Vec<string> = Vec.new()
    for en, ev in ck.enums {
        enumNames.push(en.clone())
    }
    for ei in 0..enumNames.len {
        var info = ck.enums.get(enumNames[ei])!
        var newVariants: HashMap<string, VariantInfo> = HashMap.new()
        for vn, vi in info.variants {
            var fields: Vec<TypeKind> = Vec.new()
            for fi in 0..vi.fields.len {
                fields.push(normalizeEnumNames(ck, vi.fields[fi]))
            }
            newVariants.insert(vn.clone(), VariantInfo {
                tag: vi.tag, fields: fields
            })
        }
        info.variants = newVariants
        ck.enums.insert(enumNames[ei].clone(), info)
    }
    var structNames: Vec<string> = Vec.new()
    for sn, sv in ck.structs {
        structNames.push(sn.clone())
    }
    for si in 0..structNames.len {
        var sInfo = ck.structs.get(structNames[si])!
        var newFields: Vec<CkStructField> = Vec.new()
        for fi in 0..sInfo.fields.len {
            newFields.push(CkStructField {
                name: sInfo.fields[fi].name.clone(),
                ty: normalizeEnumNames(ck, sInfo.fields[fi].ty),
                iterDelegate: sInfo.fields[fi].iterDelegate,
            })
        }
        sInfo.fields = newFields
        ck.structs.insert(structNames[si].clone(), sInfo)
    }

    // A struct/enum that embeds itself BY VALUE (directly, or through other
    // by-value structs/fixed arrays) has infinite size and can't be laid out.
    // Left unchecked, layout/codegen either recurses forever computing the size
    // (a hang the memory guard has to kill) or hands LLVM a self-referential
    // struct type it rejects with an opaque verifier error — neither is a
    // diagnostic. Must run after Phase 1.5's TStruct(enumName) -> TEnum(enumName)
    // normalization, or an enum's recursive field still reads as TStruct and
    // this walk misses it entirely.
    for si in 0..program.structs.len {
        let s = program.structs[si]
        if s.typeParams.len == 0 {
            var stack: Vec<string> = Vec.new()
            if structEmbedsSelf(ck, s.name, &mut stack) {
                errorHint(&mut ck, "struct '" + s.name.clone() + "' is recursive by value and has infinite size", "a struct cannot contain itself by value — put the recursive field behind an indirection (e.g. 'Heap<" + s.name.clone() + ">' or 'Vec<" + s.name.clone() + ">')", Option.None)
            }
        }
    }
    for ei in 0..program.enums.len {
        let e = program.enums[ei]
        if e.typeParams.len == 0 && ck.enums.contains(e.name) {
            let info = ck.enums.get(e.name)!
            for vn, vi in info.variants {
                for fi in 0..vi.fields.len {
                    match vi.fields[fi] {
                        TypeKind.TEnum(fname) => {
                            if fname == e.name {
                                errorHint(&mut ck, "enum '" + e.name.clone() + "' has infinite size due to recursive field", "wrap the recursive field in Heap<" + e.name.clone() + "> for heap allocation", Option.None)
                            }
                        }
                        _ => {
                        }
                    }
                }
            }
        }
    }

    // Phase 2: register impls and derive macros
    registerAllImpls(&mut ck, program)
    synthesizeDefaultMethods(&mut ck, program)
    processDerives(&mut ck, program)

    // Phase 2.5: record view-return provenance (which field a `&[T]`/`&string`
    // getter method reads off `self`) for every impl method BEFORE any body is
    // checked. A caller in Phase 3 (`t.items()` inside `main`) needs the
    // answer already on file — recording it lazily inside checkFunction only
    // helped a CALLER that happens to be checked later than its callee, which
    // free-function/impl-method ordering does not guarantee (mirrors the
    // oracle's recordViewProvenance pre-pass over implFnsToCheck).
    var vi: i64 = 0
    while vi < ck.monomorphizedFns.len {
        let vfn = ck.monomorphizedFns[vi].clone()
        let vRetType = resolveAstType(&mut ck, vfn.retType)
        checkViewReturnProvenance(&mut ck, vfn, vRetType)
        vi = vi + 1
    }

    // Register module-level globals in a persistent scope below every function
    // scope, so function bodies can reference them (e.g. `if key == KEY_QUIT`).
    pushScope(&mut ck)
    for gi in 0..program.globals.len {
        var gty = tyUnknown()
        match program.globals[gi].ty {
            Option.Some(t) => {
                gty = resolveAstType(&mut ck, t)
            }
            Option.None => {
                gty = checkExpr(&mut ck, *program.globals[gi].value)
            }
        }
        declare(&mut ck, program.globals[gi].name.clone(), VarInfo {
            ty: gty, mutable: program.globals[gi].mutable, moved: false, borrowed: false, read: true,
            span: cloneSpan(program.globals[gi].span),
        })
    }

    // Defensive reset: nothing checked so far (impl registration, derive
    // synthesis, the view-provenance pre-pass, global initializers) should
    // have a live borrow outlive it — this side table has no scope of its
    // own to bound it the way ck.scopes does, so it is only ever as clean as
    // every checker of an expression remembers to leave it.
    ck.borrowedPaths = HashMap.new()

    // Phase 3: check function bodies
    i = 0
    while i < program.functions.len {
        if !program.functions[i].isExtern && program.functions[i].typeParams.len == 0 {
            checkFunction(&mut ck, program.functions[i])
        }
        i = i + 1
    }

    // Phase 4: check monomorphized functions
    i = 0
    while i < ck.monomorphizedFns.len {
        let monoFn = ck.monomorphizedFns[i].clone()
        checkFunction(&mut ck, monoFn)
        // Store back the body that was actually checked. Reading a Function out of the
        // Vec copies it, and a copied ExprNode takes a FRESH id (see ast.milo's Clone
        // impl) — so every type and loop shape recorded just now is keyed to nodes that
        // die with this local, and the bodies codegen and lowering go on to walk have no
        // entry at all in exprTypes or forIns.
        ck.monomorphizedFns[i] = monoFn
        i = i + 1
    }

    // Anything still pending never got an element from a push. Reported here, at the
    // end, because a push arbitrarily far away is still a resolution.
    //
    // The list is moved out before the walk: `for pv in ck.pendingVecInfer` holds a
    // borrow of `ck` for the loop's whole body, and `error` needs `&mut ck`. milo-self
    // rejects that (correctly); the oracle compiled it, which is a gap in the oracle.
    var pending: Vec<PendingVecInfer> = Vec.new()
    for pv in ck.pendingVecInfer {
        pending.push(PendingVecInfer {
            name: pv.name.clone(), span: cloneSpan(pv.span)
        })
    }
    ck.pendingVecInfer = Vec.new()
    for pv in pending {
        error(&mut ck, "cannot infer Vec element type — no 'push' found to infer from; add a type annotation: 'let v: Vec<T> = Vec.new()'", cloneSpan(pv.span))
    }
}
