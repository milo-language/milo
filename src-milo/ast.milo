// AST node types for the Milo compiler

pub struct Span {
    line: i32,
    col: i32,
    // The file this span was parsed from. The resolver merges every imported
    // module into one program, so without this a diagnostic from an imported
    // file (e.g. std/strconv.milo) renders against the ENTRY file's path and
    // line, pointing the reader at unrelated code (matches src/ast.ts's
    // optional Span.file, made non-optional here since the parser always
    // knows which file it's parsing).
    file: string,
}

// One compiler error or warning. Declared here rather than in the checker because the
// PARSER produces these too: `expect` recovers by printing and continuing, so without a
// collected list a file with parse errors reached the checker as a Program built from
// guesses and could be reported as clean. Every producer pushes; the driver renders once.
pub struct Diagnostic {
    severity: string, // "error" or "warning"
    message: string,
    hint: string,
    span: Option<Span>,
}

pub struct MiloType {
    name: string,
    typeArgs: Vec<MiloType>,
    // Number of leading '*' on the annotation (*T = 1, **T = 2, ...). A bare
    // bool here used to collapse **T to *T — see std/platform's environBlock.
    ptrDepth: i32,
    isRef: bool,
    isRefMut: bool,
    isArray: bool,
    arraySize: Option<i64>,
    isFn: bool,
    // `move (T) => R` — an owning closure type. Parsed here so `std/runtime.milo`'s
    // `fn spawn(f: move () => void)` is readable; the owning DROP semantics are a
    // src/ feature this compiler still lags.
    isMoveFn: bool,
    fnParams: Vec<MiloType>,
    fnRet: Option<Heap<MiloType>>,
    // `i32(0..100)` — a range constraint written on an integer annotation. Both
    // ends are present or neither is; typeFromAst folds them onto the TInt.
    rangeMin: Option<i64>,
    rangeMax: Option<i64>,
}

pub fn simpleType(name: string): MiloType {
    return MiloType {
        name: name,
        typeArgs: Vec.new(),
        ptrDepth: 0,
        isRef: false,
        isRefMut: false,
        isArray: false,
        arraySize: Option.None,
        isFn: false,
        isMoveFn: false,
        fnParams: Vec.new(),
        fnRet: Option.None,
        rangeMin: Option.None,
        rangeMax: Option.None,
    }
}

pub fn ptrType(name: string): MiloType {
    return MiloType {
        name: name,
        typeArgs: Vec.new(),
        ptrDepth: 1,
        isRef: false,
        isRefMut: false,
        isArray: false,
        arraySize: Option.None,
        isFn: false,
        isMoveFn: false,
        fnParams: Vec.new(),
        fnRet: Option.None,
        rangeMin: Option.None,
        rangeMax: Option.None,
    }
}

pub struct Param {
    name: string,
    ty: MiloType,
}

pub struct StructField {
    name: string,
    ty: MiloType,
    // Only @derive(Json) reads this (the @json("wire_name") rename) — everything
    // else that can attach to a field (e.g. @iter in std/set.milo) is still
    // parsed-and-dropped at the call site.
    attributes: Vec<Attribute>,
}

pub struct TypeParam {
    name: string,
    bounds: Vec<string>,
}

pub struct Attribute {
    name: string,
    args: Vec<string>,
}

// -- Expressions --

pub struct StructLitField {
    name: string,
    value: Heap<ExprNode>,
}

// The syntactic shape of an expression, with no identity and no location of its
// own — both of those live on the ExprNode that wraps it.
pub enum Expr {
    IntLit(i64),
    FloatLit(f64),
    BoolLit(bool),
    StringLit(string),
    CharLit(i32),
    Ident(string),
    BinOp(string, Heap<ExprNode>, Heap<ExprNode>),
    UnaryOp(string, Heap<ExprNode>),
    Call(string, Vec<Heap<ExprNode>>, Vec<MiloType>),
    StructLit(string, Vec<StructLitField>),
    FieldAccess(Heap<ExprNode>, string),
    ArrayLit(Vec<Heap<ExprNode>>),
    ArrayRepeat(Heap<ExprNode>, i64),
    IndexAccess(Heap<ExprNode>, Heap<ExprNode>),
    EnumLit(string, string, Vec<Heap<ExprNode>>),
    Unwrap(Heap<ExprNode>),
    Propagate(Heap<ExprNode>),
    DefaultValue(Heap<ExprNode>, Heap<ExprNode>),
    CastExpr(Heap<ExprNode>, MiloType),
    MethodCall(Heap<ExprNode>, string, Vec<Heap<ExprNode>>),
    Closure(Vec<Param>, Option<MiloType>, Vec<Heap<Stmt>>, bool),
    RangeExpr(Heap<ExprNode>, Heap<ExprNode>),
    IsExpr(Heap<ExprNode>, Heap<Pattern>),
    // if in expression position. Arms are statement blocks whose trailing
    // ExprStmt supplies the value, same shape as MatchArm bodies — a single-
    // expression arm is just the one-statement case.
    IfExpr(Heap<ExprNode>, Vec<Heap<Stmt>>, Vec<Heap<Stmt>>),
    // match in expression position — reuses MatchArm (bare `P => v` arms get
    // wrapped in a one-statement ExprStmt body by the parser, so bodies here are
    // uniformly Vec<Heap<Stmt>>, same shape as Stmt.MatchStmt).
    MatchExpr(Heap<ExprNode>, Vec<MatchArm>),
    // anonymous JSON object literal `{ key: value, … }` — serializes to a JSON
    // string (used by `ctx.json({...})`).
    JsonObject(Vec<StructLitField>),
}

// Program-unique expression id. A lowering pass keys its side tables by this, so
// two live nodes must never share one — including the copies monomorphization
// makes of a generic body. Allocation lives inside mkExpr precisely so there is
// no way to build a node without one.
var nextExprId: u32 = 0

pub fn freshExprId(): u32 {
    nextExprId = nextExprId + 1
    return nextExprId
}

// Which argument nodes were written `&mut x`. The parser drops the marker from the tree
// (so lowering and codegen see the bare form the ABI wants) and records the node here;
// the checker reads it to enforce the explicit-`&mut` rule. Indexed by expression id, so
// every path that gives a node a new id (Clone, renameExpr, substExpr) has to carry the
// mark across with copyExplicitMut, or an argument inside an instantiated generic body
// would be reported as bare.
var explicitMutIds: Vec<bool> = Vec.new()

pub fn markExplicitMut(id: u32) {
    while explicitMutIds.len <= (id as i64) {
        explicitMutIds.push(false)
    }
    explicitMutIds[id as i64] = true
}

pub fn isExplicitMut(id: u32): bool {
    if (id as i64) >= explicitMutIds.len {
        return false
    }
    return explicitMutIds[id as i64]
}

pub fn copyExplicitMut(from: u32, to: u32) {
    if isExplicitMut(from) {
        markExplicitMut(to)
    }
}

// An expression, its identity, and where it came from. `kind` holds the syntax;
// nothing else may carry a span, or the two can disagree about the same node.
pub struct ExprNode {
    id: u32,
    kind: Expr,
    span: Option<Span>,
}

// The ONLY way to construct an expression node. Monomorphization rebuilds bodies
// through here rather than cloning them, so each instantiation gets its own ids
// for free — a clone would duplicate them and silently merge two nodes in any map
// keyed by id.
pub fn mkExpr(kind: Expr, span: Option<Span>): Heap<ExprNode> {
    return Heap(ExprNode {
        id: freshExprId(), kind: kind, span: span
    })
}

// -- Patterns --

pub enum LiteralKind {
    LitInt,
    LitFloat,
    LitString,
    LitChar,
    LitBool,
}

pub enum Pattern {
    EnumPattern(string, string, Vec<string>, Option<Span>),
    LiteralPattern(string, LiteralKind, Option<Span>),
    WildcardPattern(Option<Span>),
}

// -- Statements --

pub struct MatchArm {
    pattern: Pattern,
    body: Vec<Heap<Stmt>>,
}

pub enum Stmt {
    LetDecl(string, Option<MiloType>, Heap<ExprNode>, Option<Span>),
    VarDecl(string, Option<MiloType>, Heap<ExprNode>, Option<Span>),
    Assign(Heap<ExprNode>, Heap<ExprNode>, Option<Span>),
    Return(Option<Heap<ExprNode>>, Option<Span>),
    IfStmt(Heap<ExprNode>, Vec<Heap<Stmt>>, Option<Vec<Heap<Stmt>>>, Option<Span>),
    WhileStmt(Heap<ExprNode>, Vec<Heap<Stmt>>, Option<Span>),
    ExprStmt(Heap<ExprNode>, Option<Span>),
    MatchStmt(Heap<ExprNode>, Vec<MatchArm>, Option<Span>),
    BreakStmt(Option<Span>),
    ContinueStmt(Option<Span>),
    IfLetStmt(Heap<Pattern>, Heap<ExprNode>, Vec<Heap<Stmt>>, Option<Vec<Heap<Stmt>>>, Option<Span>),
    UnsafeBlock(Vec<Heap<Stmt>>, Option<Span>),
    ForInStmt(string, Option<string>, Heap<ExprNode>, Vec<Heap<Stmt>>, Option<Span>),
}

// -- Top-level declarations --

pub struct StructDecl {
    name: string,
    typeParams: Vec<TypeParam>,
    fields: Vec<StructField>,
    attributes: Vec<Attribute>,
}

pub struct EnumVariant {
    name: string,
    fields: Vec<MiloType>,
    // `LDA = 169` on an integer-repr enum. None means "one past the previous variant",
    // which is also how counting RESUMES after an explicit value (`STA = 141, NOP` puts
    // NOP at 142). Dropping this gave every variant its positional index, so a C-like
    // enum compiled to plausible-looking wrong numbers.
    discriminant: Option<i64>,
}

pub struct EnumDecl {
    name: string,
    typeParams: Vec<TypeParam>,
    variants: Vec<EnumVariant>,
    attributes: Vec<Attribute>,
}

pub struct Function {
    name: string,
    typeParams: Vec<TypeParam>,
    params: Vec<Param>,
    retType: MiloType,
    body: Vec<Heap<Stmt>>,
    isExtern: bool,
    isVariadic: bool,
    // `@wrapping` (direct) or inherited from a file-level `@!wrapping` directive —
    // see parser.milo's top-level loop. Only "wrapping" is ever populated here;
    // synthesized functions (monomorphized instances, trait-derived methods) default
    // to empty, which is the safe direction (checked arithmetic, not silently wrapping).
    attributes: Vec<Attribute>,
}

pub struct ImportDecl {
    path: string,
    names: Option<Vec<string>>,
    // Index-aligned with `names`' inner Vec (empty when names is None). `import {
    // foo as bar }` binds the real declared `foo` under the local name `bar` —
    // Option.None at an index means that name has no alias. See ast.milo's
    // renameExpr/renameStmt and resolver.milo's mergeImportedFile for where the
    // binding is actually realized (a rewrite of the importing file's own AST).
    aliases: Vec<Option<string>>,
    span: Option<Span>,
}

pub struct TraitMethod {
    name: string,
    params: Vec<Param>,
    retType: MiloType,
    body: Option<Vec<Heap<Stmt>>>,
    span: Option<Span>,
}

pub struct TraitDecl {
    name: string,
    typeParams: Vec<TypeParam>,
    supertraits: Vec<string>,
    methods: Vec<TraitMethod>,
    span: Option<Span>,
}

pub struct ImplDecl {
    traitName: Option<string>,
    typeName: string,
    typeParams: Vec<TypeParam>,
    methods: Vec<Function>,
    isUnsafe: bool,
    span: Option<Span>,
}

// Module-scope `let NAME: T = <const>` — a global constant. Codegen emits it as
// an LLVM global with a constant initializer; references load it.
pub struct GlobalDecl {
    name: string,
    ty: Option<MiloType>,
    value: Heap<ExprNode>,
    mutable: bool,
    span: Option<Span>,
}

// `type Name = i32(min..max)` — a named refinement alias over a base int type.
// The range is advisory (parsed, not yet enforced); the alias resolves to `base`.
pub struct TypeAlias {
    name: string,
    base: MiloType,
}

pub struct Program {
    structs: Vec<StructDecl>,
    enums: Vec<EnumDecl>,
    functions: Vec<Function>,
    imports: Vec<ImportDecl>,
    traits: Vec<TraitDecl>,
    impls: Vec<ImplDecl>,
    globals: Vec<GlobalDecl>,
    typeAliases: Vec<TypeAlias>,
    // Libraries named by `@link("SDL2")`. A module declares what it needs to link
    // against, and the resolver unions these across every imported file — the
    // attribute usually sits in the binding module (a package's lib.milo), not in
    // the program that imports it. Without this the driver had no way to learn
    // about SDL2 at all and every SDL example died at link with undefined symbols.
    linkLibs: Vec<string>,
    // Names of the top-level `fn`/`let`/`var` decls written `pub`, in this ONE file.
    // milo0 has no visibility check (that is oracle-only), so this is the only trace
    // of `pub` it keeps; the resolver reads it to scope a std module's PRIVATE values
    // to that module (`<module>$<name>`), mirroring src/resolver.ts stage 4.
    pubNames: Vec<string>,
    // Parse errors accumulated while producing this Program, in source order. The
    // resolver concatenates the lists of every file it merges, so a broken import is
    // as fatal as a broken entry file. Non-empty means the AST is a guess: the driver
    // renders these and stops before type-checking.
    parseDiagnostics: Vec<Diagnostic>,
}

// -- Clone impls --
// Modern Milo has no auto-derive for Clone; deep clones below are hand-written.
// Span carries an owned `file` string (not Copy), and Option<Span> is not Copy
// either — generic enum instantiations can't have methods — hence the free
// helper fn.

pub fn cloneSpan(sp: &Option<Span>): Option<Span> {
    match sp {
        Option.Some(s) => {
            return Option.Some(Span {
                line: s.line, col: s.col, file: s.file.clone()
            })
        }
        Option.None => {
            return Option.None
        }
    }
}

// Same reason as cloneSpan: Diagnostic holds an Option<Span>, so it has no derived
// `.clone()`.
pub fn cloneDiagnostic(d: &Diagnostic): Diagnostic {
    return Diagnostic {
        severity: d.severity.clone(),
        message: d.message.clone(),
        hint: d.hint.clone(),
        span: cloneSpan(d.span),
    }
}

pub fn cloneGlobal(g: &GlobalDecl): GlobalDecl {
    var ty: Option<MiloType> = Option.None
    match g.ty {
        Option.Some(t) => {
            ty = Option.Some(t.clone())
        }
        Option.None => {
        }
    }
    return GlobalDecl {
        name: g.name.clone(),
        ty: ty,
        value: Heap((*g.value).clone()),
        mutable: g.mutable,
        span: cloneSpan(g.span),
    }
}

pub fn cloneOptI64(o: &Option<i64>): Option<i64> {
    match o {
        Option.Some(n) => {
            return Option.Some(n)
        }
        Option.None => {
            return Option.None
        }
    }
}

pub fn cloneOptString(o: &Option<string>): Option<string> {
    match o {
        Option.Some(s) => {
            return Option.Some(s.clone())
        }
        Option.None => {
            return Option.None
        }
    }
}

pub fn cloneStrings(v: &Vec<string>): Vec<string> {
    var out: Vec<string> = Vec.new()
    for i in 0..v.len {
        out.push(v[i].clone())
    }
    return out
}

pub fn cloneTypes(v: &Vec<MiloType>): Vec<MiloType> {
    var out: Vec<MiloType> = Vec.new()
    for i in 0..v.len {
        out.push(v[i].clone())
    }
    return out
}

pub fn cloneExprs(v: &Vec<Heap<ExprNode>>): Vec<Heap<ExprNode>> {
    var out: Vec<Heap<ExprNode>> = Vec.new()
    for i in 0..v.len {
        out.push(Heap((*v[i]).clone()))
    }
    return out
}

pub fn cloneStmts(v: &Vec<Heap<Stmt>>): Vec<Heap<Stmt>> {
    var out: Vec<Heap<Stmt>> = Vec.new()
    for i in 0..v.len {
        out.push(Heap((*v[i]).clone()))
    }
    return out
}

pub fn cloneOptStmts(o: &Option<Vec<Heap<Stmt>>>): Option<Vec<Heap<Stmt>>> {
    match o {
        Option.Some(v) => {
            return Option.Some(cloneStmts(v))
        }
        Option.None => {
            return Option.None
        }
    }
}

pub fn cloneOptType(o: &Option<MiloType>): Option<MiloType> {
    match o {
        Option.Some(t) => {
            return Option.Some(t.clone())
        }
        Option.None => {
            return Option.None
        }
    }
}

// Element type of an array MiloType — same name/typeArgs, array-ness stripped.
// Struct-field registration uses this to build the inline `[N]elem` layout marker.
pub fn arrayElemType(ty: &MiloType): MiloType {
    var e = ty.clone()
    e.isArray = false
    e.arraySize = Option.None
    return e
}

impl Clone for MiloType {
    fn clone(self: &Self): Self {
        var fnRet: Option<Heap<MiloType>> = Option.None
        match self.fnRet {
            Option.Some(r) => {
                fnRet = Option.Some(Heap((*r).clone()))
            }
            Option.None => {
            }
        }
        return MiloType {
            name: self.name.clone(),
            typeArgs: cloneTypes(self.typeArgs),
            ptrDepth: self.ptrDepth,
            isRef: self.isRef,
            isRefMut: self.isRefMut,
            isArray: self.isArray,
            arraySize: cloneOptI64(self.arraySize),
            isFn: self.isFn,
            isMoveFn: self.isMoveFn,
            fnParams: cloneTypes(self.fnParams),
            fnRet: fnRet,
            rangeMin: cloneOptI64(self.rangeMin),
            rangeMax: cloneOptI64(self.rangeMax),
        }
    }
}

impl Clone for Param {
    fn clone(self: &Self): Self {
        return Param {
            name: self.name.clone(), ty: self.ty.clone()
        }
    }
}

impl Clone for StructField {
    fn clone(self: &Self): Self {
        var attributes: Vec<Attribute> = Vec.new()
        for i in 0..self.attributes.len {
            attributes.push(self.attributes[i].clone())
        }
        return StructField {
            name: self.name.clone(), ty: self.ty.clone(), attributes: attributes
        }
    }
}

impl Clone for TypeParam {
    fn clone(self: &Self): Self {
        return TypeParam {
            name: self.name.clone(), bounds: cloneStrings(self.bounds)
        }
    }
}

impl Clone for Attribute {
    fn clone(self: &Self): Self {
        return Attribute {
            name: self.name.clone(), args: cloneStrings(self.args)
        }
    }
}

impl Clone for StructLitField {
    fn clone(self: &Self): Self {
        return StructLitField {
            name: self.name.clone(), value: Heap((*self.value).clone())
        }
    }
}

impl Clone for Pattern {
    fn clone(self: &Self): Self {
        match self {
            Pattern.EnumPattern(enumName, variant, bindings, span) => {
                return Pattern.EnumPattern(enumName.clone(), variant.clone(), cloneStrings(bindings), cloneSpan(span))
            }
            Pattern.LiteralPattern(value, kind, span) => {
                return Pattern.LiteralPattern(value.clone(), kind, cloneSpan(span))
            }
            Pattern.WildcardPattern(span) => {
                return Pattern.WildcardPattern(cloneSpan(span))
            }
        }
    }
}

impl Clone for ExprNode {
    fn clone(self: &Self): Self {
        // A cloned node is a NEW node and takes a NEW id. Copying the id would let two
        // distinct expressions collide in any map keyed by it — and every caller here
        // (monomorphization instantiating a generic body, renameExpr, derive-generated
        // code) wants a fresh subtree, never an alias. There is no caller that wants the
        // id preserved, so this is the safe direction to fail in.
        let id = freshExprId()
        copyExplicitMut(self.id, id)
        return ExprNode {
            id: id, kind: self.kind.clone(), span: cloneSpan(self.span)
        }
    }
}

impl Clone for Expr {
    fn clone(self: &Self): Self {
        match self {
            Expr.IntLit(val) => {
                return Expr.IntLit(val)
            }
            Expr.FloatLit(val) => {
                return Expr.FloatLit(val)
            }
            Expr.BoolLit(val) => {
                return Expr.BoolLit(val)
            }
            Expr.StringLit(val) => {
                return Expr.StringLit(val.clone())
            }
            Expr.CharLit(val) => {
                return Expr.CharLit(val)
            }
            Expr.Ident(name) => {
                return Expr.Ident(name.clone())
            }
            Expr.BinOp(op, left, right) => {
                return Expr.BinOp(op.clone(), Heap((*left).clone()), Heap((*right).clone()))
            }
            Expr.UnaryOp(op, operand) => {
                return Expr.UnaryOp(op.clone(), Heap((*operand).clone()))
            }
            Expr.Call(func, args, typeArgs) => {
                return Expr.Call(func.clone(), cloneExprs(args), cloneTypes(typeArgs))
            }
            Expr.StructLit(name, fields) => {
                var fs: Vec<StructLitField> = Vec.new()
                for i in 0..fields.len {
                    fs.push(fields[i].clone())
                }
                return Expr.StructLit(name.clone(), fs)
            }
            Expr.JsonObject(fields) => {
                var fs: Vec<StructLitField> = Vec.new()
                for i in 0..fields.len {
                    fs.push(fields[i].clone())
                }
                return Expr.JsonObject(fs)
            }
            Expr.FieldAccess(obj, field) => {
                return Expr.FieldAccess(Heap((*obj).clone()), field.clone())
            }
            Expr.ArrayLit(elems) => {
                return Expr.ArrayLit(cloneExprs(elems))
            }
            Expr.ArrayRepeat(value, count) => {
                return Expr.ArrayRepeat(Heap((*value).clone()), count)
            }
            Expr.IndexAccess(obj, index) => {
                return Expr.IndexAccess(Heap((*obj).clone()), Heap((*index).clone()))
            }
            Expr.EnumLit(enumName, variant, args) => {
                return Expr.EnumLit(enumName.clone(), variant.clone(), cloneExprs(args))
            }
            Expr.Unwrap(operand) => {
                return Expr.Unwrap(Heap((*operand).clone()))
            }
            Expr.Propagate(operand) => {
                return Expr.Propagate(Heap((*operand).clone()))
            }
            Expr.DefaultValue(operand, default) => {
                return Expr.DefaultValue(Heap((*operand).clone()), Heap((*default).clone()))
            }
            Expr.CastExpr(operand, targetType) => {
                return Expr.CastExpr(Heap((*operand).clone()), targetType.clone())
            }
            Expr.MethodCall(obj, method, args) => {
                return Expr.MethodCall(Heap((*obj).clone()), method.clone(), cloneExprs(args))
            }
            Expr.Closure(params, retType, body, isMove) => {
                var ps: Vec<Param> = Vec.new()
                for i in 0..params.len {
                    ps.push(params[i].clone())
                }
                return Expr.Closure(ps, cloneOptType(retType), cloneStmts(body), isMove)
            }
            Expr.RangeExpr(start, end) => {
                return Expr.RangeExpr(Heap((*start).clone()), Heap((*end).clone()))
            }
            Expr.IfExpr(cond, thenBody, elseBody) => {
                return Expr.IfExpr(Heap((*cond).clone()), cloneStmts(thenBody), cloneStmts(elseBody))
            }
            Expr.IsExpr(subject, pattern) => {
                return Expr.IsExpr(Heap((*subject).clone()), Heap((*pattern).clone()))
            }
            Expr.MatchExpr(subject, arms) => {
                var armsOut: Vec<MatchArm> = Vec.new()
                for i in 0..arms.len {
                    armsOut.push(arms[i].clone())
                }
                return Expr.MatchExpr(Heap((*subject).clone()), armsOut)
            }
        }
    }
}

impl Clone for MatchArm {
    fn clone(self: &Self): Self {
        return MatchArm {
            pattern: self.pattern.clone(), body: cloneStmts(self.body)
        }
    }
}

impl Clone for Stmt {
    fn clone(self: &Self): Self {
        match self {
            Stmt.LetDecl(name, typeAnno, value, span) => {
                return Stmt.LetDecl(name.clone(), cloneOptType(typeAnno), Heap((*value).clone()), cloneSpan(span))
            }
            Stmt.VarDecl(name, typeAnno, value, span) => {
                return Stmt.VarDecl(name.clone(), cloneOptType(typeAnno), Heap((*value).clone()), cloneSpan(span))
            }
            Stmt.Assign(target, value, span) => {
                return Stmt.Assign(Heap((*target).clone()), Heap((*value).clone()), cloneSpan(span))
            }
            Stmt.Return(value, span) => {
                var v: Option<Heap<ExprNode>> = Option.None
                match value {
                    Option.Some(e) => {
                        v = Option.Some(Heap((*e).clone()))
                    }
                    Option.None => {
                    }
                }
                return Stmt.Return(v, cloneSpan(span))
            }
            Stmt.IfStmt(cond, thenBody, elseBody, span) => {
                return Stmt.IfStmt(Heap((*cond).clone()), cloneStmts(thenBody), cloneOptStmts(elseBody), cloneSpan(span))
            }
            Stmt.WhileStmt(cond, body, span) => {
                return Stmt.WhileStmt(Heap((*cond).clone()), cloneStmts(body), cloneSpan(span))
            }
            Stmt.ExprStmt(expr, span) => {
                return Stmt.ExprStmt(Heap((*expr).clone()), cloneSpan(span))
            }
            Stmt.MatchStmt(subject, arms, span) => {
                var armsOut: Vec<MatchArm> = Vec.new()
                for i in 0..arms.len {
                    armsOut.push(arms[i].clone())
                }
                return Stmt.MatchStmt(Heap((*subject).clone()), armsOut, cloneSpan(span))
            }
            Stmt.BreakStmt(span) => {
                return Stmt.BreakStmt(cloneSpan(span))
            }
            Stmt.ContinueStmt(span) => {
                return Stmt.ContinueStmt(cloneSpan(span))
            }
            Stmt.IfLetStmt(pattern, subject, thenBody, elseBody, span) => {
                return Stmt.IfLetStmt(Heap((*pattern).clone()), Heap((*subject).clone()), cloneStmts(thenBody), cloneOptStmts(elseBody), cloneSpan(span))
            }
            Stmt.UnsafeBlock(body, span) => {
                return Stmt.UnsafeBlock(cloneStmts(body), cloneSpan(span))
            }
            Stmt.ForInStmt(varName, idxName, iterable, body, span) => {
                return Stmt.ForInStmt(varName.clone(), cloneOptString(idxName), Heap((*iterable).clone()), cloneStmts(body), cloneSpan(span))
            }
        }
    }
}

// -- Import-alias rename --
//
// `from "std/fs" import { readFile as readFileRaw }` binds a LOCAL name to a
// REAL declared one. src-milo merges every module into one flat global
// namespace with no per-package mangling (see resolver.milo — there is no
// mangled prefix to redirect an alias to, unlike the oracle's
// src/mangle.ts), so the alias is realized here instead: every reference to
// it in the IMPORTING FILE's own AST is rewritten to the real name, once,
// right after that file is parsed and before it is merged into the Program.
// Everything downstream (checker, lowering, codegen) then sees only the real
// name and needs no alias awareness of its own.
//
// This is otherwise a plain structural clone (mirrors the Clone impls right
// above) — the only two arms that actually substitute are Ident and Call,
// since both a plain call (`readFileRaw(...)`) and a namespace-style static
// call (`M.clampI64(...)`, whose receiver parses as an ordinary Expr.Ident)
// bottom out in one of those two shapes. Scoped to Stmt/Expr trees (function
// bodies, global initializers) — type-position uses (`let x: Alias = …`)
// are not rewritten; nothing in this compiler's own source needs that yet.
pub fn renameExprs(v: &Vec<Heap<ExprNode>>, from: &string, to: &string): Vec<Heap<ExprNode>> {
    var out: Vec<Heap<ExprNode>> = Vec.new()
    for i in 0..v.len {
        let n = renameExpr(*v[i], from, to)
        copyExplicitMut((*v[i]).id, (*n).id)
        out.push(n)
    }
    return out
}

pub fn renameStmts(v: &Vec<Heap<Stmt>>, from: &string, to: &string): Vec<Heap<Stmt>> {
    var out: Vec<Heap<Stmt>> = Vec.new()
    for i in 0..v.len {
        out.push(Heap(renameStmt(*v[i], from, to)))
    }
    return out
}

pub fn renameOptStmts(o: &Option<Vec<Heap<Stmt>>>, from: &string, to: &string): Option<Vec<Heap<Stmt>>> {
    match o {
        Option.Some(b) => {
            return Option.Some(renameStmts(b, from, to))
        }
        Option.None => {
            return Option.None
        }
    }
}

pub fn renameMatchArm(a: &MatchArm, from: &string, to: &string): MatchArm {
    return MatchArm {
        pattern: a.pattern.clone(), body: renameStmts(a.body, from, to)
    }
}

// Returns a fresh node tree. The rename is a rewrite, not an edit in place, so the
// result gets new ids the same way any other rebuilt subtree does.
pub fn renameExpr(e: &ExprNode, from: &string, to: &string): Heap<ExprNode> {
    let sp = cloneSpan(e.span)
    match e.kind {
        Expr.IntLit(val) => {
            return mkExpr(Expr.IntLit(val), sp)
        }
        Expr.FloatLit(val) => {
            return mkExpr(Expr.FloatLit(val), sp)
        }
        Expr.BoolLit(val) => {
            return mkExpr(Expr.BoolLit(val), sp)
        }
        Expr.StringLit(val) => {
            return mkExpr(Expr.StringLit(val.clone()), sp)
        }
        Expr.CharLit(val) => {
            return mkExpr(Expr.CharLit(val), sp)
        }
        Expr.Ident(name) => {
            var n = name.clone()
            if name == from {
                n = to.clone()
            }
            return mkExpr(Expr.Ident(n), sp)
        }
        Expr.BinOp(op, left, right) => {
            return mkExpr(Expr.BinOp(op.clone(), renameExpr(*left, from, to), renameExpr(*right, from, to)), sp)
        }
        Expr.UnaryOp(op, operand) => {
            return mkExpr(Expr.UnaryOp(op.clone(), renameExpr(*operand, from, to)), sp)
        }
        Expr.Call(func, args, typeArgs) => {
            var funcName = func.clone()
            if func == from {
                funcName = to.clone()
            }
            return mkExpr(Expr.Call(funcName, renameExprs(args, from, to), cloneTypes(typeArgs)), sp)
        }
        Expr.StructLit(name, fields) => {
            var n = name.clone()
            if name == from {
                n = to.clone()
            }
            var fs: Vec<StructLitField> = Vec.new()
            for i in 0..fields.len {
                fs.push(StructLitField {
                    name: fields[i].name.clone(), value: renameExpr(*fields[i].value, from, to)
                })
            }
            return mkExpr(Expr.StructLit(n, fs), sp)
        }
        Expr.JsonObject(fields) => {
            var fs: Vec<StructLitField> = Vec.new()
            for i in 0..fields.len {
                fs.push(StructLitField {
                    name: fields[i].name.clone(), value: renameExpr(*fields[i].value, from, to)
                })
            }
            return mkExpr(Expr.JsonObject(fs), sp)
        }
        Expr.FieldAccess(obj, field) => {
            return mkExpr(Expr.FieldAccess(renameExpr(*obj, from, to), field.clone()), sp)
        }
        Expr.ArrayLit(elems) => {
            return mkExpr(Expr.ArrayLit(renameExprs(elems, from, to)), sp)
        }
        Expr.ArrayRepeat(value, count) => {
            return mkExpr(Expr.ArrayRepeat(renameExpr(*value, from, to), count), sp)
        }
        Expr.IndexAccess(obj, index) => {
            return mkExpr(Expr.IndexAccess(renameExpr(*obj, from, to), renameExpr(*index, from, to)), sp)
        }
        Expr.EnumLit(enumName, variant, args) => {
            var en = enumName.clone()
            if enumName == from {
                en = to.clone()
            }
            return mkExpr(Expr.EnumLit(en, variant.clone(), renameExprs(args, from, to)), sp)
        }
        Expr.Unwrap(operand) => {
            return mkExpr(Expr.Unwrap(renameExpr(*operand, from, to)), sp)
        }
        Expr.Propagate(operand) => {
            return mkExpr(Expr.Propagate(renameExpr(*operand, from, to)), sp)
        }
        Expr.DefaultValue(operand, default) => {
            return mkExpr(Expr.DefaultValue(renameExpr(*operand, from, to), renameExpr(*default, from, to)), sp)
        }
        Expr.CastExpr(operand, targetType) => {
            return mkExpr(Expr.CastExpr(renameExpr(*operand, from, to), targetType.clone()), sp)
        }
        Expr.MethodCall(obj, method, args) => {
            return mkExpr(Expr.MethodCall(renameExpr(*obj, from, to), method.clone(), renameExprs(args, from, to)), sp)
        }
        Expr.Closure(params, retType, body, isMove) => {
            var ps: Vec<Param> = Vec.new()
            for i in 0..params.len {
                ps.push(params[i].clone())
            }
            return mkExpr(Expr.Closure(ps, cloneOptType(retType), renameStmts(body, from, to), isMove), sp)
        }
        Expr.RangeExpr(start, end) => {
            return mkExpr(Expr.RangeExpr(renameExpr(*start, from, to), renameExpr(*end, from, to)), sp)
        }
        Expr.IfExpr(cond, thenBody, elseBody) => {
            return mkExpr(Expr.IfExpr(renameExpr(*cond, from, to), renameStmts(thenBody, from, to), renameStmts(elseBody, from, to)), sp)
        }
        Expr.IsExpr(subject, pattern) => {
            return mkExpr(Expr.IsExpr(renameExpr(*subject, from, to), Heap((*pattern).clone())), sp)
        }
        Expr.MatchExpr(subject, arms) => {
            var armsOut: Vec<MatchArm> = Vec.new()
            for i in 0..arms.len {
                armsOut.push(renameMatchArm(arms[i], from, to))
            }
            return mkExpr(Expr.MatchExpr(renameExpr(*subject, from, to), armsOut), sp)
        }
    }
}

pub fn renameStmt(s: &Stmt, from: &string, to: &string): Stmt {
    match s {
        Stmt.LetDecl(name, typeAnno, value, span) => {
            return Stmt.LetDecl(name.clone(), cloneOptType(typeAnno), (renameExpr(*value, from, to)), cloneSpan(span))
        }
        Stmt.VarDecl(name, typeAnno, value, span) => {
            return Stmt.VarDecl(name.clone(), cloneOptType(typeAnno), (renameExpr(*value, from, to)), cloneSpan(span))
        }
        Stmt.Assign(target, value, span) => {
            return Stmt.Assign((renameExpr(*target, from, to)), (renameExpr(*value, from, to)), cloneSpan(span))
        }
        Stmt.Return(value, span) => {
            var v: Option<Heap<ExprNode>> = Option.None
            match value {
                Option.Some(e) => {
                    v = Option.Some((renameExpr(*e, from, to)))
                }
                Option.None => {
                }
            }
            return Stmt.Return(v, cloneSpan(span))
        }
        Stmt.IfStmt(cond, thenBody, elseBody, span) => {
            return Stmt.IfStmt((renameExpr(*cond, from, to)), renameStmts(thenBody, from, to), renameOptStmts(elseBody, from, to), cloneSpan(span))
        }
        Stmt.WhileStmt(cond, body, span) => {
            return Stmt.WhileStmt((renameExpr(*cond, from, to)), renameStmts(body, from, to), cloneSpan(span))
        }
        Stmt.ExprStmt(expr, span) => {
            return Stmt.ExprStmt((renameExpr(*expr, from, to)), cloneSpan(span))
        }
        Stmt.MatchStmt(subject, arms, span) => {
            var armsOut: Vec<MatchArm> = Vec.new()
            for i in 0..arms.len {
                armsOut.push(renameMatchArm(arms[i], from, to))
            }
            return Stmt.MatchStmt((renameExpr(*subject, from, to)), armsOut, cloneSpan(span))
        }
        Stmt.BreakStmt(span) => {
            return Stmt.BreakStmt(cloneSpan(span))
        }
        Stmt.ContinueStmt(span) => {
            return Stmt.ContinueStmt(cloneSpan(span))
        }
        Stmt.IfLetStmt(pattern, subject, thenBody, elseBody, span) => {
            return Stmt.IfLetStmt(Heap((*pattern).clone()), (renameExpr(*subject, from, to)), renameStmts(thenBody, from, to), renameOptStmts(elseBody, from, to), cloneSpan(span))
        }
        Stmt.UnsafeBlock(body, span) => {
            return Stmt.UnsafeBlock(renameStmts(body, from, to), cloneSpan(span))
        }
        Stmt.ForInStmt(varName, idxName, iterable, body, span) => {
            return Stmt.ForInStmt(varName.clone(), cloneOptString(idxName), (renameExpr(*iterable, from, to)), renameStmts(body, from, to), cloneSpan(span))
        }
    }
}

// Function/global counterparts of renameStmt/renameExpr above — applied by the
// resolver when merging a file that imports under an alias (see resolver.milo's
// mergeImportedFile). Only these two decl kinds are covered: the compiler's own
// source has exactly one `as`-alias import today (src-milo/lsp/diagnostics.milo),
// used from a plain function body. Impl/trait method bodies are NOT rewritten —
// if an alias is ever used from inside one, it will surface as an "undefined
// function" here rather than silently doing the wrong thing.
pub fn renameFunction(f: &Function, from: &string, to: &string): Function {
    var typeParams: Vec<TypeParam> = Vec.new()
    for i in 0..f.typeParams.len {
        typeParams.push(f.typeParams[i].clone())
    }
    var params: Vec<Param> = Vec.new()
    for i in 0..f.params.len {
        params.push(f.params[i].clone())
    }
    var attributes: Vec<Attribute> = Vec.new()
    for i in 0..f.attributes.len {
        attributes.push(f.attributes[i].clone())
    }
    return Function {
        name: f.name.clone(),
        typeParams: typeParams,
        params: params,
        retType: f.retType.clone(),
        body: renameStmts(f.body, from, to),
        isExtern: f.isExtern,
        isVariadic: f.isVariadic,
        attributes: attributes,
    }
}

pub fn renameGlobal(g: &GlobalDecl, from: &string, to: &string): GlobalDecl {
    var ty: Option<MiloType> = Option.None
    match g.ty {
        Option.Some(t) => {
            ty = Option.Some(t.clone())
        }
        Option.None => {
        }
    }
    return GlobalDecl {
        name: g.name.clone(),
        ty: ty,
        value: (renameExpr(*g.value, from, to)),
        mutable: g.mutable,
        span: cloneSpan(g.span),
    }
}

impl Clone for StructDecl {
    fn clone(self: &Self): Self {
        var typeParams: Vec<TypeParam> = Vec.new()
        for i in 0..self.typeParams.len {
            typeParams.push(self.typeParams[i].clone())
        }
        var fields: Vec<StructField> = Vec.new()
        for i in 0..self.fields.len {
            fields.push(self.fields[i].clone())
        }
        var attributes: Vec<Attribute> = Vec.new()
        for i in 0..self.attributes.len {
            attributes.push(self.attributes[i].clone())
        }
        return StructDecl {
            name: self.name.clone(), typeParams: typeParams, fields: fields, attributes: attributes
        }
    }
}

impl Clone for EnumVariant {
    fn clone(self: &Self): Self {
        return EnumVariant {
            name: self.name.clone(), fields: cloneTypes(self.fields), discriminant: cloneOptI64(self.discriminant)
        }
    }
}

impl Clone for EnumDecl {
    fn clone(self: &Self): Self {
        var typeParams: Vec<TypeParam> = Vec.new()
        for i in 0..self.typeParams.len {
            typeParams.push(self.typeParams[i].clone())
        }
        var variants: Vec<EnumVariant> = Vec.new()
        for i in 0..self.variants.len {
            variants.push(self.variants[i].clone())
        }
        var attributes: Vec<Attribute> = Vec.new()
        for i in 0..self.attributes.len {
            attributes.push(self.attributes[i].clone())
        }
        return EnumDecl {
            name: self.name.clone(), typeParams: typeParams, variants: variants, attributes: attributes
        }
    }
}

impl Clone for Function {
    fn clone(self: &Self): Self {
        var typeParams: Vec<TypeParam> = Vec.new()
        for i in 0..self.typeParams.len {
            typeParams.push(self.typeParams[i].clone())
        }
        var params: Vec<Param> = Vec.new()
        for i in 0..self.params.len {
            params.push(self.params[i].clone())
        }
        var attributes: Vec<Attribute> = Vec.new()
        for i in 0..self.attributes.len {
            attributes.push(self.attributes[i].clone())
        }
        return Function {
            name: self.name.clone(),
            typeParams: typeParams,
            params: params,
            retType: self.retType.clone(),
            body: cloneStmts(self.body),
            isExtern: self.isExtern,
            isVariadic: self.isVariadic,
            attributes: attributes,
        }
    }
}

pub fn cloneParams(v: &Vec<Param>): Vec<Param> {
    var out: Vec<Param> = Vec.new()
    for i in 0..v.len {
        out.push(v[i].clone())
    }
    return out
}

pub fn cloneTypeParams(v: &Vec<TypeParam>): Vec<TypeParam> {
    var out: Vec<TypeParam> = Vec.new()
    for i in 0..v.len {
        out.push(v[i].clone())
    }
    return out
}

impl Clone for TraitMethod {
    fn clone(self: &Self): Self {
        var body: Option<Vec<Heap<Stmt>>> = Option.None
        match self.body {
            Option.Some(b) => {
                body = Option.Some(cloneStmts(b))
            }
            Option.None => {
                body = Option.None
            }
        }
        return TraitMethod {
            name: self.name.clone(),
            params: cloneParams(self.params),
            retType: self.retType.clone(),
            body: body,
            span: cloneSpan(self.span),
        }
    }
}

impl Clone for TraitDecl {
    fn clone(self: &Self): Self {
        var supertraits: Vec<string> = Vec.new()
        for i in 0..self.supertraits.len {
            supertraits.push(self.supertraits[i].clone())
        }
        var methods: Vec<TraitMethod> = Vec.new()
        for i in 0..self.methods.len {
            methods.push(self.methods[i].clone())
        }
        return TraitDecl {
            name: self.name.clone(),
            typeParams: cloneTypeParams(self.typeParams),
            supertraits: supertraits,
            methods: methods,
            span: cloneSpan(self.span),
        }
    }
}

impl Clone for ImplDecl {
    fn clone(self: &Self): Self {
        var traitName: Option<string> = Option.None
        match self.traitName {
            Option.Some(n) => {
                traitName = Option.Some(n.clone())
            }
            Option.None => {
                traitName = Option.None
            }
        }
        var methods: Vec<Function> = Vec.new()
        for i in 0..self.methods.len {
            methods.push(self.methods[i].clone())
        }
        return ImplDecl {
            traitName: traitName,
            typeName: self.typeName.clone(),
            typeParams: cloneTypeParams(self.typeParams),
            methods: methods,
            isUnsafe: self.isUnsafe,
            span: cloneSpan(self.span),
        }
    }
}
