// Diagnostics backend for the LSP server.
//
// This does NOT run the lexer/parser/checker in-process. src-milo/lexer.milo's
// lexError calls exit(1) directly on a lex failure (unterminated string, bad
// byte, …) — ordinary mid-typing states. An in-process check of a live buffer
// would take the whole LSP session down on exactly the input a user is most
// likely to type. Instead every validation shells out to a fresh, guarded
// `milo-self check-lsp <buffer-file> <doc-path>` (see the check-lsp branch in
// src-milo/main.milo for the pipeline and its JSON output shape) — a crash in
// there only kills that child. Per CRITICAL SAFETY, that spawn goes through
// scripts/guard.ts like every other milo-self invocation.
from "std/fs" import {
    writeFile, pathExists, readFile as readFileRaw
}
from "std/path" import {
    Path
}
from "std/env" import {
    Env
}
from "std/process" import {
    run, exePath
}
from "std/json" import {
    Json
}

pub extern fn getpid(): i32

// One diagnostic ready for LSP publishDiagnostics: 1-based line/col (LSP
// wants 0-based; buildPublishDiagnostics converts), already hoisted to this
// document if it came from an import (see main.milo's diagnosticToJsonObj).
pub struct LspDiagnostic {
    severity: string,
    message: string,
    hint: string,
    line: i64,
    col: i64,
}

// A process-unique scratch path — concurrent didChange validations (or a
// concurrent test run) must never share one file out from under each other.
fn scratchPath(suffix: string): string {
    return "/tmp/milo_lsp_" + getpid().toString() + suffix
}

// Find the repo root the same way main.milo's findStdlibRoot does (MILO_ROOT
// wins, else walk up looking for a landmark) so scripts/guard.ts can be
// found regardless of the server's cwd or install location. Landmark is
// scripts/guard.ts itself, not std/prelude.milo — this walk is locating the
// *tooling* root, not the stdlib root the child process resolves on its own.
fn findRepoRoot(): string {
    match Env.get("MILO_ROOT") {
        Option.Some(root) => {
            return root
        }
        Option.None => {
        }
    }
    var dir = "."
    match exePath() {
        Result.Ok(p) => {
            dir = Path.dirname(p)
        }
        Result.Err(_) => {
        }
    }
    var depth: i64 = 0
    while depth < 32 {
        if pathExists(Path.join(dir.clone(), "scripts/guard.ts")) {
            return dir
        }
        let parent = Path.dirname(dir.clone())
        if parent == dir {
            break
        }
        dir = parent
        depth = depth + 1
    }
    return dir
}

// Run `cmd`, capturing stdout+stderr together regardless of exit code — the
// std/process.capture helper discards output on a nonzero exit, which is
// exactly the case (a crashed check-lsp) this most needs the output from.
// Not std/process's shared "/tmp/.milo_capture" path either: concurrent
// validations would clobber each other's output through it.
fn captureAny(cmd: &string): string {
    let outPath = scratchPath(".out")
    let full = cmd.clone() + " > \"" + outPath + "\" 2>&1"
    let _ = run(full)
    var text = ""
    match readFileText(outPath) {
        Option.Some(s) => {
            text = s
        }
        Option.None => {
        }
    }
    return text
}

// std/fs.readFile returns Result<string, IoError>; collapse to Option since
// callers here only ever fall back on failure, never inspect the error.
fn readFileText(path: string): Option<string> {
    match readFileRaw(path) {
        Result.Ok(s) => {
            return Option.Some(s)
        }
        Result.Err(e) => {
            return Option.None
        }
    }
}

// Extract "error[lex]: LINE:COL: message" — the one lexer-fatal shape
// check-lsp can die before ever printing its JSON array. Manual scan, not
// regex: this repo's self-hosted stdlib has no regex module, and the shape
// is fixed and simple enough that a scan is clearer than escaping it.
fn extractLexError(raw: &string): Option<LspDiagnostic> {
    match raw.indexOf("error[lex]:") {
        Option.Some(idx) => {
            var i = idx + 11
            while i < raw.len && raw[i] == ' ' {
                i = i + 1
            }
            var lineDigits = ""
            while i < raw.len && raw[i] >= '0' && raw[i] <= '9' {
                lineDigits.push(raw[i])
                i = i + 1
            }
            if i >= raw.len || raw[i] != ':' {
                return Option.None
            }
            i = i + 1
            var colDigits = ""
            while i < raw.len && raw[i] >= '0' && raw[i] <= '9' {
                colDigits.push(raw[i])
                i = i + 1
            }
            if i < raw.len && raw[i] == ':' {
                i = i + 1
            }
            while i < raw.len && raw[i] == ' ' {
                i = i + 1
            }
            var msg = ""
            while i < raw.len && raw[i] != '\n' {
                msg.push(raw[i])
                i = i + 1
            }
            var line: i64 = 1
            var col: i64 = 1
            match lineDigits.parseInt() {
                Option.Some(n) => {
                    line = n
                }
                Option.None => {
                }
            }
            match colDigits.parseInt() {
                Option.Some(n) => {
                    col = n
                }
                Option.None => {
                }
            }
            return Option.Some(LspDiagnostic {
                severity: "error", message: msg, hint: "", line: line, col: col
            })
        }
        Option.None => {
            return Option.None
        }
    }
}

fn diagFromJson(item: Json): LspDiagnostic {
    var severity = "error"
    var message = ""
    var hint = ""
    var line: i64 = 1
    var col: i64 = 1
    match item.str("severity") {
        Option.Some(s) => {
            severity = s
        }
        Option.None => {
        }
    }
    match item.str("message") {
        Option.Some(s) => {
            message = s
        }
        Option.None => {
        }
    }
    match item.str("hint") {
        Option.Some(s) => {
            hint = s
        }
        Option.None => {
        }
    }
    match item.i64("line") {
        Option.Some(n) => {
            line = n
        }
        Option.None => {
        }
    }
    match item.i64("col") {
        Option.Some(n) => {
            col = n
        }
        Option.None => {
        }
    }
    return LspDiagnostic {
        severity: severity, message: message, hint: hint, line: line, col: col
    }
}

// Parse check-lsp's captured stdout+stderr. Never returns empty on a failure
// to parse — an LSP that answers "no diagnostics" when it actually could not
// run the checker is a false green light, worse than answering nothing.
pub fn parseCheckLspOutput(raw: string): Vec<LspDiagnostic> {
    var out: Vec<LspDiagnostic> = Vec.new()
    let trimmed = raw.trim()
    if trimmed.len == 0 {
        out.push(LspDiagnostic {
            severity: "warning", message: "milo-self check-lsp produced no output (it may have been killed by the memory/timeout guard)", hint: "", line: 1, col: 1
        })
        return out
    }
    match Json.parse(trimmed.clone()) {
        Result.Ok(j) => {
            if j.isArray() {
                var i: i64 = 0
                while i < j.len() {
                    match j.at(i) {
                        Option.Some(item) => {
                            out.push(diagFromJson(item))
                        }
                        Option.None => {
                        }
                    }
                    i = i + 1
                }
                return out
            }
        }
        Result.Err(_) => {
        }
    }
    match extractLexError(trimmed) {
        Option.Some(d) => {
            out.push(d)
            return out
        }
        Option.None => {
        }
    }
    var firstLine = trimmed.clone()
    match trimmed.indexOf("\n") {
        Option.Some(nl) => {
            firstLine = trimmed.substr(0, nl)
        }
        Option.None => {
        }
    }
    out.push(LspDiagnostic {
        severity: "error", message: "milo-self check failed: " + firstLine, hint: "", line: 1, col: 1
    })
    return out
}

// Validate `source` as `docPath` (a real on-disk-shaped path; only used for
// span labelling and import resolution, not read from disk — `source` is the
// buffer, which may be unsaved). Returns diagnostics ready for
// buildPublishDiagnostics.
pub fn validateDocument(source: string, docPath: string): Vec<LspDiagnostic> {
    let bufPath = scratchPath(".milo")
    let _ = writeFile(bufPath.clone(), source)
    let root = findRepoRoot()
    let guardScript = Path.join(root, "scripts/guard.ts")
    var exe = "milo-self"
    match exePath() {
        Result.Ok(p) => {
            exe = p
        }
        Result.Err(_) => {
        }
    }
    let cmd = "bun \"" + guardScript + "\" --mem-mb 768 --timeout-s 15 -- \"" + exe + "\" check-lsp \"" + bufPath + "\" \"" + docPath + "\""
    let raw = captureAny(cmd)
    return parseCheckLspOutput(raw)
}

fn severityCode(severity: &string): i64 {
    if severity == "error" {
        return 1
    }
    if severity == "warning" {
        return 2
    }
    return 3
}

// Build the `textDocument/publishDiagnostics` notification params, already
// serialized — hand straight to rpc.sendNotification.
pub fn buildPublishDiagnosticsJson(uri: string, diags: &Vec<LspDiagnostic>): string {
    var arr = Json.arr()
    for i in 0..diags.len {
        let d = diags[i]
        let ln = d.line - 1
        let ch = d.col - 1
        var msg = d.message.clone()
        if d.hint.len > 0 {
            msg = msg + "\nhint: " + d.hint.clone()
        }
        let startObj = Json.obj().int("line", ln).int("character", ch)
        let endObj = Json.obj().int("line", ln).int("character", ch + 1)
        let rangeObj = Json.obj().obj("start", startObj).obj("end", endObj)
        let itemObj = Json.obj().obj("range", rangeObj).int("severity", severityCode(d.severity)).str("source", "milo").str("message", msg)
        arr = arr.obj(itemObj)
    }
    let params = Json.obj().str("uri", uri).arr("diagnostics", arr)
    return params.build()
}
