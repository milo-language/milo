// LSP message loop: lifecycle (initialize/initialized/shutdown/exit) and
// document sync (didOpen/didChange/didClose) driving diagnostics publish.
// Mirrors src/lsp.ts's startServer/handleRequest/handleNotification for the
// subset this pass implements. `initialize` advertises no capability beyond
// text sync — hoverProvider/definitionProvider get added only once
// hover.milo/definition.milo exist and are wired in below; advertising a
// capability with no handler behind it is exactly the "answers null and
// looks like it works" trap the brief warns about.
//
// Validation itself is a subprocess (see diagnostics.milo's header): this
// loop never calls the lexer/parser/checker directly, so a lex-fatal buffer
// (src-milo/lexer.milo's lexError calls exit(1)) can never take the server
// down mid-session.
from "std/io" import {
    fdReaderAttach
}
from "src-milo/lsp/rpc.milo" import {
    RpcId, readMessage, parseMessage, sendResponse, sendNotification
}
from "src-milo/lsp/diagnostics.milo" import {
    validateDocument, buildPublishDiagnosticsJson
}
from "src-milo/lsp/util.milo" import {
    uriToPath
}
from "std/json" import {
    Json
}

fn isNotificationId(id: &RpcId): bool {
    match id {
        RpcId.IdNone => {
            return true
        }
        RpcId.IdNum(_n) => {
            return false
        }
        RpcId.IdStr(_s) => {
            return false
        }
    }
}

fn initializeResultJson(): string {
    let caps = Json.obj().int("textDocumentSync", 1)
    let info = Json.obj().str("name", "milod-self").str("version", "0.1.0")
    let result = Json.obj().obj("capabilities", caps).obj("serverInfo", info)
    return result.build()
}

fn validateAndPublish(documents: &HashMap<string, string>, uri: string): void {
    match documents.get(uri.clone()) {
        Option.Some(source) => {
            let docPath = uriToPath(uri)
            let diags = validateDocument(source, docPath)
            let paramsJson = buildPublishDiagnosticsJson(uri, diags)
            sendNotification("textDocument/publishDiagnostics", paramsJson)
        }
        Option.None => {
        }
    }
}

fn handleRequest(id: RpcId, method: string, _params: Json, _hasParams: bool): void {
    if method == "initialize" {
        sendResponse(id, initializeResultJson())
        return
    }
    if method == "shutdown" {
        sendResponse(id, "null")
        return
    }
    // Not implemented this pass — respond null rather than leaving the
    // client's request hanging with no reply at all.
    sendResponse(id, "null")
}

fn handleNotification(documents: &mut HashMap<string, string>, method: string, params: Json, _hasParams: bool): void {
    if method == "initialized" {
        return
    }
    if method == "textDocument/didOpen" {
        var uri = ""
        match params.strPath("textDocument.uri") {
            Option.Some(u) => {
                uri = u
            }
            Option.None => {
                return
            }
        }
        var text = ""
        match params.strPath("textDocument.text") {
            Option.Some(t) => {
                text = t
            }
            Option.None => {
            }
        }
        documents.insert(uri.clone(), text)
        validateAndPublish(documents, uri)
        return
    }
    if method == "textDocument/didChange" {
        var uri = ""
        match params.strPath("textDocument.uri") {
            Option.Some(u) => {
                uri = u
            }
            Option.None => {
                return
            }
        }
        var text = ""
        match params.strPath("contentChanges[0].text") {
            Option.Some(t) => {
                text = t
            }
            Option.None => {
                return
            }
        }
        documents.insert(uri.clone(), text)
        validateAndPublish(documents, uri)
        return
    }
    if method == "textDocument/didClose" {
        match params.strPath("textDocument.uri") {
            Option.Some(u) => {
                documents.remove(u)
            }
            Option.None => {
            }
        }
        return
    }
    if method == "exit" {
        exit(0)
    }
}

pub fn startServer(): void {
    var documents: HashMap<string, string> = HashMap.new()
    let reader = fdReaderAttach(0)
    eprint("milod-self: language server started")
    while true {
        match readMessage(reader) {
            Option.Some(body) => {
                let msg = parseMessage(body)
                if msg.hasMethod {
                    let id = msg.id
                    let method = msg.method
                    let params = msg.params
                    let hasParams = msg.hasParams
                    if isNotificationId(id) {
                        handleNotification(&mut documents, method, params, hasParams)
                    } else {
                        handleRequest(id, method, params, hasParams)
                    }
                }
            }
            Option.None => {
                break
            }
        }
    }
}
