// Import resolver — recursively parse imported files and merge into a single Program

from "std/process" import {
    exit
}
from "std/fs" import {
    pathExists, readFile
}
from "std/path" import {
    Path
}
from "std/env" import {
    Env
}
from "std/json" import {
    Json
}
from "src-milo/tokens.milo" import {
    Token
}
from "src-milo/lexer.milo" import {
    tokenize
}
from "src-milo/parser.milo" import {
    newParser, parse
}
from "src-milo/ast.milo" import {
    Program, StructDecl, EnumDecl, Function, ImportDecl, TraitDecl, ImplDecl,
    GlobalDecl, cloneGlobal, renameFunction, renameGlobal, Diagnostic, cloneDiagnostic,
    Attribute, Pattern, Stmt
}

pub struct ResolverState {
    visited: HashMap<string, bool>,
    structs: Vec<StructDecl>,
    enums: Vec<EnumDecl>,
    functions: Vec<Function>,
    traits: Vec<TraitDecl>,
    impls: Vec<ImplDecl>,
    globals: Vec<GlobalDecl>,
    typeAliases: Vec<TypeAlias>,
    // Unioned across every file in the import graph — see Program.linkLibs.
    linkLibs: Vec<string>,
    stdlibDir: string,
    targetOs: string,
    // The entry project's milo.json `deps` map (package name -> spec, e.g.
    // "github.com/milo-language/milo-gl@v0.2.0"), read ONCE from the entry file's
    // directory upward — mirrors src/resolver.ts, which resolves every import in the
    // whole graph (including a package's own internal imports) against the root
    // project's manifest, not a per-file one. There is no diamond-dependency story.
    deps: HashMap<string, string>,
    // Parse errors collected over every imported file. A broken import is as fatal as
    // a broken entry file — see Program.parseDiagnostics.
    parseDiagnostics: Vec<Diagnostic>,
}

// Entry-file diagnostics first, then everything the import walk collected. Order is
// the reading order a user expects: the file they named, then its dependencies.
pub fn mergeParseDiagnostics(entry: &Vec<Diagnostic>, imported: &Vec<Diagnostic>): Vec<Diagnostic> {
    var out: Vec<Diagnostic> = Vec.new()
    for i in 0..entry.len {
        out.push(cloneDiagnostic(entry[i]))
    }
    for i in 0..imported.len {
        out.push(cloneDiagnostic(imported[i]))
    }
    return out
}

// `@link` names union across the whole import graph, deduped: a package linked by
// two different modules must still produce a single -l flag.
pub fn addLinkLib(rs: &mut ResolverState, name: &string) {
    for i in 0..rs.linkLibs.len {
        if rs.linkLibs[i] == name {
            return
        }
    }
    rs.linkLibs.push(name.clone())
}

pub fn newResolver(stdlibDir: string, targetOs: string, deps: HashMap<string, string>): ResolverState {
    return ResolverState {
        visited: HashMap.new(),
        structs: Vec.new(),
        enums: Vec.new(),
        functions: Vec.new(),
        traits: Vec.new(),
        impls: Vec.new(),
        globals: Vec.new(),
        typeAliases: Vec.new(),
        linkLibs: Vec.new(),
        stdlibDir: stdlibDir,
        targetOs: targetOs,
        deps: deps,
        parseDiagnostics: Vec.new(),
    }
}

// Collapse "." and ".." segments so two different spellings of a path that name the
// SAME file always produce the SAME string. Without this, e.g. reaching a file via
// "a/b/./c.milo" (one import chain) and "a/b/c.milo" (another) leaves the `visited`
// set unable to tell they're the same file — and impls, which have no by-name dedup
// (unlike structs/enums/fns), get merged twice: LLVM then rejects the duplicate
// method definition. See AGENTS.md lane notes on flybyGeometry.
pub fn normalizePath(p: &string): string {
    let absolute = p.len > 0 && p[0] == '/'
    var parts: Vec<string> = Vec.new()
    var start: i64 = 0
    var i: i64 = 0
    while i <= p.len {
        if i == p.len || p[i] == '/' {
            if i > start {
                let seg = p.substr(start, i)
                if seg == "." {
                    // drop: refers to the current segment
                } else if seg == ".." {
                    if parts.len > 0 && parts[parts.len - 1] != ".." {
                        let _ = parts.pop()
                    } else if !absolute {
                        parts.push(seg)
                    }
                    // an absolute path can't climb above root; drop silently, same as
                    // node's path.resolve/normalize.
                } else {
                    parts.push(seg)
                }
            }
            start = i + 1
        }
        i = i + 1
    }
    var result = ""
    for j in 0..parts.len {
        if j > 0 {
            result = result + "/"
        }
        result = result + parts[j]
    }
    if absolute {
        result = "/" + result
    }
    if result.len == 0 {
        if absolute {
            result = "/"
        } else {
            result = "."
        }
    }
    return result
}

// A dependency source spec, parsed. Mirrors src/pkg.ts's `Source` (git variant only —
// this resolver never fetches, so giturl/tarball specs are out of scope; a bare
// git-host-shorthand or local-path spec is all `milo.json` deps use in practice).
pub struct PkgUrl {
    host: string,
    path: string,
    version: string,
}

// Parse "github.com/user/repo@v1.0" or a local "./path[@version]" into host/path/version.
// Mirrors src/resolver.ts:parsePkgUrl exactly (NOT src/pkg.ts:parseSource, which is
// richer but is the installer's own parser and deliberately not what the resolver
// reads by). None means the spec has no '/' and isn't a local path — malformed.
pub fn parsePkgUrl(url: &string): Option<PkgUrl> {
    var version = "main"
    var fullPath = url.clone()
    match url.indexOf("@") {
        Option.Some(atIdx) => {
            version = url.substr(atIdx + 1, url.len)
            fullPath = url.substr(0, atIdx)
        }
        Option.None => {
        }
    }
    if fullPath.len > 0 && (fullPath[0] == '/' || fullPath[0] == '.') {
        let safe = fullPath.replace("/", "_")
        return Option.Some(PkgUrl {
            host: "local", path: safe, version: version
        }
        )
    }
    match fullPath.indexOf("/") {
        Option.Some(slashIdx) => {
            return Option.Some(PkgUrl {
                host: fullPath.substr(0, slashIdx), path: fullPath.substr(slashIdx + 1, fullPath.len), version: version
            }
            )
        }
        Option.None => {
            return Option.None
        }
    }
}

// Root of the extracted-package cache: honors XDG_CACHE_HOME, else ~/.milo/cache.
// MUST stay byte-for-byte in step with src/pkg.ts:cacheRoot — that's what actually
// populated the cache this reads from.
pub fn cacheRoot(): string {
    match Env.get("XDG_CACHE_HOME") {
        Option.Some(xdg) => {
            if xdg.len > 0 {
                return Path.join(xdg, "milo")
            }
        }
        Option.None => {
        }
    }
    let home = Env.getOr("HOME", "")
    return Path.join(Path.join(home, ".milo"), "cache")
}

// Find the nearest milo.json walking up from `startDir` (20-level cap, matching
// src/resolver.ts:findManifest) and return its `deps` map. Empty map — never a hard
// error — when no manifest exists or it declares no deps: a bare import name that
// doesn't match any key here just falls through to local/stdlib resolution below,
// exactly as the TS oracle does.
pub fn findManifestDeps(startDir: string): HashMap<string, string> {
    var deps: HashMap<string, string> = HashMap.new()
    var dir = startDir
    var i: i64 = 0
    while i < 20 {
        let manifestPath = Path.join(dir, "milo.json")
        if pathExists(manifestPath) {
            match readFile(manifestPath) {
                Result.Ok(text) => {
                    match Json.parseJsonc(text) {
                        Result.Ok(doc) => {
                            match doc.get("deps") {
                                Option.Some(depsNode) => {
                                    let keys = depsNode.keys()
                                    for ki in 0..keys.len {
                                        match depsNode.str(keys[ki]) {
                                            Option.Some(v) => {
                                                deps.insert(keys[ki].clone(), v)
                                            }
                                            Option.None => {
                                            }
                                        }
                                    }
                                }
                                Option.None => {
                                }
                            }
                        }
                        Result.Err(_) => {
                        }
                    }
                }
                Result.Err(_) => {
                }
            }
            return deps
        }
        let parent = Path.dirname(dir)
        if parent == dir {
            break
        }
        dir = parent
        i = i + 1
    }
    return deps
}

// Resolve one candidate inside a package's cache directory ("<cacheBase>/<rel>"),
// returning it only if the file actually exists — never a plausible-looking path
// that happens not to be there.
fn pkgCandidate(cacheBase: &string, rel: string): Option<string> {
    let full = Path.join(cacheBase, rel)
    if pathExists(full) {
        return Option.Some(full)
    }
    return Option.None
}

// Resolve a bare `from "pkgName[/sub]" import {...}` against the entry project's
// milo.json deps, reading only what's already in the local package cache — this
// resolver never fetches. Mirrors src/resolver.ts:resolvePath's package branch,
// with ONE deliberate divergence: the TS oracle falls through to local/stdlib
// resolution when the package's manifest entry doesn't resolve to a file on disk;
// this fails closed instead; naming the package and what was expected, rather than
// silently trying a local path that happens to share the name (see AGENTS.md — an
// import resolver that can't find a package must error naming it, never guess).
fn resolvePkgImport(rs: &ResolverState, importPath: &string, pkgName: &string, spec: string): string {
    var parsed = PkgUrl {
        host: "", path: "", version: ""
    }
    match parsePkgUrl(spec) {
        Option.Some(p) => {
            parsed = p
        }
        Option.None => {
            eprint("error: milo.json dependency '" + pkgName.clone() + "' has a malformed spec '" + spec + "' (expected 'host/org/repo[@ref]' or a local './path')")
            exit(1)
            // Unreachable (exit terminates the process) — but the checker's move
            // analysis only excludes a match arm from the post-match merge when it
            // sees an explicit control-flow exit, so this keeps `spec`'s move here
            // from leaking into the arms below as a false "already moved".
            return ""
        }
    }
    let cacheBase = Path.join(Path.join(Path.join(cacheRoot(), parsed.host), parsed.path), parsed.version)

    let firstSlash = importPath.indexOf("/")
    var subPath = ""
    match firstSlash {
        Option.Some(idx) => {
            subPath = importPath.substr(idx + 1, importPath.len)
        }
        Option.None => {
        }
    }

    if subPath.len > 0 {
        match pkgCandidate(cacheBase, subPath + ".milo") {
            Option.Some(p) => {
                return normalizePath(p)
            }
            Option.None => {
            }
        }
        match pkgCandidate(cacheBase, subPath + "." + rs.targetOs + ".milo") {
            Option.Some(p) => {
                return normalizePath(p)
            }
            Option.None => {
            }
        }
        eprint("error: package '" + pkgName.clone() + "' (" + spec + ") has no module '" + subPath + "' — expected " + Path.join(cacheBase, subPath + ".milo") + " in the local package cache")
        exit(1)
        return ""
    }

    match pkgCandidate(cacheBase, "lib.milo") {
        Option.Some(p) => {
            return normalizePath(p)
        }
        Option.None => {
        }
    }
    match pkgCandidate(cacheBase, pkgName.clone() + ".milo") {
        Option.Some(p) => {
            return normalizePath(p)
        }
        Option.None => {
        }
    }
    eprint("error: package '" + pkgName.clone() + "' (" + spec + ") not found in the local package cache — expected " + Path.join(cacheBase, "lib.milo") + " (run `milo install` to fetch it)")
    exit(1)
    return ""
}

// Resolve an import path to an absolute file path.
// Search order: a package named in milo.json's deps (fail-closed if its manifest
// entry doesn't resolve to a file already in the cache — see resolvePkgImport),
// then relative to source dir, then stdlib dir, then platform-specific.
pub fn resolvePath(rs: &ResolverState, dir: &string, importPath: &string): string {
    var pkgName = importPath.clone()
    match importPath.indexOf("/") {
        Option.Some(idx) => {
            pkgName = importPath.substr(0, idx)
        }
        Option.None => {
        }
    }
    // A package import means whatever the manifest NEAREST THE IMPORTING FILE says, not
    // whatever the entry point's manifest says. Reading it once from the entry's directory
    // (what rs.deps is) made an import's meaning depend on where compilation started: a
    // library file sitting beside a milo.json that declares `gl` resolved `from "gl"` when
    // the entry was the example next door, and failed when the entry was a test fixture two
    // directories away — same file, same import, two answers. Mirrors the same fix in
    // src/resolver.ts; tests/fixtures/flybyGeometry.milo is what caught it.
    //
    // rs.deps stays as the fallback so nothing that resolves today stops: walking up from
    // the importing file reaches the project root anyway in the ordinary case.
    // A bool plus a plain string rather than an Option: matching an Option<string> twice
    // moves it, and this needs two lookups with the second conditional on the first.
    var found = false
    var pkgSpec = ""
    let dirDeps = findManifestDeps(dir.clone())
    match dirDeps.get(pkgName) {
        Option.Some(spec) => {
            pkgSpec = spec.clone()
            found = true
        }
        Option.None => {
        }
    }
    if !found && !rs.deps.isEmpty() {
        match rs.deps.get(pkgName) {
            Option.Some(spec) => {
                pkgSpec = spec.clone()
                found = true
            }
            Option.None => {
            }
        }
    }
    if found {
        return resolvePkgImport(rs, importPath, pkgName, pkgSpec)
    }

    var withExt = importPath.clone()
    if !withExt.endsWith(".milo") {
        withExt = withExt + ".milo"
    }

    // Try relative to current file's directory
    let absPath = Path.join(dir, withExt)
    if pathExists(absPath) {
        return normalizePath(absPath)
    }

    let base = withExt[0..withExt.len - 5] // strip .milo

    // Try a platform-specific sibling of the importing file itself (e.g. a package
    // importing its own "./link" finds "link.darwin.milo" next to it). Mirrors
    // src/resolver.ts's separate `localPlatform` check — a package binding a system
    // library needs this as much as std does, and without it the filename-suffix
    // platform mechanism only worked for stdlib imports, never a package's own.
    let localPlatform = Path.join(dir, base + "." + rs.targetOs + ".milo")
    if pathExists(localPlatform) {
        return normalizePath(localPlatform)
    }

    // Try platform-specific variant (e.g. platform.darwin.milo)
    let platformPath = Path.join(rs.stdlibDir, base + "." + rs.targetOs + ".milo")
    if pathExists(platformPath) {
        return normalizePath(platformPath)
    }

    // Try stdlib path
    let stdPath = Path.join(rs.stdlibDir, withExt)
    if pathExists(stdPath) {
        return normalizePath(stdPath)
    }

    return normalizePath(absPath)
}

// Parse a source file and return its Program AST.
pub fn parseFile(path: &string): Program {
    var source = ""
    match readFile(path) {
        Result.Ok(s) => {
            source = s
        }
        Result.Err(e) => {
            // Do NOT parse "" and merge an empty module: an unreadable import then looks
            // like a module that legitimately declares nothing, and the failure surfaces
            // hundreds of lines later as "unknown struct 'Math'" pointing at the CALLER.
            // Exactly that cost an afternoon of chasing a namespace-model bug that did not
            // exist — the real cause was an import path that could not be read.
            eprint("error: cannot read import '" + path.clone() + "'")
            exit(1)
        }
    }
    let tokens = tokenize(source)
    var p = newParser(tokens, path.clone())
    return parse(&mut p)
}

// A name declared twice at the top level of ONE file. The flat-namespace merge
// (dedup* below) is last-wins, so the two copies would silently collapse to
// whichever the merge happened to pick, and every call site runs that one —
// the classic bad-merge / duplicated-block bug. Milo has no overloading, so a
// same-file redefinition never has a legitimate reading. Mirrors the TS
// resolver's checkDuplicateDecls, scoped to exactly one file's own Program
// (before it is merged with anything else) — cross-file collisions are a
// separate, deliberately laxer story (see dedup* below).
//
// Values and types live in separate namespaces (`struct Point` next to `fn
// Point` is odd but not a redefinition); impl methods are namespaced by
// (type, trait) so an inherent `Foo.bar` and a `Trait for Foo` `bar` are
// distinct symbols, but two inherent `Foo.bar`s collide.
fn checkDupKey(seen: &mut HashMap<string, bool>, key: string, label: string) {
    if seen.contains(key) {
        eprint("error: '" + label + "' is defined twice in this file")
        exit(1)
    }
    seen.insert(key, true)
}

pub fn checkDuplicateDecls(prog: &Program) {
    var seen: HashMap<string, bool> = HashMap.new()
    for i in 0..prog.functions.len {
        checkDupKey(&mut seen, "value:" + prog.functions[i].name.clone(), "fn " + prog.functions[i].name.clone())
    }
    for i in 0..prog.globals.len {
        var kind = "let "
        if prog.globals[i].mutable {
            kind = "var "
        }
        checkDupKey(&mut seen, "value:" + prog.globals[i].name.clone(), kind + prog.globals[i].name.clone())
    }
    for i in 0..prog.structs.len {
        checkDupKey(&mut seen, "type:" + prog.structs[i].name.clone(), "struct " + prog.structs[i].name.clone())
    }
    for i in 0..prog.enums.len {
        checkDupKey(&mut seen, "type:" + prog.enums[i].name.clone(), "enum " + prog.enums[i].name.clone())
    }
    for i in 0..prog.traits.len {
        checkDupKey(&mut seen, "type:" + prog.traits[i].name.clone(), "trait " + prog.traits[i].name.clone())
    }
    for i in 0..prog.typeAliases.len {
        checkDupKey(&mut seen, "type:" + prog.typeAliases[i].name.clone(), "type " + prog.typeAliases[i].name.clone())
    }
    for i in 0..prog.impls.len {
        var traitPart = ""
        match prog.impls[i].traitName {
            Option.Some(t) => {
                traitPart = t.clone()
            }
            Option.None => {
            }
        }
        for j in 0..prog.impls[i].methods.len {
            let key = "impl:" + prog.impls[i].typeName.clone() + ":" + traitPart.clone() + ":" + prog.impls[i].methods[j].name.clone()
            let label = "fn " + prog.impls[i].typeName.clone() + "." + prog.impls[i].methods[j].name.clone()
            checkDupKey(&mut seen, key, label)
        }
    }
}

// `import { x as y }` binds a local alias `y` to a real declared name `x`.
// src-milo merges every module into one flat namespace with no per-package
// mangling to redirect through (see ImportDecl.aliases' doc comment in
// ast.milo), so the binding is realized as a rewrite of the IMPORTING file's
// own function/global bodies — collected here as (from, to) pairs, applied by
// applyAliases{Func,Global} below, once per file, before anything from it is
// pushed into the merged program. Shared by mergeImportedFile (every imported
// file) and resolveImports (the entry file's own top-level imports).
pub struct AliasPairs {
    froms: Vec<string>,
    tos: Vec<string>,
}

pub fn collectAliasPairs(imports: &Vec<ImportDecl>): AliasPairs {
    var froms: Vec<string> = Vec.new()
    var tos: Vec<string> = Vec.new()
    for impI in 0..imports.len {
        match imports[impI].names {
            Option.Some(names) => {
                // Defensive: aliases must be index-aligned with names (see
                // ImportDecl.aliases' doc comment) — a construction site that
                // forgets this (the synthetic std/unicode injection once did)
                // must not crash the whole compile on an out-of-bounds index.
                let aliasesLen = imports[impI].aliases.len
                for ni in 0..names.len {
                    if ni >= aliasesLen {
                        continue
                    }
                    match imports[impI].aliases[ni] {
                        Option.Some(alias) => {
                            if alias != names[ni] {
                                froms.push(alias.clone())
                                tos.push(names[ni].clone())
                            }
                        }
                        Option.None => {
                        }
                    }
                }
            }
            Option.None => {
            }
        }
    }
    return AliasPairs {
        froms: froms, tos: tos
    }
}

pub fn applyAliasesFunc(f: Function, pairs: &AliasPairs): Function {
    var out = f
    for i in 0..pairs.froms.len {
        out = renameFunction(out, pairs.froms[i], pairs.tos[i])
    }
    return out
}

pub fn applyAliasesGlobal(g: GlobalDecl, pairs: &AliasPairs): GlobalDecl {
    var out = g
    for i in 0..pairs.froms.len {
        out = renameGlobal(out, pairs.froms[i], pairs.tos[i])
    }
    return out
}

// ── std private helpers per module (src/resolver.ts stage 4, milo0 half) ──
//
// The oracle scopes every non-`pub` name of a std module to that module, so two std
// modules may both define `fn rotl`. milo0's merge is flat and last-wins, which would
// silently run one module's `rotl` for both, so it has to scope them the same way or the
// self-built compiler miscompiles std. Values only (fns and globals): the rename walker
// (ast.milo renameFunction/renameGlobal) substitutes Ident and Call positions, which is
// what a private value is referenced by. Private TYPES are not scoped here; no two std
// modules that can be loaded together define the same private type today, and the
// oracle's std-wide import gate (tests/modules.test.ts) is what keeps it that way.
//
// The walker is scope-free, so a private value whose name is also bound as a local or a
// parameter somewhere in the file is left flat (`let lenBase = lenBase()` in std/deflate
// would otherwise index a function). The oracle handles that case properly; here the
// flat fallback is exactly what milo0 did before, and identical helpers still merge.

// `Some(<module>)` for a file under `<stdlibDir>/std/`, with a platform arm's suffix
// stripped so `platform.darwin.milo` and `platform.linux.milo` yield the same symbols.
fn stdModuleId(rs: &ResolverState, absPath: &string): Option<string> {
    let stdRoot = normalizePath(Path.join(rs.stdlibDir, "std")) + "/"
    if !absPath.startsWith(stdRoot) {
        return Option.None
    }
    var base = Path.basename(absPath)
    if base.endsWith(".milo") {
        base = base.substr(0, base.len - 5)
    }
    let armSuffix = "." + rs.targetOs
    if base.endsWith(armSuffix) {
        base = base.substr(0, base.len - armSuffix.len)
    }
    return Option.Some(base)
}

fn hasName(names: &Vec<string>, n: &string): bool {
    for i in 0..names.len {
        if names[i] == n {
            return true
        }
    }
    return false
}

fn hasAttr(attrs: &Vec<Attribute>, name: &string): bool {
    for i in 0..attrs.len {
        if attrs[i].name == name {
            return true
        }
    }
    return false
}

// std/string's helpers that lowering and codegen call by name (src/mangle.ts
// COMPILER_KNOWN_STD_HELPERS). Their symbol is the compiler's ABI with std, so it stays flat.
fn isCompilerKnownHelper(n: &string): bool {
    return n == "strContains" || n == "strIndexOf" || n == "strIndexOfFrom" || n == "strLastIndexOf"
    || n == "strStartsWith" || n == "strEndsWith" || n == "strToLower" || n == "strToUpper"
    || n == "strTrim" || n == "strTrimStart" || n == "strTrimEnd" || n == "strSplit"
    || n == "strRepeat" || n == "strPadStart" || n == "strPadEnd" || n == "strReplace"
    || n == "strReplaceFirst" || n == "strSplitWords" || n == "strSplitWhitespace"
    || n == "strIsEmpty" || n == "strCharAt" || n == "strReverse" || n == "strParseInt"
    || n == "strParseF64" || n == "vecJoin"
}

// Every name a statement list binds: let/var, for-in variables, and enum-pattern
// payloads in `match`/`if let`. Closure parameters are not collected (they live inside
// expressions the statement walk does not enter); a closure parameter that shadows a
// private free fn of the same file does not occur in std.
fn collectBoundNames(stmts: &Vec<Heap<Stmt>>, out: &mut Vec<string>) {
    for i in 0..stmts.len {
        match *stmts[i] {
            Stmt.LetDecl(name, typeAnno, value, span) => {
                out.push(name.clone())
            }
            Stmt.VarDecl(name, typeAnno, value, span) => {
                out.push(name.clone())
            }
            Stmt.IfStmt(cond, thenBody, elseBody, span) => {
                collectBoundNames(thenBody, &mut out)
                match elseBody {
                    Option.Some(eb) => {
                        collectBoundNames(eb, &mut out)
                    }
                    Option.None => {
                    }
                }
            }
            Stmt.WhileStmt(cond, body, span) => {
                collectBoundNames(body, &mut out)
            }
            Stmt.MatchStmt(subject, arms, span) => {
                for ai in 0..arms.len {
                    collectPatternNames(arms[ai].pattern, &mut out)
                    collectBoundNames(arms[ai].body, &mut out)
                }
            }
            Stmt.IfLetStmt(pat, value, thenBody, elseBody, span) => {
                collectPatternNames(*pat, &mut out)
                collectBoundNames(thenBody, &mut out)
                match elseBody {
                    Option.Some(eb) => {
                        collectBoundNames(eb, &mut out)
                    }
                    Option.None => {
                    }
                }
            }
            Stmt.UnsafeBlock(body, span) => {
                collectBoundNames(body, &mut out)
            }
            Stmt.ForInStmt(name, indexName, iter, body, span) => {
                out.push(name.clone())
                match indexName {
                    Option.Some(n) => {
                        out.push(n.clone())
                    }
                    Option.None => {
                    }
                }
                collectBoundNames(body, &mut out)
            }
            _ => {
            }
        }
    }
}

fn collectPatternNames(pat: &Pattern, out: &mut Vec<string>) {
    match pat {
        Pattern.EnumPattern(enumName, variant, bindings, span) => {
            for i in 0..bindings.len {
                out.push(bindings[i].clone())
            }
        }
        _ => {
        }
    }
}

// Rename one private value everywhere in this file: its declaration, and every Ident
// and Call that names it in a fn body, an impl method body, or a global initializer.
fn renamePrivateValue(prog: &mut Program, from: &string, to: &string) {
    for i in 0..prog.functions.len {
        var f = renameFunction(prog.functions[i], from, to)
        if f.name == from {
            f.name = to.clone()
        }
        prog.functions[i] = f
    }
    for ii in 0..prog.impls.len {
        for mi in 0..prog.impls[ii].methods.len {
            prog.impls[ii].methods[mi] = renameFunction(prog.impls[ii].methods[mi], from, to)
        }
    }
    for gi in 0..prog.globals.len {
        var g = renameGlobal(prog.globals[gi], from, to)
        if g.name == from {
            g.name = to.clone()
        }
        prog.globals[gi] = g
    }
}

pub fn scopeStdPrivates(prog: &mut Program, moduleId: &string) {
    var bound: Vec<string> = Vec.new()
    for i in 0..prog.functions.len {
        for pi in 0..prog.functions[i].params.len {
            bound.push(prog.functions[i].params[pi].name.clone())
        }
        collectBoundNames(prog.functions[i].body, &mut bound)
    }
    for ii in 0..prog.impls.len {
        for mi in 0..prog.impls[ii].methods.len {
            for pi in 0..prog.impls[ii].methods[mi].params.len {
                bound.push(prog.impls[ii].methods[mi].params[pi].name.clone())
            }
            collectBoundNames(prog.impls[ii].methods[mi].body, &mut bound)
        }
    }

    var privates: Vec<string> = Vec.new()
    for i in 0..prog.functions.len {
        let n = prog.functions[i].name.clone()
        if prog.functions[i].isExtern || n == "main" || hasName(prog.pubNames, n) {
            continue
        }
        if hasAttr(prog.functions[i].attributes, "externalLinkage") || hasAttr(prog.functions[i].attributes, "cName") {
            continue
        }
        if isCompilerKnownHelper(n) || hasName(bound, n) || hasName(privates, n) {
            continue
        }
        privates.push(n)
    }
    for gi in 0..prog.globals.len {
        let n = prog.globals[gi].name.clone()
        if hasName(prog.pubNames, n) || hasName(bound, n) || hasName(privates, n) {
            continue
        }
        privates.push(n)
    }
    for pi in 0..privates.len {
        let to = moduleId.clone() + "$" + privates[pi].clone()
        renamePrivateValue(&mut prog, privates[pi], to)
    }
}

// Recursively process imports from a parsed program.
// Parse+merge one already-resolved file path, then recurse into ITS imports.
// No-ops if already visited. Shared by the real import loop and the
// synthetic std/json injection below.
pub fn mergeImportedFile(rs: &mut ResolverState, absPath: string) {
    if rs.visited.contains(absPath) {
        return
    }
    rs.visited.insert(absPath.clone(), true)
    var imported = parseFile(absPath)
    match stdModuleId(rs, absPath) {
        Option.Some(id) => {
            scopeStdPrivates(&mut imported, id)
        }
        Option.None => {
        }
    }
    for di in 0..imported.parseDiagnostics.len {
        rs.parseDiagnostics.push(cloneDiagnostic(imported.parseDiagnostics[di]))
    }
    checkDuplicateDecls(imported)
    let aliasPairs = collectAliasPairs(imported.imports)

    for si in 0..imported.structs.len {
        rs.structs.push(imported.structs[si].clone())
    }
    for ei in 0..imported.enums.len {
        rs.enums.push(imported.enums[ei].clone())
    }
    for fi in 0..imported.functions.len {
        rs.functions.push(applyAliasesFunc(imported.functions[fi].clone(), aliasPairs))
    }
    for ti in 0..imported.traits.len {
        rs.traits.push(imported.traits[ti].clone())
    }
    for ii in 0..imported.impls.len {
        rs.impls.push(imported.impls[ii].clone())
    }
    for gi in 0..imported.globals.len {
        rs.globals.push(applyAliasesGlobal(cloneGlobal(imported.globals[gi]), aliasPairs))
    }
    for ai in 0..imported.typeAliases.len {
        rs.typeAliases.push(TypeAlias {
            name: imported.typeAliases[ai].name.clone(), base: imported.typeAliases[ai].base.clone()
        }
        )
    }
    for li in 0..imported.linkLibs.len {
        addLinkLib(&mut rs, imported.linkLibs[li])
    }

    // Recurse into this module's imports
    let importDir = Path.dirname(absPath)
    processImports(&mut rs, imported, importDir)
}

// Whether any struct here has @derive(Json) — its synthesized methods call
// std/json (the cursor API, JsonError, jsonQuote…). Mirrors the TS resolver's
// derivesJson check: a derive that silently required an unrelated import
// line would report "unknown type 'Json'" pointing at code the user never
// wrote.
pub fn programDerivesJson(structs: &Vec<StructDecl>): bool {
    for i in 0..structs.len {
        for j in 0..structs[i].attributes.len {
            if structs[i].attributes[j].name == "derive" {
                for k in 0..structs[i].attributes[j].args.len {
                    if structs[i].attributes[j].args[k] == "Json" {
                        return true
                    }
                }
            }
        }
    }
    return false
}

pub fn processImports(rs: &mut ResolverState, prog: &Program, dir: &string) {
    if programDerivesJson(prog.structs) {
        let jsonPath = resolvePath(rs, dir, "std/json")
        mergeImportedFile(&mut rs, jsonPath)
    }
    for i in 0..prog.imports.len {
        let imp = prog.imports[i]
        let absPath = resolvePath(rs, dir, imp.path)
        mergeImportedFile(&mut rs, absPath)
    }
}

// Dedup declarations by name (last occurrence wins — user overrides prelude).
// Last-wins dedup by name, matching what structs/enums/functions already do. Needed
// because a module-private `let` is NOT private in milo0's flat merge: std/sha1 and
// std/sha256 each declare `let MASK32`, and importing both emitted `@MASK32` twice, which
// LLVM rejects outright.
//
// HAZARD this does not solve: two private globals sharing a name but holding DIFFERENT
// values now silently collapse to one. The real fix is per-module namespacing (the flat
// merge is milo0's design limit, backlog T2 #18); this only stops the duplicate-symbol
// error for the case where they agree.
pub fn dedupGlobals(arr: Vec<GlobalDecl>): Vec<GlobalDecl> {
    var seen: HashMap<string, bool> = HashMap.new()
    var result: Vec<GlobalDecl> = Vec.new()
    var i: i64 = arr.len - 1
    while i >= 0 {
        if !seen.contains(arr[i].name) {
            seen.insert(arr[i].name.clone(), true)
            result.push(cloneGlobal(arr[i]))
        }
        i = i - 1
    }
    result.reverse()
    return result
}

pub fn dedupStructs(arr: Vec<StructDecl>): Vec<StructDecl> {
    var seen: HashMap<string, bool> = HashMap.new()
    var result: Vec<StructDecl> = Vec.new()
    var i: i64 = arr.len - 1
    while i >= 0 {
        if !seen.contains(arr[i].name) {
            seen.insert(arr[i].name.clone(), true)
            result.push(arr[i].clone())
        }
        i = i - 1
    }
    result.reverse()
    return result
}

pub fn dedupEnums(arr: Vec<EnumDecl>): Vec<EnumDecl> {
    var seen: HashMap<string, bool> = HashMap.new()
    var result: Vec<EnumDecl> = Vec.new()
    var i: i64 = arr.len - 1
    while i >= 0 {
        if !seen.contains(arr[i].name) {
            seen.insert(arr[i].name.clone(), true)
            result.push(arr[i].clone())
        }
        i = i - 1
    }
    result.reverse()
    return result
}

pub fn dedupFunctions(arr: Vec<Function>): Vec<Function> {
    var seen: HashMap<string, bool> = HashMap.new()
    var result: Vec<Function> = Vec.new()
    var i: i64 = arr.len - 1
    while i >= 0 {
        if !seen.contains(arr[i].name) {
            seen.insert(arr[i].name.clone(), true)
            result.push(arr[i].clone())
        }
        i = i - 1
    }
    result.reverse()
    return result
}

pub fn dedupTraits(arr: Vec<TraitDecl>): Vec<TraitDecl> {
    var seen: HashMap<string, bool> = HashMap.new()
    var result: Vec<TraitDecl> = Vec.new()
    var i: i64 = arr.len - 1
    while i >= 0 {
        if !seen.contains(arr[i].name) {
            seen.insert(arr[i].name.clone(), true)
            result.push(arr[i].clone())
        }
        i = i - 1
    }
    result.reverse()
    return result
}

// Main entry point: resolve all imports and produce a merged Program.
pub fn resolveImports(program: Program, sourceDir: string, stdlibDir: string, targetOs: string): Program {
    // Read once, from the entry file's directory upward — every import in the whole
    // graph (including a package's own internal imports) resolves against the root
    // project's manifest, matching src/resolver.ts (see ResolverState.deps).
    let deps = findManifestDeps(sourceDir.clone())
    var rs = newResolver(stdlibDir, targetOs, deps)

    // Inject prelude before user code
    let preludePath = Path.join(rs.stdlibDir, "std/prelude.milo")
    if pathExists(preludePath) && !rs.visited.contains(preludePath) {
        rs.visited.insert(preludePath.clone(), true)
        let prelude = parseFile(preludePath)
        for di in 0..prelude.parseDiagnostics.len {
            rs.parseDiagnostics.push(cloneDiagnostic(prelude.parseDiagnostics[di]))
        }
        checkDuplicateDecls(prelude)
        for si in 0..prelude.structs.len {
            rs.structs.push(prelude.structs[si].clone())
        }
        for ei in 0..prelude.enums.len {
            rs.enums.push(prelude.enums[ei].clone())
        }
        for fi in 0..prelude.functions.len {
            rs.functions.push(prelude.functions[fi].clone())
        }
        for ti in 0..prelude.traits.len {
            rs.traits.push(prelude.traits[ti].clone())
        }
        for ii in 0..prelude.impls.len {
            rs.impls.push(prelude.impls[ii].clone())
        }
        for gi in 0..prelude.globals.len {
            rs.globals.push(cloneGlobal(prelude.globals[gi]))
        }
        for ai in 0..prelude.typeAliases.len {
            rs.typeAliases.push(TypeAlias {
                name: prelude.typeAliases[ai].name.clone(), base: prelude.typeAliases[ai].base.clone()
            }
            )
        }
        let preludeDir = Path.dirname(preludePath)
        processImports(&mut rs, prelude, preludeDir)
    }

    checkDuplicateDecls(program)
    // The entry file can itself write `import { x as y }` — same rewrite as
    // mergeImportedFile applies to every OTHER file (see AliasPairs above).
    let entryAliasPairs = collectAliasPairs(program.imports)

    // User code comes after prelude (last-wins dedup means user overrides)
    for si in 0..program.structs.len {
        rs.structs.push(program.structs[si].clone())
    }
    for ei in 0..program.enums.len {
        rs.enums.push(program.enums[ei].clone())
    }
    for fi in 0..program.functions.len {
        rs.functions.push(applyAliasesFunc(program.functions[fi].clone(), entryAliasPairs))
    }
    for ti in 0..program.traits.len {
        rs.traits.push(program.traits[ti].clone())
    }
    for ii in 0..program.impls.len {
        rs.impls.push(program.impls[ii].clone())
    }
    for gi in 0..program.globals.len {
        rs.globals.push(applyAliasesGlobal(cloneGlobal(program.globals[gi]), entryAliasPairs))
    }
    for ai in 0..program.typeAliases.len {
        rs.typeAliases.push(TypeAlias {
            name: program.typeAliases[ai].name.clone(), base: program.typeAliases[ai].base.clone()
        }
        )
    }
    for li in 0..program.linkLibs.len {
        addLinkLib(&mut rs, program.linkLibs[li])
    }

    // Process user program's imports
    processImports(&mut rs, program, sourceDir)

    // Dedup and return merged program
    return Program {
        structs: dedupStructs(rs.structs),
        enums: dedupEnums(rs.enums),
        functions: dedupFunctions(rs.functions),
        imports: Vec.new(),
        traits: dedupTraits(rs.traits),
        impls: rs.impls,
        globals: dedupGlobals(rs.globals),
        typeAliases: rs.typeAliases,
        linkLibs: rs.linkLibs,
        pubNames: Vec.new(),
        parseDiagnostics: mergeParseDiagnostics(program.parseDiagnostics, rs.parseDiagnostics),
    }
}
