// std/unicode: UTF-8 decoding and encoding, simple case mapping, and ASCII-level classification
//
// The code-point layer: `codepointCount`, `decodeCodepoint`, `nextCodepointBoundary`,
// `encodeCodepoint`. Case mapping: `unicodeLower`/`unicodeUpper` and the per-code-point
// `lowerCodepoint`/`upperCodepoint`, the Unicode *simple* mapping (one code point to one,
// tables generated from UnicodeData.txt by scripts/gen-case-map.ts). The full mappings
// that change a string's length or depend on context (ß to SS, final sigma) are not
// here. What is ASCII-only is the classification (`isAlphaStr`, `isNumeric`), each
// says so at its definition, and the built-in `s.toLower()`/`s.toUpper()`, which stay
// ASCII-only on purpose (see unicodeLower).

// Check if an entire string is numeric (all digits).
pub fn isNumeric(s: &string): bool {
    if s.len == 0 {
        return false
    }
    var i: i64 = 0
    while i < s.len {
        if !asciiIsDigit(s[i]) {
            return false
        }
        i += 1
    }
    return true
}
// ^ ASCII only, like isAlphaStr below: a non-ASCII digit (Arabic-Indic, fullwidth)
// answers false. Narrower promise than "alphabetic", so it surprises less often.

// Is every byte an ASCII letter? **ASCII only, despite living here** — it walks BYTES
// calling `asciiIsAlpha`, so any multibyte letter fails on its first continuation byte:
// `isAlphaStr("café")`, `isAlphaStr("привет")` and `isAlphaStr("αβγ")` are all false.
// Use it as an ASCII-identifier test, not as a Unicode letter test.
//
// The code-point layer in this module IS correct (`codepointCount("café")` is 4); it is
// the classification that is ASCII, because a Unicode general-category table is a
// generated artefact nobody has built here yet (docs/backlog.md).
pub fn isAlphaStr(s: &string): bool {
    if s.len == 0 {
        return false
    }
    var i: i64 = 0
    while i < s.len {
        if !asciiIsAlpha(s[i]) {
            return false
        }
        i += 1
    }
    return true
}

// U+FFFD REPLACEMENT CHARACTER — substituted for any malformed sequence.
pub let REPLACEMENT_CHAR: i32 = 65533

// One decoded codepoint plus the number of bytes it occupied, so a caller can
// advance without re-inspecting the lead byte.
pub struct CodePoint {
    value: i32,
    size: i64,
}

// Decode the UTF-8 codepoint starting at byte offset `at`, without allocating.
// This is the primitive to scan text with: a lexer keeps its own byte cursor and
// advances by `.size`, so no Vec<i32> is materialized just to walk a string.
//
// Malformed input never reads out of bounds and never returns a partial
// codepoint: a bad lead byte, a truncated tail, or a non-continuation byte all
// yield U+FFFD with size 1, so a scan advances and terminates on any input.
// Overlong forms and surrogate-range values are rejected the same way, which is
// what keeps decode/encode round-trips honest.
pub fn decodeCodepoint(s: &string, at: i64): CodePoint {
    if at < 0 || at >= s.len {
        return CodePoint { value: REPLACEMENT_CHAR, size: 1 }
    }
    let b = s[at]
    if b < 128 {
        return CodePoint { value: b as i32, size: 1 }
    }
    var size: i64 = 0
    var cp: i32 = 0
    if (b & 224) == 192 {
        size = 2
        cp = (b & 31) as i32
    } else if (b & 240) == 224 {
        size = 3
        cp = (b & 15) as i32
    } else if (b & 248) == 240 {
        size = 4
        cp = (b & 7) as i32
    } else {
        // continuation byte or 5/6-byte form: not a legal lead
        return CodePoint { value: REPLACEMENT_CHAR, size: 1 }
    }
    if at + size > s.len {
        return CodePoint { value: REPLACEMENT_CHAR, size: 1 }
    }
    var k: i64 = 1
    while k < size {
        let c = s[at + k]
        if (c & 192) != 128 {
            return CodePoint { value: REPLACEMENT_CHAR, size: 1 }
        }
        cp = (cp << 6) | ((c & 63) as i32)
        k += 1
    }
    // Reject overlongs, surrogates, and out-of-range: each has a shorter or no
    // legal encoding, so accepting them would let two byte sequences compare
    // unequal while decoding to the same codepoint.
    if size == 2 && cp < 128 {
        return CodePoint { value: REPLACEMENT_CHAR, size: 1 }
    }
    if size == 3 && cp < 2048 {
        return CodePoint { value: REPLACEMENT_CHAR, size: 1 }
    }
    if size == 4 && cp < 65536 {
        return CodePoint { value: REPLACEMENT_CHAR, size: 1 }
    }
    if cp > 1114111 || (cp >= 55296 && cp <= 57343) {
        return CodePoint { value: REPLACEMENT_CHAR, size: 1 }
    }
    return CodePoint { value: cp, size: size }
}

// Byte offset of the next codepoint boundary at or after `at`.
pub fn nextCodepointBoundary(s: &string, at: i64): i64 {
    let cp = decodeCodepoint(s, at)
    return at + cp.size
}

// Append `cp` to `out` as UTF-8. Invalid codepoints encode as U+FFFD rather
// than emitting bytes that would not decode back.
pub fn encodeCodepoint(out: &mut string, cp: i32): void {
    var c = cp
    if c < 0 || c > 1114111 || (c >= 55296 && c <= 57343) {
        c = REPLACEMENT_CHAR
    }
    if c < 128 {
        out.push(c as u8)
    } else if c < 2048 {
        out.push((192 | (c >> 6)) as u8)
        out.push((128 | (c & 63)) as u8)
    } else if c < 65536 {
        out.push((224 | (c >> 12)) as u8)
        out.push((128 | ((c >> 6) & 63)) as u8)
        out.push((128 | (c & 63)) as u8)
    } else {
        out.push((240 | (c >> 18)) as u8)
        out.push((128 | ((c >> 12) & 63)) as u8)
        out.push((128 | ((c >> 6) & 63)) as u8)
        out.push((128 | (c & 63)) as u8)
    }
}

// Decode UTF-8 string into Unicode codepoints. Allocates; prefer
// decodeCodepoint in a scan loop.
pub fn codepoints(s: &string): Vec<i32> {
    var result: Vec<i32> = Vec.new()
    var i: i64 = 0
    while i < s.len {
        let cp = decodeCodepoint(s, i)
        result.push(cp.value)
        i += cp.size
    }
    return result
}

// Number of Unicode codepoints in a string (not bytes).
pub fn codepointCount(s: &string): i64 {
    var count: i64 = 0
    var i: i64 = 0
    while i < s.len {
        i = i + decodeCodepoint(s, i).size
        count += 1
    }
    return count
}

// UTF-16 conversion. A codepoint above the BMP is a single codepoint but TWO
// UTF-16 code units, encoded as a surrogate pair — so a byte- or
// codepoint-oriented count is not a UTF-16 index. Needed by anything crossing a
// UTF-16 boundary (Windows wide-char APIs, JVM strings).
pub fn isSupplementary(cp: i32): bool {
    return cp > 65535
}

pub fn utf16UnitCount(cp: i32): i64 {
    if isSupplementary(cp) {
        return 2
    }
    return 1
}

pub fn highSurrogate(cp: i32): i32 {
    return 55296 + ((cp - 65536) >> 10)
}

pub fn lowSurrogate(cp: i32): i32 {
    return 56320 + ((cp - 65536) & 1023)
}

// Combine a surrogate pair back into a single codepoint.
pub fn fromSurrogatePair(high: i32, low: i32): i32 {
    return 65536 + ((high - 55296) << 10) + (low - 56320)
}

// ---------------------------------------------------------------------------
// Terminal display width
//
// A codepoint count is NOT a column count: CJK and emoji occupy two cells,
// combining marks occupy none. Any code that aligns text in a terminal — column
// layout, padding, truncation, box drawing — is wrong without this. Ranges are
// expressed as comparison chains rather than a table so lookup allocates
// nothing and stays usable in a per-frame render loop.
//
// Coverage is the practically-needed subset of the Unicode data, not the
// full UCD: the East Asian Wide/Fullwidth blocks, the emoji planes, and the
// combining-mark blocks in wide use. Rare historic scripts may measure one cell
// short. Generating the exhaustive table from UnicodeData.txt is the follow-up;
// this is deliberately the version that fits in a reviewable file.
// ---------------------------------------------------------------------------

pub let ZERO_WIDTH_JOINER: i32 = 8205

pub let VARIATION_SELECTOR_16: i32 = 65039

pub let VARIATION_SELECTOR_15: i32 = 65038

// Marks that attach to a preceding base character and advance no column.
pub fn isCombining(cp: i32): bool {
    // Generic combining blocks: diacriticals, extended, supplement, symbols,
    // and the half marks used for vertical CJK forms.
    if (cp >= 768 && cp <= 879) || (cp >= 6832 && cp <= 6911) {
        return true
    }
    if (cp >= 7616 && cp <= 7679) || (cp >= 8400 && cp <= 8432) {
        return true
    }
    if cp >= 65056 && cp <= 65071 {
        return true
    }
    // Hebrew points and Arabic harakat — the dense mark blocks in real text.
    if (cp >= 1425 && cp <= 1469) || cp == 1471 {
        return true
    }
    if (cp >= 1473 && cp <= 1474) || (cp >= 1476 && cp <= 1477) || cp == 1479 {
        return true
    }
    if (cp >= 1552 && cp <= 1562) || (cp >= 1611 && cp <= 1631) || cp == 1648 {
        return true
    }
    if (cp >= 1750 && cp <= 1756) || (cp >= 1759 && cp <= 1764) {
        return true
    }
    if (cp >= 1767 && cp <= 1768) || (cp >= 1770 && cp <= 1773) {
        return true
    }
    // Devanagari/Bengali nuktas and viramas, then the Thai/Lao mark rows.
    if cp == 2364 || cp == 2381 || (cp >= 2385 && cp <= 2388) {
        return true
    }
    if cp == 3633 || (cp >= 3636 && cp <= 3642) || (cp >= 3655 && cp <= 3662) {
        return true
    }
    if cp == 3761 || (cp >= 3764 && cp <= 3769) || (cp >= 3784 && cp <= 3789) {
        return true
    }
    return false
}

// Format/invisible characters: joiners, bidi controls, variation selectors, BOM.
pub fn isZeroWidthFormat(cp: i32): bool {
    if cp >= 8203 && cp <= 8207 {
        return true
    }
    if cp >= 8232 && cp <= 8238 {
        return true
    }
    if cp >= 8288 && cp <= 8303 {
        return true
    }
    if cp >= 65024 && cp <= 65039 {
        return true
    }
    if cp == 65279 {
        return true
    }
    // Variation selectors supplement (tag sequences for flags/subdivisions).
    if cp >= 917504 && cp <= 921599 {
        return true
    }
    return false
}

// Regional indicator symbols — two in a row form one flag glyph.
pub fn isRegionalIndicator(cp: i32): bool {
    return cp >= 127462 && cp <= 127487
}

// Emoji skin-tone modifiers, absorbed by the emoji they follow.
pub fn isSkinToneModifier(cp: i32): bool {
    return cp >= 127995 && cp <= 127999
}

// East Asian Wide/Fullwidth plus the emoji blocks that render double-width.
pub fn isWide(cp: i32): bool {
    // Hangul Jamo initial consonants.
    if cp >= 4352 && cp <= 4447 {
        return true
    }
    // CJK radicals through the unified ideographs and Yi syllables.
    if cp >= 11904 && cp <= 12287 && cp != 12351 {
        return true
    }
    if cp >= 12289 && cp <= 19903 {
        return true
    }
    if cp >= 19968 && cp <= 42191 {
        return true
    }
    // Hangul syllables.
    if cp >= 44032 && cp <= 55203 {
        return true
    }
    // CJK compatibility ideographs.
    if cp >= 63744 && cp <= 64255 {
        return true
    }
    // Vertical forms and CJK compatibility forms.
    if cp >= 65040 && cp <= 65049 {
        return true
    }
    if cp >= 65072 && cp <= 65135 {
        return true
    }
    // Fullwidth ASCII forms and fullwidth signs.
    if cp >= 65281 && cp <= 65376 {
        return true
    }
    if cp >= 65504 && cp <= 65510 {
        return true
    }
    // Emoji: misc symbols/pictographs, transport, supplemental, extended-A.
    if cp >= 127744 && cp <= 128767 {
        return true
    }
    if cp >= 128768 && cp <= 128895 {
        return true
    }
    if cp >= 129280 && cp <= 129791 {
        return true
    }
    if cp >= 129792 && cp <= 130047 {
        return true
    }
    // CJK extension planes B onward.
    if cp >= 131072 && cp <= 196605 {
        return true
    }
    return false
}

// Terminal cells occupied by a single codepoint: 0, 1, or 2.
//
// Control characters report 0 because they advance no column when printed —
// callers that need to reject them should filter before measuring, not rely on
// a negative sentinel.
pub fn charWidth(cp: i32): i64 {
    if cp >= 32 && cp < 127 {
        return 1
    }
    if cp < 32 || (cp >= 127 && cp < 160) {
        return 0
    }
    if isCombining(cp) || isZeroWidthFormat(cp) {
        return 0
    }
    if isWide(cp) {
        return 2
    }
    return 1
}

// Columns a string occupies in a terminal.
//
// Measured over grapheme clusters, not codepoints, so the multi-codepoint
// sequences that real text is full of collapse to the one glyph a terminal
// actually paints: ZWJ emoji sequences (family, professions) count once, a
// flag's two regional indicators count once, skin tones and variation
// selectors fold into the emoji they modify.
pub fn displayWidth(s: &string): i64 {
    var total: i64 = 0
    var i: i64 = 0
    // Width contributed by the current cluster head, so a following variation
    // selector can promote or demote it in place.
    var headWidth: i64 = 0
    var pendingJoin = false
    var openRegional = false
    while i < s.len {
        let c = decodeCodepoint(s, i)
        i += c.size
        let cp = c.value
        if cp == ZERO_WIDTH_JOINER {
            pendingJoin = true
            continue
        }
        // The element after a ZWJ is part of the same glyph, whatever it is.
        if pendingJoin {
            pendingJoin = false
            openRegional = false
            continue
        }
        // VS16 forces emoji presentation, widening an otherwise 1-cell symbol;
        // VS15 forces text presentation and narrows it back.
        if cp == VARIATION_SELECTOR_16 {
            if headWidth == 1 {
                total += 1
                headWidth = 2
            }
            continue
        }
        if cp == VARIATION_SELECTOR_15 {
            if headWidth == 2 {
                total -= 1
                headWidth = 1
            }
            continue
        }
        if isSkinToneModifier(cp) {
            continue
        }
        let w = charWidth(cp)
        if w == 0 {
            continue
        }
        if isRegionalIndicator(cp) {
            // Second indicator completes the flag already paid for.
            if openRegional {
                openRegional = false
                headWidth = 0
                continue
            }
            openRegional = true
            total += 2
            headWidth = 2
            continue
        }
        openRegional = false
        total += w
        headWidth = w
    }
    return total
}

// Byte offset just past the longest prefix of `s` that fits in `maxCols`
// columns. Never splits a codepoint, and never leaves half of a double-width
// glyph — a wide character that would straddle the limit is excluded entirely.
pub fn truncateToWidth(s: &string, maxCols: i64): i64 {
    var used: i64 = 0
    var i: i64 = 0
    while i < s.len {
        let c = decodeCodepoint(s, i)
        let w = charWidth(c.value)
        if used + w > maxCols {
            return i
        }
        used += w
        i += c.size
    }
    return s.len
}

// Byte offset just past the first `n` code points of `s` (`s.len` when it has fewer).
// `s.substr(0, truncateToCodepoints(s, n))` is an excerpt that never splits a character.
pub fn truncateToCodepoints(s: &string, n: i64): i64 {
    var i: i64 = 0
    var count: i64 = 0
    while i < s.len && count < n {
        i = nextCodepointBoundary(s, i)
        count += 1
    }
    return i
}

// Byte offset just past the longest prefix of `s` that is at most `maxBytes` bytes and
// ends on a code point boundary, for a byte budget (a column width in a database, a
// header limit) that must not leave half a character behind.
pub fn truncateToBytes(s: &string, maxBytes: i64): i64 {
    if s.len <= maxBytes {
        return s.len
    }
    var i: i64 = 0
    while i < s.len {
        let next = nextCodepointBoundary(s, i)
        if next > maxBytes {
            return i
        }
        i = next
    }
    return i
}

// Length of `s` in UTF-16 code units: what JavaScript's `.length` reports, so a limit
// a browser enforces can be enforced the same way on the server. A malformed byte
// counts as one unit (it decodes as U+FFFD).
pub fn utf16Length(s: &string): i64 {
    var units: i64 = 0
    var i: i64 = 0
    while i < s.len {
        let c = decodeCodepoint(s, i)
        units += utf16UnitCount(c.value)
        i += c.size
    }
    return units
}

// Byte offset just past the longest prefix of `s` that is at most `maxUnits` UTF-16
// code units. A character outside the BMP (two units) that would straddle the limit is
// excluded whole, never cut into half a surrogate pair.
pub fn truncateToUtf16(s: &string, maxUnits: i64): i64 {
    var units: i64 = 0
    var i: i64 = 0
    while i < s.len {
        let c = decodeCodepoint(s, i)
        let w = utf16UnitCount(c.value)
        if units + w > maxUnits {
            return i
        }
        units += w
        i += c.size
    }
    return s.len
}

// Whether `s` is well-formed UTF-8: no stray continuation byte, truncated sequence,
// overlong form, surrogate, or value past U+10FFFF. Bytes off the wire (a request body,
// a file, a socket) carry no such guarantee; a `string` built from literals does.
pub fn isValidUtf8(s: &string): bool {
    var i: i64 = 0
    while i < s.len {
        if s[i] < 128 {
            i += 1
            continue
        }
        // decodeCodepoint reports every malformed sequence as size 1, and a well-formed
        // non-ASCII one is never size 1, so the size alone separates them.
        let c = decodeCodepoint(s, i)
        if c.size == 1 {
            return false
        }
        i += c.size
    }
    return true
}

// `s` with every maximal ill-formed subsequence replaced by one U+FFFD, the
// substitution the WHATWG Encoding standard (and so `TextDecoder` and every browser)
// makes. Returns `s` unchanged, without copying, when it is already valid.
//
// This differs from decodeCodepoint's one-U+FFFD-per-byte on a truncated sequence:
// `E2 82` (a 3-byte form cut short) is ONE replacement here, so the server and a
// browser agree on the repaired text and its length.
pub fn repairUtf8(s: &string): string {
    if isValidUtf8(s) {
        return s
    }
    var out: string = ""
    var i: i64 = 0
    let n = s.len
    while i < n {
        let b = s[i]
        if b < 128 {
            out.push(b)
            i += 1
            continue
        }
        // The legal range of the FIRST continuation byte depends on the lead: that is
        // where overlongs (E0, F0), surrogates (ED) and values past U+10FFFF (F4) are
        // ruled out. Later continuation bytes are always 80..BF.
        var need: i64 = 0
        var lo: u8 = 128
        var hi: u8 = 191
        if b >= 194 && b <= 223 {
            need = 1
        } else if b >= 224 && b <= 239 {
            need = 2
            if b == 224 {
                lo = 160
            } else if b == 237 {
                hi = 159
            }
        } else if b >= 240 && b <= 244 {
            need = 3
            if b == 240 {
                lo = 144
            } else if b == 244 {
                hi = 143
            }
        } else {
            encodeCodepoint(&mut out, REPLACEMENT_CHAR)
            i += 1
            continue
        }
        var j = i + 1
        var good = true
        while j <= i + need {
            if j >= n {
                good = false
                break
            }
            let c = s[j]
            let l: u8 = if j == i + 1 { lo } else { 128 }
            let h: u8 = if j == i + 1 { hi } else { 191 }
            if c < l || c > h {
                good = false
                break
            }
            j += 1
        }
        if good {
            out.pushStr(s.slice(i, i + need + 1))
            i += need + 1
        } else {
            // j stops at the first byte that cannot continue the sequence, so the
            // lead plus every valid continuation before it is one maximal subpart.
            encodeCodepoint(&mut out, REPLACEMENT_CHAR)
            i = j
        }
    }
    return out
}

// ── Case mapping ──

// The simple lowercase mapping of code point `cp` (UnicodeData.txt field 13), or `cp`
// itself when it has none. One code point to one: the full mappings in SpecialCasing.txt
// (context-dependent final sigma, language rules) are out of scope.
pub fn lowerCodepoint(cp: i32): i32 {
    if cp < 128 {
        return if cp >= 'A' as i32 && cp <= 'Z' as i32 { cp + 32 } else { cp }
    }
    let at = caseFind(LOWER_FROM, LOWER_COUNT, cp)
    return if at >= 0 { LOWER_TO[at] } else { cp }
}

// The simple uppercase mapping of code point `cp` (UnicodeData.txt field 12), or `cp`
// itself when it has none. `ß` stays `ß`: its uppercase "SS" is a full mapping, two code
// points, which a per-code-point map cannot produce.
pub fn upperCodepoint(cp: i32): i32 {
    if cp < 128 {
        return if cp >= 'a' as i32 && cp <= 'z' as i32 { cp - 32 } else { cp }
    }
    let at = caseFind(UPPER_FROM, UPPER_COUNT, cp)
    return if at >= 0 { UPPER_TO[at] } else { cp }
}

// `s` with every code point lowercased by lowerCodepoint: "ÀÉÎ Straße ΣΑΣ" becomes
// "àéî straße σασ". Unicode-aware, unlike the ASCII-only `s.toLower()`, which is the
// right one for protocol tokens (header names, schemes, hex): there a Unicode mapping
// would let the Kelvin sign U+212A match "k". The byte length can change ("ȿ" is 2 bytes,
// its uppercase "Ȿ" 3). Malformed UTF-8 bytes are copied unchanged.
pub fn unicodeLower(s: &string): string {
    return mapCase(s, false)
}

// `s` with every code point uppercased by upperCodepoint: "àéî straße" becomes
// "ÀÉÎ STRAßE" (ß has no one-code-point uppercase). See unicodeLower for when to use
// this rather than the ASCII-only `s.toUpper()`.
pub fn unicodeUpper(s: &string): string {
    return mapCase(s, true)
}

fn mapCase(s: &string, upper: bool): string {
    var out = ""
    var i: i64 = 0
    while i < s.len {
        let b = s[i]
        if b < 128 {
            if upper && b >= 'a' && b <= 'z' {
                out.push(b - 32)
            } else if !upper && b >= 'A' && b <= 'Z' {
                out.push(b + 32)
            } else {
                out.push(b)
            }
            i += 1
            continue
        }
        let cp = decodeCodepoint(s, i)
        if cp.value == REPLACEMENT_CHAR && cp.size == 1 {
            // not valid UTF-8 here: keep the byte rather than invent a U+FFFD
            out.push(b)
            i += 1
            continue
        }
        encodeCodepoint(&mut out, if upper { upperCodepoint(cp.value) } else { lowerCodepoint(cp.value) })
        i += cp.size
    }
    return out
}

// Index of `cp` in the sorted `keys`, or -1.
fn caseFind(keys: &[i32], n: i64, cp: i32): i64 {
    var lo: i64 = 0
    var hi = n
    while lo < hi {
        let mid = (lo + hi) / 2
        let k = keys[mid]
        if k == cp {
            return mid
        }
        if k < cp {
            lo = mid + 1
        } else {
            hi = mid
        }
    }
    return -1
}

