// std/zip — read PKZIP archives (APPNOTE.TXT), pure Milo on std/inflate.
//
// Reads the central directory, then for each entry seeks its local header and
// inflates the payload: method 0 (stored) is copied, method 8 (deflate) is fed to
// std/inflate — which is exactly the raw DEFLATE zip stores, no zlib wrapper. Each
// entry's CRC-32 is verified against the directory. Read-only and whole-archive
// (no streaming, no zip64, no encryption) — enough to open .zip/.jar/.epub/.docx.

from "std/inflate" import {
    Inflate
}
from "std/checksum" import {
    Checksum
}
from "std/binary" import {
    Bytes
}

pub struct ZipEntry {
    name: string,
    data: string, // decompressed contents
}

// Every offset in a zip comes out of the archive itself — a central-directory
// entry points at a local header, which points at the data — so a corrupt or
// truncated file names positions that are not there. Reading through Option and
// failing the parse is what keeps that an error rather than a bounds abort in the
// middle of a function whose type promises a Result.
fn zipU16(src: &string, p: i64): Result<i64, string> {
    let Option.Some(v) = Bytes.readU16Le(src, p) else {
        return Result.Err("zip: truncated archive")
    }
    return Result.Ok(v as i64)
}

fn zipU32(src: &string, p: i64): Result<i64, string> {
    let Option.Some(v) = Bytes.readU32Le(src, p) else {
        return Result.Err("zip: truncated archive")
    }
    return Result.Ok(v as i64)
}

// Locate the End Of Central Directory record by scanning back for its signature
// (0x06054b50). The trailing comment is variable-length, so we search rather than
// index from the end.
fn findEocd(src: &string): i64 {
    if src.len < 22 {
        return -1
    }
    var p = src.len - 22
    while p >= 0 {
        // p <= len - 22, so the read is always in range; the default only has to
        // be some value that is not the signature, and every p is a candidate to
        // reject rather than a field whose value is being trusted.
        if Bytes.readU32Le(src, p).unwrapOr(0 as u32) == 0x06054b50 as u32 {
            return p
        }
        p -= 1
    }
    return -1
}

// Read every entry, decompressing and CRC-checking each.
fn zipRead(src: &string): Result<Vec<ZipEntry>, string> {
    let eocd = findEocd(src)
    if eocd < 0 {
        return Result.Err("zip: no end-of-central-directory record")
    }
    let count = zipU16(src, eocd + 10)?
    var cd = zipU32(src, eocd + 16)? // central directory offset

    var entries = Vec.new()
    for _e in 0..count {
        if zipU32(src, cd)? != 0x02014b50 {
            return Result.Err("zip: bad central directory header")
        }
        let method = zipU16(src, cd + 10)?
        let wantCrc = zipU32(src, cd + 16)?
        let compSize = zipU32(src, cd + 20)?
        let uncompSize = zipU32(src, cd + 24)?
        let nameLen = zipU16(src, cd + 28)?
        let extraLen = zipU16(src, cd + 30)?
        let commentLen = zipU16(src, cd + 32)?
        let localOff = zipU32(src, cd + 42)?

        if src.len - nameLen < cd + 46 {
            return Result.Err("zip: truncated archive")
        }
        var name = ""
        for i in 0..nameLen {
            name.push(src[cd + 46 + i])
        }

        // Local header: 30 fixed bytes + its own name/extra fields (lengths may
        // differ from the central copy, so read them from the local header).
        if zipU32(src, localOff)? != 0x04034b50 {
            return Result.Err("zip: bad local file header")
        }
        let lNameLen = zipU16(src, localOff + 26)?
        let lExtraLen = zipU16(src, localOff + 28)?
        let dataOff = localOff + 30 + lNameLen + lExtraLen

        if src.len - compSize < dataOff {
            return Result.Err("zip: truncated archive")
        }
        var comp = ""
        for i in 0..compSize {
            comp.push(src[dataOff + i])
        }

        var data = ""
        if method == 0 {
            data = comp
        } else if method == 8 {
            data = Inflate.raw(comp)?
        } else {
            return Result.Err($"zip: unsupported compression method {method}")
        }

        if data.len != uncompSize {
            return Result.Err($"zip: size mismatch for {name}")
        }
        if Checksum.crc32(data) != wantCrc {
            return Result.Err($"zip: CRC-32 mismatch for {name}")
        }

        entries.push(ZipEntry {
            name: name, data: data
        }
        )
        cd = cd + 46 + nameLen + extraLen + commentLen
    }
    return Result.Ok(entries)
}

// Zip namespace — Zip.read(src) parses a PKZIP archive into entries.
pub struct Zip {
}

impl Zip {
    fn read(src: &string): Result<Vec<ZipEntry>, string> {
        return zipRead(src)
    }
}
