// std/https — HTTPS server: std/http's wire format driven over std/tls.
//
// Why a separate module rather than a serveTls() in std/http: std/http must stay free of
// OpenSSL so a plain HTTP server links without it (the same split that keeps SSL_* out of
// std/net). Importing std/https — and only that — is what pulls OpenSSL in.
//
// It reaches TLS through std/tls, which holds the server transport; std/fetch is the
// client half and is not needed here.

from "std/http" import {
    Request, Response, Router, ServeOptions, serveHandlerExchange, serveRouterExchange
}
from "std/tls" import {
    TlsConn, TlsListener
}
from "std/net" import {
    NetError, deadlineIn
}

// NetError's payload is already the message; this just erases the variant so the
// serve* functions can return the Result<Unit> (E = string) shape std/http uses.
fn netErrText(e: &NetError): string {
    match e {
        NetError.DnsFailure(m) => {
            return m
        }
        NetError.ConnectionFailed(m) => {
            return m
        }
        NetError.TlsError(m) => {
            return m
        }
        NetError.SendFailed(m) => {
            return m
        }
        NetError.Timeout(m) => {
            return "timed out: " + m
        }
        NetError.TooLarge(m) => {
            return "too large: " + m
        }
        NetError.Other(m) => {
            return m
        }
    }
}

// Writes give up per call, as fdWriteBy does in std/http: one slow-to-drain response
// cannot be starved by an earlier one on the same connection.
fn tlsWrite(stream: &TlsConn, data: &string, ms: i64): void {
    let _sent = stream.sendWithin(data, ms)
}

// The next connection whose handshake finished within the read timeout. One client
// failing the handshake (wrong protocol, an untrusting client hanging up mid-flight, a
// port scanner, one that connects and sends nothing) must not be fatal.
fn acceptNext(listener: &TlsListener, opts: &ServeOptions): TlsConn {
    while true {
        match listener.acceptWithin(opts.readTimeoutMs) {
            Result.Err(_e) => {
                continue
            }
            Result.Ok(stream) => {
                return stream
            }
        }
    }
}

// Bind, load the cert chain and announce. Shared by serveTls() and serveRouterTls():
// the plaintext pair in std/http had drifted the same way, and a cert-loading fix that
// lands in only one of two copies is a server that quietly keeps serving the old chain.
fn bindTls(port: u16?, certPath: &string, keyPath: &string): Result<TlsListener> {
    var bindPort: u16 = 0
    if let Option.Some(p) = port {
        bindPort = p
    }

    match TlsListener.bind(bindPort, certPath, keyPath) {
        Result.Err(e) => {
            return Result.Err(netErrText(e))
        }
        Result.Ok(listener) => {
            print($"listening on https://localhost:{listener.port()}")
            return Result.Ok(listener)
        }
    }
}

// Serve HTTPS on `port` (None = OS-chosen) with the PEM cert chain and private key at
// `certPath`/`keyPath`. One request per connection, closed after the response, read with
// std/http's own reader (chunked and gzip/deflate bodies, the 1 MiB body cap and the
// 400/413/414/431/501/505 refusals) and ServeOptions' default read and write timeouts:
// the same contract as http.serve. Only returns on a fatal bind/listen error.
pub fn serveTls(port: u16?, certPath: &string, keyPath: &string, handler: (&Request) => Response): Result<Unit> {
    let listener = bindTls(port, certPath, keyPath)?
    let opts = ServeOptions {
    }
    while true {
        let stream = acceptNext(listener, opts)
        // The handshake had its own readTimeoutMs; the request gets a fresh one, fixed for
        // the whole request so a client dribbling a byte at a time still runs out.
        let by = deadlineIn(opts.readTimeoutMs)
        serveHandlerExchange((raw: &mut string): i64 => stream.readMoreBy(&mut raw, by), (data: &string): void => tlsWrite(stream, data, opts.writeTimeoutMs), handler)
        // stream drops here: close_notify, SSL_free, close(fd)
    }
    return Result.Err("server exited")
}

// serveRouter over TLS: routes, Context-set headers and the router's body limits behave
// exactly as in std/http.
pub fn serveRouterTls(port: u16?, certPath: &string, keyPath: &string, router: &Router): Result<Unit> {
    return serveRouterTlsWith(port, certPath, keyPath, router, ServeOptions {
    })
}

// serveRouterTls with the read and write timeouts spelled out (ServeOptions). Connections
// are served one at a time, so maxConn and drainMs do not apply; a client that stalls
// the handshake or the request is what readTimeoutMs bounds, and it stops everyone else
// until then.
pub fn serveRouterTlsWith(port: u16?, certPath: &string, keyPath: &string, router: &Router, opts: &ServeOptions): Result<Unit> {
    let listener = bindTls(port, certPath, keyPath)?
    while true {
        let stream = acceptNext(listener, opts)
        let by = deadlineIn(opts.readTimeoutMs)
        serveRouterExchange((raw: &mut string): i64 => stream.readMoreBy(&mut raw, by), (data: &string): void => tlsWrite(stream, data, opts.writeTimeoutMs), router)
    }
    return Result.Err("server exited")
}
