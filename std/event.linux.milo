// std/event — cross-platform event loop (Linux/epoll implementation)
//
// epoll_event is `{ events: u32, data: union(u64) }` and its layout is the one struct
// in the kernel ABI that differs by architecture on the same OS: the kernel declares it
// `__attribute__((packed))` on x86_64 only, so there it is 12 bytes with `data` at
// offset 4, while on aarch64 (and every other arch) it is 16 bytes with `data` at
// offset 8. Hardcoding the x86_64 shape put the fd in the padding on arm64 and every
// registration silently watched fd 0: no green-IO fixture ever completed on
// linux-arm64. We store the fd in `data` as an i32 and read it back from the same offset.

from "std/os" import {
    malloc,
    free,
    memset
}
from "std/platform" import {
    epoll_create1,
    epoll_ctl,
    epoll_wait,
    fcntl,
    fGetfl,
    fSetfl,
    oNonblock,
    epollCtlAdd,
    epollCtlDel,
    epollIn,
    epollOut,
    close,
    read,
    write
}

pub fn epollEventSize(): i64 {
    return if @targetArch() == "x86_64" {
        12
    } else {
        16
    }
}

fn epollDataOffset(): i64 {
    return if @targetArch() == "x86_64" {
        4
    } else {
        8
    }
}

pub struct EventLoop {
    epfd: i32,
}

// @internal
pub fn eventLoopNew(): Result<EventLoop, string> {
    unsafe {
        let fd = epoll_create1(0)
        if fd < 0 {
            return Result.Err("epoll_create1() failed")
        }
        return Result.Ok(EventLoop {
            epfd: fd
        }
        )
    }
}

impl EventLoop {
    fn new(): Result<EventLoop, string> {
        return eventLoopNew()
    }
}

pub fn setNonblocking(fd: i32): i32 {
    unsafe {
        let flags = fcntl(fd, fGetfl())
        if flags < 0 {
            return -1
        }
        return fcntl(fd, fSetfl(), flags | oNonblock())
    }
}

// Clear O_NONBLOCK. fd 0/1/2 share an open file description with the parent
// shell, so a non-blocking flag left set here leaks out and makes the shell's
// reads return EAGAIN after we exit. Restore blocking mode before exiting.
pub fn clearNonblocking(fd: i32): i32 {
    unsafe {
        let flags = fcntl(fd, fGetfl())
        if flags < 0 {
            return -1
        }
        return fcntl(fd, fSetfl(), flags & ~oNonblock())
    }
}

pub fn eventRegisterRead(el: &EventLoop, fd: i32): i32 {
    unsafe {
        var ev: [u8; 16] = [0; 16]
        let pEvents = ev as *u32
        pEvents[0] = epollIn()
        let pData = ((ev as i64) + epollDataOffset()) as *i32
        pData[0] = fd
        return epoll_ctl(el.epfd, epollCtlAdd(), fd, ev as *u8)
    }
}

pub fn eventRegisterWrite(el: &EventLoop, fd: i32): i32 {
    unsafe {
        var ev: [u8; 16] = [0; 16]
        let pEvents = ev as *u32
        pEvents[0] = epollOut()
        let pData = ((ev as i64) + epollDataOffset()) as *i32
        pData[0] = fd
        return epoll_ctl(el.epfd, epollCtlAdd(), fd, ev as *u8)
    }
}

pub fn eventDeregister(el: &EventLoop, fd: i32, _forWrite: bool): i32 {
    unsafe {
        var ev: [u8; 16] = [0; 16]
        return epoll_ctl(el.epfd, epollCtlDel(), fd, ev as *u8)
    }
}

// poll for ready events. readyFds: caller-allocated *i32 array with capacity >= maxEvents.
// returns count of ready fds, or -1 on error.
// timeoutMs < 0 means block indefinitely.
pub fn eventPoll(el: &EventLoop, readyFds: *i32, maxEvents: i32, timeoutMs: i32): i32 {
    unsafe {
        let bufSize = maxEvents as i64 * epollEventSize()
        let evBuf = malloc(bufSize)
        memset(evBuf, 0, bufSize)

        let n = epoll_wait(el.epfd, evBuf, maxEvents, timeoutMs)

        if n > 0 {
            let base = evBuf as i64
            for i in 0..n {
                let fdAddr = base + (i as i64 * epollEventSize()) + epollDataOffset()
                readyFds[i as i64] = *(fdAddr as *i32)
            }
        }

        free(evBuf)
        return n
    }
}

// ── wakeup event (cross-thread poll interruption) ──
// eventfd registered for read; a write from any thread makes epoll_wait return.
pub extern fn eventfd(initval: u32, flags: i32): i32

pub fn efdNonblock(): i32 {
    return 2048
}

pub fn efdCloexec(): i32 {
    return 524288
}

pub fn eventLoopInitWakeup(el: &EventLoop): i32 {
    unsafe {
        let efd = eventfd(0, efdNonblock() | efdCloexec())
        if efd < 0 {
            return -1
        }
        if eventRegisterRead(el, efd) < 0 {
            close(efd)
            return -1
        }
        return efd
    }
}

// safe from any thread: write(2) on an eventfd is atomic
pub fn eventLoopNotify(_el: &EventLoop, wakeupId: i32): i32 {
    unsafe {
        var one: u64 = 1
        let n = write(wakeupId, (one.addrOf()) as *u8, 8)
        if n == 8 {
            return 0
        }
        return -1
    }
}

// eventfd is level-triggered under epoll; the counter must be consumed or
// every subsequent poll reports it ready again
pub fn eventLoopDrainWakeup(_el: &EventLoop, wakeupId: i32): void {
    unsafe {
        var buf: u64 = 0
        read(wakeupId, (buf.addrOf()) as *u8, 8)
    }
}

pub fn eventLoopCloseWakeup(el: &EventLoop, wakeupId: i32): void {
    unsafe {
        eventDeregister(el, wakeupId, false)
        close(wakeupId)
    }
}

pub fn eventLoopFromFd(fd: i32): EventLoop {
    return EventLoop {
        epfd: fd
    }
}

pub fn eventLoopFd(el: &EventLoop): i32 {
    return el.epfd
}

pub fn eventLoopClose(el: &EventLoop): void {
    unsafe {
        close(el.epfd)
    }
}
