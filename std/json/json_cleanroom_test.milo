    assert(d.path("items.name").isNone())
    assert(d.path("a[0]").isNone())
}

@req(JSON-PATH)
fn testPathNonDigitInBracketsIsNone() {
    let d = P(SAMPLE)
    assert(d.path("items[x]").isNone())
    assert(d.path("items[-1]").isNone())
    assert(d.path("items[1x]").isNone())
    assert(d.path("items[ 1]").isNone())
    assert(d.path("items[+1]").isNone())
    assert(d.path("items[1.0]").isNone())
