// Tests that verify the requirements in std/json/requirements.json. `milo trace std/json.milo`
// finds them by the @req on each test; `milo test std/json/json_test.milo` runs them.
//
// The JSONTestSuite cases (tests/vendor/JSONTestSuite, MIT) are read from disk, relative to the
// repository root (or one or two levels below it). Every y_ case must be accepted, every n_
// case rejected, and each i_ case (the suite leaves them to the implementation) must match the
// choice recorded in implDefinedRejects, which is also stated in the requirements.
from "std/testing" import { assertTrue, assertFalse, assertStrEqual, assertEqual64, assertNear }
from "std/fs" import { readDir, readFile, isDir }
from "std/json" import { Json, JsonError, JsonMismatch, jsonKindName, jsonQuote, jsonF32Str, jsonBoolStr, JsonEvent, JsonToken, JsonVal, jsonPull, jsoncParse, jsonSer, jsonEscapeStr, jsonFloatStr, jsonPretty, JSON_MAX_DEPTH }

fn accepts(text: string): bool {
    var ok: bool = false
    match Json.parse(text) {
        Result.Ok(_j) => {
            ok = true
        }
        Result.Err(_e) => {
            ok = false
        }
    }
    return ok
}

fn acceptsJsonc(text: string): bool {
    var ok: bool = false
    match jsoncParse(text) {
        Result.Ok(_j) => {
            ok = true
        }
        Result.Err(_e) => {
            ok = false
        }
    }
    return ok
}

fn errOf(text: string): string {
    var msg: string = ""
    match Json.parse(text) {
        Result.Ok(_j) => {
            msg = "ok"
        }
        Result.Err(e) => {
            msg = e
        }
    }
    return msg
}

// Parsed document, or `null` when the text is rejected (callers only use it after accepts()).
fn rootStr(text: string): string {
    var out: string = "<rejected>"
    match Json.parse(text) {
        Result.Ok(j) => {
            out = j.asStr() ?? "<not a string>"
        }
        Result.Err(_e) => {
            out = "<rejected>"
        }
    }
    return out
}

fn rootF64(text: string): f64 {
    var out: f64 = -1.0
    match Json.parse(text) {
        Result.Ok(j) => {
            out = j.asF64() ?? -2.0
        }
        Result.Err(_e) => {
            out = -3.0
        }
    }
    return out
}

// Fails (with the offending text in the message) when `text` is not accepted / not rejected.
fn mustAccept(text: string) {
    assertTrue(accepts(text))
}

fn mustReject(text: string) {
    assertFalse(accepts(text))
}

// ── JSONTestSuite ──

fn suiteDir(): string {
    var d: string = "tests/vendor/JSONTestSuite/test_parsing"
    if isDir(d) {
        return d
    }
    d = "../tests/vendor/JSONTestSuite/test_parsing"
    if isDir(d) {
        return d
    }
    return "../../tests/vendor/JSONTestSuite/test_parsing"
}

// The i_ cases this parser rejects. Everything else in i_ is accepted. The reasons:
// ill-formed UTF-8 (JSON-UTF8), UTF-16 text and a leading BOM (JSON-BOM). Accepted: all ten
// number-range cases (JSON-NUM-RANGE), lone and inverted surrogate escapes, which decode to
// U+FFFD (JSON-STR-SURROGATE), and 500 nested arrays (JSON-DEPTH, limit 512).
fn implDefinedRejects(name: &string): bool {
    return name == "i_string_invalid_utf-8.json" || name == "i_string_iso_latin_1.json"
    || name == "i_string_lone_utf8_continuation_byte.json" || name == "i_string_not_in_unicode_range.json"
    || name == "i_string_overlong_sequence_2_bytes.json" || name == "i_string_overlong_sequence_6_bytes_null.json"
    || name == "i_string_overlong_sequence_6_bytes.json" || name == "i_string_truncated-utf-8.json"
    || name == "i_string_UTF-16LE_with_BOM.json" || name == "i_string_UTF-8_invalid_sequence.json"
    || name == "i_string_utf16BE_no_BOM.json" || name == "i_string_utf16LE_no_BOM.json"
    || name == "i_string_UTF8_surrogate_U+D800.json" || name == "i_structure_UTF-8_BOM_empty_object.json"
}

// Runs every case whose file name starts with `prefix`. `want` 1 = must accept, 0 = must
// reject, 2 = implementation-defined (checked against implDefinedRejects). Returns the names
// of the cases that disagree, space separated, and counts the cases it ran into `checked`.
fn runCases(prefix: string, want: i32, checked: &mut i64): string {
    let dir = suiteDir()
    let ents = readDir(dir) ?? Vec.new()
    var bad: string = ""
    for e in ents {
        if !e.name.startsWith(prefix) {
            continue
        }
        var text: string = ""
        match readFile(dir + "/" + e.name) {
            Result.Ok(t) => {
                text = t
            }
            Result.Err(_e) => {
                bad = bad + " unreadable:" + e.name
                continue
            }
        }
        checked += 1
        let got = accepts(text)
        var expect: bool = want == 1
        if want == 2 {
            expect = !implDefinedRejects(e.name)
        }
        if got != expect {
            bad = bad + " " + e.name
        }
    }
    return bad
}

@req(JSON-ARRAY)
fn testSuiteArrays(): void {
    var n: i64 = 0
    let bad = runCases("y_array", 1, &mut n) + runCases("n_array", 0, &mut n)
    assertEqual64(n, 37)
    assertStrEqual(bad, "")
}

@req(JSON-OBJECT)
@req(JSON-DUP-NAMES)
fn testSuiteObjects(): void {
    var n: i64 = 0
    let bad = runCases("y_object", 1, &mut n) + runCases("n_object", 0, &mut n)
    assertEqual64(n, 40)
    assertStrEqual(bad, "")
}

@req(JSON-NUM-GRAMMAR)
fn testSuiteNumbers(): void {
    var n: i64 = 0
    let bad = runCases("y_number", 1, &mut n) + runCases("n_number", 0, &mut n)
    assertEqual64(n, 70)
    assertStrEqual(bad, "")
}

@req(JSON-STR-CHARS)
@req(JSON-STR-ESC)
@req(JSON-STR-UESC)
@req(JSON-STR-SURROGATE)
@req(JSON-UTF8)
fn testSuiteStrings(): void {
    var n: i64 = 0
    let bad = runCases("y_string", 1, &mut n) + runCases("n_string", 0, &mut n)
    assertEqual64(n, 72)
    assertStrEqual(bad, "")
}

@req(JSON-TEXT)
@req(JSON-WS)
@req(JSON-LITERALS)
@req(JSON-BOM)
fn testSuiteStructure(): void {
    var n: i64 = 0
    let bad = runCases("y_structure", 1, &mut n) + runCases("n_structure", 0, &mut n)
    + runCases("n_incomplete", 0, &mut n) + runCases("n_multidigit", 0, &mut n) + runCases("n_single", 0, &mut n)
    assertEqual64(n, 64)
    assertStrEqual(bad, "")
}

// All 95 y_ cases accepted, all 188 n_ cases rejected: the headline requirement.
@req(JSON-PARSE)
fn testSuiteEveryYAcceptedEveryNRejected(): void {
    var ny: i64 = 0
    var nn: i64 = 0
    let bad = runCases("y_", 1, &mut ny) + runCases("n_", 0, &mut nn)
    assertEqual64(ny, 95)
    assertEqual64(nn, 188)
    assertStrEqual(bad, "")
}

@req(JSON-NUM-RANGE)
@req(JSON-STR-SURROGATE)
@req(JSON-UTF8)
@req(JSON-BOM)
@req(JSON-DEPTH)
fn testSuiteImplementationDefined(): void {
    var n: i64 = 0
    let bad = runCases("i_", 2, &mut n)
    assertEqual64(n, 35)
    assertStrEqual(bad, "")
}

// ── grammar ──

@req(JSON-TEXT)
fn testTopLevelAndTrailing(): void {
    mustAccept("1")
    mustAccept("\"a\"")
    mustAccept("null")
    mustAccept("true")
    mustAccept(" \t\n\r[] \r\n")
    mustReject("")
    mustReject("   ")
    mustReject("[] []")
    mustReject("1 2")
    mustReject("{} x")
    mustReject("[]]")
}

@req(JSON-WS)
fn testWhitespaceSet(): void {
    mustAccept("\t[\n1\r,\r\n2 ]")
    mustReject("[1,\x0b2]")
    mustReject("[1,\x0c2]")
    mustReject("[1,\u{a0}2]")
    mustReject("[1,\u{2028}2]")
    mustReject("[1,\x002]")
    mustReject("\x00[]")
}

@req(JSON-LITERALS)
fn testLiterals(): void {
    mustAccept("[true,false,null]")
    mustReject("True")
    mustReject("NULL")
    mustReject("tru")
    mustReject("truee")
    mustReject("nul")
    mustReject("nullx")
    mustReject("[true false]")
    mustReject("[fals]")
}

@req(JSON-OBJECT)
fn testObjects(): void {
    mustAccept("{}")
    mustAccept("{ \"a\" : 1 , \"b\" : [ ] , \"c\" : { } }")
    mustReject("{a:1}")
    mustReject("{\"a\" 1}")
    mustReject("{\"a\":}")
    mustReject("{\"a\":1,}")
    mustReject("{,}")
    mustReject("{\"a\":1,,\"b\":2}")
    mustReject("{\"a\":1")
    mustReject("{\"a\":1]")
    mustReject("{1:2}")
    mustReject("{\"a\":1 \"b\":2}")
    mustReject("{'a':1}")
}

@req(JSON-DUP-NAMES)
fn testDuplicateNames(): void {
    match Json.parse("{\"a\":1,\"b\":0,\"a\":2}") {
        Result.Ok(j) => {
            assertEqual64(j.i64("a") ?? -1, 1)
            assertEqual64(j.len(), 3)
            let ks = j.keys()
            assertStrEqual(ks[0], "a")
            assertStrEqual(ks[1], "b")
            assertStrEqual(ks[2], "a")
        }
        Result.Err(_e) => {
            assertTrue(false)
        }
    }
}

@req(JSON-ARRAY)
fn testArrays(): void {
    mustAccept("[]")
    mustAccept("[ 1 , [ ] , [ [ 2 ] ] ]")
    mustReject("[1,]")
    mustReject("[,1]")
    mustReject("[1,,2]")
    mustReject("[1:2]")
    mustReject("[1")
    mustReject("[1}")
    mustReject("[,]")
}

@req(JSON-NUM-GRAMMAR)
fn testNumberGrammar(): void {
    mustAccept("[0,-0,1,-1,10,0.5,-0.5,1e5,1E5,1e+5,1e-5,1.5e3,0e0,0.0e-0,123456789012345678901234567890]")
    mustReject("01")
    mustReject("-01")
    mustReject("00")
    mustReject("+1")
    mustReject(".5")
    mustReject("5.")
    mustReject("1.e3")
    mustReject("1e")
    mustReject("1e+")
    mustReject("-")
    mustReject("--1")
    mustReject("0x10")
    mustReject("1.5.5")
    mustReject("NaN")
    mustReject("Infinity")
    mustReject("-Infinity")
    mustReject("[1 e5]")
    mustReject("[1_0]")
    mustReject("[0e]")
}

@req(JSON-NUM-RANGE)
fn testNumberRange(): void {
    // f64: correctly rounded, +/-infinity past the range, zero below it
    assertTrue(rootF64("1e999") > 1.7976931348623157e308)
    assertTrue(rootF64("-1e999") < -1.7976931348623157e308)
    assertNear(rootF64("1e-999"), 0.0, 1e-300)
    assertTrue(rootF64("0.3") == 0.3)
    assertTrue(rootF64("1e23") == 1e23)
    assertTrue(rootF64("123456789012345678901234567890") == 1.2345678901234568e29)
    // a very long literal and a very large exponent are accepted
    var big: string = "1"
    for _i in 0..5000 {
        big.push('0')
    }
    mustAccept(big)
    mustAccept("1e99999999999999999999999999")
    // integer accessors answer only for an exact i64 / u64
    match Json.parse("[9223372036854775807, 9223372036854775808, 1.5, 1e3, -42, 18446744073709551615, -5]") {
        Result.Ok(j) => {
            assertEqual64(j.at(0)!.asI64() ?? -1, 9223372036854775807)
            assertTrue(j.at(1)!.asI64() == Option.None)
            assertTrue(j.at(2)!.asI64() == Option.None)
            assertTrue(j.at(3)!.asI64() == Option.None)
            assertEqual64(j.at(4)!.asI64() ?? 0, -42)
            assertTrue(j.at(5)!.asI64() == Option.None)
            assertStrEqual(j.at(5)!.rawStr(), "18446744073709551615")
            let cur = j.curChild(j.curRoot(), 5)
            assertTrue((j.curUint(cur) ?? 7) == 18446744073709551615)
            assertTrue((j.curUint(j.curChild(j.curRoot(), 6)) ?? 7) == 7)
        }
        Result.Err(_e) => {
            assertTrue(false)
        }
    }
}

@req(JSON-SAFE-ARITH)
fn testIntegerReadsNeverWrap(): void {
    let lits = ["9223372036854775808", "99999999999999999999", "-9223372036854775809", "184467440737095516150"]
    for l in lits {
        match Json.parse(l) {
            Result.Ok(j) => {
                assertTrue(j.asI64() == Option.None)
            }
            Result.Err(_e) => {
                assertTrue(false)
            }
        }
    }
    let hi = Json.parse("9223372036854775807")!
    assertEqual64(hi.asI64() ?? 0, 9223372036854775807)
    let lo = Json.parse("-9223372036854775807")!
    assertEqual64(lo.asI64() ?? 0, -9223372036854775807)
}

@req(JSON-STR-CHARS)
fn testStringChars(): void {
    mustAccept("\"\"")
    mustAccept("\"abc\"")
    mustAccept("\" \"")
    mustAccept("\"\x7f\"")
    mustAccept("\"\u{e9}\u{20ac}\u{1F600}\"")
    mustReject("\"abc")
    mustReject("\"")
    mustReject("\"a\tb\"")
    mustReject("\"a\nb\"")
    mustReject("\"a\rb\"")
    mustReject("\"a\x00b\"")
    mustReject("\"a\x1fb\"")
    mustReject("'abc'")
    mustReject("[\"a\" \"b\"]")
}

@req(JSON-STR-ESC)
fn testStringEscapes(): void {
    assertStrEqual(rootStr("\"\\\"\\\\\\/\\b\\f\\n\\r\\t\""), "\"\\/\x08\x0c\n\r\t")
    mustReject("\"\\x\"")
    mustReject("\"\\a\"")
    mustReject("\"\\'\"")
    mustReject("\"\\")
    mustReject("\"\\\"")
    mustReject("\"\\\n\"")
    mustReject("\"\\0\"")
    mustReject("\"\\U0041\"")
}

@req(JSON-STR-UESC)
fn testUnicodeEscapes(): void {
    assertStrEqual(rootStr("\"\\u0041\""), "A")
    assertStrEqual(rootStr("\"\\u00e9\""), "\u{e9}")
    assertStrEqual(rootStr("\"\\u00E9\""), "\u{e9}")
    assertStrEqual(rootStr("\"\\u20AC\""), "\u{20ac}")
    assertStrEqual(rootStr("\"\\u0000\""), "\x00")
    mustReject("\"\\u\"")
    mustReject("\"\\u1\"")
    mustReject("\"\\u12\"")
    mustReject("\"\\u123\"")
    mustReject("\"\\u12G4\"")
    mustReject("\"\\uZZZZ\"")
    mustReject("\"\\u 123\"")
    mustReject("\"\\u123")
}

@req(JSON-STR-SURROGATE)
fn testSurrogates(): void {
    assertStrEqual(rootStr("\"\\ud83d\\ude00\""), "\u{1F600}")
    assertStrEqual(rootStr("\"\\uD834\\uDD1E\""), "\u{1D11E}")
    assertEqual64(rootStr("\"\\ud83d\\ude00\"").len, 4)
    // lone and reversed surrogates decode to U+FFFD, never to invalid UTF-8
    assertStrEqual(rootStr("\"\\ud800\""), "\u{fffd}")
    assertStrEqual(rootStr("\"\\udc00\""), "\u{fffd}")
    assertStrEqual(rootStr("\"\\ud800\\u0041\""), "\u{fffd}A")
    assertStrEqual(rootStr("\"\\ude00\\ud83d\""), "\u{fffd}\u{fffd}")
}

@req(JSON-UTF8)
fn testUtf8Validation(): void {
    mustReject("\"\xff\"")
    mustReject("\"\xc3\"")
    mustReject("\"\xc0\x80\"")
    mustReject("\"\xc1\xbf\"")
    mustReject("\"\xed\xa0\x80\"")
    mustReject("\"\xf4\x90\x80\x80\"")
    mustReject("\"\xf8\x88\x80\x80\x80\"")
    mustReject("\"\x80\"")
    mustReject("\"\xe2\x82\"")
    mustReject("\"\xe0\x80\x80\"")
    mustReject("\"\xf0\x80\x80\x80\"")
    mustAccept("\"\xc2\x80\"")
    mustAccept("\"\xdf\xbf\"")
    mustAccept("\"\xe0\xa0\x80\"")
    mustAccept("\"\xed\x9f\xbf\"")
    mustAccept("\"\xef\xbf\xbf\"")
    mustAccept("\"\xf0\x90\x80\x80\"")
    mustAccept("\"\xf4\x8f\xbf\xbf\"")
    // a name is a string too
    mustReject("{\"\xff\":1}")
    // outside a string any non-ASCII byte is already an error
    mustReject("[\u{e9}]")
}

@req(JSON-BOM)
fn testByteOrderMarkAndUtf16(): void {
    mustReject("\xef\xbb\xbf{}")
    mustReject("\xef\xbb\xbf[1]")
    mustReject("\xff\xfe[\x00]\x00")
    mustReject("\xfe\xff\x00[\x00]")
    mustReject("[\x00]\x00")
}

@req(JSON-DEPTH)
fn testDepthLimit(): void {
    var ok: string = ""
    var deep: string = ""
    for _i in 0..512 {
        ok.push('[')
        deep.push('[')
    }
    deep.push('[')
    for _i in 0..512 {
        ok.push(']')
        deep.push(']')
    }
    deep.push(']')
    mustAccept(ok)
    mustReject(deep.clone())
    assertTrue(errOf(deep).contains("nesting deeper than 512"))
    assertEqual64(JSON_MAX_DEPTH, 512)
}

// ── memory safety ──

fn corpus(): string {
    return "{\"a\":[1,-2.5e+3,true,false,null,\"x\\u00e9\\ud83d\\ude00\\n\"],\"b\":{\"c\":\"\u{e9}\u{1F600}\",\"d\":[]},\"e\":0}"
}

// Every prefix of a valid document, every single-byte corruption of it, and a few hostile
// shapes go through the parser, the JSONC parser and the tokenizer: none may crash or hang.
// Only the whole document may be accepted.
@req(JSON-SAFE)
@req(JSON-SAFE-BOUNDS)
fn testTruncationAndCorruptionNeverCrash(): void {
    let doc = corpus()
    var accepted: i64 = 0
    for n in 0..doc.len + 1 {
        let cut = doc.substr(0, n)
        if accepts(cut.clone()) {
            accepted += 1
        }
        if acceptsJsonc(cut.clone()) {
            accepted += 0
        }
        var p = jsonPull(cut)
        var steps: i64 = 0
        while steps < doc.len + 8 {
            let t = p.next()
            steps += 1
            if t.kind == JsonEvent.End || t.kind == JsonEvent.Error {
                break
            }
        }
        assertTrue(steps < doc.len + 8)
    }
    assertEqual64(accepted, 1)
    // flip each byte to a spread of values; the answer is irrelevant, surviving is the test
    let flips = ["\"", "\\", "[", "}", "0", "\x00", "\xff", "e", "-", ","]
    for i in 0..doc.len {
        for f in flips {
            let mutated = doc.substr(0, i) + f + doc.substr(i + 1, doc.len)
            if accepts(mutated.clone()) {
                accepted += 0
            }
            var p = jsonPull(mutated)
            var steps: i64 = 0
            while steps < doc.len + 16 {
                let t = p.next()
                steps += 1
                if t.kind == JsonEvent.End || t.kind == JsonEvent.Error {
                    break
                }
            }
            assertTrue(steps < doc.len + 16)
        }
    }
    // 100000 opening brackets: depth limit, not a stack overflow
    var bomb: string = ""
    for _i in 0..100000 {
        bomb.push('[')
    }
    mustReject(bomb)
    // a lone backslash, quote and sign at the very end of input
    mustReject("[\"\\")
    mustReject("[-")
    mustReject("[1e")
    mustReject("[\"\xe2\x82")
    mustReject("[tru")
}

// ── serializer ──

@req(JSON-SER-ESCAPE)
fn testEscape(): void {
    assertStrEqual(jsonEscapeStr("a\"b"), "a\\\"b")
    assertStrEqual(jsonEscapeStr("a\\b"), "a\\\\b")
    assertStrEqual(jsonEscapeStr("\n\t\r"), "\\n\\t\\r")
    assertStrEqual(jsonEscapeStr("\x01"), "\\u0001")
    assertStrEqual(jsonEscapeStr("\x08"), "\\u0008")
    assertStrEqual(jsonEscapeStr("\x1f"), "\\u001f")
    assertStrEqual(jsonEscapeStr("\x00"), "\\u0000")
    assertStrEqual(jsonEscapeStr("\u{e9}\u{1F600}"), "\u{e9}\u{1F600}")
    assertStrEqual(jsonEscapeStr("\x7f /"), "\x7f /")
    // no byte below 0x20 survives
    var all: string = ""
    for b in 0..32 {
        all.push(b as u8)
    }
    let esc = jsonEscapeStr(all)
    for i in 0..esc.len {
        assertTrue(esc[i] >= 32)
    }
}

@req(JSON-SER-GRAMMAR)
fn testSerializerGrammar(): void {
    let text = Json.obj().int("a", 1).arr("b", Json.arr().bool(true).nil().str("x")).obj("c", Json.obj()).str("q\"k", "v").build()
    assertStrEqual(text, "{\"a\":1,\"b\":[true,null,\"x\"],\"c\":{},\"q\\\"k\":\"v\"}")
    mustAccept(text)
    mustAccept(Json.arr().build())
    mustAccept(Json.obj().build())
    let v = JsonVal.JObj(Vec.new())
    assertStrEqual(jsonSer(v), "{}")
}

@req(JSON-SER-NUM)
fn testSerializerNumbers(): void {
    assertStrEqual(Json.arr().int(0).int(-1).int(9223372036854775807).int(-9223372036854775807).build(), "[0,-1,9223372036854775807,-9223372036854775807]")
    let fl = [1.5, 1e22, 1e-7, 0.1, 1.7976931348623157e308, 5e-324, -0.25, 100.0, 123456789.125]
    for f in fl {
        let t = jsonFloatStr(f)
        mustAccept(t.clone())
        assertTrue(rootF64(t) == f)
    }
    let zero: f64 = 0.0
    let nan = zero / zero
    let inf = 1.0 / zero
    assertStrEqual(jsonFloatStr(nan), "null")
    assertStrEqual(jsonFloatStr(inf), "null")
    assertStrEqual(jsonFloatStr(0.0 - inf), "null")
}

@req(JSON-SER)
@req(JSON-SER-ROUNDTRIP)
fn testRoundTrip(): void {
    // every ASCII byte (controls included) plus multi-byte text survives string -> JSON -> string
    var s: string = ""
    for b in 0..128 {
        s.push(b as u8)
    }
    s = s + "\u{e9}\u{20ac}\u{1F600}\u{10ffff}\"\\/"
    let text = jsonSer(JsonVal.JStr(s.clone()))
    assertStrEqual(rootStr(text), s)
    // a document: order, duplicate names, integer extremes, nested values
    let doc = Json.obj().int("z", -9223372036854775807).str("a", "x").int("z", 2).arr("l", Json.arr().int(3).int(1).int(2)).build()
    match Json.parse(doc.clone()) {
        Result.Ok(j) => {
            let ks = j.keys()
            assertEqual64(ks.len, 4)
            assertStrEqual(ks[0], "z")
            assertStrEqual(ks[1], "a")
            assertStrEqual(ks[2], "z")
            assertStrEqual(ks[3], "l")
            assertEqual64(j.i64("z") ?? 0, -9223372036854775807)
            assertStrEqual(j.rawStr(), doc)
        }
        Result.Err(_e) => {
            assertTrue(false)
        }
    }
}

@req(JSON-SER-PRETTY)
fn testPretty(): void {
    let compact = "{\"a\":[1,2,{\"b\":\"x  y\"}],\"c\":\" sp \\\" aced \",\"d\":1.50e+3,\"e\":{},\"f\":[]}"
    let pretty = jsonPretty(compact, 2)
    mustAccept(pretty.clone())
    assertTrue(pretty.contains("\n"))
    assertStrEqual(jsonPretty(pretty, 0), compact)
    assertStrEqual(jsonPretty(compact, 0), compact)
}

// ── JSONC ──

@req(JSON-JSONC-COMMENTS)
fn testJsoncComments(): void {
    assertTrue(acceptsJsonc("// head\n{\"a\": 1 /* mid */, // tail\n\"b\": [2]}\n// end"))
    assertTrue(acceptsJsonc("/* x */ 1 /* y */"))
    assertTrue(acceptsJsonc("[\"// not a comment\", \"/* nor this */\"]"))
    // a comment is whitespace: it must not join two tokens into one
    assertFalse(acceptsJsonc("[1/**/2]"))
    assertFalse(acceptsJsonc("[tr/**/ue]"))
    assertTrue(acceptsJsonc("[1/**/,/**/2]"))
    match jsoncParse("{\"u\": \"a//b\" // c\n}") {
        Result.Ok(j) => {
            assertStrEqual(j.str("u") ?? "", "a//b")
        }
        Result.Err(_e) => {
            assertTrue(false)
        }
    }
}

@req(JSON-JSONC-TRAILING)
fn testJsoncTrailingCommas(): void {
    assertTrue(acceptsJsonc("[1,2,]"))
    assertTrue(acceptsJsonc("{\"a\":1,}"))
    assertTrue(acceptsJsonc("[1,2 , /* c */ ]"))
    assertTrue(acceptsJsonc("[[1,],{\"a\":[2,],},]"))
    assertFalse(acceptsJsonc("[,]"))
    assertFalse(acceptsJsonc("[1,,]"))
    assertFalse(acceptsJsonc("{,}"))
    assertFalse(acceptsJsonc("{\"a\":1,,}"))
    assertFalse(acceptsJsonc("[,1]"))
    assertFalse(acceptsJsonc("[\"a,\" ,]x"))
}

@req(JSON-JSONC)
@req(JSON-JSONC-STRICT)
fn testJsoncOtherwiseStrict(): void {
    assertTrue(acceptsJsonc("[1,{\"a\":null}]"))
    assertFalse(acceptsJsonc("[01]"))
    assertFalse(acceptsJsonc("{a:1}"))
    assertFalse(acceptsJsonc("['x']"))
    assertFalse(acceptsJsonc("[\"\\x\"]"))
    assertFalse(acceptsJsonc("[\"\\u12\"]"))
    assertFalse(acceptsJsonc("[\"\xff\"]"))
    assertFalse(acceptsJsonc("[1] [2]"))
    assertFalse(acceptsJsonc(""))
    assertFalse(acceptsJsonc("[1 // unterminated array"))
}

// ── streaming ──

fn evName(t: &JsonToken): string {
    match t.kind {
        JsonEvent.StartObject => {
            return "{"
        }
        JsonEvent.EndObject => {
            return "}"
        }
        JsonEvent.StartArray => {
            return "["
        }
        JsonEvent.EndArray => {
            return "]"
        }
        JsonEvent.Key => {
            return "K:" + t.text
        }
        JsonEvent.Str => {
            return "S:" + t.text
        }
        JsonEvent.Num => {
            return "N:" + jsonFloatStr(t.num)
        }
        JsonEvent.Bool => {
            if t.flag {
                return "true"
            }
            return "false"
        }
        JsonEvent.Null => {
            return "null"
        }
        JsonEvent.End => {
            return "END"
        }
        JsonEvent.Error => {
            return "ERR"
        }
    }
}

fn events(src: string): string {
    var p = jsonPull(src)
    var out: string = ""
    var steps: i64 = 0
    while steps < 1000 {
        let t = p.next()
        let n = evName(t)
        out = out + n + " "
        steps += 1
        if n == "END" || n == "ERR" {
            break
        }
    }
    return out
}

@req(JSON-PULL)
@req(JSON-PULL-EVENTS)
fn testPullEvents(): void {
    assertStrEqual(events("{\"a\":[1,-2.5e1,true,false,null,\"x\\u00e9\\n\"],\"b\":{\"c\":\"d\"}}"), "{ K:a [ N:1 N:-25 true false null S:x\u{e9}\n ] K:b { K:c S:d } } END ")
    assertStrEqual(events("  7  "), "N:7 END ")
    assertStrEqual(events("\"top\""), "S:top END ")
    assertStrEqual(events(""), "END ")
    assertStrEqual(events("[]"), "[ ] END ")
    assertStrEqual(events("{\"\\ud83d\\ude00\":0.3}"), "{ K:\u{1F600} N:0.3 } END ")
}

@req(JSON-PULL-TOKENS)
fn testPullTokenErrors(): void {
    assertStrEqual(events("[tru]"), "[ ERR ")
    assertStrEqual(events("[nul"), "[ ERR ")
    assertStrEqual(events("[nope]"), "[ ERR ")
    assertStrEqual(events("[01]"), "[ ERR ")
    assertStrEqual(events("[1.]"), "[ ERR ")
    assertStrEqual(events("[1e]"), "[ ERR ")
    assertStrEqual(events("[-]"), "[ ERR ")
    assertStrEqual(events("[\"\\x\"]"), "[ ERR ")
    assertStrEqual(events("[\"\\u12\"]"), "[ ERR ")
    assertStrEqual(events("[\"a\tb\"]"), "[ ERR ")
    assertStrEqual(events("[\"\xff\"]"), "[ ERR ")
    assertStrEqual(events("[\"abc"), "[ ERR ")
    assertStrEqual(events("[+1]"), "[ ERR ")
}

@req(JSON-PULL-STRUCTURE)
fn testPullDoesNotCheckStructure(): void {
    // documented limit: tokens are checked one by one, the shape around them is not
    assertStrEqual(events("[1 2]"), "[ N:1 N:2 ] END ")
    assertStrEqual(events("]"), "] END ")
    assertTrue(accepts("[1 2]") == false)
}

// ── the module as a whole ──

@req(JSON-API)
fn testAccessors(): void {
    match Json.parse("{\"s\":\"v\",\"i\":7,\"f\":2.5,\"b\":true,\"n\":null,\"l\":[10,20],\"o\":{\"k\":\"deep\"}}") {
        Result.Ok(j) => {
            assertStrEqual(j.str("s") ?? "", "v")
            assertEqual64(j.i64("i") ?? 0, 7)
            assertNear(j.f64("f") ?? 0.0, 2.5, 1e-12)
            assertTrue(j.bool("b") ?? false)
            let nn = j.get("n")!
            assertTrue(nn.isNull())
            let ll = j.get("l")!
            assertEqual64(ll.len(), 2)
            let l1 = ll.at(1)!
            assertEqual64(l1.asI64() ?? 0, 20)
            assertStrEqual(j.strPath("o.k") ?? "", "deep")
            match j.get("missing") {
                Option.Some(_m) => {
                    assertTrue(false)
                }
                Option.None => {}
            }
            assertTrue(j.isObject())
            let allKeys = j.keys()
            assertEqual64(allKeys.len, 7)
        }
        Result.Err(_e) => {
            assertTrue(false)
        }
    }
}

@req(JSON-SER)
fn testSerializersEmitValidJson(): void {
    mustAccept(jsonSer(JsonVal.JArr(Vec.new())))
    mustAccept(jsonSer(JsonVal.JStr("\x01\x02\"\\")))
    mustAccept(jsonSer(JsonVal.JFloat(1.0e300)))
    mustAccept(Json.obj().str("a", "\n").float("b", 0.5).build())
}

@req(JSON-JSONC)
fn testJsoncAcceptsJsonAndExtensions(): void {
    assertTrue(acceptsJsonc("{\"a\": [1, 2,], /* c */ \"b\": null, // d\n}"))
    assertFalse(acceptsJsonc("{\"a\": [1, 2,], \"b\" null}"))
}

@req(JSON-PULL)
fn testPullStreamsWithoutTree(): void {
    // a 2000-element array is consumed token by token
    var s: string = "["
    for i in 0..2000 {
        if i > 0 {
            s.push(',')
        }
        s = s + i.toString()
    }
    s.push(']')
    var p = jsonPull(s)
    var nums: i64 = 0
    var total: f64 = 0.0
    while true {
        let t = p.next()
        if t.kind == JsonEvent.Num {
            nums += 1
            total += t.num
        }
        if t.kind == JsonEvent.End || t.kind == JsonEvent.Error {
            break
        }
    }
    assertEqual64(nums, 2000)
    assertNear(total, 1999000.0, 1e-9)
}

@req(JSON-SAFE)
fn testHostileShapesTerminate(): void {
    mustReject("{\"a\":")
    mustReject("[".repeat(1000))
    mustReject("{\"a\":".repeat(600))
    mustReject("\"" + "\\".repeat(1001))
    var longNum: string = "-"
    for _i in 0..20000 {
        longNum.push('9')
    }
    mustAccept(longNum)
    mustReject("1" + "e".repeat(10))
}

// ── the document API: accessors, paths, cursors, index chains, errors, builders ──

let DOC: string = "{\"s\":\"v\",\"i\":7,\"f\":2.5,\"b\":true,\"n\":null,\"a\":[1,\"x\",[true]],\"o\":{\"k\":1,\"d\":\"deep\"}}"

fn doc(text: &string): Json {
    let parsed = Json.parse(text)
    assertTrue(parsed.isOk())
    return parsed!
}

@req(JSON-GET)
fn testAccessorsReturnNothingOnAMismatch(): void {
    let j = doc(DOC)
    // wrong kind: never coerced
    assertTrue(j.str("i").isNone())
    assertTrue(j.i64("s").isNone())
    assertTrue(j.i64("f").isNone())
    assertTrue(j.f64("s").isNone())
    assertTrue(j.bool("i").isNone())
    assertTrue(j.get("zz").isNone())
    assertTrue(j.str("zz").isNone())
    // right kind
    assertStrEqual(j.str("s") ?? "", "v")
    assertEqual64(j.i64("i") ?? 0, 7)
    assertNear(j.f64("f") ?? 0.0, 2.5, 1e-12)
    assertTrue(j.bool("b") ?? false)
    // the subtree is a document of its own holding the same text
    let o = j.get("o")!
    assertStrEqual(o.rawStr(), "{\"k\":1,\"d\":\"deep\"}")
    assertStrEqual(o.str("d") ?? "", "deep")
    // positions: in range, out of range, negative, and on an object
    let a = j.get("a")!
    assertEqual64(a.len(), 3)
    assertEqual64(a.at(0)!.asI64() ?? 0, 1)
    assertStrEqual(a.at(1)!.asStr() ?? "", "x")
    assertTrue(a.at(2)!.at(0)!.asBool() ?? false)
    assertTrue(a.at(3).isNone())
    assertTrue(a.at(-1).isNone())
    assertTrue(j.at(0).isNone())
    // non-containers have no members and no length
    let s = j.get("s")!
    assertTrue(s.get("k").isNone())
    assertTrue(s.at(0).isNone())
    assertEqual64(s.len(), 0)
    assertTrue(s.asI64().isNone())
    assertTrue(s.asBool().isNone())
    assertTrue(s.isStr() && !s.isNum() && !s.isBool() && !s.isNull() && !s.isArray() && !s.isObject())
    assertTrue(j.get("n")!.isNull())
    assertTrue(a.isArray() && j.isObject())
    let ks = j.keys()
    assertEqual64(ks.len, 7)
    assertStrEqual(ks[0], "s")
    assertStrEqual(ks[6], "o")
}

@req(JSON-PATH)
fn testPathsReturnNoneForAMissingStep(): void {
    let j = doc(DOC)
    assertStrEqual(j.strPath("o.d") ?? "", "deep")
    assertEqual64(j.i64Path("a[0]") ?? 0, 1)
    assertTrue(j.boolPath("a[2][0]") ?? false)
    assertNear(j.f64Path("f") ?? 0.0, 2.5, 1e-12)
    assertStrEqual(j.path("o")!.rawStr(), "{\"k\":1,\"d\":\"deep\"}")
    // a missing key, an index past the end, a step into a scalar
    assertTrue(j.path("zz").isNone())
    assertTrue(j.path("o.zz").isNone())
    assertTrue(j.strPath("o.zz").isNone())
    assertTrue(j.path("a[3]").isNone())
    assertTrue(j.path("s.x").isNone())
    assertTrue(j.path("s[0]").isNone())
    // malformed brackets
    assertTrue(j.path("a[x]").isNone())
    assertTrue(j.path("a[0").isNone())
    assertEqual64(j.curPath("a[0"), -1)
    // a wrong kind at the end
    assertTrue(j.strPath("i").isNone())
    assertTrue(j.i64Path("s").isNone())
    // relative to a cursor
    let a = j.curPath("a")
    assertEqual64(j.i64At(a, "[0]") ?? 0, 1)
    assertStrEqual(j.strAt(a, "[1]") ?? "", "x")
    assertTrue(j.boolAt(a, "[2][0]") ?? false)
    assertTrue(j.strAt(a, "[9]").isNone())
    assertTrue(j.f64At(a, "[1]").isNone())
    assertEqual64(j.curAt(j.curRoot(), ""), j.curRoot())
}

@req(JSON-CURSOR)
fn testCursorMissesReadAsAbsent(): void {
    let j = doc(DOC)
    let root = j.curRoot()
    assertEqual64(j.curKind(root) as i64, 5)
    assertEqual64(j.curLen(root), 7)
    let a = j.curField(root, "a")
    assertEqual64(j.curKind(a) as i64, 4)
    assertEqual64(j.curLen(a), 3)
    assertEqual64(j.curInt(j.curChild(a, 0)) ?? 0, 1)
    assertStrEqual(j.curStr(j.curChild(a, 1)) ?? "", "x")
    assertStrEqual(j.curRaw(a), "[1,\"x\",[true]]")
    assertTrue(j.curBool(j.curField(root, "b")) ?? false)
    assertNear(j.curFloat(j.curField(root, "f")) ?? 0.0, 2.5, 1e-12)
    // misses are -1 and every reader treats -1 as nothing here
    let miss = j.curField(root, "zz")
    assertEqual64(miss, -1)
    assertEqual64(j.curChild(a, 3), -1)
    assertEqual64(j.curChild(a, -1), -1)
    assertEqual64(j.curChild(root, 0), -1)
    assertEqual64(j.curField(a, "k"), -1)
    assertEqual64(j.curLen(miss), 0)
    assertEqual64(j.curKind(miss) as i64, -1)
    assertTrue(j.curStr(miss).isNone())
    assertTrue(j.curInt(miss).isNone())
    assertTrue(j.curBool(miss).isNone())
    assertStrEqual(j.curRaw(miss), "")
    assertFalse(j.curHolds(miss))
    // a wrong kind is absent, not coerced
    assertTrue(j.curStr(j.curField(root, "i")).isNone())
    assertTrue(j.curInt(j.curField(root, "s")).isNone())
    // object entries by position, in document order, and array walks
    let o = j.curField(root, "o")
    assertStrEqual(j.curKeyAt(o, 0), "k")
    assertStrEqual(j.curKeyAt(o, 1), "d")
    assertStrEqual(j.curKeyAt(o, 2), "")
    assertEqual64(j.curInt(j.curValueAt(o, 0)) ?? 0, 1)
    assertEqual64(j.curValueAt(o, 2), -1)
    assertEqual64(j.curValueAt(a, 0), -1)
    assertEqual64(j.curItems(a).len, 3)
    assertEqual64(j.curItems(o).len, 0)
    // same answers as the owned accessors
    assertStrEqual(j.curJson(a).rawStr(), j.get("a")!.rawStr())
    assertTrue(j.curHolds(a))
    // a cursor from another document is not held
    let other = doc(DOC)
    assertFalse(other.curHolds(a))
}

@req(JSON-INDEX)
fn testIndexChainAnswersLikeTheCursor(): void {
    let j = doc(DOC)
    let root = j.idxRoot()
    assertStrEqual(j.idxStr(j.idxKey(root, "s")) ?? "", "v")
    assertEqual64(j.idxI64(j.idxPos(j.idxKey(root, "a"), 0)) ?? 0, 1)
    assertEqual64(j.idxI64(j.idxPath(root, "a[0]")) ?? 0, 1)
    assertNear(j.idxF64(j.idxKey(root, "f")) ?? 0.0, 2.5, 1e-12)
    assertTrue(j.idxBool(j.idxKey(root, "b")) ?? false)
    assertEqual64(j.idxLen(root), 7)
    assertEqual64(j.idxKind(root) as i64, 5)
    assertStrEqual(j.idxRaw(j.idxKey(root, "o")), "{\"k\":1,\"d\":\"deep\"}")
    assertStrEqual(j.idxJson(j.idxKey(root, "o")).rawStr(), "{\"k\":1,\"d\":\"deep\"}")
    assertEqual64(j.idxItems(j.idxKey(root, "a")).len, 3)
    let keys = j.idxKeys(j.idxKey(root, "o"))
    assertEqual64(keys.len, 2)
    assertStrEqual(keys[1], "d")
    assertEqual64(j.idxI64(j.idxValueAt(j.idxKey(root, "o"), 0)) ?? 0, 1)
    assertEqual64(j.idxCur(root).c, root.c)
    // a missing step is absent, and stays absent down the chain
    let miss = j.idxPos(j.idxKey(root, "zz"), 0)
    assertFalse(j.idxExists(miss))
    assertTrue(j.idxExists(root))
    assertTrue(j.idxStr(miss).isNone())
    assertTrue(j.idxI64(miss).isNone())
    assertTrue(j.idxF64(miss).isNone())
    assertTrue(j.idxBool(miss).isNone())
    assertEqual64(j.idxLen(miss), 0)
    assertEqual64(j.idxItems(miss).len, 0)
    assertEqual64(j.idxKeys(miss).len, 0)
    assertStrEqual(j.idxRaw(miss), "")
    assertFalse(j.idxExists(j.idxPos(j.idxKey(root, "a"), 3)))
    assertFalse(j.idxExists(j.idxKey(j.idxKey(root, "a"), "k")))
}

@req(JSON-ERROR)
fn testErrorsNameTheLocation(): void {
    let syn = JsonError.Syntax("bad token")
    assertStrEqual(syn.path(), "")
    assertStrEqual(syn.message(), "invalid JSON: bad token")
    assertStrEqual(JsonError.Syntax("x").under("a").path(), "")
    let missing = JsonError.Missing("city")
    assertStrEqual(missing.message(), "missing field 'city'")
    assertStrEqual(JsonError.Missing("city").under("address").path(), "address.city")
    // indices abut, they do not take a dot
    assertStrEqual(JsonError.Missing("city").underIndex(3).path(), "[3].city")
    assertStrEqual(JsonError.Missing("city").underIndex(3).under("friends").path(), "friends[3].city")
    let mm = JsonError.Mismatch(JsonMismatch { path: "", expected: "object", actual: "array" })
    assertStrEqual(mm.message(), "document root: expected object, got array")
    let deep = JsonError.Mismatch(JsonMismatch { path: "n", expected: "number", actual: "string" }).under("a")
    assertStrEqual(deep.path(), "a.n")
    assertStrEqual(deep.message(), "field 'a.n': expected number, got string")
    assertStrEqual(jsonKindName(0), "null")
    assertStrEqual(jsonKindName(1), "bool")
    assertStrEqual(jsonKindName(2), "number")
    assertStrEqual(jsonKindName(3), "string")
    assertStrEqual(jsonKindName(4), "array")
    assertStrEqual(jsonKindName(5), "object")
    assertStrEqual(jsonKindName(-1), "missing")
}

@req(JSON-BUILD)
fn testBuilderOutputParsesBack(): void {
    let inner = Json.obj().int("x", -5).nil("n")
    let text = Json.obj().str("s", "q\"\\\n").int("i", 9).float("f", 0.25).bool("b", false).nil("z").obj("o", inner).arr("a", Json.arr().int(1).str("t").bool(true).nil().float(1.5).obj(Json.obj().int("k", 2)).arr(Json.arr().int(3))).raw("r", "[1, 2]").val("v", JsonVal.JInt(4)).build()
    let j = doc(text)
    // members come back in call order, with their kinds and values
    let ks = j.keys()
    assertEqual64(ks.len, 9)
    assertStrEqual(ks[0], "s")
    assertStrEqual(ks[1], "i")
    assertStrEqual(ks[2], "f")
    assertStrEqual(ks[3], "b")
    assertStrEqual(ks[4], "z")
    assertStrEqual(ks[5], "o")
    assertStrEqual(ks[6], "a")
    assertStrEqual(ks[7], "r")
    assertStrEqual(ks[8], "v")
    assertStrEqual(j.str("s") ?? "", "q\"\\\n")
    assertEqual64(j.i64("i") ?? 0, 9)
    assertNear(j.f64("f") ?? 0.0, 0.25, 1e-12)
    assertFalse(j.bool("b") ?? true)
    assertTrue(j.get("z")!.isNull())
    assertEqual64(j.i64Path("o.x") ?? 0, -5)
    assertTrue(j.path("o.n")!.isNull())
    assertEqual64(j.get("a")!.len(), 7)
    assertEqual64(j.i64Path("a[0]") ?? 0, 1)
    assertStrEqual(j.strPath("a[1]") ?? "", "t")
    assertTrue(j.boolPath("a[2]") ?? false)
    assertTrue(j.path("a[3]")!.isNull())
    assertNear(j.f64Path("a[4]") ?? 0.0, 1.5, 1e-12)
    assertEqual64(j.i64Path("a[5].k") ?? 0, 2)
    assertEqual64(j.i64Path("a[6][0]") ?? 0, 3)
    assertEqual64(j.i64Path("r[1]") ?? 0, 2)
    assertEqual64(j.i64("v") ?? 0, 4)
    // an *Opt method adds its key only for Some
    let opt = Json.obj().strOpt("a", Option.Some("x")).strOpt("b", Option.None).intOpt("c", Option.Some(1)).intOpt("d", Option.None).floatOpt("e", Option.Some(0.5)).floatOpt("f", Option.None).boolOpt("g", Option.Some(true)).boolOpt("h", Option.None).build()
    let oj = doc(opt)
    let oks = oj.keys()
    assertEqual64(oks.len, 4)
    assertStrEqual(oks[0], "a")
    assertStrEqual(oks[1], "c")
    assertStrEqual(oks[2], "e")
    assertStrEqual(oks[3], "g")
    // empty builders, and the array builder alone
    assertStrEqual(Json.obj().build(), "{}")
    assertStrEqual(Json.arr().build(), "[]")
    assertEqual64(doc(Json.arr().int(1).int(2).build()).len(), 2)
    // buildPretty is the same value, re-spaced
    let pretty = Json.obj().int("a", 1).arr("b", Json.arr().int(2).int(3)).buildPretty(2)
    assertTrue(pretty.contains("\n"))
    assertStrEqual(jsonPretty(pretty, 0), Json.obj().int("a", 1).arr("b", Json.arr().int(2).int(3)).build())
    assertStrEqual(Json.arr().int(1).buildPretty(0), "[1]")
    // spread copies the members of a parsed object; a key added again replaces its value in place
    let src = doc("{\"a\":1,\"b\":{\"c\":2}}")
    let merged = doc(Json.obj().spread(src, src.curRoot()).int("a", 5).int("d", 6).build())
    let mks = merged.keys()
    assertEqual64(mks.len, 3)
    assertStrEqual(mks[0], "a")
    assertStrEqual(mks[1], "b")
    assertStrEqual(mks[2], "d")
    assertEqual64(merged.i64("a") ?? 0, 5)
    assertEqual64(merged.i64Path("b.c") ?? 0, 2)
    // spreading a non-object contributes nothing
    assertStrEqual(Json.obj().spread(src, src.curField(src.curRoot(), "a")).build(), "{}")
}

@req(JSON-SER-ESCAPE)
@req(JSON-SER-NUM)
@req(JSON-SER-GRAMMAR)
fn testSmallSerializers(): void {
    assertStrEqual(jsonQuote("a\"b\n"), "\"a\\\"b\\n\"")
    assertStrEqual(jsonBoolStr(true), "true")
    assertStrEqual(jsonBoolStr(false), "false")
    assertStrEqual(jsonF32Str(0.1), "0.1")
    let inf: f32 = 1.0e30 * 1.0e30
    assertStrEqual(jsonF32Str(inf), "null")
    assertStrEqual(jsonSer(JsonVal.JBool(true)), "true")
    assertStrEqual(JsonVal.JNull.toJsonText(), "null")
}

@req(JSON-POOL)
fn testPoolReadsBackWhatTheSourceHolds(): void {
    let src = "[null,true,false,-12.5e1,\"str\",[1,2],{\"k\":\"v\",\"e\":{}},[]]"
    let j = doc(src)
    let r = j.curRoot()
    assertEqual64(j.curLen(r), 8)
    let kinds: Vec<i64> = [0, 1, 1, 2, 3, 4, 5, 4]
    for i in 0..8 {
        assertEqual64(j.curKind(j.curChild(r, i)) as i64, kinds[i])
    }
    assertTrue(j.curBool(j.curChild(r, 1)) ?? false)
    assertFalse(j.curBool(j.curChild(r, 2)) ?? true)
    assertNear(j.curFloat(j.curChild(r, 3)) ?? 0.0, -125.0, 1e-9)
    assertStrEqual(j.curStr(j.curChild(r, 4)) ?? "", "str")
    assertEqual64(j.curLen(j.curChild(r, 5)), 2)
    assertEqual64(j.curInt(j.curChild(j.curChild(r, 5), 1)) ?? 0, 2)
    assertStrEqual(j.curKeyAt(j.curChild(r, 6), 1), "e")
    assertEqual64(j.curLen(j.curChild(r, 7)), 0)
    // the whole document, and a subtree handed to a new pool, give the source text back
    assertStrEqual(j.rawStr(), src)
    assertStrEqual(j.at(6)!.rawStr(), "{\"k\":\"v\",\"e\":{}}")
    assertStrEqual(j.at(5)!.rawStr(), "[1,2]")
}
