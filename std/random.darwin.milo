// std/random — random number generation
//
// Uses arc4random (macOS/BSD) — no seeding required, cryptographically strong.
// For Linux compat, could fall back to /dev/urandom via std/io.

from "std/replay" import {
    replayOff, replayActive, replayTakeI64, replayPutI64, replayTakeInto, replayPutFrom
}

pub extern fn arc4random(): u32

pub extern fn arc4random_uniform(upper: u32): u32

pub extern fn arc4random_buf(buf: *u8, nbytes: i64): void

// Random u32 in [0, 2^32).
@replayHooked
fn osRandU32(): u32 {
    unsafe { return arc4random() }
}

// Random i64 in [0, max). Panics if max <= 0.
@replayHooked
fn randInt(max: i64): i64 {
    if max <= 0 {
        eprint("randInt: max must be > 0")
    }
    if replayOff() {
        unsafe { return arc4random_uniform(max as u32) as i64 }
    }
    // Its own kind, not random.u32: arc4random_uniform rejection-samples internally,
    // so the answer is not a function of one recorded u32.
    if replayActive() {
        return replayTakeI64("random.uniform", max.toString())
    }
    var v: i64 = 0
    unsafe { v = arc4random_uniform(max as u32) as i64 }
    replayPutI64("random.uniform", max.toString(), v)
    return v
}

// Random i64 in [min, max]. Panics if min > max.
fn randRange(min: i64, max: i64): i64 {
    if min > max {
        eprint("randRange: min must be <= max")
    }
    let span = max - min + 1
    return min + randInt(span)
}

// Random f64 in [0.0, 1.0).
fn randFloat(): f64 {
    let r = randU32()
    return r as f64 / 4294967296.0
}

// Random f64 in [min, max).
fn randFloatRange(min: f64, max: f64): f64 {
    return min + randFloat() * (max - min)
}

// Random bool (coin flip).
fn randBool(): bool {
    return randInt(2) == 0
}

// Shuffle a Vec<i64> in place using Fisher-Yates. Pass v.len() as n.
fn shuffleI64(v: &mut Vec<i64>, n: i64): void {
    var i = n - 1
    while i > 0 {
        let j = randRange(0, i)
        let tmp = v[i]
        v[i] = v[j]
        v[j] = tmp
        i -= 1
    }
}

// Fill a buffer with random bytes.
@replayHooked
fn osRandBytes(buf: *u8, n: i64): void {
    unsafe { arc4random_buf(buf, n) }
}

// Recorded and replayed under MILO_RECORD / MILO_REPLAY (std/replay), like every
// entropy read in this file.
fn randU32(): u32 {
    if replayOff() {
        return osRandU32()
    }
    if replayActive() {
        return replayTakeI64("random.u32", "") as u32
    }
    let v = osRandU32()
    replayPutI64("random.u32", "", v as i64)
    return v
}

fn randBytes(buf: *u8, n: i64): void {
    if replayOff() {
        osRandBytes(buf, n)
        return
    }
    if replayActive() {
        // randBytes' callers hand it a buffer of at least n bytes.
        unsafe { replayTakeInto("random.bytes", buf, n) }
        return
    }
    osRandBytes(buf, n)
    unsafe { replayPutFrom("random.bytes", buf, n) }
}

// Random namespace — Random.int/range/float/bool/bytes/... (platform RNG).
pub struct Random {
}

impl Random {
    // A random u32 in [0, 2^32).
    fn u32(): u32 {
        return randU32()
    }
    // A random integer in [0, max). `max` must be positive.
    fn int(max: i64): i64 {
        return randInt(max)
    }
    // A random integer in [min, max], both ends inclusive.
    fn range(min: i64, max: i64): i64 {
        return randRange(min, max)
    }
    // A random float in [0.0, 1.0).
    fn float(): f64 {
        return randFloat()
    }
    // A random float in [min, max).
    fn floatRange(min: f64, max: f64): f64 {
        return randFloatRange(min, max)
    }
    // `true` or `false` with equal probability.
    fn bool(): bool {
        return randBool()
    }
    // Shuffle the first `n` elements of `v` in place (Fisher-Yates). Pass `v.len()` for
    // all.
    fn shuffleI64(v: &mut Vec<i64>, n: i64): void {
        shuffleI64(&mut v, n)
    }
    // Fill `buf` with `n` random bytes.
    @unsafe
    fn bytes(buf: *u8, n: i64): void {
        randBytes(buf, n)
    }
}
