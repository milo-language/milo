// Create a new directory with a unique name and return its path. `prefix` is a
// path prefix, not a parent directory: makeTempDir("/tmp/build-") creates
// something like "/tmp/build-a1B2c3".
//
// The directory is created 0700 and is the caller's to remove — nothing cleans
// it up at exit. `removeAll` is the usual companion.
//
// Needs POSIX mkdtemp, so it does not link on Windows.
pub fn makeTempDir(prefix: &string): Result<string, IoError> {
    if !replayOff() {
        match fsText("fs.mkdtemp", prefix, (): Option<string> => {
            match makeTempDirLive(prefix) {
                Result.Ok(t) => {
                    return Option.Some(t)
                }
                Result.Err(_) => {
                    return Option.None
                }
            }
        }) {
            Option.Some(t) => {
                return Result.Ok(t)
            }
            Option.None => {
                return Result.Err(ioError(prefix))
            }
        }
    }
    return makeTempDirLive(prefix)
}

@replayHooked
fn makeTempDirLive(prefix: &string): Result<string, IoError> {
    // mkdtemp modifies template in place — copy into mutable buffer
    var buf: [u8; 4096] = [0; 4096]
    let tmpl = prefix + "XXXXXX"
    if tmpl.len >= 4096 {
        return Result.Err(IoError.Other("temporary directory prefix is too long"))
    }
    unsafe {
        for i in 0..tmpl.len {
            buf[i] = tmpl[i]
        }
        buf[tmpl.len] = 0
        let r = mkdtemp(buf as *u8)
        if r as i64 == 0 as i64 {
            return Result.Err(ioError(prefix))
        }
        return Result.Ok(_cstrToString(r))
    }
}

// Create a new empty file with a unique name and return its path. `prefix` is a
// path prefix, not a parent directory: makeTempFile("/tmp/build-") creates
// something like "/tmp/build-a1B2c3".
//
// The file is created 0600 and returned closed — open it with File.openWrite.
// It is the caller's to remove; nothing cleans it up at exit. Reopening by name
// is safe against the classic /tmp attack because the file already exists and is
// owned by this process; an attacker cannot substitute their own file for it in
// a sticky directory.
//
// Pairs with makeTempDir, and like it needs POSIX mkstemp, so it does not link
// on Windows.
pub fn makeTempFile(prefix: &string): Result<string, IoError> {
    if !replayOff() {
        match fsText("fs.mkstemp", prefix, (): Option<string> => {
            match makeTempFileLive(prefix) {
                Result.Ok(t) => {
                    return Option.Some(t)
                }
                Result.Err(_) => {
                    return Option.None
                }
            }
        }) {
            Option.Some(t) => {
                return Result.Ok(t)
            }
            Option.None => {
                return Result.Err(ioError(prefix))
            }
        }
    }
    return makeTempFileLive(prefix)
}

@replayHooked
fn makeTempFileLive(prefix: &string): Result<string, IoError> {
    // mkstemp modifies template in place — copy into mutable buffer
    var buf: [u8; 4096] = [0; 4096]
    let tmpl = prefix + "XXXXXX"
    if tmpl.len >= 4096 {
        return Result.Err(IoError.Other("temporary file prefix is too long"))
    }
    unsafe {
        for i in 0..tmpl.len {
            buf[i] = tmpl[i]
        }
        buf[tmpl.len] = 0
        let fd = mkstemp(buf as *u8)
        if fd < 0 {
            return Result.Err(ioError(prefix))
        }
        sysClose(fd)
        return Result.Ok(_cstrToString(buf as *u8))
    }
}

pub fn currentDir(): Result<string, IoError> {
    if !replayOff() {
        match fsText("fs.getcwd", "", (): Option<string> => {
            match currentDirLive() {
                Result.Ok(t) => {
                    return Option.Some(t)
                }
                Result.Err(_) => {
                    return Option.None
                }
            }
        }) {
            Option.Some(t) => {
                return Result.Ok(t)
            }
            Option.None => {
                return Result.Err(IoError.Other("getcwd failed"))
            }
        }
    }
    return currentDirLive()
}

@replayHooked
fn currentDirLive(): Result<string, IoError> {
    var buf: [u8; 4096] = [0; 4096]
    unsafe {
        let r = getcwd(buf as *u8, 4096)
        if r as i64 == 0 as i64 {
            return Result.Err(IoError.Other("getcwd failed"))
