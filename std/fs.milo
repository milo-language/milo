pub fn readLink(path: &string): Result<string, IoError> {
    if !replayOff() {
        match fsText("fs.readlink", path, (): Option<string> => {
            match readLinkLive(path) {
                Result.Ok(t) => {
                    return Option.Some(t)
                }
                Result.Err(_) => {
                    return Option.None
                }
            }
        }) {
            Option.Some(t) => {
                return Result.Ok(t)
            }
            Option.None => {
                return Result.Err(ioError(path))
            }
        }
    }
    return readLinkLive(path)
}

@replayHooked
fn readLinkLive(path: &string): Result<string, IoError> {
    var buf: [u8; 4096] = [0; 4096]
    unsafe {
        let n = readlink(path, buf as *u8, 4095)
        if n < 0 {
            return Result.Err(ioError(path))
        }
        buf[n] = 0
        return Result.Ok(_cstrToString(buf as *u8))
    }
}

pub fn realPath(path: &string): Result<string, IoError> {
