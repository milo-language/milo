// Change an open file's permission bits (fchmod).
@replayHooked
pub fn setFileMode(f: &File, mode: i32): Result<Unit, IoError> {
    var fd: i32 = -1
    unsafe { fd = f.rawFd() }
    let r = fsStatus("fs.fchmod", fd.toString() + " " + mode.toString(), (): i64 => {
        unsafe {
            return fchmod(fd, mode as u32) as i64
        }
    })
    if r != 0 {
        return errFd("fchmod failed")
    }
    return ok()
}

