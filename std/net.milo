// std/net — TCP, DNS with automatic cleanup. The TLS + HTTP client (TlsStream,
// FetchResponse, fetch*) lives in std/fetch and the TLS server transport in std/tls:
// keeping SSL_* out of this module is what lets a plain-TCP program link without
// OpenSSL (required on Windows, whose xwin sysroot ships none).

from "std/os" import {
    connectFdIn,
    connectFdInWait,
    IO_GAVE_UP, bindIn,
    signal,
    acceptFd,
    acceptFdNb,
    bind,
    freeaddrinfo,
    getSockPort,
    getaddrinfo,
    listen,
    readFd,
    setsockopt,
    socket,
    writeFd,
    connectFdIn6,
    connectFdIn6Wait,
    bindIn6,
    inet_pton,
    sysSocket,
    sysListen,
    sysClose
}
from "std/runtime" import {
    Promise, schedulerCurrent
}
from "std/replay" import {
    replayOff, replayBlob
}
from "std/platform" import {
    SockAddrIn,
    addrinfoAddrOffset,
    makeSockaddr,
    solSocket,
    soReuseaddr,
    makeSockaddr6,
    afInet6,
    ensureNetInit,
    listenFdsStart,
    getpid,
    fcntl
}
from "std/env" import {
    Env
}
from "std/sync" import {
    Channel
}
from "std/select" import {
    Select
}
from "std/time" import {
    ensureTimersLive, unrecordedEpochMillis
}
from "std/io" import {
    fdChannel,
    FdStream,
    AsFd
}

// ── NetError ──

// Why a network operation failed. The payload is a short description; for `DnsFailure`
// it is the hostname.
pub enum NetError {
    DnsFailure(string),
    ConnectionFailed(string),
    TlsError(string),
    SendFailed(string),
    // A deadline passed; the payload names the stage that was waiting (std/fetch's
    // fetchWithTimeout: "connect", "tls handshake", "send", "response").
    Timeout(string),
    // A response body past the cap (std/fetch's FetchOptions.maxBodyBytes); the payload
    // says which limit was hit. The body is dropped, never returned cut short.
    TooLarge(string),
    Other(string),
}

impl NetError {
    // What went wrong, prefixed by the stage that failed. Makes NetError an `Error`,
    // so `?` turns it into a string error or boxes it as Heap<Error>.
    fn message(self: &Self): string {
        match self {
            NetError.DnsFailure(m) => {
                return "dns: " + m
            }
            NetError.ConnectionFailed(m) => {
                return "connect: " + m
            }
            NetError.TlsError(m) => {
                return "tls: " + m
            }
            NetError.SendFailed(m) => {
                return "send: " + m
            }
            NetError.Timeout(m) => {
                return "timeout: " + m
            }
            NetError.TooLarge(m) => {
                return "too large: " + m
            }
            NetError.Other(m) => {
                return m
            }
        }
    }
}

// ── IpAddr ──

// An address of either family, as `resolveAll` returns it. `V4` holds the address as
// `ip4` builds it; `V6` holds the 16 raw bytes (as `ip6` parses them) and the scope id,
// the interface index a link-local peer (fe80::/10) needs, 0 otherwise.
pub enum IpAddr {
    V4(u32),
    V6([u8; 16], u32),
}

impl IpAddr {
    // Text form: a dotted quad, or RFC 5952 for v6 (lowercase hex, the longest run of
    // two or more zero groups as `::`), with `%scope` when the scope id is not 0.
    fn toString(self: &Self): string {
        match self {
            IpAddr.V4(ip) => {
                let v = ip as i64
                return $"{v & 255}.{(v >> 8) & 255}.{(v >> 16) & 255}.{(v >> 24) & 255}"
            }
            IpAddr.V6(b, scope) => {
                return ip6Text(b, scope)
            }
        }
    }
}

fn ip6Text(b: &[u8; 16], scope: u32): string {
    var groups: [i64; 8] = [0; 8]
    for g in 0..8 {
        groups[g] = (b[2 * g] as i64) * 256 + (b[2 * g + 1] as i64)
    }
    // the longest run of zero groups, first one on a tie; a lone zero stays "0"
    var bestAt: i64 = -1
    var bestLen: i64 = 1
    var g: i64 = 0
    while g < 8 {
        if groups[g] == 0 {
            var e = g
            while e < 8 && groups[e] == 0 {
                e += 1
            }
            if e - g > bestLen {
                bestAt = g
                bestLen = e - g
            }
            g = e
        } else {
            g += 1
        }
    }
    let hex = "0123456789abcdef"
    var out: string = ""
    g = 0
    while g < 8 {
        if g == bestAt {
            out += "::"
            g += bestLen
            continue
        }
        if g > 0 && g != bestAt + bestLen {
            out += ":"
        }
        let v = groups[g]
        var started = false
        var shift: i64 = 12
        while shift >= 0 {
            let d = (v >> shift) & 15
            if d != 0 || started || shift == 0 {
                out.push(hex[d])
                started = true
            }
            shift -= 4
        }
        g += 1
    }
    if scope != 0 {
        out += "%" + (scope as i64).toString()
    }
    return out
}

// ── TcpStream ──

// TCP connection handle. Automatically closes the fd when dropped.
pub struct TcpStream {
    _fd: i32,
}

impl Drop for TcpStream {
    fn drop(self: &mut Self): void {
        unsafe {
            // `> 0`, not `>= 0`: drop glue runs on moved-from slots, which move-zeroing
            // leaves all-zero — every Drop impl must be a no-op on the zero value, or a
            // loop like `let ar = listener.accept()` + `match ar` closes fd 0 (stdin) on
            // each reassign-drop and every later accept() returns the freed fd 0.
            // Tradeoff: a real socket on fd 0 (only possible if stdin was closed at
            // startup) is leaked instead of closed.
            if self._fd > 0 {
                sysClose(self._fd)
            }
        }
    }
}

// Parse an IPv6 literal ("::1", "2001:db8::1") into its 16 raw bytes.
// None if the text isn't a valid v6 address — inet_pton is strict, and a v4 literal like
// "127.0.0.1" is NOT auto-mapped, so it returns None here rather than a v4-mapped address.
pub fn ip6(text: &string): Option<[u8; 16]> {
    unsafe {
        var out: [u8; 16] = [0; 16]
        var cbuf: [u8; 64] = [0; 64]
        if text.len >= 64 {
            return Option.None
        }
        var i: i64 = 0
        while i < text.len {
            cbuf[i] = text[i]
            i += 1
        }
        if inet_pton(afInet6(), cbuf as *u8, out as *u8) != 1 {
            return Option.None
        }
        return Option.Some(out)
    }
}

// Construct an IPv4 address from four octets.
// Example: ip4(127, 0, 0, 1) for localhost.
pub fn ip4(a: u8, b: u8, c: u8, d: u8): u32 {
    let a32 = a as u32
    let b32 = b as u32
    let c32 = c as u32
    let d32 = d as u32
    return a32 | (b32 << 8) | (c32 << 16) | (d32 << 24)
}

impl TcpStream {
    // Open a TCP connection to an IPv4 address (see `ip4`, `resolve`).
    fn connect(ip: u32, port: u16): Result<TcpStream, NetError> {
        unsafe {
            ignoreSigpipe()
            let AF_INET: i32 = 2
            let SOCK_STREAM: i32 = 1

            ensureNetInit()
            var fd: i32 = 0
            fd = sysSocket(AF_INET, SOCK_STREAM, 0)
            if fd < 0 {
                return Result.Err(NetError.ConnectionFailed("socket() failed"))
            }

            var addr = makeSockaddr(port, ip)

            if connectFdIn(fd, addr) < 0 {
                sysClose(fd)
                return Result.Err(NetError.ConnectionFailed("connect() failed"))
            }

            return Result.Ok(TcpStream {
                _fd: fd
            })
        }
    }

    // connect() whose in-progress connect waits through `wait(fd, forRead)`, which
    // returns false to give up (std/fetch passes a deadline): Err(Timeout("connect")).
    // The stream is left nonblocking, so read and write it with recvFdWait/sendFdWait.
    fn connectWait(ip: u32, port: u16, wait: (i32, bool) => bool): Result<TcpStream, NetError> {
        unsafe {
            ignoreSigpipe()
            ensureNetInit()
            let fd = sysSocket(2, 1, 0)
            if fd < 0 {
                return Result.Err(NetError.ConnectionFailed("socket() failed"))
            }
            let r = connectFdInWait(fd, makeSockaddr(port, ip), (forRead: bool): bool => wait(fd, forRead))
            if r != 0 {
                sysClose(fd)
                if r as i64 == IO_GAVE_UP {
                    return Result.Err(NetError.Timeout("connect"))
                }
                return Result.Err(NetError.ConnectionFailed("connect() failed"))
            }
            return Result.Ok(TcpStream {
                _fd: fd
            })
        }
    }

    // IPv6 connect. Added alongside connect() rather than replacing it: a u32 cannot hold
    // a 128-bit address, so the v4 entry point keeps its shape. `scopeId` is the interface
    // index for a link-local peer (fe80::/10), 0 otherwise.
    fn connect6(addr: [u8; 16], port: u16, scopeId: u32): Result<TcpStream, NetError> {
        unsafe {
            ignoreSigpipe()
            ensureNetInit()
            var fd: i32 = 0
            fd = sysSocket(afInet6(), 1, 0)
            if fd < 0 {
                return Result.Err(NetError.ConnectionFailed("socket() failed"))
            }
            var sa = makeSockaddr6(port, addr, scopeId)
            if connectFdIn6(fd, sa) < 0 {
                sysClose(fd)
                return Result.Err(NetError.ConnectionFailed("connect() failed"))
            }
            return Result.Ok(TcpStream {
                _fd: fd
            })
        }
    }

    // connectWait for IPv6 (see connect6).
    fn connect6Wait(addr: [u8; 16], port: u16, scopeId: u32, wait: (i32, bool) => bool): Result<TcpStream, NetError> {
        unsafe {
            ignoreSigpipe()
            ensureNetInit()
            let fd = sysSocket(afInet6(), 1, 0)
            if fd < 0 {
                return Result.Err(NetError.ConnectionFailed("socket() failed"))
            }
            let r = connectFdIn6Wait(fd, makeSockaddr6(port, addr, scopeId), (forRead: bool): bool => wait(fd, forRead))
            if r != 0 {
                sysClose(fd)
                if r as i64 == IO_GAVE_UP {
                    return Result.Err(NetError.Timeout("connect"))
                }
                return Result.Err(NetError.ConnectionFailed("connect() failed"))
            }
            return Result.Ok(TcpStream {
                _fd: fd
            })
        }
    }

    // Connect to an address of either family (see `resolveAll`).
    fn connectAddr(addr: &IpAddr, port: u16): Result<TcpStream, NetError> {
        match addr {
            IpAddr.V4(ip) => {
                return TcpStream.connect(ip, port)
            }
            IpAddr.V6(bytes, scope) => {
                return TcpStream.connect6(bytes, port, scope)
            }
        }
    }

    // connectAddr whose in-progress connect waits through `wait`, as connectWait does.
    fn connectAddrWait(addr: &IpAddr, port: u16, wait: (i32, bool) => bool): Result<TcpStream, NetError> {
        match addr {
            IpAddr.V4(ip) => {
                return TcpStream.connectWait(ip, port, wait)
            }
            IpAddr.V6(bytes, scope) => {
                return TcpStream.connect6Wait(bytes, port, scope, wait)
            }
        }
    }

    // Connect to `hostname`, trying every address `resolveAll` returns, in order, until
    // one accepts. A name that resolves to both families reaches a server listening on
    // only one of them, which `connect(resolve(host)!, port)` cannot (it only tries the
    // first IPv4 address). The error is the last attempt's.
    fn connectHost(hostname: &string, port: u16): Result<TcpStream, NetError> {
        let addrs = resolveAll(hostname)?
        var last = NetError.ConnectionFailed("no address")
        for a in addrs {
            match TcpStream.connectAddr(a, port) {
                Result.Ok(s) => {
                    return Result.Ok(s)
                }
                Result.Err(e) => {
                    last = e
                }
            }
        }
        return Result.Err(last)
    }

    // Send `data`. Returns the number of bytes sent.
    fn send(self: &Self, data: &string): Result<i64, NetError> {
        unsafe {
            let n = writeFd(self._fd, data, data.len)
            if n < 0 {
                return Result.Err(NetError.SendFailed("tcp send failed"))
            }
            return Result.Ok(n)
        }
    }

    // Read everything until the peer closes, as one string (blocks to EOF).
    // Prefer `incoming()` for streaming/incremental consumption — it delivers
    // chunks as they arrive instead of buffering the whole response.
    fn recv(self: &Self): Result<string, NetError> {
        unsafe {
            var result: string = ""
            var buf: [u8; 4096] = [0; 4096]
            while true {
                let n = readFd(self._fd, buf, 4096)
                if n <= 0 {
                    break
                }
                for i in 0..n {
                    result.push(buf[i])
                }
            }
            return Result.Ok(result)
        }
    }

    // Stream inbound bytes as an iterable channel, pumped on a background green
    // task — the uniform async-read API shared with pty/child/pipe. Iterate with
    // `for chunk in stream.incoming()`; the channel closes when the peer does.
    // (Plaintext only — TlsStream needs an SSL-aware pump.)
    fn incoming(self: &Self): Channel<string> {
        unsafe { return fdChannel(self._fd) }
    }

    // Close the socket now rather than at drop: the peer sees EOF here. Afterwards the
    // stream is inert and its drop is a no-op.
    fn close(self: &mut Self): void {
        if self._fd > 0 {
            unsafe { sysClose(self._fd) }
        }
        self._fd = -1
    }

    // Release the underlying fd to the caller. After this the stream no longer
    // closes it on drop, and the number is the caller's to close exactly once.
    // `@unsafe` because nothing tracks it from here; `wsAccept` and
    // `TlsStream.fromTcp` take the stream itself, which is the safe hand-off.
    @unsafe
    fn take(self: &mut Self): i32 {
        let f = self._fd
        self._fd = -1
        return f
    }

    // A non-owning std/io Reader+Writer view of this socket, so `BufReader` and
    // `BufWriter` work over TCP. Borrowing rather than consuming the stream is the
    // point: a request/response protocol needs to read and write the same socket,
    // and a wrapper that owned it could only do one. The TcpStream must outlive the
    // view — it still owns the fd and closes it on drop, and nothing checks that, so
    // `TcpStream.connect(...)!.stream()` on a temporary is wrong. Bind the stream to
    // a name first; see FdStream in std/io.
    fn stream(self: &Self): FdStream {
        unsafe { return FdStream.onSocket(self._fd) }
    }

    // A single read of whatever is currently available, unlike `recv()` which loops until
    // the peer closes. A keep-alive HTTP client never closes its write half while waiting
    // for the response, so `recv()` would deadlock; this returns after one segment — enough
    // for a request's headers.
    fn recvOnce(self: &Self): string {
        unsafe {
            var result: string = ""
            var buf: [u8; 65536] = [0; 65536]
            let n = readFd(self._fd, buf, 65536)
            if n > 0 {
                for i in 0..n {
                    result.push(buf[i])
                }
            }
            return result
        }
    }
}

// Borrow the underlying fd WITHOUT transferring ownership: the stream still closes it
// on drop. `@unsafe` (see AsFd in std/io); `sel.onRead(stream)` and friends take the
// stream itself.
impl AsFd for TcpStream {
    @unsafe
    fn rawFd(self: &Self): i32 {
        return self._fd
    }
}

impl AsFd for TcpListener {
    @unsafe
    fn rawFd(self: &Self): i32 {
        return self._fd
    }
}

// ── TcpListener ──

// Listening TCP socket. Accepts inbound connections; closes the fd on drop.
// Server counterpart to TcpStream.connect — no raw syscalls required in user code.
pub struct TcpListener {
    _fd: i32,
}

impl Drop for TcpListener {
    fn drop(self: &mut Self): void {
        unsafe {
            // `> 0`: zeroed moved-from slots must drop as a no-op (see TcpStream.drop).
            if self._fd > 0 {
                sysClose(self._fd)
            }
        }
    }
}

// SIGPIPE's default action is to kill the process, so writing to a socket whose
// peer has already gone away takes the whole server down — silently, with exit
// status 141 and nothing logged. Every runtime that serves connections ignores
// it and deals with the EPIPE that write() returns instead. Called when a
// listener or a stream is created, so any program doing socket IO is covered.
// One-shot, done with an atomic compare-and-swap rather than `if flag { return };
// flag = true`. That read-modify-write is not atomic, and connect() is reachable from
// a Promise.blocking worker (milojs reaches it through fetch), so two OS threads could
// both fall through the guard.
//
// Not std/sync's Once, deliberately: a Once owns a malloc'd control block, so it needs
// an initializer that RUNS, and a `--no-entry` object (milojs embeds one) has no entry
// point to run global initializers in. A bool with a constant initializer works in both
// builds, and the CAS is the whole synchronization this needs.
var gSigpipeIgnored: bool = false

pub fn ignoreSigpipe(): void {
    unsafe {
        // The CAS returns the value that WAS there (std/sync's AtomicBool.cas
        // documents the same convention), so false means this caller is the one
        // that claimed the flag and true means somebody already had.
        if _atomicCasBool((gSigpipeIgnored.addrOf()) as *u8, false, true) {
            return
        }
        // SIGPIPE is 13 on both darwin and linux; SIG_IGN is the handler value 1
        let _prev = signal(13, 1 as *u8)
    }
}

// Socket activation (systemd's LISTEN_FDS protocol): the already-bound, already-listening
// socket the service manager passes in, or -1 when this process was not started that way.
// LISTEN_PID must name THIS process (the variables also reach children, which must not
// claim a socket meant for their parent). The variables are removed once read, as systemd
// asks, so a child we spawn never mistakes them for its own.
//
// Every listener constructor asks this first, so each serve variant gets socket
// activation from the one place. Only the first listener of the process gets the
// socket: the variables are gone afterwards. Skipped under record/replay (descriptors are
// synthetic there) and on targets with no inheritance (Windows).
//
// @unsafe: the caller takes ownership of the returned number and must wrap it in exactly
// one handle (TcpListener, TlsListener) that closes it.
@unsafe
pub fn takeInheritedListenFd(): i32 {
    let first = listenFdsStart()
    if first < 0 || !replayOff() {
        return -1
    }
    let fdsVar = Env.get("LISTEN_FDS")
    let pidVar = Env.get("LISTEN_PID")
    if fdsVar.isNone() && pidVar.isNone() {
        return -1
    }
    let _a = Env.remove("LISTEN_FDS")
    let _b = Env.remove("LISTEN_PID")
    let Option.Some(nText) = fdsVar else {
        return -1
    }
    let Option.Some(pidText) = pidVar else {
        return -1
    }
    // LISTEN_FDS=1 or more; the first descriptor is the one used.
    unsafe {
        if digitsValue(nText) < 1 || digitsValue(pidText) != getpid() as i64 {
            return -1
        }
        // A descriptor that is not a socket is a misconfigured unit: bind our own rather
        // than serve on something that cannot accept.
        if getSockPort(first) < 0 {
            return -1
        }
        // F_SETFD = 2, FD_CLOEXEC = 1 on linux and darwin: processes we exec do not inherit it.
        fcntl(first, 2, 1)
    }
    return first
}

// The value of a string of ASCII digits; -1 for anything else (including empty).
fn digitsValue(text: &string): i64 {
    if text.len == 0 || text.len > 18 {
        return -1
    }
    var v: i64 = 0
    for i in 0..text.len {
        let c = text[i]
        if c < '0' || c > '9' {
            return -1
        }
        v = v * 10 + (c - '0') as i64
    }
    return v
}

impl TcpListener {
    // Bind to 0.0.0.0:port (every interface) and start listening. SO_REUSEADDR is set so a quick
    // restart doesn't fail with "address already in use". Pass port 0 to let the
    // OS choose a free port (recover it via the accepted peer or getsockname).
    fn bind(port: u16): Result<TcpListener, NetError> {
        return TcpListener.bindAddr(0, port)
    }

    // Bind to one IPv4 address (see `ip4`). `bindAddr(ip4(127, 0, 0, 1), port)`
    // is the loopback-only listener a local dev server wants: `bind` takes every
    // interface, so anything it serves is reachable from the network.
    //
    // Started under systemd socket activation (LISTEN_FDS/LISTEN_PID), this adopts the
    // passed socket instead and `addr` and `port` are ignored: the unit file chose them.
    fn bindAddr(addr: u32, port: u16): Result<TcpListener, NetError> {
        unsafe {
            ignoreSigpipe()
            let inherited = takeInheritedListenFd()
            if inherited >= 0 {
                return Result.Ok(TcpListener {
                    _fd: inherited
                })
            }
            let AF_INET: i32 = 2
            let SOCK_STREAM: i32 = 1

            ensureNetInit()
            var fd: i32 = 0
            fd = sysSocket(AF_INET, SOCK_STREAM, 0)
            if fd < 0 {
                return Result.Err(NetError.ConnectionFailed("socket() failed"))
            }

            var one: i32 = 1
            unsafe { setsockopt(fd, solSocket(), soReuseaddr(), one, 4) }

            var sa = makeSockaddr(port, addr)
            if bindIn(fd, sa) < 0 {
                sysClose(fd)
                return Result.Err(NetError.ConnectionFailed("bind() failed"))
            }
            if sysListen(fd, 1024) < 0 {
                sysClose(fd)
                return Result.Err(NetError.ConnectionFailed("listen() failed"))
            }
            return Result.Ok(TcpListener {
                _fd: fd
            })
        }
    }

    // Bind an IPv6 listener. Added alongside bind(); pass the 16 raw bytes (`ip6("::1")`,
    // or all-zero for the v6 wildcard "::").
    fn bind6(addr: [u8; 16], port: u16): Result<TcpListener, NetError> {
        unsafe {
            ignoreSigpipe()
            let inherited = takeInheritedListenFd()
            if inherited >= 0 {
                return Result.Ok(TcpListener {
                    _fd: inherited
                })
            }
            ensureNetInit()
            var fd: i32 = 0
            fd = sysSocket(afInet6(), 1, 0)
            if fd < 0 {
                return Result.Err(NetError.ConnectionFailed("socket() failed"))
            }
            var one: i32 = 1
            unsafe { setsockopt(fd, solSocket(), soReuseaddr(), one, 4) }
            var sa = makeSockaddr6(port, addr, 0)
            if bindIn6(fd, sa) < 0 {
                sysClose(fd)
                return Result.Err(NetError.ConnectionFailed("bind() failed"))
            }
            if sysListen(fd, 1024) < 0 {
                sysClose(fd)
                return Result.Err(NetError.ConnectionFailed("listen() failed"))
            }
            return Result.Ok(TcpListener {
                _fd: fd
            })
        }
    }

    // The bound port — the point of `bind(0)`, which asks the OS to pick one.
    // Without this a caller that binds 0 has no way to learn what it got, so
    // every test and every ephemeral server has to hardcode a port and hope it
    // is free. `TlsListener` has had this; `TcpListener` did not.
    //
    // -1 if getsockname fails, mirroring getSockPort rather than reporting a
    // plausible-looking port number.
    fn port(self: &Self): i32 {
        unsafe {
            return getSockPort(self._fd)
        }
    }

    // Accept one connection. Inside the green scheduler this yields (via the
    // event loop) until a client is ready rather than blocking the whole
    // runtime; outside it, it blocks.
    fn accept(self: &Self): Result<TcpStream, NetError> {
        unsafe {
            let clientFd = acceptFd(self._fd)
            if clientFd < 0 {
                return Result.Err(NetError.ConnectionFailed("accept() failed"))
            }
            return Result.Ok(TcpStream {
                _fd: clientFd
            })
        }
    }

    // Accept without parking: Ok(stream) only when a connection is already
    // pending, Err otherwise. For callers that multiplex accept with other
    // event sources — accept() parks the calling task on the listener, which
    // stalls everything else that task drives until a client connects.
    fn acceptNb(self: &Self): Result<TcpStream, NetError> {
        unsafe {
            let clientFd = acceptFdNb(self._fd)
            if clientFd < 0 {
                return Result.Err(NetError.ConnectionFailed("no pending connection"))
            }
            return Result.Ok(TcpStream {
                _fd: clientFd
            })
        }
    }
}

// ── DNS ──

// DNS lookup: the first IPv4 address for `hostname`. Recorded as net.resolve.
// On a green task the lookup (getaddrinfo, which blocks) runs on a worker OS thread
// and parks only the calling task, so other tasks, and other lookups, keep running.
pub fn resolve(hostname: &string): Result<u32, NetError> {
    if !replayOff() {
        let p = replayBlob("net.resolve", hostname, (): string => {
            match resolveLive(hostname) {
                Result.Ok(ip) => {
                    return ip.toString()
                }
                Result.Err(_) => {
                    return "!"
                }
            }
        })
        if p == "!" {
            return Result.Err(NetError.DnsFailure(hostname))
        }
        var ip: u32 = 0
        for i in 0..p.len() {
            ip = ip * 10 + ((p[i] - '0') as u32)
        }
        return Result.Ok(ip)
    }
    return resolveLive(hostname)
}

// getaddrinfo is a blocking libc call. On a green task it would stall the scheduler's
// OS thread, so every other task waited on this lookup and parallel fetches resolved
// one after another; a worker thread does the lookup and only the asking task parks.
// Not under record/replay: the worker's thread spawn would be a record of its own that
// a replay, answering the lookup from the trace, never makes.
@replayHooked
fn resolveLive(hostname: &string): Result<u32, NetError> {
    if schedulerCurrent() as i64 == 0 || !replayOff() {
        return lookupV4(hostname)
    }
    let host = hostname
    let p = Promise<Result<u32, NetError>>.blocking(move(): Result<u32, NetError> => lookupV4(host))
    match p.await() {
        Result.Ok(r) => {
            return r
        }
        Result.Err(_) => {
            return Result.Err(NetError.DnsFailure(hostname))
        }
    }
}

// DNS lookup: every address for `hostname`, IPv4 and IPv6, in the order getaddrinfo
// returns them. That order is RFC 6724's (which family and which address to try first
// for this host's routes), so a client connects by trying them front to back, as
// `TcpStream.connectHost` does. Never an empty list: no address is Err(DnsFailure).
// Recorded as net.resolveall. Off the scheduler thread on a green task, as `resolve` is.
pub fn resolveAll(hostname: &string): Result<Vec<IpAddr>, NetError> {
    return resolveAllBy(hostname, 0)
}

// resolveAll that stops waiting at `by` (epoch ms; 0 waits as long as it takes) with
// Err(Timeout("dns")). getaddrinfo cannot be cancelled, so a lookup past its deadline
// is abandoned: its thread finishes on its own and the result is dropped. The bound
// applies on a green task, where the lookup runs on a worker; off one (and under
// record/replay) the call is the plain blocking lookup.
pub fn resolveAllBy(hostname: &string, by: i64): Result<Vec<IpAddr>, NetError> {
    if !replayOff() {
        // A record kind of its own rather than a new payload for net.resolve, so a trace
        // recorded before resolveAll existed still replays its resolve() calls.
        let p = replayBlob("net.resolveall", hostname, (): string => {
            match resolveAllLive(hostname, by) {
                Result.Ok(addrs) => {
                    return encodeAddrs(addrs)
                }
                Result.Err(_) => {
                    return "!"
                }
            }
        })
        if p == "!" {
            return Result.Err(NetError.DnsFailure(hostname))
        }
        return Result.Ok(decodeAddrs(p))
    }
    return resolveAllLive(hostname, by)
}

// Trace payload: space-separated `4:<u32>` or `6:<32 hex digits>:<scope>`.
fn encodeAddrs(addrs: &Vec<IpAddr>): string {
    let hex = "0123456789abcdef"
    var out: string = ""
    for a in addrs {
        if out.len > 0 {
            out += " "
        }
        match a {
            IpAddr.V4(ip) => {
                out += "4:" + (ip as i64).toString()
            }
            IpAddr.V6(b, scope) => {
                out += "6:"
                for i in 0..16 {
                    out.push(hex[(b[i] as i64) >> 4])
                    out.push(hex[(b[i] as i64) & 15])
                }
                out += ":" + (scope as i64).toString()
            }
        }
    }
    return out
}

fn decimalOf(s: &string, from: i64, to: i64): i64 {
    var v: i64 = 0
    for i in from..to {
        v = v * 10 + ((s[i] - '0') as i64)
    }
    return v
}

fn hexNibble(c: u8): u8 {
    if c >= 'a' {
        return c - 'a' + 10
    }
    return c - '0'
}

fn decodeAddrs(p: &string): Vec<IpAddr> {
    var out: Vec<IpAddr> = Vec.new()
    for f in p.split(" ") {
        if f.len < 3 {
            continue
        }
        if f[0] == '4' {
            out.push(IpAddr.V4(decimalOf(f, 2, f.len) as u32))
        } else {
            var b: [u8; 16] = [0; 16]
            for i in 0..16 {
                b[i] = hexNibble(f[2 + 2 * i]) * 16 + hexNibble(f[3 + 2 * i])
            }
            out.push(IpAddr.V6(b, decimalOf(f, 35, f.len) as u32))
        }
    }
    return out
}

// Off the scheduler thread for the same reason as resolveLive.
@replayHooked
fn resolveAllLive(hostname: &string, by: i64): Result<Vec<IpAddr>, NetError> {
    if schedulerCurrent() as i64 == 0 || !replayOff() {
        return lookupAll(hostname)
    }
    let host = hostname
    let p = Promise<Result<Vec<IpAddr>, NetError>>.blocking(move(): Result<Vec<IpAddr>, NetError> => lookupAll(host))
    if by > 0 {
        ensureTimersLive()
        var sel = Select.new()
        sel.onRecv(p.channel())
        var left = by - unrecordedEpochMillis()
        if left < 0 {
            left = 0
        }
        sel.onTimeout(left)
        if sel.wait() != 0 {
            return Result.Err(NetError.Timeout("dns"))
        }
    }
    match p.await() {
        Result.Ok(r) => {
            return r
        }
        Result.Err(_) => {
            return Result.Err(NetError.DnsFailure(hostname))
        }
    }
}

// struct addrinfo: ai_family is at 4 and ai_next at 40 on every target std supports;
// ai_addr moves (addrinfoAddrOffset). In sockaddr_in6 the address is at 8 and the scope
// id at 24.
@replayHooked
fn lookupAll(hostname: &string): Result<Vec<IpAddr>, NetError> {
    var hints: [u8; 48] = [0; 48]
    unsafe {
        let h = (hints as *i32)
        // AF_UNSPEC (0) asks for both families; SOCK_STREAM keeps one entry per address
        // instead of one per socket type.
        h[1] = 0
        h[2] = 1
    }
    var resBuf: [u8; 8] = [0; 8]
    var out: Vec<IpAddr> = Vec.new()
    unsafe {
        let err = getaddrinfo(hostname, 0 as *u8, hints as *u8, resBuf as *u8)
        if err != 0 {
            return Result.Err(NetError.DnsFailure(hostname))
        }
        let head = *(resBuf as *i64)
        var info = head
        while info != 0 {
            let fam = *((info + 4) as *i32)
            let sa = *((info + addrinfoAddrOffset()) as *i64)
            if sa != 0 && fam == 2 {
                out.push(IpAddr.V4(*((sa + 4) as *u32)))
            } else if sa != 0 && fam == afInet6() {
                var b: [u8; 16] = [0; 16]
                for i in 0..16 {
                    b[i] = *((sa + 8 + i) as *u8)
                }
                out.push(IpAddr.V6(b, *((sa + 24) as *u32)))
            }
            info = *((info + 40) as *i64)
        }
        freeaddrinfo(head as *u8)
    }
    if out.len == 0 {
        return Result.Err(NetError.DnsFailure(hostname))
    }
    return Result.Ok(out)
}

@replayHooked
fn lookupV4(hostname: &string): Result<u32, NetError> {
    var hints: [u8; 48] = [0; 48]
    unsafe {
        let hintsFamily = (hints as *i32)
        hintsFamily[1] = 2
        hintsFamily[2] = 1
    }

    var resBuf: [u8; 8] = [0; 8]
    unsafe {
        let err = getaddrinfo(hostname, 0 as *u8, hints as *u8, resBuf as *u8)
        if err != 0 {
            return Result.Err(NetError.DnsFailure(hostname))
        }
        let infoPtr = *(resBuf as *i64)
        let addrPtr = *((infoPtr + addrinfoAddrOffset()) as *i64)
        let ip = *((addrPtr + 4) as *u32)
        freeaddrinfo(infoPtr as *u8)
        return Result.Ok(ip)
    }
}

// A raw descriptor lent to a Select for one wait.
struct WaitFd {
    fd: i32,
}

impl AsFd for WaitFd {
    fn rawFd(self: &Self): i32 {
        return self.fd
    }
}

// Wait for `fd` to be readable (or writable) until `by` (epoch ms; 0 waits as long as
// it takes). False when `by` came first.
//
// Not a trace record of its own: the wait parks on a Select, and the scheduler poll
// that ends it is already one (sched.pick says whether the fd arm or the timer arm
// fired), so a replay times out exactly where the recording did, without waiting. A
// record wrapped around the wait came out AFTER the sched records written inside it,
// and the replay, asking for the wrapper first, diverged at the first wait.
pub fn waitIo(fd: i32, forRead: bool, by: i64): bool {
    // Select's fd and timer arms are inert without a scheduler, which a plain main
    // that never spawned a task does not have.
    ensureTimersLive()
    var sel = Select.new()
    let h = WaitFd { fd: fd }
    if forRead {
        sel.onRead(h)
    } else {
        sel.onWrite(h)
    }
    if by > 0 {
        // A deadline already past still arms the timer (at 0) rather than returning
        // false here: that decision would read the unrecorded clock, so a replay,
        // running faster, would make it differently.
        var left = by - unrecordedEpochMillis()
        if left < 0 {
            left = 0
        }
        sel.onTimeout(left)
    }
    return sel.wait() == 0
}

// A deadline `ms` from now as waitIo wants it: epoch ms, 0 for no limit. The clock is the
// unrecorded one for the same replay reason as in waitIo.
pub fn deadlineIn(ms: i64): i64 {
    if ms <= 0 {
        return 0
    }
    return unrecordedEpochMillis() + ms
}
