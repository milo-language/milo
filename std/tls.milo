// std/tls — TLS *server* transport: accept connections and run the server handshake.
// std/fetch is the client half (TlsStream, fetch); this is the counterpart, and
// std/https is the HTTP server built on it.
//
// Why its own module rather than a TlsListener in std/fetch, which is where the client
// TLS code lives: std/fetch is the HTTP *client* — fetch(), redirects, response parsing.
// A listener that answers connections has nothing to do with that surface, and a server
// program should not drag the client in to get it.
//
// Everything below stays out of std/net and std/http for the usual reason: those two
// must link without OpenSSL (the xwin Windows sysroot ships none). Importing std/tls or
// std/fetch is what pulls SSL_* in.

from "std/net" import {
    NetError, ignoreSigpipe, takeInheritedListenFd, waitIo, deadlineIn
}
from "std/event" import {
    setNonblocking
}
from "std/os" import {
    acceptFd,
    bindIn,
    getSockPort,
    setsockopt,
    sysClose,
    sysSocket,
    sysListen
}
from "std/openssl" import {
    SSL_CTX_check_private_key, SSL_CTX_free, SSL_CTX_new, SSL_CTX_use_PrivateKey_file, SSL_CTX_use_certificate_chain_file, SSL_free,
    SSL_new, SSL_set_fd, SSL_shutdown, TLS_server_method, sslAcceptFd, sslAcceptFdWait, sslReadFd,
    sslReadFdWait, sslWriteAllFd, sslWriteAllFdWait, SSL_GAVE_UP
}
from "std/platform" import {
    makeSockaddr,
    ensureNetInit,
    solSocket,
    soReuseaddr
}

// ── TlsConn ──

// One accepted TLS connection. The server-side counterpart of std/fetch's TlsStream;
// separate from it because the two differ where it matters — a client owns its SSL_CTX
// and verifies the peer, a server's ctx belongs to the listener and is shared.
//
// LIFETIME: `ctx` is deliberately absent. The SSL_CTX comes from the TlsListener and is
// shared by every connection it accepts, so freeing it here would pull it out from under
// the next accept(). The listener must outlive the connections it hands out.
pub struct TlsConn {
    _fd: i32,
    _ssl: i64,
}

impl Drop for TlsConn {
    fn drop(self: &mut Self): void {
        unsafe {
            if self._ssl != 0 {
                // close_notify before the fd goes away: an abrupt TCP close is an
                // "unexpected eof" to an OpenSSL peer, which curl reports as a transfer
                // error even when the body arrived complete.
                SSL_shutdown(self._ssl as *u8)
                SSL_free(self._ssl as *u8)
            }
            // `> 0`: zeroed moved-from slots must drop as a no-op (see TcpStream.drop in std/net).
            if self._fd > 0 {
                sysClose(self._fd)
            }
        }
    }
}

impl TlsConn {
    // Write `data` through the TLS record layer. Returns the byte count OpenSSL accepted.
    fn send(self: &Self, data: &string): Result<i64, NetError> {
        unsafe {
            let n = sslWriteAllFd(self._ssl as *u8, self._fd, data, data.len)
            if n < 0 || (n == 0 && data.len > 0) {
                return Result.Err(NetError.SendFailed("SSL_write failed"))
            }
            return Result.Ok(n as i64)
        }
    }

    // A single SSL_read of whatever has arrived. A server must answer while the client
    // still holds the connection open, so a read-to-EOF loop would deadlock; this
    // returns after one record — the TLS analogue of one read(2) on the socket.
    fn recvOnce(self: &Self): string {
        var result: string = ""
        var buf: [u8; 8192] = [0; 8192]
        unsafe {
            let n = sslReadFd(self._ssl as *u8, self._fd, buf as *u8, 8192)
            if n > 0 {
                for i in 0..n as i64 {
                    result.push(buf[i])
                }
            }
        }
        return result
    }

    // recvOnce that gives up at `by` (epoch ms, 0 = never), appending to `raw`: the byte
    // count, 0 once the peer has closed or the read failed, -1 at the deadline. That is
    // std/http's request-reader contract (see readMoreBy there), so a TLS client that
    // stalls mid-request is dropped like a plaintext one. Needs the fd nonblocking, which
    // acceptWithin leaves it.
    fn readMoreBy(self: &Self, raw: &mut string, by: i64): i64 {
        var buf: [u8; 8192] = [0; 8192]
        let fd = self._fd
        unsafe {
            let n = sslReadFdWait(self._ssl as *u8, fd, buf as *u8, 8192, (forRead: bool): bool => waitIo(fd, forRead, by))
            if n == SSL_GAVE_UP {
                return -1
            }
            if n <= 0 {
                return 0
            }
            for i in 0..n as i64 {
                raw.push(buf[i])
            }
            return n as i64
        }
    }

    // send that stops waiting on a peer that is not reading once `ms` has passed (0 = no
    // limit).
    fn sendWithin(self: &Self, data: &string, ms: i64): Result<i64, NetError> {
        let by = deadlineIn(ms)
        let fd = self._fd
        unsafe {
            let n = sslWriteAllFdWait(self._ssl as *u8, fd, data, data.len, (forRead: bool): bool => waitIo(fd, forRead, by))
            if n == SSL_GAVE_UP as i64 {
                return Result.Err(NetError.Timeout("TLS write"))
            }
            if n < 0 || (n == 0 && data.len > 0) {
                return Result.Err(NetError.SendFailed("SSL_write failed"))
            }
            return Result.Ok(n)
        }
    }

    // Read to EOF, as one string. For a request framed by the peer closing its write
    // half; an HTTP server wants recvOnce().
    fn recv(self: &Self): Result<string, NetError> {
        var result: string = ""
        var buf: [u8; 4096] = [0; 4096]
        while true {
            unsafe {
                let n = sslReadFd(self._ssl as *u8, self._fd, buf as *u8, 4096)
                if n <= 0 {
                    break
                }
                for i in 0..n as i64 {
                    result.push(buf[i])
                }
            }
        }
        return Result.Ok(result)
    }
}

// ── TlsListener ──

// Listening TLS socket: a TCP listener plus the server SSL_CTX holding the certificate
// chain and private key. Frees the ctx and closes the fd on drop.
pub struct TlsListener {
    _fd: i32,
    _ctx: i64,
}

impl Drop for TlsListener {
    fn drop(self: &mut Self): void {
        unsafe {
            if self._ctx != 0 {
                SSL_CTX_free(self._ctx as *u8)
            }
            // `> 0`: zeroed moved-from slots must drop as a no-op (see TcpStream.drop in std/net).
            if self._fd > 0 {
                sysClose(self._fd)
            }
        }
    }
}

impl TlsListener {
    // Bind 0.0.0.0:port and serve `certPath` (PEM chain, leaf first) with `keyPath`.
    // Port 0 lets the OS pick — recover it with port().
    fn bind(port: u16, certPath: &string, keyPath: &string): Result<TlsListener, NetError> {
        unsafe {
            let AF_INET: i32 = 2
            let SOCK_STREAM: i32 = 1
            let SSL_FILETYPE_PEM: i32 = 1

            ignoreSigpipe()
            ensureNetInit()
            // Socket activation hands over an already-listening socket (see std/net).
            var fd: i32 = takeInheritedListenFd()
            if fd < 0 {
                unsafe { fd = sysSocket(AF_INET, SOCK_STREAM, 0) }
                if fd < 0 {
                    return Result.Err(NetError.ConnectionFailed("sysSocket() failed"))
                }

                var one: i32 = 1
                unsafe { setsockopt(fd, solSocket(), soReuseaddr(), one, 4) }

                var addr = makeSockaddr(port, 0)
                if bindIn(fd, addr) < 0 {
                    sysClose(fd)
                    return Result.Err(NetError.ConnectionFailed("bind() failed"))
                }
                unsafe {
                    if sysListen(fd, 1024) < 0 {
                        sysClose(fd)
                        return Result.Err(NetError.ConnectionFailed("sysListen() failed"))
                    }
                }
            }

            unsafe {
                let ctx = SSL_CTX_new(TLS_server_method())
                let ctxAddr = ctx as i64
                if ctxAddr == 0 {
                    sysClose(fd)
                    return Result.Err(NetError.TlsError("SSL_CTX_new failed"))
                }
                if SSL_CTX_use_certificate_chain_file(ctx, certPath) != 1 {
                    SSL_CTX_free(ctx)
                    sysClose(fd)
                    return Result.Err(NetError.TlsError("failed to load certificate chain: " + certPath))
                }
                if SSL_CTX_use_PrivateKey_file(ctx, keyPath, SSL_FILETYPE_PEM) != 1 {
                    SSL_CTX_free(ctx)
                    sysClose(fd)
                    return Result.Err(NetError.TlsError("failed to load private key: " + keyPath))
                }
                // Cert and key load independently, so a mismatched pair gets this far. Left
                // unchecked it surfaces only as every client's handshake failing, with
                // nothing on the server naming the cause.
                if SSL_CTX_check_private_key(ctx) != 1 {
                    SSL_CTX_free(ctx)
                    sysClose(fd)
                    return Result.Err(NetError.TlsError("private key does not match certificate"))
                }
                return Result.Ok(TlsListener { _fd: fd, _ctx: ctxAddr })
            }
        }
    }

    // Accept one connection and run the server handshake on it.
    fn accept(self: &Self): Result<TlsConn, NetError> {
        unsafe {
            // acceptFd, not TcpListener.accept: a TcpStream built here would close the client
            // fd when it dropped, out from under the TlsConn that took it over. acceptFd also
            // leaves the client fd blocking outside a green task and nonblocking inside one —
            // the same split connectFd makes, and the one sslAcceptFd assumes.
            let clientFd = acceptFd(self._fd)
            if clientFd < 0 {
                return Result.Err(NetError.ConnectionFailed("accept() failed"))
            }
            unsafe {
                let ssl = SSL_new(self._ctx as *u8)
                let sslAddr = ssl as i64
                if sslAddr == 0 {
                    sysClose(clientFd)
                    return Result.Err(NetError.TlsError("SSL_new failed"))
                }
                SSL_set_fd(ssl, clientFd)
                if sslAcceptFd(ssl, clientFd) != 1 {
                    SSL_free(ssl)
                    sysClose(clientFd)
                    return Result.Err(NetError.TlsError("SSL_accept failed"))
                }
                return Result.Ok(TlsConn { _fd: clientFd, _ssl: sslAddr })
            }
        }
    }

    // accept() whose handshake must finish within `ms` of the TCP accept (0 = no limit).
    // Without it a client that connects and sends nothing parks the handshake forever,
    // and a server accepting one connection at a time (std/https) stops answering
    // everyone. The connection comes back nonblocking, for readMoreBy and sendWithin;
    // recvOnce/recv/send assume a blocking fd outside a green task, so use those on a
    // connection from accept().
    fn acceptWithin(self: &Self, ms: i64): Result<TlsConn, NetError> {
        unsafe {
            let clientFd = acceptFd(self._fd)
            if clientFd < 0 {
                return Result.Err(NetError.ConnectionFailed("accept() failed"))
            }
            // Counted from here, not from the call: the wait for a client to arrive is not
            // the client's to spend.
            let by = deadlineIn(ms)
            setNonblocking(clientFd)
            let ssl = SSL_new(self._ctx as *u8)
            let sslAddr = ssl as i64
            if sslAddr == 0 {
                sysClose(clientFd)
                return Result.Err(NetError.TlsError("SSL_new failed"))
            }
            SSL_set_fd(ssl, clientFd)
            let r = sslAcceptFdWait(ssl, clientFd, (forRead: bool): bool => waitIo(clientFd, forRead, by))
            if r != 1 {
                SSL_free(ssl)
                sysClose(clientFd)
                if r == SSL_GAVE_UP {
                    return Result.Err(NetError.Timeout("TLS handshake"))
                }
                return Result.Err(NetError.TlsError("SSL_accept failed"))
            }
            return Result.Ok(TlsConn { _fd: clientFd, _ssl: sslAddr })
        }
    }

    // The bound port — how to learn what the OS picked after bind(0).
    // -1 if getsockname fails, mirroring getSockPort rather than reporting a
    // plausible-looking port number.
    fn port(self: &Self): i32 {
        unsafe {
            return getSockPort(self._fd)
        }
    }
}
