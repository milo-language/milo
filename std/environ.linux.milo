from "std/fs" import {
    readFile
}
from "std/platform" import {
    environBlock
}
// std/environ — enumerate the whole process environment.
//
// getEnv reads one variable by name; this lists every variable, which is what a
// language runtime needs to expose something like Node's process.env.
//
// The live environment is the `environ` array (std/platform's environBlock). Linux also
// publishes it as NUL-separated NAME=VALUE records in /proc/self/environ, but that copy
// is FROZEN at exec: it never reflects a later Env.set, so it is only the fallback for
// the case where the `environ` symbol cannot be resolved (a fully static binary).

pub struct EnvEntry {
    name: string,
    value: string,
}

// Every variable in the process environment, in the order the OS supplies them.
pub fn envVars(): Vec<EnvEntry> {
    var out: Vec<EnvEntry> = Vec.new()
    unsafe {
        let block = environBlock()
        if block as i64 != 0 {
            var b: i64 = 0
            var going = true
            while going {
                let entry: *u8 = block[b]
                if (entry as i64) == 0 {
                    going = false
                } else {
                    let text = _cstrToString(entry)
                    // entries are NAME=VALUE; a value may itself contain '='
                    var eq: i64 = -1
                    var k: i64 = 0
                    while k < text.len() && eq < 0 {
                        if text[k] == '=' {
                            eq = k
                        }
                        k += 1
                    }
                    if eq > 0 {
                        var name = String.withCapacity(eq)
                        var n: i64 = 0
                        while n < eq {
                            name.push(text[n])
                            n += 1
                        }
                        var value = String.withCapacity(text.len() - eq)
                        var v = eq + 1
                        while v < text.len() {
                            value.push(text[v])
                            v += 1
                        }
                        out.push(EnvEntry {
                            name: name, value: value
                        })
                    }
                    b += 1
                }
            }
            return out
        }
    }
    match readFile("/proc/self/environ") {
        Result.Ok(blob) => {
            var start: i64 = 0
            var i: i64 = 0
            while i <= blob.len() {
                let atEnd = i == blob.len()
                if atEnd || blob[i] == 0 as u8 {
                    if i > start {
                        // entries are NAME=VALUE; a value may itself contain '='
                        var eq: i64 = -1
                        var k = start
                        while k < i && eq < 0 {
                            if blob[k] == '=' {
                                eq = k
                            }
                            k += 1
                        }
                        if eq > start {
                            var name = String.withCapacity(eq - start)
                            var n = start
                            while n < eq {
                                name.push(blob[n])
                                n += 1
                            }
                            var value = String.withCapacity(i - eq)
                            var v = eq + 1
                            while v < i {
                                value.push(blob[v])
                                v += 1
                            }
                            out.push(EnvEntry {
                                name: name, value: value
                            })
                        }
                    }
                    start = i + 1
                }
                i += 1
            }
        }
        Result.Err(_e) => {
        }
    }
    return out
}
