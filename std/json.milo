// std/json — flat pool JSON parser
// All nodes in one Vec, child relationships via indirection table.
// String values stored as offsets into source — zero allocation during parse.
// ~6 allocations total for any document size.

from "std/binary" import {
    Bytes
}

// kind: 0=null 1=bool 2=number 3=string 4=array 5=object
//
// 24 bytes, down from 56 with one named field per kind: the pool is the parse's
// working set, and the wider node cost 10-15% of parse time in cache misses.
// The two payload words mean something different per kind; only the jsonNode*
// accessors and jsonNew* constructors below know the layout.
//   null:          a = 0, b = 0
//   bool:          a = 1 for true, 0 for false
//   string:        a = strStart, b = strLen
//   number:        a = the f64's IEEE-754 bit pattern, b = (strStart << 32) | strLen
//   array, object: a = childStart, b = (keyStart << 32) | childCount (keyStart 0 for arrays)
// The packed halves fit because jsonParse caps the input at 2^32-1 bytes and
// the pool at 2^32-1 nodes: every source offset, length and count is below 2^32.
pub struct JsonNode {
    kind: i32,
    a: i64,
    b: i64,
}

fn jsonNewNull(): JsonNode {
    return JsonNode {
        kind: 0, a: 0, b: 0
    }
}

fn jsonNewBool(v: bool): JsonNode {
    if v {
        return JsonNode {
            kind: 1, a: 1, b: 0
        }
    }
    return JsonNode {
        kind: 1, a: 0, b: 0
    }
}

fn jsonNewStr(start: i64, len: i64): JsonNode {
    return JsonNode {
        kind: 3, a: start, b: len
    }
}

fn jsonNewNum(val: f64, start: i64, len: i64): JsonNode {
    return JsonNode {
        kind: 2, a: Bytes.f64ToBits(val) as i64, b: (start << 32) | len
    }
}

// `kind` is 4 (array) or 5 (object). Asserted rather than relying on the pool
// cap alone: the cap is checked after the parse, and this is the one pack that
// jsonExtractSubtree also performs outside jsonParse.
fn jsonNewContainer(kind: i32, childStart: i64, childCount: i64, keyStart: i64): JsonNode {
    assert(childCount <= 0xFFFFFFFF && keyStart <= 0xFFFFFFFF, "json: container exceeds 2^32 children, node cannot pack it")
    return JsonNode {
        kind: kind, a: childStart, b: (keyStart << 32) | childCount
    }
}

fn jsonNodeBool(n: &JsonNode): bool {
    return n.a != 0
}

fn jsonNodeNum(n: &JsonNode): f64 {
    return Bytes.f64FromBits(n.a as u64)
}

// Source span of a string (kind 3) or number literal (kind 2).
fn jsonNodeStrStart(n: &JsonNode): i64 {
    if n.kind == 2 {
        return n.b >> 32
    }
    return n.a
}

fn jsonNodeStrLen(n: &JsonNode): i64 {
    if n.kind == 2 {
        return n.b & 0xFFFFFFFF
    }
    return n.b
}

fn jsonNodeChildStart(n: &JsonNode): i64 {
    return n.a
}

// 0 for a scalar, as the dedicated field was: len() and jsonExtractSubtree ask
// without checking the kind first, and a string's b is its length.
fn jsonNodeChildCount(n: &JsonNode): i64 {
    if n.kind < 4 {
        return 0
    }
    return n.b & 0xFFFFFFFF
}

fn jsonNodeKeyStart(n: &JsonNode): i64 {
    return n.b >> 32
}

pub struct Json {
    source: string,
    nodes: Vec<JsonNode>,
    childIdx: Vec<i64>,
    keyOffsets: Vec<i64>,
    keyLens: Vec<i64>,
    root: i64,
    // Identity of this parse, carried in the high bits of every cursor the
    // document hands out (see the cursor-branding section below). Always in
    // 1..2^31-1; 0 is reserved so a hand-built cursor never matches. The same
    // runtime brand seal.Span carries as _bufferId (docs/memory-safety-vs-rust.md).
    _docId: i64,
}

// ── Cursor branding ──
//
// A cursor is (document brand << 32) | node index, still one i64. The brand is
// what stops the one silent failure the raw-index cursor had: a cursor from
// document A resolved against document B named an in-bounds node of B and
// nothing objected. Rust rejects that tie-up at compile time with an invariant
// lifetime; Milo has no lifetimes to carry the tie, so it is a runtime tag,
// exactly as seal.Span carries _bufferId. See docs/memory-safety-vs-rust.md.
//
// -1 stays the "nothing here" cursor: brands fit 31 bits, so every packed
// cursor is positive and `cur < 0` still separates missing from present.

fn jsonCurPack(docId: i64, idx: i64): i64 {
    return (docId << 32) | idx
}

fn jsonCurIdx(cur: i64): i64 {
    return cur & 0xFFFFFFFF
}

// The check every cursor accessor funnels through. A negative cursor is the
// total-navigation "nothing here" and passes through as -1. A cursor branded
// for a DIFFERENT document is not "nothing here": it is a program that mixed
// two documents, and answering Option.None would launder that bug into the
// missing-key path, where `?? fallback` swallows it silently. seal resolved
// the same tension for eq() the same way (assert, with holds() as the
// tolerant probe): the accessors abort, and curHolds is the branch point for
// a cursor of unknown origin. A hand-built integer cursor carries brand 0,
// which no document ever has, so the old raw-index habit fails closed too.
fn jsonCurResolve(doc: &Json, cur: i64): i64 {
    if cur < 0 {
        return -1
    }
    assert((cur >> 32) == doc._docId, "json: cursor belongs to a different document")
    return cur & 0xFFFFFFFF
}

// Doc brands start at 1 so a hand-built or zeroed cursor never matches a real
// document. Atomic for the same reason seal's buffer ids are: parsing can run
// on Promise.blocking worker threads, not only the scheduler thread.
var nextJsonDocId: i64 = 1

fn jsonMintDocId(): i64 {
    var b: i64 = 0
    unsafe {
        b = _atomicAddI64((nextJsonDocId.addrOf()) as *u8, 1)
    }
    // Fold into 1..2^31-1: the packed cursor gives the brand 31 bits, and 0 is
    // reserved for hand-built cursors. Brands repeat after 2^31-1 documents; a
    // stale cursor is then wrongly accepted only if it was held across an exact
    // multiple of that many parses, the same residual window seal accepts for
    // its i32 buffer ids.
    return ((b - 1) % 2147483647) + 1
}

// ── Key comparison (byte-by-byte against source, zero allocation) ──

fn jsonKeyEq(source: &string, off: i64, klen: i64, target: &string): bool {
    if klen != target.len {
        return false
    }
    for i in 0..klen {
        if source[off + i] != target[i] {
            return false
        }
    }
    return true
}

// ── String materialization (allocates only when user requests the value) ──

fn jsonHexVal(c: u8): i64 {
    if c >= 48 && c <= 57 {
        return (c - 48) as i64
    } // 0-9
    if c >= 97 && c <= 102 {
        return (c - 97 + 10) as i64
    } // a-f
    if c >= 65 && c <= 70 {
        return (c - 65 + 10) as i64
    } // A-F
    return 0
}

// Exact integer read of a number node.
//
// The parser accumulates every number into an f64, which is lossy past 2^53 and
// silently truncating for `1.5`. Both directions are data loss with no signal,
// so an integer read re-scans the literal's own source span instead: only a
// literal that is an integer AND fits i64 answers Some. Out of range, fractional
// and exponent forms answer None, which the caller already has to handle.
// (i64::MIN reads as None — its magnitude is one past what this accumulates.)
fn jsonNodeInt(source: &string, n: &JsonNode): Option<i64> {
    if jsonNodeStrLen(n) <= 0 {
        return Option.None
    }
    var i: i64 = jsonNodeStrStart(n)
    let end = jsonNodeStrStart(n) + jsonNodeStrLen(n)
    var neg: bool = false
    if i < end && source[i] == '-' {
        neg = true
        i = i + 1
    }
    if i >= end {
        return Option.None
    }
    var acc: i64 = 0
    while i < end {
        let c = source[i]
        if c < '0' || c > '9' {
            return Option.None
        }
        if acc > 922337203685477580 {
            return Option.None
        }
        acc = acc * 10
        let d = (c as i64) - 48
        if acc > 9223372036854775807 - d {
            return Option.None
        }
        acc = acc + d
        i = i + 1
    }
    if neg {
        return Option.Some(0 - acc)
    }
    return Option.Some(acc)
}

// Same rules as jsonNodeInt, for the half of u64 that i64 cannot hold. A `u64`
// field would otherwise be writable but not readable.
fn jsonNodeUint(source: &string, n: &JsonNode): Option<u64> {
    if jsonNodeStrLen(n) <= 0 {
        return Option.None
    }
    var i: i64 = jsonNodeStrStart(n)
    let end = jsonNodeStrStart(n) + jsonNodeStrLen(n)
    if i < end && source[i] == '-' {
        return Option.None
    }
    if i >= end {
        return Option.None
    }
    var acc: u64 = 0
    while i < end {
        let c = source[i]
        if c < '0' || c > '9' {
            return Option.None
        }
        if acc > 1844674407370955161 {
            return Option.None
        }
        acc = acc * 10
        let d = (c as i64) as u64 - 48
        if acc > 18446744073709551615 - d {
            return Option.None
        }
        acc = acc + d
        i = i + 1
    }
    return Option.Some(acc)
}

fn jsonMaterializeStr(source: &string, start: i64, len: i64): string {
    var hasEscape: bool = false
    var i: i64 = 0
    while i < len {
        if source[start + i] == '\\' {
            hasEscape = true
            break
        }
        i = i + 1
    }
    if !hasEscape {
        var result: string = String.withCapacity(len)
        i = 0
        while i < len {
            result.push(source[start + i])
            i = i + 1
        }
        return result
    }
    var result: string = ""
    i = 0
    while i < len {
        if source[start + i] == '\\' && i + 1 < len {
            i = i + 1
            let esc = source[start + i]
            if esc == 'n' {
                result.push('\n')
            } 
            else if esc == 't' {
                result.push('\t')
            } 
            else if esc == 'r' {
                result.push('\r')
            } 
            else if esc == '"' {
                result.push('"')
            } 
            else if esc == '\\' {
                result.push('\\')
            } 
            else if esc == '/' {
                result.push('/')
            } 
            else if esc == 'b' {
                result.push(8 as u8)
            } 
            else if esc == 'f' {
                result.push(12 as u8)
            } 
            else if esc == 'u' && i + 4 < len {
                // \uXXXX → code point → UTF-8.
                //
                // A non-BMP character arrives as a SURROGATE PAIR, because JSON inherits
                // JS's UTF-16 escapes — `"\ud83d\ude00"` is one code point, U+1F600.
                // Emitting the halves separately produced two 3-byte sequences (CESU-8):
                // 6 bytes where UTF-8 needs 4, and not equal to the literal "😀". Every
                // surrogate is an invalid Unicode scalar value, so that output was not
                // valid UTF-8 at all — which is the one thing Milo's string type promises.
                var cp = (jsonHexVal(source[start + i + 1]) << 12)
                | (jsonHexVal(source[start + i + 2]) << 8)
                | (jsonHexVal(source[start + i + 3]) << 4)
                | jsonHexVal(source[start + i + 4])
                i = i + 4
                if cp >= 0xD800 && cp <= 0xDBFF && i + 6 < len
                && source[start + i + 1] == '\\' && source[start + i + 2] == 'u' {
                    let lo = (jsonHexVal(source[start + i + 3]) << 12)
                    | (jsonHexVal(source[start + i + 4]) << 8)
                    | (jsonHexVal(source[start + i + 5]) << 4)
                    | jsonHexVal(source[start + i + 6])
                    if lo >= 0xDC00 && lo <= 0xDFFF {
                        cp = 0x10000 + ((cp - 0xD800) << 10) + (lo - 0xDC00)
                        i = i + 6
                    }
                }
                // An unpaired surrogate — a high one nothing followed, or a stray low —
                // has no UTF-8 encoding. U+FFFD is what the rest of this module already
                // substitutes for a malformed sequence (see REPLACEMENT_CHAR).
                if cp >= 0xD800 && cp <= 0xDFFF {
                    cp = 0xFFFD
                }
                if cp < 0x80 {
                    result.push(cp as u8)
                } else if cp < 0x800 {
                    result.push((0xC0 | (cp >> 6)) as u8)
                    result.push((0x80 | (cp & 0x3F)) as u8)
                } else if cp < 0x10000 {
                    result.push((0xE0 | (cp >> 12)) as u8)
                    result.push((0x80 | ((cp >> 6) & 0x3F)) as u8)
                    result.push((0x80 | (cp & 0x3F)) as u8)
                } else {
                    result.push((0xF0 | (cp >> 18)) as u8)
                    result.push((0x80 | ((cp >> 12) & 0x3F)) as u8)
                    result.push((0x80 | ((cp >> 6) & 0x3F)) as u8)
                    result.push((0x80 | (cp & 0x3F)) as u8)
                }
            } 
            else {
                result.push(esc)
            }
        } else {
            result.push(source[start + i])
        }
        i = i + 1
    }
    return result
}

impl Json {
    // ── Namespace entry points (static) ──

    // Parse strict RFC 8259 JSON. Propagate failures with `?` or match on the error.
    fn parse(s: string): Result<Json> {
        return jsonParse(s)
    }

    // Parse JSON with JSONC extensions (comments, trailing commas).
    fn parseJsonc(s: string): Result<Json> {
        return jsoncParse(s)
    }

    // New empty object builder: Json.obj().set("k", ...).build().
    fn obj(): JsonObj {
        return jsonObj()
    }

    // New empty array builder.
    fn arr(): JsonArr {
        return jsonArr()
    }

    // ── Object field accessors ──

    fn get(self: &Self, key: &string): Option<Json> {
        let node = self.nodes[self.root]
        if node.kind != 5 {
            return Option.None
        }
        for i in 0..jsonNodeChildCount(node) {
            if jsonKeyEq(self.source, self.keyOffsets[jsonNodeKeyStart(node) + i], self.keyLens[jsonNodeKeyStart(node) + i], key) {
                let childNodeIdx = self.childIdx[jsonNodeChildStart(node) + i]
                return Option.Some(jsonExtractSubtree(self, childNodeIdx))
            }
        }
        return Option.None
    }

    fn str(self: &Self, key: &string): Option<string> {
        let node = self.nodes[self.root]
        if node.kind != 5 {
            return Option.None
        }
        for i in 0..jsonNodeChildCount(node) {
            if jsonKeyEq(self.source, self.keyOffsets[jsonNodeKeyStart(node) + i], self.keyLens[jsonNodeKeyStart(node) + i], key) {
                let child = self.nodes[self.childIdx[jsonNodeChildStart(node) + i]]
                if child.kind == 3 {
                    return Option.Some(jsonMaterializeStr(self.source, jsonNodeStrStart(child), jsonNodeStrLen(child)))
                }
                return Option.None
            }
        }
        return Option.None
    }

    fn i64(self: &Self, key: &string): Option<i64> {
        let node = self.nodes[self.root]
        if node.kind != 5 {
            return Option.None
        }
        for i in 0..jsonNodeChildCount(node) {
            if jsonKeyEq(self.source, self.keyOffsets[jsonNodeKeyStart(node) + i], self.keyLens[jsonNodeKeyStart(node) + i], key) {
                let child = self.nodes[self.childIdx[jsonNodeChildStart(node) + i]]
                if child.kind == 2 {
                    return jsonNodeInt(self.source, child)
                }
                return Option.None
            }
        }
        return Option.None
    }

    fn f64(self: &Self, key: &string): Option<f64> {
        let node = self.nodes[self.root]
        if node.kind != 5 {
            return Option.None
        }
        for i in 0..jsonNodeChildCount(node) {
            if jsonKeyEq(self.source, self.keyOffsets[jsonNodeKeyStart(node) + i], self.keyLens[jsonNodeKeyStart(node) + i], key) {
                let child = self.nodes[self.childIdx[jsonNodeChildStart(node) + i]]
                if child.kind == 2 {
                    return Option.Some(jsonNodeNum(child))
                }
                return Option.None
            }
        }
        return Option.None
    }

    fn bool(self: &Self, key: &string): Option<bool> {
        let node = self.nodes[self.root]
        if node.kind != 5 {
            return Option.None
        }
        for i in 0..jsonNodeChildCount(node) {
            if jsonKeyEq(self.source, self.keyOffsets[jsonNodeKeyStart(node) + i], self.keyLens[jsonNodeKeyStart(node) + i], key) {
                let child = self.nodes[self.childIdx[jsonNodeChildStart(node) + i]]
                if child.kind == 1 {
                    return Option.Some(jsonNodeBool(child))
                }
                return Option.None
            }
        }
        return Option.None
    }

    // ── Array access ──

    fn at(self: &Self, index: i64): Option<Json> {
        let node = self.nodes[self.root]
        if node.kind != 4 || index < 0 || index >= jsonNodeChildCount(node) {
            return Option.None
        }
        let childNodeIdx = self.childIdx[jsonNodeChildStart(node) + index]
        return Option.Some(jsonExtractSubtree(self, childNodeIdx))
    }

    // ── Zero-copy cursor navigation ──
    //
    // `get`/`at` above return an owned Json by deep-cloning the whole document
    // (source string + every node) per call — navigating a large doc thousands
    // of times blows up to gigabytes. The cursor API instead hands out an `i64`
    // cursor into THIS document: navigation returns cursors (-1 = missing) with
    // zero allocation, and only leaf-string reads materialize (just that one
    // string). Start at `curRoot()` and chain:
    //   let user = doc.curField(doc.curChild(doc.curRoot(), 0), "name")
    //   match doc.curStr(user) { Option.Some(s) => ..., Option.None => ... }
    //
    // A cursor is not a bare node index: the document's brand rides in its
    // high bits (see jsonCurResolve above). Resolving a cursor against a
    // different Json used to read a wrong-but-in-bounds node of the other
    // document and report nothing; now it aborts, naming the mistake. -1 still
    // flows through every accessor as "nothing here", so navigation stays
    // total for any in-document miss. A memberwise copy of a Json shares its
    // brand, which is sound because copying preserves node numbering; the
    // documents `get`/`at`/`path` return carry a fresh brand because
    // extraction renumbers the pool.
    //
    // This is one of two ways to reach a nested value. The other is to chain the
    // owned accessors with `Option.andThen` — `doc.at(0).andThen((j) => j.str("name"))`
    // — which reads better but pays one deep clone per hop. Both replaced the family
    // of fixed-shape accessors (`strAt`, `childI64At`, …) this module used to carry;
    // see docs/breaking-changes.md.
    fn curRoot(self: &Self): i64 {
        return jsonCurPack(self._docId, self.root)
    }

    fn curChild(self: &Self, cur: i64, index: i64): i64 {
        let raw = jsonCurResolve(self, cur)
        if raw < 0 {
            return -1
        }
        let node = self.nodes[raw]
        if node.kind != 4 || index < 0 || index >= jsonNodeChildCount(node) {
            return -1
        }
        return jsonCurPack(self._docId, self.childIdx[jsonNodeChildStart(node) + index])
    }

    fn curField(self: &Self, cur: i64, key: &string): i64 {
        let raw = jsonCurResolve(self, cur)
        if raw < 0 {
            return -1
        }
        let node = self.nodes[raw]
        if node.kind != 5 {
            return -1
        }
        for i in 0..jsonNodeChildCount(node) {
            if jsonKeyEq(self.source, self.keyOffsets[jsonNodeKeyStart(node) + i], self.keyLens[jsonNodeKeyStart(node) + i], key) {
                return jsonCurPack(self._docId, self.childIdx[jsonNodeChildStart(node) + i])
            }
        }
        return -1
    }

    fn curLen(self: &Self, cur: i64): i64 {
        let raw = jsonCurResolve(self, cur)
        if raw < 0 {
            return 0
        }
        let node = self.nodes[raw]
        if node.kind != 4 && node.kind != 5 {
            return 0
        }
        return jsonNodeChildCount(node)
    }

    // Node kind at the cursor: 0 null, 1 bool, 2 number, 3 string, 4 array,
    // 5 object; -1 if the cursor is invalid.
    fn curKind(self: &Self, cur: i64): i32 {
        let raw = jsonCurResolve(self, cur)
        if raw < 0 {
            return -1
        }
        return self.nodes[raw].kind
    }

    // Whether `cur` is a cursor into THIS document (and in range). Branch on
    // this for a cursor you did not navigate to yourself; the accessors abort
    // on a foreign cursor instead. False for -1. Mirrors Sealed.holds.
    fn curHolds(self: &Self, cur: i64): bool {
        if cur < 0 {
            return false
        }
        if (cur >> 32) != self._docId {
            return false
        }
        return (cur & 0xFFFFFFFF) < self.nodes.len()
    }

    fn curInt(self: &Self, cur: i64): Option<i64> {
        let raw = jsonCurResolve(self, cur)
        if raw < 0 {
            return Option.None
        }
        let node = self.nodes[raw]
        if node.kind == 2 {
            return jsonNodeInt(self.source, node)
        }
        return Option.None
    }

    // Unsigned read, for values above i64::MAX that `curInt` must reject.
    fn curUint(self: &Self, cur: i64): Option<u64> {
        let raw = jsonCurResolve(self, cur)
        if raw < 0 {
            return Option.None
        }
        let node = self.nodes[raw]
        if node.kind == 2 {
            return jsonNodeUint(self.source, node)
        }
        return Option.None
    }

    fn curFloat(self: &Self, cur: i64): Option<f64> {
        let raw = jsonCurResolve(self, cur)
        if raw < 0 {
            return Option.None
        }
        let node = self.nodes[raw]
        if node.kind == 2 {
            return Option.Some(jsonNodeNum(node))
        }
        return Option.None
    }

    fn curBool(self: &Self, cur: i64): Option<bool> {
        let raw = jsonCurResolve(self, cur)
        if raw < 0 {
            return Option.None
        }
        let node = self.nodes[raw]
        if node.kind == 1 {
            return Option.Some(jsonNodeBool(node))
        }
        return Option.None
    }

    fn curStr(self: &Self, cur: i64): Option<string> {
        let raw = jsonCurResolve(self, cur)
        if raw < 0 {
            return Option.None
        }
        let node = self.nodes[raw]
        if node.kind == 3 {
            return Option.Some(jsonMaterializeStr(self.source, jsonNodeStrStart(node), jsonNodeStrLen(node)))
        }
        return Option.None
    }

    // ── Bare value extraction ──

    fn asStr(self: &Self): Option<string> {
        let node = self.nodes[self.root]
        if node.kind == 3 {
            return Option.Some(jsonMaterializeStr(self.source, jsonNodeStrStart(node), jsonNodeStrLen(node)))
        }
        return Option.None
    }

    fn asI64(self: &Self): Option<i64> {
        let node = self.nodes[self.root]
        if node.kind == 2 {
            return jsonNodeInt(self.source, node)
        }
        return Option.None
    }

    fn asF64(self: &Self): Option<f64> {
        let node = self.nodes[self.root]
        if node.kind == 2 {
            return Option.Some(jsonNodeNum(node))
        }
        return Option.None
    }

    fn asBool(self: &Self): Option<bool> {
        let node = self.nodes[self.root]
        if node.kind == 1 {
            return Option.Some(jsonNodeBool(node))
        }
        return Option.None
    }

    // ── Type checks ──

    fn isNull(self: &Self): bool {
        return self.nodes[self.root].kind == 0
    }
    fn isStr(self: &Self): bool {
        return self.nodes[self.root].kind == 3
    }
    fn isNum(self: &Self): bool {
        return self.nodes[self.root].kind == 2
    }
    fn isBool(self: &Self): bool {
        return self.nodes[self.root].kind == 1
    }
    fn isArray(self: &Self): bool {
        return self.nodes[self.root].kind == 4
    }
    fn isObject(self: &Self): bool {
        return self.nodes[self.root].kind == 5
    }

    fn len(self: &Self): i64 {
        return jsonNodeChildCount(self.nodes[self.root])
    }

    fn rawStr(self: &Self): string {
        return jsonNodeRawStr(self, self.root)
    }

    // The document re-rendered with `indent` spaces per level (0 or less
    // minifies). Reformats rawStr(), so what comes out is the same bytes the
    // parse went in with, only re-spaced (see jsonPretty).
    fn pretty(self: &Self, indent: i64): string {
        let raw = self.rawStr()
        return jsonPretty(raw, indent)
    }

    // ── Path accessors ──
    //
    // Reading a nested field through get().get().asStr() nests an Option per level,
    // and every level has to be unwrapped or matched even though the caller only
    // ever wants "the value, or a default". These collapse the whole walk into one
    // Option so `?? fallback` finishes the job.

    // Cursor at the end of a dotted path — "a.b", "items[0].name". A missing key,
    // an out-of-range index or a shape mismatch yields -1, which every cursor
    // accessor already reads as "nothing here", so the walk is total for any input.
    // A key containing '.' or '[' is not addressable this way; use get()/at().
    fn curPath(self: &Self, p: &string): i64 {
        var cur: i64 = self.curRoot()
        var seg: string = ""
        var inIndex: bool = false
        var idx: i64 = 0
        for b in p {
            if inIndex {
                if b == ']' {
                    cur = self.curChild(cur, idx)
                    inIndex = false
                    idx = 0
                } else if b >= '0' && b <= '9' {
                    idx = idx * 10 + ((b as i64) - 48)
                } else {
                    return -1
                }
            } else if b == '.' {
                if seg.len > 0 {
                    cur = self.curField(cur, seg)
                    seg = ""
                }
            } else if b == '[' {
                if seg.len > 0 {
                    cur = self.curField(cur, seg)
                    seg = ""
                }
                inIndex = true
                idx = 0
            } else {
                seg.push(b)
            }
            if cur < 0 {
                return -1
            }
        }
        // An unterminated '[' never resolved to a child, so the path is malformed.
        if inIndex {
            return -1
        }
        if seg.len > 0 {
            cur = self.curField(cur, seg)
        }
        return cur
    }

    fn path(self: &Self, p: &string): Option<Json> {
        let cur = self.curPath(p)
        if cur < 0 {
            return Option.None
        }
        return Option.Some(jsonExtractSubtree(self, jsonCurIdx(cur)))
    }

    fn strPath(self: &Self, p: &string): Option<string> {
        return self.curStr(self.curPath(p))
    }

    fn i64Path(self: &Self, p: &string): Option<i64> {
        return self.curInt(self.curPath(p))
    }

    fn f64Path(self: &Self, p: &string): Option<f64> {
        return self.curFloat(self.curPath(p))
    }

    fn boolPath(self: &Self, p: &string): Option<bool> {
        return self.curBool(self.curPath(p))
    }

    // Key of the object child at `index`. `keys()` answers the same question for the
    // ROOT only, which is no help to a nested object whose keys are not known ahead of
    // time — decoding a `HashMap<string, V>` field has to walk children it cannot name.
    // Empty string for a non-object cursor or an out-of-range index; "" is also a legal
    // JSON key, so bound the walk with `curLen` rather than testing the result.
    fn curKeyAt(self: &Self, cur: i64, index: i64): string {
        let raw = jsonCurResolve(self, cur)
        if raw < 0 {
            return ""
        }
        let node = self.nodes[raw]
        if node.kind != 5 || index < 0 || index >= jsonNodeChildCount(node) {
            return ""
        }
        return jsonMaterializeStr(self.source, self.keyOffsets[jsonNodeKeyStart(node) + index], self.keyLens[jsonNodeKeyStart(node) + index])
    }

    // Value of the object child at `index`, the other half of curKeyAt. Deliberately
    // separate from `curChild`, which is the ARRAY accessor and returns -1 for an object:
    // "element i of an array" and "entry i of an object" are different questions, and one
    // function answering both would make an object walked as an array look like it worked.
    fn curValueAt(self: &Self, cur: i64, index: i64): i64 {
        let raw = jsonCurResolve(self, cur)
        if raw < 0 {
            return -1
        }
        let node = self.nodes[raw]
        if node.kind != 5 || index < 0 || index >= jsonNodeChildCount(node) {
            return -1
        }
        return jsonCurPack(self._docId, self.childIdx[jsonNodeChildStart(node) + index])
    }

    fn keys(self: &Self): Vec<string> {
        var result: Vec<string> = Vec.new()
        let root = self.curRoot()
        var i: i64 = 0
        while i < self.curLen(root) {
            result.push(self.curKeyAt(root, i))
            i = i + 1
        }
        return result
    }
}

fn jsonNodeRawStr(doc: &Json, nodeIdx: i64): string {
    let node = doc.nodes[nodeIdx]
    if node.kind == 0 {
        return "null"
    }
    if node.kind == 1 {
        if jsonNodeBool(node) {
            return "true"
        }
        return "false"
    }
    if node.kind == 2 {
        // Verbatim source slice: exact round-trip for ints f64 formatting would mangle.
        if jsonNodeStrLen(node) > 0 {
            return jsonMaterializeStr(doc.source, jsonNodeStrStart(node), jsonNodeStrLen(node))
        }
        return $"{jsonNodeNum(node)}"
    }
    if node.kind == 3 {
        return "\"" + jsonEscapeStr(jsonMaterializeStr(doc.source, jsonNodeStrStart(node), jsonNodeStrLen(node))) + "\""
    }
    if node.kind == 4 {
        var s: string = "["
        var i: i64 = 0
        while i < jsonNodeChildCount(node) {
            if i > 0 {
                s = s + ","
            }
            s = s + jsonNodeRawStr(doc, doc.childIdx[jsonNodeChildStart(node) + i])
            i = i + 1
        }
        return s + "]"
    }
    if node.kind == 5 {
        var s: string = "{"
        var i: i64 = 0
        while i < jsonNodeChildCount(node) {
            if i > 0 {
                s = s + ","
            }
            s = s + "\"" + jsonEscapeStr(jsonMaterializeStr(doc.source, doc.keyOffsets[jsonNodeKeyStart(node) + i], doc.keyLens[jsonNodeKeyStart(node) + i])) + "\":" + jsonNodeRawStr(doc, doc.childIdx[jsonNodeChildStart(node) + i])
            i = i + 1
        }
        return s + "}"
    }
    return ""
}

// ── Subtree extraction (for get/at — clones source, remaps indices) ──

fn jsonExtractSubtree(src: &Json, nodeIdx: i64): Json {
    var nodes: Vec<JsonNode> = Vec.new()
    var childIdx: Vec<i64> = Vec.new()
    var keyOffsets: Vec<i64> = Vec.new()
    var keyLens: Vec<i64> = Vec.new()
    var queue: Vec<i64> = Vec.new()
    queue.push(nodeIdx)
    var processed: i64 = 0
    while processed < queue.len() {
        let oldIdx = queue[processed]
        let old = src.nodes[oldIdx]
        var newChildStart: i64 = 0
        var newKeyStart: i64 = 0
        if jsonNodeChildCount(old) > 0 {
            newChildStart = childIdx.len()
            if old.kind == 5 {
                newKeyStart = keyOffsets.len()
            }
            var c: i64 = 0
            while c < jsonNodeChildCount(old) {
                let oldChildIdx = src.childIdx[jsonNodeChildStart(old) + c]
                let newChildIdx = queue.len()
                queue.push(oldChildIdx)
                childIdx.push(newChildIdx)
                if old.kind == 5 {
                    keyOffsets.push(src.keyOffsets[jsonNodeKeyStart(old) + c])
                    keyLens.push(src.keyLens[jsonNodeKeyStart(old) + c])
                }
                c = c + 1
            }
        }
        // Scalars carry only source spans, which the cloned source keeps valid, so
        // they copy as-is; containers are repacked with the renumbered starts.
        if old.kind == 4 || old.kind == 5 {
            nodes.push(jsonNewContainer(old.kind, newChildStart, jsonNodeChildCount(old), newKeyStart))
        } else {
            nodes.push(old)
        }
        processed = processed + 1
    }
    // A fresh brand, not src's: extraction renumbers the pool (BFS order, the
    // subtree root becomes node 0), so a cursor into src resolved against the
    // extract would name a renumbered-wrong node. Its own brand turns that
    // mistake into the named abort. No node-count assert needed here: the pool
    // is a subset of one jsonParse already capped.
    return Json {
        source: src.source.clone(), nodes: nodes, childIdx: childIdx, keyOffsets: keyOffsets, keyLens: keyLens, root: 0, _docId: jsonMintDocId()
    }
}

// ── Parser ──

fn jsonParse(s: string): Result<Json> {
    if s.len == 0 {
        return Result.Err("empty json input at byte 0")
    }
    // A number node packs its source offset and length into 32 bits each (see
    // JsonNode), so an input past 2^32 bytes would store a truncated span: in
    // bounds and wrong. Same rule as the node-count cap below: enforce at mint.
    assert(s.len <= 0xFFFFFFFF, "json: input exceeds 2^32 bytes, node spans cannot address it")
    var nodes: Vec<JsonNode> = Vec.new()
    var childIdx: Vec<i64> = Vec.new()
    var keyOffsets: Vec<i64> = Vec.new()
    var keyLens: Vec<i64> = Vec.new()
    // Size the pools from the input up front: growing them by doubling from empty was
    // ~12% of parse time on benchmarks/json/data.json. Measured bytes per node (and per
    // childIdx entry, which is nodes minus one for any tree) on the repo's json files:
    // 11 (data.json, dense one-line), 24 (tests/hir-cover.json), 29-38 (package.json,
    // the vscode manifests, emitJsParity.baseline.json). Bytes per object key: 20, 31-46,
    // and 1584 for the numeric-array-heavy hir-cover.json. Divisors sit at the sparse end
    // (40 for nodes, 64 for keys) so every measured doc reserves at or below what it needs
    // and a doc of long strings never over-allocates by more than ~60% of its own size.
    nodes.reserve(s.len / 40)
    childIdx.reserve(s.len / 40)
    keyOffsets.reserve(s.len / 64)
    keyLens.reserve(s.len / 64)
    // Scratch stack for in-flight container children, shared across the whole parse so it
    // allocates once, not per container. scratchLen is the logical length, scratch.len() the
    // high-water mark: entries above scratchLen are stale and overwritten in place, so
    // repeated container parses cost zero allocations. The push is written out at each
    // site in jsonParseArray/jsonParseObject (Milo has no inline attribute and the call
    // was ~8% of parse time). It only holds the open containers' pending children, so a
    // small fixed reserve covers most documents.
    var scratch: Vec<i64> = Vec.new()
    scratch.reserve(64)
    var scratchLen: i64 = 0
    var pos: i64 = 0
    var err: bool = false
    jsonSkipWs(s, &mut pos)
    if pos >= s.len {
        return Result.Err("empty json input at byte " + pos.toString())
    }
    let rootIdx = jsonParseValue(s, &mut pos, &mut nodes, &mut childIdx, &mut keyOffsets, &mut keyLens, &mut scratch, &mut scratchLen, &mut err)
    if err {
        return Result.Err("malformed json at byte " + pos.toString())
    }
    jsonSkipWs(s, &mut pos)
    if pos != s.len {
        return Result.Err("trailing json content at byte " + pos.toString())
    }
    // A cursor gives the node index 32 bits (the brand takes the rest), so a
    // pool past 2^32 nodes would pack a truncated index: in bounds, brand
    // matching, and wrong. Same rule as seal's 2GB span cap: enforce at mint,
    // not on resolve.
    assert(nodes.len() <= 0xFFFFFFFF, "json: document exceeds 2^32 nodes, cursors cannot address it")
    return Result.Ok(Json {
        source: s, nodes: nodes, childIdx: childIdx, keyOffsets: keyOffsets, keyLens: keyLens, root: rootIdx, _docId: jsonMintDocId()
    }
    )
}

// JSONC (Microsoft/VS Code flavor): JSON plus // and /* */ comments and trailing commas.
// No formal spec exists; this matches the de-facto jsonc-parser behavior. Implemented as a
// string-aware preprocessor that emits strict JSON, so everything else inherits jsonParse's
// exact RFC-8259 validation — JSONC is strictly a superset of comments + trailing commas, not
// a second, looser parser.
fn jsonStripJsonc(s: &string): string {
    // Pass 1: remove comments outside of string literals (string contents copied verbatim,
    // tracking backslash escapes so a \" inside a string never ends it).
    var nc: string = ""
    var i: i64 = 0
    var inStr: bool = false
    while i < s.len {
        let c = s[i]
        if inStr {
            nc.push(c)
            if c == '\\' && i + 1 < s.len {
                nc.push(s[i + 1])
                i = i + 2
            } else {
                if c == '"' {
                    inStr = false
                }
                i = i + 1
            }
        } else if c == '"' {
            inStr = true
            nc.push(c)
            i = i + 1
        } else if c == '/' && i + 1 < s.len && s[i + 1] == '/' {
            i = i + 2
            while i < s.len && s[i] != '\n' {
                i = i + 1
            }
        } else if c == '/' && i + 1 < s.len && s[i + 1] == '*' {
            i = i + 2
            while i + 1 < s.len && !(s[i] == '*' && s[i + 1] == '/') {
                i = i + 1
            }
            i = i + 2
        } else {
            nc.push(c)
            i = i + 1
        }
    }
    // Pass 2: drop any comma whose next non-whitespace char is ] or } (trailing comma).
    var out: string = ""
    var j: i64 = 0
    var inStr2: bool = false
    while j < nc.len {
        let c = nc[j]
        if inStr2 {
            out.push(c)
            if c == '\\' && j + 1 < nc.len {
                out.push(nc[j + 1])
                j = j + 2
            } else {
                if c == '"' {
                    inStr2 = false
                }
                j = j + 1
            }
        } else if c == '"' {
            inStr2 = true
            out.push(c)
            j = j + 1
        } else if c == ',' {
            var k: i64 = j + 1
            while k < nc.len && (nc[k] == ' ' || nc[k] == '\t' || nc[k] == '\n' || nc[k] == '\r') {
                k = k + 1
            }
            if k < nc.len && (nc[k] == '}' || nc[k] == ']') {
                j = j + 1
            } else {
                out.push(c)
                j = j + 1
            }
        } else {
            out.push(c)
            j = j + 1
        }
    }
    return out
}

fn jsoncParse(s: string): Result<Json> {
    let stripped = jsonStripJsonc(s)
    return jsonParse(stripped)
}

fn jsonSkipWs(s: &string, pos: &mut i64) {
    while pos < s.len {
        let c = s[pos]
        if c != ' ' && c != '\t' && c != '\n' && c != '\r' {
            break
        }
        pos = pos + 1
    }
}

// The three bare literals were previously accepted on their first byte alone, so
// `nope` parsed as null and `trux` as true — malformed text became a plausible
// value with no error.
fn jsonLitAt(s: &string, pos: i64, lit: &string): bool {
    if pos + lit.len > s.len {
        return false
    }
    var i: i64 = 0
    while i < lit.len {
        if s[pos + i] != lit[i] {
            return false
        }
        i = i + 1
    }
    return true
}

fn jsonParseValue(s: &string, pos: &mut i64, nodes: &mut Vec<JsonNode>, childIdx: &mut Vec<i64>, keyOffsets: &mut Vec<i64>, keyLens: &mut Vec<i64>, scratch: &mut Vec<i64>, scratchLen: &mut i64, err: &mut bool): i64 {
    jsonSkipWs(s, &mut pos)
    if pos >= s.len {
        err = true
        let idx = nodes.len()
        nodes.push(jsonNewNull())
        return idx
    }
    let c = s[pos]
    if c == '"' {
        return jsonParseString(s, &mut pos, &mut nodes, &mut err)
    }
    if c == '{' {
        return jsonParseObject(s, &mut pos, &mut nodes, &mut childIdx, &mut keyOffsets, &mut keyLens, &mut scratch, &mut scratchLen, &mut err)
    }
    if c == '[' {
        return jsonParseArray(s, &mut pos, &mut nodes, &mut childIdx, &mut keyOffsets, &mut keyLens, &mut scratch, &mut scratchLen, &mut err)
    }
    if c == 't' {
        if !jsonLitAt(s, pos, "true") {
            err = true
        }
        pos = pos + 4
        let idx = nodes.len()
        nodes.push(jsonNewBool(true))
        return idx
    }
    if c == 'f' {
        if !jsonLitAt(s, pos, "false") {
            err = true
        }
        pos = pos + 5
        let idx = nodes.len()
        nodes.push(jsonNewBool(false))
        return idx
    }
    if c == 'n' {
        if !jsonLitAt(s, pos, "null") {
            err = true
        }
        pos = pos + 4
        let idx = nodes.len()
        nodes.push(jsonNewNull())
        return idx
    }
    // Only '-' or a digit can begin a value here; anything else (',', ']', '}', ':', stray punctuation)
    // is a structural error — guarding here is what rejects empty/leading-comma elements like `[ , x]`.
    if c == '-' || (c >= '0' && c <= '9') {
        return jsonParseNumber(s, &mut pos, &mut nodes, &mut err)
    }
    err = true
    let idx = nodes.len()
    nodes.push(jsonNewNull())
    return idx
}

// RFC 8259 §7: a string char is any Unicode scalar except '"', '\' and the C0 controls (< 0x20),
// which must be escaped. Valid escapes are " \ / b f n r t and \uXXXX. We validate the escape
// letter but not the 4 hex digits (no fail case exercises bad \u, and over-checking risks false
// positives on valid \u sequences).
fn jsonScanString(s: &string, pos: &mut i64, _err: &mut bool) {
    // Local cursor: writing through the &mut i64 every byte defeats LLVM's alias analysis
    // (the store could alias the string header), forcing len/data reloads per char.
    var p: i64 = pos
    let n = s.len
    while p < n {
        let ch = s[p]
        if ch == '"' {
            break
        }
        if ch == '\\' {
            p = p + 1
            if p < n {
                let e = s[p]
                if !(e == '"' || e == '\\' || e == '/' || e == 'b' || e == 'f' || e == 'n' || e == 'r' || e == 't' || e == 'u') {
                    _err = true
                }
                p = p + 1
            } else {
                _err = true
            }
        } else if ch < ' ' {
            _err = true
            p = p + 1
        } else {
            p = p + 1
        }
    }
    if p >= n {
        _err = true
    }
    pos = p
}

fn jsonParseString(s: &string, pos: &mut i64, nodes: &mut Vec<JsonNode>, err: &mut bool): i64 {
    pos = pos + 1
    let start = pos
    jsonScanString(s, &mut pos, &mut err)
    let slen = pos - start
    if pos < s.len {
        pos = pos + 1
    }
    let idx = nodes.len()
    nodes.push(jsonNewStr(start, slen))
    return idx
}

fn jsonScanStringRange(s: &string, pos: &mut i64, start: &mut i64, _slen: &mut i64, err: &mut bool) {
    pos = pos + 1
    start = pos
    jsonScanString(s, &mut pos, &mut err)
    _slen = pos - start
    if pos < s.len {
        pos = pos + 1
    }
}

fn jsonParseNumber(s: &string, pos: &mut i64, nodes: &mut Vec<JsonNode>, _err: &mut bool): i64 {
    // Record the source span so rawStr can round-trip the literal verbatim —
    // f64 formatting would mangle large ints ("1572864" → "1.57286e+06").
    let numStart = pos
    var result: f64 = 0.0
    var negative: bool = false
    if pos < s.len && s[pos] == '-' {
        negative = true
        pos = pos + 1
    }
    // Integer part: RFC requires at least one digit, and forbids leading zeros (`013`) — a single
    // '0' is the only int that may start with '0'.
    if pos >= s.len || !(s[pos] >= '0' && s[pos] <= '9') {
        _err = true
    } else if s[pos] == '0' {
        pos = pos + 1
        if pos < s.len && s[pos] >= '0' && s[pos] <= '9' {
            _err = true
        }
    } else {
        while pos < s.len && s[pos] >= '0' && s[pos] <= '9' {
            result = result * 10.0 + (s[pos] as i32 - 48) as f64
            pos = pos + 1
        }
    }
    if pos < s.len && s[pos] == '.' {
        pos = pos + 1
        if pos >= s.len || !(s[pos] >= '0' && s[pos] <= '9') {
            _err = true
        }
        var frac: f64 = 0.1
        while pos < s.len && s[pos] >= '0' && s[pos] <= '9' {
            result = result + (s[pos] as i32 - 48) as f64 * frac
            frac = frac * 0.1
            pos = pos + 1
        }
    }
    if pos < s.len && (s[pos] == 'e' || s[pos] == 'E') {
        pos = pos + 1
        var expNeg: bool = false
        if pos < s.len && s[pos] == '-' {
            expNeg = true
            pos = pos + 1
        } else if pos < s.len && s[pos] == '+' {
            pos = pos + 1
        }
        if pos >= s.len || !(s[pos] >= '0' && s[pos] <= '9') {
            _err = true
        }
        var exp: i64 = 0
        while pos < s.len && s[pos] >= '0' && s[pos] <= '9' {
            exp = exp * 10 + (s[pos] as i32 - 48) as i64
            pos = pos + 1
        }
        var factor: f64 = 1.0
        var e: i64 = 0
        while e < exp {
            factor = factor * 10.0
            e = e + 1
        }
        if expNeg {
            result = result / factor
        } 
        else {
            result = result * factor
        }
    }
    if negative {
        result = 0.0 - result
    }
    let idx = nodes.len()
    nodes.push(jsonNewNum(result, numStart, pos - numStart))
    return idx
}

// Container children must be contiguous in childIdx, but grandchildren are discovered
// interleaved while a container is still open. Children park on the scratch stack until
// the container closes, then commit as one contiguous block — this replaced a pre-counting
// scan to the matching close bracket that re-read every container body (73% of parse time).
fn jsonParseArray(s: &string, pos: &mut i64, nodes: &mut Vec<JsonNode>, childIdx: &mut Vec<i64>, keyOffsets: &mut Vec<i64>, keyLens: &mut Vec<i64>, scratch: &mut Vec<i64>, scratchLen: &mut i64, err: &mut bool): i64 {
    pos = pos + 1
    let myIdx = nodes.len()
    nodes.push(jsonNewContainer(4, 0, 0, 0))
    jsonSkipWs(s, &mut pos)
    if pos < s.len && s[pos] == ']' {
        pos = pos + 1
        return myIdx
    }
    let sStart = scratchLen
    while pos < s.len {
        // After a comma the next iteration re-enters here; jsonParseValue's value-start guard
        // turns a trailing comma (`,]`) into an error because ']' cannot begin a value.
        let childNodeIdx = jsonParseValue(s, &mut pos, &mut nodes, &mut childIdx, &mut keyOffsets, &mut keyLens, &mut scratch, &mut scratchLen, &mut err)
        // Scratch push, see the scratch comment in jsonParse.
        if scratchLen < scratch.len() {
            scratch[scratchLen] = childNodeIdx
        } else {
            scratch.push(childNodeIdx)
        }
        scratchLen = scratchLen + 1
        if err {
            break
        }
        jsonSkipWs(s, &mut pos)
        if pos < s.len && s[pos] == ',' {
            pos = pos + 1
        } else {
            break
        }
    }
    // Unterminated array (`["x"`) is an error — the close bracket is mandatory.
    if pos < s.len && s[pos] == ']' {
        pos = pos + 1
    } else {
        err = true
    }
    let ci = scratchLen - sStart
    let childStart = childIdx.len()
    var k: i64 = 0
    while k < ci {
        childIdx.push(scratch[sStart + k])
        k = k + 1
    }
    scratchLen = sStart
    nodes[myIdx] = jsonNewContainer(4, childStart, ci, 0)
    return myIdx
}

fn jsonParseObject(s: &string, pos: &mut i64, nodes: &mut Vec<JsonNode>, childIdx: &mut Vec<i64>, keyOffsets: &mut Vec<i64>, keyLens: &mut Vec<i64>, scratch: &mut Vec<i64>, scratchLen: &mut i64, err: &mut bool): i64 {
    pos = pos + 1
    let myIdx = nodes.len()
    nodes.push(jsonNewContainer(5, 0, 0, 0))
    jsonSkipWs(s, &mut pos)
    if pos < s.len && s[pos] == '}' {
        pos = pos + 1
        return myIdx
    }
    // Each entry parks 3 scratch slots: nodeIdx, keyOffset, keyLen. Arrays park 1 per child,
    // but mixed strides coexist fine — every container only reads back its own range.
    let sStart = scratchLen
    // The empty-object case returned above, so reaching the loop means a key is required;
    // expectKey stays true after every comma so a trailing comma (`{...,}`) is rejected.
    var expectKey: bool = true
    while pos < s.len {
        jsonSkipWs(s, &mut pos)
        if pos >= s.len || s[pos] != '"' {
            if expectKey {
                err = true
            }
            break
        }
        expectKey = false
        var koff: i64 = 0
        var klen: i64 = 0
        jsonScanStringRange(s, &mut pos, &mut koff, &mut klen, &mut err)
        jsonSkipWs(s, &mut pos)
        // The colon separating key and value is mandatory (`{"k" null}` is an error).
        if pos < s.len && s[pos] == ':' {
            pos = pos + 1
        } else {
            err = true
        }
        let childNodeIdx = jsonParseValue(s, &mut pos, &mut nodes, &mut childIdx, &mut keyOffsets, &mut keyLens, &mut scratch, &mut scratchLen, &mut err)
        // Three scratch pushes, see the scratch comment in jsonParse.
        if scratchLen < scratch.len() {
            scratch[scratchLen] = childNodeIdx
        } else {
            scratch.push(childNodeIdx)
        }
        scratchLen = scratchLen + 1
        if scratchLen < scratch.len() {
            scratch[scratchLen] = koff
        } else {
            scratch.push(koff)
        }
        scratchLen = scratchLen + 1
        if scratchLen < scratch.len() {
            scratch[scratchLen] = klen
        } else {
            scratch.push(klen)
        }
        scratchLen = scratchLen + 1
        if err {
            break
        }
        jsonSkipWs(s, &mut pos)
        if pos < s.len && s[pos] == ',' {
            pos = pos + 1
            expectKey = true
        } else {
            break
        }
    }
    // Unterminated object (`{"k":1,`) is an error — the close brace is mandatory.
    if pos < s.len && s[pos] == '}' {
        pos = pos + 1
    } else {
        err = true
    }
    let ci = (scratchLen - sStart) / 3
    let childStart = childIdx.len()
    let keyStart = keyOffsets.len()
    var k: i64 = 0
    while k < ci {
        childIdx.push(scratch[sStart + k * 3])
        keyOffsets.push(scratch[sStart + k * 3 + 1])
        keyLens.push(scratch[sStart + k * 3 + 2])
        k = k + 1
    }
    scratchLen = sStart
    nodes[myIdx] = jsonNewContainer(5, childStart, ci, keyStart)
    return myIdx
}

pub fn jsonEscapeStr(s: &string): string {
    var result: string = ""
    var i: i64 = 0
    while i < s.len {
        let c = s[i]
        if c == '"' {
            result = result + "\\\""
        } 
        else if c == '\\' {
            result = result + "\\\\"
        } 
        else if c == '\n' {
            result = result + "\\n"
        } 
        else if c == '\t' {
            result = result + "\\t"
        } 
        else if c == '\r' {
            result = result + "\\r"
        } 
        else if c < 32 {
            // RFC 8259: all control chars MUST be escaped. Terminal streams
            // (ESC etc.) otherwise produce unparseable frames.
            let digits: string = "0123456789abcdef"
            result = result + "\\u00"
            result.push(digits[((c as i64) >> 4) & 15])
            result.push(digits[(c as i64) & 15])
        } 
        else {
            result.push(c)
        }
        i = i + 1
    }
    return result
}

// ---------------------------------------------------------------------------
// Reformatting: the JSON.stringify(v, null, n) knob.
//
// This reformats JSON TEXT instead of walking a parsed document, for two
// reasons. Fidelity: key order, escapes and number spelling (an id past 2^53,
// an exponent, a -0.0) survive byte for byte because no value is ever read back
// through an f64. Reach: one implementation serves every producer in the
// language: a parsed Json, a builder's build(), the jsonStringify builtin, a
// payload that arrived off a socket and was never parsed at all.

fn jsonFmtIsSpace(c: u8): bool {
    return c == ' ' || c == '\t' || c == '\n' || c == '\r'
}

// Index of the next non-whitespace byte at or after `i` (src.len if none).
fn jsonFmtSkipSpace(src: &string, i: i64): i64 {
    var j = i
    while j < src.len && jsonFmtIsSpace(src[j]) {
        j = j + 1
    }
    return j
}

fn jsonFmtNewline(out: &mut string, indent: i64, depth: i64) {
    out.push('\n')
    for _i in 0..(indent * depth) {
        out.push(' ')
    }
}

// Copy a string token verbatim from `i` (which must index its opening quote),
// returning the index just past its closing quote. Escapes are copied as a pair
// so a \" inside the string is never mistaken for the end of it.
fn jsonFmtCopyString(src: &string, i: i64, out: &mut string): i64 {
    var j = i
    out.push(src[j])
    j = j + 1
    while j < src.len {
        let c = src[j]
        out.push(c)
        j = j + 1
        if c == '\\' {
            if j < src.len {
                out.push(src[j])
                j = j + 1
            }
        } else if c == '"' {
            return j
        }
    }
    return j
}

// Re-render a JSON document. `indent` > 0 indents nested values by that many
// spaces per level, exactly as `JSON.stringify(v, null, indent)` does; `indent`
// <= 0 minifies, dropping every byte of whitespace outside a string.
//
// Text that does not start with '{' or '[' comes back unchanged: a bare scalar
// has nothing to indent, and text that is not JSON at all (a plain-text error
// line, an empty body) is not this function's to mangle.
pub fn jsonPretty(src: &string, indent: i64): string {
    let start = jsonFmtSkipSpace(src, 0)
    if start >= src.len {
        return src.clone()
    }
    let first = src[start]
    if first != '{' && first != '[' {
        return src.clone()
    }
    var out: string = ""
    var depth: i64 = 0
    var i = start
    while i < src.len {
        let c = src[i]
        if c == '"' {
            i = jsonFmtCopyString(src, i, &mut out)
        } else if jsonFmtIsSpace(c) {
            i = i + 1
        } else if c == '{' || c == '[' {
            let n = jsonFmtSkipSpace(src, i + 1)
            if n < src.len && (src[n] == '}' || src[n] == ']') {
                // An empty container stays on one line: "{}" split over two is
                // noise, and it is what every other pretty-printer emits.
                out.push(c)
                out.push(src[n])
                i = n + 1
            } else {
                depth = depth + 1
                out.push(c)
                if indent > 0 {
                    jsonFmtNewline(&mut out, indent, depth)
                }
                i = i + 1
            }
        } else if c == '}' || c == ']' {
            depth = depth - 1
            // Unbalanced input would otherwise indent by a negative count. The
            // reformatter is not a validator, so it clamps and keeps going.
            if depth < 0 {
                depth = 0
            }
            if indent > 0 {
                jsonFmtNewline(&mut out, indent, depth)
            }
            out.push(c)
            i = i + 1
        } else if c == ',' {
            out.push(c)
            if indent > 0 {
                jsonFmtNewline(&mut out, indent, depth)
            }
            i = i + 1
        } else if c == ':' {
            out.push(c)
            if indent > 0 {
                out.push(' ')
            }
            i = i + 1
        } else {
            out.push(c)
            i = i + 1
        }
    }
    return out
}

// ---------------------------------------------------------------------------
// Serialization — JsonVal value tree + fluent builders.
// Complements the flat-pool parser above: parse with jsonParse, build with
// jsonObj()/jsonArr(), serialize with .build() / jsonSer.
pub enum JsonVal {
    JNull,
    JBool(bool),
    JInt(i64),
    JFloat(f64),
    JStr(string),
    JArr(Vec<JsonVal>),
    JObj(Vec<JsonMember>),
    // Pre-serialized JSON spliced verbatim — the caller guarantees validity.
    // Lets builders compose with fragments produced elsewhere (other builders,
    // pass-through payloads) without a parse/rebuild round trip.
    JRaw(string),
}

pub struct JsonMember {
    key: string, val: JsonVal
}

pub fn jsonSer(v: &JsonVal): string {
    match v {
        JsonVal.JNull => {
            return "null"
        }
        JsonVal.JBool(b) => {
            if b {
                return "true"
            } else {
                return "false"
            }
        }
        JsonVal.JInt(n) => {
            return n.toString()
        }
        JsonVal.JFloat(f) => {
            return f.toString()
        }
        JsonVal.JStr(s) => {
            return "\"" + jsonEscapeStr(s) + "\""
        }
        JsonVal.JRaw(s) => {
            return s.clone()
        }
        JsonVal.JArr(items) => {
            var out = "["
            for i in 0..items.len {
                if i > 0 {
                    out = out + ","
                }
                out = out + jsonSer(items[i])
            }
            return out + "]"
        }
        JsonVal.JObj(members) => {
            var out = "{"
            for i in 0..members.len {
                if i > 0 {
                    out = out + ","
                }
                out = out + "\"" + jsonEscapeStr(members[i].key) + "\":" + jsonSer(members[i].val)
            }
            return out + "}"
        }
    }
}

// Fluent object builder. Methods consume and return self to enable chaining:
//   jsonObj().str("type", "capabilities").int("seq", 3).build()
pub struct JsonObj {
    members: Vec<JsonMember>
}

fn jsonObj(): JsonObj {
    return JsonObj {
        members: Vec.new()
    }
}

impl JsonObj {
    fn str(self: Self, key: string, val: string): Self {
        var m = self
        m.members.push(JsonMember {
            key: key, val: JsonVal.JStr(val)
        }
        )
        return m
    }
    fn int(self: Self, key: string, val: i64): Self {
        var m = self
        m.members.push(JsonMember {
            key: key, val: JsonVal.JInt(val)
        }
        )
        return m
    }
    fn float(self: Self, key: string, val: f64): Self {
        var m = self
        m.members.push(JsonMember {
            key: key, val: JsonVal.JFloat(val)
        }
        )
        return m
    }
    fn bool(self: Self, key: string, val: bool): Self {
        var m = self
        m.members.push(JsonMember {
            key: key, val: JsonVal.JBool(val)
        }
        )
        return m
    }
    fn nil(self: Self, key: string): Self {
        var m = self
        m.members.push(JsonMember {
            key: key, val: JsonVal.JNull
        }
        )
        return m
    }
    fn obj(self: Self, key: string, val: JsonObj): Self {
        var m = self
        m.members.push(JsonMember {
            key: key, val: JsonVal.JObj(val.members)
        }
        )
        return m
    }
    fn arr(self: Self, key: string, val: JsonArr): Self {
        var m = self
        m.members.push(JsonMember {
            key: key, val: JsonVal.JArr(val.items)
        }
        )
        return m
    }
    fn val(self: Self, key: string, val: JsonVal): Self {
        var m = self
        m.members.push(JsonMember {
            key: key, val: val
        }
        )
        return m
    }
    // Splice a pre-serialized JSON value verbatim (caller guarantees validity).
    fn raw(self: Self, key: string, json: string): Self {
        var m = self
        m.members.push(JsonMember {
            key: key, val: JsonVal.JRaw(json)
        }
        )
        return m
    }
    // Optional-field helpers: add the key only when the Option is Some, so a
    // conditional field stays inside the fluent chain instead of breaking out
    // to an `if` around each call.
    fn strOpt(self: Self, key: string, val: Option<string>): Self {
        var m = self
        match val {
            Option.Some(v) => {
                m.members.push(JsonMember {
                    key: key, val: JsonVal.JStr(v)
                }
                )
            }
            Option.None => {
            }
        }
        return m
    }
    fn intOpt(self: Self, key: string, val: Option<i64>): Self {
        var m = self
        match val {
            Option.Some(v) => {
                m.members.push(JsonMember {
                    key: key, val: JsonVal.JInt(v)
                }
                )
            }
            Option.None => {
            }
        }
        return m
    }
    fn floatOpt(self: Self, key: string, val: Option<f64>): Self {
        var m = self
        match val {
            Option.Some(v) => {
                m.members.push(JsonMember {
                    key: key, val: JsonVal.JFloat(v)
                }
                )
            }
            Option.None => {
            }
        }
        return m
    }
    fn boolOpt(self: Self, key: string, val: Option<bool>): Self {
        var m = self
        match val {
            Option.Some(v) => {
                m.members.push(JsonMember {
                    key: key, val: JsonVal.JBool(v)
                }
                )
            }
            Option.None => {
            }
        }
        return m
    }
    fn build(self: &Self): string {
        var out = "{"
        for i in 0..self.members.len {
            if i > 0 {
                out = out + ","
            }
            out = out + "\"" + jsonEscapeStr(self.members[i].key) + "\":" + jsonSer(self.members[i].val)
        }
        return out + "}"
    }

    // build() with `indent` spaces per nesting level (0 or less minifies).
    fn buildPretty(self: &Self, indent: i64): string {
        let compact = self.build()
        return jsonPretty(compact, indent)
    }
}

// Fluent array builder:
//   jsonArr().str("a").int(2).obj(jsonObj().bool("ok", true)).build()
pub struct JsonArr {
    items: Vec<JsonVal>
}

fn jsonArr(): JsonArr {
    return JsonArr {
        items: Vec.new()
    }
}

impl JsonArr {
    fn str(self: Self, val: string): Self {
        var m = self
        m.items.push(JsonVal.JStr(val))
        return m
    }
    fn int(self: Self, val: i64): Self {
        var m = self
        m.items.push(JsonVal.JInt(val))
        return m
    }
    fn float(self: Self, val: f64): Self {
        var m = self
        m.items.push(JsonVal.JFloat(val))
        return m
    }
    fn bool(self: Self, val: bool): Self {
        var m = self
        m.items.push(JsonVal.JBool(val))
        return m
    }
    fn nil(self: Self): Self {
        var m = self
        m.items.push(JsonVal.JNull)
        return m
    }
    fn obj(self: Self, val: JsonObj): Self {
        var m = self
        m.items.push(JsonVal.JObj(val.members))
        return m
    }
    fn arr(self: Self, val: JsonArr): Self {
        var m = self
        m.items.push(JsonVal.JArr(val.items))
        return m
    }
    fn val(self: Self, val: JsonVal): Self {
        var m = self
        m.items.push(val)
        return m
    }
    // Splice a pre-serialized JSON value verbatim (caller guarantees validity).
    fn raw(self: Self, json: string): Self {
        var m = self
        m.items.push(JsonVal.JRaw(json))
        return m
    }
    fn build(self: &Self): string {
        var out = "["
        for i in 0..self.items.len {
            if i > 0 {
                out = out + ","
            }
            out = out + jsonSer(self.items[i])
        }
        return out + "]"
    }

    // build() with `indent` spaces per nesting level (0 or less minifies).
    fn buildPretty(self: &Self, indent: i64): string {
        let compact = self.build()
        return jsonPretty(compact, indent)
    }
}

// ── Streaming pull parser ──────────────────────────────────────────────────
// Emits one event at a time and never materializes the tree — O(depth) memory,
// for documents too large to hold as a flat pool (cf. Go json.Decoder.Token /
// Rust StreamDeserializer). jsonPull(src).next() yields tokens until End.
pub enum JsonEvent {
    StartObject,
    EndObject,
    StartArray,
    EndArray,
    Key,
    Str,
    Num,
    Bool,
    Null,
    End,
    Error,
}

pub struct JsonToken {
    kind: JsonEvent,
    text: string, // set for Key and Str
    num: f64, // set for Num
    flag: bool, // set for Bool
}

fn jsonTok(k: JsonEvent): JsonToken {
    return JsonToken {
        kind: k, text: "", num: 0.0, flag: false
    }
}

// Container stack entries: 0 = array, 1 = object expecting key, 2 = object
// expecting value. The colon/comma transitions flip 1<->2 so a string can be
// classified as Key vs Str without lookahead.
pub struct JsonPull {
    src: string,
    pos: i64,
    stack: Vec<i64>,
}

pub fn jsonPull(src: string): JsonPull {
    return JsonPull {
        src: src, pos: 0, stack: Vec.new()
    }
}

// Standalone number → f64 (int . frac e exp), advancing pos past the literal.
// The flat-pool parser's jsonParseNumber is node-coupled, so the scan is inlined.
fn jsonPullNumber(s: &string, pos: &mut i64): f64 {
    var result: f64 = 0.0
    var negative: bool = false
    if pos < s.len && s[pos] == '-' {
        negative = true
        pos = pos + 1
    }
    while pos < s.len && s[pos] >= '0' && s[pos] <= '9' {
        result = result * 10.0 + (s[pos] as i32 - 48) as f64
        pos = pos + 1
    }
    if pos < s.len && s[pos] == '.' {
        pos = pos + 1
        var frac: f64 = 0.1
        while pos < s.len && s[pos] >= '0' && s[pos] <= '9' {
            result = result + (s[pos] as i32 - 48) as f64 * frac
            frac = frac * 0.1
            pos = pos + 1
        }
    }
    if pos < s.len && (s[pos] == 'e' || s[pos] == 'E') {
        pos = pos + 1
        var expNeg: bool = false
        if pos < s.len && s[pos] == '+' {
            pos = pos + 1
        } else if pos < s.len && s[pos] == '-' {
            expNeg = true
            pos = pos + 1
        }
        var exp: i64 = 0
        while pos < s.len && s[pos] >= '0' && s[pos] <= '9' {
            exp = exp * 10 + (s[pos] as i32 - 48) as i64
            pos = pos + 1
        }
        var scale: f64 = 1.0
        var i: i64 = 0
        while i < exp {
            scale = scale * 10.0
            i = i + 1
        }
        if expNeg {
            result = result / scale
        } else {
            result = result * scale
        }
    }
    if negative {
        result = 0.0 - result
    }
    return result
}

impl JsonPull {
    fn next(self: &mut Self): JsonToken {
        while true {
            jsonSkipWs(self.src, &mut self.pos)
            if self.pos >= self.src.len {
                return jsonTok(JsonEvent.End)
            }
            let c = self.src[self.pos]
            if c == '{' {
                self.pos = self.pos + 1
                self.stack.push(1)
                return jsonTok(JsonEvent.StartObject)
            }
            if c == '}' {
                self.pos = self.pos + 1
                if self.stack.len > 0 {
                    self.stack.pop()!
                }
                return jsonTok(JsonEvent.EndObject)
            }
            if c == '[' {
                self.pos = self.pos + 1
                self.stack.push(0)
                return jsonTok(JsonEvent.StartArray)
            }
            if c == ']' {
                self.pos = self.pos + 1
                if self.stack.len > 0 {
                    self.stack.pop()!
                }
                return jsonTok(JsonEvent.EndArray)
            }
            if c == ',' {
                self.pos = self.pos + 1
                if self.stack.len > 0 && self.stack[self.stack.len - 1] == 2 {
                    self.stack[self.stack.len - 1] = 1
                }
                continue
            }
            if c == ':' {
                self.pos = self.pos + 1
                if self.stack.len > 0 && self.stack[self.stack.len - 1] == 1 {
                    self.stack[self.stack.len - 1] = 2
                }
                continue
            }
            if c == '"' {
                var strStart: i64 = 0
                var strLen: i64 = 0
                var strErr: bool = false
                jsonScanStringRange(self.src, &mut self.pos, &mut strStart, &mut strLen, &mut strErr)
                var t = jsonTok(JsonEvent.Str)
                // in an object at a key slot (state 1) the string is the key
                if self.stack.len > 0 && self.stack[self.stack.len - 1] == 1 {
                    t = jsonTok(JsonEvent.Key)
                }
                t.text = jsonMaterializeStr(self.src, strStart, strLen)
                return t
            }
            if c == 't' {
                self.pos = self.pos + 4
                var t = jsonTok(JsonEvent.Bool)
                t.flag = true
                return t
            }
            if c == 'f' {
                self.pos = self.pos + 5
                var t = jsonTok(JsonEvent.Bool)
                t.flag = false
                return t
            }
            if c == 'n' {
                self.pos = self.pos + 4
                return jsonTok(JsonEvent.Null)
            }
            if c == '-' || (c >= '0' && c <= '9') {
                var t = jsonTok(JsonEvent.Num)
                t.num = jsonPullNumber(self.src, &mut self.pos)
                return t
            }
            return jsonTok(JsonEvent.Error)
        }
        return jsonTok(JsonEvent.Error)
    }
}

// ---------------------------------------------------------------------------
// Typed decode errors and the runtime half of @derive(Json)
//
// The generated toJson/fromJson methods call only the names below plus the
// cursor API above. Nothing here is derive-only — hand-written decoders are
// welcome to reuse it.

// Where a decode failed and what was found instead. `expected` and `actual`
// share one vocabulary: null, bool, number, string, array, object, "missing".
pub struct JsonMismatch {
    path: string,
    expected: string,
    actual: string,
}

pub enum JsonError {
    // The text was not JSON at all — the parser's own message. Path is empty.
    Syntax(string),
    // A required field was absent. Payload is the dotted path.
    Missing(string),
    // A value was present at the path but of the wrong JSON kind.
    Mismatch(JsonMismatch),
}

// Prefix `rest` with one path segment. Array indices already carry their own
// brackets, so they abut rather than take a dot: ("friends", "[3].city").
fn jsonPathJoin(seg: string, rest: &string): string {
    if rest.len == 0 {
        return seg
    }
    if rest[0] == '[' {
        return seg + rest
    }
    return seg + "." + rest
}

// Human-readable name for a `curKind` result, including -1 for "no such node".
pub fn jsonKindName(kind: i32): string {
    if kind == 0 {
        return "null"
    }
    if kind == 1 {
        return "bool"
    }
    if kind == 2 {
        return "number"
    }
    if kind == 3 {
        return "string"
    }
    if kind == 4 {
        return "array"
    }
    if kind == 5 {
        return "object"
    }
    return "missing"
}

impl JsonError {
    // Dotted path to the offending value, "" for a syntax error.
    fn path(self: &Self): string {
        match self {
            JsonError.Syntax(_m) => {
                return ""
            }
            JsonError.Missing(p) => {
                return p.clone()
            }
            JsonError.Mismatch(m) => {
                return m.path.clone()
            }
        }
    }

    fn message(self: &Self): string {
        match self {
            JsonError.Syntax(m) => {
                return "invalid JSON: " + m
            }
            JsonError.Missing(p) => {
                return "missing field '" + p + "'"
            }
            JsonError.Mismatch(m) => {
                if m.path.len == 0 {
                    return "document root: expected " + m.expected + ", got " + m.actual
                }
                return "field '" + m.path + "': expected " + m.expected + ", got " + m.actual
            }
        }
    }

    // Re-root the error one level up. Decoders build paths bottom-up so the
    // success path never allocates a path string.
    fn under(self: JsonError, seg: string): JsonError {
        match self {
            JsonError.Syntax(m) => {
                return JsonError.Syntax(m)
            }
            JsonError.Missing(p) => {
                return JsonError.Missing(jsonPathJoin(seg, p))
            }
            JsonError.Mismatch(m) => {
                return JsonError.Mismatch(JsonMismatch {
                    path: jsonPathJoin(seg, m.path), expected: m.expected, actual: m.actual
                }
                )
            }
        }
    }

    fn underIndex(self: JsonError, index: i64): JsonError {
        return self.under("[" + index.toString() + "]")
    }
}

// Quote and escape a string as a JSON string literal, brackets included.
pub fn jsonQuote(s: &string): string {
    return "\"" + jsonEscapeStr(s) + "\""
}

// `true`/`false` as JSON text.
pub fn jsonBoolStr(b: bool): string {
    if b {
        return "true"
    }
    return "false"
}
