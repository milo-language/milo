// std/openssl — the OpenSSL binding: the extern declarations and the green-aware
// handshake/read/write loops that std/fetch (client), std/tls (server) and std/ws use.
//
// Its own leaf module, not part of std/os, because std/os is the libc module every
// program reaches for `malloc`. With these 22 externs in std/os, every module that
// imported it for memory dragged the SSL symbols in; at -O2 they were dead-stripped, at
// -O0 they were not, and on a platform with no OpenSSL in the sysroot (Windows) the link
// failed naming symbols the program never mentioned. A module that never says TLS now
// never references libssl.

from "std/runtime" import {
    schedulerCurrent, schedulerWaitRead, schedulerWaitWrite
}
from "std/replay" import {
    replayOff, replayBlob, replayInts
}

pub extern fn TLS_client_method(): *u8

pub extern fn SSL_CTX_new(method: *u8): *u8

pub extern fn SSL_CTX_free(ctx: *u8): void

pub extern fn SSL_CTX_set_default_verify_paths(ctx: *u8): i32

// Loading the trust store (above) is NOT verification — an OpenSSL client defaults to
// SSL_VERIFY_NONE, so the handshake completes against any certificate, self-signed
// included. SSL_VERIFY_PEER (mode 1) is what makes SSL_connect fail on an untrusted
// chain. Pass a null callback to keep OpenSSL's own verdict.
pub extern fn SSL_CTX_set_verify(ctx: *u8, mode: i32, callback: *u8): void

// Binds the peer certificate to an expected hostname. SNI (SSL_ctrl 55) only tells the
// server which cert to send — it checks nothing on the way back — so without this a
// valid certificate for ANY host satisfies the handshake. OpenSSL 1.1.0+.
pub extern fn SSL_set1_host(ssl: *u8, hostname: *u8): i32

// X509_V_OK == 0. Belt-and-braces after a handshake: with SSL_VERIFY_PEER set this
// cannot report failure (SSL_connect would already have failed), but it is the check
// that makes the guarantee explicit rather than implied by a mode constant.
pub extern fn SSL_get_verify_result(ssl: *u8): i64

pub extern fn SSL_new(ctx: *u8): *u8

pub extern fn SSL_set_fd(ssl: *u8, fd: i32): i32

pub extern fn SSL_connect(ssl: *u8): i32

pub extern fn SSL_read(ssl: *u8, buf: *u8, num: i32): i32

pub extern fn SSL_write(ssl: *u8, buf: *u8, num: i32): i32

pub extern fn SSL_free(ssl: *u8): void

pub extern fn SSL_ctrl(ssl: *u8, cmd: i32, larg: i64, parg: *u8): i64

pub extern fn SSL_get_error(ssl: *u8, ret: i32): i32

pub extern fn ERR_clear_error(): void

// ── server side ──

pub extern fn TLS_server_method(): *u8

pub extern fn SSL_CTX_use_certificate_chain_file(ctx: *u8, file: *u8): i32

// fileType is SSL_FILETYPE_PEM (1) or SSL_FILETYPE_ASN1 (2) — there is no
// "detect from the bytes" mode, so a PEM key handed the ASN1 constant fails to load.
pub extern fn SSL_CTX_use_PrivateKey_file(ctx: *u8, file: *u8, fileType: i32): i32

// Both files load independently, so a cert/key pair that does not belong together is
// accepted until this is called. Without it the mismatch first shows up as a handshake
// failure on every client, with nothing on the server naming the cause.
pub extern fn SSL_CTX_check_private_key(ctx: *u8): i32

// Adds a CA file/dir to the trust store. Either argument may be null.
pub extern fn SSL_CTX_load_verify_locations(ctx: *u8, caFile: *u8, caPath: *u8): i32

pub extern fn SSL_accept(ssl: *u8): i32

// Sends close_notify. Skipping it makes a peer see a truncated stream rather than a
// clean EOF, which OpenSSL clients report as an "unexpected eof" error.
pub extern fn SSL_shutdown(ssl: *u8): i32

// ── green-aware TLS IO ──
// SSL_* on a nonblocking fd reports WANT_READ/WANT_WRITE; these park the
// green task until the fd is ready and retry. On a plain OS thread (blocking
// fd) the WANT codes never occur and these reduce to one SSL call.
//
// Every SSL_* call here is preceded by ERR_clear_error(). OpenSSL's error queue is
// per OS thread, and every green task shares that thread: an entry another
// connection left behind makes SSL_get_error report a fatal SSL_ERROR_SSL instead of
// WANT_READ, and the read loop then ends the body early. Concurrent fetches came
// back truncated at random record boundaries.
fn sslWantRead(): i32 {
    return 2
}

fn sslWantWrite(): i32 {
    return 3
}

// After an SSL_* call on a green task returned `r` and SSL_get_error said `e`: park on
// the direction OpenSSL is waiting for and return true to retry, or false when the
// error is final.
fn sslParkForRetry(e: i32, fd: i32): bool {
    unsafe {
        if e == sslWantRead() {
            schedulerWaitRead(fd)
            return true
        }
        if e == sslWantWrite() {
            schedulerWaitWrite(fd)
            return true
        }
        return false
    }
}

// One SSL_* attempt: its return value, and SSL_get_error's verdict when it is not a
// success. OpenSSL does its own socket IO, so under MILO_RECORD each attempt is a
// tls.* record (the plaintext a read returned, or the return value and verdict), and
// under MILO_REPLAY the answer comes from the trace with no handshake and no socket.
struct SslStep {
    r: i32,
    e: i32,
}

@replayHooked
fn sslStep(kind: string, arg: string, ssl: *u8, success: i32, live: () => i32): SslStep {
    if replayOff() {
        unsafe { ERR_clear_error() }
        let r = live()
        var e: i32 = 0
        if r != success {
            unsafe { e = SSL_get_error(ssl, r) }
        }
        return SslStep {
            r: r, e: e
        }
    }
    let v = replayInts(replayBlob(kind, arg, (): string => {
        unsafe { ERR_clear_error() }
        let r = live()
        var e: i32 = 0
        if r != success {
            unsafe { e = SSL_get_error(ssl, r) }
        }
        return r.toString() + " " + e.toString()
    }))
    return SslStep {
        r: v[0] as i32, e: v[1] as i32
    }
}

// Drive SSL_connect to completion. Returns 1 on success (SSL_connect result otherwise).
@replayHooked
@unsafe
pub fn sslConnectFd(ssl: *u8, fd: i32): i32 {
    while true {
        let st = sslStep("tls.connect", fd.toString(), ssl, 1, (): i32 => {
            unsafe {
                return SSL_connect(ssl)
            }
        })
        if st.r == 1 {
            return 1
        }
        if schedulerCurrent() as i64 == 0 || !sslParkForRetry(st.e, fd) {
            return st.r
        }
    }
    return -1
}

// Drive SSL_accept to completion — the server-side mirror of sslConnectFd.
// Returns 1 on success (SSL_accept result otherwise).
@replayHooked
@unsafe
pub fn sslAcceptFd(ssl: *u8, fd: i32): i32 {
    while true {
        let st = sslStep("tls.accept", fd.toString(), ssl, 1, (): i32 => {
            unsafe {
                return SSL_accept(ssl)
            }
        })
        if st.r == 1 {
            return 1
        }
        if schedulerCurrent() as i64 == 0 || !sslParkForRetry(st.e, fd) {
            return st.r
        }
    }
    return -1
}

// One SSL_read attempt through the trace: `=` and the plaintext, or `!r e`.
@replayHooked
fn sslReadOnce(ssl: *u8, fd: i32, buf: *u8, len: i32): SslStep {
    if replayOff() {
        var n: i32 = 0
        var e: i32 = 0
        unsafe {
            ERR_clear_error()
            n = SSL_read(ssl, buf, len)
            if n <= 0 {
                e = SSL_get_error(ssl, n)
            }
        }
        return SslStep {
            r: n, e: e
        }
    }
    let p = replayBlob("tls.read", fd.toString() + " " + len.toString(), (): string => {
        var n: i32 = 0
        var e: i32 = 0
        unsafe {
            ERR_clear_error()
            n = SSL_read(ssl, buf, len)
            if n <= 0 {
                e = SSL_get_error(ssl, n)
            }
        }
        if n <= 0 {
            return "!" + n.toString() + " " + e.toString()
        }
        unsafe {
            return "=" + _bytesToString(buf, n as i64)
        }
    })
    if p.len() > 0 && p[0] == '=' {
        let n = p.len() - 1
        unsafe {
            for i in 0..n {
                buf[i] = p[i + 1]
            }
        }
        return SslStep {
            r: n as i32, e: 0
        }
    }
    let v = replayInts(p.substr(1, p.len()))
    return SslStep {
        r: v[0] as i32, e: v[1] as i32
    }
}

// One SSL_read. Returns bytes read (>0), or <=0 on close/error.
@unsafe
pub fn sslReadFd(ssl: *u8, fd: i32, buf: *u8, len: i32): i32 {
    while true {
        let st = sslReadOnce(ssl, fd, buf, len)
        if st.r > 0 {
            return st.r
        }
        if schedulerCurrent() as i64 == 0 || !sslParkForRetry(st.e, fd) {
            return st.r
        }
    }
    return -1
}

// One SSL_write (OpenSSL default writes all-or-WANT; no partial handling needed).
// Recorded as tls.write with the size; under replay nothing is sent.
@replayHooked
@unsafe
pub fn sslWriteFd(ssl: *u8, fd: i32, buf: *u8, len: i32): i32 {
    while true {
        let st = sslStep("tls.write", fd.toString() + " " + len.toString(), ssl, len, (): i32 => {
            unsafe {
                return SSL_write(ssl, buf, len)
            }
        })
        if st.r > 0 {
            return st.r
        }
        if schedulerCurrent() as i64 == 0 || !sslParkForRetry(st.e, fd) {
            return st.r
        }
    }
    return -1
}

// ── TLS IO that can give up ──
// The loops above park until the fd is ready, however long that takes. These hand each
// WANT_READ/WANT_WRITE to `wait(forRead)` instead, which returns false to give up (a
// deadline passed): they then return the SSL call's own result (<= 0). The fd must be
// nonblocking; they work the same on a green task and on a plain thread.

fn sslWaitFor(e: i32, wait: (bool) => bool): bool {
    if e == sslWantRead() {
        return wait(true)
    }
    if e == sslWantWrite() {
        return wait(false)
    }
    return false
}

// sslConnectFd through `wait`. 1 on success.
@unsafe
pub fn sslConnectFdWait(ssl: *u8, fd: i32, wait: (bool) => bool): i32 {
    while true {
        let st = sslStep("tls.connect", fd.toString(), ssl, 1, (): i32 => {
            unsafe {
                return SSL_connect(ssl)
            }
        })
        if st.r == 1 {
            return 1
        }
        if !sslWaitFor(st.e, wait) {
            return st.r
        }
    }
    return -1
}

// sslReadFd through `wait`: bytes read (> 0), or <= 0 on close, error or giving up.
@unsafe
pub fn sslReadFdWait(ssl: *u8, fd: i32, buf: *u8, len: i32, wait: (bool) => bool): i32 {
    while true {
        let st = sslReadOnce(ssl, fd, buf, len)
        if st.r > 0 {
            return st.r
        }
        if !sslWaitFor(st.e, wait) {
            return st.r
        }
    }
    return -1
}

// sslWriteAllFd through `wait`: `len`, or the failing SSL_write's result (<= 0).
@unsafe
pub fn sslWriteAllFdWait(ssl: *u8, fd: i32, buf: *u8, len: i64, wait: (bool) => bool): i64 {
    var sent: i64 = 0
    while sent < len {
        let chunk = sslChunk(len - sent)
        var at: *u8 = buf
        unsafe { at = (buf as i64 + sent) as *u8 }
        let from = at
        let st = sslStep("tls.write", fd.toString() + " " + chunk.toString(), ssl, chunk, (): i32 => {
            unsafe {
                return SSL_write(ssl, from, chunk)
            }
        })
        if st.r > 0 {
            sent += st.r as i64
            continue
        }
        if !sslWaitFor(st.e, wait) {
            return st.r as i64
        }
    }
    return sent
}

// The largest count one SSL_read or SSL_write takes: their length is a C int, and
// a 64-bit length cast to i32 wraps (2^32 + 5 bytes became a 5-byte write that
// reported success). Every std caller with an i64 length clamps through this.
pub fn sslChunk(len: i64): i32 {
    if len > 2147483647 {
        return 2147483647
    }
    if len < 0 {
        return 0
    }
    return len as i32
}

// Write all `len` bytes, in chunks SSL_write can take. Returns `len`, or the failing
// SSL_write's result (<= 0).
@unsafe
pub fn sslWriteAllFd(ssl: *u8, fd: i32, buf: *u8, len: i64): i64 {
    var sent: i64 = 0
    while sent < len {
        var n: i32 = 0
        unsafe {
            n = sslWriteFd(ssl, fd, (buf as i64 + sent) as *u8, sslChunk(len - sent))
        }
        if n <= 0 {
            return n as i64
        }
        sent += n as i64
    }
    return sent
}
