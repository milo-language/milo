// std/replay — deterministic record/replay of a program's nondeterministic inputs.
//
// Every std entry point that asks the OS something whose answer can differ between
// runs (the clock, entropy, the environment, argv, file/socket/subprocess IO, which
// green task the scheduler wakes) calls through here, and so does every extern call the
// compiler redirects (src/replay-externs.ts). With neither MILO_RECORD nor MILO_REPLAY
// set the hook is one global compare and the call goes straight to the OS. With
// MILO_RECORD=<file> each answer is appended to a trace; with MILO_REPLAY=<file> each
// call returns the next recorded answer instead, so the program computes exactly what it
// computed when recorded. Format, kinds and phases: docs/record-replay.md.
//
// The mode is decided once, at process start (a global initializer), and both
// variables are then removed from this process's environment: a child process that
// inherited MILO_RECORD would truncate and interleave into the parent's trace.

@!replayHooked

from "std/os" import {
    getenv, fflush, malloc, free, realloc, memcpy
}
from "std/platform" import {
    open, read, write, close, lseek, sockRead, sockWrite, envUnset, oReadBinary, oWriteCreateTrunc,
    getErrno, setErrno, netErrno, setNetErrno, atExit, exitNow, debugTrap, usleep,
    envSet, aslrReexec, mmap, mprotect, protRead, protWrite, mapPrivate, mapAnon
}

// Bumped only when the record framing changes. A new record kind is additive: an
// older replayer meeting it reports a divergence naming the kind, which is the truth.
// So is a thread's record: `net.read@2` is net.read made on thread 2 (writeRecord).
let TRACE_VERSION: i64 = 1

// Divergence, a corrupt or missing trace, and a failed trace write all exit with this,
// so a driver (a test, dapweb's reverse step) can tell "replay broke" from the
// program's own failure codes 1 and 2.
pub let REPLAY_EXIT_CODE: i32 = 3

// How many consumed records a divergence report shows for context.
let RECENT_SHOWN: i64 = 6

// ── state ──
//
// One trace serves every OS thread. Each record carries the number of the thread that
// made it (0 is the main thread, which runs `main` and every green task; a thread std
// starts gets the next number when its parent records `thread.spawn`), and the trace
// order is the order the records were made. Under replay a thread answers its next call
// only when the record at the head of the trace is its own, so every thread sees the
// answers it saw when recorded AND in the same interleaving with the other threads. The
// sync primitives (std/sync) record each operation's outcome, so who got the lock, which
// message a receive took and what an atomic returned replay too. docs/record-replay.md
// §Threads.
//
// The shared state below is written only inside `rrLock.run`, which serializes every
// thread's access to the trace. Reads of rrMode outside it are safe: it is written once,
// while the process has a single thread, before any hook can run elsewhere.
//
// 0 = not decided yet, 1 = off, 2 = recording, 3 = replaying. A hook that runs before
// the global initializer (another module's initializer reading the clock) finds 0 and
// decides on the spot; after that every hooked call costs this one compare.
var rrMode: i64 = 0
var rrFd: i32 = -1
// Sequence number of the last record written or consumed; records count from 1.
var rrSeq: i64 = 0
// Replay reads the trace through a window: rrBuf holds bytes from the file not yet
// consumed (from rrPos on), refilled a chunk at a time, so memory is bounded by the
// largest record rather than the trace.
var rrBuf: string = ""
var rrPos: i64 = 0
var rrEof: bool = false
// The next record's header, once peeked (the scheduler peeks to tell an idle poll from
// a call; a waiting thread peeks to see whose turn it is).
var rrPeeked: bool = false
var rrNextSeq: i64 = 0
var rrNextKind: string = ""
var rrNextArgLen: i64 = 0
var rrNextPayloadLen: i64 = 0
var rrNextTid: i64 = 0
// The last RECENT_SHOWN records consumed, one line each, for divergence reports.
var rrRecent: string = ""
// MILO_REPLAY_STOP: the record at which replay calls miloReplayStop (0 = none).
var rrStopAt: i64 = 0
var rrStopPrint: bool = false
var rrStopCall: string = ""
// Set once replay is exiting with a divergence, so the exit hook stays quiet.
var rrFailing: bool = false
// Per fd: what it is ('f' file, 'n' socket, 'p' child pipe, 't' pty), which names its
// record kinds (fs.read, net.read, ...), and under replay whether the number is
// synthetic, handed out from the trace with no OS descriptor behind it.
var rrFdCat: string = ""
var rrFdSynth: string = ""
// Threads: how many have been numbered (main included), whether any other than main
// was ever started (sync operations are ordered only from then on), and per thread
// number a 1 once that thread has finished, so a replay waiting on a finished thread's
// record reports the divergence instead of waiting forever.
var rrThreads: i64 = 1
var rrThreaded: bool = false
var rrThreadDone: string = ""
// Unrecorded externs this run has called, one name per line; each is reported once.
var rrHoles: string = ""

// Per thread: its number, the scheduler polls it owes the trace (recording) or the trace
// owes it (replay), and whether it holds rrLock (so a divergence raised inside the lock
// can still run the exit hook).
thread_local var rrTid: i64 = 0
thread_local var rrIdle: i64 = 0
thread_local var rrPastEnd: i64 = 0
thread_local var rrHeld: bool = false
thread_local var rrBooting: bool = false
// The payload the last successful take on this thread consumed.
thread_local var rrTaken: string = ""

// The lock word behind rrLock. Only ever touched through atomics.
var rrLockWord: i64 = 0

// The one lock around the trace. A spin lock with a sleep, not a pthread mutex: it has
// to work before any initializer has run (a hook can fire from another module's global
// initializer), and the critical sections are a record's worth of work. Reentrant per
// thread, so a divergence reported while it is held can still run the exit hook.
// `@synchronized` tells the checker's thread pass that the shared state above, written
// only inside `run`, is not racing.
pub struct ReplayLock {
    _unused: i64,
}

impl ReplayLock {
    @synchronized
    fn run(self: &Self, f: () => void): void {
        if rrHeld {
            f()
            return
        }
        var spins: i64 = 0
        unsafe {
            while _atomicCasI64(rrLockWord.addrOf() as *u8, 0, 1) != 0 {
                spins += 1
                if spins > 64 {
                    usleep(20)
                }
            }
        }
        rrHeld = true
        f()
        rrHeld = false
        unsafe { _atomicStoreI64(rrLockWord.addrOf() as *u8, 0) }
    }
}

let rrLock: ReplayLock = ReplayLock { _unused: 0 }
// Last, so the state above is already initialized when this runs.
let rrBooted: bool = replayModeNow() > 0

// True when neither recording nor replaying. The single check every hook makes
// before touching the OS; a not-yet-decided mode reads as "not off" so the slow
// path gets to decide it.
pub fn replayOff(): bool {
    return rrMode == 1
}

// True when hooked calls must return recorded answers instead of asking the OS.
pub fn replayActive(): bool {
    return replayModeNow() == 3
}

// True when hooked calls append their answers to a trace.
pub fn replayRecording(): bool {
    return replayModeNow() == 2
}

fn replayModeNow(): i64 {
    if rrMode == 0 {
        // A hook reached while deciding (the ASLR restart asks the OS things) is off.
        if rrBooting {
            return 1
        }
        rrBooting = true
        rrLock.run((): void => {
            replayBoot()
        })
        rrBooting = false
    }
    return rrMode
}

fn replayFail(msg: string): void {
    rrLock.run((): void => {
        rrFailing = true
    })
    unsafe { fflush(0 as *u8) }
    eprint(msg)
    exit(REPLAY_EXIT_CODE)
}

fn envPath(name: string): string {
    unsafe {
        let p = getenv(name)
        if p as i64 == 0 {
            return ""
        }
        return _cstrToString(p)
    }
}

fn replayBoot(): void {
    if rrMode != 0 {
        return
    }
    let recordPath = envPath("MILO_RECORD")
    let replayPath = envPath("MILO_REPLAY")
    if recordPath.len() > 0 && replayPath.len() > 0 {
        replayFail("MILO_RECORD and MILO_REPLAY are both set; pick one")
    }
    if recordPath.len() == 0 && replayPath.len() == 0 {
        rrMode = 1
        return
    }
    aslrOff()
    heapStart()
    let stopAt = envPath("MILO_REPLAY_STOP")
    rrStopPrint = envPath("MILO_REPLAY_STOP_PRINT").len() > 0
    unsafe {
        envUnset("MILO_RECORD" as *u8)
        envUnset("MILO_REPLAY" as *u8)
        envUnset("MILO_REPLAY_STOP" as *u8)
        envUnset("MILO_REPLAY_STOP_PRINT" as *u8)
    }
    if recordPath.len() > 0 {
        startRecording(recordPath)
    } else {
        rrStopAt = decimal(stopAt)
        startReplay(replayPath)
    }
}

// ── addresses ──
//
// Values replay; addresses have to be made to. Two things move them between runs: ASLR
// (where the image, the stacks and the kernel's mappings land) and the allocator (libc's
// malloc places its regions at random, and the engine's own allocations differ between
// recording and replaying). So under either variable the process restarts once with ASLR
// off, and every allocation the program makes is served from a heap at a fixed address
// whose state depends only on the program's own allocations: std/replay's (and the hooks')
// allocations go to libc's malloc instead, by rrDepth. docs/record-replay.md §Addresses.

// argv as main received it, for the restart (miloReplayStart).
var rrArgv: *u8 = 0 as *u8

var rrAslrDone: bool = false

fn aslrOff(): void {
    if rrAslrDone {
        return
    }
    rrAslrDone = true
    // The restarted process finds the marker and goes on; anything else restarts.
    if envPath("MILO_RR_REEXEC").len() > 0 {
        unsafe { envUnset("MILO_RR_REEXEC" as *u8) }
        return
    }
    if rrArgv as i64 == 0 {
        return
    }
    var traced = false
    unsafe {
        envSet("MILO_RR_REEXEC" as *u8, "1" as *u8)
        traced = aslrReexec(rrArgv)
        envUnset("MILO_RR_REEXEC" as *u8)
    }
    if !traced {
        eprint("milo replay: warning: could not restart with ASLR off; addresses may differ between recording and replay")
    }
}

// Called first thing in main, before any global initializer: decides record/replay (so
// an initializer's allocations already come from the fixed heap) and restarts with ASLR
// off when needed, which must happen before the trace is opened.
//
// Only the restart and the heap happen here: the rest of the decision waits for
// std/replay's own initializer, because its state (the trace window, the fd tables) is
// set up by the global initializers that run after this.
@externalLinkage
pub fn miloReplayStart(argv: *u8): void {
    if envPath("MILO_RECORD").len() == 0 && envPath("MILO_REPLAY").len() == 0 {
        return
    }
    rrArgv = argv
    aslrOff()
    heapStart()
}

// The fixed heap: 16 regions, one per thread number (threads past 15 share the last),
// each served by its own size-class free lists, so a thread's allocations land where
// they landed when recorded whatever the other threads do. The top of a region holds
// page-granular blocks (green-task stacks, std/runtime).
let RR_HEAP_BASE: i64 = 35184372088832
let RR_REGION: i64 = 8589934592
let RR_PAGES_AT: i64 = 6442450944
let RR_CLASSES: i64 = 32
var rrHeapOn: i64 = 0
var rrHeapMapped: [i64; 16] = [0; 16]
var rrHeapBump: [i64; 16] = [0; 16]
var rrHeapPageBump: [i64; 16] = [0; 16]
var rrHeapLocks: [i64; 16] = [0; 16]
var rrHeapFree: [i64; 512] = [0; 512]
// Freed page blocks per region, as (address, length) pairs, reused by exact length.
var rrPageFreeAt: [i64; 512] = [0; 512]
var rrPageFreeLen: [i64; 512] = [0; 512]
// Nonzero while this thread runs std/replay or a recording hook: its allocations go to
// libc's malloc. Codegen raises and lowers it around every such fn (src/lower.ts).
thread_local var rrDepth: i64 = 0

fn heapStart(): void {
    if rrHeapOn != 0 || @targetOs() == "windows" {
        return
    }
    rrHeapOn = 1
    // This fn runs inside the engine, whose entry did not count while the heap was off.
    rrDepth = 1
}

fn heapRegion(): i64 {
    if rrTid > 15 {
        return 15
    }
    return rrTid
}

fn heapLock(r: i64): void {
    unsafe {
        let w = (rrHeapLocks as *i64 as i64 + r * 8) as *u8
        while _atomicCasI64(w, 0, 1) != 0 {
            usleep(1)
        }
    }
}

fn heapUnlock(r: i64): void {
    unsafe { _atomicStoreI64((rrHeapLocks as *i64 as i64 + r * 8) as *u8, 0) }
}

// Map region `r` at its fixed address on first use. False when the kernel will not
// place it there (something else already lives at that address).
fn heapMapRegion(r: i64): bool {
    unsafe {
        let slots = rrHeapMapped as *i64
        if slots[r] != 0 {
            return true
        }
        let want = RR_HEAP_BASE + r * RR_REGION
        // MAP_NORESERVE on Linux (no effect asked for on darwin, whose anonymous memory
        // is reserved lazily anyway).
        var extra: i32 = 0
        if @targetOs() == "linux" {
            extra = 16384
        }
        let got = mmap(want as *u8, RR_REGION, protRead() | protWrite(), mapPrivate() | mapAnon() | extra, -1, 0)
        if got as i64 != want {
            return false
        }
        slots[r] = 1
        return true
    }
}

fn heapInArena(p: *u8): bool {
    let a = p as i64
    return rrHeapOn != 0 && a >= RR_HEAP_BASE && a < RR_HEAP_BASE + 16 * RR_REGION
}

fn heapFail(): void {
    rrHeapOn = 0
    replayFail("record/replay: cannot place the fixed-address heap at 35184372088832 (0x200000000000): the address is taken")
}

fn heapAlloc(n: i64): *u8 {
    var c: i64 = 0
    while (16 << c) < n + 16 && c < RR_CLASSES - 1 {
        c += 1
    }
    let size: i64 = 16 << c
    if size < n + 16 {
        unsafe { return malloc(n) }
    }
    let r = heapRegion()
    heapLock(r)
    if !heapMapRegion(r) {
        heapUnlock(r)
        heapFail()
    }
    unsafe {
        let lists = rrHeapFree as *i64
        let bumps = rrHeapBump as *i64
        var blk = lists[r * RR_CLASSES + c]
        if blk != 0 {
            lists[r * RR_CLASSES + c] = (blk as *i64) [0]
        } else {
            if bumps[r] + size > RR_PAGES_AT {
                heapUnlock(r)
                // The region is spent: the rest of the run allocates from libc, and
                // says so once, since addresses past here may differ.
                return malloc(n)
            }
            blk = RR_HEAP_BASE + r * RR_REGION + bumps[r]
            bumps[r] = bumps[r] + size
        }
        let hdr = blk as *i64
        hdr[0] = c
        hdr[1] = r
        heapUnlock(r)
        return (blk + 16) as *u8
    }
}

fn heapFree(p: *u8): void {
    unsafe {
        let blk = p as i64 - 16
        let hdr = blk as *i64
        let c = hdr[0]
        let r = hdr[1]
        heapLock(r)
        let lists = rrHeapFree as *i64
        hdr[0] = lists[r * RR_CLASSES + c]
        lists[r * RR_CLASSES + c] = blk
        heapUnlock(r)
    }
}

// malloc, free and realloc for every allocation Milo code makes: codegen calls these in
// place of libc's when std/replay is in the program (src/codegen.ts). With neither
// variable set they are one compare in front of libc.
pub fn replayHeapMalloc(n: i64): *u8 {
    unsafe {
        if rrHeapOn == 0 || rrDepth > 0 {
            return malloc(n)
        }
    }
    return heapAlloc(n)
}

pub fn replayHeapFree(p: *u8): void {
    unsafe {
        if p as i64 == 0 {
            return
        }
        if !heapInArena(p) {
            free(p)
            return
        }
    }
    heapFree(p)
}

pub fn replayHeapRealloc(p: *u8, n: i64): *u8 {
    unsafe {
        if p as i64 == 0 {
            return replayHeapMalloc(n)
        }
        if !heapInArena(p) {
            return realloc(p, n)
        }
        let c = (p as i64 - 16) as *i64
        let room = (16 << c[0]) - 16
        if n <= room {
            return p
        }
        // A block grows within the heap it came from, whoever grows it.
        let q = heapAlloc(n)
        memcpy(q, p, room)
        heapFree(p)
        return q
    }
}

// Green tasks switch inside a thread, so the engine depth belongs to a context, not to
// the thread: std/runtime takes it out before a swapcontext and puts it back after.
pub fn replayHeapDepthOut(): i64 {
    let d = rrDepth
    rrDepth = 0
    return d
}

pub fn replayHeapDepthIn(d: i64): void {
    rrDepth = d
}

// Page-granular memory (a green task's stack) from the fixed heap, or null when the
// heap is off or this is the engine's own: the caller then maps it itself.
pub fn replayHeapMap(len: i64): *u8 {
    if rrHeapOn == 0 || rrDepth > 0 {
        return 0 as *u8
    }
    let r = heapRegion()
    let want = (len + 65535) / 65536 * 65536
    heapLock(r)
    if !heapMapRegion(r) {
        heapUnlock(r)
        heapFail()
    }
    unsafe {
        let at = rrPageFreeAt as *i64
        let lens = rrPageFreeLen as *i64
        for i in 0..32 {
            if at[r * 32 + i] != 0 && lens[r * 32 + i] == want {
                let p = at[r * 32 + i]
                at[r * 32 + i] = 0
                heapUnlock(r)
                // Its last user left a guard page protected, and darwin's makecontext
                // zeroes the whole stack before std/runtime protects it again.
                mprotect(p as *u8, want, protRead() | protWrite())
                return p as *u8
            }
        }
        let bumps = rrHeapPageBump as *i64
        if RR_PAGES_AT + bumps[r] + want > RR_REGION {
            heapUnlock(r)
            return 0 as *u8
        }
        let p = RR_HEAP_BASE + r * RR_REGION + RR_PAGES_AT + bumps[r]
        bumps[r] = bumps[r] + want
        heapUnlock(r)
        return p as *u8
    }
}

// Give back a block replayHeapMap handed out. False when `p` is not one (the caller
// unmaps it itself).
pub fn replayHeapUnmap(p: *u8, len: i64): bool {
    if !heapInArena(p) {
        return false
    }
    let r = (p as i64 - RR_HEAP_BASE) / RR_REGION
    let want = (len + 65535) / 65536 * 65536
    heapLock(r)
    unsafe {
        let at = rrPageFreeAt as *i64
        let lens = rrPageFreeLen as *i64
        for i in 0..32 {
            if at[r * 32 + i] == p as i64 {
                heapUnlock(r)
                return true
            }
        }
        for i in 0..32 {
            if at[r * 32 + i] == 0 {
                at[r * 32 + i] = p as i64
                lens[r * 32 + i] = want
                heapUnlock(r)
                return true
            }
        }
    }
    heapUnlock(r)
    return true
}

fn traceHeader(): string {
    return "milo-trace " + TRACE_VERSION.toString() + "\n"
}

fn startRecording(path: string): void {
    var fd: i32 = -1
    unsafe {
        let pathC = path.clone()
        fd = open(pathC as *u8, oWriteCreateTrunc(), 420)
    }
    if fd < 0 {
        replayFail("record: cannot create trace file " + path)
    }
    rrFd = fd
    rrMode = 2
    writeAll(traceHeader())
}

fn startReplay(path: string): void {
    var fd: i32 = -1
    unsafe {
        let pathC = path.clone()
        fd = open(pathC as *u8, oReadBinary())
    }
    if fd < 0 {
        replayFail("replay: cannot open trace file " + path)
    }
    rrFd = fd
    let header = traceHeader()
    fillTo(header.len())
    if rrBuf.len() < header.len() || !rrBuf.startsWith(header) {
        replayFail("replay: " + path + " is not a milo-trace version " + TRACE_VERSION.toString() + " file")
    }
    rrPos = header.len()
    rrMode = 3
    unsafe { atExit(replayAtExit as *u8) }
}

// ── trace writing ──

// One write per record, unbuffered: a program that crashes or exits mid-run still
// leaves every record it made on disk, which is the run worth replaying.
fn writeAll(s: string): void {
    var off: i64 = 0
    while off < s.len() {
        var n: i64 = 0
        unsafe {
            n = write(rrFd, (s as *u8 as i64 + off) as *u8, s.len() - off)
        }
        if n <= 0 {
            replayFail("record: write to trace file failed")
        }
        off += n
    }
}

fn callName(kind: &string, arg: &string): string {
    if arg.len() == 0 {
        return kind.clone()
    }
    return kind + "(" + arg + ")"
}

// `<seq> <kind>[@<thread>] <argLen> <payloadLen>`: a record made on a thread other than
// the main one names it after its kind, which keeps the framing (and every reader of
// it) unchanged, and leaves a single-threaded trace exactly as it always was.
fn writeRecord(kind: &string, arg: &string, payload: &string): void {
    rrSeq += 1
    var rec = String.withCapacity(40 + kind.len() + arg.len() + payload.len())
    rec.pushStr(rrSeq.toString())
    rec.push(' ')
    rec.pushStr(kind)
    if rrTid != 0 {
        rec.push('@')
        rec.pushStr(rrTid.toString())
    }
    rec.push(' ')
    rec.pushStr(arg.len().toString())
    rec.push(' ')
    rec.pushStr(payload.len().toString())
    rec.push('\n')
    rec.pushStr(arg)
    rec.push('\n')
    rec.pushStr(payload)
    rec.push('\n')
    writeAll(rec)
}

// Idle scheduler polls are owed to the trace before this thread's next record, so
// replay knows how many polls passed before it.
fn flushIdle(): void {
    if rrIdle > 0 {
        let n = rrIdle
        rrIdle = 0
        writeRecord("sched.idle", "", n.toString())
    }
}

// Append one record: `<seq> <kind> <argLen> <payloadLen>\n<arg>\n<payload>\n`.
// `arg` names the call (an env var name, a byte count) so replay can tell a
// different call of the same kind from the recorded one; `payload` is the answer.
// No-op unless recording.
pub fn replayPut(kind: &string, arg: &string, payload: &string): void {
    if replayModeNow() != 2 {
        return
    }
    rrLock.run((): void => {
        flushIdle()
        writeRecord(kind, arg, payload)
    })
}

// replayPut with a decimal payload.
pub fn replayPutI64(kind: &string, arg: &string, v: i64): void {
    replayPut(kind, arg, v.toString())
}

// ── trace reading ──

fn corrupt(seq: i64): void {
    replayFail("replay trace corrupt at record " + seq.toString())
}

// Make at least `n` unread bytes available past rrPos, unless the file ends first.
// Consumed bytes are dropped once they dominate the window.
fn fillTo(n: i64): void {
    if rrBuf.len() - rrPos >= n || rrEof {
        return
    }
    if rrPos > 65536 && rrPos * 2 > rrBuf.len() {
        rrBuf = rrBuf.substr(rrPos, rrBuf.len())
        rrPos = 0
    }
    var chunk: [u8; 65536] = [0; 65536]
    while rrBuf.len() - rrPos < n && !rrEof {
        var got: i64 = 0
        unsafe {
            got = read(rrFd, chunk as *u8, 65536)
        }
        if got <= 0 {
            rrEof = true
        } else {
            unsafe { rrBuf.pushStr(_bytesToString(chunk as *u8, got)) }
        }
    }
}

// The bytes up to the next newline, consuming it. None at a clean end of trace.
fn takeLine(seq: i64): Option<string> {
    var scanned: i64 = 0
    while true {
        var i = rrPos + scanned
        while i < rrBuf.len() {
            if rrBuf[i] == '\n' {
                let line = rrBuf.substr(rrPos, i)
                rrPos = i + 1
                return Option.Some(line)
            }
            i += 1
        }
        scanned = rrBuf.len() - rrPos
        if rrEof {
            if scanned == 0 {
                return Option.None
            }
            corrupt(seq)
        }
        fillTo(scanned + 4096)
    }
    return Option.None
}

fn decimal(s: &string): i64 {
    var v: i64 = 0
    var neg = false
    for i in 0..s.len() {
        let c = s[i]
        if i == 0 && c == '-' {
            neg = true
        } else if c >= '0' && c <= '9' {
            v = v * 10 + ((c - '0') as i64)
        }
    }
    if neg {
        return 0 - v
    }
    return v
}

// Read the next record's header line without consuming the record. False at the end
// of the trace.
fn peekHeader(): bool {
    if rrPeeked {
        return true
    }
    let seq = rrSeq + 1
    match takeLine(seq) {
        Option.None => {
            return false
        }
        Option.Some(line) => {
            let fields = line.split(" ")
            if fields.len != 4 || decimal(fields[0]) != seq {
                corrupt(seq)
            }
            rrNextSeq = seq
            rrNextKind = fields[1].clone()
            rrNextTid = 0
            match fields[1].indexOf("@") {
                Option.Some(at) => {
                    rrNextKind = fields[1].substr(0, at)
                    rrNextTid = decimal(fields[1].substr(at + 1, fields[1].len()))
                }
                Option.None => {
                }
            }
            rrNextArgLen = decimal(fields[2])
            rrNextPayloadLen = decimal(fields[3])
            rrPeeked = true
            return true
        }
    }
}

fn takeBytes(seq: i64, n: i64): string {
    fillTo(n + 1)
    if n < 0 || rrPos + n + 1 > rrBuf.len() || rrBuf[rrPos + n] != '\n' {
        corrupt(seq)
    }
    let out = rrBuf.substr(rrPos, rrPos + n)
    rrPos += n + 1
    return out
}

fn shortArg(arg: &string): string {
    var out = String.withCapacity(64)
    for i in 0..arg.len() {
        if i >= 60 {
            out.pushStr("...")
            break
        }
        let c = arg[i]
        if c < 32 || c > 126 {
            out.push('.')
        } else {
            out.push(c)
        }
    }
    return out
}

fn threadNote(tid: i64): string {
    if tid == 0 {
        return ""
    }
    return " [thread " + tid.toString() + "]"
}

fn noteConsumed(seq: i64, kind: &string, arg: &string, payloadLen: i64): void {
    rrSeq = seq
    rrPeeked = false
    let line = "  " + seq.toString() + " " + callName(kind, shortArg(arg)) + threadNote(rrTid) + " -> " + payloadLen.toString() + " bytes\n"
    rrRecent.pushStr(line)
    var lines: i64 = 0
    var i = rrRecent.len() - 1
    while i >= 0 {
        if rrRecent[i] == '\n' {
            lines += 1
            if lines > RECENT_SHOWN {
                rrRecent = rrRecent.substr(i + 1, rrRecent.len())
                break
            }
        }
        i -= 1
    }
    if seq == rrStopAt {
        replayStopHit(seq, callName(kind, shortArg(arg)))
    }
}

fn recentContext(): string {
    if rrRecent.len() == 0 {
        return ""
    }
    return "\nlast records replayed:\n" + rrRecent.substr(0, rrRecent.len() - 1)
}

// Exit with "replay diverged at record N: expected <recorded>, got <this run>",
// followed by the records consumed just before it.
fn diverge(seq: i64, expected: &string, got: &string): void {
    replayFail("replay diverged at record " + seq.toString() + ": expected " + expected + ", got " + got + recentContext())
}

// The head record's call, for a divergence report.
fn headCall(): string {
    let arg = takeBytes(rrNextSeq, rrNextArgLen)
    return callName(rrNextKind, shortArg(arg)) + threadNote(rrNextTid)
}

fn threadFinished(tid: i64): bool {
    return tid >= 0 && tid < rrThreadDone.len() && rrThreadDone[tid] == 1
}

// One attempt at this thread's next record. 1 when the head of the trace is this
// thread's and was consumed into `out`, 0 when another thread has the head.
fn tryTake(kind: &string, arg: &string): i64 {
    let seq = rrSeq + 1
    if rrIdle > 0 {
        diverge(seq, "sched.idle (" + rrIdle.toString() + " more scheduler polls)", callName(kind, arg) + threadNote(rrTid))
    }
    if !peekHeader() {
        diverge(seq, "end of trace", callName(kind, arg) + threadNote(rrTid))
    }
    if rrNextTid != rrTid {
        if threadFinished(rrNextTid) {
            diverge(seq, headCall(), "thread " + rrNextTid.toString() + " already finished (" + callName(kind, arg) + threadNote(rrTid) + " waiting)")
        }
        return 0
    }
    let recArg = takeBytes(seq, rrNextArgLen)
    if rrNextKind != kind || recArg != arg {
        diverge(seq, callName(rrNextKind, recArg) + threadNote(rrNextTid), callName(kind, arg) + threadNote(rrTid))
    }
    let payload = takeBytes(seq, rrNextPayloadLen)
    noteConsumed(seq, kind, arg, payload.len())
    rrTaken = payload
    return 1
}

// Under replay, a thread whose record is not at the head of the trace waits here for
// the threads whose records come first. Sleeps after a short spin: a turn is often
// only a record away, but another thread may be computing for a long time.
fn waitTurn(spins: i64): void {
    if spins > 32 {
        unsafe { usleep(50) }
    }
}

// The recorded answer to this call. Exits with "replay diverged at record N:
// expected <recorded call>, got <this call>" when the next record of this thread is a
// different call, or the trace has run out. With several threads, waits until this
// thread's record reaches the head of the trace.
pub fn replayTake(kind: &string, arg: &string): string {
    var got: i64 = 0
    var spins: i64 = 0
    while got == 0 {
        rrLock.run((): void => {
            got = tryTake(kind, arg)
        })
        if got == 0 {
            spins += 1
            waitTurn(spins)
        }
    }
    let taken = rrTaken.clone()
    rrTaken = ""
    return taken
}

// Replay: consume this thread's next record if it is `kind(arg)`, once it is this
// thread's turn. False, consuming nothing, when the next record is something else.
fn replayTakeIfNext(kind: &string, arg: &string): bool {
    var state: i64 = 0
    var spins: i64 = 0
    while state == 0 {
        rrLock.run((): void => {
            if !peekHeader() {
                state = 2
                return
            }
            if rrNextTid != rrTid {
                if threadFinished(rrNextTid) {
                    state = 2
                }
                return
            }
            if rrNextKind != kind || rrNextArgLen != arg.len() {
                state = 2
                return
            }
            // Compared in place, so a different note is left in the trace untouched.
            fillTo(rrNextArgLen + 1)
            if rrPos + rrNextArgLen > rrBuf.len() || rrBuf.substr(rrPos, rrPos + rrNextArgLen) != arg {
                state = 2
                return
            }
            let _ = takeBytes(rrNextSeq, rrNextArgLen)
            let p = takeBytes(rrNextSeq, rrNextPayloadLen)
            noteConsumed(rrNextSeq, kind, arg, p.len())
            state = 1
        })
        if state == 0 {
            spins += 1
            waitTurn(spins)
        }
    }
    return state == 1
}

// replayTake of a decimal payload.
pub fn replayTakeI64(kind: &string, arg: &string): i64 {
    return decimal(replayTake(kind, arg))
}

// ── stopping at a record ──

// The function a debugger breaks on to stop a replay at a chosen record: with
// MILO_REPLAY_STOP=<N>, replay calls it right after consuming record N, so the
// replaying program is stopped with record N's call just answered. External linkage
// keeps the symbol (`b miloReplayStop`); it then raises SIGTRAP, so a debugger
// attached without a breakpoint stops here too. With MILO_REPLAY_STOP_PRINT=1 it
// prints instead and the replay continues (for tests and a UI that only wants the
// position).
@externalLinkage
pub fn miloReplayStop(seq: i64): void {
    if rrStopPrint {
        eprint("replay: stop at record " + seq.toString() + ": " + rrStopCall)
        return
    }
    debugTrap()
}

fn replayStopHit(seq: i64, call: string): void {
    rrStopCall = call
    miloReplayStop(seq)
}

// ── clean exit ──

// Records left over when the program exits mean this run made fewer calls than the
// recorded one, which is a divergence like any other.
fn replayAtExit(): void {
    rrLock.run((): void => {
        atExitCheck()
    })
}

fn atExitCheck(): void {
    if rrMode != 3 || rrFailing {
        return
    }
    let seq = rrSeq + 1
    var expected = ""
    if rrIdle > 0 {
        expected = "sched.idle (" + rrIdle.toString() + " more scheduler polls)"
    } else if peekHeader() {
        let arg = takeBytes(seq, rrNextArgLen)
        let _ = takeBytes(seq, rrNextPayloadLen)
        expected = callName(rrNextKind, shortArg(arg)) + threadNote(rrNextTid)
        rrPeeked = false
    } else {
        return
    }
    var left: i64 = 1
    var going = true
    while going {
        match takeLine(seq) {
            Option.None => {
                going = false
            }
            Option.Some(line) => {
                let fields = line.split(" ")
                if fields.len != 4 {
                    going = false
                } else {
                    let _ = takeBytes(seq, decimal(fields[2]))
                    let _ = takeBytes(seq, decimal(fields[3]))
                    left += 1
                }
            }
        }
    }
    rrFailing = true
    unsafe { fflush(0 as *u8) }
    eprint("replay diverged at record " + seq.toString() + ": expected " + expected + ", got end of program (" + left.toString() + " records not replayed)" + recentContext())
    exitNow(REPLAY_EXIT_CODE)
}

// ── encodings shared by the hooks ──

// Strings joined with a NUL after each: the encoding for argv and the environment,
// whose entries are C strings and so can never contain one.
pub fn replayJoinNul(items: &Vec<string>): string {
    var out = String.withCapacity(64)
    for s in items {
        out.pushStr(s)
        out.push(0)
    }
    return out
}

// The inverse of replayJoinNul.
pub fn replaySplitNul(payload: &string): Vec<string> {
    var out: Vec<string> = Vec.new()
    var cur = String.withCapacity(16)
    for i in 0..payload.len() {
        let c = payload[i]
        if c == 0 {
            out.push(cur)
            cur = String.withCapacity(16)
        } else {
            cur.push(c)
        }
    }
    return out
}

// Replay: copy the recorded `n` bytes into `buf`. The byte count is the call's arg,
// so a request for a different count diverges instead of reading past the record.
pub fn replayTakeInto(kind: &string, buf: *u8, n: i64): void {
    let p = replayTake(kind, n.toString())
    unsafe {
        for i in 0..n {
            buf[i] = p[i]
        }
    }
}

// Record: the `n` bytes the OS just wrote into `buf`.
pub fn replayPutFrom(kind: &string, buf: *u8, n: i64): void {
    var p = String.withCapacity(n)
    unsafe {
        for i in 0..n {
            p.push(buf[i])
        }
    }
    replayPut(kind, n.toString(), p)
}

// A status-style result: the return value, then the errno when it is negative.
fn encodeRet(r: i64, err: i32): string {
    if r < 0 {
        return r.toString() + " " + err.toString()
    }
    return r.toString()
}

fn decodeRet(p: &string, net: bool): i64 {
    var sp: i64 = -1
    for i in 0..p.len() {
        if p[i] == ' ' && sp < 0 {
            sp = i
        }
    }
    if sp < 0 {
        return decimal(p)
    }
    let err = decimal(p.substr(sp + 1, p.len())) as i32
    if net {
        setNetErrno(err)
    } else {
        setErrno(err)
    }
    return decimal(p.substr(0, sp))
}

// Run a call that answers with a number (an fd, a status, an offset; negative with
// errno set on failure) through the trace: recorded with its errno, or answered from
// the trace with errno restored. `net` picks the socket error channel (WSAGetLastError
// on Windows). Callers check replayOff() first, so the closure costs nothing when off.
pub fn replayRet(kind: &string, arg: &string, net: bool, live: () => i64): i64 {
    if replayActive() {
        return decodeRet(replayTake(kind, arg), net)
    }
    let r = live()
    var err: i32 = 0
    if r < 0 {
        if net {
            err = netErrno()
        } else {
            err = getErrno()
        }
    }
    replayPut(kind, arg, encodeRet(r, err))
    // Writing the record is a syscall too; the caller reads errno after this returns.
    if r < 0 {
        if net {
            setNetErrno(err)
        } else {
            setErrno(err)
        }
    }
    return r
}

// Run a call that answers with arbitrary bytes the caller encodes itself (a stat
// result, a directory listing, a resolved address).
pub fn replayBlob(kind: &string, arg: &string, live: () => string): string {
    if replayActive() {
        return replayTake(kind, arg)
    }
    let p = live()
    replayPut(kind, arg, p)
    return p
}

// The space-separated decimals of a payload (several numbers in one answer).
pub fn replayInts(p: &string): Vec<i64> {
    var out: Vec<i64> = Vec.new()
    for f in p.split(" ") {
        out.push(decimal(f))
    }
    return out
}

// ── file descriptors ──

fn byteAt(table: &string, fd: i32): u8 {
    if fd < 0 || fd as i64 >= table.len() {
        return 0
    }
    return table[fd as i64]
}

fn setByte(table: &mut string, fd: i32, v: u8): void {
    if fd < 0 || fd > 1048576 {
        return
    }
    while table.len() <= fd as i64 {
        table.push(0)
    }
    unsafe {
        let p = table as *u8
        p[fd as i64] = v
    }
}

// Note an fd std just opened (or that replay just handed out) and what it is: 'f' a
// file, 'n' a socket, 'p' a child's pipe, 't' a pty. Under replay the number came from
// the trace and has no OS descriptor behind it.
pub fn replayFdOpened(fd: i32, cat: u8): void {
    if fd < 0 || rrMode < 2 {
        return
    }
    rrLock.run((): void => {
        setByte(&mut rrFdCat, fd, cat)
        if rrMode == 3 {
            setByte(&mut rrFdSynth, fd, 1)
        }
    })
}

// What std recorded `fd` as (see replayFdOpened), 0 when nothing.
pub fn replayFdCategory(fd: i32): u8 {
    var c: u8 = 0
    rrLock.run((): void => {
        c = byteAt(rrFdCat, fd)
    })
    return c
}

// True when `fd` is a replay-synthetic descriptor: every operation on it is answered
// from the trace, and the OS must never see the number.
pub fn replayFdSynthetic(fd: i32): bool {
    if rrMode != 3 {
        return false
    }
    var s = false
    rrLock.run((): void => {
        s = byteAt(rrFdSynth, fd) == 1
    })
    return s
}

// The record kind for `op` on `fd`: fs.read, net.write, proc.read, pty.read,
// stdin.read, stdout.write; fd.<op> for a descriptor std did not open.
fn fdKind(fd: i32, op: string): string {
    let cat = replayFdCategory(fd)
    if cat == 'f' {
        return "fs." + op
    }
    if cat == 'n' {
        return "net." + op
    }
    if cat == 'p' {
        return "proc." + op
    }
    if cat == 't' {
        return "pty." + op
    }
    if fd == 0 {
        return "stdin." + op
    }
    if fd == 1 {
        return "stdout." + op
    }
    if fd == 2 {
        return "stderr." + op
    }
    return "fd." + op
}

// One read(2) or recv through the trace. The payload is `=` and the bytes, or `!` and
// the errno (EAGAIN included: a green read that would block is recorded too, and the
// park that follows is what the scheduler records replay).
pub fn replayRead(fd: i32, buf: *u8, len: i64, socket: bool): i64 {
    let kind = fdKind(fd, "read")
    let arg = fd.toString() + " " + len.toString()
    if replayActive() {
        let p = replayTake(kind, arg)
        if p.len() == 0 {
            corrupt(rrSeq)
        }
        if p[0] == '!' {
            let err = decimal(p.substr(1, p.len())) as i32
            if socket {
                setNetErrno(err)
            } else {
                setErrno(err)
            }
            return -1
        }
        let n = p.len() - 1
        if n > len {
            corrupt(rrSeq)
        }
        unsafe {
            for i in 0..n {
                buf[i] = p[i + 1]
            }
        }
        return n
    }
    var n: i64 = 0
    unsafe {
        if socket {
            n = sockRead(fd, buf, len)
        } else {
            n = read(fd, buf, len)
        }
    }
    if n < 0 {
        var err: i32 = 0
        if socket {
            err = netErrno()
        } else {
            err = getErrno()
        }
        replayPut(kind, arg, "!" + err.toString())
        if socket {
            setNetErrno(err)
        } else {
            setErrno(err)
        }
        return n
    }
    var p = String.withCapacity(n + 1)
    p.push('=')
    unsafe { p.pushStr(_bytesToString(buf, n)) }
    replayPut(kind, arg, p)
    return n
}

// One write(2) or send through the trace: what is recorded is that it happened, to
// which fd, how many bytes were offered and how many went (or the errno). Under replay
// the write reaches the OS only for the inherited stdout and stderr, so the user sees
// the program's output; a write to a file, socket, pipe or pty is answered from the
// trace and never performed (the peer does not exist, and a replay must not change
// the filesystem).
pub fn replayWrite(fd: i32, buf: *u8, len: i64, socket: bool): i64 {
    let kind = fdKind(fd, "write")
    let arg = fd.toString() + " " + len.toString()
    if replayActive() {
        let n = decodeRet(replayTake(kind, arg), socket)
        if n > 0 && (fd == 1 || fd == 2) && !replayFdSynthetic(fd) {
            var off: i64 = 0
            while off < n {
                var w: i64 = 0
                unsafe { w = write(fd, (buf as i64 + off) as *u8, n - off) }
                if w <= 0 {
                    break
                }
                off += w
            }
        }
        return n
    }
    var n: i64 = 0
    unsafe {
        if socket {
            n = sockWrite(fd, buf, len)
        } else {
            n = write(fd, buf, len)
        }
    }
    var err: i32 = 0
    if n < 0 {
        if socket {
            err = netErrno()
        } else {
            err = getErrno()
        }
    }
    replayPut(kind, arg, encodeRet(n, err))
    if n < 0 {
        if socket {
            setNetErrno(err)
        } else {
            setErrno(err)
        }
    }
    return n
}

// open(2) through the trace. Under replay nothing is opened (a write-mode open does
// not create or truncate the file) and the recorded fd comes back as a synthetic one.
pub fn replayOpen(path: &string, flags: i32, mode: i32): i32 {
    let arg = flags.toString() + " " + path
    let fd = replayRet("fs.open", arg, false, (): i64 => {
        unsafe {
            return open(path, flags, mode) as i64
        }
    }) as i32
    replayFdOpened(fd, 'f')
    return fd
}

// close(2), unrecorded: when a program closes is deterministic given its inputs. A
// synthetic fd is only forgotten; the OS never had it.
pub fn replayClose(fd: i32): i32 {
    if fd < 0 {
        return -1
    }
    var synthetic = false
    rrLock.run((): void => {
        synthetic = rrMode == 3 && byteAt(rrFdSynth, fd) == 1
        setByte(&mut rrFdCat, fd, 0)
        setByte(&mut rrFdSynth, fd, 0)
    })
    if synthetic {
        return 0
    }
    unsafe { return close(fd) }
}

// lseek(2) through the trace: a file's size and position are answers from the OS.
pub fn replayLseek(fd: i32, off: i64, whence: i32): i64 {
    let arg = fd.toString() + " " + off.toString() + " " + whence.toString()
    return replayRet(fdKind(fd, "seek"), arg, false, (): i64 => {
        unsafe {
            return lseek(fd, off, whence)
        }
    })
}

// Lowercase hex of `n` raw bytes (socket addresses in a record's arg).
pub fn replayHex(p: *u8, n: i64): string {
    let digits = "0123456789abcdef"
    var out = String.withCapacity(n * 2)
    unsafe {
        for i in 0..n {
            let b = p[i]
            out.push(digits[(b >> 4) as i64])
            out.push(digits[(b & 15) as i64])
        }
    }
    return out
}

// ── scheduler ──

// Recording: one green-scheduler poll's outcome (std/runtime: pollAndWake). An empty
// payload is a poll that woke nothing and only bumps a counter; anything else is a
// sched.pick record naming the fds that came ready and the timer arms that fired.
pub fn replaySchedPut(payload: &string): void {
    if rrMode != 2 {
        return
    }
    if payload.len() == 0 {
        rrIdle += 1
        return
    }
    rrLock.run((): void => {
        flushIdle()
        writeRecord("sched.pick", "", payload)
    })
}

// One attempt at a scheduler poll's record: 1 with `out` set when answered (an idle
// poll answers ""), 0 when another thread has the head of the trace.
fn trySchedTake(): i64 {
    rrTaken = ""
    if rrIdle > 0 {
        rrIdle -= 1
        return 1
    }
    if !peekHeader() {
        // Trailing idle polls are legitimate (the recorded run's were never written),
        // but a replay that keeps polling past the trace is waiting for an event the
        // recording never had.
        rrPastEnd += 1
        if rrPastEnd > 1000000 {
            diverge(rrSeq + 1, "end of trace", "a scheduler poll still waiting for an event" + threadNote(rrTid))
        }
        return 1
    }
    let seq = rrNextSeq
    if rrNextTid != rrTid {
        if threadFinished(rrNextTid) {
            diverge(seq, headCall(), "thread " + rrNextTid.toString() + " already finished (a scheduler poll" + threadNote(rrTid) + " waiting)")
        }
        return 0
    }
    if rrNextKind == "sched.idle" {
        let _ = takeBytes(seq, rrNextArgLen)
        let p = takeBytes(seq, rrNextPayloadLen)
        noteConsumed(seq, "sched.idle", "", p.len())
        rrIdle = decimal(p) - 1
        return 1
    }
    if rrNextKind == "sched.pick" {
        let _ = takeBytes(seq, rrNextArgLen)
        let p = takeBytes(seq, rrNextPayloadLen)
        noteConsumed(seq, "sched.pick", "", p.len())
        rrTaken = p
        return 1
    }
    let arg = takeBytes(seq, rrNextArgLen)
    diverge(seq, callName(rrNextKind, arg), "a scheduler poll" + threadNote(rrTid))
    return 1
}

// Replay: what the poll at this point woke when recorded ("" for nothing). A poll
// past the end of the trace is idle: the recorded run's trailing idle polls were
// never written.
pub fn replaySchedTake(): string {
    var got: i64 = 0
    var spins: i64 = 0
    while got == 0 {
        rrLock.run((): void => {
            got = trySchedTake()
        })
        if got == 0 {
            spins += 1
            waitTurn(spins)
        }
    }
    let taken = rrTaken.clone()
    rrTaken = ""
    return taken
}

// ── threads ──

// Called where std starts an OS thread, before it starts: numbers the new thread and
// records that it was started (`thread.spawn`, payload the number), so the numbering
// replays. From here on every sync operation is ordered. Returns 0 when off.
pub fn replayThreadSpawn(): i64 {
    if replayOff() {
        return 0
    }
    var tid: i64 = 0
    if replayActive() {
        tid = replayTakeI64("thread.spawn", "")
        rrLock.run((): void => {
            if tid + 1 > rrThreads {
                rrThreads = tid + 1
            }
            rrThreaded = true
        })
        return tid
    }
    rrLock.run((): void => {
        tid = rrThreads
        rrThreads += 1
        rrThreaded = true
        flushIdle()
        writeRecord("thread.spawn", "", tid.toString())
    })
    return tid
}

// First thing on a thread std started: take the number its parent recorded.
pub fn replayThreadStart(tid: i64): void {
    rrTid = tid
}

// Last thing on a thread std started. Under replay a thread waiting for a finished
// thread's record is then a divergence, not a hang.
pub fn replayThreadExit(): void {
    if rrMode < 2 || rrTid == 0 {
        return
    }
    rrLock.run((): void => {
        flushIdle()
        while rrThreadDone.len() <= rrTid {
            rrThreadDone.push(0)
        }
        unsafe {
            let p = rrThreadDone as *u8
            p[rrTid] = 1
        }
    })
}

// True when cross-thread sync operations are ordered: recording or replaying a run that
// has started an OS thread. Before the first thread exists every sync operation happens
// on the main thread, whose order the scheduler records already.
pub fn replaySyncOn(): bool {
    return rrMode >= 2 && rrThreaded
}

// Replay: wait until this thread's next record is at the head of the trace. std/sync
// calls it before taking a primitive's own lock, so the operation runs exactly when it
// ran in the recording, after every operation recorded before it. No-op when recording.
pub fn replaySyncEnter(): void {
    if rrMode != 3 {
        return
    }
    var ready = false
    var spins: i64 = 0
    while !ready {
        rrLock.run((): void => {
            if !peekHeader() || rrNextTid == rrTid || threadFinished(rrNextTid) {
                ready = true
            }
        })
        if !ready {
            spins += 1
            waitTurn(spins)
        }
    }
}

// One ordered sync operation, made while the primitive's lock is held: what it did
// (`op`, e.g. "recv") and how it came out (`outcome`: ready or not, the value an atomic
// returned). Recorded as `sync.<op>` with both in the arg; under replay the same
// operation must come out the same way, or the run has diverged.
pub fn replaySyncNote(op: &string, outcome: i64): void {
    let kind = "sync." + op
    if rrMode == 3 {
        let _ = replayTake(kind, outcome.toString())
        return
    }
    replayPut(kind, outcome.toString(), "")
}

// One ordered atomic operation (std/sync's Atomic* types): `f` performs it and returns
// its result. Recording runs it inside the trace lock, so the record order is the order
// the operations really happened in; replay runs it on this thread's turn and checks it
// returned what it returned when recorded.
pub fn replaySyncAtomic(op: &string, f: () => i64): i64 {
    if rrMode == 3 {
        replaySyncEnter()
        let r = f()
        replaySyncNote(op, r)
        return r
    }
    var r: i64 = 0
    rrLock.run((): void => {
        r = f()
        flushIdle()
        writeRecord("sync." + op, r.toString(), "")
    })
    return r
}

// ── externs (src/replay-externs.ts generates the callers) ──

// Report, once per name, that this run called an extern the trace cannot answer, and
// note it in the trace (`trace.hole`: arg the name, payload where), so `milo trace`
// shows a recording with gaps. Under replay the note is consumed silently; the call
// itself runs for real in both.
pub fn replayHole(name: &string, site: *u8): void {
    let mode = replayModeNow()
    if mode < 2 {
        return
    }
    // Under replay the note is wherever the recording put it: on the thread that got
    // there first, which another thread reaching the same extern now must not take.
    if mode == 3 {
        let _ = replayTakeIfNext("trace.hole", name)
        return
    }
    var where = ""
    unsafe {
        if site as i64 != 0 {
            where = _cstrToString(site)
        }
    }
    var first = false
    rrLock.run((): void => {
        let line = name + "\n"
        if !rrHoles.contains(line) {
            rrHoles.pushStr(line)
            first = true
        }
    })
    if !first {
        return
    }
    eprint("replay: this run called unrecorded " + name + " at " + where + "; a replay may diverge")
    replayPut("trace.hole", name, where)
}

// replayHole with C strings, for a report the compiler inserts (a thread closure that
// shares unsafe memory, see src/checker-program-passes.ts: checkThreadBoundary).
pub fn replayHoleAt(name: *u8, site: *u8): void {
    if replayOff() {
        return
    }
    unsafe { replayHole(_cstrToString(name), site) }
}

// One extern call through the trace. The payload is a header line `<ret> <errno>` and
// one length per output buffer (-1 for one the call did not get), then the outputs'
// bytes back to back.
pub struct ReplayCall {
    kind: string,
    arg: string,
    ret: i64,
    err: i32,
    lens: Vec<i64>,
    data: string,
    dataPos: i64,
    outIdx: i64,
}

// Start one recorded extern call of kind `kind` (`x.<name>`).
pub fn replayCallBegin(kind: string): ReplayCall {
    return ReplayCall {
        kind: kind,
        arg: "",
        ret: 0,
        err: 0,
        lens: Vec.new(),
        data: "",
        dataPos: 0,
        outIdx: 0
    }
}

// The bits of a float, for recording a float argument or return.
pub fn replayF64Bits(v: f64): i64 {
    var b: i64 = 0
    var x = v
    unsafe {
        let src = x.addrOf() as *u8
        let dst = b.addrOf() as *u8
        for i in 0..8 {
            dst[i] = src[i]
        }
    }
    return b
}

pub fn replayF64FromBits(b: i64): f64 {
    var v: f64 = 0.0
    var x = b
    unsafe {
        let src = x.addrOf() as *u8
        let dst = v.addrOf() as *u8
        for i in 0..8 {
            dst[i] = src[i]
        }
    }
    return v
}

impl ReplayCall {
    fn sep(self: &mut Self): void {
        if self.arg.len() > 0 {
            self.arg.push(' ')
        }
    }

    // A scalar argument, part of what names the call.
    fn argInt(self: &mut Self, v: i64): void {
        self.sep()
        self.arg.pushStr(v.toString())
    }

    // A C string argument (a path, a variable name); `-` for null.
    fn argCstr(self: &mut Self, p: *u8): void {
        self.sep()
        unsafe {
            if p as i64 == 0 {
                self.arg.push('-')
            } else {
                self.arg.pushStr(_cstrToString(p))
            }
        }
    }

    // `n` bytes an argument points at, in hex.
    fn argBytes(self: &mut Self, p: *u8, n: i64): void {
        self.sep()
        if p as i64 == 0 || n <= 0 {
            self.arg.push('-')
            return
        }
        self.arg.pushStr(replayHex(p, n))
    }

    // True when the call is to be answered from the trace.
    fn replaying(self: &Self): bool {
        return rrMode == 3
    }

    // Replay: fetch this call's record and restore its errno.
    fn take(self: &mut Self, net: bool): void {
        let p = replayTake(self.kind, self.arg)
        var nl: i64 = -1
        for i in 0..p.len() {
            if nl < 0 && p[i] == '\n' {
                nl = i
            }
        }
        if nl < 0 {
            corrupt(rrSeq)
        }
        let fields = replayInts(p.substr(0, nl))
        if fields.len < 2 {
            corrupt(rrSeq)
        }
        self.ret = fields[0]
        self.err = fields[1] as i32
        for i in 2..fields.len {
            self.lens.push(fields[i])
        }
        self.data = p.substr(nl + 1, p.len())
        self.dataPos = 0
        if net {
            setNetErrno(self.err)
        } else {
            setErrno(self.err)
        }
    }

    // Replay: the recorded return value (a float's bits, a handle's address).
    fn retVal(self: &Self): i64 {
        return self.ret
    }

    fn nextLen(self: &mut Self): i64 {
        if self.outIdx >= self.lens.len {
            corrupt(rrSeq)
        }
        let n = self.lens[self.outIdx]
        self.outIdx += 1
        return n
    }

    // Replay: copy the next recorded output into `p` (skipped when the recording had
    // none, or `p` is null).
    fn outInto(self: &mut Self, p: *u8): void {
        let n = self.nextLen()
        if n < 0 {
            return
        }
        if self.dataPos + n > self.data.len() {
            corrupt(rrSeq)
        }
        if p as i64 != 0 {
            unsafe {
                for i in 0..n {
                    p[i] = self.data[self.dataPos + i]
                }
            }
        }
        self.dataPos += n
    }

    // Replay: the next recorded output as a fresh heap copy (a returned string or
    // structure), null when the recording returned null.
    fn outCopy(self: &mut Self): *u8 {
        let n = self.nextLen()
        if n < 0 {
            return 0 as *u8
        }
        if self.dataPos + n > self.data.len() {
            corrupt(rrSeq)
        }
        unsafe {
            let p = malloc(n + 1)
            for i in 0..n {
                p[i] = self.data[self.dataPos + i]
            }
            p[n] = 0
            self.dataPos += n
            return p
        }
    }

    // Record: errno right after the live call, before anything else can touch it.
    fn saveErrno(self: &mut Self, net: bool): void {
        if net {
            self.err = netErrno()
        } else {
            self.err = getErrno()
        }
    }

    fn setRet(self: &mut Self, r: i64): void {
        self.ret = r
    }

    // Record: `n` bytes at `p` as the next output (absent when `p` is null or `n` < 0).
    fn outFrom(self: &mut Self, p: *u8, n: i64): void {
        if p as i64 == 0 || n < 0 {
            self.lens.push(-1)
            return
        }
        self.lens.push(n)
        unsafe { self.data.pushStr(_bytesToString(p, n)) }
    }

    // Record: the NUL-terminated string at `p` (within `cap` bytes when `cap` >= 0),
    // terminator included.
    fn outCstr(self: &mut Self, p: *u8, cap: i64): void {
        if p as i64 == 0 {
            self.lens.push(-1)
            return
        }
        var n: i64 = 0
        unsafe {
            while (cap < 0 || n < cap) && p[n] != 0 {
                n += 1
            }
        }
        if cap < 0 || n < cap {
            n += 1
        }
        self.outFrom(p, n)
    }

    // Record: write the record, then put errno back (the write is a syscall too).
    fn put(self: &mut Self, net: bool): void {
        var p = String.withCapacity(32 + self.data.len())
        p.pushStr(self.ret.toString())
        p.push(' ')
        p.pushStr(self.err.toString())
        for n in self.lens {
            p.push(' ')
            p.pushStr(n.toString())
        }
        p.push('\n')
        p.pushStr(self.data)
        replayPut(self.kind, self.arg, p)
        if net {
            setNetErrno(self.err)
        } else {
            setErrno(self.err)
        }
    }
}
