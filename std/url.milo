// std/url — URL parsing into components

// A parsed URL, split into its components. `raw` keeps the original string.
pub struct Url {
    scheme: string,
    host: string,
    port: i32,
    path: string,
    query: string,
    fragment: string,
    raw: string,
}

fn urlParse(s: string): Result<Url> {
    var scheme: string = ""
    var host: string = ""
    var port: i32 = 0
    var path: string = ""
    var query: string = ""
    var fragment: string = ""
    var i: i64 = 0

    // scheme
    var schemeEnd: i64 = 0
    while schemeEnd < s.len {
        if s[schemeEnd] == ':' {
            break
        }
        if s[schemeEnd] == '/' || s[schemeEnd] == '?' || s[schemeEnd] == '#' {
            break
        }
        schemeEnd += 1
    }
    if schemeEnd < s.len && s[schemeEnd] == ':' {
        scheme = s[0..schemeEnd].clone()
        i = schemeEnd + 1
    }

    // authority (//host:port)
    if i + 1 < s.len && s[i] == '/' && s[i + 1] == '/' {
        i += 2
        let authStart = i
        while i < s.len && s[i] != '/' && s[i] != '?' && s[i] != '#' {
            i += 1
        }
        let auth = s[authStart..i]

        // split host:port
        var colonPos: i64 = -1
        var j: i64 = auth.len - 1
        while j >= 0 {
            if auth[j] == ':' {
                colonPos = j
                break
            }
            if auth[j] == ']' {
                break
            }
            j -= 1
        }

        if colonPos > 0 {
            host = auth[0..colonPos].clone()
            let portStr = auth[colonPos + 1..auth.len]
            port = _parsePort(portStr)?
        } else {
            host = auth
        }
    }

    // path
    let pathStart = i
    while i < s.len && s[i] != '?' && s[i] != '#' {
        i += 1
    }
    path = s[pathStart..i].clone()

    // query
    if i < s.len && s[i] == '?' {
        i += 1
        let qStart = i
        while i < s.len && s[i] != '#' {
            i += 1
        }
        query = s[qStart..i].clone()
    }

    // fragment
    if i < s.len && s[i] == '#' {
        i += 1
        fragment = s[i..s.len].clone()
    }

    // default ports
    if port == 0 {
        if scheme == "http" {
            port = 80
        }
        if scheme == "https" {
            port = 443
        }
    }

    return Result.Ok(Url {
        scheme: scheme, host: host, port: port,
        path: path, query: query, fragment: fragment,
        raw: s,
    })
}

fn _parsePort(s: &string): Result<i32> {
    if s.len == 0 {
        return Result.Err("empty URL port")
    }
    var result: i64 = 0
    var i: i64 = 0
    while i < s.len {
        let c = s[i]
        if c < '0' || c > '9' {
            return Result.Err("invalid URL port at byte " + i.toString())
        }
        result = result * 10 + (c as i64 - 48)
        if result > 65535 {
            return Result.Err("URL port is out of range")
        }
        i += 1
    }
    return Result.Ok(result as i32)
}

fn urlQueryGet(u: &Url, key: &string): Option<string> {
    if u.query.len == 0 {
        return Option.None
    }
    var i: i64 = 0
    while i < u.query.len {
        let kStart = i
        while i < u.query.len && u.query[i] != '=' && u.query[i] != '&' {
            i += 1
        }
        let k = u.query[kStart..i]
        var val: string = ""
        if i < u.query.len && u.query[i] == '=' {
            i += 1
            let vStart = i
            while i < u.query.len && u.query[i] != '&' {
                i += 1
            }
            val = u.query[vStart..i].clone()
        }
        if strEqUrl(k, key) {
            return Option.Some(val)
        }
        if i < u.query.len && u.query[i] == '&' {
            i += 1
        }
    }
    return Option.None
}

fn strEqUrl(a: &string, b: &string): bool {
    if a.len != b.len {
        return false
    }
    var i: i64 = 0
    while i < a.len {
        if a[i] != b[i] {
            return false
        }
        i += 1
    }
    return true
}

fn urlString(u: &Url): string {
    var result: string = ""
    if u.scheme.len > 0 {
        result = result + u.scheme + "://"
    }
    result += u.host
    if u.port > 0 && u.port != 80 && u.port != 443 {
        result = result + ":" + format(u.port)
    }
    result += u.path
    if u.query.len > 0 {
        result = result + "?" + u.query
    }
    if u.fragment.len > 0 {
        result = result + "#" + u.fragment
    }
    return result
}

// Url instance/static API — Url.parse(s), u.queryGet(key), u.toString().
impl Url {
    // Parse a URL string into its components.
    fn parse(s: string): Result<Url> {
        return urlParse(s)
    }
    // The value of query parameter `key`, or None if the query has no such key.
    fn queryGet(self: &Self, key: &string): Option<string> {
        return urlQueryGet(self, key)
    }
    // Reassemble the URL from its components.
    fn toString(self: &Self): string {
        return urlString(self)
    }
}

fn hexVal(c: u8): i64 {
    if c >= '0' && c <= '9' {
        return (c - '0') as i64
    }
    if c >= 'a' && c <= 'f' {
        return (c - 'a') as i64 + 10
    }
    if c >= 'A' && c <= 'F' {
        return (c - 'A') as i64 + 10
    }
    return -1
}

// The byte of the %XX at `i`, or -1 when `i` does not start one.
fn escapedByte(s: &string, i: i64): i64 {
    if i + 2 >= s.len || s[i] != '%' {
        return -1
    }
    let hi = hexVal(s[i + 1])
    let lo = hexVal(s[i + 2])
    if hi < 0 || lo < 0 {
        return -1
    }
    return hi * 16 + lo
}

// JavaScript's decodeURIComponent: each %XX back to its byte, '+' left alone. An error
// (naming the byte offset) where JS throws URIError: a '%' without two hex digits after it, or escapes that do
// not spell valid UTF-8 (a stray continuation byte, an overlong form, a surrogate, a
// code point past U+10FFFF). A request path decoded with a lenient decoder instead
// would let malformed input through as if it were text.
pub fn decodeUriComponent(s: &string): Result<string> {
    var out: string = ""
    var i: i64 = 0
    while i < s.len {
        if s[i] != '%' {
            out.push(s[i])
            i += 1
            continue
        }
        let at = i
        let b = escapedByte(s, i)
        if b < 0 {
            return Result.Err($"malformed escape at byte {at}")
        }
        i += 3
        if b < 128 {
            out.push(b as u8)
            continue
        }
        var need: i64 = 0
        var cp: i64 = 0
        var min: i64 = 0
        if b >= 0xC0 && b < 0xE0 {
            need = 1
            cp = b & 0x1F
            min = 0x80
        } else if b >= 0xE0 && b < 0xF0 {
            need = 2
            cp = b & 0x0F
            min = 0x800
        } else if b >= 0xF0 && b < 0xF8 {
            need = 3
            cp = b & 0x07
            min = 0x10000
        } else {
            return Result.Err($"invalid utf-8 escape at byte {at}")
        }
        out.push(b as u8)
        for _k in 0..need {
            let c = escapedByte(s, i)
            if c < 0x80 || c > 0xBF {
                return Result.Err($"invalid utf-8 escape at byte {at}")
            }
            cp = cp * 64 + (c & 0x3F)
            out.push(c as u8)
            i += 3
        }
        if cp < min || cp > 0x10FFFF || (cp >= 0xD800 && cp <= 0xDFFF) {
            return Result.Err($"invalid utf-8 escape at byte {at}")
        }
    }
    return Result.Ok(out)
}

// ── Reference resolution (RFC 3986 §5.2) ──

// A URI reference split per RFC 3986 §3 without validation. The `has*` flags keep
// "absent" apart from "present but empty", which §5.2.2 treats differently
// ("?" alone replaces the base query with an empty one).
struct UrlRefParts {
    scheme: string,
    hasAuthority: bool,
    authority: string,
    path: string,
    hasQuery: bool,
    query: string,
    hasFragment: bool,
    fragment: string,
}

fn isSchemeByte(c: u8, first: bool): bool {
    let alpha = (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z')
    if first {
        return alpha
    }
    return alpha || (c >= '0' && c <= '9') || c == '+' || c == '-' || c == '.'
}

fn splitUrlRef(s: &string): UrlRefParts {
    var p = UrlRefParts {
        scheme: "", hasAuthority: false, authority: "", path: "",
        hasQuery: false, query: "", hasFragment: false, fragment: "",
    }
    var i: i64 = 0
    // A scheme is letters then scheme bytes up to ':'; anything else first means the
    // reference is relative and a later ':' belongs to its path ("a:b" vs "./a:b").
    var j: i64 = 0
    while j < s.len && isSchemeByte(s[j], j == 0) {
        j += 1
    }
    if j > 0 && j < s.len && s[j] == ':' {
        p.scheme = s.substr(0, j)
        i = j + 1
    }
    if i + 1 < s.len && s[i] == '/' && s[i + 1] == '/' {
        p.hasAuthority = true
        i += 2
        let start = i
        while i < s.len && s[i] != '/' && s[i] != '?' && s[i] != '#' {
            i += 1
        }
        p.authority = s.substr(start, i)
    }
    let pathStart = i
    while i < s.len && s[i] != '?' && s[i] != '#' {
        i += 1
    }
    p.path = s.substr(pathStart, i)
    if i < s.len && s[i] == '?' {
        p.hasQuery = true
        i += 1
        let qs = i
        while i < s.len && s[i] != '#' {
            i += 1
        }
        p.query = s.substr(qs, i)
    }
    if i < s.len && s[i] == '#' {
        p.hasFragment = true
        p.fragment = s.substr(i + 1, s.len)
    }
    return p
}

// RFC 3986 §5.2.4: drop "." segments and let ".." eat the segment before it. A ".."
// above the root stays at the root, so "/../../etc" is "/etc", as browsers do.
fn removeDotSegments(path: &string): string {
    var segs: Vec<string> = Vec.new()
    var i: i64 = 0
    let absolute = path.len > 0 && path[0] == '/'
    if absolute {
        i = 1
    }
    var last = ""
    while i <= path.len {
        var end = i
        while end < path.len && path[end] != '/' {
            end += 1
        }
        last = path.substr(i, end)
        if last == ".." {
            if segs.len > 0 {
                let _ = segs.pop()
            }
        } else if last != "." {
            segs.push(last)
        }
        i = end + 1
    }
    // a trailing "." or ".." names a directory, so the result keeps its slash
    if (last == "." || last == "..") {
        segs.push("")
    }
    var out = if absolute { "/" } else { "" }
    for k in 0..segs.len {
        if k > 0 {
            out += "/"
        }
        out += segs[k]
    }
    return out
}

// The absolute URL `ref` names when it appears in a document at `base`, per RFC 3986
// §5.2: "../img.png", "//cdn.example/x", "?page=2" and "#top" all resolve as a browser
// resolves an href. An absolute `ref` comes back with its dot segments removed. No
// percent-decoding, case folding or validation: a malformed input resolves to
// whatever the algorithm makes of it, so check the result before using it.
pub fn resolveUrl(base: &string, ref: &string): string {
    let b = splitUrlRef(base)
    let r = splitUrlRef(ref)
    var t = UrlRefParts {
        scheme: "", hasAuthority: false, authority: "", path: "",
        hasQuery: r.hasQuery, query: r.query, hasFragment: r.hasFragment, fragment: r.fragment,
    }
    if r.scheme.len > 0 {
        t.scheme = r.scheme
        t.hasAuthority = r.hasAuthority
        t.authority = r.authority
        t.path = removeDotSegments(r.path)
    } else {
        t.scheme = b.scheme
        if r.hasAuthority {
            t.hasAuthority = true
            t.authority = r.authority
            t.path = removeDotSegments(r.path)
        } else {
            t.hasAuthority = b.hasAuthority
            t.authority = b.authority
            if r.path.len == 0 {
                t.path = b.path
                if !r.hasQuery {
                    t.hasQuery = b.hasQuery
                    t.query = b.query
                }
            } else if r.path[0] == '/' {
                t.path = removeDotSegments(r.path)
            } else {
                // §5.2.3 merge: an authority with an empty path merges under "/"
                var merged = ""
                if b.hasAuthority && b.path.len == 0 {
                    merged = "/" + r.path
                } else {
                    var slash: i64 = b.path.len - 1
                    while slash >= 0 && b.path[slash] != '/' {
                        slash -= 1
                    }
                    merged = b.path.substr(0, slash + 1) + r.path
                }
                t.path = removeDotSegments(merged)
            }
        }
    }
    var out = ""
    if t.scheme.len > 0 {
        out = t.scheme + ":"
    }
    if t.hasAuthority {
        out = out + "//" + t.authority
    }
    out += t.path
    if t.hasQuery {
        out = out + "?" + t.query
    }
    if t.hasFragment {
        out = out + "#" + t.fragment
    }
    return out
}
