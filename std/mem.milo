// std/mem — memory management with automatic cleanup
//
// Neither type here hands safe code an address. A mapping is read through `with` /
// `withMut`, which lend its bytes as a bounds-checked slice for one closure call; a Bump
// allocation is named by a BumpSpan handle that goes stale at the next `reset`.

from "std/os" import {
    free, malloc, memset
}
from "std/platform" import {
    mapPrivateAnon,
    mmap, munmap
}
from "std/io" import {
    File,
    AsFd
}
from "std/foreign" import {
    withRaw, withRawMut
}

// ── MappedMemory ──

// Memory-mapped region. Automatically unmapped on drop. The fields are private so the
// only way to hold one is from mmapAnon / mmapFile, which keeps `_ptr` a live mapping of
// `_len` bytes for as long as the value lives.
pub struct MappedMemory {
    _ptr: *u8,
    _len: i64,
    _writable: bool,
}

impl Drop for MappedMemory {
    fn drop(self: &mut Self): void {
        unsafe {
            if self._ptr as i64 != 0 {
                munmap(self._ptr, self._len)
            }
        }
    }
}

// mmap reports failure as MAP_FAILED, which is (void*)-1, not null.
fn mapFailed(p: *u8): bool {
    unsafe {
        return p as i64 == -1 || p as i64 == 0
    }
}

// Allocate an anonymous (non-file-backed), zero-filled, writable memory-mapped region.
pub fn mmapAnon(size: i64): Result<MappedMemory> {
    if size <= 0 {
        return Result.Err("mmap: size must be positive, got " + size.toString())
    }
    let PROT_RW: i32 = 3
    unsafe {
        let p = mmap(0 as *u8, size, PROT_RW, mapPrivateAnon(), -1, 0)
        if mapFailed(p) {
            return Result.Err("mmap failed")
        }
        return Result.Ok(MappedMemory {
            _ptr: p, _len: size, _writable: true
        })
    }
}

// Memory-map `size` bytes of an open file for reading. The mapping keeps the pages,
// not the descriptor: `f` may close once this returns. The mapping is read-only, so
// `withMut` on it returns None.
pub fn mmapFile(f: &File, size: i64): Result<MappedMemory> {
    if size <= 0 {
        return Result.Err("mmap: size must be positive, got " + size.toString())
    }
    let PROT_READ: i32 = 1
    let MAP_PRIVATE: i32 = 2
    unsafe {
        let p = mmap(0 as *u8, size, PROT_READ, MAP_PRIVATE, f.rawFd(), 0)
        if mapFailed(p) {
            return Result.Err("mmap failed")
        }
        return Result.Ok(MappedMemory {
            _ptr: p, _len: size, _writable: false
        })
    }
}

impl MappedMemory {
    // Length of the mapping in bytes.
    fn len(self: &Self): i64 {
        return self._len
    }

    // Whether `withMut` can write this mapping (true for mmapAnon, false for mmapFile).
    fn isWritable(self: &Self): bool {
        return self._writable
    }

    // Lend the mapped bytes to `f` and return what it returns. The view cannot outlive
    // the call, so it cannot outlive the mapping.
    fn with<R>(self: &Self, f: (&[u8]) => R): R {
        unsafe {
            return withRaw(self._ptr, self._len, f)!
        }
    }

    // `with` with a mutable view. None, and `f` is not called, when the mapping is
    // read-only: a write there would fault rather than fail.
    fn withMut<R>(self: &mut Self, f: (&mut [u8]) => R): Option<R> {
        if !self._writable {
            return Option.None
        }
        unsafe {
            return withRawMut(self._ptr, self._len, f)
        }
    }

    // `with` for a closure that returns nothing.
    fn read(self: &Self, f: (&[u8]) => void): void {
        unsafe {
            let _ran = withRaw(self._ptr, self._len, (bytes: &[u8]): bool => {
                f(bytes)
                return true
            })
        }
    }

    // `withMut` for a closure that returns nothing. False, and `f` is not called, when
    // the mapping is read-only.
    @mustUse
    fn write(self: &mut Self, f: (&mut [u8]) => void): bool {
        if !self._writable {
            return false
        }
        unsafe {
            return withRawMut(self._ptr, self._len, (bytes: &mut [u8]): bool => {
                f(&mut bytes)
                return true
            }) ?? false
        }
    }

    // The mapping's base address, for handing to C (memchr over a mapped file). The
    // caller must not use it after this MappedMemory drops, and must not write through
    // it when `isWritable()` is false.
    @unsafe
    fn ptr(self: &Self): *u8 {
        return self._ptr
    }
}

// ── Bump ──

// Bump allocator with automatic cleanup. Named Bump, not Arena: std/arena owns
// the name `Arena` for its generational typed-handle arena, and Milo merges every
// module into one flat namespace, so a program cannot import both under one name.
// All allocations are 8-byte aligned. Use reset() to reclaim without freeing.
//
// `_epoch` counts resets; every BumpSpan carries the epoch it was cut in, so a span kept
// past a reset is rejected instead of aliasing whatever was allocated over it.
pub struct Bump {
    _id: i64,
    _base: *u8,
    _cap: i64,
    _used: i64,
    _epoch: i64,
}

// A copyable token naming `len` bytes of one Bump, valid until that Bump's next reset.
// Private fields: only Bump.alloc can make one.
@derive(Eq)
pub struct BumpSpan {
    _bumpId: i64,
    _epoch: i64,
    _offset: i64,
    _len: i64,
}

impl Drop for Bump {
    fn drop(self: &mut Self): void {
        unsafe {
            if self._base as i64 != 0 {
                free(self._base)
            }
        }
    }
}

// Same reason as std/arena's id counter: a Bump may be created on a blocking worker.
var nextBumpId: i64 = 1

// Create a new bump allocator with the given capacity in bytes.
fn bumpNew(capacity: i64): Result<Bump>
requires capacity > 0
{
    if capacity <= 0 {
        return Result.Err("bump: capacity must be positive, got " + capacity.toString())
    }
    unsafe {
        let p = malloc(capacity)
        if p as i64 == 0 {
            return Result.Err("bump allocation failed")
        }
        let id = _atomicAddI64((nextBumpId.addrOf()) as *u8, 1)
        return Result.Ok(Bump {
            _id: id, _base: p, _cap: capacity, _used: 0, _epoch: 0
        })
    }
}

// Allocate size bytes from the bump allocator (8-byte aligned), zeroed.
// Returns Err if it doesn't have enough space.
fn bumpAlloc(a: &mut Bump, size: i64): Result<BumpSpan>
requires size > 0
// The invariant the overflow broke, and the one `a._used <= a._cap` cannot catch on its
// own: a wrapped-negative `used` is still <= cap. Reported `unknown` rather than proven
// because `aligned` is computed with a bitwise mask, which the solver does not model.
ensures a._used >= 0
ensures a._used <= a._cap
{
    if size <= 0 {
        return Result.Err("bump: size must be positive, got " + size.toString())
    }
    // align to 8 bytes
    let seven: i64 = 7
    let aligned = (a._used + seven) & ~seven
    // Subtract instead of adding: `aligned + size > a._cap` overflows for a large `size`
    // once a previous allocation has made `aligned` positive, and the wrapped negative is
    // not greater than `cap`, so the guard passed and handed out an allocation the arena
    // cannot hold. Found by `milo test --contracts` once it drew a SEQUENCE of calls: one
    // alloc to make `aligned` positive, then `size = i64::MAX`. Checking `aligned` first
    // is what makes `a._cap - aligned` safe to compute.
    if aligned > a._cap || size > a._cap - aligned {
        return Result.Err("bump allocator out of memory")
    }
    // Zeroed so a safe reader never sees bytes from before a reset or malloc's
    // uninitialized ones.
    unsafe {
        memset(spanPtr(a, aligned), 0, size)
    }
    a._used = aligned + size
    return Result.Ok(BumpSpan {
        _bumpId: a._id, _epoch: a._epoch, _offset: aligned, _len: size
    })
}

// Address of byte `offset` of the region. Callers have bounds-checked `offset`; the
// result never leaves this file.
@unsafe
fn spanPtr(a: &Bump, offset: i64): *u8 {
    unsafe {
        return (a._base as i64 + offset) as *u8
    }
}

// Whether `s` was cut from this Bump since its last reset. Offset and length are
// re-checked against `_used` even though only alloc can build a span, so the bounds do
// not rest on that alone.
fn spanLive(a: &Bump, s: BumpSpan): bool {
    return s._bumpId == a._id && s._epoch == a._epoch && s._offset >= 0 && s._len > 0 && s._offset <= a._used && s._len <= a._used - s._offset
}

// Reset the allocator, making all previously allocated memory available for reuse.
fn bumpReset(a: &mut Bump): void
ensures a._used == 0
{
    a._used = 0
    a._epoch += 1
}

fn bumpRemaining(a: &Bump): i64
requires a._used <= a._cap
ensures result >= 0
{
    return a._cap - a._used
}

impl Bump {
    // Restate each callee's preconditions on the wrapper (Bump has no struct
    // invariant the solver models): without them the wrapper can't discharge the
    // free fn's `requires`, same restating pattern as Pool's live/available.

    // Create a bump allocator over `capacity` bytes of heap. The whole region is freed
    // when the Bump drops.
    fn new(capacity: i64): Result<Bump>
    requires capacity > 0
    {
        return bumpNew(capacity)
    }
    // Bump-allocate `size` zeroed bytes (8-byte aligned) and return the span naming
    // them. Errs when the region is full.
    fn alloc(self: &mut Self, size: i64): Result<BumpSpan>
    requires size > 0
    {
        return bumpAlloc(&mut self, size)
    }
    // Lend the span's bytes to `f` and return what it returns. None, and `f` is not
    // called, when the span is from another Bump or from before a reset.
    fn with<R>(self: &Self, s: BumpSpan, f: (&[u8]) => R): Option<R> {
        if !spanLive(self, s) {
            return Option.None
        }
        unsafe {
            return withRaw(spanPtr(self, s._offset), s._len, f)
        }
    }
    // `with` with a mutable view: writes land in the span.
    fn withMut<R>(self: &mut Self, s: BumpSpan, f: (&mut [u8]) => R): Option<R> {
        if !spanLive(self, s) {
            return Option.None
        }
        unsafe {
            return withRawMut(spanPtr(self, s._offset), s._len, f)
        }
    }
    // `with` for a closure that returns nothing. False when the span is stale.
    @mustUse
    fn read(self: &Self, s: BumpSpan, f: (&[u8]) => void): bool {
        if !spanLive(self, s) {
            return false
        }
        unsafe {
            return withRaw(spanPtr(self, s._offset), s._len, (bytes: &[u8]): bool => {
                f(bytes)
                return true
            }) ?? false
        }
    }
    // `withMut` for a closure that returns nothing. False when the span is stale.
    @mustUse
    fn write(self: &mut Self, s: BumpSpan, f: (&mut [u8]) => void): bool {
        if !spanLive(self, s) {
            return false
        }
        unsafe {
            return withRawMut(spanPtr(self, s._offset), s._len, (bytes: &mut [u8]): bool => {
                f(&mut bytes)
                return true
            }) ?? false
        }
    }
    // Whether `s` still names live bytes of THIS Bump.
    @mustUse
    fn valid(self: &Self, s: BumpSpan): bool {
        return spanLive(self, s)
    }
    // Reclaim every allocation at once. Every span issued before this goes stale.
    fn reset(self: &mut Self): void {
        bumpReset(&mut self)
    }
    // Bytes still available.
    fn remaining(self: &Self): i64 {
        return bumpRemaining(self)
    }
}

impl BumpSpan {
    // Length of the span in bytes.
    fn len(self: &Self): i64 {
        return self._len
    }
}
