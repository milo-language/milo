// std/mem — memory management with automatic cleanup

from "std/os" import {
    free, malloc
}
from "std/platform" import {
    mapPrivateAnon,
    mmap, munmap
}

// ── MappedMemory ──

// Memory-mapped region. Automatically unmapped on drop.
pub struct MappedMemory {
    ptr: i64,
    len: i64,
}

impl Drop for MappedMemory {
    fn drop(self: &mut Self): void {
        if self.ptr != 0 {
            unsafe {
                munmap(self.ptr as *u8, self.len)
            }
        }
    }
}

// Allocate an anonymous (non-file-backed) memory-mapped region.
pub fn mmapAnon(size: i64): Result<MappedMemory> {
    let PROT_RW: i32 = 3
    var addr: i64 = 0
    unsafe {
        let p = mmap(0 as *u8, size, PROT_RW, mapPrivateAnon(), -1, 0)
        addr = p as i64
    }
    let mapFailed: i64 = -1 as i64
    if addr == mapFailed {
        return Result.Err("mmap failed")
    }
    return Result.Ok(MappedMemory {
        ptr: addr, len: size
    })
}

// Memory-map a file descriptor for reading.
pub fn mmapFile(fFd: i32, size: i64): Result<MappedMemory> {
    let PROT_READ: i32 = 1
    let MAP_PRIVATE: i32 = 2
    var addr: i64 = 0
    unsafe {
        let p = mmap(0 as *u8, size, PROT_READ, MAP_PRIVATE, fFd, 0)
        addr = p as i64
    }
    let mapFailed: i64 = -1 as i64
    if addr == mapFailed {
        return Result.Err("mmap failed")
    }
    return Result.Ok(MappedMemory {
        ptr: addr, len: size
    })
}

// ── Bump ──

// Bump allocator with automatic cleanup. Named Bump, not Arena: std/arena owns
// the name `Arena` for its generational typed-handle arena, and Milo merges every
// module into one flat namespace, so a program cannot import both under one name.
// All allocations are 8-byte aligned. Use bumpReset() to reclaim without freeing.
pub struct Bump {
    base: i64,
    cap: i64,
    used: i64,
}

impl Drop for Bump {
    fn drop(self: &mut Self): void {
        if self.base != 0 {
            unsafe {
                free(self.base as *u8)
            }
        }
    }
}

// Create a new bump allocator with the given capacity in bytes.
fn bumpNew(capacity: i64): Result<Bump>
requires capacity > 0
{
    unsafe {
        let p = malloc(capacity)
        let addr = p as i64
        if addr == 0 {
            return Result.Err("bump allocation failed")
        }
        return Result.Ok(Bump {
            base: addr, cap: capacity, used: 0
        })
    }
}

// Allocate size bytes from the bump allocator (8-byte aligned).
// Returns Err if it doesn't have enough space.
fn bumpAlloc(a: &mut Bump, size: i64): Result<i64>
requires size > 0
// The invariant the overflow broke, and the one `a.used <= a.cap` cannot catch on its
// own: a wrapped-negative `used` is still <= cap. Reported `unknown` rather than proven
// because `aligned` is computed with a bitwise mask, which the solver does not model.
ensures a.used >= 0
ensures a.used <= a.cap
{
    // align to 8 bytes
    let seven: i64 = 7
    let aligned = (a.used + seven) & ~seven
    // Subtract instead of adding: `aligned + size > a.cap` overflows for a large `size`
    // once a previous allocation has made `aligned` positive, and the wrapped negative is
    // not greater than `cap`, so the guard passed and handed out a pointer for an
    // allocation the arena cannot hold. Found by `milo test --contracts` once it drew a
    // SEQUENCE of calls: one alloc to make `aligned` positive, then `size = i64::MAX`.
    // Checking `aligned` first is what makes `a.cap - aligned` safe to compute.
    if aligned > a.cap || size > a.cap - aligned {
        return Result.Err("bump allocator out of memory")
    }
    let ptr = a.base + aligned
    a.used = aligned + size
    return Result.Ok(ptr)
}

// Reset the allocator, making all previously allocated memory available for reuse.
fn bumpReset(a: &mut Bump): void
ensures a.used == 0
{
    a.used = 0
}

fn bumpRemaining(a: &Bump): i64
requires a.used <= a.cap
ensures result >= 0
{
    return a.cap - a.used
}

impl Bump {
    // Restate each callee's preconditions on the wrapper (Bump has no struct
    // invariant the solver models): without them the wrapper can't discharge the
    // free fn's `requires` — same restating pattern as Pool's free/live/available.

    // Create a bump allocator over `capacity` bytes of heap. The whole region is freed
    // when the Bump drops.
    fn new(capacity: i64): Result<Bump>
    requires capacity > 0
    {
        return bumpNew(capacity)
    }
    // Bump-allocate `size` bytes (8-byte aligned) and return the address. Errs when the
    // region is full.
    fn alloc(self: &mut Self, size: i64): Result<i64>
    requires size > 0
    {
        return bumpAlloc(&mut self, size)
    }
    // Reclaim every allocation at once by resetting the used count to zero.
    fn reset(self: &mut Self): void {
        bumpReset(&mut self)
    }
    // Bytes still available.
    fn remaining(self: &Self): i64 {
        return bumpRemaining(self)
    }
}
