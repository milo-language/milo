// ── Public types ──

// A name/value pair: a path parameter, query parameter, header or cookie.
pub struct Param {
    name: string,
    value: string,
}

// A parsed HTTP request.
pub struct Request {
    method: string,
    path: string,
    queryParams: Vec<Param>,
    // The query string exactly as sent (no '?', not percent-decoded), "" when the
    // URL had none: what a proxy forwards or a log records, since decoded params
    // cannot be turned back into the original bytes.
    rawQuery: string,
    headers: Vec<Param>,
    body: string,
}

// Request context passed to route handlers.
pub struct Context {
    req: Request,
    params: Vec<Param>,
    statusCode: i32,
    respHeaders: Vec<Param>,
}

impl Context {
    // Value of the route parameter `name`, or None if the route has no such
    // parameter. A matched-but-empty segment is Some("").
    fn param(self: &Self, name: &string): Option<string> {
        for i in 0..self.params.len {
            if self.params[i].name == name {
                return Option.Some(self.params[i].value)
            }
        }
        return Option.None
    }

    // Value of query-string parameter `name`, or None if it was not in the URL.
    // `?name=` and `?name` are both present with an empty value: Some("").
    fn query(self: &Self, name: &string): Option<string> {
        for i in 0..self.req.queryParams.len {
            if self.req.queryParams[i].name == name {
                return Option.Some(self.req.queryParams[i].value)
            }
        }
        return Option.None
    }

    // Value of request header `name` (case-insensitive), or None if the request
    // did not carry it. A header sent with an empty value is Some("").
    fn header(self: &Self, name: &string): Option<string> {
        for i in 0..self.req.headers.len {
            if eqIgnoreCase(self.req.headers[i].name, name) {
                return Option.Some(self.req.headers[i].value)
            }
        }
        return Option.None
    }

    // Value of cookie `name`, or None if there is no Cookie header or it does
    // not carry `name`. `name=` in the header is Some("").
    fn cookie(self: &Self, name: &string): Option<string> {
        match self.header("Cookie") {
            Option.Some(cookieHeader) => {
                return parseCookieValue(cookieHeader, name)
            }
            Option.None => {
                return Option.None
            }
        }
    }

    // Set the response status code used by `text`, `json`, `html` and `redirect`.
    fn setStatus(self: &mut Self, code: i32): void {
        self.statusCode = code
    }

    // Add a response header.
    fn setHeader(self: &mut Self, name: string, value: string): void {
        self.respHeaders.push(Param {
            name: name, value: value
        })
    }

    // Set a response cookie (`Set-Cookie: name=value`).
    fn setCookie(self: &mut Self, name: string, value: string): void {
        self.respHeaders.push(Param {
            name: "Set-Cookie", value: name + "=" + value
        })
    }

    // Set a response cookie with attributes, e.g. `options` = "Path=/; HttpOnly".
    fn setCookieWithOptions(self: &mut Self, name: string, value: string, options: string): void {
        self.respHeaders.push(Param {
            name: "Set-Cookie", value: name + "=" + value + "; " + options
        })
    }

    // Delete a cookie on the client (`Max-Age=0`).
    fn deleteCookie(self: &mut Self, name: string): void {
        self.respHeaders.push(Param {
            name: "Set-Cookie",
            value: name + "=; Max-Age=0",
        })
    }

    // A text/plain response, with the status from `setStatus`.
    fn text(self: &Self, body: string): Response {
        if self.statusCode != 200 {
            return Response.Status(self.statusCode, "text/plain; charset=utf-8", body)
        }
        return Response.Text(body)
    }

    // An application/json response, with the status from `setStatus`.
    fn json(self: &Self, body: string): Response {
        if self.statusCode != 200 {
            return Response.Status(self.statusCode, "application/json", body)
        }
        return Response.Json(body)
    }

    // A text/html response, with the status from `setStatus`.
    fn html(self: &Self, body: string): Response {
        if self.statusCode != 200 {
            return Response.Status(self.statusCode, "text/html; charset=utf-8", body)
        }
        return Response.Html(body)
    }

    // The file at `path` as the response, with validators and ranges (see fileResponse):
    // 200, 206, 304, 416, or a 404 when it is not a readable regular file. The content
    // type comes from std/mime (application/octet-stream when the extension is unknown);
    // Cache-Control stays the handler's to set. Nothing here keeps `path` inside a
    // directory: a handler joining user input into it must refuse `..` itself.
    fn file(self: &mut Self, path: &string): Response {
        let ct = Mime.contentType(path) ?? "application/octet-stream"
        let Option.Some(handled) = fileResponse(self.req.method, self.req.headers, path, ct) else {
            return Response.NotFound
        }
        for h in handled.headers {
            self.respHeaders.push(h.clone())
        }
        return handled.response
    }

    // A redirect to `url`: sets the `Location` header and answers 302 Found, or the
    // status from `setStatus` (301, 303, 307, 308) when one was set. The URL is also the
    // body, for clients that show it.
    fn redirect(self: &mut Self, url: string): Response {
        self.respHeaders.push(Param {
            name: "Location", value: url
        })
        if self.statusCode != 200 {
            return Response.Status(self.statusCode, "text/plain; charset=utf-8", url)
        }
        return Response.Status(302, "text/plain; charset=utf-8", url)
    }
}

// What a handler returns. `Status` carries the status code, content type and body.
pub enum Response {
    Text(string),
    Html(string),
    Json(string),
    NotFound,
    Status(i32, string, string),
}

pub struct HandledResponse {
    response: Response,
    headers: Vec<Param>,
}

// ── Internal helpers ──

fn toLower(ch: u8): u8 {
    if ch >= 'A' && ch <= 'Z' {
        return ch + 32
    }
    return ch
}

// @internal
pub fn eqIgnoreCase(a: &string, b: &string): bool {
    if a.len != b.len {
        return false
    }
    for i in 0..a.len {
        if toLower(a[i]) != toLower(b[i]) {
            return false
        }
    }
    return true
}

// Parse a request out of a raw read buffer. Public so an alternate transport
// (std/https) can reuse the parser without duplicating it.
pub fn parseRequest(buf: &[u8; 8192], n: i64): Request {
    var raw: string = ""
    for i in 0..n {
        raw.push(buf[i])
    }
    return parseRequestText(raw)
}

// The parser proper, over however many bytes the reader collected. The body is
// whatever follows the headers, cut at Content-Length.
fn parseRequestText(raw: &string): Request {
    let n = raw.len
    var i: i64 = 0

    // parse method
    while i < n && raw[i] != ' ' {
        i += 1
    }
    let method = raw.substr(0, i)
    while i < n && raw[i] == ' ' {
        i += 1
    }

    // parse URI (path?query)
    let uriStart = i
    while i < n && raw[i] != ' ' {
        i += 1
    }
    let uri = raw.substr(uriStart, i)

    // skip to end of request line
    while i < n && raw[i] != '\n' {
        i += 1
    }
    if i < n {
        i += 1
    }

    // parse headers
    var headers: Vec<Param> = []
    var contentLength: i64 = 0
    while i < n {
        if raw[i] == '\r' && i + 1 < n && raw[i + 1] == '\n' {
            i += 2
            break
        }
        if raw[i] == '\n' {
            i += 1
            break
        }
        let headerStart = i
        while i < n && raw[i] != ':' {
            i += 1
        }
        let headerName = raw.substr(headerStart, i)
        if i < n {
            i += 1
        }
        while i < n && raw[i] == ' ' {
            i += 1
        }
        let valueStart = i
        while i < n && raw[i] != '\r' && raw[i] != '\n' {
            i += 1
        }
        let headerValue = raw.substr(valueStart, i)
        if eqIgnoreCase(headerName, "content-length") {
            contentLength = parseContentLength(headerValue)
        }
        headers.push(Param {
            name: headerName, value: headerValue
        })
        if i < n && raw[i] == '\r' {
            i += 1
        }
        if i < n && raw[i] == '\n' {
            i += 1
        }
    }

    // extract body
    var body: string = ""
    if contentLength > 0 && i < n {
        let bodyEnd = i + contentLength
        var end: i64 = n
        if bodyEnd < n {
            end = bodyEnd
        }
        body = raw.substr(i, end)
    }

    // split URI into path and query
    var path: string = ""
    var queryStr: string = ""
    var foundQ: bool = false
    for ch in uri {
        if !foundQ && ch == '?' {
            foundQ = true
        } else if foundQ {
            queryStr.push(ch)
        } else {
            path.push(ch)
        }
    }

    let queryParams = parseQueryString(queryStr)
    return Request {
        method: method,
        path: path,
        queryParams: queryParams,
        rawQuery: queryStr,
        headers: headers,
        body: body,
    }
}

fn parseContentLength(s: &string): i64 {
    var result: i64 = 0
    for ch in s {
        let d = ch as i64 - 48
        if d >= 0 && d <= 9 {
            // Saturate rather than overflow: a 30-digit Content-Length is a client
            // asking for a 413, not a reason to wrap negative (or trap).
            if result > 100000000000000 {
                return result
            }
            result = result * 10 + d
        }
    }
    return result
}

// Value of a single hex digit, or -1 if the byte isn't one.
fn hexNibble(ch: u8): i32 {
    if ch >= '0' && ch <= '9' {
        return (ch - '0') as i32
    }
    if ch >= 'a' && ch <= 'f' {
        return (ch - 'a') as i32 + 10
    }
    if ch >= 'A' && ch <= 'F' {
        return (ch - 'A') as i32 + 10
    }
    return -1
}

// Percent-decode a query component. '+' means space (form-urlencoded) and %XX
// is a raw byte. A malformed escape is passed through literally rather than
// dropped, so a stray '%' in user input can't truncate the value.
fn urlDecode(s: &string): string {
    var out: string = ""
    var i = 0
    while i < s.len {
        let ch = s[i]
        if ch == '+' {
            out.push(' ')
            i += 1
        } else if ch == '%' && i + 2 < s.len {
            let hi = hexNibble(s[i + 1])
            let lo = hexNibble(s[i + 2])
            if hi >= 0 && lo >= 0 {
                out.push((hi * 16 + lo) as u8)
                i += 3
            } else {
                out.push(ch)
                i += 1
            }
        } else {
            out.push(ch)
            i += 1
        }
    }
    return out
}

fn parseQueryString(qs: &string): Vec<Param> {
    var params: Vec<Param> = []
    if qs.len == 0 {
        return params
    }
    var key: string = ""
    var value: string = ""
    var inValue: bool = false
    for ch in qs {
        if ch == '&' {
            if key.len > 0 {
                params.push(Param {
                    name: urlDecode(key), value: urlDecode(value)
                })
            }
            key = ""
            value = ""
            inValue = false
        } else if ch == '=' && !inValue {
            inValue = true
        } else if inValue {
            value.push(ch)
        } else {
            key.push(ch)
        }
    }
    if key.len > 0 {
        params.push(Param {
            name: urlDecode(key), value: urlDecode(value)
        })
    }
    return params
}

// None when `name` is not in the header; Some("") when it is present with no
// value (`name=` or a bare `name`), which a caller may legitimately treat as set.
fn parseCookieValue(cookieHeader: string, name: &string): Option<string> {
    if cookieHeader.len == 0 {
        return Option.None
    }
    var i: i64 = 0
    while i < cookieHeader.len {
        while i < cookieHeader.len && (cookieHeader[i] == ' ' || cookieHeader[i] == ';') {
            i += 1
        }
        let keyStart = i
        while i < cookieHeader.len && cookieHeader[i] != '=' && cookieHeader[i] != ';' {
            i += 1
        }
        let key = bufToStrFromString(cookieHeader, keyStart, i)
        var val: string = ""
        if i < cookieHeader.len && cookieHeader[i] == '=' {
            i += 1
            let valStart = i
            while i < cookieHeader.len && cookieHeader[i] != ';' {
                i += 1
            }
            val = bufToStrFromString(cookieHeader, valStart, i)
        }
        if key == name {
            return Option.Some(val)
        }
    }
    return Option.None
}

fn bufToStrFromString(s: &string, start: i64, end: i64): string {
    var result: string = ""
    var idx: i64 = start
    while idx < end {
        result.push(s[idx])
        idx += 1
    }
    return result
}

// The status line's code and reason phrase, e.g. "404 Not Found".
pub fn statusText(status: i32): string {
    let code = (status as i64).toString()
    let phrase = reasonPhrase(status)
    if phrase.len > 0 {
        return code + " " + phrase
    }
    // A code without a phrase above still goes out as itself. This used to fall
    // back to "200 OK", so a proxy's setStatus(502) reached the client as a
    // success with an error body, and the client's res.ok check never fired.
    if status >= 500 {
        return code + " Server Error"
    }
    if status >= 400 {
        return code + " Client Error"
    }
    if status >= 300 {
        return code + " Redirection"
    }
    return code + " OK"
}

// The registered reason phrase for `status` (RFC 9110 and the RFCs that added
// codes since), or "" for a code without one.
fn reasonPhrase(status: i32): string {
    match status {
        100 => { return "Continue" }
        101 => { return "Switching Protocols" }
        102 => { return "Processing" }
        103 => { return "Early Hints" }
        200 => { return "OK" }
        201 => { return "Created" }
        202 => { return "Accepted" }
        203 => { return "Non-Authoritative Information" }
        204 => { return "No Content" }
        205 => { return "Reset Content" }
        206 => { return "Partial Content" }
        207 => { return "Multi-Status" }
        208 => { return "Already Reported" }
        226 => { return "IM Used" }
        300 => { return "Multiple Choices" }
        301 => { return "Moved Permanently" }
        302 => { return "Found" }
        303 => { return "See Other" }
        304 => { return "Not Modified" }
        305 => { return "Use Proxy" }
        307 => { return "Temporary Redirect" }
        308 => { return "Permanent Redirect" }
        400 => { return "Bad Request" }
        401 => { return "Unauthorized" }
        402 => { return "Payment Required" }
        403 => { return "Forbidden" }
        404 => { return "Not Found" }
        405 => { return "Method Not Allowed" }
        406 => { return "Not Acceptable" }
        407 => { return "Proxy Authentication Required" }
        408 => { return "Request Timeout" }
        409 => { return "Conflict" }
        410 => { return "Gone" }
        411 => { return "Length Required" }
        412 => { return "Precondition Failed" }
        413 => { return "Content Too Large" }
        414 => { return "URI Too Long" }
        415 => { return "Unsupported Media Type" }
        416 => { return "Range Not Satisfiable" }
        417 => { return "Expectation Failed" }
        421 => { return "Misdirected Request" }
        422 => { return "Unprocessable Content" }
        423 => { return "Locked" }
        424 => { return "Failed Dependency" }
        425 => { return "Too Early" }
        426 => { return "Upgrade Required" }
        428 => { return "Precondition Required" }
        429 => { return "Too Many Requests" }
        431 => { return "Request Header Fields Too Large" }
        451 => { return "Unavailable For Legal Reasons" }
        500 => { return "Internal Server Error" }
        501 => { return "Not Implemented" }
        502 => { return "Bad Gateway" }
        503 => { return "Service Unavailable" }
        504 => { return "Gateway Timeout" }
        505 => { return "HTTP Version Not Supported" }
        506 => { return "Variant Also Negotiates" }
        507 => { return "Insufficient Storage" }
        508 => { return "Loop Detected" }
        510 => { return "Not Extended" }
        511 => { return "Network Authentication Required" }
        _ => { return "" }
    }
}

// A header name or value with CR or LF in it would end the header early and let the
// rest be read as more headers or as the body (response splitting), e.g. a redirect URL
// taken from a query string. Replace them with spaces, as Go's net/http does, so every
// setter (setHeader, setCookie, redirect, a Status content type) is safe at this one
// point instead of each having to remember.
fn headerSafe(s: &string): string {
    var out: string = ""
    for i in 0..s.len {
        if s[i] == '\r' || s[i] == '\n' {
            out.push(' ')
        } else {
            out.push(s[i])
        }
    }
    return out
}

// The response bytes, built but not written. Split out of sendRaw so a transport that
// is not a bare fd — std/https writes through SSL_write — reuses the exact wire format
// instead of reimplementing it. std/http itself stays OpenSSL-free; that separation is
// why TLS lives in another module.
//
// Header rules: Content-Type and Server are defaults a handler header of the same
// name (case-insensitive) replaces; an empty `contentType` writes no Content-Type. Content-Length, Connection and Transfer-Encoding
// describe the framing this function writes, so a handler's copy would contradict
// the bytes on the wire and is dropped. 1xx, 204 and 304 never carry a body (RFC 9110
// 6.4.1): those go out with no body, no Content-Length and no Content-Type.
pub fn renderRaw(status: i32, contentType: &string, body: &string, extraHeaders: &Vec<Param>): string {
    let bodyless = (status >= 100 && status < 200) || status == 204 || status == 304
    var resp: string = "HTTP/1.1 " + statusText(status)
    if !bodyless {
        // An empty content type means the body has none (an empty redirect body, say),
        // not a "Content-Type: " line with no value.
        if contentType.len > 0 && !hasHeader(extraHeaders, "Content-Type") {
            resp = resp + "\r\nContent-Type: " + headerSafe(contentType)
        }
        resp = resp + "\r\nContent-Length: " + body.len.toString()
    }
    for h in extraHeaders {
        if isFramingHeader(h.name) || (bodyless && eqIgnoreCase(h.name, "Content-Type")) {
            continue
        }
        resp.pushStr("\r\n" + headerSafe(h.name) + ": " + headerSafe(h.value))
    }
    resp += "\r\nConnection: close"
    if !hasHeader(extraHeaders, "Server") {
        resp += "\r\nServer: milo"
    }
    resp += "\r\n\r\n"
    if !bodyless {
        resp += body
    }
    return resp
}

fn hasHeader(headers: &Vec<Param>, name: &string): bool {
    for i in 0..headers.len {
        if eqIgnoreCase(headers[i].name, name) {
            return true
        }
    }
    return false
}

fn isFramingHeader(name: &string): bool {
    return eqIgnoreCase(name, "Content-Length") || eqIgnoreCase(name, "Connection") || eqIgnoreCase(name, "Transfer-Encoding")
}

// The wire bytes for `req`: a HEAD request gets the headers a GET would (Content-Length
// included) and no body (RFC 9110 9.3.2). A body after them would be read as the start
// of the next response on a kept-alive connection.
pub fn renderFor(req: &Request, response: &Response, extraHeaders: &Vec<Param>): string {
    if req.method != "HEAD" {
        return renderResponse(response, extraHeaders)
    }
    return headOnly(renderResponse(response, extraHeaders))
}

// Rendered response bytes cut after the header block.
pub fn headOnly(wire: string): string {
    let Option.Some(end) = wire.indexOf("\r\n\r\n") else {
        return wire
    }
    return wire.substr(0, end + 4)
}

// Wire bytes for a Response, including the status line and headers.
pub fn renderResponse(response: &Response, extraHeaders: &Vec<Param>): string {
    match response {
        Response.Text(body) => {
            return renderRaw(200, "text/plain; charset=utf-8", body, extraHeaders)
        }
        Response.Html(body) => {
            return renderRaw(200, "text/html; charset=utf-8", body, extraHeaders)
        }
        Response.Json(body) => {
            return renderRaw(200, "application/json", body, extraHeaders)
        }
        Response.NotFound => {
            return renderRaw(404, "text/plain; charset=utf-8", "404 Not Found", extraHeaders)
        }
        Response.Status(code, ct, body) => {
            return renderRaw(code, ct, body, extraHeaders)
        }
    }
}

// ── Reading a request ──

// The largest request line plus headers accepted; more is answered 431.
let maxHeaderBytes: i64 = 16384

// Default cap on a request body, answered 413 past it. Router.setMaxBodySize
// changes it per router.
let defaultMaxBodyBytes: i64 = 1048576

enum ReadOutcome {
    Got(Request),
    // Answer with this status and close: the request was refused before any handler ran.
    Reject(i32),
    // The peer closed or the read failed before a whole request arrived. Nothing to answer.
    Gone,
}

// Offset just past the blank line that ends the headers, or -1. Accepts bare-LF
// line endings as well, as the parser does. Scanning starts at `from` so each new
// read only rescans the few bytes a terminator could straddle.
fn headerEnd(raw: &string, from: i64): i64 {
    var i: i64 = from
    while i < raw.len {
        if raw[i] == '\n' {
            if i + 1 < raw.len && raw[i + 1] == '\n' {
                return i + 2
            }
            if i + 2 < raw.len && raw[i + 1] == '\r' && raw[i + 2] == '\n' {
                return i + 3
            }
        }
        i += 1
    }
    return -1
}

// Append up to one read's worth of bytes from `fd` to `raw`; the byte count, <= 0 at
// EOF or on error. recvFd parks a green task on EAGAIN and blocks outside one, so the
// same reader serves the sequential and the concurrent servers.
fn readMore(fd: i32, raw: &mut string): i64 {
    var chunk: [u8; 8192] = [0; 8192]
    var n: i64 = 0
    unsafe { n = recvFd(fd, chunk, 8192) }
    for i in 0..n {
        raw.push(chunk[i])
    }
    return n
}

// Read one whole request: headers up to the blank line, then the body however many reads
// it takes, framed by Content-Length or by Transfer-Encoding: chunked (decoded here), and
// decompressed when it carries Content-Encoding: gzip or deflate. A request this server
// cannot frame or decode is refused before any handler runs: 400 for a malformed request
// line, header, length or chunk framing, 413 past the body limit (counted on the decoded
// bytes, so a small zip bomb is refused too), 415 for an unknown content coding and 501
// for a transfer coding other than chunked.
//
// `read` appends one read's worth of bytes to its argument and returns the count (<= 0
// at EOF or on error); `write` sends all of its argument. Taking the transport as two
// closures is what lets std/https read requests through TLS with this same code.
fn readRequest(read: (&mut string) => i64, write: (&string) => void, maxBody: i64, maxInflated: i64): ReadOutcome {
    var raw: string = ""
    var end: i64 = -1
    while end < 0 {
        var scanFrom: i64 = 0
        if raw.len > 3 {
            scanFrom = raw.len - 3
        }
        if read(&mut raw) <= 0 {
            return ReadOutcome.Gone
        }
        end = headerEnd(raw, scanFrom)
        if end < 0 && raw.len > maxHeaderBytes {
            return ReadOutcome.Reject(headTooLong(raw))
        }
    }
    if end > maxHeaderBytes {
        return ReadOutcome.Reject(headTooLong(raw))
    }
    let headText = raw.substr(0, end)
    let lineProblem = requestLineProblem(headText)
    if lineProblem != 0 {
        return ReadOutcome.Reject(lineProblem)
    }
    var req = parseRequestText(headText)
    var contentLength: i64 = 0
    var sawLength = false
    var chunked = false
    var expectContinue = false
    for h in req.headers {
        if !isToken(h.name) {
            // no name, or whitespace before the colon (RFC 9112 5.1): a smuggling vector
            return ReadOutcome.Reject(400)
        }
        if eqIgnoreCase(h.name, "Content-Length") {
            let Option.Some(n) = strictLength(h.value) else {
                return ReadOutcome.Reject(400)
            }
            if sawLength && n != contentLength {
                return ReadOutcome.Reject(400)
            }
            contentLength = n
            sawLength = true
        } else if eqIgnoreCase(h.name, "Transfer-Encoding") {
            let codings = codingList(h.value)
            var i: i64 = 0
            for c in codings {
                let last = i == codings.len - 1
                if c == "chunked" {
                    // chunked anywhere but last leaves the length undeterminable (RFC 9112 6.3)
                    if !last {
                        return ReadOutcome.Reject(400)
                    }
                    chunked = true
                } else if c != "identity" {
                    return ReadOutcome.Reject(if last { 400 } else { 501 })
                }
                i += 1
            }
        } else if eqIgnoreCase(h.name, "Expect") && eqIgnoreCase(h.value, "100-continue") {
            expectContinue = true
        }
    }
    // Content-Encoding is checked before the body is read: a coding this server cannot
    // undo is 415 whatever the body holds.
    let Option.Some(encodings) = contentCodings(req.headers) else {
        return ReadOutcome.Reject(415)
    }
    if !chunked && contentLength > maxBody {
        return ReadOutcome.Reject(413)
    }
    // A client that sent Expect: 100-continue may wait for this before sending the
    // body (curl waits a second, then sends anyway). Skip it when the body is
    // already here: the client did not wait.
    if expectContinue && (chunked || contentLength > 0) && raw.len == end {
        write("HTTP/1.1 100 Continue\r\n\r\n")
    }
    if chunked {
        // Transfer-Encoding wins over Content-Length (RFC 9112 6.3); the connection closes
        // after the response, so no byte of a smuggled second request is ever read.
        var scan = ChunkScan.new(end)
        while true {
            let stop = scan.step(raw)
            if stop >= 0 {
                break
            }
            if stop == chunkMalformed {
                return ReadOutcome.Reject(400)
            }
            if scan.declared() > maxBody {
                return ReadOutcome.Reject(413)
            }
            // Size lines, extensions and trailers are overhead the declared count does not
            // see: a body of one-byte chunks with long extensions is capped here instead.
            if (raw.len - end - maxHeaderBytes) / 2 > maxBody {
                return ReadOutcome.Reject(413)
            }
            if read(&mut raw) <= 0 {
                return ReadOutcome.Gone
            }
        }
        req.body = decodeChunked(raw, end)
    } else {
        let want = end + contentLength
        while raw.len < want {
            if read(&mut raw) <= 0 {
                return ReadOutcome.Gone
            }
        }
        req.body = raw.substr(end, want)
    }
    if encodings.len > 0 {
        let status = decodeBody(&mut req, encodings, maxInflated)
        if status != 0 {
            return ReadOutcome.Reject(status)
        }
    }
    return ReadOutcome.Got(req)
}

// 414 when the request line alone is past the header limit (the URI is what is long),
// else 431.
fn headTooLong(raw: &string): i32 {
    let lineEnd = raw.indexOf("\n") ?? raw.len
    return if lineEnd > maxHeaderBytes { 414 } else { 431 }
}

// 400 for a request line that is not `method SP target SP HTTP/1.x`, 505 for another
// HTTP version, 0 when it is well formed.
fn requestLineProblem(head: &string): i32 {
    var lineEnd: i64 = 0
    while lineEnd < head.len && head[lineEnd] != '\r' && head[lineEnd] != '\n' {
        lineEnd += 1
    }
    let parts = head.substr(0, lineEnd).split(" ")
    if parts.len != 3 || !isToken(parts[0]) || parts[1].len == 0 {
        return 400
    }
    for ch in parts[1] {
        if ch <= 32 || ch == 127 {
            return 400
        }
    }
    let version = parts[2]
    if version.len != 8 || !version.startsWith("HTTP/") || version[6] != '.' || version[5] < '0' || version[5] > '9' || version[7] < '0' || version[7] > '9' {
        return 400
    }
    if version[5] != '1' {
        return 505
    }
    return 0
}

// An RFC 9110 token: a method or a field name. Empty is not one.
fn isToken(s: &string): bool {
    if s.len == 0 {
        return false
    }
    for ch in s {
        let ok = (ch >= 'a' && ch <= 'z') || (ch >= 'A' && ch <= 'Z') || (ch >= '0' && ch <= '9') || ch == '!' || ch == '#' ||
        ch == '$' || ch == '%' || ch == '&' || ch == '\'' || ch == '*' || ch == '+' || ch == '-' || ch == '.' || ch == '^' ||
        ch == '_' || ch == '`' || ch == '|' || ch == '~'
        if !ok {
            return false
        }
    }
    return true
}

// A Content-Length value: decimal digits only, optional surrounding whitespace, or None.
// The lenient parseContentLength skips anything else, which would read "1x0" as 10.
fn strictLength(v: &string): Option<i64> {
    let t = v.trim()
    if t.len == 0 {
        return Option.None
    }
    for ch in t {
        if ch < '0' || ch > '9' {
            return Option.None
        }
    }
    return Option.Some(parseContentLength(t))
}

// A comma-separated coding list, lowercased, empty members dropped.
fn codingList(v: &string): Vec<string> {
    var out: Vec<string> = []
    for part in v.split(",") {
        // parameters (`;q=...`) never change which coding it is
        let name = part.split(";") [0].trim().toLower()
        if name.len > 0 {
            out.push(name)
        }
    }
    return out
}

// The request's content codings in the order they were applied, identity dropped, or
// None when one is not gzip, x-gzip or deflate.
fn contentCodings(headers: &Vec<Param>): Option<Vec<string>> {
    var out: Vec<string> = []
    for h in headers {
        if eqIgnoreCase(h.name, "Content-Encoding") {
            for c in codingList(h.value) {
                if c == "gzip" || c == "x-gzip" || c == "deflate" {
                    out.push(c)
                } else if c != "identity" {
                    return Option.None
                }
            }
        }
    }
    return Option.Some(out)
}

fn inflateCoding(deflate: bool, body: &string, max: i64): Result<string, string> {
    if !deflate {
        return Inflate.gzipMax(body, max)
    }
    // "deflate" means zlib (RFC 9110 8.4.1.2), but some clients send a bare DEFLATE
    // stream, so that is tried when the zlib wrapper does not check out
    match Inflate.zlibMax(body, max) {
        Result.Ok(out) => {
            return Result.Ok(out)
        }
        Result.Err(e) => {
            if e == INFLATE_TOO_BIG {
                return Result.Err(e)
            }
        }
    }
    return Inflate.rawMax(body, max)
}

// Undo the content codings on `req.body`, last applied first, never producing more than
// `max` bytes. 0, or the status to refuse with: 413 for output past `max`, 400 for a body
// that does not decode. The handler then sees the decoded body and headers that describe
// it: Content-Encoding dropped and Content-Length, if sent, the decoded length.
fn decodeBody(req: &mut Request, codings: Vec<string>, max: i64): i32 {
    var i = codings.len - 1
    while i >= 0 {
        match inflateCoding(codings[i] == "deflate", req.body, max) {
            Result.Ok(out) => {
                req.body = out
            }
            Result.Err(e) => {
                return if e == INFLATE_TOO_BIG { 413 } else { 400 }
            }
        }
        i -= 1
    }
    var kept: Vec<Param> = []
    for h in req.headers {
        if eqIgnoreCase(h.name, "Content-Encoding") {
            continue
        }
        if eqIgnoreCase(h.name, "Content-Length") {
            kept.push(Param {
                name: h.name, value: req.body.len.toString()
            })
        } else {
            kept.push(h.clone())
        }
    }
    req.headers = kept
    return 0
}

// Read one request through `read`, answer it through `write` with what `respond`
// renders, or with the status readRequest refused it with: the one request lifecycle
// every server shares, the plaintext ones here and std/https's over TLS. Closing the
// transport is the caller's.
fn serveExchange(read: (&mut string) => i64, write: (&string) => void, maxBody: i64, maxInflated: i64, respond: (Request) => string): void {
    match readRequest(read, write, maxBody, maxInflated) {
        ReadOutcome.Got(req) => {
            write(respond(req))
        }
        ReadOutcome.Reject(code) => {
            let noHeaders: Vec<Param> = []
            write(renderRaw(code, "text/plain; charset=utf-8", statusText(code), noHeaders))
        }
        ReadOutcome.Gone => {}
    }
}

// @internal
// One request answered by `handler`, as `serve` answers it, over any transport (`read`
// and `write` as readRequest takes them). std/https's serveTls drives it over TLS.
pub fn serveHandlerExchange(read: (&mut string) => i64, write: (&string) => void, handler: (&Request) => Response): void {
    serveExchange(read, write, defaultMaxBodyBytes, defaultMaxBodyBytes, (req: Request): string => {
        let noHeaders: Vec<Param> = []
        return renderFor(req, handler(req), noHeaders)
    })
}

// @internal
// One request routed through `router` with its body limits, as `serveRouter` answers
// it, over any transport. std/https's serveRouterTls drives it over TLS.
pub fn serveRouterExchange(read: (&mut string) => i64, write: (&string) => void, router: &Router): void {
    serveExchange(read, write, router.maxBodyBytes, inflatedLimit(router), (req: Request): string => {
        let head = req.method == "HEAD"
        let handled = router.handle(req)
        if head {
            return headOnly(renderResponse(handled.response, handled.headers))
        }
        return renderResponse(handled.response, handled.headers)
    })
}

fn fdWrite(fd: i32, data: &string): void {
    let _sent = sendAll(fd, data)
}

// Close an accepted connection once its exchange is over.
fn closeFd(fd: i32): void {
    unsafe { sysClose(fd) }
}

// ── Graceful drain (SIGTERM) ──
//
// SIGTERM stops the server accepting, lets requests in flight finish, then exits 0 after
// at most ServeOptions.drainMs. The handler is a C signal handler, so it can only touch
// plain globals and write(2) one byte to a pipe: the byte is what wakes the accept loop
// and every connection parked in waitConn. The pipe is never read, so it stays readable
// and reaches tasks that start waiting after the signal too.

// 1 once SIGTERM arrived.
var gTerm: i32 = 0
// Read and write ends of the drain pipe; -1 for a server that has none (the sequential
// variants, which have nothing parked to wake).
var gDrainR: i32 = -1
var gDrainW: i32 = -1
// 1 while a sequential server sits in accept() with nothing in flight: SIGTERM then has
// nothing to wait for and the handler exits at once.
var gIdleAccept: i32 = 0

fn termHandler(_sig: i32): void {
    unsafe {
        gTerm = 1
        if gDrainW >= 0 {
            var b: [u8; 1] = [1]
            osWrite(gDrainW, b as *u8, 1)
        }
        if gIdleAccept == 1 {
            exitNow(0)
        }
    }
}

// The descriptor that becomes readable when draining starts; -1 when none.
fn drainWatchFd(): i32 {
    unsafe { return gDrainR }
}

// Install the SIGTERM drain. `broadcast` also creates the drain pipe, for servers whose
// connections park (the concurrent ones).
fn installDrain(broadcast: bool): void {
    unsafe {
        if broadcast && gDrainR < 0 {
            var fds: [i32; 2] = [0; 2]
            if osPipe(fds as *i32) == 0 {
                // the handler's write must never block
                setNonblocking(fds[1])
                gDrainR = fds[0]
                gDrainW = fds[1]
            }
        }
        osSignal(15, termHandler as *u8)
    }
}

fn terminated(): bool {
    unsafe { return gTerm == 1 }
}

// Knobs for the concurrent servers (serveRouterConcurrentWith).
pub struct ServeOptions {
    // Most connections served at once. At the cap the server stops calling accept() until
    // one finishes, so the excess waits in the kernel's listen backlog (see the
    // backpressure note on acceptLoop).
    maxConn: i64 = 512,
    // After SIGTERM: how long requests in flight may keep running before the process
    // exits anyway.
    drainMs: i64 = 10000,
}

// ── Public API ──

// The IPv4 address `host` names: a dotted quad, or "localhost" for 127.0.0.1.
// No DNS: a server binds an address it owns, and a name that resolves elsewhere is
// a misconfiguration better refused at startup.
fn parseBindHost(host: &string): Option<u32> {
    if host == "localhost" {
        return Option.Some(ip4(127, 0, 0, 1))
    }
    if host.len == 0 || host.len >= 16 {
        return Option.None
    }
    var cbuf: [u8; 16] = [0; 16]
    for i in 0..host.len {
        cbuf[i] = host[i]
    }
    var out: u32 = 0
    unsafe {
        // AF_INET is 2 on every target std supports; out is filled in network order,
        // which is what a sockaddr_in (and ip4) holds.
        if inet_pton(2, cbuf as *u8, out.addrOf() as *u8) != 1 {
            return Option.None
        }
    }
    return Option.Some(out)
}

// Bind, listen and announce. Shared by every serve variant: two copies of a
// socket/bind/listen prologue is how one of them ends up with a setsockopt or an
// address-family fix the other never got. TcpListener.bindAddr is that one copy
// (SO_REUSEADDR, SIGPIPE ignored, Winsock init).
fn openListener(host: &string, port: u16?): Result<TcpListener> {
    var addr: u32 = 0
    if host != "0.0.0.0" {
        match parseBindHost(host) {
            Option.Some(a) => {
                addr = a
            }
            Option.None => {
                return Result.Err($"bind() failed: '{host}' is not an IPv4 address")
            }
        }
    }
    var bindPort: u16 = 0
    if let Option.Some(p) = port {
        bindPort = p
    }
    match TcpListener.bindAddr(addr, bindPort) {
        Result.Err(_e) => {
            return Result.Err("bind() failed")
        }
        Result.Ok(listener) => {
            let actualPort = listener.port()
            var shown: string = "localhost"
            if host != "0.0.0.0" {
                shown = host
            }
            print($"listening on http://{shown}:{actualPort}")
            return Result.Ok(listener)
        }
    }
}

// The listener's descriptor, for the accept loops. The listener keeps owning it.
fn listenerFd(l: &TcpListener): i32 {
    unsafe { return l.rawFd() }
}

// accept() on `listenFd`, discarding the peer address; -1 on failure. The address is
// storage-sized: accept lets the kernel pick the peer family, and a v6 peer does not
// fit a 16-byte sockaddr_in.
fn acceptPeer(listenFd: i32): i32 {
    unsafe {
        return sysAccept(listenFd)
    }
}

// acceptPeer for the one-at-a-time servers. While it blocks there is nothing in flight, so
// SIGTERM may end the process right there (termHandler). The flag is raised just before
// accept(); a signal in the few instructions between accept() returning and the flag
// dropping would lose that one connection to a reset, which a client retries.
fn acceptIdle(listenFd: i32): i32 {
    unsafe {
        gIdleAccept = 1
        // Raised first, then checked: a SIGTERM before the flag is seen here, one after it
        // exits in the handler.
        if gTerm == 1 {
            exit(0)
        }
    }
    let fd = acceptPeer(listenFd)
    unsafe { gIdleAccept = 0 }
    return fd
}

// The simplest server: every request goes to `handler`. Good for a static file server
// or a single-handler app. Answers one connection at a time, on every interface.
pub fn serve(port: u16?, handler: (&Request) => Response): Result<Unit> {
    let sock = openListener("0.0.0.0", port)?
    let listenFd = listenerFd(sock)
    installDrain(false)
    while true {
        let clientFd = acceptIdle(listenFd)
        if clientFd < 0 {
            continue
        }
        serveHandlerExchange((raw: &mut string): i64 => readMore(clientFd, &mut raw), (data: &string): void => fdWrite(clientFd, data), handler)
        closeFd(clientFd)
        if terminated() {
            exit(0)
        }
    }
    return Result.Err("server exited")
}

// ── Static files ──

// The response for a GET or HEAD of the file at `path`, or None when it is not a regular
// file this process can read. It carries the validators and answers conditional and
// range requests (RFC 9110 sections 8.8, 13 and 14):
//
//   ETag           strong, from the file's size and its modification time in nanoseconds
//                  ("<size hex>-<mtime ns hex>"), so a 304 costs a stat and no read
//   Last-Modified  the modification time, whole seconds
//   304            If-None-Match lists the ETag (or is *); without If-None-Match,
//                  If-Modified-Since is not before the modification time
//   206            a single satisfiable `Range: bytes=` range on a GET, with Content-Range;
//                  If-Range must name the current ETag or Last-Modified, else the whole file
//   416            a range that starts past the end, with `Content-Range: bytes */<size>`
//
// Several ranges get the whole file (200), which RFC 9110 allows. Cache-Control is left
// to the caller: whether a file may be cached is the app's knowledge, not the file's.
pub fn fileResponse(method: &string, reqHeaders: &Vec<Param>, path: &string, contentType: &string): Option<HandledResponse> {
    if !isFile(path) {
        return Option.None
    }
    let Option.Some(info) = fileInfo(path) else {
        return Option.None
    }
    let etag = "\"" + hexLen(info.size) + "-" + hexLen(info.mtimeNs) + "\""
    let mtimeSec = info.mtimeNs / 1000000000
    let lastModified = formatRfc2822(mtimeSec * 1000)
    var headers: Vec<Param> = [Param {
        name: "ETag", value: etag
    }, Param {
        name: "Last-Modified", value: lastModified
    }]
    if notModified(reqHeaders, etag, mtimeSec) {
        return Option.Some(HandledResponse {
            response: Response.Status(304, "", ""), headers: headers
        })
    }
    let Result.Ok(body) = readFile(path) else {
        return Option.None
    }
    headers.push(Param {
        name: "Accept-Ranges", value: "bytes"
    })
    let range = headerValue(reqHeaders, "Range")
    if method != "GET" || range.isNone() || !ifRangeHolds(reqHeaders, etag, lastModified) {
        return Option.Some(HandledResponse {
            response: Response.Status(200, contentType, body), headers: headers
        })
    }
    match parseRange(range ?? "", body.len) {
        RangeSpec.Whole => {
            return Option.Some(HandledResponse {
                response: Response.Status(200, contentType, body), headers: headers
            })
        }
        RangeSpec.Unsatisfiable => {
            headers.push(Param {
                name: "Content-Range", value: $"bytes */{body.len}"
            })
            return Option.Some(HandledResponse {
                response: Response.Status(416, "text/plain; charset=utf-8", statusText(416)), headers: headers
            })
        }
        RangeSpec.Part(first, last) => {
            headers.push(Param {
                name: "Content-Range", value: $"bytes {first}-{last}/{body.len}"
            })
            return Option.Some(HandledResponse {
                response: Response.Status(206, contentType, body.substr(first, last + 1)), headers: headers
            })
        }
    }
}

// The first value of request header `name`, case-insensitive.
fn headerValue(headers: &Vec<Param>, name: &string): Option<string> {
    for h in headers {
        if eqIgnoreCase(h.name, name) {
            return Option.Some(h.value)
        }
    }
    return Option.None
}

// Whether the conditional headers make this a 304. If-None-Match uses the weak
// comparison (a W/ prefix is ignored) and, when present, overrides If-Modified-Since
// (RFC 9110 13.2.2). An unparseable If-Modified-Since is ignored.
fn notModified(headers: &Vec<Param>, etag: &string, mtimeSec: i64): bool {
    if let Option.Some(inm) = headerValue(headers, "If-None-Match") {
        for raw in inm.split(",") {
            var tag = raw.trim()
            if tag == "*" {
                return true
            }
            if tag.startsWith("W/") {
                tag = tag.substr(2, tag.len)
            }
            if tag == etag {
                return true
            }
        }
        return false
    }
    let Option.Some(ims) = headerValue(headers, "If-Modified-Since") else {
        return false
    }
    let Result.Ok(ms) = parseRfc2822(ims) else {
        return false
    }
    return mtimeSec <= ms / 1000
}

// If-Range (RFC 9110 13.1.5): the range applies only when it names the current entity,
// by the strong ETag or by exactly the Last-Modified date. Absent, it always holds.
fn ifRangeHolds(headers: &Vec<Param>, etag: &string, lastModified: &string): bool {
    let Option.Some(v) = headerValue(headers, "If-Range") else {
        return true
    }
    let t = v.trim()
    return t == etag || t == lastModified
}

enum RangeSpec {
    // serve the whole representation: no usable range (several, or bad syntax)
    Whole,
    Unsatisfiable,
    // first and last byte offsets, inclusive
    Part(i64, i64),
}

// A `Range: bytes=` value against a body of `size` bytes. Bad syntax and multiple ranges
// read as Whole: a server may ignore Range, and must not fail the request over it.
fn parseRange(v: &string, size: i64): RangeSpec {
    let t = v.trim()
    if !t.toLower().startsWith("bytes=") {
        return RangeSpec.Whole
    }
    let spec = t.substr(6, t.len).trim()
    if spec.contains(",") {
        return RangeSpec.Whole
    }
    let Option.Some(dash) = spec.indexOf("-") else {
        return RangeSpec.Whole
    }
    let a = spec.substr(0, dash).trim()
    let b = spec.substr(dash + 1, spec.len).trim()
    if a.len == 0 {
        // suffix: the last N bytes
        let Option.Some(n) = strictLength(b) else {
            return RangeSpec.Whole
        }
        if n == 0 || size == 0 {
            return RangeSpec.Unsatisfiable
        }
        let first = if n >= size { 0 } else { size - n }
        return RangeSpec.Part(first, size - 1)
    }
    let Option.Some(first) = strictLength(a) else {
        return RangeSpec.Whole
    }
    var last = size - 1
    if b.len > 0 {
        let Option.Some(l) = strictLength(b) else {
            return RangeSpec.Whole
        }
        if l < first {
            return RangeSpec.Whole
        }
        if l < last {
            last = l
        }
    }
    if first >= size {
        return RangeSpec.Unsatisfiable
    }
    return RangeSpec.Part(first, last)
}

// ── Router ──

// A GET route that keeps its connection (see Router.stream).
pub struct StreamRoute {
    pattern: string,
    paramNames: Vec<string>,
    handler: (&mut Context, &mut Stream) => void,
}

// A GET route that upgrades to a WebSocket (see Router.ws).
pub struct WsRoute {
    pattern: string,
    paramNames: Vec<string>,
    handler: (&mut Context, &mut WebSocket) => void,
}

pub struct Route {
    method: string,
    pattern: string,
    paramNames: Vec<string>,
    handler: (&mut Context) => Response,
}

// Routes requests to handlers by method and path pattern (`/users/:id`), with
// middleware run around every handler.
pub struct Router {
    routes: Vec<Route>,
    streams: Vec<StreamRoute>,
    sockets: Vec<WsRoute>,
    middleware: Vec<(&mut Context, (&mut Context) => Response) => Response>,
    maxBodyBytes: i64,
    // 0: the same as maxBodyBytes
    maxInflatedBytes: i64,
}

// The decoded-size cap for a gzip/deflate request body.
fn inflatedLimit(r: &Router): i64 {
    return if r.maxInflatedBytes > 0 { r.maxInflatedBytes } else { r.maxBodyBytes }
}

impl Router {
    // An empty router.
    fn new(): Router {
        return Router {
            routes: [],
            streams: [],
            sockets: [],
            middleware: [],
            maxBodyBytes: defaultMaxBodyBytes,
            maxInflatedBytes: 0,
        }
    }

    // The largest request body this router's server accepts, in bytes (default 1 MiB).
    // A request declaring more is answered 413 before its body is read.
    fn setMaxBodySize(self: &mut Self, bytes: i64): void {
        self.maxBodyBytes = bytes
    }

    // The largest body a gzip or deflate request body may decompress to (default: the
    // max body size). Past it the request is answered 413, before the handler runs and
    // without holding more than this many decoded bytes.
    fn setMaxInflatedSize(self: &mut Self, bytes: i64): void {
        self.maxInflatedBytes = bytes
    }

    // Register a GET route. `:name` segments in `pattern` bind path parameters, read
    // with `ctx.param("name")`.
    fn get(self: &mut Self, pattern: string, h: move (&mut Context) => Response): void {
        self.addRoute("GET", pattern, h)
    }

    // Register a POST route.
    fn post(self: &mut Self, pattern: string, h: move (&mut Context) => Response): void {
        self.addRoute("POST", pattern, h)
    }

    // Register a PUT route.
    fn put(self: &mut Self, pattern: string, h: move (&mut Context) => Response): void {
        self.addRoute("PUT", pattern, h)
    }

    // Register a DELETE route.
    fn delete(self: &mut Self, pattern: string, h: move (&mut Context) => Response): void {
        self.addRoute("DELETE", pattern, h)
    }

    // Register a route that matches any method.
    fn all(self: &mut Self, pattern: string, h: move (&mut Context) => Response): void {
        self.addRoute("*", pattern, h)
    }

    // Register a GET route that keeps its connection: server-sent events, a long poll.
    // The handler gets the request's context and the connection as a `Stream`: it
    // either `open`s the stream and `send`s chunks for as long as it likes, or answers
    // with an ordinary `respond`. Other tasks reach the client through `conn.outbox()`.
    // The server owns the socket and closes it when the handler returns. Middleware does
    // not run, and only serveRouterConcurrent honours these routes, since one long-lived
    // stream would stall a server that answers one connection at a time.
    fn stream(self: &mut Self, pattern: string, h: move (&mut Context, &mut Stream) => void): void {
        let paramNames = extractParamNames(pattern)
        self.streams.push(StreamRoute {
            pattern: pattern,
            paramNames: paramNames,
            handler: h,
        })
    }

    // Register a WebSocket route. A GET on `pattern` asking to upgrade (`Upgrade:
    // websocket`) is answered 101 by the server, which then hands the handler the
    // connection as a `WebSocket`; a GET that does not ask falls through to the other
    // routes. Ping, pong and the close handshake are the server's, and so is a heartbeat:
    // a peer silent for a whole 30 s ping interval is dropped. The socket is closed (after
    // a close frame, if none went out) when the handler returns. As with `stream`, only
    // serveRouterConcurrent honours these routes.
    fn ws(self: &mut Self, pattern: string, h: move (&mut Context, &mut WebSocket) => void): void {
        let paramNames = extractParamNames(pattern)
        self.sockets.push(WsRoute {
            pattern: pattern,
            paramNames: paramNames,
            handler: h,
        })
    }

    // Add middleware. It receives the context and `next`, the rest of the chain, and
    // returns the response.
    fn use(self: &mut Self, mw: move (&mut Context, (&mut Context) => Response) => Response): void {
        self.middleware.push(mw)
    }

    fn addRoute(self: &mut Self, method: string, pattern: string, h: move (&mut Context) => Response): void {
        let paramNames = extractParamNames(pattern)
        self.routes.push(Route {
            method: method,
            pattern: pattern,
            paramNames: paramNames,
            handler: h,
        })
    }

    fn handle(self: &Self, req: Request): HandledResponse {
        // find matching route index + params first (borrowing req), then move req after the loop
        var matchIdx: i64 = -1
        var matchedParams: Vec<Param> = []
        for i in 0..self.routes.len {
            let route = self.routes[i]
            // a GET route answers HEAD too; the server then sends its headers only
            if route.method == "*" || route.method == req.method || (route.method == "GET" && req.method == "HEAD") {
                let params = matchRoute(route.pattern, route.paramNames, req.path)
                if let Option.Some(matched) = params {
                    matchIdx = i
                    matchedParams = matched
                    break
                }
            }
        }

        if matchIdx < 0 {
            return HandledResponse {
                response: Response.NotFound, headers: []
            }
        }

        var ctx = Context {
            req: req,
            params: matchedParams,
            statusCode: 200,
            respHeaders: [],
        }
        let handler = self.routes[matchIdx].handler
        if self.middleware.len == 0 {
            let resp = handler(&mut ctx)
            return HandledResponse {
                response: resp, headers: ctx.respHeaders
            }
        }
        // `final` owns the chain: each link owns the next one (captured as `next`) and
        // gives it to its middleware, which runs it; the caller frees it once that call
        // returns. A plain `(&mut Context) => Response` slot owns nothing, so the links
        // assigned into one were freed by nobody, one environment per request. The
        // innermost link wraps `handler` rather than being it: the route table owns the
        // handler, and an owning slot would free any environment it carries.
        var final: move (&mut Context) => Response = move(c: &mut Context) => {
            return handler(&mut c)
        }
        var m: i64 = self.middleware.len - 1
        while m >= 0 {
            let mw = self.middleware[m]
            let next = final
            // `move`: `mw` and `next` are this iteration's locals and `final` outlives
            // them. Captured by reference, every link read the last iteration's slots,
            // so two or more middleware recursed forever.
            final = move(c: &mut Context) => {
                return mw(&mut c, next)
            }
            m -= 1
        }
        let resp = final(&mut ctx)
        return HandledResponse {
            response: resp, headers: ctx.respHeaders
        }
    }
}

// Start an HTTP server using a Router (headers from Context are sent on the wire),
// on every interface. Answers one connection at a time.
pub fn serveRouter(port: u16?, router: &Router): Result<Unit> {
    return serveRouterOn("0.0.0.0", port, router)
}

// serveRouter bound to one IPv4 address: "127.0.0.1" (or "localhost") for a server
// that only a local reverse proxy should reach, "0.0.0.0" for every interface.
pub fn serveRouterOn(host: &string, port: u16?, router: &Router): Result<Unit> {
    let sock = openListener(host, port)?
    let listenFd = listenerFd(sock)
    installDrain(false)
    while true {
        let clientFd = acceptIdle(listenFd)
        if clientFd < 0 {
            continue
        }
        serveRouterExchange((raw: &mut string): i64 => readMore(clientFd, &mut raw), (data: &string): void => fdWrite(clientFd, data), router)
        closeFd(clientFd)
        if terminated() {
            exit(0)
        }
    }
    return Result.Err("server exited")
}

// A green task's socket is non-blocking, so one write() may be short. sendFd loops,
// parks only on EAGAIN, and gives up on any other error: a peer that hung up
// (EPIPE/ECONNRESET) must end the task, or it retries forever on EPOLLHUP.
// False once the peer is gone.
fn sendAll(fd: i32, buf: &string): bool {
    unsafe { return sendFd(fd, buf, buf.len) == buf.len }
}

// ── Long-lived connections: Stream and WebSocket ──
//
// A stream or ws route's connection belongs to its own task, and only that task touches
// the descriptor. Other tasks reach the client through an Outbox: a channel the
// connection's task drains while its handler is parked in `waitClosed` or `recv`
// (waitConn selects over the socket and the channel), or before the handler's own send.
// One writer per socket is what keeps two senders' bytes from interleaving mid-frame, and
// a sender that holds no descriptor cannot write to one the kernel has since reused.

// What another task asks a connection to do, through its Outbox.
enum OutMsg {
    Data(string),
    Close,
}

// The most messages an Outbox holds for a peer that is not reading. Past it the
// connection is dropped rather than buffered without bound.
let outboxCapacity: i64 = 1024

// A storable, cloneable sender to one Stream or WebSocket, for tasks other than the
// connection's own: a broadcast keeps a `Vec<Outbox>` and sends to each. Messages are
// queued and written by the connection's task. It holds no descriptor, so once the
// connection has ended `send` returns false and touches nothing.
pub struct Outbox {
    _ch: Channel<OutMsg>,
    // Set once the connection has ended or was dropped for falling behind.
    _gone: AtomicBool,
}

impl Outbox {
    // Queue `data`: one body chunk for a Stream, one text message for a WebSocket. Never
    // parks. False once the connection has ended, and also when the peer has 1024
    // messages still unwritten: a peer that far behind is not reading, so its connection
    // is dropped instead of buffered without bound.
    fn send(self: &Self, data: &string): bool {
        if self._gone.load() {
            return false
        }
        if self._ch.trySend(OutMsg.Data(data)) {
            return true
        }
        dropConnection(self)
        return false
    }

    // End the connection once what was queued before this is written: a Stream finishes
    // its body, a WebSocket sends its close frame.
    fn close(self: &Self): void {
        if self._gone.load() {
            return
        }
        if !self._ch.trySend(OutMsg.Close) {
            dropConnection(self)
        }
    }

    // Another sender to the same connection.
    fn clone(self: &Self): Outbox {
        return Outbox {
            _ch: self._ch.clone(), _gone: self._gone.clone()
        }
    }
}

// Mark the connection over and wake its task: a closed channel fires its select arm.
// A free fn because a method on a pub type is public.
fn dropConnection(o: &Outbox): void {
    o._gone.store(true)
    o._ch.close()
}

fn newOutbox(gone: bool): Outbox {
    // Channel.new fails only when malloc does.
    return Outbox {
        _ch: Channel<OutMsg>.new(outboxCapacity)!, _gone: AtomicBool.new(gone)
    }
}

// The connection's outbox handle for a new sender, created on first use: most
// connections never get one, and the channel's ring is allocated up front.
fn outboxOf(out: &mut Option<Outbox>, ended: bool): Outbox {
    if let Option.Some(o) = out {
        return o.clone()
    }
    let o = newOutbox(ended)
    out = Option.Some(o.clone())
    return o
}

// The next queued message, if any.
fn nextOut(out: &Option<Outbox>): Option<OutMsg> {
    if let Option.Some(o) = out {
        return o._ch.tryRecv()
    }
    return Option.None
}

// True when the outbox was dropped (by `dropConnection`) and nothing is left in it.
fn outDropped(out: &Option<Outbox>): bool {
    if let Option.Some(o) = out {
        return o._gone.load() && o._ch.len() == 0
    }
    return false
}

fn endOut(out: &Option<Outbox>): void {
    if let Option.Some(o) = out {
        dropConnection(o)
    }
}

// The connection's descriptor lent to one Select wait. The connection task owns it and
// is the one waiting, so it is open for the whole wait.
struct SockRef {
    fd: i32,
}

impl AsFd for SockRef {
    @unsafe
    fn rawFd(self: &Self): i32 {
        return self.fd
    }
}

let wakeRead: i64 = 0
let wakeOut: i64 = 1
let wakeTimeout: i64 = 2
// The server began draining (SIGTERM): the connection should wind down now.
let wakeDrain: i64 = 3

// Park the connection's task until its socket is readable, its outbox holds something
// (or was dropped), `timeoutMs` passes (< 0: never), or the server starts draining.
fn waitConn(fd: i32, out: &Option<Outbox>, timeoutMs: i64): i64 {
    var sel = Select.new()
    sel.onRead(SockRef {
        fd: fd
    })
    var arm: i64 = 1
    var outArm: i64 = -1
    if let Option.Some(o) = out {
        sel.onRecv(o._ch)
        outArm = arm
        arm += 1
    }
    var timeoutArm: i64 = -1
    if timeoutMs >= 0 {
        sel.onTimeout(timeoutMs)
        timeoutArm = arm
        arm += 1
    }
    // The drain pipe stays readable once SIGTERM wrote to it, so it wakes this wait and
    // every later one: a long-lived connection must not hold the drain to its cap.
    var drainArm: i64 = -1
    let drainFd = drainWatchFd()
    if drainFd >= 0 {
        sel.onRead(SockRef {
            fd: drainFd
        })
        drainArm = arm
    }
    let w = sel.wait()
    if w > 0 && w == outArm {
        return wakeOut
    }
    if w > 0 && w == drainArm {
        return wakeDrain
    }
    if w > 0 && w == timeoutArm {
        return wakeTimeout
    }
    // 0, or -1 with no scheduler: the next read decides (it blocks if it must).
    return wakeRead
}

// Read and discard what the peer sent. False once it has closed or the read failed.
fn discardInput(fd: i32): bool {
    var scratch: string = ""
    return readMore(fd, &mut scratch) > 0
}

fn hexLen(n: i64): string {
    let digits = "0123456789abcdef"
    if n == 0 {
        return "0"
    }
    var out: string = ""
    var v = n
    while v > 0 {
        out = digits.substr(v % 16, v % 16 + 1) + out
        v = v / 16
    }
    return out
}

// One chunk of a chunked body (RFC 9112 7.1). An empty `data` is no chunk at all: a
// zero-length chunk is the end of the body.
fn chunkOf(data: &string): string {
    if data.len == 0 {
        return ""
    }
    return hexLen(data.len) + "\r\n" + data + "\r\n"
}

// Stream states.
let streamFresh: i32 = 0
let streamOpen: i32 = 1
let streamEnded: i32 = 2

// A stream route's connection (see Router.stream): a 200 response whose body the
// handler writes in chunks for as long as the client stays.
pub struct Stream {
    _fd: i32,
    _state: i32,
    // The head `open` built. It goes out with the first chunk, so a client sees the
    // headers and the first event in one segment.
    _head: string,
    _out: Option<Outbox>,
}

impl Stream {
    // Start the response: 200, Content-Type `contentType` and `headers`, with the body
    // sent in chunks (Transfer-Encoding: chunked). Framing headers in `headers`
    // (Content-Length, Connection, Transfer-Encoding) are dropped: the stream writes its
    // own. No effect once the stream is open or answered.
    fn open(self: &mut Self, contentType: &string, headers: &Vec<Param>): void {
        if self._state != streamFresh {
            return
        }
        var head: string = "HTTP/1.1 200 OK"
        if contentType.len > 0 && !hasHeader(headers, "Content-Type") {
            head.pushStr("\r\nContent-Type: " + headerSafe(contentType))
        }
        for h in headers {
            if !isFramingHeader(h.name) {
                head.pushStr("\r\n" + headerSafe(h.name) + ": " + headerSafe(h.value))
            }
        }
        head.pushStr("\r\nTransfer-Encoding: chunked\r\n\r\n")
        self._head = head
        self._state = streamOpen
    }

    // Write `data` as one body chunk, after anything already queued in the outbox. False
    // before `open` and once the client is gone. An empty `data` writes nothing.
    fn send(self: &mut Self, data: &string): bool {
        streamPump(&mut self)
        if self._state != streamOpen {
            return false
        }
        return streamWrite(&mut self, chunkOf(data))
    }

    // Answer with an ordinary response instead of a stream (a 404 for an unknown feed).
    // The stream is over afterwards. No effect once the stream is open or answered.
    fn respond(self: &mut Self, response: &Response, headers: &Vec<Param>): void {
        if self._state != streamFresh {
            return
        }
        let _ = sendAll(self._fd, renderResponse(response, headers))
        endStream(&mut self)
    }

    // Park until the client goes away or the stream is ended through its outbox, writing
    // what other tasks queue meanwhile. Anything the client sends is discarded.
    fn waitClosed(self: &mut Self): void {
        if self._state == streamOpen && self._head.len > 0 {
            let _ = streamWrite(&mut self, "")
        }
        while self._state != streamEnded {
            let w = waitConn(self._fd, self._out, -1)
            if w == wakeDrain {
                streamPump(&mut self)
                endStream(&mut self)
            } else if w == wakeRead {
                if !discardInput(self._fd) {
                    endStream(&mut self)
                }
            } else {
                streamPump(&mut self)
            }
        }
    }

    // A sender other tasks can keep to write to this stream (see Outbox). Once the
    // stream is over its `send` returns false.
    fn outbox(self: &mut Self): Outbox {
        return outboxOf(&mut self._out, self._state == streamEnded)
    }
}

// Write the pending head, if any, and `bytes` in one write. False (and the stream
// over) if the client is gone.
fn streamWrite(s: &mut Stream, bytes: &string): bool {
    var buf = s._head + bytes
    s._head = ""
    if buf.len == 0 {
        return true
    }
    if !sendAll(s._fd, buf) {
        endStream(&mut s)
        return false
    }
    return true
}

// Write what other tasks queued. Data queued before `open` is dropped: there is no
// response to put it in yet.
fn streamPump(s: &mut Stream): void {
    while s._state != streamEnded {
        match nextOut(s._out) {
            Option.Some(OutMsg.Data(d)) => {
                if s._state == streamOpen {
                    let _ = streamWrite(&mut s, chunkOf(d))
                }
            }
            Option.Some(OutMsg.Close) => {
                finishStream(&mut s)
            }
            Option.None => {
                if outDropped(s._out) {
                    endStream(&mut s)
                }
                return
            }
        }
    }
}

fn endStream(s: &mut Stream): void {
    s._state = streamEnded
    endOut(s._out)
}

// End the response properly: the last chunk for an open stream, a 500 for a handler
// that neither opened nor answered.
fn finishStream(s: &mut Stream): void {
    if s._state == streamFresh {
        let noHeaders: Vec<Param> = []
        let _ = sendAll(s._fd, renderRaw(500, "text/plain; charset=utf-8", statusText(500), noHeaders))
    } else if s._state == streamOpen {
        let _ = streamWrite(&mut s, "0\r\n\r\n")
    }
    endStream(&mut s)
}

// How often a WebSocket pings a quiet peer; one silent for a whole interval after a
// ping is dropped.
let wsPingIntervalMs: i64 = 30000

// A ws route's connection (see Router.ws), already upgraded.
pub struct WebSocket {
    _fd: i32,
    // Bytes read that do not make a whole frame yet.
    _in: string,
    // The fragments of a message still arriving.
    _msg: string,
    _inMessage: bool,
    _closeSent: bool,
    _ended: bool,
    _maxMessage: i64,
    // Whether the peer sent anything since the last heartbeat.
    _heard: bool,
    _nextTick: i64,
    _out: Option<Outbox>,
}

impl WebSocket {
    // The next text or binary message's payload, or None once the connection is over:
    // the peer closed it, broke the protocol, sent a message over the size limit, or went
    // silent. Pings are answered and pongs absorbed here, and what other tasks queue in
    // the outbox is written while this waits.
    fn recv(self: &mut Self): Option<string> {
        while !self._ended {
            match parseWsFrame(self._in, self._maxMessage - self._msg.len) {
                WsFrameParse.Frame(f) => {
                    self._in = self._in.substr(f.size, self._in.len)
                    if let Option.Some(m) = wsFrame(&mut self, f.opcode, f.fin, f.masked, f.payload) {
                        return Option.Some(m)
                    }
                }
                WsFrameParse.Incomplete => {
                    wsWait(&mut self)
                }
                WsFrameParse.TooBig => {
                    wsFail(&mut self, 1009)
                }
                WsFrameParse.Invalid => {
                    wsFail(&mut self, 1002)
                }
            }
        }
        return Option.None
    }

    // Send `msg` as a text message, after anything already queued in the outbox. False
    // once the connection is over or closing.
    fn sendText(self: &mut Self, msg: &string): bool {
        wsPump(&mut self)
        if self._ended || self._closeSent {
            return false
        }
        return wsWrite(&mut self, 1, msg)
    }

    // Start the close handshake (status 1000) after what the outbox holds. `recv` then
    // returns None once the peer answers.
    fn close(self: &mut Self): void {
        wsPump(&mut self)
        if !self._ended && !self._closeSent {
            wsSendClose(&mut self, 1000)
        }
    }

    // The largest message `recv` accepts, in bytes (default 1 MiB). A longer one closes
    // the connection with status 1009 before its payload is buffered.
    fn setMaxMessageSize(self: &mut Self, bytes: i64): void {
        self._maxMessage = bytes
    }

    // A sender other tasks can keep to write to this socket (see Outbox). Once the
    // connection is over its `send` returns false.
    fn outbox(self: &mut Self): Outbox {
        return outboxOf(&mut self._out, self._ended)
    }
}

// Act on one frame; Some(payload) when it completes a data message.
fn wsFrame(ws: &mut WebSocket, opcode: i32, fin: bool, masked: bool, payload: string): Option<string> {
    ws._heard = true
    // RFC 6455 5.1: a server must fail a connection whose client frames are unmasked.
    if !masked {
        wsFail(&mut ws, 1002)
        return Option.None
    }
    if opcode == 9 {
        if !ws._closeSent {
            let _ = wsWrite(&mut ws, 10, payload)
        }
        return Option.None
    }
    if opcode == 10 {
        return Option.None
    }
    if opcode == 8 {
        if !ws._closeSent {
            // Echo the peer's status code, as RFC 6455 5.5.1 suggests.
            var echo: string = ""
            if payload.len >= 2 {
                echo = payload.substr(0, 2)
            }
            let _ = wsWrite(&mut ws, 8, echo)
            ws._closeSent = true
        }
        wsEnd(&mut ws)
        return Option.None
    }
    if opcode == 0 {
        if !ws._inMessage {
            wsFail(&mut ws, 1002)
            return Option.None
        }
        ws._msg.pushStr(payload)
        if !fin {
            return Option.None
        }
        ws._inMessage = false
        return Option.Some(replace(ws._msg, ""))
    }
    // A new data frame while a fragmented message is still arriving is a protocol error.
    if ws._inMessage {
        wsFail(&mut ws, 1002)
        return Option.None
    }
    if fin {
        return Option.Some(payload)
    }
    ws._msg = payload
    ws._inMessage = true
    return Option.None
}

// Wait for more of the peer's bytes, writing the outbox and running the heartbeat
// meanwhile.
fn wsWait(ws: &mut WebSocket): void {
    let now = unrecordedEpochMillis()
    if now >= ws._nextTick {
        wsTick(&mut ws, now)
        return
    }
    let w = waitConn(ws._fd, ws._out, ws._nextTick - now)
    if w == wakeOut {
        wsPump(&mut ws)
    } else if w == wakeTimeout {
        wsTick(&mut ws, unrecordedEpochMillis())
    } else if w == wakeDrain {
        // 1001: going away, the code for a server shutting down
        wsFail(&mut ws, 1001)
    } else {
        if readMore(ws._fd, &mut ws._in) <= 0 {
            wsEnd(&mut ws)
        }
    }
}

// One heartbeat: drop a peer that has said nothing since the last one, ping the rest.
fn wsTick(ws: &mut WebSocket, now: i64): void {
    if !ws._heard {
        wsEnd(&mut ws)
        return
    }
    ws._heard = false
    ws._nextTick = now + wsPingIntervalMs
    if !ws._closeSent {
        let _ = wsWrite(&mut ws, 9, "")
    }
}

// Write what other tasks queued.
fn wsPump(ws: &mut WebSocket): void {
    while !ws._ended {
        match nextOut(ws._out) {
            Option.Some(OutMsg.Data(d)) => {
                if !ws._closeSent {
                    let _ = wsWrite(&mut ws, 1, d)
                }
            }
            Option.Some(OutMsg.Close) => {
                if !ws._closeSent {
                    wsSendClose(&mut ws, 1000)
                }
            }
            Option.None => {
                if outDropped(ws._out) {
                    wsEnd(&mut ws)
                }
                return
            }
        }
    }
}

// Write one unfragmented frame. False (and the connection over) if the peer is gone.
fn wsWrite(ws: &mut WebSocket, opcode: i32, payload: &string): bool {
    if !sendAll(ws._fd, encodeWsFrame(opcode, payload, true, "")) {
        wsEnd(&mut ws)
        return false
    }
    return true
}

fn wsSendClose(ws: &mut WebSocket, code: i32): void {
    var payload: string = ""
    payload.push(((code >> 8) & 255) as u8)
    payload.push((code & 255) as u8)
    let _ = wsWrite(&mut ws, 8, payload)
    ws._closeSent = true
}

// Close with `code` and stop: the peer broke the protocol or the size limit.
fn wsFail(ws: &mut WebSocket, code: i32): void {
    if !ws._closeSent {
        wsSendClose(&mut ws, code)
    }
    wsEnd(&mut ws)
}

fn wsEnd(ws: &mut WebSocket): void {
    ws._ended = true
    endOut(ws._out)
}

// After the handler returns: flush the outbox and send a close frame if none went out.
fn finishWs(ws: &mut WebSocket): void {
    wsPump(&mut ws)
    if !ws._ended && !ws._closeSent {
        wsSendClose(&mut ws, 1000)
    }
    wsEnd(&mut ws)
}

// Whether `req` asks to become a WebSocket (`Upgrade: websocket`, any case).
fn isUpgradeRequest(req: &Request): bool {
    for h in req.headers {
        if eqIgnoreCase(h.name, "Upgrade") && h.value.toLower().contains("websocket") {
            return true
        }
    }
    return false
}

fn requestHeader(req: &Request, name: &string): string {
    for h in req.headers {
        if eqIgnoreCase(h.name, name) {
            return h.value
        }
    }
    return ""
}

// Upgrade the connection and run a ws route's handler on it.
fn runWsRoute(req: &Request, fd: i32, params: Vec<Param>, handler: (&mut Context, &mut WebSocket) => void): void {
    let key = requestHeader(req, "Sec-WebSocket-Key")
    if key.len == 0 {
        let noHeaders: Vec<Param> = []
        let _ = sendAll(fd, renderRaw(400, "text/plain; charset=utf-8", statusText(400), noHeaders))
        return
    }
    let accept = "HTTP/1.1 101 Switching Protocols\r\nUpgrade: websocket\r\nConnection: Upgrade\r\nSec-WebSocket-Accept: " + computeAcceptKey(key) + "\r\n\r\n"
    if !sendAll(fd, accept) {
        return
    }
    var ctx = Context {
        req: req.clone(),
        params: params,
        statusCode: 200,
        respHeaders: [],
    }
    var ws = WebSocket {
        _fd: fd,
        _in: "",
        _msg: "",
        _inMessage: false,
        _closeSent: false,
        _ended: false,
        _maxMessage: defaultMaxBodyBytes,
        _heard: true,
        _nextTick: unrecordedEpochMillis() + wsPingIntervalMs,
        _out: Option.None,
    }
    handler(&mut ctx, &mut ws)
    finishWs(&mut ws)
}

// Run the stream or ws route matching `req`, if any. False means none matched and `req`
// is untouched for the normal path. A free fn, not a Router method: it takes the
// connection's raw fd, and methods on a pub type are public.
fn runLongRoute(req: &Request, fd: i32, router: &Router): bool {
    if req.method != "GET" {
        return false
    }
    if isUpgradeRequest(req) {
        for i in 0..router.sockets.len {
            if let Option.Some(matched) = matchRoute(router.sockets[i].pattern, router.sockets[i].paramNames, req.path) {
                runWsRoute(req, fd, matched, router.sockets[i].handler)
                return true
            }
        }
    }
    for i in 0..router.streams.len {
        if let Option.Some(matched) = matchRoute(router.streams[i].pattern, router.streams[i].paramNames, req.path) {
            var ctx = Context {
                req: req.clone(),
                params: matched,
                statusCode: 200,
                respHeaders: [],
            }
            var conn = Stream {
                _fd: fd, _state: streamFresh, _head: "", _out: Option.None
            }
            let handler = router.streams[i].handler
            handler(&mut ctx, &mut conn)
            streamPump(&mut conn)
            finishStream(&mut conn)
            return true
        }
    }
    return false
}

// One connection in its own green task. Every read parks on EAGAIN (recvFd), so a
// client trickling its request in stalls only this task; one that closes mid-request
// ends it with the fd closed.
// "GET /path?a=1&b=2", as the client sent it.
fn requestLine(req: &Request): string {
    var out = req.method + " " + req.path
    if req.rawQuery.len > 0 {
        out.push('?')
        out.pushStr(req.rawQuery)
    }
    return out
}

// What a client gets if its request's handler panics (index out of bounds, overflow,
// a failed assert): an answer instead of a reset, while the server keeps running.
let PANIC_REPLY = "HTTP/1.1 500 Internal Server Error\r\nContent-Type: text/plain; charset=utf-8\r\nContent-Length: 25\r\nConnection: close\r\n\r\n500 Internal Server Error"

fn handleConn(clientFd: i32, router: &Router): void {
    unsafe { taskOnPanicReply(clientFd, PANIC_REPLY) }
    serveExchange((raw: &mut string): i64 => readMore(clientFd, &mut raw), (data: &string): void => fdWrite(clientFd, data), router.maxBodyBytes, inflatedLimit(router), (req: Request): string => {
        taskOnPanicNote(requestLine(req))
        // A stream or ws route has already written everything it will; nothing more to send.
        if runLongRoute(req, clientFd, router) {
            return ""
        }
        let head = req.method == "HEAD"
        let handled = router.handle(req)
        if head {
            return headOnly(renderResponse(handled.response, handled.headers))
        }
        return renderResponse(handled.response, handled.headers)
    })
    closeFd(clientFd)
}

// One connection task: take the next accepted fd and serve it. The fd comes over a
// channel because a scoped task may borrow only what outlives the scope body, and
// each fd is a body local (a by-reference capture would see the next accept's fd).
// `done` tells a capped accept loop that a slot has opened.
fn serveNextConn(fds: &Channel<i32>, router: &Router, done: &Channel<i32>): void {
    match fds.recv() {
        Result.Ok(clientFd) => {
            handleConn(clientFd, router)
            // Full means a wake-up is already pending, which is all one is for.
            let _ = done.trySend(0)
        }
        Result.Err(_e) => {
            return
        }
    }
}

// The accept loop, run as a green task. Every connection is a task on this
// function's own Task.scope, so each borrows `router` from the caller's frame rather
// than from a global, and the scope keeps that frame alive while any of them runs.
//
// Backpressure design: at `maxConn` connections in flight the loop stops calling
// accept() until one finishes. The excess then waits in the kernel's listen backlog
// (1024, capped by somaxconn), which is bounded; past it the kernel drops SYNs and
// clients retransmit. So memory is bounded by maxConn tasks and never by the offered load:
// a reverse proxy in front (nginx) times out the wait, where an unbounded
// task-per-connection server would grow until the OOM killer takes a 1 GB droplet.
//
// On SIGTERM (see "Graceful drain") it closes this process's copy of the listener,
// waits for the connections in flight, and exits. Under socket activation the service
// manager still holds the socket, so new connections queue for the next process.
fn acceptLoop(listenFd: i32, fds: &Channel<i32>, router: &Router, maxConn: i64, drainMs: i64): void {
    let done = Channel<i32>.new(1)!
    Task.scope((s) => {
        while !terminated() {
            // The scope's own live count is the in-flight number, and the one that
            // cannot drift: a handler that panics is reaped like any other task, where
            // a counter decremented at the end of the handler would leak its slot.
            if s.live() >= maxConn {
                var capSel = Select.new()
                capSel.onRecv(done)
                armDrain(&mut capSel)
                // The timeout is a safety net for a slot freed with no wake-up (a panicked
                // task runs no code at its end).
                capSel.onTimeout(100)
                capSel.wait()
                let _t = done.tryRecv()
                continue
            }
            let clientFd = acceptPeer(listenFd)
            if clientFd < 0 {
                var idleSel = Select.new()
                idleSel.onRead(SockRef {
                    fd: listenFd
                })
                armDrain(&mut idleSel)
                idleSel.wait()
                continue
            }
            // clientFd was just accepted; nothing else holds it until the send below.
            unsafe { setNonblocking(clientFd) }
            s.spawn(() => serveNextConn(fds, router, done))
            // Parks only while the buffer holds 64 fds whose tasks have not run yet.
            // It cannot fail: only a closed channel refuses, and nothing closes this one.
            fds.send(clientFd)!
        }
        // Draining. Closing stops new accepts here; connections already queued in the
        // kernel stay with whoever else holds the socket.
        unsafe { sysClose(listenFd) }
        let deadline = unrecordedEpochMillis() + drainMs
        while s.live() > 0 {
            if unrecordedEpochMillis() >= deadline {
                print("drain timeout: exiting with connections still open")
                exit(0)
            }
            sleepMs(5)
        }
    })
}

// Arm the drain pipe, if the server has one, on `sel`.
fn armDrain(sel: &mut Select): void {
    let fd = drainWatchFd()
    if fd >= 0 {
        sel.onRead(SockRef {
            fd: fd
        })
    }
}

// Like serveRouter, but each connection is handled in its own green task.
//
// serveRouter answers one connection at a time, which is fine while every
// handler is pure computation over embedded data. It stops being fine the
// moment a handler talks to the network: one slow upstream then stalls every
// other client for the whole round trip. Handlers that fetch need this loop.
//
// Never returns once listening, except by exiting the process 0 after a SIGTERM drain
// (ServeOptions); a listener that cannot be opened is an Err. The
// scheduler drives the accept task, the handlers it spawns and any task the caller
// spawned earlier, exactly as a green-threaded server's main is supposed to.
pub fn serveRouterConcurrent(port: u16?, router: Router): Result<Unit> {
    return serveRouterConcurrentOn("0.0.0.0", port, router)
}

// serveRouterConcurrent bound to one IPv4 address (see serveRouterOn).
pub fn serveRouterConcurrentOn(host: &string, port: u16?, router: Router): Result<Unit> {
    return serveRouterConcurrentWith(host, port, router, ServeOptions {
    })
}

// serveRouterConcurrentOn with its limits spelled out: the connection cap and the SIGTERM
// drain deadline (ServeOptions).
pub fn serveRouterConcurrentWith(host: &string, port: u16?, router: Router, opts: &ServeOptions): Result<Unit> {
    let sock = openListener(host, port)?
    let listenFd = listenerFd(sock)
    // acceptLoop owns the descriptor from here: it closes it when draining, and a
    // second close from the listener's drop could hit a descriptor reused since.
    forget(sock)
    let fds = Channel<i32>.new(64)?
    // accept() has no green-aware wrapper: on a blocking listener it parks the
    // OS thread and no other task ever runs. Non-blocking plus an explicit
    // kqueue/epoll wait is what makes the accept loop a cooperating task.
    unsafe { setNonblocking(listenFd) }
    installDrain(true)
    var maxConn = opts.maxConn
    if maxConn < 1 {
        maxConn = 1
    }
    let drainMs = opts.drainMs
    // The accept loop is a scoped task rather than this body, so it is a green task
    // (and schedulerWaitRead parks it) even when the caller is not; the join below
    // then drives the scheduler for good, as schedulerRunToCompletion used to.
    Task.scope((s) => {
        s.spawn(() => acceptLoop(listenFd, fds, router, maxConn, drainMs))
    })
    if terminated() {
        exit(0)
    }
    return Result.Err("server exited")
}

// ── Path matching ──

fn extractParamNames(pattern: &string): Vec<string> {
    var names: Vec<string> = []
    var i: i64 = 0
    while i < pattern.len {
        if pattern[i] == ':' {
            var j: i64 = i + 1
            while j < pattern.len && pattern[j] != '/' {
                j += 1
            }
            var name: string = ""
            var k: i64 = i + 1
            while k < j {
                name.push(pattern[k])
                k += 1
            }
            names.push(name)
            i = j
        } else {
            i += 1
        }
    }
    return names
}

fn matchRoute(pattern: &string, paramNames: &Vec<string>, path: &string): Option<Vec<Param>> {
    let patSegs = splitPath(pattern)
    let pathSegs = splitPath(path)

    var hasWildcard: bool = false
    if patSegs.len > 0 && patSegs[patSegs.len - 1] == "*" {
        hasWildcard = true
    }

    if !hasWildcard && patSegs.len != pathSegs.len {
        return Option.None
    }
    if hasWildcard && pathSegs.len < patSegs.len - 1 {
        return Option.None
    }

    var params: Vec<Param> = []
    var paramIdx: i64 = 0
    var segCount: i64 = patSegs.len
    if hasWildcard {
        segCount -= 1
    }

    for i in 0..segCount {
        let pat = patSegs[i]
        if i >= pathSegs.len {
            return Option.None
        }
        let seg = pathSegs[i]
        if pat.len > 0 && pat[0] == ':' {
            if paramIdx < paramNames.len {
                params.push(Param {
                    name: paramNames[paramIdx], value: seg
                })
                paramIdx += 1
            }
        } else if pat != seg {
            return Option.None
        }
    }
    return Option.Some(params)
}

fn splitPath(path: &string): Vec<string> {
    var segs: Vec<string> = []
    var current: string = ""
    for ch in path {
        if ch == '/' {
            if current.len > 0 {
                segs.push(current)
                current = ""
            }
        } else {
            current.push(ch)
        }
    }
    if current.len > 0 {
        segs.push(current)
    }
    return segs
}
