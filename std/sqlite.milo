// std/sqlite — SQLite3 database bindings
//
// Requires libsqlite3, linked via the @link below. The driver used to add the
// flag by grepping emitted IR for "@sqlite3_" against a hardcoded Homebrew
// path — which put one vendor's API name into a general-purpose compiler's
// vocabulary, matched any symbol that merely contained that substring, and
// resolved to a path that only exists on an arm64 Mac with Homebrew.
//
//   let db = dbOpen("app.db")!
//   dbExec(db, "CREATE TABLE users (id INTEGER PRIMARY KEY, name TEXT)")!
//   dbExec(db, "INSERT INTO users (name) VALUES ('alice')")!
//   let stmt = dbQuery(db, "SELECT id, name FROM users")!
//   while dbStep(stmt) {
//       print($"{dbColumnInt(stmt, 0)} {dbColumnText(stmt, 1)}")
//   }
//
// Both handles close themselves when they go out of scope. `dbFinalize(stmt)` and
// `dbClose(db)` do it early and consume the handle, so it cannot be used afterwards.

@link("sqlite3")
pub extern fn sqlite3_open(filename: *u8, db: *u8): i32

pub extern fn sqlite3_close(db: *u8): i32

// The Drop below uses this one, not sqlite3_close: with a Statement still alive,
// sqlite3_close fails with SQLITE_BUSY and the connection leaks, while close_v2 defers
// the free until the last statement is finalized. That is what makes a Statement that
// outlives its Database (they are dropped in either order) sound.
pub extern fn sqlite3_close_v2(db: *u8): i32

pub extern fn sqlite3_exec(db: *u8, sql: *u8, callback: *u8, arg: *u8, errmsg: *u8): i32

pub extern fn sqlite3_prepare_v2(db: *u8, sql: *u8, nByte: i32, stmt: *u8, tail: *u8): i32

pub extern fn sqlite3_step(stmt: *u8): i32

pub extern fn sqlite3_finalize(stmt: *u8): i32

pub extern fn sqlite3_column_int(stmt: *u8, col: i32): i32

pub extern fn sqlite3_column_int64(stmt: *u8, col: i32): i64

pub extern fn sqlite3_column_double(stmt: *u8, col: i32): f64

pub extern fn sqlite3_column_text(stmt: *u8, col: i32): *u8

pub extern fn sqlite3_column_bytes(stmt: *u8, col: i32): i32

pub extern fn sqlite3_column_count(stmt: *u8): i32

pub extern fn sqlite3_column_type(stmt: *u8, col: i32): i32

pub extern fn sqlite3_bind_int(stmt: *u8, idx: i32, val: i32): i32

pub extern fn sqlite3_bind_int64(stmt: *u8, idx: i32, val: i64): i32

pub extern fn sqlite3_bind_double(stmt: *u8, idx: i32, val: f64): i32

pub extern fn sqlite3_bind_text(stmt: *u8, idx: i32, text: *u8, n: i32, destructor: *u8): i32

pub extern fn sqlite3_bind_null(stmt: *u8, idx: i32): i32

pub extern fn sqlite3_reset(stmt: *u8): i32

pub extern fn sqlite3_errmsg(db: *u8): *u8

pub extern fn sqlite3_db_handle(stmt: *u8): *u8

pub extern fn sqlite3_changes(db: *u8): i32

pub extern fn sqlite3_last_insert_rowid(db: *u8): i64

// An open SQLite3 connection, closed when it goes out of scope (or by `dbClose`).
//
// Both handles own what sqlite handed back, so the pointer fields make them
// move-tracked: a second copy would `close`/`finalize` the same object again.
pub struct Database {
    _handle: *u8,
}

impl Drop for Database {
    fn drop(self: &mut Self): void {
        if self._handle != 0 as *u8 {
            unsafe { sqlite3_close_v2(self._handle) }
            self._handle = 0 as *u8
        }
    }
}

// A prepared SQL statement, finalized when it goes out of scope (or by `dbFinalize`).
pub struct Statement {
    _handle: *u8,
}

impl Drop for Statement {
    fn drop(self: &mut Self): void {
        if self._handle != 0 as *u8 {
            unsafe { sqlite3_finalize(self._handle) }
            self._handle = 0 as *u8
        }
    }
}

impl Database {
    // The raw `sqlite3*`, for callers that reach sqlite3 functions this module does not
    // wrap. Borrowed: the Database still owns and closes it.
    fn handle(self: &Self): *u8 {
        return self._handle
    }
}

impl Statement {
    // The raw `sqlite3_stmt*`, for callers that reach sqlite3 functions this module does
    // not wrap. Borrowed: the Statement still owns and finalizes it.
    fn handle(self: &Self): *u8 {
        return self._handle
    }
}

// Open or create the database at `path`. `":memory:"` opens an in-memory database.
pub fn dbOpen(path: string): Result<Database> {
    unsafe {
        var handle: *u8 = 0 as *u8
        let rc = sqlite3_open(path, (handle.addrOf()) as *u8)
        if rc != 0 {
            if handle != 0 as *u8 {
                sqlite3_close(handle)
            }
            return Result.Err("sqlite3_open failed")
        }
        return Result.Ok(Database { _handle: handle })
    }
}

// Close the connection now rather than at the end of its scope. It consumes `db`:
// taking it by reference left a closed handle usable, and the next call on it was a
// use-after-free. Statements still alive keep working; see `sqlite3_close_v2`.
pub fn dbClose(db: Database): void {
    var d = db
    // Drop runs at the end of this fn; spelled out so the close is visible here.
    d.drop()
}

// Execute SQL that returns no rows (CREATE, INSERT, UPDATE, DELETE). Errs with sqlite's
// message.
pub fn dbExec(db: &Database, sql: string): Result<i32> {
    unsafe {
        let rc = sqlite3_exec(db._handle, sql, 0 as *u8, 0 as *u8, 0 as *u8)
        if rc != 0 {
            let msg = _cstrToString(sqlite3_errmsg(db._handle))
            return Result.Err(msg)
        }
        return Result.Ok(sqlite3_changes(db._handle))
    }
}

// An open transaction. Rolls back when it goes out of scope; `commit()` is the only way
// to keep the writes. Move-only (the raw handle makes it move-tracked), and `commit` /
// `rollback` consume it, so it cannot be used afterwards.
//
//   let tx = dbBegin(db)?
//   dbExec(db, "INSERT ...")?     // an early return via `?` drops tx -> ROLLBACK
//   tx.commit()?
pub struct Transaction {
    _handle: *u8,
    // A never-stepped prepared statement whose only job is to keep the connection alive:
    // sqlite3_close_v2 defers the free until the last statement is finalized, so a
    // `dbClose(db)` while the guard lives cannot leave the Drop below running on a freed
    // sqlite3*.
    _pin: Statement,
    done: bool,
}

impl Drop for Transaction {
    fn drop(self: &mut Self): void {
        // Rollback is the one implicit effect (it is what makes `?` inside a transaction
        // safe); commit is always explicit. Its error is ignored: nothing can act on it.
        if !self.done {
            self.done = true
            unsafe { sqlite3_exec(self._handle, "ROLLBACK", 0 as *u8, 0 as *u8, 0 as *u8) }
        }
    }
}

impl Transaction {
    // COMMIT, consuming the guard. On Err the transaction is still open in sqlite
    // (e.g. SQLITE_BUSY), so the guard rolls it back as it drops at the end of this fn.
    fn commit(self: Self): Result<i32> {
        var t = self
        unsafe {
            let rc = sqlite3_exec(t._handle, "COMMIT", 0 as *u8, 0 as *u8, 0 as *u8)
            if rc != 0 {
                return Result.Err(_cstrToString(sqlite3_errmsg(t._handle)))
            }
        }
        t.done = true
        return Result.Ok(0)
    }

    // ROLLBACK now, consuming the guard.
    fn rollback(self: Self): Result<i32> {
        var t = self
        t.done = true
        unsafe {
            let rc = sqlite3_exec(t._handle, "ROLLBACK", 0 as *u8, 0 as *u8, 0 as *u8)
            if rc != 0 {
                return Result.Err(_cstrToString(sqlite3_errmsg(t._handle)))
            }
        }
        return Result.Ok(0)
    }
}

fn _begin(db: &Database, sql: string): Result<Transaction> {
    dbExec(db, sql)?
    let pin = match dbQuery(db, "ROLLBACK") {
        Ok(p) => p
        Err(e) => {
            // The BEGIN succeeded but the guard cannot be built: undo it by hand.
            let _ = dbExec(db, "ROLLBACK")
            return Result.Err(e)
        }
    }
    return Result.Ok(Transaction { _handle: db._handle, _pin: pin, done: false })
}

// BEGIN a deferred transaction. Hold the result in a `let`; it rolls back on drop.
pub fn dbBegin(db: &Database): Result<Transaction> {
    return _begin(db, "BEGIN")
}

// BEGIN IMMEDIATE: takes the write lock up front, so a write transaction under WAL
// contention fails here with SQLITE_BUSY rather than at its first write.
pub fn dbBeginImmediate(db: &Database): Result<Transaction> {
    return _begin(db, "BEGIN IMMEDIATE")
}

// Prepare a query for row-by-row iteration with `dbStep`.
pub fn dbQuery(db: &Database, sql: string): Result<Statement> {
    unsafe {
        var handle: *u8 = 0 as *u8
        let rc = sqlite3_prepare_v2(db._handle, sql, 0 - 1, (handle.addrOf()) as *u8, 0 as *u8)
        if rc != 0 {
            let msg = _cstrToString(sqlite3_errmsg(db._handle))
            return Result.Err(msg)
        }
        return Result.Ok(Statement { _handle: handle })
    }
}

// Advance to the next row: true if a row is available, false when done. An error also
// reads as false; use dbNext where a failed step must not pass for an empty result.
pub fn dbStep(stmt: &Statement): bool {
    unsafe { return sqlite3_step(stmt._handle) == 100 }
}

// Advance to the next row: Ok(true) for a row, Ok(false) when done, and Err with
// sqlite's message when the step fails (a constraint violation, a busy database, or a
// table dropped since the statement was prepared, which prepare cannot see).
pub fn dbNext(stmt: &Statement): Result<bool> {
    unsafe {
        let rc = sqlite3_step(stmt._handle)
        if rc == 100 {
            return Result.Ok(true)
        }
        if rc == 101 {
            return Result.Ok(false)
        }
        return Result.Err(_cstrToString(sqlite3_errmsg(sqlite3_db_handle(stmt._handle))))
    }
}

// The column `col` (0-based) of the current row as an i32.
pub fn dbColumnInt(stmt: &Statement, col: i32): i32 {
    unsafe { return sqlite3_column_int(stmt._handle, col) }
}

// The column `col` (0-based) of the current row as an i64.
pub fn dbColumnInt64(stmt: &Statement, col: i32): i64 {
    unsafe { return sqlite3_column_int64(stmt._handle, col) }
}

// The column `col` (0-based) of the current row as an f64.
pub fn dbColumnFloat(stmt: &Statement, col: i32): f64 {
    unsafe { return sqlite3_column_double(stmt._handle, col) }
}

// The column `col` (0-based) of the current row as a string, every byte of it:
// embedded NULs are kept.
pub fn dbColumnText(stmt: &Statement, col: i32): string {
    unsafe {
        let ptr = sqlite3_column_text(stmt._handle, col)
        if ptr == 0 as *u8 {
            return ""
        }
        // The byte count, not the NUL: TEXT may hold embedded NULs, and reading it as
        // a C string cut the value at the first one. column_bytes must come after
        // column_text, which is what fixes the encoding it counts.
        let n = sqlite3_column_bytes(stmt._handle, col)
        return _bytesToString(ptr, n as i64)
    }
}

// Number of columns in the result set.
pub fn dbColumnCount(stmt: &Statement): i32 {
    unsafe { return sqlite3_column_count(stmt._handle) }
}

// Whether column `col` (0-based) of the current row is NULL.
pub fn dbColumnIsNull(stmt: &Statement, col: i32): bool {
    unsafe { return sqlite3_column_type(stmt._handle, col) == 5 }
}

// Free the prepared statement now rather than at the end of its scope. Consumes
// `stmt` for the reason `dbClose` consumes its handle.
pub fn dbFinalize(stmt: Statement): void {
    var s = stmt
    s.drop()
}

// Bind an i32 to parameter `idx`. Parameter indices are 1-based.
pub fn dbBindInt(stmt: &Statement, idx: i32, val: i32): Result<i32> {
    var rc: i32 = 0
    unsafe { rc = sqlite3_bind_int(stmt._handle, idx, val) }
    if rc != 0 {
        return Result.Err("bind_int failed")
    }
    return Result.Ok(0)
}

// Bind an i64 to parameter `idx` (1-based).
pub fn dbBindInt64(stmt: &Statement, idx: i32, val: i64): Result<i32> {
    var rc: i32 = 0
    unsafe { rc = sqlite3_bind_int64(stmt._handle, idx, val) }
    if rc != 0 {
        return Result.Err("bind_int64 failed")
    }
    return Result.Ok(0)
}

// Bind an f64 to parameter `idx` (1-based). A whole-number value still binds as REAL;
// SQLite compares REAL and INTEGER by value, so a range check against an INTEGER
// column means the same either way.
pub fn dbBindFloat(stmt: &Statement, idx: i32, val: f64): Result<i32> {
    var rc: i32 = 0
    unsafe { rc = sqlite3_bind_double(stmt._handle, idx, val) }
    if rc != 0 {
        return Result.Err("bind_double failed")
    }
    return Result.Ok(0)
}

// Bind a string to parameter `idx` (1-based). Every byte is bound, embedded NULs too.
pub fn dbBindText(stmt: &Statement, idx: i32, val: string): Result<i32> {
    if val.len > 2147483647 {
        return Result.Err("bind_text failed: string longer than 2 GiB")
    }
    unsafe {
        // An explicit length, not -1: -1 makes SQLite stop at the first NUL, which
        // silently truncated any value containing one. (-1 as the destructor is
        // SQLITE_TRANSIENT: SQLite copies, since `val` is freed when this returns.)
        let rc = sqlite3_bind_text(stmt._handle, idx, val, val.len as i32, (0 - 1) as *u8)
        if rc != 0 {
            return Result.Err("bind_text failed")
        }
        return Result.Ok(0)
    }
}

// Bind NULL to parameter `idx` (1-based).
pub fn dbBindNull(stmt: &Statement, idx: i32): Result<i32> {
    var rc: i32 = 0
    unsafe { rc = sqlite3_bind_null(stmt._handle, idx) }
    if rc != 0 {
        return Result.Err("bind_null failed")
    }
    return Result.Ok(0)
}

// Reset the statement so it can run again with new bindings.
pub fn dbReset(stmt: &Statement): void {
    unsafe { sqlite3_reset(stmt._handle) }
}

// The rowid of the most recent successful INSERT on this connection.
pub fn dbLastInsertId(db: &Database): i64 {
    unsafe { return sqlite3_last_insert_rowid(db._handle) }
}

pub extern fn sqlite3_column_name(stmt: *u8, col: i32): *u8

// The name of column `col` (0-based) in the result set: the SQL alias when there is one
// (`SELECT p.user_id AS userId` is "userId"). Empty when `col` is out of range.
pub fn dbColumnName(stmt: &Statement, col: i32): string {
    unsafe {
        let ptr = sqlite3_column_name(stmt._handle, col)
        if ptr == 0 as *u8 {
            return ""
        }
        return _cstrToString(ptr)
    }
}

// Index of the column named exactly `name`, or Err naming `what` (the "Struct.field"
// being read) when the result has no such column.
pub fn dbColumnIndex(stmt: &Statement, name: &string, what: &string): Result<i32> {
    let n = dbColumnCount(stmt)
    var i: i32 = 0
    while i < n {
        if dbColumnName(stmt, i) == name {
            return Result.Ok(i)
        }
        i = i + 1
    }
    return Result.Err($"{what}: no column named '{name}' in result")
}

// The readers `@derive(Row)` calls, one per supported field type plus an Option form
// (NULL is None). A non-Option read of NULL is an Err rather than a silent 0 or "", so a
// schema change cannot turn into wrong data. `what` is "Struct.field" for the messages.

pub fn dbRowI64(st: &Statement, name: &string, what: &string): Result<i64> {
    let c = dbColumnIndex(st, name, what)?
    if dbColumnIsNull(st, c) {
        return Result.Err($"{what}: column '{name}' is NULL but the field is not an Option")
    }
    return Result.Ok(dbColumnInt64(st, c))
}

pub fn dbRowOptI64(st: &Statement, name: &string, what: &string): Result<i64?> {
    let c = dbColumnIndex(st, name, what)?
    if dbColumnIsNull(st, c) {
        return Result.Ok(null)
    }
    return Result.Ok(Some(dbColumnInt64(st, c)))
}

pub fn dbRowI32(st: &Statement, name: &string, what: &string): Result<i32> {
    let c = dbColumnIndex(st, name, what)?
    if dbColumnIsNull(st, c) {
        return Result.Err($"{what}: column '{name}' is NULL but the field is not an Option")
    }
    return Result.Ok(dbColumnInt(st, c))
}

pub fn dbRowOptI32(st: &Statement, name: &string, what: &string): Result<i32?> {
    let c = dbColumnIndex(st, name, what)?
    if dbColumnIsNull(st, c) {
        return Result.Ok(null)
    }
    return Result.Ok(Some(dbColumnInt(st, c)))
}

pub fn dbRowF64(st: &Statement, name: &string, what: &string): Result<f64> {
    let c = dbColumnIndex(st, name, what)?
    if dbColumnIsNull(st, c) {
        return Result.Err($"{what}: column '{name}' is NULL but the field is not an Option")
    }
    return Result.Ok(dbColumnFloat(st, c))
}

pub fn dbRowOptF64(st: &Statement, name: &string, what: &string): Result<f64?> {
    let c = dbColumnIndex(st, name, what)?
    if dbColumnIsNull(st, c) {
        return Result.Ok(null)
    }
    return Result.Ok(Some(dbColumnFloat(st, c)))
}

pub fn dbRowBool(st: &Statement, name: &string, what: &string): Result<bool> {
    let c = dbColumnIndex(st, name, what)?
    if dbColumnIsNull(st, c) {
        return Result.Err($"{what}: column '{name}' is NULL but the field is not an Option")
    }
    return Result.Ok(dbColumnInt64(st, c) != 0)
}

pub fn dbRowOptBool(st: &Statement, name: &string, what: &string): Result<bool?> {
    let c = dbColumnIndex(st, name, what)?
    if dbColumnIsNull(st, c) {
        return Result.Ok(null)
    }
    return Result.Ok(Some(dbColumnInt64(st, c) != 0))
}

pub fn dbRowStr(st: &Statement, name: &string, what: &string): Result<string> {
    let c = dbColumnIndex(st, name, what)?
    if dbColumnIsNull(st, c) {
        return Result.Err($"{what}: column '{name}' is NULL but the field is not an Option")
    }
    return Result.Ok(dbColumnText(st, c))
}

pub fn dbRowOptStr(st: &Statement, name: &string, what: &string): Result<string?> {
    let c = dbColumnIndex(st, name, what)?
    if dbColumnIsNull(st, c) {
        return Result.Ok(null)
    }
    return Result.Ok(Some(dbColumnText(st, c)))
}
