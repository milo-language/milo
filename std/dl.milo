// Dynamic loading of shared libraries at runtime (dlopen/dlsym).
//
// Loading a library is only half of it: a plugin usually needs to call back into
// the host, which requires the host's own symbols to be visible to the loaded
// object. A fn the library resolves against you must be `pub` (or carry
// `@externalLinkage`): only those are external symbols, a private fn is `internal`.
// Then, on macOS link the host with `-Wl,-export_dynamic`; on Linux the
// compiler already passes -rdynamic on every link, and `-Wl,-export_dynamic` there
// is actively harmful — GNU ld reads it as `-e xport_dynamic` and quietly replaces
// the entry symbol. Without the export, dlOpen fails with an unresolved-symbol
// error for anything the library expects from you.
//
// Symbols come back as raw pointers. Use the `extern` function-pointer type to
// call one:
//
//     let lib = dlOpen("libfoo.dylib")!
//     let p = lib.sym("add")!
//     unsafe {
//         let add = p as extern (i32, i32) => i32
//         let sum = add(2, 3)
//     }
//
// Nothing here can be checked by the compiler: a wrong signature on that cast is
// undefined behavior exactly as it is in C, which is why both the cast and the call
// need `unsafe`.

from "std/cstr" import {
    CStr
}
// The four raw loader calls live in the platform split: Windows has no <dlfcn.h> and
// spells this LoadLibrary/GetProcAddress. Everything below is the typed layer over
// them, and is the same on every platform.
from "std/platform" import {
    dlopen, dlsym, dlclose, dlerror
}

// Resolve every symbol at load time rather than on first call. Same value on
// darwin and linux. RTLD_GLOBAL is deliberately not exposed — it differs between
// the two platforms (0x8 vs 0x100), and promoting a library's symbols into the
// global namespace is rarely what a caller wants.
pub let RTLD_NOW: i32 = 2

// Owns the dlopen handle, so the pointer field makes it move-tracked: two copies would
// each `close` it. No `@copy`, on purpose. The field is private: a public one let any
// file point `sym` at an arbitrary address.
//
// No Drop either, also on purpose: a library stays loaded until `close`. Pointers from
// `sym` are raw and routinely outlive the Lib binding (a callback table filled at
// startup), and unloading at the end of that binding's scope would leave each of them
// pointing at unmapped code.
pub struct Lib {
    _handle: *u8,
}

// The most recent loader error, or a generic message when the loader has none.
// dlerror() also CLEARS the error, so this must be read exactly once per failure.
pub fn dlLastError(): string {
    unsafe {
        let e = dlerror()
        match CStr.wrap(e) {
            Option.Some(c) => {
                return c.toString()
            }
            Option.None => {
                return "unknown dynamic loader error"
            }
        }
    }
}

// Load a shared library. `path` may be a filename resolved via the loader search
// path, or an explicit path.
pub fn dlOpen(path: &string): Result<Lib, string> {
    unsafe {
        let h = dlopen(path, RTLD_NOW)
        if (h as i64) == 0 {
            return Result.Err(dlLastError())
        }
        return Result.Ok(Lib {
            _handle: h
        })
    }
}

// A handle to the running program itself, for looking up symbols the executable
// exports. Requires the host's symbols to be exported, same as letting a loaded
// library resolve against the host — see the note at the top of this file.
pub fn dlSelf(): Result<Lib, string> {
    unsafe {
        let h = dlopen(0 as *u8, RTLD_NOW)
        if (h as i64) == 0 {
            return Result.Err(dlLastError())
        }
        return Result.Ok(Lib {
            _handle: h
        })
    }
}

impl Lib {
    // Address of a symbol, for casting to an `extern` function-pointer type or
    // reading as data. A symbol whose value is legitimately zero is
    // indistinguishable from an error here, as with plain dlsym.
    fn sym(self: &Lib, name: &string): Result<*u8, string> {
        unsafe {
            let p = dlsym(self._handle, name)
            if (p as i64) == 0 {
                return Result.Err(dlLastError())
            }
            return Result.Ok(p)
        }
    }

    // Whether a symbol is present, without treating absence as an error.
    fn has(self: &Lib, name: &string): bool {
        unsafe {
            let p = dlsym(self._handle, name)
            return (p as i64) != 0
        }
    }

    // Unload the library. Consumes the Lib: taking it by reference left a closed
    // handle usable, so a second close or a `sym` after it reached the loader with a
    // freed handle. Pointers obtained from sym() dangle afterwards, and any
    // still-running thread the library started keeps running; closing does not stop it.
    fn close(self: Self): bool {
        unsafe { return dlclose(self._handle) == 0 }
    }
}
