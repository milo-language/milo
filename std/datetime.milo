// std/datetime — date/time components and formatting (ISO 8601, RFC 2822, strftime-style), RFC 2822 and ISO 8601 parsing
// (UTC by default; DateTime.fromEpochLocal / DateTime.localNow apply the host TZ)

from "std/time" import {
    epochSecs, since
}
from "std/replay" import {
    replayOff, replayActive, replayTake, replayPut
}

pub extern fn localtime_r(timep: *u8, result: *u8): *u8

pub extern fn tzset(): void

// A broken-down calendar date and time. `month` is 1-based and `weekday` counts from 0
// = Sunday.
pub struct DateTime {
    year: i32,
    month: i32,
    day: i32,
    hour: i32,
    minute: i32,
    second: i32,
    weekday: i32,
}

impl DateTime {
    // Components in UTC for the given epoch seconds (negative is before 1970).
    fn fromEpoch(epochSec: i64): DateTime {
        // Days since 1970-01-01, floored: `/` truncates toward zero, which put the
        // second before the epoch at 00:00:-1 on 1970-01-01.
        var totalDays = epochSec / 86400
        var daySeconds = epochSec - totalDays * 86400
        if daySeconds < 0 {
            daySeconds += 86400
            totalDays -= 1
        }

        let hour = (daySeconds / 3600) as i32
        let minute = ((daySeconds - (hour as i64) * 3600) / 60) as i32
        let second = (daySeconds - (hour as i64) * 3600 - (minute as i64) * 60) as i32

        // weekday: 1970-01-01 was Thursday (4)
        var wd = ((totalDays + 4) % 7) as i32
        if wd < 0 {
            wd += 7
        }

        // civil date from day count (Hinnant algorithm)
        var z = totalDays + 719468
        var eraInput = z
        if z < 0 {
            eraInput = z - 146096
        }
        let era = eraInput / 146097
        let doe = z - era * 146097
        let yoe = (doe - doe / 1460 + doe / 36524 - doe / 146096) / 365
        let y = yoe + era * 400
        let doy = doe - (365 * yoe + yoe / 4 - yoe / 100)
        let mp = (5 * doy + 2) / 153
        let d = doy - (153 * mp + 2) / 5 + 1
        var m = mp + 3
        if mp >= 10 {
            m = mp - 9
        }
        var yr = y
        if m <= 2 {
            yr = y + 1
        }

        return DateTime {
            year: yr as i32, month: m as i32, day: d as i32,
            hour: hour, minute: minute, second: second,
            weekday: wd,
        }
    }

    // Current UTC time.
    fn now(): DateTime {
        return DateTime.fromEpoch(epochSecs())
    }

    // Same components as fromEpoch but in the host timezone (TZ env /
    // /etc/localtime). struct tm leads with nine consecutive ints
    // (tm_sec, tm_min, tm_hour, tm_mday, tm_mon, tm_year, tm_wday, tm_yday,
    // tm_isdst) on both macOS and glibc — only those leading fields are read, so
    // the trailing platform differences (tm_gmtoff/tm_zone) don't matter.
    //
    // The host timezone is an input like the clock (TZ, /etc/localtime), so the
    // breakdown is recorded and replayed under MILO_RECORD / MILO_REPLAY (std/replay).
    fn fromEpochLocal(epochSec: i64): DateTime {
        if replayOff() {
            return osLocalBreakdown(epochSec)
        }
        // Payload: year month day hour minute second weekday, space-separated.
        if replayActive() {
            let p = replayTake("time.local", epochSec.toString())
            var f: [i64; 7] = [0; 7]
            var k: i64 = 0
            var neg = false
            for i in 0..p.len() {
                let c = p[i]
                if c == ' ' {
                    if neg {
                        f[k] = 0 - f[k]
                    }
                    neg = false
                    k += 1
                } else if c == '-' {
                    neg = true
                } else if k < 7 {
                    f[k] = f[k] * 10 + ((c - '0') as i64)
                }
            }
            return DateTime {
                year: f[0] as i32,
                month: f[1] as i32,
                day: f[2] as i32,
                hour: f[3] as i32,
                minute: f[4] as i32,
                second: f[5] as i32,
                weekday: f[6] as i32,
            }
        }
        let d = osLocalBreakdown(epochSec)
        let fields = [d.year, d.month, d.day, d.hour, d.minute, d.second, d.weekday]
        var p = String.withCapacity(32)
        for v in fields {
            p.pushStr(v.toString())
            p.push(' ')
        }
        replayPut("time.local", epochSec.toString(), p)
        return d
    }

    // Current time in the host timezone.
    fn localNow(): DateTime {
        return DateTime.fromEpochLocal(epochSecs())
    }

    // ISO 8601: 2024-03-15T14:30:00
    fn format(self: &DateTime): string {
        var result: string = ""
        result = result + padI32(self.year, 4) + "-" + padI32(self.month, 2) + "-" + padI32(self.day, 2)
        result += "T"
        result = result + padI32(self.hour, 2) + ":" + padI32(self.minute, 2) + ":" + padI32(self.second, 2)
        return result
    }

    // The date portion only: 2024-03-15.
    fn formatDate(self: &DateTime): string {
        return padI32(self.year, 4) + "-" + padI32(self.month, 2) + "-" + padI32(self.day, 2)
    }

    // The time portion only: 14:30:00.
    fn formatTime(self: &DateTime): string {
        return padI32(self.hour, 2) + ":" + padI32(self.minute, 2) + ":" + padI32(self.second, 2)
    }
}

// English name for a weekday, 0 = Sunday.
pub fn weekdayName(wd: i32): string {
    if wd == 0 {
        return "Sunday"
    }
    if wd == 1 {
        return "Monday"
    }
    if wd == 2 {
        return "Tuesday"
    }
    if wd == 3 {
        return "Wednesday"
    }
    if wd == 4 {
        return "Thursday"
    }
    if wd == 5 {
        return "Friday"
    }
    if wd == 6 {
        return "Saturday"
    }
    return "Unknown"
}

// English name for a month, 1 = January.
pub fn monthName(m: i32): string {
    if m == 1 {
        return "January"
    }
    if m == 2 {
        return "February"
    }
    if m == 3 {
        return "March"
    }
    if m == 4 {
        return "April"
    }
    if m == 5 {
        return "May"
    }
    if m == 6 {
        return "June"
    }
    if m == 7 {
        return "July"
    }
    if m == 8 {
        return "August"
    }
    if m == 9 {
        return "September"
    }
    if m == 10 {
        return "October"
    }
    if m == 11 {
        return "November"
    }
    if m == 12 {
        return "December"
    }
    return "Unknown"
}

// ── Formatting epoch milliseconds ──

// An instant split into UTC components plus its millisecond, floored so an instant
// before 1970 breaks down onto the right second.
struct Instant {
    dt: DateTime,
    millis: i64,
}

fn instantOf(ms: i64): Instant {
    var secs = ms / 1000
    var millis = ms - secs * 1000
    if millis < 0 {
        millis += 1000
        secs -= 1
    }
    return Instant { dt: DateTime.fromEpoch(secs), millis: millis }
}

fn padI64(val: i64, width: i64): string {
    var s = if val < 0 { (0 - val).toString() } else { val.toString() }
    while s.len < width {
        s = "0" + s
    }
    return if val < 0 { "-" + s } else { s }
}

// ISO 8601 / RFC 3339 in UTC with millisecond precision, `2026-10-12T14:00:00.000Z`,
// for epoch milliseconds `ms` (the form JavaScript's toISOString writes).
// parseIso8601 reads it back to the same `ms`.
pub fn formatIso8601(ms: i64): string {
    let t = instantOf(ms)
    let d = t.dt
    return padI64(d.year as i64, 4) + "-" + padI32(d.month, 2) + "-" + padI32(d.day, 2) + "T" + padI32(d.hour, 2) + ":" +
    padI32(d.minute, 2) + ":" + padI32(d.second, 2) + "." + padI64(t.millis, 3) + "Z"
}

// An RFC 5322 / 2822 date in UTC, in the IMF-fixdate form HTTP requires (RFC 9110
// 5.6.7): `Mon, 12 Oct 2026 14:00:00 GMT`, for epoch milliseconds `ms`. The one form
// is right for HTTP `Date`, `Last-Modified` and `Expires`, cookie `Expires`, RSS
// `pubDate` and email `Date:`. Sub-second precision is dropped (floored);
// parseRfc2822 reads the result back to the whole second.
pub fn formatRfc2822(ms: i64): string {
    let d = instantOf(ms).dt
    return weekdayName(d.weekday).substr(0, 3) + ", " + padI32(d.day, 2) + " " + monthName(d.month).substr(0, 3) + " " +
    padI64(d.year as i64, 4) + " " + padI32(d.hour, 2) + ":" + padI32(d.minute, 2) + ":" + padI32(d.second, 2) + " GMT"
}

// Format epoch milliseconds `ms` with a strftime-style `pattern`, at a fixed offset of
// `offsetMinutes` east of UTC (0 for UTC, -420 for PDT). There is no time zone
// database: the caller supplies the offset that applies to the instant.
//
//   %Y year (2026)        %m month 01-12      %d day 01-31       %e day, space-padded
//   %H hour 00-23         %I hour 01-12       %M minute 00-59    %S second 00-60
//   %L millisecond 000    %p AM or PM         %j day of year 001-366
//   %a Mon   %A Monday    %b Oct   %B October %z offset +hhmm    %y year 00-99
//   %F = %Y-%m-%d         %T = %H:%M:%S       %% a literal %
//
// A `-` after `%` drops a numeric field's padding (`%-d` is 5, `%-I` is 2). Names are
// English. A directive not listed is copied to the output unchanged, as C strftime
// implementations do.
pub fn formatDateTime(ms: i64, pattern: &string, offsetMinutes: i64): string {
    let t = instantOf(ms + offsetMinutes * 60000)
    let d = t.dt
    var out = ""
    var i: i64 = 0
    while i < pattern.len {
        let c = pattern[i]
        if c != '%' || i + 1 >= pattern.len {
            out.push(c)
            i += 1
            continue
        }
        var j = i + 1
        let noPad = pattern[j] == '-' && j + 1 < pattern.len
        if noPad {
            j += 1
        }
        let f = pattern[j]
        let w: i64 = if noPad { 0 } else { 2 }
        if f == 'Y' {
            out.pushStr(padI64(d.year as i64, if noPad { 0 } else { 4 }))
        } else if f == 'y' {
            let y = d.year as i64 % 100
            out.pushStr(padI64(if y < 0 { y + 100 } else { y }, w))
        } else if f == 'm' {
            out.pushStr(padI64(d.month as i64, w))
        } else if f == 'd' {
            out.pushStr(padI64(d.day as i64, w))
        } else if f == 'e' {
            if d.day < 10 && !noPad {
                out.push(' ')
            }
            out.pushStr(d.day.toString())
        } else if f == 'H' {
            out.pushStr(padI64(d.hour as i64, w))
        } else if f == 'I' {
            let h = d.hour as i64 % 12
            out.pushStr(padI64(if h == 0 { 12 } else { h }, w))
        } else if f == 'M' {
            out.pushStr(padI64(d.minute as i64, w))
        } else if f == 'S' {
            out.pushStr(padI64(d.second as i64, w))
        } else if f == 'L' {
            out.pushStr(padI64(t.millis, if noPad { 0 } else { 3 }))
        } else if f == 'p' {
            out.pushStr(if d.hour < 12 { "AM" } else { "PM" })
        } else if f == 'j' {
            let doy = daysFromCivil(d.year as i64, d.month as i64, d.day as i64) - daysFromCivil(d.year as i64, 1, 1) + 1
            out.pushStr(padI64(doy, if noPad { 0 } else { 3 }))
        } else if f == 'a' {
            out.pushStr(weekdayName(d.weekday).substr(0, 3))
        } else if f == 'A' {
            out.pushStr(weekdayName(d.weekday))
        } else if f == 'b' {
            out.pushStr(monthName(d.month).substr(0, 3))
        } else if f == 'B' {
            out.pushStr(monthName(d.month))
        } else if f == 'z' {
            let a = if offsetMinutes < 0 { 0 - offsetMinutes } else { offsetMinutes }
            out.push(if offsetMinutes < 0 { '-' } else { '+' })
            out.pushStr(padI64(a / 60, 2) + padI64(a % 60, 2))
        } else if f == 'F' {
            out.pushStr(padI64(d.year as i64, 4) + "-" + padI32(d.month, 2) + "-" + padI32(d.day, 2))
        } else if f == 'T' {
            out.pushStr(padI32(d.hour, 2) + ":" + padI32(d.minute, 2) + ":" + padI32(d.second, 2))
        } else if f == '%' {
            out.push('%')
        } else {
            out.pushStr(pattern.substr(i, j + 1))
        }
        i = j + 1
    }
    return out
}

fn padI32(val: i32, width: i32): string {
    var s = format(val)
    while s.len < width as i64 {
        s = "0" + s
    }
    return s
}

// Little-endian i32 read out of the struct tm buffer.
@replayHooked
fn osLocalBreakdown(epochSec: i64): DateTime {
    // POSIX doesn't require localtime_r to imply tzset(); call it so TZ
    // changes (and the first call) always take effect.
    unsafe { tzset() }
    var t: [i64; 1] = [0; 1]
    t[0] = epochSec
    var tm: [u8; 128] = [0; 128]
    unsafe {
        let _r = localtime_r(t as *u8, tm as *u8)
    }
    return DateTime {
        year: tmI32(tm, 20) + 1900,
        month: tmI32(tm, 16) + 1,
        day: tmI32(tm, 12),
        hour: tmI32(tm, 8),
        minute: tmI32(tm, 4),
        second: tmI32(tm, 0),
        weekday: tmI32(tm, 24),
    }
}

fn tmI32(buf: &[u8; 128], off: i64): i32 {
    var v: i64 = 0
    var i: i64 = 3
    while i >= 0 {
        v = v * 256 + (buf[off + i] as i64)
        i -= 1
    }
    return v as i32
}

// ── Parsing ──

// Days from 1970-01-01 to the given proleptic Gregorian date (Hinnant's
// days_from_civil, the inverse of the breakdown in DateTime.fromEpoch).
fn daysFromCivil(year: i64, month: i64, day: i64): i64 {
    var y = year
    if month <= 2 {
        y = y - 1
    }
    var eraInput = y
    if y < 0 {
        eraInput = y - 399
    }
    let era = eraInput / 400
    let yoe = y - era * 400
    var mp = month - 3
    if month <= 2 {
        mp = month + 9
    }
    let doy = (153 * mp + 2) / 5 + day - 1
    let doe = yoe * 365 + yoe / 4 - yoe / 100 + doy
    return era * 146097 + doe - 719468
}

fn daysInMonth(year: i64, month: i64): i64 {
    if month == 2 {
        let leap = (year % 4 == 0 && year % 100 != 0) || year % 400 == 0
        return if leap { 29 } else { 28 }
    }
    if month == 4 || month == 6 || month == 9 || month == 11 {
        return 30
    }
    return 31
}

// Epoch milliseconds for validated UTC components; `offsetMin` is the zone's offset
// east of UTC, subtracted to land on UTC. A leap second (:60) folds onto :59, since
// epoch time has no slot for it.
fn civilToMillis(year: i64, month: i64, day: i64, hour: i64, minute: i64, second: i64, millis: i64, offsetMin: i64): Result<i64> {
    if month < 1 || month > 12 {
        return Err($"month {month} out of range")
    }
    if day < 1 || day > daysInMonth(year, month) {
        return Err($"day {day} out of range for {year}-{month}")
    }
    if hour > 23 || minute > 59 || second > 60 {
        return Err($"time {hour}:{minute}:{second} out of range")
    }
    let sec = if second == 60 { 59 } else { second }
    let days = daysFromCivil(year, month, day)
    let secs = days * 86400 + hour * 3600 + minute * 60 + sec - offsetMin * 60
    return Ok(secs * 1000 + millis)
}

fn isDigit(c: u8): bool {
    return c >= '0' && c <= '9'
}

fn isAlpha(c: u8): bool {
    return (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z')
}

// Exactly `n` digits at `pos`, or -1.
fn fixedDigits(s: &string, pos: i64, n: i64): i64 {
    if pos + n > s.len {
        return -1
    }
    var v: i64 = 0
    var i: i64 = 0
    while i < n {
        let c = s[pos + i]
        if !isDigit(c) {
            return -1
        }
        v = v * 10 + (c - '0') as i64
        i += 1
    }
    return v
}

fn countDigits(s: &string, pos: i64): i64 {
    var i = pos
    while i < s.len && isDigit(s[i]) {
        i += 1
    }
    return i - pos
}

fn skipSpaces(s: &string, pos: i64): i64 {
    var i = pos
    while i < s.len && (s[i] == ' ' || s[i] == '\t' || s[i] == '\r' || s[i] == '\n') {
        i += 1
    }
    return i
}

// The word of ASCII letters at `pos`, lowercased.
fn alphaWord(s: &string, pos: i64): string {
    var i = pos
    while i < s.len && isAlpha(s[i]) {
        i += 1
    }
    return s.substr(pos, i).toLower()
}

fn monthFromName(w: &string): i64 {
    let names = ["jan", "feb", "mar", "apr", "may", "jun", "jul", "aug", "sep", "oct", "nov", "dec"]
    let full = ["january", "february", "march", "april", "may", "june", "july", "august", "september", "october", "november", "december"]
    var i: i64 = 0
    while i < 12 {
        if w == names[i] || w == full[i] {
            return i + 1
        }
        i += 1
    }
    // "Sept" turns up in hand-written feeds.
    if w == "sept" {
        return 9
    }
    return 0
}

// A numeric offset `+hhmm`, `+hh:mm` or `+hh` at `pos` (the sign included), as minutes
// east of UTC with the index after it, or None when `pos` holds no sign.
struct ZoneOffset {
    minutes: i64,
    next: i64,
}

fn numericOffset(s: &string, pos: i64): Option<ZoneOffset> {
    if pos >= s.len || (s[pos] != '+' && s[pos] != '-') {
        return None
    }
    let sign: i64 = if s[pos] == '-' { -1 } else { 1 }
    let hh = fixedDigits(s, pos + 1, 2)
    if hh < 0 {
        return None
    }
    var i = pos + 3
    var mm: i64 = 0
    if i < s.len && s[i] == ':' {
        mm = fixedDigits(s, i + 1, 2)
        if mm < 0 {
            return None
        }
        i += 3
    } else if countDigits(s, i) == 2 {
        mm = fixedDigits(s, i, 2)
        i += 2
    }
    if hh > 23 || mm > 59 {
        return None
    }
    return Some(ZoneOffset { minutes: sign * (hh * 60 + mm), next: i })
}

// Parse an RFC 5322 / 2822 / 1123 / 822 date, the form RSS `pubDate` and email `Date:`
// headers use: `Mon, 12 Oct 2026 14:00:00 GMT`, `12 Oct 2026 14:00 -0700 (PDT)`.
// Returns epoch milliseconds (UTC). The weekday is optional and not checked against
// the date; seconds are optional. Accepted zones: numeric (`+0000`, `-07:00`), `UT`,
// `GMT`, `UTC`, `Z`, the US zones `EST EDT CST CDT MST MDT PST PDT`, and the military
// letters, which RFC 2822 §4.3 says to read as `-0000` (UTC). Other names (`CEST`,
// `IST`) are ambiguous and rejected. Two-digit years follow RFC 2822 §4.3: 00-49 is
// 20xx, 50-99 is 19xx; three digits add 1900. A trailing `(comment)` is ignored.
pub fn parseRfc2822(s: &string): Result<i64> {
    var i = skipSpaces(s, 0)
    // Optional day-of-week: letters then a comma.
    if i < s.len && isAlpha(s[i]) {
        let w = alphaWord(s, i)
        let j = skipSpaces(s, i + w.len)
        if j < s.len && s[j] == ',' {
            i = skipSpaces(s, j + 1)
        }
    }
    let dn = countDigits(s, i)
    if dn < 1 || dn > 2 {
        return Err($"rfc 2822 date '{s}': expected a day of the month")
    }
    let day = fixedDigits(s, i, dn)
    i = skipSpaces(s, i + dn)
    let mw = alphaWord(s, i)
    let month = monthFromName(mw)
    if month == 0 {
        return Err($"rfc 2822 date '{s}': unknown month '{mw}'")
    }
    i = skipSpaces(s, i + mw.len)
    let yn = countDigits(s, i)
    if yn < 2 || yn > 4 {
        return Err($"rfc 2822 date '{s}': expected a year")
    }
    var year = fixedDigits(s, i, yn)
    if yn == 2 {
        year = if year < 50 { 2000 + year } else { 1900 + year }
    } else if yn == 3 {
        year = 1900 + year
    }
    i = skipSpaces(s, i + yn)
    let hh = fixedDigits(s, i, 2)
    if hh < 0 || i + 2 >= s.len || s[i + 2] != ':' {
        return Err($"rfc 2822 date '{s}': expected hh:mm")
    }
    let mi = fixedDigits(s, i + 3, 2)
    if mi < 0 {
        return Err($"rfc 2822 date '{s}': expected hh:mm")
    }
    i += 5
    var sec: i64 = 0
    if i < s.len && s[i] == ':' {
        sec = fixedDigits(s, i + 1, 2)
        if sec < 0 {
            return Err($"rfc 2822 date '{s}': expected seconds after ':'")
        }
        i += 3
    }
    i = skipSpaces(s, i)
    var offset: i64 = 0
    match numericOffset(s, i) {
        Some(z) => {
            offset = z.minutes
            i = z.next
        }
        None => {
            let z = alphaWord(s, i)
            if z.len == 0 {
                return Err($"rfc 2822 date '{s}': missing time zone")
            }
            let named = namedZoneOffset(z)
            if named.isNone() {
                return Err($"rfc 2822 date '{s}': unknown or ambiguous time zone '{z}'")
            }
            offset = named ?? 0
            i += z.len
        }
    }
    i = skipSpaces(s, i)
    if i < s.len && s[i] == '(' {
        while i < s.len && s[i] != ')' {
            i += 1
        }
        if i >= s.len {
            return Err($"rfc 2822 date '{s}': unclosed comment")
        }
        i = skipSpaces(s, i + 1)
    }
    if i != s.len {
        return Err($"rfc 2822 date '{s}': unexpected text after the zone")
    }
    return civilToMillis(year, month, day, hh, mi, sec, 0, offset)
}

// RFC 2822 §3.3 and §4.3 zone names, as minutes east of UTC.
fn namedZoneOffset(z: &string): Option<i64> {
    if z == "ut" || z == "gmt" || z == "utc" || z == "z" {
        return Some(0)
    }
    if z == "est" { return Some(-300) }
    if z == "edt" { return Some(-240) }
    if z == "cst" { return Some(-360) }
    if z == "cdt" { return Some(-300) }
    if z == "mst" { return Some(-420) }
    if z == "mdt" { return Some(-360) }
    if z == "pst" { return Some(-480) }
    if z == "pdt" { return Some(-420) }
    // Military zones: their signs were published backwards in RFC 822, so RFC 2822
    // says to treat every one as carrying no zone information, i.e. UTC.
    if z.len == 1 && z != "j" {
        return Some(0)
    }
    return None
}

// Parse an ISO 8601 / RFC 3339 timestamp in extended format: `2026-10-12T14:00:00Z`,
// `2026-10-12T14:00:00.123+02:00`, `2026-10-12 14:00:00z`, or a bare date
// `2026-10-12` (midnight UTC). Returns epoch milliseconds (UTC). Fractional seconds take
// any number of digits and are truncated to milliseconds; `hh:mm` without seconds is
// accepted. The offset is `Z`, `±hh:mm`, `±hhmm` or `±hh`, and a date-time without one
// is an error rather than a guess at local time (append `Z` if it is UTC).
pub fn parseIso8601(s: &string): Result<i64> {
    let n = s.len
    if countDigits(s, 0) != 4 || n < 10 || s[4] != '-' || s[7] != '-' {
        return Err($"iso 8601 '{s}': expected YYYY-MM-DD")
    }
    let year = fixedDigits(s, 0, 4)
    let month = fixedDigits(s, 5, 2)
    let day = fixedDigits(s, 8, 2)
    if month < 0 || day < 0 {
        return Err($"iso 8601 '{s}': expected YYYY-MM-DD")
    }
    if n == 10 {
        return civilToMillis(year, month, day, 0, 0, 0, 0, 0)
    }
    if s[10] != 'T' && s[10] != 't' && s[10] != ' ' {
        return Err($"iso 8601 '{s}': expected 'T' after the date")
    }
    let hh = fixedDigits(s, 11, 2)
    let mi = fixedDigits(s, 14, 2)
    if hh < 0 || mi < 0 || n < 16 || s[13] != ':' {
        return Err($"iso 8601 '{s}': expected hh:mm after 'T'")
    }
    var i: i64 = 16
    var sec: i64 = 0
    var millis: i64 = 0
    if i < n && s[i] == ':' {
        sec = fixedDigits(s, i + 1, 2)
        if sec < 0 {
            return Err($"iso 8601 '{s}': expected seconds after ':'")
        }
        i += 3
        if i < n && (s[i] == '.' || s[i] == ',') {
            let fd = countDigits(s, i + 1)
            if fd == 0 {
                return Err($"iso 8601 '{s}': expected digits after the decimal point")
            }
            var k: i64 = 0
            while k < 3 {
                millis = millis * 10
                if k < fd {
                    millis = millis + (s[i + 1 + k] - '0') as i64
                }
                k += 1
            }
            i += 1 + fd
        }
    }
    var offset: i64 = 0
    if i < n && (s[i] == 'Z' || s[i] == 'z') {
        i += 1
    } else {
        match numericOffset(s, i) {
            Some(z) => {
                offset = z.minutes
                i = z.next
            }
            None => {
                if i >= n {
                    return Err($"iso 8601 '{s}': missing UTC offset (append 'Z' for UTC)")
                }
                return Err($"iso 8601 '{s}': bad UTC offset")
            }
        }
    }
    if i != n {
        return Err($"iso 8601 '{s}': unexpected text after the offset")
    }
    return civilToMillis(year, month, day, hh, mi, sec, millis, offset)
}
