// std/regex — regular expression matching (wraps POSIX regex.h)
//
// THREAD SAFETY: a Regex must be used from one thread at a time — and on macOS, only
// one thread in the whole process may be inside the engine at all.
//
// Apple's libc regex is not thread-safe for patterns containing a bracket expression
// (`[A-Z]`, `[0-9]`, …), and not in the way you can design around: four threads each
// running `regexec` over the same corpus with a `regex_t` **they compiled themselves**
// disagree on the match count, and `regcomp` intermittently fails outright. Sharing one
// compiled regex is no worse and no better — both race. Reproduced in plain C with no
// Milo involved; a bracket-free pattern (`Tok.*Info`) is clean over the same trials,
// and forcing `setlocale(LC_ALL, "C")` plus a single-threaded warm-up compile does not
// help, which points at an unsynchronized process-global collation/character-class
// cache inside libSystem. ThreadSanitizer cannot see it — the racing memory lives in an
// uninstrumented system library — so a clean tsan run proves nothing here.
//
// The symptom is *silently missing matches*, not a crash. If you are fanning work out
// with `Promise.blocking`, keep the regex on one thread: split the work so the threads
// do the reading and any literal scanning, and the matcher runs where the results are
// consumed. `examples/cli-tools/rg.milo` (`workerCanFormat`) is the worked example.

from "std/unicode" import {
    nextCodepointBoundary
}

pub extern fn regcomp(_preg: *u8, _regex: *u8, _cflags: i32): i32

pub extern fn regexec(_preg: *u8, _str: *u8, _nmatch: i64, _pmatch: *u8, _eflags: i32): i32

pub extern fn regfree(_preg: *u8): void

// ── Regex handle ──

pub struct Regex {
    _preg: [u8; 128],
    _valid: bool,
}

// Compile a POSIX extended regex with explicit cflags. REG_EXTENDED=1, REG_ICASE=2.
// Milo strings are UTF-8 by definition, but POSIX regex asks the C LOCALE what a
// character is — and a program that never calls setlocale runs in the "C" locale, where
// a character is a BYTE. So `.` matched 4 times in "aéb" (3 code points, 4 bytes) and a
// quantifier bound to the last byte of a multibyte literal. Setting LC_CTYPE fixes both
// (measured: 4 -> 3).
//
// Forced to UTF-8 rather than taken from the environment with "": with LANG and LC_ALL
// unset — the usual state in CI and in a container — "" resolves to "C" and the byte
// behaviour comes straight back. Milo's string type does not vary with the environment,
// so neither should its matcher.
//
// LC_CTYPE alone, never LC_ALL: LC_NUMERIC decides the decimal separator, and moving it
// would rewrite every float this program prints (a comma in a locale like de_DE), which
// is a far worse bug than the one being fixed. Verified that float output is unchanged.
pub extern fn setlocale(_category: i32, _locale: *u8): *u8

var _regexLocaleSet: bool = false

// Category 2 is LC_CTYPE on darwin.
fn regexEnsureUtf8Ctype(): void {
    if _regexLocaleSet {
        return
    }
    _regexLocaleSet = true
    unsafe {
        let want = "UTF-8"
        setlocale(2, want.cstr())
    }
}

fn regexNewFlags(pattern: string, cflags: i32): Result<Regex> {
    regexEnsureUtf8Ctype()
    var r = Regex {
        _preg: [0; 128], _valid: false
    }
    let rc = regcomp(r._preg, pattern, cflags)
    if rc != 0 {
        return Result.Err("invalid regular expression")
    }
    r._valid = true
    return Result.Ok(r)
}

// Compile a POSIX extended regular expression.
fn regexNew(pattern: string): Result<Regex> {
    return regexNewFlags(pattern, 1)
}

// REG_STARTEND: hand regexec an explicit byte range in pmatch[0] instead of
// letting it scan to a NUL. This is what makes the engine safe on a `&string`
// VIEW — a view points into the middle of a larger buffer and its end is NOT
// NUL-terminated, so a plain regexec runs off the end of the view and matches
// the rest of the file. That produced silently wrong counts (6713 instead of
// 191) in examples/cli-tools/rg.milo before this was fixed.
//
// It is also faster: the previous code re-sliced the input on every iteration to
// advance past a match, which copied the tail each time.
pub let REG_STARTEND: i32 = 4

fn writeMatchI64(buf: &mut [u8; 160], off: i32, val: i64) {
    for k in 0..8 {
        buf[off as i64 + k] = ((val >> (k * 8)) & 255) as u8
    }
}

fn readMatchI64(buf: &[u8; 160], off: i32): i64 {
    var val: i64 = 0
    for k in 0..8 {
        val = val | ((buf[off as i64 + k] as i64) << (k * 8))
    }
    return val
}

// Test if a string matches the pattern.
fn regexMatch(re: &Regex, input: &string): bool {
    var pmatch: [u8; 160] = [0; 160]
    writeMatchI64(&mut pmatch, 0, 0)
    writeMatchI64(&mut pmatch, 8, input.len)
    return regexec(re._preg, input, 1, pmatch, REG_STARTEND) == 0
}

// Match result: start and end byte offsets.
pub struct RegexMatch {
    start: i64,
    end: i64,
}

// Find the first match in a string. Returns None if no match.
fn regexFind(re: &Regex, input: &string): Option<RegexMatch> {
    var pmatch: [u8; 160] = [0; 160]
    writeMatchI64(&mut pmatch, 0, 0)
    writeMatchI64(&mut pmatch, 8, input.len)
    let rc = regexec(re._preg, input, 1, pmatch, REG_STARTEND)
    if rc != 0 {
        return Option.None
    }
    let so = readMatchI64(pmatch, 0)
    let eo = readMatchI64(pmatch, 8)
    return Option.Some(RegexMatch {
        start: so, end: eo
    })
}

// Find all non-overlapping matches in a string.
fn regexFindAll(re: &Regex, input: &string): Vec<RegexMatch> {
    var matches: Vec<RegexMatch> = Vec.new()
    var offset: i64 = 0
    var pmatch: [u8; 160] = [0; 160]
    while offset < input.len {
        // the search window is [offset, len) — no slicing, no copy
        writeMatchI64(&mut pmatch, 0, offset)
        writeMatchI64(&mut pmatch, 8, input.len)
        // REG_NOTBOL past the first byte: `^` must not match mid-string just
        // because the window happens to start there.
        var eflags = REG_STARTEND
        if offset > 0 {
            eflags = REG_STARTEND | 1
        }
        let rc = regexec(re._preg, input, 1, pmatch, eflags)
        if rc != 0 {
            break
        }
        let so = readMatchI64(pmatch, 0)
        let eo = readMatchI64(pmatch, 8)
        matches.push(RegexMatch {
            start: so, end: eo
        })
        offset = eo
        if so == eo {
            // A zero-width match advances by one CODE POINT, not one byte. Advancing a
            // byte lands inside a multibyte character, and in a UTF-8 locale regexec
            // rejects that start position — so the loop hit `rc != 0` and BROKE, silently
            // returning a truncated list. `x*` over "aéb" gave 2 matches instead of one
            // per character boundary, and over "日本" gave 1.
            offset = nextCodepointBoundary(input, offset)
        }
    }
    return matches
}

impl Regex {
    fn compile(pattern: string): Result<Regex> {
        return regexNew(pattern)
    }
    fn compileFlags(pattern: string, flags: i32): Result<Regex> {
        return regexNewFlags(pattern, flags)
    }
    fn isMatch(self: &Self, input: &string): bool {
        return regexMatch(self, input)
    }
    fn find(self: &Self, input: &string): Option<RegexMatch> {
        return regexFind(self, input)
    }
    fn findAll(self: &Self, input: &string): Vec<RegexMatch> {
        return regexFindAll(self, input)
    }
}
