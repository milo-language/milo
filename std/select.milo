// std/select — wait on the first ready of many sources (Go's select).
//
// A task arms N arms — channel recv/send, fd read/write, or a timeout — then
// parks until one fires. wait() returns the winning arm index; the value of a
// recv arm is fetched per-arm afterwards (ch.recv/tryRecv), which keeps Select
// non-generic across heterogeneous arm types. Single-consumer channels only:
// with per-arm fetch a second consumer could take the value between the claim
// and the fetch.
//
//   var sel = Select.new()
//   sel.onRecv(ch)        // arm 0
//   sel.onRead(sock)      // arm 1 (any AsFd: TcpStream, Pty, SignalPipe, Stdin {}, ...)
//   sel.onTimeout(5000)   // arm 2
//   match sel.wait() {
//     0 => { let v = ch.recv()! ... }
//     1 => { /* fd readable */ }
//     2 => { /* timed out */ }
//   }
//   // sel frees its state when it goes out of scope (Select implements Drop)
//
// Channel arms (`onRecv`/`onSend`) are generic over the channel's element type;
// the method carries its own type parameter, inferred from the argument.
//
// LIMITATION — timer and fd arms need a scheduler; channel arms don't.
// fd/timer readiness is observed by the scheduler's poll loop, so with no scheduler
// (nothing green ever spawned — e.g. a main that only uses Promise.blocking) those arms
// are INERT: they are armed, and they never fire. A channel arm still works, because a
// foreign pthread's send claims it directly.
//
// The trap is `onTimeout` as a safety net. It looks like protection and isn't:
//
//   sel.onRecv(p.channel())        // Promise.blocking — real pthread, no scheduler
//   sel.onTimeout(1000)            // INERT: if the worker hangs, so does this select
//
// A select with ONLY inert arms would block on a wake that can never come, so wait()
// returns -1 for that case instead of hanging. Mixed arms are not rescued — if you want a
// live timeout, make sure a scheduler exists (spawn any green task, or use Promise.run).

from "std/os" import {
    malloc, free, memset
}
from "std/sync" import {
    Channel, ChannelHandle, channelArmRecv, channelArmSend, channelUnarmRecv, channelUnarmSend
}
from "std/time" import {
    unrecordedEpochMillis
}
from "std/io" import {
    AsFd
}
from "std/runtime" import {
    schedulerExists,
    selectStateNew, selectStateFree, selectWaitState, selectTryClaim,
    selectRegisterFd, selectUnregisterFd,
    rtWriteI64, rtWritePtr, rtReadI64,
    nodeKind, nodeA, nodeArm, nodeFd, nodeDeadline, nodeSize,
    kindSelRecv, kindSelSend, kindSelRead, kindSelWrite, kindSelTimer
}

fn maxArms(): i64 {
    return 16
}

// channel arms stash the ChannelInner ptr in the node's otherwise-unused
// deadline slot so cleanup can unlink without a parallel array
fn nodeChan(): i64 {
    return nodeDeadline()
}

// Owns its runtime state, so the pointer fields make it move-tracked (no `@copy`), and
// frees it in Drop, so no Select value outlives its state (an explicit `destroy(&self)`
// could be called twice, or followed by another wait()).
pub struct Select {
    _state: *u8, // SelectState (runtime)
    _nodes: *u8, // array of _maxArms nodes, nodeSize() bytes each
    _count: i64,
    // One owner per channel arm. A node holds the raw ChannelInner pointer until wait()
    // tears it down, and a `&Channel<T>` borrow ends when onRecv returns, so without
    // these a channel dropped between onRecv and wait() was a use-after-free.
    _chans: Vec<ChannelHandle>,
}

// A free fn, not a Select method: methods are as public as their type, and this takes a
// bare descriptor number (onRead/onWrite borrow the handle it came from).
fn armFd(sel: &mut Select, kind: i64, fd: i32): void {
    if sel._count >= maxArms() {
        return
    }
    let node = sel._node(sel._count)
    // `node` is slot _count of this Select's own node array, checked against maxArms above.
    unsafe {
        rtWriteI64(node, nodeKind(), kind)
        rtWritePtr(node, nodeA(), sel._state)
        rtWriteI64(node, nodeArm(), sel._count)
        rtWriteI64(node, nodeFd(), fd as i64)
    }
    sel._count += 1
}

// Free, not a method, for the reason armFd is: it stores `ptr` where wait() reads it back as
// a ChannelInner, so only onRecv/onSend (which pass a live channel's rawPtr) may reach it.
fn armChan(sel: &mut Select, kind: i64, ptr: *u8, owner: ChannelHandle): void {
    if sel._count >= maxArms() {
        return
    }
    let node = sel._node(sel._count)
    // `node` is slot _count of this Select's own node array, checked against maxArms above.
    unsafe {
        rtWriteI64(node, nodeKind(), kind)
        rtWritePtr(node, nodeA(), sel._state)
        rtWriteI64(node, nodeArm(), sel._count)
        rtWritePtr(node, nodeChan(), ptr)
    }
    sel._chans.push(owner)
    sel._count += 1
}

impl Select {
    fn new(): Select {
        unsafe {
            let state = selectStateNew()
            let nodes = malloc(nodeSize() * maxArms())
            memset(nodes, 0, nodeSize() * maxArms())
            return Select {
                _state: state, _nodes: nodes, _count: 0, _chans: Vec.new()
            }
        }
    }

    fn _node(self: &Self, i: i64): *u8 {
        unsafe {
            return (self._nodes as i64 + i * nodeSize()) as *u8
        }
    }

    // Arm on a value becoming receivable from `ch`. The arm keeps its own reference to
    // the channel, so dropping `ch` before wait() is safe.
    fn onRecv<T>(self: &mut Self, ch: &Channel<T>): void {
        armChan(&mut self, kindSelRecv(), ch.rawPtr(), ch.retainHandle())
    }

    // Arm on `ch` having room for a send.
    fn onSend<T>(self: &mut Self, ch: &Channel<T>): void {
        armChan(&mut self, kindSelSend(), ch.rawPtr(), ch.retainHandle())
    }

    // Arm on `h` becoming readable. The arm holds only the descriptor NUMBER until wait()
    // returns (a borrow cannot keep `h` alive past this call), so the caller must keep
    // `h` open across the wait: closing it first arms whatever descriptor reuses the
    // number. That is a wrong wakeup, not a memory error; channel arms keep an owner.
    fn onRead<T: AsFd>(self: &mut Self, h: &T): void {
        unsafe { armFd(&mut self, kindSelRead(), h.rawFd()) }
    }

    // Arm on `h` accepting a write without blocking.
    fn onWrite<T: AsFd>(self: &mut Self, h: &T): void {
        unsafe { armFd(&mut self, kindSelWrite(), h.rawFd()) }
    }

    fn onTimeout(self: &mut Self, ms: i64): void {
        if self._count >= maxArms() {
            return
        }
        let node = self._node(self._count)
        // `node` is slot _count of this Select's own node array, checked against maxArms above.
        unsafe {
            rtWriteI64(node, nodeKind(), kindSelTimer())
            rtWritePtr(node, nodeA(), self._state)
            rtWriteI64(node, nodeArm(), self._count)
            rtWriteI64(node, nodeDeadline(), unrecordedEpochMillis() + ms)
        }
        self._count += 1
    }

    // Arm every source, park until one fires, tear down the rest, return the
    // winning arm index.
    fn wait(self: &mut Self): i64 {
        var i: i64 = 0
        while i < self._count {
            let node = self._node(i)
            var ready = false
            // Every node below _count was filled by an arm fn, and a channel node's pointer
            // stays live because _chans holds an owner of that channel.
            unsafe {
                let kind = rtReadI64(node, nodeKind())
                if kind == kindSelRecv() {
                    ready = channelArmRecv(readPtr(node, nodeChan()), node)
                } else if kind == kindSelSend() {
                    ready = channelArmSend(readPtr(node, nodeChan()), node)
                } else {
                    // fd/timer readiness is observed by the scheduler poll loop
                    selectRegisterFd(node)
                }
                if ready {
                    selectTryClaim(self._state, i)
                }
            }
            if ready {
                i += 1
                break
            }
            i += 1
        }

        // With no scheduler, fd and timer arms can never fire — _selectRegisterFd needs the
        // event loop and silently skips. Only a foreign pthread claiming a channel can wake
        // us, so a select with no channel arm would block on a signal that never comes.
        // Return -1 instead of hanging; the caller is misusing Select (arm a channel, or
        // spawn a green task so a scheduler exists).
        if !schedulerExists() && !self._hasChannelArm() {
            self._teardown()
            return -1
        }

        // _state is this Select's own, freed only by Drop.
        var winner: i64 = -1
        unsafe { winner = selectWaitState(self._state) }
        self._teardown()
        return winner
    }

    // Can anything fire without a scheduler? Only channel arms: a foreign pthread's send
    // claims them directly.
    fn _hasChannelArm(self: &Self): bool {
        var i: i64 = 0
        while i < self._count {
            var kind: i64 = 0
            // Every node below _count was filled by an arm fn.
            unsafe { kind = rtReadI64(self._node(i), nodeKind()) }
            if kind == kindSelRecv() || kind == kindSelSend() {
                return true
            }
            i += 1
        }
        return false
    }

    // Deregister every arm. Tolerant: an arm that never linked (a synchronously
    // ready channel, or arms past an early claim) is simply skipped.
    fn _teardown(self: &Self): void {
        var i: i64 = 0
        while i < self._count {
            let node = self._node(i)
            // As in wait(): a filled node, and a channel _chans still owns.
            unsafe {
                let kind = rtReadI64(node, nodeKind())
                if kind == kindSelRecv() {
                    channelUnarmRecv(readPtr(node, nodeChan()), node)
                } else if kind == kindSelSend() {
                    channelUnarmSend(readPtr(node, nodeChan()), node)
                } else {
                    selectUnregisterFd(node)
                }
            }
            i += 1
        }
    }

}

impl Drop for Select {
    fn drop(self: &mut Self): void {
        // Zeroed == moved out (a send memsets its payload); nothing to free.
        if self._state as i64 == 0 {
            return
        }
        unsafe {
            selectStateFree(self._state)
            free(self._nodes)
            self._state = 0 as *u8
            self._nodes = 0 as *u8
        }
    }
}

fn readPtr(node: *u8, off: i64): *u8 {
    unsafe {
        var v: *u8 = 0 as *u8
        let src = (node as i64 + off) as *i64
        v = (*src) as *u8
        return v
    }
}
