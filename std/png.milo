// std/png — encode and decode PNG images (RFC 2083), pure Milo.
//
// Parses the chunk stream, concatenates IDAT, zlib-inflates it, then reverses the
// per-scanline filters (None/Sub/Up/Average/Paeth) to recover raw pixels. This is
// the payload path that motivated the compression stdlib: a real, filtered, zlib-
// wrapped format decoded end to end. Supports 8-bit truecolor (RGB, colorType 2)
// and truecolor+alpha (RGBA, colorType 6), no interlace — the common web/screenshot
// case. Palette, <8-bit, 16-bit, and Adam7 interlace are out of scope for now.

from "std/inflate" import {
    Inflate
}
from "std/deflate" import {
    Deflate
}
from "std/checksum" import {
    Checksum
}
from "std/binary" import {
    Bytes
}

pub struct PngImage {
    width: i64,
    height: i64,
    channels: i64, // 3 (RGB) or 4 (RGBA)
    pixels: string, // row-major, channels bytes per pixel, top-down
}

// PNG is big-endian throughout. Chunk lengths and IHDR dimensions are read out of
// the file being decoded, so the read is fallible by nature and the truncation
// check belongs in the type rather than in a comment above each call site.
fn be32(src: &string, p: i64): Result<i64, string> {
    let Option.Some(v) = Bytes.readU32Be(src, p) else {
        return Result.Err("png: truncated chunk")
    }
    return Result.Ok(v as i64)
}

// Paeth predictor (RFC 2083 §6.6): pick whichever of a/b/c the initial estimate
// a+b-c is closest to.
fn paeth(a: i64, b: i64, c: i64): i64 {
    let p = a + b - c
    var pa = p - a
    if pa < 0 {
        pa = 0 - pa
    }
    var pb = p - b
    if pb < 0 {
        pb = 0 - pb
    }
    var pc = p - c
    if pc < 0 {
        pc = 0 - pc
    }
    if pa <= pb && pa <= pc {
        return a
    }
    if pb <= pc {
        return b
    }
    return c
}

fn decodePng(src: &string): Result<PngImage, string> {
    if src.len < 8 {
        return Result.Err("png: too short")
    }
    // Signature: 137 80 78 71 13 10 26 10.
    if src[0] != 137 || src[1] != 80 || src[2] != 78 || src[3] != 71 {
        return Result.Err("png: bad signature")
    }

    var width: i64 = 0
    var height: i64 = 0
    var channels: i64 = 0
    var idat = ""

    var pos: i64 = 8
    var sawIhdr = false
    while pos + 8 <= src.len {
        let clen = be32(src, pos)?
        let t0 = src[pos + 4]
        let t1 = src[pos + 5]
        let t2 = src[pos + 6]
        let t3 = src[pos + 7]
        let dataStart = pos + 8
        // The loop condition only proves the 8-byte header is present. `clen`
        // comes off the wire, so the chunk body it claims has to be checked
        // against what is actually here — a file truncated mid-IDAT otherwise
        // ran the copy below straight off the end of `src`, which is a bounds
        // abort, not the Result.Err this function's type promises.
        if dataStart + clen > src.len {
            return Result.Err("png: truncated chunk")
        }

        if t0 == 'I' && t1 == 'H' && t2 == 'D' && t3 == 'R' {
            if clen < 13 {
                return Result.Err("png: short IHDR")
            }
            width = be32(src, dataStart)?
            height = be32(src, dataStart + 4)?
            // Bounded before they reach the stride arithmetic below: width and
            // height are attacker-chosen 32-bit values, and `height * (stride +
            // 1)` on two of them overflows i64, which traps rather than
            // returning an error.
            if width <= 0 || height <= 0 || width > 65535 || height > 65535 {
                return Result.Err($"png: implausible dimensions {width}x{height}")
            }
            let bitDepth = src[dataStart + 8] as i64
            let colorType = src[dataStart + 9] as i64
            let interlace = src[dataStart + 12] as i64
            if bitDepth != 8 {
                return Result.Err("png: only 8-bit depth supported")
            }
            if interlace != 0 {
                return Result.Err("png: interlaced images unsupported")
            }
            if colorType == 2 {
                channels = 3
            } else if colorType == 6 {
                channels = 4
            } else {
                return Result.Err($"png: unsupported color type {colorType}")
            }
            sawIhdr = true
        } else if t0 == 'I' && t1 == 'D' && t2 == 'A' && t3 == 'T' {
            for i in 0..clen {
                idat.push(src[dataStart + i])
            }
        } else if t0 == 'I' && t1 == 'E' && t2 == 'N' && t3 == 'D' {
            break
        }
        // Advance past data + 4-byte CRC.
        pos = dataStart + clen + 4
    }

    if !sawIhdr {
        return Result.Err("png: missing IHDR")
    }

    let raw = Inflate.zlib(idat)?
    let bpp = channels
    let stride = width * bpp
    // Each scanline is prefixed by a 1-byte filter type.
    if raw.len != height * (stride + 1) {
        return Result.Err("png: decompressed size mismatch")
    }

    // Unfilter in place into `out` (the reconstruction buffer the filters reference).
    var out = ""
    for y in 0..height {
        let filter = raw[y * (stride + 1)] as i64
        let inBase = y * (stride + 1) + 1
        let outBase = y * stride
        for x in 0..stride {
            let f = raw[inBase + x] as i64
            // a = byte bpp to the left, b = byte above, c = byte above-left.
            var a: i64 = 0
            if x >= bpp {
                a = out[outBase + x - bpp] as i64
            }
            var b: i64 = 0
            if y > 0 {
                b = out[outBase - stride + x] as i64
            }
            var c: i64 = 0
            if y > 0 && x >= bpp {
                c = out[outBase - stride + x - bpp] as i64
            }
            var recon: i64 = f
            if filter == 1 {
                recon = f + a
            } else if filter == 2 {
                recon = f + b
            } else if filter == 3 {
                recon = f + ((a + b) / 2)
            } else if filter == 4 {
                recon = f + paeth(a, b, c)
            }
            out.push((recon & 0xff) as u8)
        }
    }

    return Result.Ok(PngImage {
        width: width, height: height, channels: channels, pixels: out
    }
    )
}

// ── encoding ──────────────────────────────────────────────────────────────────

// One PNG chunk: length, type, payload, and a CRC over the TYPE AND PAYLOAD but
// not the length. Getting that span wrong produces a file every decoder rejects
// with a checksum error and no hint as to which half was wrong.
fn chunk(out: &mut string, kind: &string, body: &string) {
    Bytes.writeU32Be(&mut out, body.len as u32)
    var crcInput = ""
    crcInput.pushStr(kind)
    crcInput.pushStr(body)
    out.pushStr(kind)
    out.pushStr(body)
    Bytes.writeU32Be(&mut out, Checksum.crc32(crcInput) as u32)
}

// Encode 8-bit truecolour (3 channels) or truecolour+alpha (4) to a PNG.
//
// Every scanline is written with filter type 0 (None). Filtering exists to make
// the deflate stream smaller, and the encoder's job here is to be obviously
// correct rather than small — the filters are the part of PNG that is easy to
// get subtly wrong, and this is the write side of a decoder that already has to
// implement all five of them to read other people's files.
pub fn encodePng(pixels: &string, width: i64, height: i64, channels: i64): Result<string, string> {
    if channels != 3 && channels != 4 {
        return Result.Err($"encodePng: channels must be 3 or 4, got {channels}")
    }
    if width <= 0 || height <= 0 {
        return Result.Err($"encodePng: bad size {width}x{height}")
    }
    let need = width * height * channels
    if pixels.len < need {
        return Result.Err($"encodePng: need {need} bytes, got {pixels.len}")
    }

    var raw = ""
    var y = 0
    while y < height {
        raw.push(0 as u8) // filter: None
        let start = y * width * channels
        var i = 0
        while i < width * channels {
            raw.push(pixels[start + i])
            i = i + 1
        }
        y = y + 1
    }

    var out = ""
    // The 8-byte signature. The \r\n\x1a\n tail is a deliberate trap for
    // transfers that mangle line endings — if it survives, the rest did too.
    out.push(137 as u8)
    out.push(80 as u8)
    out.push(78 as u8)
    out.push(71 as u8)
    out.push(13 as u8)
    out.push(10 as u8)
    out.push(26 as u8)
    out.push(10 as u8)

    var ihdr = ""
    Bytes.writeU32Be(&mut ihdr, width as u32)
    Bytes.writeU32Be(&mut ihdr, height as u32)
    ihdr.push(8 as u8) // bit depth
    if channels == 3 {
        ihdr.push(2 as u8) // truecolour
    } else {
        ihdr.push(6 as u8) // truecolour + alpha
    }
    ihdr.push(0 as u8) // deflate
    ihdr.push(0 as u8) // adaptive filtering
    ihdr.push(0 as u8) // no interlace
    chunk(&mut out, "IHDR", ihdr)
    chunk(&mut out, "IDAT", Deflate.zlib(raw))
    chunk(&mut out, "IEND", "")
    return Result.Ok(out)
}

// Png namespace — Png.decode(src) reads a PNG, Png.encode(...) writes one.
pub struct Png {
}

impl Png {
    fn decode(src: &string): Result<PngImage, string> {
        return decodePng(src)
    }

    fn encode(pixels: &string, width: i64, height: i64, channels: i64): Result<string, string> {
        return encodePng(pixels, width, height, channels)
    }
}
