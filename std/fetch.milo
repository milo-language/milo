// std/fetch — TLS client + HTTP client (fetch). Split out of std/net so a plain-TCP
// program never links OpenSSL: net.milo's TcpStream/TcpListener carry no SSL symbols,
// and only importing from here pulls SSL_*/TLS_client_method. This is what lets a
// bare TCP program cross-link for Windows, where the xwin sysroot ships no OpenSSL.

from "std/net" import {
    TcpStream, NetError, IpAddr, resolveAll
}
from "std/os" import {
    connectFdIn,
    recvFdWait,
    sendFdWait,
    IO_GAVE_UP,
    sysClose,
    sysSocket
}
from "std/openssl" import {
    SSL_CTX_free, SSL_CTX_load_verify_locations, SSL_CTX_new, SSL_CTX_set_default_verify_paths, SSL_CTX_set_verify, SSL_ctrl,
    SSL_free, SSL_get_verify_result, SSL_new, SSL_set1_host, SSL_set_fd, SSL_shutdown,
    TLS_client_method, sslConnectFd, sslReadFd, sslWriteAllFd, sslConnectFdWait, sslReadFdWait, sslWriteAllFdWait, SSL_GAVE_UP
}
from "std/platform" import {
    makeSockaddr,
    ensureNetInit,
    sockRead,
    netErrno,
    netEagain
}
from "std/replay" import {
    replayRet, replayOff
}
from "std/select" import {
    Select
}
from "std/url" import {
    resolveUrl
}
from "std/time" import {
    ensureTimersLive, unrecordedEpochMillis
}
from "std/io" import {
    AsFd
}
from "std/chunked" import {
    ChunkScan, chunkMalformed, decodeChunked
}
from "std/json" import {
    Json
}
from "std/sync" import {
    Channel
}
from "std/runtime" import {
    Task, isWorkerThread
}
from "std/event" import {
    setNonblocking
}

// ── TLS verification constants ──

// openssl/ssl.h: SSL_VERIFY_PEER. Makes the handshake fail on an untrusted chain
// instead of silently accepting it (the client default is SSL_VERIFY_NONE).
let SSL_VERIFY_PEER: i32 = 1
// openssl/x509_vfy.h: X509_V_OK.
let X509_V_OK: i64 = 0

// ── TLS Stream ──

// TLS/SSL connection handle. Frees SSL context and closes fd on drop.
pub struct TlsStream {
    _fd: i32,
    _ssl: i64,
    _ctx: i64,
}

impl Drop for TlsStream {
    fn drop(self: &mut Self): void {
        unsafe {
            if self._ssl != 0 {
                // close_notify before the fd goes away: an abrupt TCP close is an
                // "unexpected eof" to an OpenSSL peer, which curl reports as a transfer
                // error even when the body arrived complete.
                SSL_shutdown(self._ssl as *u8)
                SSL_free(self._ssl as *u8)
            }
            if self._ctx != 0 {
                SSL_CTX_free(self._ctx as *u8)
            }
            // `> 0`: zeroed moved-from slots must drop as a no-op (see TcpStream.drop in std/net).
            if self._fd > 0 {
                sysClose(self._fd)
            }
        }
    }
}

impl TlsStream {
    // Open a TLS connection to an IPv4 address. `hostname` is used for SNI and
    // certificate verification.
    fn connect(ip: u32, port: u16, hostname: &string): Result<TlsStream, NetError> {
        return TlsStream.connectWithCA(ip, port, hostname, "")
    }

    // connect() with one extra CA file trusted on top of the system store. The point is
    // to keep verification ON while trusting a private CA: what users otherwise reach
    // for is disabling verification, which throws the whole guarantee away.
    // An empty caFile is exactly connect().
    fn connectWithCA(ip: u32, port: u16, hostname: &string, caFile: &string): Result<TlsStream, NetError> {
        unsafe {
            let AF_INET: i32 = 2
            let SOCK_STREAM: i32 = 1

            ensureNetInit()
            var fd: i32 = 0
            unsafe { fd = sysSocket(AF_INET, SOCK_STREAM, 0) }
            if fd < 0 {
                return Result.Err(NetError.ConnectionFailed("sysSocket() failed"))
            }

            var addr = makeSockaddr(port, ip)

            if connectFdIn(fd, addr) < 0 {
                sysClose(fd)
                return Result.Err(NetError.ConnectionFailed("connect() failed"))
            }

            unsafe { return TlsStream.fromFd(fd, hostname, caFile) }
        }
    }

    // connect() that gives up at `connectBy` (the TCP connect and the handshake) and at
    // `overallBy`, both epoch ms with 0 for none. The stream it returns is nonblocking:
    // use sendBy and recvBy on it.
    fn connectBy(ip: u32, port: u16, hostname: &string, connectBy: i64, overallBy: i64): Result<TlsStream, NetError> {
        let by = sooner(connectBy, overallBy)
        var tcp = TcpStream.connectWait(ip, port, (fd: i32, forRead: bool): bool => waitIo(fd, forRead, by))?
        unsafe { return TlsStream.fromFdBy(tcp.take(), hostname, "", by) }
    }

    // Client handshake over an ALREADY-connected socket. This is the entry point a
    // protocol with in-band TLS negotiation needs — Postgres' SSLRequest, SMTP STARTTLS:
    // the socket must carry plaintext first, so TLS setup cannot own the connect() too.
    // The stream is consumed: the returned TlsStream owns its fd, and every error path
    // closes it, so nothing is left behind to use after the handshake.
    fn fromTcp(conn: TcpStream, hostname: &string, caFile: &string): Result<TlsStream, NetError> {
        var s = conn
        unsafe { return TlsStream.fromFd(s.take(), hostname, caFile) }
    }

    // `fromTcp` over a bare descriptor. OWNERSHIP: fd is taken over by the returned
    // TlsStream, and closed on every error path here. `@unsafe` because the caller must
    // vouch it owns `fd` outright and neither closes nor uses it again.
    @replayHooked
    @unsafe
    fn fromFd(fd: i32, hostname: &string, caFile: &string): Result<TlsStream, NetError> {
        unsafe { return TlsStream.fromFdBy(fd, hostname, caFile, -1) }
    }

    // fromFd with the handshake bounded by `by` (epoch ms; 0 for none); -1 is fromFd's
    // own unbounded, green-parking handshake.
    @replayHooked
    @unsafe
    fn fromFdBy(fd: i32, hostname: &string, caFile: &string, by: i64): Result<TlsStream, NetError> {
        unsafe {
            let method = TLS_client_method()
            let ctx = SSL_CTX_new(method)
            let ctxAddr = ctx as i64
            if ctxAddr == 0 {
                sysClose(fd)
                return Result.Err(NetError.TlsError("SSL_CTX_new failed"))
            }
            SSL_CTX_set_default_verify_paths(ctx)
            // Added to the default paths, not instead of them: a program that trusts a
            // private CA still has to reach the public internet.
            if caFile.len > 0 {
                if SSL_CTX_load_verify_locations(ctx, caFile, 0 as *u8) != 1 {
                    SSL_CTX_free(ctx)
                    sysClose(fd)
                    return Result.Err(NetError.TlsError("SSL_CTX_load_verify_locations failed"))
                }
            }
            // Without SSL_VERIFY_PEER this client accepted ANY certificate — a
            // self-signed cert that `openssl s_client` rejects handshook fine, so a
            // MITM was undetectable. Loading the trust store above looks like
            // verification but does not enable it.
            SSL_CTX_set_verify(ctx, SSL_VERIFY_PEER, 0 as *u8)

            let ssl = SSL_new(ctx)
            let sslAddr = ssl as i64
            if sslAddr == 0 {
                SSL_CTX_free(ctx)
                sysClose(fd)
                return Result.Err(NetError.TlsError("SSL_new failed"))
            }

            // SNI: tells the server which cert to send. It verifies nothing.
            SSL_ctrl(ssl, 55, 0, hostname)
            // This is the check SNI is often mistaken for: without it, a cert valid for
            // any other host would satisfy the handshake.
            SSL_set1_host(ssl, hostname)
            SSL_set_fd(ssl, fd)

            // fd is nonblocking when connecting from a green task; sslConnectFd
            // parks on WANT_READ/WANT_WRITE until the handshake completes
            var r: i32 = 0
            if by < 0 {
                r = sslConnectFd(ssl, fd)
            } else {
                r = sslConnectFdWait(ssl, fd, (forRead: bool): bool => waitIo(fd, forRead, by))
            }
            if r != 1 {
                SSL_free(ssl)
                SSL_CTX_free(ctx)
                sysClose(fd)
                if r == SSL_GAVE_UP {
                    return Result.Err(NetError.Timeout("tls handshake"))
                }
                return Result.Err(NetError.TlsError("SSL handshake failed"))
            }
            // Not redundant with SSL_VERIFY_PEER, despite appearances: with the
            // set_verify line removed, this alone still rejects an untrusted chain
            // (verified by deleting each in turn). Two independent mechanisms, so
            // losing either one in a refactor cannot silently reopen the hole.
            let verdict = replayRet("tls.verify", fd.toString(), false, (): i64 => {
                unsafe {
                    return SSL_get_verify_result(ssl)
                }
            })
            if verdict != X509_V_OK {
                SSL_free(ssl)
                SSL_CTX_free(ctx)
                sysClose(fd)
                return Result.Err(NetError.TlsError("certificate verification failed"))
            }

            return Result.Ok(TlsStream {
                _fd: fd, _ssl: sslAddr, _ctx: ctxAddr
            })
        }
    }

    // Send `data` over the TLS connection. Returns the number of bytes sent.
    fn send(self: &Self, data: &string): Result<i64, NetError> {
        unsafe {
            let n = sslWriteAllFd(self._ssl as *u8, self._fd, data, data.len)
            if n < 0 || (n == 0 && data.len > 0) {
                return Result.Err(NetError.SendFailed("SSL_write failed"))
            }
            return Result.Ok(n as i64)
        }
    }

    // Read everything until the peer closes, as one string (blocks to EOF).
    // Prefer `incoming()` for streaming/incremental consumption.
    fn recv(self: &Self): Result<string, NetError> {
        var result: string = ""
        var buf: [u8; 4096] = [0; 4096]
        while true {
            unsafe {
                let n = sslReadFd(self._ssl as *u8, self._fd, buf as *u8, 4096)
                if n <= 0 {
                    break
                }
                for i in 0..n as i64 {
                    result.push(buf[i])
                }
            }
        }
        return Result.Ok(result)
    }

    // send() that gives up at `by` (epoch ms; 0 for none).
    fn sendBy(self: &Self, data: &string, by: i64): Result<i64, NetError> {
        let fd = self._fd
        unsafe {
            let n = sslWriteAllFdWait(self._ssl as *u8, fd, data, data.len, (forRead: bool): bool => waitIo(fd, forRead, by))
            if n < 0 || (n == 0 && data.len > 0) {
                if n == SSL_GAVE_UP as i64 {
                    return Result.Err(NetError.Timeout("send"))
                }
                return Result.Err(NetError.SendFailed("SSL_write failed"))
            }
            return Result.Ok(n)
        }
    }

    // recv() that gives up at `by` (epoch ms; 0 for none): Err(Timeout) rather than the
    // part of the body that arrived in time.
    fn recvBy(self: &Self, by: i64): Result<string, NetError> {
        return self.recvUpTo(by, 0)
    }

    // recvBy that stops once `maxBytes` bytes have arrived (0 reads to EOF), for a
    // caller that must not buffer whatever a hostile server chooses to send. The
    // result may run up to one TLS record past the cap.
    fn recvUpTo(self: &Self, by: i64, maxBytes: i64): Result<string, NetError> {
        let fd = self._fd
        var result: string = ""
        var buf: [u8; 4096] = [0; 4096]
        var last: i32 = 0
        while maxBytes <= 0 || result.len < maxBytes {
            unsafe {
                last = sslReadFdWait(self._ssl as *u8, fd, buf as *u8, 4096, (forRead: bool): bool => waitIo(fd, forRead, by))
                if last <= 0 {
                    break
                }
                for i in 0..last as i64 {
                    result.push(buf[i])
                }
            }
        }
        if last == SSL_GAVE_UP {
            return Result.Err(NetError.Timeout("response"))
        }
        return Result.Ok(result)
    }

    // A single SSL_read of whatever has arrived, unlike `recv()` which loops to EOF.
    // A server must answer a request while the client still holds the connection open,
    // so recv() would deadlock there; this returns after one record.
    fn recvOnce(self: &Self): string {
        var result: string = ""
        var buf: [u8; 8192] = [0; 8192]
        unsafe {
            let n = sslReadFd(self._ssl as *u8, self._fd, buf as *u8, 8192)
            if n > 0 {
                for i in 0..n as i64 {
                    result.push(buf[i])
                }
            }
        }
        return result
    }

    // Stream decrypted inbound bytes as an iterable channel, pumped on a green
    // task — the uniform async-read API, TLS variant. Uses the SSL-aware read
    // (parks on WANT_READ) rather than the raw-fd fdChannel. `for chunk in
    // tls.incoming()`; the channel closes at EOF / on SSL error.
    // Consumes the stream, so send any request first. The detached pump reads
    // through the SSL state, so the pump has to own it: when incoming() only
    // borrowed, dropping the stream ran SSL_read on a freed SSL. The connection
    // closes when the pump ends (EOF, an SSL error, or the first chunk that
    // arrives after every receiver is gone).
    fn incoming(self: TlsStream): Channel<string> {
        unsafe {
            let ch = Channel<string>.new(256)!
            let chPump = ch.clone() // pump task's owning handle; caller keeps `ch`
            let stream = self
            // The fd MUST be nonblocking or sslReadFd blocks the OS thread and the
            // WANT_READ park path is dead code — one read would freeze the whole
            // scheduler. connect() sets this when called from a green task, but not
            // if it ran outside one, so enforce it here.
            setNonblocking(stream._fd)
            Task.spawn(move(): void => {
                var buf: [u8; 4096] = [0; 4096]
                while true {
                    var n: i32 = 0
                    unsafe {
                        n = sslReadFd(stream._ssl as *u8, stream._fd, buf as *u8, 4096)
                    }
                    if n <= 0 {
                        break
                    }
                    var data: string = ""
                    for i in 0..n as i64 {
                        data.push(buf[i])
                    }
                    // if-let, not .isErr(): keep std in milo-self's subset (no isErr builtin)
                    if let Result.Err(_) = chPump.send(data) {
                        break
                    }
                }
                chPump.close()
            })
            return ch
        }
    }
}

// ── FetchResponse ──

// HTTP response with status code, headers, and body.
//
// Not `Response`: Milo's module namespace is flat and merged, so that name collided with
// std/http's `Response` enum and no program could import both — i.e. could not serve HTTP
// and fetch over HTTPS at once. The client type moved because handlers spell std/http's
// `Response.Text(...)` constantly while this one is almost always used through inference.
pub struct FetchResponse {
    status: i32,
    headers: string,
    body: string,
}

impl FetchResponse {
    // Return the response body as a string.
    fn text(self: &Self): string {
        return self.body.clone()
    }

    // Parse the response body as JSON.
    fn json(self: &Self): Json {
        return Json.parse(self.body)!
    }

    // Return true if the status code is 2xx (success).
    fn ok(self: &Self): bool {
        return self.status >= 200 && self.status < 300
    }

    // Value of response header `name` (case-insensitive), or None if the
    // response did not carry it. A header sent with an empty value is Some("").
    fn header(self: &Self, name: &string): Option<string> {
        return findHeader(self.headers, name)
    }
}

// ── String helpers ──

// Case-insensitive compare of `blen` bytes of `b` against `a` starting at `ai`.
// Anchored at an offset, which is what header scanning needs and what
// std/string's strIndexOfFromIgnoreCase does not give.
fn strEqNocase(a: &string, ai: i64, b: &string, blen: i64): bool {
    var i: i64 = 0
    while i < blen {
        var ca: u8 = a[ai + i]
        var cb: u8 = b[i]
        // lowercase ASCII
        if ca >= 'A' && ca <= 'Z' {
            ca += 32
        }
        if cb >= 'A' && cb <= 'Z' {
            cb += 32
        }
        if ca != cb {
            return false
        }
        i += 1
    }
    return true
}

// Value of `name` in a CRLF-joined header block, or None if it is not there.
// A header sent with no value (`Accept:`) is present: Some("").
pub fn findHeader(headers: &string, name: &string): Option<string> {
    // search for "Name: value" in headers (case-insensitive name match)
    var i: i64 = 0
    // Bound is `i + name.len`, not `+ 1`: the colon is the last byte that must
    // exist, so a value-less header at the very end of the block still matches.
    while i + name.len < headers.len {
        // check if we're at line start (i==0 or preceded by \n)
        if i == 0 || headers[i - 1] == '\n' {
            if strEqNocase(headers, i, name, name.len) && headers[i + name.len] == ':' {
                var start: i64 = i + name.len + 1
                // skip spaces after colon
                while start < headers.len && headers[start] == ' ' {
                    start += 1
                }
                var end: i64 = start
                while end < headers.len && headers[end] != '\r' && headers[end] != '\n' {
                    end += 1
                }
                return Option.Some(headers.substr(start, end))
            }
        }
        i += 1
    }
    return Option.None
}

// ── HTTP parsing ──

fn parseStatus(raw: &string): i32 {
    if raw.len < 12 {
        return 0
    }
    var code: i32 = 0
    var i: i64 = 9
    while i < raw.len && raw[i] >= '0' && raw[i] <= '9' {
        code = code * 10 + (raw[i] as i32 - 48)
        i += 1
    }
    return code
}

fn parseRawHeaders(raw: &string): string {
    var start: i64 = 0
    var i: i64 = 0
    while i + 1 < raw.len {
        if raw[i] == '\r' && raw[i + 1] == '\n' {
            if start == 0 {
                start = i + 2
            }
            if i + 3 < raw.len && raw[i + 2] == '\r' && raw[i + 3] == '\n' {
                return raw.substr(start, i)
            }
        }
        i += 1
    }
    return ""
}

fn parseBody(raw: &string): string {
    var i: i64 = 0
    while i + 3 < raw.len {
        if raw[i] == '\r' && raw[i + 1] == '\n' && raw[i + 2] == '\r' && raw[i + 3] == '\n' {
            return raw.substr(i + 4, raw.len)
        }
        i += 1
    }
    return raw.clone()
}

pub fn parseResponse(raw: string): FetchResponse {
    let status = parseStatus(raw)
    let headers = parseRawHeaders(raw)
    var body = parseBody(raw)
    // handle chunked transfer encoding
    let te = findHeader(headers, "Transfer-Encoding") ?? ""
    if te.startsWith("chunked") {
        body = decodeChunked(body, 0)
    }
    return FetchResponse {
        status: status, headers: headers, body: body
    }
}

// ── URL parsing ──

pub fn isHttps(url: &string): bool {
    return url.len > 8 && url[0] == 'h' && url[4] == 's' && url[5] == ':' && url[6] == '/' && url[7] == '/'
}

fn schemeOffset(url: &string): i64 {
    if isHttps(url) {
        return 8
    }
    if url.len > 7 && url[0] == 'h' && url[4] == ':' && url[5] == '/' && url[6] == '/' {
        return 7
    }
    return 0
}

pub fn parseHost(url: &string): string {
    let start = schemeOffset(url)
    var end: i64 = start
    while end < url.len && url[end] != '/' && url[end] != ':' {
        end += 1
    }
    return url.substr(start, end)
}

pub fn parsePort(url: &string): u16 {
    var i: i64 = schemeOffset(url)
    while i < url.len && url[i] != '/' && url[i] != ':' {
        i += 1
    }
    if i < url.len && url[i] == ':' {
        i += 1
        var port: i32 = 0
        while i < url.len && url[i] >= '0' && url[i] <= '9' {
            port = port * 10 + (url[i] as i32 - 48)
            i += 1
        }
        return port as u16
    }
    if isHttps(url) {
        return 443
    }
    return 80
}

// The authority for the Host header: the host, plus `:port` whenever the port is
// not the scheme's default. RFC 7230 5.4 requires it, and leaving it off is not
// cosmetic — a server on a non-default port that authenticates the request
// (AWS SigV4 signs the Host header verbatim) rejects a request whose Host says
// one thing and whose connection says another.
pub fn hostHeader(url: &string): string {
    let host = parseHost(url)
    let port = parsePort(url)
    let dflt: u16 = if isHttps(url) {
        443
    } else {
        80
    }
    if port == dflt {
        return host
    }
    return host + ":" + (port as i64).toString()
}

pub fn parsePath(url: &string): string {
    var i: i64 = schemeOffset(url)
    while i < url.len && url[i] != '/' {
        i += 1
    }
    if i >= url.len {
        return "/"
    }
    return url.substr(i, url.len)
}

// ── Form encoding ──

// Percent-encode one component of a URL query or an
// application/x-www-form-urlencoded body. Everything outside RFC 3986's
// unreserved set becomes %XX, space included: `%20` decodes back to a space in
// both a query string and a form body, whereas `+` only does in the latter.
pub fn urlEncode(s: &string): string {
    let hex: string = "0123456789ABCDEF"
    var out: string = ""
    var i: i64 = 0
    while i < s.len {
        let c = s[i]
        if (c >= 'A' && c <= 'Z') || (c >= 'a' && c <= 'z') || (c >= '0' && c <= '9') || c == '-' || c == '_' || c == '.' || c == '~' {
            out.push(c)
        } else {
            out.push('%')
            out.push(hex[(c as i64) / 16])
            out.push(hex[(c as i64) % 16])
        }
        i += 1
    }
    return out
}

// One key/value pair of a form body.
pub struct FormField {
    name: string,
    value: string,
}

// Build an application/x-www-form-urlencoded body. Both halves of every pair are
// percent-encoded, so a value containing '&' or '=' can't split the body into
// extra fields.
pub fn formEncode(fields: &Vec<FormField>): string {
    var out: string = ""
    var i: i64 = 0
    while i < fields.len {
        if i > 0 {
            out.push('&')
        }
        out = out + urlEncode(fields[i].name) + "=" + urlEncode(fields[i].value)
        i += 1
    }
    return out
}

// ── FetchOptions ──

// HTTP request configuration: method, headers, and body.
//
// `headers` is a CRLF-joined block ("Accept: text/plain\r\nX-Id: 7") with no trailing
// CRLF; leave it empty for none.
pub struct FetchOptions {
    method: string,
    headers: string,
    // A `Connection: close` header here opts this request out of the connection pool
    // (see the pool notes in std/fetch); without one, the connection is reused.
    body: string,
}

// Limits on one fetch, in milliseconds; 0 means no limit. `connectMs` bounds each TCP
// connect together with its TLS handshake; `totalMs` bounds the whole call from the
// first connect to the last body byte, redirects included. DNS is not covered: a lookup
// is bounded only by the system resolver's own timeout.
//
// Separate from FetchOptions because it predates field defaults, when a new field broke
// every FetchOptions literal. Folding it in now (`connectMs: i64 = 0` on FetchOptions)
// would still remove this type and fetchWithTimeout's third argument from every caller.
pub struct FetchTimeouts {
    connectMs: i64,
    totalMs: i64,
}

// A raw descriptor lent to a Select for one wait.
struct FetchWaitFd {
    fd: i32,
}

impl AsFd for FetchWaitFd {
    fn rawFd(self: &Self): i32 {
        return self.fd
    }
}

// The earlier of two deadlines (epoch ms), where 0 is none.
fn sooner(a: i64, b: i64): i64 {
    if a == 0 {
        return b
    }
    if b == 0 || a < b {
        return a
    }
    return b
}

fn deadlineIn(ms: i64): i64 {
    if ms <= 0 {
        return 0
    }
    return unrecordedEpochMillis() + ms
}

// Wait for `fd` to be readable (or writable) until `by` (epoch ms; 0 waits as long as
// it takes). False when `by` came first.
//
// Not a trace record of its own: the wait parks on a Select, and the scheduler poll
// that ends it is already one (sched.pick says whether the fd arm or the timer arm
// fired), so a replay times out exactly where the recording did, without waiting. A
// record wrapped around the wait came out AFTER the sched records written inside it,
// and the replay, asking for the wrapper first, diverged at the first wait.
fn waitIo(fd: i32, forRead: bool, by: i64): bool {
    // Select's fd and timer arms are inert without a scheduler, which a plain main
    // that never spawned a task does not have.
    ensureTimersLive()
    var sel = Select.new()
    let h = FetchWaitFd { fd: fd }
    if forRead {
        sel.onRead(h)
    } else {
        sel.onWrite(h)
    }
    if by > 0 {
        // A deadline already past still arms the timer (at 0) rather than returning
        // false here: that decision would read the unrecorded clock, so a replay,
        // running faster, would make it differently.
        var left = by - unrecordedEpochMillis()
        if left < 0 {
            left = 0
        }
        sel.onTimeout(left)
    }
    return sel.wait() == 0
}

// ── HTTP client ──

// Serialize a request. HTTP does not require Accept or User-Agent, but real
// servers reject requests without them: Overpass 406s an Accept-less client, and
// several public APIs 403 an anonymous one. Both are only supplied when the
// caller has not set their own, so an explicit header always wins.
// Asks the server to close the connection after its response (`Connection: close`),
// so the response ends where the stream does.
pub fn buildRequest(host: &string, path: &string, opts: &FetchOptions): string {
    return requestText(host, path, opts, false)
}

// buildRequest, or with `keepAlive` the same request without `Connection: close`:
// HTTP/1.1 keeps the connection open by default, and the response is read by its
// framing rather than to EOF.
fn requestText(host: &string, path: &string, opts: &FetchOptions, keepAlive: bool): string {
    var req: string = opts.method.clone() + " " + path.clone() + " HTTP/1.1\r\nHost: " + host.clone() + "\r\n"
    if !keepAlive && findHeader(opts.headers, "Connection").isNone() {
        req += "Connection: close\r\n"
    }
    if opts.headers.len > 0 {
        req = req + opts.headers.clone() + "\r\n"
    }
    if findHeader(opts.headers, "Accept").isNone() {
        req += "Accept: */*\r\n"
    }
    if findHeader(opts.headers, "User-Agent").isNone() {
        req += "User-Agent: milo/0.1\r\n"
    }
    if opts.body.len > 0 {
        req = req + "Content-Length: " + opts.body.len.toString() + "\r\n\r\n" + opts.body.clone()
    } else {
        req += "\r\n"
    }
    return req
}

fn isTimeout(e: &NetError): bool {
    match e {
        NetError.Timeout(_) => {
            return true
        }
        _ => {
            return false
        }
    }
}

// Connect to the first of `addrs` that accepts, trying them in order (resolveAll's
// RFC 6724 order), all bounded by `by` (epoch ms; 0 for none): one deadline shared by
// every attempt, so the time a dead first address took is not given back to the second.
//
// Sequential rather than Happy Eyeballs (RFC 8305): a refused address (a v6-only or
// v4-only server reached through `localhost`) fails at once and the next one is tried;
// what racing would add is an escape from an address that silently drops SYNs, and
// fetchWithTimeout's connect limit already bounds that wait. Sequential attempts also
// replay as the plain sequence of records they made.
fn connectAnyBy(addrs: &Vec<IpAddr>, port: u16, by: i64): Result<TcpStream, NetError> {
    var last = NetError.ConnectionFailed("no address")
    for a in addrs {
        match TcpStream.connectAddrWait(a, port, (fd: i32, forRead: bool): bool => waitIo(fd, forRead, by)) {
            Result.Ok(s) => {
                return Result.Ok(s)
            }
            Result.Err(e) => {
                if isTimeout(e) {
                    return Result.Err(e)
                }
                last = e
            }
        }
    }
    return Result.Err(last)
}

// A fresh connection for one request. Plain HTTP rides in a TlsStream too, with `_ssl`
// 0: Drop already handles that shape, and one type is what lets the pool and the
// response reader below serve both schemes. Such a stream never leaves this module.
fn openConn(useTls: bool, sni: &string, addrs: &Vec<IpAddr>, port: u16, by: i64): Result<TlsStream, NetError> {
    var tcp = connectAnyBy(addrs, port, by)?
    // take() moves the fd out of the TcpStream, so the TlsStream built here is its only
    // owner and its Drop the only close; the raw-fd constructors can't express that.
    unsafe {
        if useTls {
            return TlsStream.fromFdBy(tcp.take(), sni, "", by)
        }
        return Result.Ok(TlsStream {
            _fd: tcp.take(), _ssl: 0, _ctx: 0
        })
    }
}

fn connSend(c: &TlsStream, data: &string, by: i64): Result<i64, NetError> {
    if c._ssl != 0 {
        return c.sendBy(data, by)
    }
    let fd = c._fd
    unsafe {
        let sent = sendFdWait(fd, data, data.len, (forRead: bool): bool => waitIo(fd, forRead, by))
        if sent == IO_GAVE_UP {
            return Result.Err(NetError.Timeout("send"))
        }
        if sent < 0 {
            return Result.Err(NetError.SendFailed("send() failed"))
        }
        return Result.Ok(sent)
    }
}

// One read into `buf`: bytes read, 0 at EOF, < 0 on error, IO_GAVE_UP past `by`.
fn connRead(c: &TlsStream, buf: *u8, cap: i64, by: i64): i64 {
    let fd = c._fd
    unsafe {
        if c._ssl != 0 {
            let n = sslReadFdWait(c._ssl as *u8, fd, buf, cap as i32, (forRead: bool): bool => waitIo(fd, forRead, by))
            if n == SSL_GAVE_UP {
                return IO_GAVE_UP
            }
            return n as i64
        }
        return recvFdWait(fd, buf, cap, (forRead: bool): bool => waitIo(fd, forRead, by))
    }
}

// ── Response framing ──

// Index just past the first CRLFCRLF at or after `from`, or -1.
fn headEndFrom(raw: &string, from: i64): i64 {
    var i = from
    while i + 3 < raw.len {
        if raw[i] == '\r' && raw[i + 1] == '\n' && raw[i + 2] == '\r' && raw[i + 3] == '\n' {
            return i + 4
        }
        i += 1
    }
    return -1
}

// Does a comma-separated header value list `token` (case-insensitive)?
fn hasToken(value: &string, token: &string): bool {
    var i: i64 = 0
    while i + token.len <= value.len {
        if strEqNocase(value, i, token, token.len) {
            return true
        }
        i += 1
    }
    return false
}

// What one exchange produced, and whether its connection may carry another request.
struct Reply {
    resp: FetchResponse,
    reusable: bool,
}

// Send `req` on `c` and read one response by its framing: Content-Length, chunked, or
// none (HEAD, 1xx, 204, 304), so a kept-alive connection is not read to an EOF that
// never comes. A response with neither length nor chunked framing is read to EOF, as
// HTTP/1.1 says, and its connection is spent. `got` is set once any response byte
// arrives: a failure before that on a reused connection means the server had closed it.
fn exchange(c: &TlsStream, req: &string, isHead: bool, by: i64, maxBytes: i64, got: &mut bool): Result<Reply, NetError> {
    connSend(c, req, by)?
    var raw: string = ""
    // 16 KiB is a whole TLS record, so SSL_read never leaves part of one buffered in the
    // SSL object, where a byte past the response would hide from the leftover check.
    var buf: [u8; 16384] = [0; 16384]
    var headEnd: i64 = -1
    // frame end once known; -1 unknown yet, -2 chunked (see chunks), -3 read to EOF
    var need: i64 = -1
    var chunks = ChunkScan.new(0)
    var keepHdr = true
    var frameEnd: i64 = -1
    var capped = false
    while true {
        if maxBytes > 0 && raw.len >= maxBytes {
            capped = true
            break
        }
        var want: i64 = 16384
        if maxBytes > 0 && maxBytes - raw.len < want {
            want = maxBytes - raw.len
        }
        var n: i64 = 0
        unsafe { n = connRead(c, buf as *u8, want, by) }
        if n == IO_GAVE_UP {
            return Result.Err(NetError.Timeout("response"))
        }
        if n <= 0 {
            // Nothing at all: a reused connection the server had closed, or a server
            // that hung up without answering (curl's "empty reply from server").
            if raw.len == 0 && !got {
                return Result.Err(NetError.ConnectionFailed("empty reply from server"))
            }
            break
        }
        got = true
        let scanFrom = if raw.len > 3 { raw.len - 3 } else { 0 }
        for i in 0..n {
            raw.push(buf[i])
        }
        if headEnd < 0 {
            headEnd = headEndFrom(raw, scanFrom)
            if headEnd < 0 {
                continue
            }
            let status = parseStatus(raw)
            // An interim 1xx (100 Continue, 103 Early Hints) precedes the real response
            // on the same connection: drop it and read on. 101 is a protocol switch.
            if status >= 100 && status < 200 && status != 101 {
                raw = raw.substr(headEnd, raw.len)
                headEnd = -1
                continue
            }
            let headers = parseRawHeaders(raw)
            if hasToken(findHeader(headers, "Connection") ?? "", "close") || raw.startsWith("HTTP/1.0") {
                keepHdr = false
            }
            let te = findHeader(headers, "Transfer-Encoding") ?? ""
            let cl = findHeader(headers, "Content-Length")
            if isHead || status == 204 || status == 304 || status == 101 {
                need = headEnd
            } else if hasToken(te, "chunked") {
                need = -2
                chunks = ChunkScan.new(headEnd)
            } else if let Option.Some(v) = cl {
                need = headEnd + parseLength(v)
                if need < headEnd {
                    need = -3
                }
            } else {
                need = -3
            }
        }
        if need == -2 {
            let end = chunks.step(raw)
            if end >= 0 {
                frameEnd = end
                break
            }
            if end == chunkMalformed {
                need = -3
            }
        } else if need >= 0 && raw.len >= need {
            frameEnd = need
            break
        }
    }
    var reusable = false
    if frameEnd >= 0 {
        // Bytes past the frame mean the server and this reader disagree about where the
        // response ended; the next request on that connection would read them first.
        reusable = keepHdr && !capped && raw.len == frameEnd
        if raw.len > frameEnd {
            raw = raw.substr(0, frameEnd)
        }
    }
    return Result.Ok(Reply {
        resp: parseResponse(raw), reusable: reusable
    })
}

// A Content-Length value, or -1 if it is not a plain decimal.
fn parseLength(v: &string): i64 {
    if v.len == 0 || v.len > 18 {
        return -1
    }
    var n: i64 = 0
    for i in 0..v.len {
        if v[i] < '0' || v[i] > '9' {
            return -1
        }
        n = n * 10 + ((v[i] - '0') as i64)
    }
    return n
}

// ── Connection pool ──
//
// Idle keep-alive connections, keyed by scheme, host and port (and fetchAt's pinned
// address, so a vetted address is never swapped for a pooled connection to another).
// A request checks one out (removes it), so a connection serves one request at a time
// and concurrent green fetches to one host each get their own; it goes back when its
// response was framed, the server did not say `Connection: close`, and nothing followed
// the frame. At most MAX_IDLE_PER_HOST idle connections are kept per key: past that a
// returned connection is closed. Beyond the cap, a request opens a connection rather
// than waiting for one, so one slow response never holds up an unrelated request; the
// cap bounds what the pool keeps, not what is in flight.
//
// thread_local: green tasks on one scheduler share this pool and never race on it (they
// switch only at parks, and nothing here holds an element of it across one: entries
// are moved out by index before any IO). A Promise.blocking worker keeps none (see
// poolOn), since its thread ends after one call and nothing would close what it left.

struct IdleConn {
    key: string,
    conn: TlsStream,
    // when it went idle, epoch ms (the unrecorded clock; idleAlive's verdict is recorded)
    since: i64,
}

thread_local var gIdle: Vec<IdleConn> = []

let MAX_IDLE_PER_HOST: i64 = 6
let MAX_IDLE: i64 = 32
// A server typically closes an idle connection after 5 to 60 s; past this one is not
// tried at all.
let IDLE_MS: i64 = 30000

fn poolOn(): bool {
    return !isWorkerThread()
}

fn poolKey(useTls: bool, host: &string, port: u16, pin: &Option<u32>): string {
    var k = if useTls { "https://" } else { "http://" }
    k = k + host.clone() + ":" + (port as i64).toString()
    if let Option.Some(ip) = pin {
        k = k + "@" + (ip as i64).toString()
    }
    return k
}

// Whether an idle connection can carry a request: younger than IDLE_MS, and nothing to
// read on it. Idle, a server sends nothing, so readable means EOF (it closed), a
// close_notify, or stray bytes; any of them retires the connection, and so the one-byte
// probe may consume what it finds. The verdict is a trace record (net.reuse), so a
// replay reuses exactly the connections the recording did.
fn idleAlive(fd: i32, since: i64): bool {
    if replayOff() {
        return idleAliveLive(fd, since) == 1
    }
    return replayRet("net.reuse", fd.toString(), true, (): i64 => idleAliveLive(fd, since)) == 1
}

@replayHooked
fn idleAliveLive(fd: i32, since: i64): i64 {
    if unrecordedEpochMillis() - since > IDLE_MS {
        return 0
    }
    var b: [u8; 1] = [0; 1]
    unsafe {
        // the fd is nonblocking (connectAddrWait left it so): EAGAIN is the live answer
        let n = sockRead(fd, b as *u8, 1)
        if n < 0 && netErrno() == netEagain() {
            return 1
        }
    }
    return 0
}

// The most recently returned live connection for `key`, if any. Dead ones met on the
// way are dropped, which closes them.
fn checkout(key: &string): Option<TlsStream> {
    var i = gIdle.len - 1
    while i >= 0 {
        if gIdle[i].key == key {
            let e = gIdle.remove(i)
            if idleAlive(e.conn._fd, e.since) {
                return Option.Some(e.conn)
            }
        }
        i -= 1
    }
    return Option.None
}

fn checkin(key: string, c: TlsStream): void {
    var same: i64 = 0
    for i in 0..gIdle.len {
        if gIdle[i].key == key {
            same += 1
        }
    }
    if same >= MAX_IDLE_PER_HOST {
        return
    }
    if gIdle.len >= MAX_IDLE {
        // oldest first: the least likely to still be open server-side
        let _old = gIdle.remove(0)
    }
    gIdle.push(IdleConn {
        key: key, conn: c, since: unrecordedEpochMillis()
    })
}

// Methods RFC 9110 calls idempotent: sending one twice means what sending it once does,
// so a request that died on a stale connection can be sent again.
fn idempotent(method: &string): bool {
    return method == "GET" || method == "HEAD" || method == "PUT" || method == "DELETE" || method == "OPTIONS"
}

// One request for `url`, on a pooled connection when one is idle and on a fresh one
// otherwise. `pin` is fetchAt's address; without it the host is resolved, and only when
// a fresh connection is needed. Bounded by `connectBy` and `overallBy` (epoch ms; 0 for
// none); `maxBytes` caps the bytes read (0 for none).
fn fetchOnce(url: &string, opts: &FetchOptions, pin: Option<u32>, connectBy: i64, overallBy: i64, maxBytes: i64): Result<FetchResponse, NetError> {
    let useTls = isHttps(url)
    let host = parseHost(url)
    let port = parsePort(url)
    let isHead = opts.method == "HEAD"
    // A caller's own `Connection: close` is the per-request opt-out of the pool.
    let keepAlive = poolOn() && !hasToken(findHeader(opts.headers, "Connection") ?? "", "close")
    let req = requestText(hostHeader(url), parsePath(url), opts, keepAlive)
    let key = poolKey(useTls, host, port, pin)

    if keepAlive {
        if let Option.Some(c) = checkout(key) {
            var got = false
            match exchange(c, req, isHead, overallBy, maxBytes, &mut got) {
                Result.Ok(reply) => {
                    if reply.reusable {
                        checkin(key, c)
                    }
                    return Result.Ok(reply.resp)
                }
                Result.Err(e) => {
                    // The server closed the idle connection as this request went out
                    // (the probe raced it). Before any response byte nothing was
                    // answered, so an idempotent request goes again, once, on a fresh
                    // connection. A timeout is not staleness: its deadline is spent.
                    if got || isTimeout(e) || !idempotent(opts.method) {
                        return Result.Err(e)
                    }
                }
            }
        }
    }

    var addrs: Vec<IpAddr> = []
    if let Option.Some(ip) = pin {
        addrs.push(IpAddr.V4(ip))
    } else {
        addrs = resolveAll(host)?
        if overallBy > 0 && unrecordedEpochMillis() >= overallBy {
            return Result.Err(NetError.Timeout("dns"))
        }
    }
    let c = openConn(useTls, host, addrs, port, sooner(connectBy, overallBy))?
    var got = false
    let reply = exchange(c, req, isHead, overallBy, maxBytes, &mut got)?
    if keepAlive && reply.reusable {
        checkin(key, c)
    }
    return Result.Ok(reply.resp)
}

// The URL a redirect's Location points at, resolved against the request URL.
// A server may answer with a path alone (weather.gov sends
// `Location: /points/38.3396,-122.7011`), and fetching that bare string parsed
// an empty host, so the redirect failed as an unreachable upstream.
pub fn resolveLocation(base: &string, loc: &string): string {
    return resolveUrl(base, loc)
}

// Redirects followed before giving up, as curl and Go's net/http do: a server
// that redirects to itself used to recurse until the stack ran out.
let MAX_REDIRECTS: i64 = 10

fn doFetch(url: string, opts: FetchOptions): Result<FetchResponse, NetError> {
    return doFetchHops(url, opts, 0, FetchTimeouts { connectMs: 0, totalMs: 0 }, 0)
}

// `overallBy` is the totalMs deadline as epoch ms, fixed at the first hop so redirects
// share it.
fn doFetchHops(url: string, opts: FetchOptions, hops: i64, t: FetchTimeouts, overallBy: i64): Result<FetchResponse, NetError> {
    let r = fetchOnce(url, opts, Option.None, deadlineIn(t.connectMs), overallBy, 0)?

    // follow redirects (301, 302, 307, 308)
    if r.status == 301 || r.status == 302 || r.status == 307 || r.status == 308 {
        // An empty Location is as unfollowable as a missing one, so both collapse here.
        let loc = r.header("Location") ?? ""
        if loc.len > 0 && hops < MAX_REDIRECTS {
            var redirOpts = FetchOptions {
                method: opts.method.clone(),
                headers: opts.headers.clone(),
                body: opts.body.clone(),
            }
            if r.status == 301 || r.status == 302 {
                redirOpts.method = "GET"
                redirOpts.body = ""
            }
            return doFetchHops(resolveLocation(url, loc), redirOpts, hops + 1, t, overallBy)
        }
    }
    return Result.Ok(r)
}

// ── Public API ──

// One request for `url`, sent to the IPv4 address `ip` the caller already resolved
// (std/net `resolve`), with no redirect followed: a 3xx comes back as is, Location
// and all. The Host header and the TLS certificate name still come from `url`.
//
// This is the primitive for fetching a URL someone else chose. Checking the host's
// address and then calling `fetch` resolves the name twice, and a DNS answer that
// changes in between (rebinding) sends the request somewhere the check never saw;
// here the address checked is the address connected to. Each redirect hop is the
// caller's to vet and resolve the same way.
//
// At most `maxBytes` bytes of the response are read, headers included (0 for no
// limit), and the response is parsed from what arrived, so a cut-off body comes back
// short rather than as an error. `t` bounds the request as in fetchWithTimeout.
pub fn fetchAt(ip: u32, url: &string, opts: FetchOptions, t: FetchTimeouts, maxBytes: i64): Result<FetchResponse, NetError> {
    return fetchOnce(url, opts, Option.Some(ip), deadlineIn(t.connectMs), deadlineIn(t.totalMs), maxBytes)
}

// HTTP GET. Resolves the host, uses TLS for an https URL, and follows 301/302/307/308
// redirects.
pub fn fetch(url: &string): Result<FetchResponse, NetError> {
    var opts = FetchOptions {
        method: "GET", headers: "", body: ""
    }
    return doFetch(url.clone(), opts)
}

// An HTTP request with full control over method, headers and body. Redirects are
// followed as for `fetch`; a 301 or 302 turns the retry into a GET with no body.
pub fn fetchWith(url: &string, opts: FetchOptions): Result<FetchResponse, NetError> {
    return doFetch(url.clone(), opts)
}

// fetchWith that gives up: Err(NetError.Timeout(stage)) once `t.connectMs` passes on
// a connect, or `t.totalMs` on the whole request, instead of waiting on a server that
// stopped answering. Nothing is returned from a response cut off by the deadline.
pub fn fetchWithTimeout(url: &string, opts: FetchOptions, t: FetchTimeouts): Result<FetchResponse, NetError> {
    let by = deadlineIn(t.totalMs)
    return doFetchHops(url.clone(), opts, 0, t, by)
}

// HTTP POST of `body` with `Content-Type: application/json`.
pub fn fetchPost(url: &string, body: &string): Result<FetchResponse, NetError> {
    var opts = FetchOptions {
        method: "POST",
        headers: "Content-Type: application/json",
        body: body.clone(),
    }
    return doFetch(url.clone(), opts)
}

// POST an application/x-www-form-urlencoded body — build it with formEncode, or
// hand-roll it with urlEncode. Several APIs that nominally accept a raw body
// (Overpass, most OAuth token endpoints) only accept this content type.
pub fn fetchForm(url: &string, body: &string): Result<FetchResponse, NetError> {
    var opts = FetchOptions {
        method: "POST",
        headers: "Content-Type: application/x-www-form-urlencoded",
        body: body.clone(),
    }
    return doFetch(url.clone(), opts)
}

// HTTP PUT of `body` with `Content-Type: application/json`.
pub fn fetchPut(url: &string, body: &string): Result<FetchResponse, NetError> {
    var opts = FetchOptions {
        method: "PUT",
        headers: "Content-Type: application/json",
        body: body.clone(),
    }
    return doFetch(url.clone(), opts)
}

// HTTP DELETE.
pub fn fetchDelete(url: &string): Result<FetchResponse, NetError> {
    var opts = FetchOptions {
        method: "DELETE", headers: "", body: ""
    }
    return doFetch(url.clone(), opts)
}

// HTTP PATCH of `body` with `Content-Type: application/json`.
pub fn fetchPatch(url: &string, body: &string): Result<FetchResponse, NetError> {
    var opts = FetchOptions {
        method: "PATCH",
        headers: "Content-Type: application/json",
        body: body.clone(),
    }
    return doFetch(url.clone(), opts)
}
