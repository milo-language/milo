// std/string — string utility functions

// declared here rather than imported from std/os so std/string (pulled into
// every program via the prelude) stays dependency-free
extern fn memchr(s: *u8, c: i32, n: i64): *u8

extern fn memcmp(s1: *u8, s2: *u8, n: i64): i32

@cSig("stdlib.h", "double atof(const char *)")
extern fn atof(str: *u8): f64

// Check if haystack contains needle.

// True if `needle` occurs anywhere in `haystack` (empty needle → true).
fn strContains(haystack: &string, needle: &string): bool {
    return strIndexOfFrom(haystack, needle, 0) >= 0
}

// Find first occurrence of needle in haystack.

// Raw search helper. String.indexOf wraps the -1 sentinel as None.
fn strIndexOf(haystack: &string, needle: &string): i64 {
    return strIndexOfFrom(haystack, needle, 0)
}

// Find first occurrence of needle starting at pos.

// Raw search helper. String.indexOfFrom wraps the -1 sentinel as None.
fn strIndexOfFrom(haystack: &string, needle: &string, pos: i64): i64
requires pos >= 0
ensures result >= -1
{
    if needle.len == 0 {
        return pos
    }
    if pos < 0 as i64 {
        return -1
    }
    if pos + needle.len > haystack.len {
        return -1
    }
    // memchr skips to each candidate first byte (SIMD in libc), memcmp
    // verifies the rest — ~5x faster than a byte-at-a-time loop on big inputs
    let base = haystack.cstr() as i64
    let nptr = needle.cstr()
    let c0 = needle[0] as i32
    let last = haystack.len - needle.len
    var i: i64 = pos
    while i <= last {
        var hit: i64 = 0
        unsafe {
            let p = memchr((base + i) as *u8, c0, last - i + 1)
            hit = p as i64
        }
        if hit == 0 {
            return -1
        }
        i = hit - base
        var cmp: i32 = 0
        unsafe {
            cmp = memcmp((base + i) as *u8, nptr, needle.len)
        }
        if cmp == 0 {
            return i
        }
        i += 1
    }
    return -1
}

// First occurrence of `needle` in `haystack` at or after `pos`, comparing ASCII
// letters case-insensitively, or -1.
//
// Same memchr skip as strIndexOfFrom, with two differences that both come from case
// folding:
//
//   - The scan anchors on the first byte of the needle that is NOT a letter. That
//     byte has one spelling, so memchr runs once instead of once per case, and a
//     digit or punctuation byte is rarer in text than a letter, so each call rejects
//     far more. Searching "uint256" case-insensitively anchors on '2', not 'u'.
//     A needle that is all letters falls back to the two-pass scan on byte 0.
//   - When two passes ARE running, only the one whose hit was just consumed is
//     re-run. Refreshing both after every failed verify re-scans the rest of the
//     buffer per candidate, which is quadratic in candidate count.
//
// The verify is a byte loop rather than strncasecmp: the MSVC CRT spells that
// `_strnicmp`, and this file is in the prelude of every program on every platform.
// It only runs on candidate positions, which memchr has already made rare.
pub fn strIndexOfFromIgnoreCase(haystack: &string, needle: &string, pos: i64): i64
requires pos >= 0
ensures result >= -1
{
    if needle.len == 0 {
        return pos
    }
    if pos + needle.len > haystack.len {
        return -1
    }
    let base = haystack.cstr() as i64
    let last = haystack.len - needle.len

    var anchor: i64 = 0
    var k: i64 = 0
    while k < needle.len {
        if !asciiIsAlpha(needle[k]) {
            anchor = k
            break
        }
        k += 1
    }
    let ab = needle[anchor]
    let c1 = asciiToLower(ab) as i32
    var c2 = c1
    if asciiIsAlpha(ab) {
        c2 = asciiToUpper(ab) as i32
    }

    // Hit positions of the anchor byte in each case. -1 = must re-scan, -2 = no
    // further occurrence.
    var h1: i64 = -1
    var h2: i64 = -1
    if c2 == c1 {
        h2 = -2
    }
    var s: i64 = pos
    while s <= last
    invariant s >= 0
    {
        if h1 == -1 {
            var p: i64 = 0
            unsafe {
                p = memchr((base + s + anchor) as *u8, c1, last - s + 1) as i64
            }
            if p == 0 {
                h1 = -2
            } else {
                h1 = p - base
            }
        }
        if h2 == -1 {
            var p: i64 = 0
            unsafe {
                p = memchr((base + s + anchor) as *u8, c2, last - s + 1) as i64
            }
            if p == 0 {
                h2 = -2
            } else {
                h2 = p - base
            }
        }
        var h: i64 = -2
        if h1 >= 0 {
            h = h1
        }
        if h2 >= 0 && (h < 0 || h2 < h) {
            h = h2
        }
        if h < 0 {
            return -1
        }
        let start = h - anchor
        var j: i64 = 0
        while j < needle.len {
            if asciiToLower(haystack[start + j]) != asciiToLower(needle[j]) {
                break
            }
            j += 1
        }
        if j == needle.len {
            return start
        }
        // Only the consumed hit is stale; the other one is past `h`, so it is still
        // at or after the new cursor.
        if h1 == h {
            h1 = -1
        }
        if h2 == h {
            h2 = -1
        }
        s = start + 1
    }
    return -1
}

// True if `needle` occurs anywhere in `haystack`, ignoring ASCII case.
pub fn strContainsIgnoreCase(haystack: &string, needle: &string): bool {
    return strIndexOfFromIgnoreCase(haystack, needle, 0) >= 0
}

// Find last occurrence of needle.

// Raw search helper. String.lastIndexOf wraps the -1 sentinel as None.
fn strLastIndexOf(haystack: &string, needle: &string): i64 {
    if needle.len == 0 {
        return haystack.len
    }
    if needle.len > haystack.len {
        return -1
    }
    var i: i64 = haystack.len - needle.len
    while i >= 0 as i64 {
        var j: i64 = 0
        while j < needle.len {
            if haystack[i + j] != needle[j] {
                break
            }
            j += 1
        }
        if j == needle.len {
            return i
        }
        i -= 1
    }
    return -1
}

// Check if string starts with prefix.

// True if `s` begins with `prefix`.
fn strStartsWith(s: &string, prefix: &string): bool {
    if prefix.len > s.len {
        return false
    }
    for i in 0..prefix.len {
        if s[i] != prefix[i] {
            return false
        }
    }
    return true
}

// Check if string ends with suffix.

// True if `s` ends with `suffix`.
fn strEndsWith(s: &string, suffix: &string): bool {
    if suffix.len > s.len {
        return false
    }
    let offset = s.len - suffix.len
    for i in 0..suffix.len {
        if s[offset + i] != suffix[i] {
            return false
        }
    }
    return true
}

// Return new string with ASCII uppercase letters converted to lowercase.

// ASCII-lowercased copy (A–Z → a–z; other bytes unchanged).
fn strToLower(s: &string): string
ensures result.len == s.len
{
    var result: string = ""
    for i in 0..s.len {
        let ch = s[i]
        if ch >= 65 && ch <= 90 {
            result.push(ch + 32)
        } else {
            result.push(ch)
        }
    }
    return result
}

// Return new string with ASCII lowercase letters converted to uppercase.

// ASCII-uppercased copy (a–z → A–Z; other bytes unchanged).
fn strToUpper(s: &string): string
ensures result.len == s.len
{
    var result: string = ""
    for i in 0..s.len {
        let ch = s[i]
        if ch >= 97 && ch <= 122 {
            result.push(ch - 32)
        } else {
            result.push(ch)
        }
    }
    return result
}

// Strip leading and trailing ASCII whitespace (space, tab, newline, carriage return).

// Copy with leading and trailing ASCII whitespace removed.
fn strTrim(s: &string): string {
    var start: i64 = 0
    while start < s.len {
        let ch = s[start]
        if ch != 32 && ch != 9 && ch != 10 && ch != 13 {
            break
        }
        start += 1
    }
    var end: i64 = s.len
    while end > start {
        let ch = s[end - 1]
        if ch != 32 && ch != 9 && ch != 10 && ch != 13 {
            break
        }
        end -= 1
    }
    if start >= end {
        return ""
    }
    return s.substr(start, end)
}

// Strip leading ASCII whitespace.

// Copy with leading ASCII whitespace removed.
fn strTrimStart(s: &string): string {
    var start: i64 = 0
    while start < s.len {
        let ch = s[start]
        if ch != 32 && ch != 9 && ch != 10 && ch != 13 {
            break
        }
        start += 1
    }
    if start >= s.len {
        return ""
    }
    return s.substr(start, s.len)
}

// Strip trailing ASCII whitespace.

// Copy with trailing ASCII whitespace removed.
fn strTrimEnd(s: &string): string {
    var end: i64 = s.len
    while end > 0 as i64 {
        let ch = s[end - 1]
        if ch != 32 && ch != 9 && ch != 10 && ch != 13 {
            break
        }
        end -= 1
    }
    if end <= 0 as i64 {
        return ""
    }
    return s.substr(0 as i64, end)
}

// Split string by separator. Returns Vec of substrings.

// Split `s` on every occurrence of `sep` into a Vec of pieces (adjacent
// separators yield empty pieces; keeps them, unlike strSplitWhitespace).
fn strSplit(s: &string, sep: &string): Vec<string> {
    var result: Vec<string> = Vec.new()
    if sep.len == 0 {
        for i in 0..s.len {
            result.push(s.substr(i, i + 1))
        }
        return result
    }
    var pos: i64 = 0
    // Carries `strIndexOfFrom`'s `requires pos >= 0` across the loop: without it `pos` is
    // a fresh unknown on the second and later iterations and the call cannot be discharged.
    while pos <= s.len
    invariant pos >= 0
    {
        let found = strIndexOfFrom(s, sep, pos)
        if found < 0 {
            result.push(s.substr(pos, s.len))
            break
        }
        let idx = found
        result.push(s.substr(pos, idx))
        pos = idx + sep.len
    }
    return result
}

// Repeat a string n times.

// `s` concatenated `n` times (n <= 0 → empty string).
fn strRepeat(s: &string, n: i64): string
requires n >= 0
{
    var result: string = ""
    for i in 0..n {
        result += s
    }
    return result
}

// Pad start of string to targetLen using padStr (cycles if shorter than needed).

// Left-pad `s` with repeated `padStr` until it is `targetLen` characters long
// (returned unchanged if already at least that long). Characters, not bytes: a
// column of "café" and "cafe" lines up. The pad string is cycled by character too,
// so a multibyte pad is never cut.
fn strPadStart(s: &string, targetLen: i64, padStr: &string): string
requires targetLen >= 0
{
    var needed: i64 = targetLen - _charCount(s)
    if needed <= 0 || padStr.len == 0 {
        return s.clone()
    }
    var padding: string = ""
    while needed > 0 {
        var i: i64 = 0
        while i < padStr.len && needed > 0 {
            let w = _utf8Width(padStr[i])
            padding += padStr.substr(i, i + w)
            i += w
            needed -= 1
        }
    }
    return padding + s
}

// Pad end of string to targetLen using padStr (cycles if shorter than needed).

// Right-pad `s` with repeated `padStr` until it is `targetLen` characters long
// (returned unchanged if already at least that long). Characters, not bytes, as
// strPadStart.
fn strPadEnd(s: &string, targetLen: i64, padStr: &string): string
requires targetLen >= 0
{
    var needed: i64 = targetLen - _charCount(s)
    if needed <= 0 || padStr.len == 0 {
        return s.clone()
    }
    var result: string = s.clone()
    while needed > 0 {
        var i: i64 = 0
        while i < padStr.len && needed > 0 {
            let w = _utf8Width(padStr[i])
            result += padStr.substr(i, i + w)
            i += w
            needed -= 1
        }
    }
    return result
}

// Replace all occurrences of old with newVal.

// Copy of `s` with every occurrence of `old` replaced by `newVal`.
fn strReplace(s: &string, old: &string, newVal: &string): string {
    if old.len == 0 {
        return s.clone()
    }
    var result: string = ""
    var pos: i64 = 0
    // See strSplit: keeps `pos >= 0` available for strIndexOfFrom's precondition.
    while pos < s.len
    invariant pos >= 0
    {
        let found = strIndexOfFrom(s, old, pos)
        if found < 0 {
            result += s.substr(pos, s.len)
            break
        }
        let idx = found
        if idx > pos {
            result += s.substr(pos, idx)
        }
        result += newVal
        pos = idx + old.len
    }
    return result
}

// Check if a byte is ASCII whitespace.
pub fn asciiIsWhitespace(ch: u8): bool {
    return ch == 32 || ch == 9 || ch == 10 || ch == 13
}

// Check if a byte is an ASCII digit.
pub fn asciiIsDigit(ch: u8): bool {
    return ch >= 48 && ch <= 57
}

// Check if a byte is an ASCII letter.
pub fn asciiIsAlpha(ch: u8): bool {
    return (ch >= 65 && ch <= 90) || (ch >= 97 && ch <= 122)
}

// Check if a byte is an ASCII letter or digit.
pub fn asciiIsAlphanumeric(ch: u8): bool {
    return asciiIsAlpha(ch) || asciiIsDigit(ch)
}

pub fn asciiIsLower(ch: u8): bool {
    return ch >= 'a' && ch <= 'z'
}

pub fn asciiIsUpper(ch: u8): bool {
    return ch >= 'A' && ch <= 'Z'
}

pub fn asciiIsPunctuation(ch: u8): bool {
    return (ch >= 33 && ch <= 47) || (ch >= 58 && ch <= 64) || (ch >= 91 && ch <= 96) || (ch >= 123 && ch <= 126)
}

pub fn asciiIsHexDigit(ch: u8): bool {
    return asciiIsDigit(ch) || (ch >= 'a' && ch <= 'f') || (ch >= 'A' && ch <= 'F')
}

pub fn asciiIsPrintable(ch: u8): bool {
    return ch >= 32 && ch < 127
}

pub fn asciiIsControl(ch: u8): bool {
    return ch < 32 || ch == 127
}

pub fn asciiToLower(ch: u8): u8 {
    if asciiIsUpper(ch) {
        return ch + 32
    }
    return ch
}

pub fn asciiToUpper(ch: u8): u8 {
    if asciiIsLower(ch) {
        return ch - 32
    }
    return ch
}

// Split string into words (contiguous alphabetic sequences), lowercased.

// Extract maximal runs of ASCII letters as lowercased words, dropping all
// other characters (digits, punctuation, whitespace). For tokenizing prose.
fn strSplitWords(s: &string): Vec<string> {
    var result: Vec<string> = Vec.new()
    var word: string = ""
    for i in 0..s.len {
        let ch = s[i]
        if asciiIsAlpha(ch) {
            if ch >= 65 && ch <= 90 {
                word.push(ch + 32)
            } else {
                word.push(ch)
            }
        } else {
            if word.len > 0 {
                result.push(word)
                word = ""
            }
        }
    }
    if word.len > 0 {
        result.push(word)
    }
    return result
}

// Split string on whitespace into non-empty tokens.

// Split on runs of whitespace into non-empty tokens (no empty pieces, unlike
// strSplit). Leading/trailing whitespace is ignored.
fn strSplitWhitespace(s: &string): Vec<string> {
    var result: Vec<string> = Vec.new()
    var token: string = ""
    for i in 0..s.len {
        let ch = s[i]
        if asciiIsWhitespace(ch) {
            if token.len > 0 {
                result.push(token)
                token = ""
            }
        } else {
            token.push(ch)
        }
    }
    if token.len > 0 {
        result.push(token)
    }
    return result
}

fn vecJoin(parts: &Vec<string>, sep: &string): string {
    var result: string = ""
    for i in 0..parts.len {
        if i > 0 {
            result += sep
        }
        result += parts[i]
    }
    return result
}

// True if `s` has zero length.
fn strIsEmpty(s: &string): bool {
    return s.len == 0
}

// The character that starts at byte `idx`, as a string of one to four bytes. `idx`
// is a byte offset, so `"aéb".charAt(1)` is "é" and `.charAt(2)`, the middle of the
// é, aborts rather than answering half a character. An `if` and not an `assert`:
// contracts compile out at -O2 and this must hold in every build. Requires
// 0 <= idx < s.len. Bytes that are not text go through `s[idx]`, which is a byte.
fn strCharAt(s: &string, idx: i64): string
requires idx >= 0 && idx < s.len
{
    if (s[idx] & 192) == 128 {
        eprint("milo: charAt(", idx, ") lands inside a multibyte UTF-8 character; charAt takes a byte offset, iterate with codePoints() for characters")
        exit(1)
    }
    return s.substr(idx, idx + _utf8Width(s[idx]))
}

// Byte length of the UTF-8 sequence that `lead` begins: 1 for ASCII, 2-4 by the
// lead byte's high bits. A continuation byte (10xxxxxx) has no width of its own and
// is reported as 1 so a caller that lands on one reads a single byte, never past
// the character.
fn _utf8Width(lead: u8): i64 {
    if lead < 128 {
        return 1
    }
    if lead >= 240 {
        return 4
    }
    if lead >= 224 {
        return 3
    }
    if lead >= 192 {
        return 2
    }
    return 1
}

// Characters (code points) in `s`: every byte that is not a continuation byte
// starts one. What padStart/padEnd measure, so "日本" pads as two columns wide,
// not six.
fn _charCount(s: &string): i64 {
    var n: i64 = 0
    for i in 0..s.len {
        if (s[i] & 192) != 128 {
            n += 1
        }
    }
    return n
}

// UTF-8 aware: scans backward past continuation bytes to reverse whole codepoints
fn strReverse(s: &string): string
ensures result.len == s.len
{
    var result: string = ""
    var i: i64 = s.len
    while i > 0 {
        var start: i64 = i - 1
        while start > 0 && (s[start] & 192) == 128 {
            start -= 1
        }
        var j: i64 = start
        while j < i {
            result.push(s[j])
            j += 1
        }
        i = start
    }
    return result
}

// The single base-10 integer parser: `s.parseInt()` lowers to this and
// `std/strconv.parseInt` forwards to it. Some(n) only when the whole string is
// an optionally-signed run of ASCII digits that fits in i64. Trailing junk,
// surrounding whitespace, an empty string, and out-of-range values are all None.
//
// Digits accumulate NEGATIVE because the i64 range is asymmetric: i64::MIN has no
// positive counterpart to build up in. Overflow is rejected here instead of being
// left to the arithmetic trap — a parser fed hostile input must answer None, not
// abort the process.
fn strParseInt(s: &string): Option<i64> {
    let minI64: i64 = -9223372036854775807 - 1
    var i: i64 = 0
    var negative: bool = false
    if s.len > 0 && (s[0] == 45 || s[0] == 43) {
        negative = s[0] == 45
        i = 1
    }
    if i >= s.len {
        return Option.None
    }
    var acc: i64 = 0
    while i < s.len {
        let ch = s[i]
        if ch < 48 || ch > 57 {
            return Option.None
        }
        let digit: i64 = (ch - 48) as i64
        // acc*10 - digit must stay >= minI64. Signed division truncates toward
        // zero, which for a negative quotient is exactly the ceiling this needs.
        if acc < (minI64 + digit) / 10 {
            return Option.None
        }
        acc = acc * 10 - digit
        i += 1
    }
    if negative {
        return Option.Some(acc)
    }
    if acc == minI64 {
        return Option.None
    }
    return Option.Some(0 - acc)
}

// Strict float-literal shape for strParseF64: optional sign, digits with at most
// one '.', optional exponent. atof stops at the first byte it can't use and
// reports nothing, so the whole string has to be validated before it runs.
fn _strIsFloatText(s: &string): bool {
    var i: i64 = 0
    if i < s.len && (s[i] == 43 || s[i] == 45) {
        i += 1
    }
    var digits: i64 = 0
    while i < s.len && s[i] >= 48 && s[i] <= 57 {
        digits += 1
        i += 1
    }
    if i < s.len && s[i] == 46 {
        i += 1
        while i < s.len && s[i] >= 48 && s[i] <= 57 {
            digits += 1
            i += 1
        }
    }
    if digits == 0 {
        return false
    }
    if i < s.len && (s[i] == 101 || s[i] == 69) {
        i += 1
        if i < s.len && (s[i] == 43 || s[i] == 45) {
            i += 1
        }
        var expDigits: i64 = 0
        while i < s.len && s[i] >= 48 && s[i] <= 57 {
            expDigits += 1
            i += 1
        }
        if expDigits == 0 {
            return false
        }
    }
    return i == s.len
}

// The single float parser: `s.parseF64()` lowers to this and
// `std/strconv.parseFloat` forwards to it. Some(x) only for a complete float
// literal; "abc", "1.2x", " 1.2", "inf" and "nan" are all None.
fn strParseF64(s: &string): Option<f64> {
    if !_strIsFloatText(s) {
        return Option.None
    }
    // atof reads to a NUL, and `s` may be a VIEW into a larger buffer (`s.slice(a, b)`,
    // a `lines()` piece) whose byte at s.len is another digit — `"12345".slice(0, 2)`
    // parsed as 12345 before this copy existed. An owned string is NUL-terminated at
    // its own length, so the copy is what bounds the read.
    let owned = s.substr(0, s.len)
    var v: f64 = 0.0
    v = atof(owned.cstr())
    return Option.Some(v)
}

// Copy of `s` with only the first occurrence of `old` replaced by `newVal`.
fn strReplaceFirst(s: &string, old: &string, newVal: &string): string {
    let found = strIndexOf(s, old)
    if found < 0 {
        return s.clone()
    }
    let idx = found
    return s.substr(0, idx) + newVal + s.substr(idx + old.len, s.len)
}
