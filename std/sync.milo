// std/sync — synchronization primitives (channel, waitgroup, once, atomics) via pthreads

from "std/platform" import {
    pthread_cond_broadcast, pthread_cond_destroy, pthread_cond_init, pthread_cond_signal, pthread_cond_wait, pthread_mutex_destroy, pthread_mutex_init, pthread_mutex_lock, pthread_mutex_unlock, pthread_self
}
from "std/os" import {
    free, malloc, memcpy, memset
}
from "std/runtime" import {
    schedulerCurrent, schedulerExists, schedulerPark, schedulerUnpark, schedulerBlockMain, schedulerPollMain, selectTryClaim, nodeKind, nodeNext, nodeA, nodeArm, kindPlain
}

// ── Channel<T> ──
// Bounded FIFO channel for safe message passing between threads.
// Channel is a reference-counted handle — `.clone()` to share it with another owner
// (a task/worker); the queue frees itself when the last owner drops. No manual destroy.
// Payloads still queued when the last owner drops are destroyed (their `Drop` runs,
// once each); payloads already received belong to the receiver and are untouched.
//
//   let ch = Channel<i64>.new(16)!
//   let chW = ch.clone()
//   let p = Promise<i64>.blocking(move (): i64 => {
//       chW.send(42)!
//       return 0
//   })
//   let val = ch.recv()!
//   p.await()!
//   // ch (and chW, dropped by the worker) free the queue automatically
pub struct ChannelInner {
    mtx: *u8,
    condNotEmpty: *u8,
    condNotFull: *u8,
    buf: *u8,
    capacity: i64,
    len: i64,
    head: i64,
    tail: i64,
    closed: i64,
    // intrusive lists of parked green tasks; nodes live on the parked task's
    // stack: [0..8) task ptr, [8..16) next ptr. pthread waiters use the conds.
    recvWaitHead: *u8,
    sendWaitHead: *u8,
    // inlined Arc-style refcount. `Channel<T>.drop` takes the last-owner decrement
    // itself (it must destroy queued payloads, which needs T) and then zeroes its
    // ChannelHandle so the handle's own Drop below is a no-op.
    refcount: i64,
}

// Non-generic reference-counted owner of a ChannelInner. Channel<T> holds one of these;
// the handle's Drop is the fallback for a handle that was never wrapped, and the
// refcount/free logic lives here once, free of T.
pub struct ChannelHandle {
    _ptr: *u8,
}

unsafe

impl Send for ChannelHandle {
}
unsafe

impl Sync for ChannelHandle {
}

impl ChannelHandle {
    fn retain(self: &Self): ChannelHandle {
        unsafe {
            let inner = self._ptr as *ChannelInner
            _atomicAddI64(((*inner).refcount).addrOf() as *u8, 1)
            return ChannelHandle {
                _ptr: self._ptr
            }
        }
    }
}

impl Drop for ChannelHandle {
    fn drop(self: &mut Self): void {
        // A zeroed handle must drop to nothing. send/trySend hand the payload to the
        // buffer with memcpy and then memset the local to zero rather than forgetting
        // it, so the moved-from value still drops; recv/tryRecv build a `zeroed<T>()`
        // that drops untouched on every early return. That is inert for string and Vec
        // (free(0) is a no-op) and used to fault here for anything holding a channel,
        // which is why std/mem, std/pool and std/seal all guard the same way.
        if self._ptr as i64 == 0 {
            return
        }
        unsafe {
            let inner = self._ptr as *ChannelInner
            let old = _atomicSubI64(((*inner).refcount).addrOf() as *u8, 1)
            if old == 1 {
                channelFreeInner(inner)
            }
        }
    }
}

// Release everything a ChannelInner owns except the queued payloads, which only the
// generic `Channel<T>.drop` can destroy. Caller holds the last reference.
fn channelFreeInner(inner: *ChannelInner): void {
    unsafe {
        pthread_mutex_destroy((*inner).mtx)
        pthread_cond_destroy((*inner).condNotEmpty)
        pthread_cond_destroy((*inner).condNotFull)
        free((*inner).mtx)
        free((*inner).condNotEmpty)
        free((*inner).condNotFull)
        free((*inner).buf)
        free(inner as *u8)
    }
}

// Waiter nodes use the unified 48-byte runtime layout (see std/runtime): plain
// channel waiters are kind 0 with the task ptr at nodeA; Select arms (kind 1/2)
// carry a SelectState ptr + arm index and take the claim path when woken.
fn nodeLoadPtr(node: *u8, off: i64): *u8 {
    unsafe {
        var v: *u8 = 0 as *u8
        memcpy((v.addrOf()) as *u8, (node as i64 + off) as *u8, 8)
        return v
    }
}

fn nodeStorePtr(node: *u8, off: i64, v: *u8): void {
    unsafe {
        memcpy((node as i64 + off) as *u8, (v.addrOf()) as *u8, 8)
    }
}

fn nodeLoadI64(node: *u8, off: i64): i64 {
    unsafe {
        var v: i64 = 0
        memcpy((v.addrOf()) as *u8, (node as i64 + off) as *u8, 8)
        return v
    }
}

fn nodeStoreI64(node: *u8, off: i64, v: i64): void {
    unsafe {
        memcpy((node as i64 + off) as *u8, (v.addrOf()) as *u8, 8)
    }
}

// Pop one waiter off `head` (a channel wait list) and wake it. Caller holds the
// channel mutex. A plain waiter's task is unparked; a Select arm claims the
// select. Returns the new head. The node must not be touched after this — the
// woken task's frame (plain) or the Select (arm) owns it.
fn wakeOne(head: *u8): *u8 {
    if head as i64 == 0 {
        return 0 as *u8
    }
    let next = nodeLoadPtr(head, nodeNext())
    if nodeLoadI64(head, nodeKind()) == kindPlain() {
        schedulerUnpark(nodeLoadPtr(head, nodeA()))
    } else {
        selectTryClaim(nodeLoadPtr(head, nodeA()), nodeLoadI64(head, nodeArm()))
    }
    return next
}

// Unlink `node` from a wait list if present. Caller holds the channel mutex.
fn unlinkNode(head: *u8, node: *u8): *u8 {
    if head as i64 == 0 {
        return 0 as *u8
    }
    if head as i64 == node as i64 {
        return nodeLoadPtr(head, nodeNext())
    }
    var prev = head
    var cur = nodeLoadPtr(head, nodeNext())
    while cur as i64 != 0 {
        let next = nodeLoadPtr(cur, nodeNext())
        if cur as i64 == node as i64 {
            nodeStorePtr(prev, nodeNext(), next)
            return head
        }
        prev = cur
        cur = next
    }
    return head
}

// Park the current green task as a receive waiter. Caller holds mtx; returns
// with mtx re-acquired. The waiter node lives on this frame's stack — safe
// because the frame stays alive while parked and the waker pops the node
// (under mtx) before unparking, so it never dangles.
fn chParkRecv(inner: *ChannelInner): void {
    unsafe {
        var w: [u8; 48] = [0; 48]
        let wp = w as *u8
        nodeStoreI64(wp, nodeKind(), kindPlain())
        nodeStorePtr(wp, nodeA(), schedulerCurrent())
        nodeStorePtr(wp, nodeNext(), (*inner).recvWaitHead)
        (*inner).recvWaitHead = wp
        pthread_mutex_unlock((*inner).mtx)
        schedulerPark()
        pthread_mutex_lock((*inner).mtx)
    }
}

fn chParkSend(inner: *ChannelInner): void {
    unsafe {
        var w: [u8; 48] = [0; 48]
        let wp = w as *u8
        nodeStoreI64(wp, nodeKind(), kindPlain())
        nodeStorePtr(wp, nodeA(), schedulerCurrent())
        nodeStorePtr(wp, nodeNext(), (*inner).sendWaitHead)
        (*inner).sendWaitHead = wp
        pthread_mutex_unlock((*inner).mtx)
        schedulerPark()
        pthread_mutex_lock((*inner).mtx)
    }
}

fn chWakeOneRecv(inner: *ChannelInner): void {
    unsafe {
        (*inner).recvWaitHead = wakeOne((*inner).recvWaitHead)
    }
}

fn chWakeOneSend(inner: *ChannelInner): void {
    unsafe {
        (*inner).sendWaitHead = wakeOne((*inner).sendWaitHead)
    }
}

// ── Select arm hooks (called from std/select) ──

// Arm a Select recv on this channel. Returns true if recv would proceed right
// now (buffer non-empty or closed) — the caller claims immediately and does not
// link. Otherwise links `node` (kind sel-recv) and returns false.
// @internal
pub fn channelArmRecv(ptr: *u8, node: *u8): bool {
    unsafe {
        let inner = ptr as *ChannelInner
        pthread_mutex_lock((*inner).mtx)
        if (*inner).closed == 1 || (*inner).len > 0 {
            pthread_mutex_unlock((*inner).mtx)
            return true
        }
        nodeStorePtr(node, nodeNext(), (*inner).recvWaitHead)
        (*inner).recvWaitHead = node
        pthread_mutex_unlock((*inner).mtx)
        return false
    }
}

// Arm a Select send. Ready if the buffer has room or the channel is closed
// (a send on a closed channel returns Err rather than blocking).
// @internal
pub fn channelArmSend(ptr: *u8, node: *u8): bool {
    unsafe {
        let inner = ptr as *ChannelInner
        pthread_mutex_lock((*inner).mtx)
        if (*inner).closed == 1 || (*inner).len < (*inner).capacity {
            pthread_mutex_unlock((*inner).mtx)
            return true
        }
        nodeStorePtr(node, nodeNext(), (*inner).sendWaitHead)
        (*inner).sendWaitHead = node
        pthread_mutex_unlock((*inner).mtx)
        return false
    }
}

// @internal
pub fn channelUnarmRecv(ptr: *u8, node: *u8): void {
    unsafe {
        let inner = ptr as *ChannelInner
        pthread_mutex_lock((*inner).mtx)
        (*inner).recvWaitHead = unlinkNode((*inner).recvWaitHead, node)
        pthread_mutex_unlock((*inner).mtx)
    }
}

// @internal
pub fn channelUnarmSend(ptr: *u8, node: *u8): void {
    unsafe {
        let inner = ptr as *ChannelInner
        pthread_mutex_lock((*inner).mtx)
        (*inner).sendWaitHead = unlinkNode((*inner).sendWaitHead, node)
        pthread_mutex_unlock((*inner).mtx)
    }
}

pub struct Channel<T> {
    h: ChannelHandle,
}

// Safety: every access to ChannelInner is serialized by its pthread mutex; values
// cross the boundary by move through the owned ring-buffer slots.
unsafe

impl Send for Channel<T> {
}
unsafe

impl Sync for Channel<T> {
}

impl Channel<T> {
    fn new(capacity: i64): Result<Channel<T>>
    requires
    capacity > 0
    {
        // Checked at every -O, not only by the contract: a non-positive capacity mallocs
        // nothing and `send` then writes through it (a negative one never sees the buffer
        // as full).
        if capacity <= 0 {
            return Result.Err("channel capacity must be positive")
        }
        unsafe {
            let raw = malloc(96)
            let inner = raw as *ChannelInner

            let mtx = malloc(64)
            let r1 = pthread_mutex_init(mtx, 0 as *u8)
            if r1 != 0 {
                free(mtx)
                free(raw)
                return Result.Err("channel mutex init failed")
            }
            let cne = malloc(48)
            let r2 = pthread_cond_init(cne, 0 as *u8)
            if r2 != 0 {
                free(mtx)
                free(cne)
                free(raw)
                return Result.Err("channel cond init failed")
            }
            let cnf = malloc(48)
            let r3 = pthread_cond_init(cnf, 0 as *u8)
            if r3 != 0 {
                free(mtx)
                free(cne)
                free(cnf)
                free(raw)
                return Result.Err("channel cond init failed")
            }

            (*inner).mtx = mtx
            (*inner).condNotEmpty = cne
            (*inner).condNotFull = cnf
            (*inner).buf = malloc(capacity * sizeOf<T>())
            (*inner).capacity = capacity
            (*inner).len = 0
            (*inner).head = 0
            (*inner).tail = 0
            (*inner).closed = 0
            (*inner).recvWaitHead = 0 as *u8
            (*inner).sendWaitHead = 0 as *u8
            (*inner).refcount = 1

            return Result.Ok(Channel {
                h: ChannelHandle {
                    _ptr: raw
                }
            })
        }
    }

    fn send(self: &Self, val: T): Result<i32> {
        var v: T = val
        unsafe {
            let inner = self.h._ptr as *ChannelInner
            let mtx = (*inner).mtx
            let cap = (*inner).capacity

            pthread_mutex_lock(mtx)
            if (*inner).closed == 1 {
                pthread_mutex_unlock(mtx)
                return Result.Err("channel closed")
            }
            var curLen: i64 = (*inner).len
            while curLen == cap {
                // in a green task, park the task so the scheduler keeps
                // running; on the main thread with a live scheduler, drive it
                // so a green receiver can drain the buffer (blocking the cond
                // here would hang — nobody else would run the scheduler, and
                // the receiver may itself be a green task); on a plain OS
                // thread, block on the cond as before.
                if schedulerCurrent() as i64 != 0 {
                    chParkSend(inner)
                } else if schedulerExists() {
                    pthread_mutex_unlock(mtx)
                    schedulerPollMain()
                    pthread_mutex_lock(mtx)
                } else {
                    pthread_cond_wait((*inner).condNotFull, mtx)
                }
                if (*inner).closed == 1 {
                    pthread_mutex_unlock(mtx)
                    return Result.Err("channel closed")
                }
                curLen = (*inner).len
            }
            var tail: i64 = (*inner).tail
            let slotPtr = ((*inner).buf as i64 + tail * sizeOf<T>()) as *u8
            memcpy(slotPtr, (v.addrOf()) as *u8, sizeOf<T>())
            // ownership transferred to channel buffer; zero without drop
            memset((v.addrOf()) as *u8, 0, sizeOf<T>())
            (*inner).tail = (tail + 1) % cap
            (*inner).len = curLen + 1
            // a green receiver and a pthread receiver may both be waiting
            chWakeOneRecv(inner)
            pthread_cond_signal((*inner).condNotEmpty)
            pthread_mutex_unlock(mtx)
            return Result.Ok(0)
        }
    }

    fn recv(self: &Self): Result<T> {
        unsafe {
            var val: T = zeroed<T>()
            let inner = self.h._ptr as *ChannelInner
            let mtx = (*inner).mtx
            let cap = (*inner).capacity

            pthread_mutex_lock(mtx)
            var curLen: i64 = (*inner).len
            while curLen == 0 {
                if (*inner).closed == 1 {
                    pthread_mutex_unlock(mtx)
                    return Result.Err("channel closed")
                }
                // green task: park (scheduler keeps running). main thread with
                // a live scheduler: drive it so a green sender can fill the
                // buffer — the two-branch version deadlocked here because the
                // cond wait blocked the only thread that could run the sender.
                // plain OS thread: block on the cond, woken by a foreign send.
                if schedulerCurrent() as i64 != 0 {
                    chParkRecv(inner)
                } else if schedulerExists() {
                    pthread_mutex_unlock(mtx)
                    schedulerPollMain()
                    pthread_mutex_lock(mtx)
                } else {
                    pthread_cond_wait((*inner).condNotEmpty, mtx)
                }
                curLen = (*inner).len
            }
            var head: i64 = (*inner).head
            let slotPtr = ((*inner).buf as i64 + head * sizeOf<T>()) as *u8
            memcpy((val.addrOf()) as *u8, slotPtr, sizeOf<T>())
            (*inner).head = (head + 1) % cap
            (*inner).len = curLen - 1
            chWakeOneSend(inner)
            pthread_cond_signal((*inner).condNotFull)
            pthread_mutex_unlock(mtx)
            return Result.Ok(val)
        }
    }

    fn trySend(self: &Self, val: T): bool {
        var v: T = val
        unsafe {
            let inner = self.h._ptr as *ChannelInner
            let mtx = (*inner).mtx

            pthread_mutex_lock(mtx)
            let curLen: i64 = (*inner).len
            let cap = (*inner).capacity
            if curLen == cap {
                pthread_mutex_unlock(mtx)
                return false
            }
            var tail: i64 = (*inner).tail
            let slotPtr = ((*inner).buf as i64 + tail * sizeOf<T>()) as *u8
            memcpy(slotPtr, (v.addrOf()) as *u8, sizeOf<T>())
            memset((v.addrOf()) as *u8, 0, sizeOf<T>())
            (*inner).tail = (tail + 1) % cap
            (*inner).len = curLen + 1
            chWakeOneRecv(inner)
            pthread_cond_signal((*inner).condNotEmpty)
            pthread_mutex_unlock(mtx)
            return true
        }
    }

    fn tryRecv(self: &Self): Option<T> {
        unsafe {
            var val: T = zeroed<T>()
            let inner = self.h._ptr as *ChannelInner
            let mtx = (*inner).mtx

            pthread_mutex_lock(mtx)
            let curLen: i64 = (*inner).len
            if curLen == 0 {
                pthread_mutex_unlock(mtx)
                return Option.None
            }
            let cap = (*inner).capacity
            var head: i64 = (*inner).head
            let slotPtr = ((*inner).buf as i64 + head * sizeOf<T>()) as *u8
            memcpy((val.addrOf()) as *u8, slotPtr, sizeOf<T>())
            (*inner).head = (head + 1) % cap
            (*inner).len = curLen - 1
            chWakeOneSend(inner)
            pthread_cond_signal((*inner).condNotFull)
            pthread_mutex_unlock(mtx)
            return Option.Some(val)
        }
    }

    fn len(self: &Self): i64 {
        unsafe {
            let inner = self.h._ptr as *ChannelInner
            let mtx = (*inner).mtx
            pthread_mutex_lock(mtx)
            let n: i64 = (*inner).len
            pthread_mutex_unlock(mtx)
            return n
        }
    }

    // Raw ChannelInner pointer, for std/select arm hooks (channelArm*).
    fn rawPtr(self: &Self): *u8 {
        return self.h._ptr
    }

    // Share this channel with another owner (a spawned producer/consumer). Each clone
    // must be dropped exactly once; the queue is torn down when the last owner drops,
    // and any payload still queued at that point is destroyed (its `Drop` runs once).
    // Values already received are the receiver's and are not touched.
    // send/recv take &Self, so a handle only needs cloning when moved into a task while
    // the parent still uses it.
    fn clone(self: &Self): Channel<T> {
        return Channel {
            h: self.h.retain()
        }
    }

    // Signal no more values will be sent. Pending items are still delivered.
    fn close(self: &Self): void {
        unsafe {
            let inner = self.h._ptr as *ChannelInner
            let mtx = (*inner).mtx
            pthread_mutex_lock(mtx)
            (*inner).closed = 1
            // every parked green task must observe closed and error out
            while (*inner).recvWaitHead as i64 != 0 {
                chWakeOneRecv(inner)
            }
            while (*inner).sendWaitHead as i64 != 0 {
                chWakeOneSend(inner)
            }
            pthread_cond_broadcast((*inner).condNotEmpty)
            pthread_cond_broadcast((*inner).condNotFull)
            pthread_mutex_unlock(mtx)
        }
    }

    // Iterator protocol — enables `for val in channel { ... }`
    // Uses match, not let-else: std must stay within the subset milo-self parses
    // (src-milo has no let-else yet), or self-host can't compile std.
    fn next(self: &mut Self): Option<T> {
        match self.recv() {
            Result.Ok(val) => {
                return Option.Some(val)
            }
            Result.Err(_) => {
                return Option.None
            }
        }
    }

}

impl Drop for Channel<T> {
    fn drop(self: &mut Self): void {
        // Zeroed == already moved out (see ChannelHandle.drop); nothing to release.
        if self.h._ptr as i64 == 0 {
            return
        }
        unsafe {
            let inner = self.h._ptr as *ChannelInner
            // The decrement has to happen here, not in the handle's Drop: only the
            // thread that observes the count reach zero may touch the buffer, and
            // only this generic impl knows T's drop glue. Zeroing the handle afterwards
            // turns its own Drop into the no-op path.
            let old = _atomicSubI64(((*inner).refcount).addrOf() as *u8, 1)
            if old == 1 {
                let cap = (*inner).capacity
                var idx: i64 = (*inner).head
                var remaining: i64 = (*inner).len
                while remaining > 0 {
                    // Move the slot's bytes into a local so scope exit runs T's Drop;
                    // the same take-then-drop idiom as seal.milo's Shared.drop.
                    var v: T = zeroed<T>()
                    let slotPtr = ((*inner).buf as i64 + idx * sizeOf<T>()) as *u8
                    memcpy((v.addrOf()) as *u8, slotPtr, sizeOf<T>())
                    idx = (idx + 1) % cap
                    remaining -= 1
                }
                (*inner).len = 0
                (*inner).head = 0
                (*inner).tail = 0
                channelFreeInner(inner)
            }
            self.h._ptr = 0 as *u8
        }
    }
}

// ── Atomics ──
//
// Every atomic operation on every type below is **sequentially consistent**
// (`seq_cst`); a compare-and-swap is seq_cst on both success and failure. Milo
// exposes no ordering parameter and has no acquire/release/relaxed forms — the
// cheaper orderings are a correctness cliff you cannot see in the source, and
// nothing in std or its consumers has ever been bound by the difference. Read
// every load/store/add/sub/swap/cas here as a full barrier.
//
// `add`/`sub` **wrap** on overflow, unlike ordinary Milo arithmetic, which traps.
// There is no atomic read-modify-write instruction with a checked form; a caller
// that must detect overflow writes a `cas` loop and checks the old value itself.
//
// Each atomic is a reference-counted handle: `.clone()` to give another task or
// `Promise.blocking` worker its own owner, and the storage frees when the last
// one drops. There is no `.destroy()`.

// ── AtomicI64 ──

pub struct AtomicI64 {
    _ptr: *u8,
}

// Safety: the pointee is accessed only through the atomic runtime operations.
unsafe

impl Send for AtomicI64 {
}
unsafe

impl Sync for AtomicI64 {
}

// heap layout (16 bytes): 0 value(i64), 8 refcount(i64). The refcount is inlined
// into the same allocation as the payload (Arc-style) so a clone/drop is one atomic
// op and one allocation — never a separate refcount box.
impl AtomicI64 {
    fn new(initial: i64): AtomicI64 {
        unsafe {
            let p = malloc(16)
            _atomicStoreI64(p, initial)
            _atomicStoreI64((p as i64 + 8) as *u8, 1)
            return AtomicI64 {
                _ptr: p
            }
        }
    }

    // Share this atomic with another owner (e.g. a spawned task). Each clone must be
    // dropped exactly once; the underlying storage is freed when the last owner drops.
    fn clone(self: &Self): AtomicI64 {
        unsafe {
            _atomicAddI64((self._ptr as i64 + 8) as *u8, 1)
            return AtomicI64 {
                _ptr: self._ptr
            }
        }
    }

    fn load(self: &Self): i64 {
        return _atomicLoadI64(self._ptr)
    }

    fn store(self: &Self, val: i64): void {
        _atomicStoreI64(self._ptr, val)
    }

    fn add(self: &Self, val: i64): i64 {
        return _atomicAddI64(self._ptr, val)
    }

    fn sub(self: &Self, val: i64): i64 {
        return _atomicSubI64(self._ptr, val)
    }

    fn swap(self: &Self, val: i64): i64 {
        return _atomicSwapI64(self._ptr, val)
    }

    // Store `desired` only if the current value is `expected`. Returns the value that
    // was there — equal to `expected` exactly when the swap happened.
    fn cas(self: &Self, expected: i64, desired: i64): i64 {
        return _atomicCasI64(self._ptr, expected, desired)
    }
}

impl Drop for AtomicI64 {
    // atomicrmw sub returns the OLD value, so old == 1 means this was the last owner.
    fn drop(self: &mut Self): void {
        // zeroed == already moved out; see ChannelHandle.drop.
        if self._ptr as i64 == 0 {
            return
        }
        unsafe {
            let old = _atomicSubI64((self._ptr as i64 + 8) as *u8, 1)
            if old == 1 {
                free(self._ptr)
            }
        }
    }
}

// ── AtomicBool ──

pub struct AtomicBool {
    _ptr: *u8,
}

// Safety: the pointee is accessed only through the atomic runtime operations.
unsafe

impl Send for AtomicBool {
}
unsafe

impl Sync for AtomicBool {
}

// heap layout (16 bytes): 0 value(bool), 8 refcount(i64). Refcount inlined; see AtomicI64.
impl AtomicBool {
    fn new(initial: bool): AtomicBool {
        unsafe {
            let p = malloc(16)
            _atomicStoreBool(p, initial)
            _atomicStoreI64((p as i64 + 8) as *u8, 1)
            return AtomicBool {
                _ptr: p
            }
        }
    }

    // Share this atomic with another owner; freed when the last owner drops.
    fn clone(self: &Self): AtomicBool {
        unsafe {
            _atomicAddI64((self._ptr as i64 + 8) as *u8, 1)
            return AtomicBool {
                _ptr: self._ptr
            }
        }
    }

    fn load(self: &Self): bool {
        return _atomicLoadBool(self._ptr)
    }

    fn store(self: &Self, val: bool): void {
        _atomicStoreBool(self._ptr, val)
    }

    fn swap(self: &Self, val: bool): bool {
        return _atomicSwapBool(self._ptr, val)
    }

    // Returns the value that was there — equal to `expected` exactly when the swap
    // happened, which is how a caller claims a one-shot flag: `f.cas(false, true) == false`.
    fn cas(self: &Self, expected: bool, desired: bool): bool {
        return _atomicCasBool(self._ptr, expected, desired)
    }
}

impl Drop for AtomicBool {
    fn drop(self: &mut Self): void {
        // zeroed == already moved out; see ChannelHandle.drop.
        if self._ptr as i64 == 0 {
            return
        }
        unsafe {
            let old = _atomicSubI64((self._ptr as i64 + 8) as *u8, 1)
            if old == 1 {
                free(self._ptr)
            }
        }
    }
}

// ── AtomicI32 ──

pub struct AtomicI32 {
    _ptr: *u8,
}

// Safety: the pointee is accessed only through the atomic runtime operations.
unsafe

impl Send for AtomicI32 {
}
unsafe

impl Sync for AtomicI32 {
}

// heap layout (16 bytes): 0 value(i32), 8 refcount(i64). The 4 bytes between them are
// padding — the refcount stays 8-aligned so its own atomics are single instructions.
impl AtomicI32 {
    fn new(initial: i32): AtomicI32 {
        unsafe {
            let p = malloc(16)
            _atomicStoreI32(p, initial)
            _atomicStoreI64((p as i64 + 8) as *u8, 1)
            return AtomicI32 {
                _ptr: p
            }
        }
    }

    // Share this atomic with another owner; freed when the last owner drops.
    fn clone(self: &Self): AtomicI32 {
        unsafe {
            _atomicAddI64((self._ptr as i64 + 8) as *u8, 1)
            return AtomicI32 {
                _ptr: self._ptr
            }
        }
    }

    fn load(self: &Self): i32 {
        return _atomicLoadI32(self._ptr)
    }

    fn store(self: &Self, val: i32): void {
        _atomicStoreI32(self._ptr, val)
    }

    // Returns the OLD value. Wraps on overflow.
    fn add(self: &Self, val: i32): i32 {
        return _atomicAddI32(self._ptr, val)
    }

    // Returns the OLD value. Wraps on underflow.
    fn sub(self: &Self, val: i32): i32 {
        return _atomicSubI32(self._ptr, val)
    }

    fn swap(self: &Self, val: i32): i32 {
        return _atomicSwapI32(self._ptr, val)
    }

    // Store `desired` only if the current value is `expected`. Returns the value that
    // was there — equal to `expected` exactly when the swap happened.
    fn cas(self: &Self, expected: i32, desired: i32): i32 {
        return _atomicCasI32(self._ptr, expected, desired)
    }
}

impl Drop for AtomicI32 {
    fn drop(self: &mut Self): void {
        // zeroed == already moved out; see ChannelHandle.drop.
        if self._ptr as i64 == 0 {
            return
        }
        unsafe {
            let old = _atomicSubI64((self._ptr as i64 + 8) as *u8, 1)
            if old == 1 {
                free(self._ptr)
            }
        }
    }
}

// ── AtomicU64 ──

pub struct AtomicU64 {
    _ptr: *u8,
}

// Safety: the pointee is accessed only through the atomic runtime operations.
unsafe

impl Send for AtomicU64 {
}
unsafe

impl Sync for AtomicU64 {
}

// heap layout (16 bytes): 0 value(u64), 8 refcount(i64). Refcount inlined; see AtomicI64.
//
// The 64-bit atomic instructions are bit-level operations with no notion of sign, so
// this rides the same intrinsics as AtomicI64 through `as` casts (which reinterpret,
// never range-check). add/sub therefore wrap in the full u64 range, which is what the
// hardware does and what an unsigned counter wants.
impl AtomicU64 {
    fn new(initial: u64): AtomicU64 {
        unsafe {
            let p = malloc(16)
            _atomicStoreI64(p, initial as i64)
            _atomicStoreI64((p as i64 + 8) as *u8, 1)
            return AtomicU64 {
                _ptr: p
            }
        }
    }

    // Share this atomic with another owner; freed when the last owner drops.
    fn clone(self: &Self): AtomicU64 {
        unsafe {
            _atomicAddI64((self._ptr as i64 + 8) as *u8, 1)
            return AtomicU64 {
                _ptr: self._ptr
            }
        }
    }

    fn load(self: &Self): u64 {
        return _atomicLoadI64(self._ptr) as u64
    }

    fn store(self: &Self, val: u64): void {
        _atomicStoreI64(self._ptr, val as i64)
    }

    // Returns the OLD value. Wraps on overflow.
    fn add(self: &Self, val: u64): u64 {
        return _atomicAddI64(self._ptr, val as i64) as u64
    }

    // Returns the OLD value. Wraps on underflow.
    fn sub(self: &Self, val: u64): u64 {
        return _atomicSubI64(self._ptr, val as i64) as u64
    }

    fn swap(self: &Self, val: u64): u64 {
        return _atomicSwapI64(self._ptr, val as i64) as u64
    }

    // Store `desired` only if the current value is `expected`. Returns the value that
    // was there — equal to `expected` exactly when the swap happened.
    fn cas(self: &Self, expected: u64, desired: u64): u64 {
        return _atomicCasI64(self._ptr, expected as i64, desired as i64) as u64
    }
}

impl Drop for AtomicU64 {
    fn drop(self: &mut Self): void {
        // zeroed == already moved out; see ChannelHandle.drop.
        if self._ptr as i64 == 0 {
            return
        }
        unsafe {
            let old = _atomicSubI64((self._ptr as i64 + 8) as *u8, 1)
            if old == 1 {
                free(self._ptr)
            }
        }
    }
}

// ── WaitGroup ──
// Wait for a set of tasks/threads to finish. `add` before spawning, each worker
// calls `done`, and `wait` blocks until the counter reaches zero. Cross-world
// like Channel: a green worker's `done` wakes both parked green waiters and a
// pthread cond; `wait` parks a task, drives the scheduler from main, or
// cond_waits on a plain thread.
//
//   let wg = WaitGroup.new()
//   wg.add(1)
//   Task.spawn(move (): void => { work(); wg.done() })
//   wg.wait()

// heap layout (40 bytes): 0 mtx, 8 cond, 16 count (i64), 24 greenWaitHead (*u8),
// 32 refcount (i64, inlined Arc-style)
pub struct WaitGroup {
    _p: *u8,
}

// Safety: count and waiter-list access are serialized by the embedded mutex.
unsafe

impl Send for WaitGroup {
}
unsafe

impl Sync for WaitGroup {
}

impl WaitGroup {
    fn new(): WaitGroup {
        unsafe {
            let p = malloc(40)
            memset(p, 0, 40)
            let mtx = malloc(64)
            pthread_mutex_init(mtx, 0 as *u8)
            let cond = malloc(64)
            pthread_cond_init(cond, 0 as *u8)
            nodeStorePtr(p, 0, mtx)
            nodeStorePtr(p, 8, cond)
            nodeStoreI64(p, 32, 1)
            return WaitGroup {
                _p: p
            }
        }
    }

    // Share this WaitGroup with another owner (e.g. a worker task); freed when the
    // last owner drops. add/done/wait take &Self, so most uses need no clone.
    fn clone(self: &Self): WaitGroup {
        unsafe {
            _atomicAddI64((self._p as i64 + 32) as *u8, 1)
            return WaitGroup {
                _p: self._p
            }
        }
    }

    fn add(self: &Self, n: i64): void {
        let p = self._p
        let mtx = nodeLoadPtr(p, 0)
        pthread_mutex_lock(mtx)
        nodeStoreI64(p, 16, nodeLoadI64(p, 16) + n)
        pthread_mutex_unlock(mtx)
    }

    fn done(self: &Self): void {
        let p = self._p
        let mtx = nodeLoadPtr(p, 0)
        pthread_mutex_lock(mtx)
        let c = nodeLoadI64(p, 16) - 1
        nodeStoreI64(p, 16, c)
        if c <= 0 {
            // wake every parked green waiter, then broadcast to pthreads
            var h = nodeLoadPtr(p, 24)
            while h as i64 != 0 {
                h = wakeOne(h)
            }
            nodeStorePtr(p, 24, 0 as *u8)
            pthread_cond_broadcast(nodeLoadPtr(p, 8))
        }
        pthread_mutex_unlock(mtx)
    }

    fn wait(self: &Self): void {
        unsafe {
            let p = self._p
            let mtx = nodeLoadPtr(p, 0)
            let cur = schedulerCurrent()
            if cur as i64 != 0 {
                pthread_mutex_lock(mtx)
                while nodeLoadI64(p, 16) > 0 {
                    var w: [u8; 48] = [0; 48]
                    let wp = w as *u8
                    nodeStoreI64(wp, nodeKind(), kindPlain())
                    nodeStorePtr(wp, nodeA(), cur)
                    nodeStorePtr(wp, nodeNext(), nodeLoadPtr(p, 24))
                    nodeStorePtr(p, 24, wp)
                    pthread_mutex_unlock(mtx)
                    schedulerPark()
                    pthread_mutex_lock(mtx)
                }
                pthread_mutex_unlock(mtx)
            } else if schedulerExists() {
                // main thread with live tasks: drive the scheduler (blocking on
                // the wakeup fd) until a worker's done() drops the count to zero
                while true {
                    pthread_mutex_lock(mtx)
                    let c = nodeLoadI64(p, 16)
                    pthread_mutex_unlock(mtx)
                    if c <= 0 {
                        return
                    }
                    schedulerBlockMain()
                }
            } else {
                pthread_mutex_lock(mtx)
                while nodeLoadI64(p, 16) > 0 {
                    pthread_cond_wait(nodeLoadPtr(p, 8), mtx)
                }
                pthread_mutex_unlock(mtx)
            }
        }
    }

}

impl Drop for WaitGroup {
    fn drop(self: &mut Self): void {
        // zeroed == already moved out; see ChannelHandle.drop.
        if self._p as i64 == 0 {
            return
        }
        unsafe {
            let old = _atomicSubI64((self._p as i64 + 32) as *u8, 1)
            if old == 1 {
                let p = self._p
                pthread_mutex_destroy(nodeLoadPtr(p, 0))
                free(nodeLoadPtr(p, 0))
                pthread_cond_destroy(nodeLoadPtr(p, 8))
                free(nodeLoadPtr(p, 8))
                free(p)
            }
        }
    }
}

// ── Once ──
// Run one initializer exactly once, no matter how many green tasks or
// `Promise.blocking` threads reach it first. Every caller that returns from
// `run` has seen the initializer's writes; the losers block until the winner
// finishes rather than proceeding past a half-built value.
//
// Correct under both worlds: a green task waits by parking (the scheduler keeps
// running), a plain OS thread waits on a condition variable, and the main thread
// with a live scheduler drives it — the same three-branch shape as WaitGroup.
//
// This is Milo's lazy static. Module-level `var`s already run real initializers
// in dependency order before `main`, so an *eager* static needs nothing:
//
//   var gTable: Vec<i64> = buildTable()   // runs before main, no Once needed
//
// Reach for Once when the work must be deferred past the start of main (it needs
// argv or a config file) or is expensive and usually unwanted. The shape is a
// global plus a guard function, because a getter cannot hand back a `&T`:
//
//   var gTable: Vec<i64> = []
//   var gTableOnce: Once = Once.new()
//
//   pub fn ensureTable(): void {
//       gTableOnce.run((): void => {
//           gTable = buildTable()
//       })
//   }
//
// Callers do `ensureTable()` and then read `gTable` directly.

let ONCE_IDLE: i64 = 0
let ONCE_RUNNING: i64 = 1
let ONCE_DONE: i64 = 2

// heap layout (56 bytes): 0 mtx, 8 cond, 16 state (i64), 24 greenWaitHead (*u8),
// 32 ownerTask (*u8), 40 ownerThread (i64), 48 refcount (i64, inlined Arc-style)
pub struct Once {
    _p: *u8,
}

// Safety: state transitions and the waiter list are serialized by the embedded
// mutex; the state word is additionally atomic so `isDone` and the `run` fast
// path can read it without taking the lock.
unsafe

impl Send for Once {
}
unsafe

impl Sync for Once {
}

fn onceStatePtr(p: *u8): *u8 {
    unsafe {
        return (p as i64 + 16) as *u8
    }
}

// Block until the running initializer publishes ONCE_DONE. Caller holds mtx and
// gets it back. The waiter node lives on this frame, which stays alive across the
// park; the completer pops it under mtx, so it never dangles.
fn onceWait(p: *u8, mtx: *u8): void {
    unsafe {
        let cur = schedulerCurrent()
        if cur as i64 != 0 {
            var w: [u8; 48] = [0; 48]
            let wp = w as *u8
            nodeStoreI64(wp, nodeKind(), kindPlain())
            nodeStorePtr(wp, nodeA(), cur)
            nodeStorePtr(wp, nodeNext(), nodeLoadPtr(p, 24))
            nodeStorePtr(p, 24, wp)
            pthread_mutex_unlock(mtx)
            schedulerPark()
            pthread_mutex_lock(mtx)
        } else if schedulerExists() {
            // bounded poll, not schedulerBlockMain: the wake condition is a state
            // word flipped under a mutex, not an fd event, so a -1 poll would sleep
            // straight past a foreign thread's completion.
            pthread_mutex_unlock(mtx)
            schedulerPollMain()
            pthread_mutex_lock(mtx)
        } else {
            pthread_cond_wait(nodeLoadPtr(p, 8), mtx)
        }
    }
}

// An initializer that calls `run` on its own Once can never finish — it would wait
// for itself. Waiting is the only other option, so this would be a hang with no
// stack to read; die with the reason instead. Caller holds mtx.
fn onceRejectReentry(p: *u8, mtx: *u8): void {
    let ownerTask = nodeLoadPtr(p, 32)
    var reentrant: bool = false
    if ownerTask as i64 != 0 {
        reentrant = schedulerCurrent() as i64 == ownerTask as i64
    } else {
        // Owner is not a green task, so anything on its OS thread — including a green
        // task its initializer just spawned — is downstream of it and cannot proceed.
        reentrant = (pthread_self() as i64) == nodeLoadI64(p, 40)
    }
    if reentrant {
        pthread_mutex_unlock(mtx)
        eprint("std/sync: Once.run re-entered while this Once's initializer is still running on the same thread (directly, or through another Once that calls back) — it would wait for itself forever")
        exit(1)
    }
}

impl Once {
    fn new(): Once {
        unsafe {
            let p = malloc(56)
            memset(p, 0, 56)
            let mtx = malloc(64)
            pthread_mutex_init(mtx, 0 as *u8)
            let cond = malloc(64)
            pthread_cond_init(cond, 0 as *u8)
            nodeStorePtr(p, 0, mtx)
            nodeStorePtr(p, 8, cond)
            nodeStoreI64(p, 48, 1)
            return Once {
                _p: p
            }
        }
    }

    // Share this Once with another owner (a worker task/thread); freed when the last
    // owner drops. `run` takes &Self, so a module-level Once never needs a clone.
    fn clone(self: &Self): Once {
        unsafe {
            _atomicAddI64((self._p as i64 + 48) as *u8, 1)
            return Once {
                _p: self._p
            }
        }
    }

    // True once the initializer has completed. Still false while it is running, so
    // this is a progress hint, never a substitute for `run`.
    fn isDone(self: &Self): bool {
        return _atomicLoadI64(onceStatePtr(self._p)) == ONCE_DONE
    }

    // Run `f` if nobody has yet, otherwise block until whoever did is finished.
    // Returns only once the initializer has completed exactly once, process-wide.
    // @synchronized: `f` is a critical section. The embedded mutex serializes it and the
    // atomic state word publishes its writes, so globals mutated in here are not racing.
    @synchronized
    fn run(self: &Self, f: () => void): void {
        if _atomicLoadI64(onceStatePtr(self._p)) == ONCE_DONE {
            return
        }
        if self._claim() {
            f()
            self._complete()
        }
    }

    // true when this caller took the initializer slot; false when it waited out
    // someone else's run and there is nothing left to do.
    fn _claim(self: &Self): bool {
        let p = self._p
        let mtx = nodeLoadPtr(p, 0)
        pthread_mutex_lock(mtx)
        while _atomicLoadI64(onceStatePtr(p)) != ONCE_DONE {
            if _atomicLoadI64(onceStatePtr(p)) == ONCE_IDLE {
                _atomicStoreI64(onceStatePtr(p), ONCE_RUNNING)
                nodeStorePtr(p, 32, schedulerCurrent())
                nodeStoreI64(p, 40, pthread_self() as i64)
                pthread_mutex_unlock(mtx)
                return true
            }
            onceRejectReentry(p, mtx)
            onceWait(p, mtx)
        }
        pthread_mutex_unlock(mtx)
        return false
    }

    // Publish the initializer's writes and release every waiter.
    fn _complete(self: &Self): void {
        let p = self._p
        let mtx = nodeLoadPtr(p, 0)
        pthread_mutex_lock(mtx)
        _atomicStoreI64(onceStatePtr(p), ONCE_DONE)
        var h = nodeLoadPtr(p, 24)
        while h as i64 != 0 {
            h = wakeOne(h)
        }
        nodeStorePtr(p, 24, 0 as *u8)
        pthread_cond_broadcast(nodeLoadPtr(p, 8))
        pthread_mutex_unlock(mtx)
    }

}

impl Drop for Once {
    fn drop(self: &mut Self): void {
        // zeroed == already moved out; see ChannelHandle.drop.
        if self._p as i64 == 0 {
            return
        }
        unsafe {
            let old = _atomicSubI64((self._p as i64 + 48) as *u8, 1)
            if old == 1 {
                let p = self._p
                pthread_mutex_destroy(nodeLoadPtr(p, 0))
                free(nodeLoadPtr(p, 0))
                pthread_cond_destroy(nodeLoadPtr(p, 8))
                free(nodeLoadPtr(p, 8))
                free(p)
            }
        }
    }
}
