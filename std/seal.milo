// std/seal — stored zero-copy: keep views into an input buffer without storing references.
//
// The problem this solves: a lexer, parser or deserializer wants to hold on to
// many small pieces of a large input. Copying each piece into its own string is
// an allocation per piece (3M of them, in the benchmark this module was written
// against). Milo cannot store a `&string` instead, because references are
// second-class. The usual workaround is to keep (start, len) offsets into a
// buffer you also keep, which works right up until something mutates or
// reallocates the buffer under the offsets, and nothing stops that.
//
// So remove the mutation rather than check for it:
//
//     var buf = readFile("input.json")!
//     let src = seal(buf)          // consumes buf; `buf` is moved
//     // buf.push(...)             // does not compile: `buf` was moved
//     // src.push(...)             // does not compile: Sealed has no such method
//
//     var tokens: Vec<Token> = Vec.new()
//     tokens.push(Token { kind: TokenKind.Str, at: Span { start: 12, len: 5 } })
//     let text = src.text(tokens[0].at)     // materialise ONE piece, on demand
//
// A Span is two integers. It is Copy, it holds no pointer, it can live in a
// struct field, a Vec, a map key, or a serialised record, and it costs nothing
// to keep. It touches memory only when you resolve it against a Sealed.
//
// What makes the offsets safe is not care, it is that `Sealed` exposes no
// operation that could invalidate them. There is no check to forget on the
// reading path. (The `Shared` half below does use unsafe, for a refcount box;
// the sealed bytes themselves are still never written.)
//
// A Span carries the identity of the buffer it was measured from, so resolving
// one against a different Sealed is a named failure rather than wrong-but-plausible
// bytes. Tying the two together at COMPILE time would need a lifetime or a type-level
// brand, and neither exists under this language's axiom, so the tie is checked at
// runtime instead. See docs/memory-safety-vs-rust.md, "what the compiler does not check".

// A start, a length, and `_bufferId`, the identity of the buffer it was measured from.
// (Called a "brand" in the type-theory sense; named for what it holds instead, since the
// field is visible to anyone who reads the struct.)
//
// The `_bufferId` is what stops the one silent failure this design had: a span resolved
// against a DIFFERENT sealed buffer used to read wrong-but-in-bounds bytes and report
// nothing. Rust prevents that with an invariant lifetime; with no lifetimes to carry
// the tie, a runtime tag is the honest substitute, and it demotes a wrong answer to a
// named error: the claim discipline in docs/memory-safety-vs-rust.md, applied to itself.
//
// It costs nothing in space: `len` narrowed to i32 to make room, so a Span is the same
// 16 bytes it was. That caps one span at 2GB, which is a span, not a buffer.
//
// Make them with `src.span(start, len)`; a hand-built Span carries `_bufferId` 0, which no
// buffer ever has, so it fails closed rather than reading something plausible.
// Declared here rather than imported from std/os. std/os also declares the OpenSSL
// externs, and a module that imports it for malloc drags those symbols into every
// program that reaches it. At -O2 they are dead-stripped; at -O0 they are not, and on
// a platform with no OpenSSL in the sysroot (Windows) the link fails naming symbols
// this module has nothing to do with. Four libc declarations are cheaper than that
// coupling. See docs/backlog.md for splitting std/os properly.
@cSig("stdlib.h", "void *malloc(size_t)")
extern fn malloc(size: i64): *u8

@cSig("stdlib.h", "void free(void *)")
extern fn free(p: *u8): void

@cSig("string.h", "void *memcpy(void *, const void *, size_t)")
extern fn memcpy(dst: *u8, src: *u8, n: i64): *u8

@cSig("string.h", "void *memset(void *, int, size_t)")
extern fn memset(dst: *u8, c: i32, n: i64): *u8

@derive(Eq)
pub struct Span {
    start: i64,
    len: i32,
    _bufferId: i32,
}

// An immutable byte buffer. Produced by consuming a string with `seal`; the
// only way back to a mutable buffer is `unseal`, which consumes this.
//
// Every method here reads. That is the design, with one honest limit: Milo has no
// per-field visibility, so `pub struct` exposes `_data` to any caller who names the type,
// and `s._data = ...` on a `var` holder is not rejected. A same-length replacement then
// leaves live spans resolving against different bytes, id matching and bounds passing.
// The API maintains the invariant; the type cannot enforce it until fields can be private.
pub struct Sealed {
    _data: string,
    _bufferId: i32,
}

// Brands start at 1 so that a zero-valued Span (hand-built, or a zeroed struct field)
// never matches a real buffer.
var nextSealBufferId: i64 = 1

// Consume a buffer and return it sealed. O(1): the bytes are moved, not copied.
pub fn seal(s: string): Sealed {
    var b: i64 = 0
    unsafe {
        b = _atomicAddI64((nextSealBufferId.addrOf()) as *u8, 1)
    }
    var out: Sealed = Sealed {
        _data: s, _bufferId: b as i32
    }
    return out
}

// Hand the buffer back, mutable again. Consumes the Sealed, so no span holder
// can still be relying on it through THIS binding.
//
// Spans measured against it are of course still just integers, and will read a
// buffer that is now free to change. That is the same offsets-by-convention
// situation this module exists to replace, so unseal is the point at which the
// guarantee ends, deliberately and visibly.
pub fn unseal(s: Sealed): string {
    return s._data
}

// The readers below are module-private and exist only in this by-value-receiver form:
// `impl Shared` reaches its buffer as `(*box).inner`, which is not a `Self`, so it
// cannot call the `impl Sealed` methods. The public spelling is the method; a `pub`
// twin here would be a second spelling of the same operation, which the stdlib does
// not keep (docs/stdlib-design.md).

// Bytes held in the sealed buffer.
fn sealedLen(s: &Sealed): i64 {
    return s._data.len
}

// A span covering the whole buffer.
fn sealedSpan(s: &Sealed): Span {
    // `as i32` truncates without trapping, so a buffer past 2GB would hand back a
    // span whose length is a low slice of the real one: in bounds, id matching, and
    // wrong. That is the wrong-but-plausible failure `_bufferId` exists to abolish,
    // so the 2GB span cap is enforced here rather than discovered later.
    assert(s._data.len <= 2147483647, "sealed: buffer is larger than 2GB, no single span can cover it")
    var sp: Span = Span {
        start: 0, len: s._data.len as i32, _bufferId: s._bufferId
    }
    return sp
}

// Measure a span against THIS buffer. The only way to get a span that resolves:
// a hand-built Span carries `_bufferId` 0, which no buffer ever has.
fn sealedSpanOf(s: &Sealed, start: i64, len: i64): Span {
    // Same trap as sealedSpan: `len as i32` does not trap on overflow, so spanOf(0, 2^32+4)
    // used to return a perfectly valid-looking 4-byte span. A length that does not fit the
    // narrowed field is a caller error, not a span.
    assert(len >= 0 && len <= 2147483647, "sealed: span length must be in 0..2GB")
    var sp: Span = Span {
        start: start, len: len as i32, _bufferId: s._bufferId
    }
    return sp
}

// Whether `sp` fits inside this buffer. Cheap; use it when a span from an
// untrusted source might not belong here.
fn sealedHolds(s: &Sealed, sp: Span): bool {
    if sp._bufferId != s._bufferId {
        return false
    }
    if sp.start < 0 || sp.len < 0 {
        return false
    }
    return sp.start + (sp.len as i64) <= s._data.len
}

// The byte at `i`, bounds-checked. For a whole range prefer `text` or, to avoid the
// allocation, `eq` and `each`.
fn sealedByteAt(s: &Sealed, i: i64): u8 {
    assert(i >= 0 && i < s._data.len, "sealed: byte index out of range")
    return s._data[i]
}

// Materialise the span as an owned string. THIS is the allocation, and it is
// the only one: naming it `text` rather than hiding it behind indexing is the
// point, so a reader can see where the copies are.
fn sealedText(s: &Sealed, sp: Span): string {
    assert(sp._bufferId == s._bufferId, "sealed: span was measured against a different buffer")
    assert(sealedHolds(s, sp), "sealed: span does not fit this buffer")
    return s._data.substr(sp.start, sp.start + (sp.len as i64))
}

// Compare a span against a string WITHOUT materialising it. This is what keeps
// a scanner's keyword checks off the allocator: the common operation on a
// retained piece is comparing it, not owning it.
fn sealedEq(s: &Sealed, sp: Span, other: &string): bool {
    // Assert the _bufferId rather than leaning on sealedHolds for it. holds() answers
    // "does this span fit here", and a foreign span makes it false, which eq then
    // returned as "not equal" — the wrong answer to a question the caller never
    // asked, and the one silent failure the _bufferId exists to stop. text() has always
    // aborted on this; eq() disagreed with it. A caller who genuinely wants the
    // tolerant behaviour calls holds() first.
    assert(sp._bufferId == s._bufferId, "sealed: span was measured against a different buffer")
    if !sealedHolds(s, sp) {
        return false
    }
    if (sp.len as i64) != other.len {
        return false
    }
    var i: i64 = 0
    while i < (sp.len as i64) {
        if s._data[sp.start + i] != other[i] {
            return false
        }
        i = i + 1
    }
    return true
}

// Read the span's bytes one at a time without materialising it. The borrowing
// form: `f` sees each byte, nothing is allocated.
fn sealedEach(s: &Sealed, sp: Span, f: (u8) => void): void {
    assert(sp._bufferId == s._bufferId, "sealed: span was measured against a different buffer")
    assert(sealedHolds(s, sp), "sealed: span does not fit this buffer")
    var i: i64 = 0
    while i < (sp.len as i64) {
        f(s._data[sp.start + i])
        i = i + 1
    }
}

impl Sealed {
    // Bytes held.
    fn len(self: &Self): i64 {
        return sealedLen(self)
    }

    // A span over the whole buffer.
    fn span(self: &Self): Span {
        return sealedSpan(self)
    }

    // Measure a span against this buffer. Use this rather than building a Span by
    // hand: a hand-built one carries _bufferId 0 and will not resolve anywhere.
    fn spanOf(self: &Self, start: i64, len: i64): Span {
        return sealedSpanOf(self, start, len)
    }

    // Whether `sp` fits here. Branch on this for a span you did not measure
    // yourself; `text` aborts instead.
    fn holds(self: &Self, sp: Span): bool {
        return sealedHolds(self, sp)
    }

    // The byte at `i`, bounds-checked.
    fn byteAt(self: &Self, i: i64): u8 {
        return sealedByteAt(self, i)
    }

    // Materialise `sp` as an owned string. The allocation lives here.
    fn text(self: &Self, sp: Span): string {
        return sealedText(self, sp)
    }

    // Compare `sp` to a string without materialising it.
    fn eq(self: &Self, sp: Span, other: &string): bool {
        return sealedEq(self, sp, other)
    }

    // Visit each byte of `sp` without materialising it.
    fn each(self: &Self, sp: Span, f: (u8) => void): void {
        sealedEach(self, sp, f)
    }

    // Give the buffer back, mutable. Consumes this Sealed.
    fn unseal(self: Self): string {
        return unseal(self)
    }
}

// ---------------------------------------------------------------------------
// Sharing one sealed buffer across threads.
// ---------------------------------------------------------------------------
//
// `Sealed` is an owned value, so one holder has it and passing it to a worker
// moves it. That is the right default, and it is exactly wrong for the case this
// module was written for: N scanners reading ONE large input at once. Copying the
// buffer per worker is the cost `seal` exists to avoid, and a reference cannot
// cross a thread boundary.
//
// The way out is the property `Sealed` already has. Sharing is unsafe when a
// reader can observe a write, and no operation on a `Sealed` writes. Immutability
// is not a promise here, it is the absence of a method, so N readers over one
// buffer needs no lock, no ordering, and no check inside the read path. What is
// left is deciding when the storage is released, which is a count, not a race.
//
//     let src = seal(readFile("big.json")!)
//     let a = src.share()          // consumes the Sealed
//     let b = a.clone()            // another holder, same bytes, no copy
//     ... hand `b` to a worker by move ...
//     let back = thaw(a)           // Ok only when no other holder is alive
//
// Reading a `Shared` goes through `sharedWith`, which hands the callback the `Sealed`
// itself; `len` and `byteAt` are also on `Shared` directly for the per-byte loop.
//
// `Send` and `Sync` are audited rather than derived: the raw pointer is reached
// only by the read paths below and by a refcount that moves under an atomic.
//
// Move-tracked twice over: the Drop impl and the raw pointer field each make it so.
pub struct Shared {
    _ptr: *u8,
    _bufferId: i32,
}

// Safe because nothing here writes the bytes. The only mutable state in the box
// is the refcount, and it moves only under `_atomicAddI64`/`_atomicSubI64`.
unsafe

impl Send for Shared {
}
unsafe

impl Sync for Shared {
}

// Refcount first so its address is the box's address; `share` relies on that.
struct SharedBox {
    rc: i64,
    inner: Sealed,
}

// A refused `thaw`, holding the buffer it declined to hand back.
//
// Returning the `Shared` rather than dropping it is what makes the refusal
// recoverable: a caller who guessed wrong about the other holders still has the
// buffer, and `holders` says how many were alive at the moment of the attempt.
pub struct ThawRejected {
    shared: Shared,
    holders: i64,
}

// Consume a `Sealed` and return a shareable holder of the same bytes. O(1): the
// buffer is moved into the box, never copied.
pub fn share(s: Sealed): Shared {
    var tmp: Sealed = s
    let b = tmp._bufferId
    unsafe {
        let raw = malloc(sizeOf<SharedBox>())
        assert(raw as i64 != 0, "share: out of memory")
        memset(raw, 0, sizeOf<SharedBox>())
        let box = raw as *SharedBox
        (*box).rc = 1
        // Move the Sealed into the box, then zero the source so its drop is a
        // no-op: the bytes now belong to the box.
        memcpy(((*box).inner.addrOf()) as *u8, (tmp.addrOf()) as *u8, sizeOf<Sealed>())
        memset((tmp.addrOf()) as *u8, 0, sizeOf<Sealed>())
        var out: Shared = Shared {
            _ptr: raw, _bufferId: b
        }
        return out
    }
}

// Recover the `Sealed` when this is the only holder alive.
//
// Refused while another holder exists, because handing the buffer back would let
// it be unsealed and mutated under readers that are still reading it. The refusal
// returns the `Shared` unharmed.
pub fn thaw(sh: Shared): Result<Sealed, ThawRejected> {
    var h: Shared = sh
    let live = _atomicAddI64(h._ptr, 0)
    if live != 1 {
        var r: ThawRejected = ThawRejected {
            shared: h, holders: live
        }
        return Result.Err(r)
    }
    unsafe {
        var out: Sealed = zeroed<Sealed>()
        let box = h._ptr as *SharedBox
        // Move the buffer out and zero the slot. `h` still drops below, which
        // takes the count to zero and frees the box; the zeroed slot makes that
        // drop's release of `inner` a no-op.
        memcpy((out.addrOf()) as *u8, ((*box).inner.addrOf()) as *u8, sizeOf<Sealed>())
        memset(((*box).inner.addrOf()) as *u8, 0, sizeOf<Sealed>())
        return Result.Ok(out)
    }
}

impl Drop for Shared {
    fn drop(self: &mut Self): void {
        if self._ptr as i64 == 0 {
            return
        }
        unsafe {
            let old = _atomicSubI64(self._ptr, 1)
            if old == 1 {
                let box = self._ptr as *SharedBox
                // Take the buffer out so the ordinary string drop releases it,
                // then release the box. After `thaw` the slot is zeroed and this
                // is a no-op, which is why there is one path and not two.
                var last: Sealed = zeroed<Sealed>()
                memcpy((last.addrOf()) as *u8, ((*box).inner.addrOf()) as *u8, sizeOf<Sealed>())
                memset(((*box).inner.addrOf()) as *u8, 0, sizeOf<Sealed>())
                free(self._ptr)
            }
        }
    }
}

// Read the shared buffer through a borrow: `f` gets the `Sealed` itself, so the whole
// reader API is available on it and nothing is copied.
//
//     let name = sharedWith(sh, (s: &Sealed): string => s.text(sp))
//     let ok   = sharedWith(sh, (s: &Sealed): bool => s.eq(sp, "name"))
//
// This is the accessor because Milo cannot return a `&Sealed`, so `Shared` cannot
// delegate through a deref the way `Arc<T>` does. The alternative was re-exposing every
// reader by hand on `Shared`, two lists that drift apart the moment one gains a method.
// One borrow point replaces the list.
//
// Free function, not a method: `R` is a parameter of the operation rather than of
// `Shared`, and a method's own type parameter is never inferred at the call site. Same
// reason `std/arena` spells its read as `arenaWith`.
//
// `len` and `byteAt` stay on `Shared` directly: a worker calls those per byte in a loop,
// where a closure per read is the wrong shape.
pub fn sharedWith<R>(sh: &Shared, f: (&Sealed) => R): R {
    unsafe {
        let box = sh._ptr as *SharedBox
        return f((*box).inner)
    }
}

impl Shared {
    // Another holder of the same bytes. No copy; the buffer is released when the
    // last holder drops.
    fn clone(self: &Self): Shared {
        _atomicAddI64(self._ptr, 1)
        var out: Shared = Shared {
            _ptr: self._ptr, _bufferId: self._bufferId
        }
        return out
    }

    // How many holders are alive right now. A progress hint: by the time you read
    // it another thread may have cloned or dropped one. `thaw` is the operation
    // that acts on the count without a window between reading and using it.
    fn holders(self: &Self): i64 {
        return _atomicAddI64(self._ptr, 0)
    }

    // Bytes held.
    fn len(self: &Self): i64 {
        unsafe {
            let box = self._ptr as *SharedBox
            return sealedLen((*box).inner)
        }
    }

    // The byte at `i`, bounds-checked.
    fn byteAt(self: &Self, i: i64): u8 {
        unsafe {
            let box = self._ptr as *SharedBox
            return sealedByteAt((*box).inner, i)
        }
    }
}

impl Sealed {
    // Consume this buffer and return a shareable holder of the same bytes.
    fn share(self: Self): Shared {
        return share(self)
    }
}
