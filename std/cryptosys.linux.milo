// std/cryptosys — platform crypto binding for std/crypto (Linux/OpenSSL).
//
// Exposes raw digest bytes and the raw GCM calls only; hex encoding, the AesGcmResult
// split, the length guards and the `Crypto` namespace live once in std/crypto.milo.

from "std/os" import {
    malloc, free
}

pub extern fn SHA256(_data: *u8, _len: u64, _md: *u8): *u8

pub extern fn MD5(_data: *u8, _len: u64, _md: *u8): *u8

pub extern fn SHA1(_data: *u8, _len: u64, _md: *u8): *u8

pub extern fn EVP_CIPHER_CTX_new(): *u8

pub extern fn EVP_CIPHER_CTX_free(_ctx: *u8): void

pub extern fn EVP_aes_256_gcm(): *u8

pub extern fn EVP_aes_128_gcm(): *u8

pub extern fn EVP_EncryptInit_ex(_ctx: *u8, _type: *u8, _impl: *u8, _key: *u8, _iv: *u8): i32

pub extern fn EVP_EncryptUpdate(_ctx: *u8, _out: *u8, _outl: *i32, _in: *u8, _inl: i32): i32

pub extern fn EVP_EncryptFinal_ex(_ctx: *u8, _out: *u8, _outl: *i32): i32

pub extern fn EVP_DecryptInit_ex(_ctx: *u8, _type: *u8, _impl: *u8, _key: *u8, _iv: *u8): i32

pub extern fn EVP_DecryptUpdate(_ctx: *u8, _out: *u8, _outl: *i32, _in: *u8, _inl: i32): i32

pub extern fn EVP_DecryptFinal_ex(_ctx: *u8, _out: *u8, _outl: *i32): i32

pub extern fn EVP_CIPHER_CTX_ctrl(_ctx: *u8, _type: i32, _arg: i32, _ptr: *u8): i32

// The first `n` bytes of a digest buffer as a string.
fn cryptosysBytes(buf: &[u8; 32], n: i64): string {
    var result: string = ""
    for i in 0..n {
        result.push(buf[i])
    }
    return result
}

// Raw 32-byte SHA-256 digest.
pub fn sha256Raw(input: &string): string {
    var hash: [u8; 32] = [0; 32]
    unsafe {
        SHA256(input, input.len as u64, hash)
    }
    return cryptosysBytes(hash, 32)
}

// Raw 16-byte MD5 digest.
pub fn md5Raw(input: &string): string {
    var hash: [u8; 32] = [0; 32]
    unsafe {
        MD5(input, input.len as u64, hash)
    }
    return cryptosysBytes(hash, 16)
}

// Raw 20-byte SHA-1 digest.
pub fn sha1Raw(input: &string): string {
    var hash: [u8; 32] = [0; 32]
    unsafe {
        SHA1(input, input.len as u64, hash)
    }
    return cryptosysBytes(hash, 20)
}

// EVP_CTRL_GCM_SET_TAG = 0x11, EVP_CTRL_GCM_GET_TAG = 0x10
fn evpCtrlGcmGetTag(): i32 {
    return 16
}

fn evpCtrlGcmSetTag(): i32 {
    return 17
}

// ── One GCM implementation per direction ──
//
// AES-128-GCM and AES-256-GCM differ by exactly two things: the EVP cipher and the key
// length. They used to be two 90-line copies each, and a copy is how one key size ends
// up with a fix the other never gets — the tag-handling and free-on-error paths below
// are the parts that would silently diverge. std/crypto keeps the `requires` contracts
// and the self-naming length errors; only the EVP dance lives here.

// AES-GCM encrypt; returns ciphertext with the 16-byte tag appended. Lengths are the
// caller's to guarantee: std/crypto checks them before calling.
pub fn gcmEncryptRaw(keyBits: i64, key: &string, iv: &string, plaintext: &string, aad: &string): Result<string, string> {
    unsafe {
        let ctx = EVP_CIPHER_CTX_new()
        if ctx as i64 == 0 {
            return Result.Err("EVP_CIPHER_CTX_new failed")
        }

        let cipher = if keyBits == 128 {
            EVP_aes_128_gcm()
        } else {
            EVP_aes_256_gcm()
        }
        if EVP_EncryptInit_ex(ctx, cipher, 0 as *u8, key, iv) != 1 {
            EVP_CIPHER_CTX_free(ctx)
            return Result.Err("EVP_EncryptInit_ex failed")
        }

        var aadOutLen: i32 = 0
        if aad.len > 0 {
            if EVP_EncryptUpdate(ctx, 0 as *u8, (aadOutLen.addrOf()) as *i32, aad, aad.len as i32) != 1 {
                EVP_CIPHER_CTX_free(ctx)
                return Result.Err("EVP_EncryptUpdate (AAD) failed")
            }
        }

        var ctBuf: *u8 = 0 as *u8
        if plaintext.len > 0 {
            ctBuf = malloc(plaintext.len + 16)
        }
        var outLen: i32 = 0

        if plaintext.len > 0 {
            if EVP_EncryptUpdate(ctx, ctBuf, (outLen.addrOf()) as *i32, plaintext, plaintext.len as i32) != 1 {
                free(ctBuf)
                EVP_CIPHER_CTX_free(ctx)
                return Result.Err("EVP_EncryptUpdate failed")
            }
        }

        var finalLen: i32 = 0
        let finalPtr = if plaintext.len > 0 {
            (ctBuf as i64 + outLen as i64) as *u8
        } else {
            0 as *u8
        }
        if EVP_EncryptFinal_ex(ctx, finalPtr, (finalLen.addrOf()) as *i32) != 1 {
            if plaintext.len > 0 {
                free(ctBuf)
            }
            EVP_CIPHER_CTX_free(ctx)
            return Result.Err("EVP_EncryptFinal_ex failed")
        }

        var tag: [u8; 16] = [0; 16]
        if EVP_CIPHER_CTX_ctrl(ctx, evpCtrlGcmGetTag(), 16, tag) != 1 {
            if plaintext.len > 0 {
                free(ctBuf)
            }
            EVP_CIPHER_CTX_free(ctx)
            return Result.Err("failed to get GCM tag")
        }

        EVP_CIPHER_CTX_free(ctx)

        var ciphertext: string = ""
        let totalLen = outLen + finalLen
        for i in 0..totalLen as i64 {
            ciphertext.push(*((ctBuf as i64 + i) as *u8))
        }
        if plaintext.len > 0 {
            free(ctBuf)
        }

        for i in 0..16 {
            ciphertext.push(tag[i])
        }
        return Result.Ok(ciphertext)
    }
}

// AES-GCM decrypt; Err on authentication failure.
pub fn gcmDecryptRaw(keyBits: i64, key: &string, iv: &string, ciphertext: &string, tag: &string, aad: &string): Result<string, string> {
    unsafe {
        let ctx = EVP_CIPHER_CTX_new()
        if ctx as i64 == 0 {
            return Result.Err("EVP_CIPHER_CTX_new failed")
        }

        let cipher = if keyBits == 128 {
            EVP_aes_128_gcm()
        } else {
            EVP_aes_256_gcm()
        }
        if EVP_DecryptInit_ex(ctx, cipher, 0 as *u8, key, iv) != 1 {
            EVP_CIPHER_CTX_free(ctx)
            return Result.Err("EVP_DecryptInit_ex failed")
        }

        var aadOutLen: i32 = 0
        if aad.len > 0 {
            if EVP_DecryptUpdate(ctx, 0 as *u8, (aadOutLen.addrOf()) as *i32, aad, aad.len as i32) != 1 {
                EVP_CIPHER_CTX_free(ctx)
                return Result.Err("EVP_DecryptUpdate (AAD) failed")
            }
        }

        var ptBuf: *u8 = 0 as *u8
        if ciphertext.len > 0 {
            ptBuf = malloc(ciphertext.len + 16)
        }
        var outLen: i32 = 0

        if ciphertext.len > 0 {
            if EVP_DecryptUpdate(ctx, ptBuf, (outLen.addrOf()) as *i32, ciphertext, ciphertext.len as i32) != 1 {
                free(ptBuf)
                EVP_CIPHER_CTX_free(ctx)
                return Result.Err("EVP_DecryptUpdate failed")
            }
        }

        // set expected tag before final
        if EVP_CIPHER_CTX_ctrl(ctx, evpCtrlGcmSetTag(), 16, tag as *u8) != 1 {
            if ciphertext.len > 0 {
                free(ptBuf)
            }
            EVP_CIPHER_CTX_free(ctx)
            return Result.Err("failed to set GCM tag")
        }

        var finalLen: i32 = 0
        let finalPtr = if ciphertext.len > 0 {
            (ptBuf as i64 + outLen as i64) as *u8
        } else {
            0 as *u8
        }
        if EVP_DecryptFinal_ex(ctx, finalPtr, (finalLen.addrOf()) as *i32) != 1 {
            if ciphertext.len > 0 {
                free(ptBuf)
            }
            EVP_CIPHER_CTX_free(ctx)
            return Result.Err("AES-GCM decrypt failed: authentication error")
        }

        EVP_CIPHER_CTX_free(ctx)

        var plaintext: string = ""
        let totalLen = outLen + finalLen
        for i in 0..totalLen as i64 {
            plaintext.push(*((ptBuf as i64 + i) as *u8))
        }
        if ciphertext.len > 0 {
            free(ptBuf)
        }
        return Result.Ok(plaintext)
    }
}
