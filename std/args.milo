// std/args — command-line argument parsing

from "std/replay" import {
    replayOff, replayActive, replayTake, replayPut, replayJoinNul, replaySplitNul
}

// Return all command-line arguments as a Vec<string>.
// Index 0 is the program name. Recorded and replayed under MILO_RECORD /
// MILO_REPLAY (std/replay); payload is each argument followed by a NUL.
pub fn args(): Vec<string> {
    if replayOff() {
        return osArgs()
    }
    if replayActive() {
        return replaySplitNul(replayTake("args", ""))
    }
    let live = osArgs()
    replayPut("args", "", replayJoinNul(live))
    return live
}

fn osArgs(): Vec<string> {
    var result: Vec<string> = Vec.new()
    let n = _miloArgCount()
    for i in 0..n {
        result.push(_miloArgAt(i))
    }
    return result
}

// Get the value following a --name flag.
// None if the flag is absent or is the last argument. Only the `--name value`
// form is recognised, not `--name=value`.
// Example: getFlag("port") returns the value after --port.
pub fn getFlag(name: &string): string? {
    let all = args()
    let flag = "--" + name
    for i in 0..all.len {
        if all[i] == flag {
            if i + 1 < all.len {
                return Option.Some(all[i + 1])
            }
        }
    }
    return null
}

// Check if a --name flag is present in the arguments.
pub fn hasFlag(name: &string): bool {
    let all = args()
    let flag = "--" + name
    for item in all {
        if item == flag {
            return true
        }
    }
    return false
}
