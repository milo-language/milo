// platform-specific constants and helpers for Linux

from "std/os" import {
    htons, readlink, memcpy
}

// C's spelling, not Milo camelCase — @cLayout emits offsetof() with the name verbatim.
// No sin_len here (that is darwin/BSD); family is u16. Verified against the real header.
// Opaque marker for "a sockaddr of some family". The socket syscalls take a
// `struct sockaddr *` and read the family out of the first bytes, so one extern must serve
// sockaddr_in / sockaddr_in6 / sockaddr_un. A nominal opaque type rather than a bare *u8:
// same zero cost, but a typo can't pass just any pointer.
pub extern type SockAddr

@cLayout("struct sockaddr_in", "netinet/in.h")
pub extern struct SockAddrIn {
    sin_family: u16,
    sin_port: u16,
    sin_addr: u32,
    sin_zero: [u8; 8],
}

// IPv6. Same 28 bytes as darwin, but no sin6_len and family is u16.
@cLayout("struct sockaddr_in6", "netinet/in.h")
pub extern struct SockAddrIn6 {
    sin6_family: u16,
    sin6_port: u16,
    sin6_flowinfo: u32,
    sin6_addr: [u8; 16],
    sin6_scope_id: u32,
}

// Unix domain. 110 here vs 106 on darwin (no sun_len, u16 family, 108-byte path) — but
// sun_path lands at offset 2 on both.
@cLayout("struct sockaddr_un", "sys/un.h")
pub extern struct SockAddrUn {
    sun_family: u16,
    sun_path: [u8; 108],
}

// sockaddr_storage — big enough for any family. accept()/recvfrom() let the KERNEL pick
// the family, so they must write into this, never a 16-byte sockaddr_in: a v6 peer needs
// 28 bytes and would otherwise be truncated.
@cLayout("struct sockaddr_storage", "sys/socket.h")
pub extern struct SockAddrStorage {
    ss_family: u16,
    __ss_padding: [u8; 118],
    __ss_align: u64,
}

// 128 bytes of zeroes; the kernel fills in whichever family the peer used.
pub fn makeZeroedSockaddrStorage(): SockAddrStorage {
    unsafe {
        return zeroed<SockAddrStorage>()
    }
}

// AF_INET6 is 10 here — one of the few socket constants that actually differs across the
// two platforms (AF_INET and AF_UNIX are both the same on each).
pub fn afInet6(): i32 {
    return 10
}

// IPv6 address. `addr` is the 16 raw bytes in network order; `scopeId` is the interface
// index for a link-local address (fe80::/10), 0 otherwise.
pub fn makeSockaddr6(port: u16, addr: [u8; 16], scopeId: u32): SockAddrIn6 {
    var a = SockAddrIn6 {
        sin6_family: 10 as u16,
        sin6_port: htons(port),
        sin6_flowinfo: 0,
        sin6_addr: [0; 16],
        sin6_scope_id: scopeId,
    }
    var i: i64 = 0
    while i < 16 {
        a.sin6_addr[i] = addr[i]
        i = i + 1
    }
    return a
}

pub fn sockAddrInLen(): u32 {
    return 16
}

pub fn sockAddrIn6Len(): u32 {
    return 28
}

// Whole-struct length; bind/connect want it for AF_UNIX.
// AF_UNIX address for `path`. Truncates at sockAddrUnMaxPath so the kernel always sees a
// NUL-terminated path; callers should reject longer paths rather than connect to a
// silently shortened one (UnixListener/UnixStream do).
pub fn makeSockaddrUn(path: &string): SockAddrUn {
    var a = SockAddrUn {
        sun_family: 1 as u16,
        sun_path: [0; 108],
    }
    var i: i64 = 0
    while i < path.len && i < sockAddrUnMaxPath() {
        a.sun_path[i] = path[i]
        i = i + 1
    }
    return a
}

pub fn sockAddrUnLen(): u32 {
    return 110
}

// Longest path that still leaves room for the NUL the kernel expects.
pub fn sockAddrUnMaxPath(): i64 {
    return 107
}

pub fn sockAddrStorageLen(): u32 {
    return 128
}

pub fn makeSockaddr(port: u16, addr: u32): SockAddrIn {
    unsafe {
        return SockAddrIn {
            sin_family: 2 as u16,
            sin_port: htons(port),
            sin_addr: addr,
            sin_zero: [0; 8],
        }
    }
}

pub fn makeZeroedSockaddr(): SockAddrIn {
    return SockAddrIn {
        sin_family: 0 as u16, sin_port: 0, sin_addr: 0, sin_zero: [0; 8],
    }
}

pub fn solSocket(): i32 {
    return 1
}

pub fn soReuseaddr(): i32 {
    return 2
}

pub fn mapPrivateAnon(): i32 {
    return 34
}

pub fn oWriteCreateTrunc(): i32 {
    return 577
}

pub fn oWriteCreateAppend(): i32 {
    return 1089
}

// offset of aiAddr field in struct addrinfo (swapped with aiCanonname vs macOS)
pub fn addrinfoAddrOffset(): i64 {
    return 24
}

// struct stat layout (Linux x8664)
pub fn statModeOffset(): i64 {
    return 24
}

pub fn statSizeOffset(): i64 {
    return 48
}

pub fn statBufSize(): i64 {
    return 144
}

// struct dirent layout
pub fn direntTypeOffset(): i64 {
    return 18
}

pub fn direntNameOffset(): i64 {
    return 19
}

// errno access — glibc uses __errno_location() to get errno pointer
extern fn __errno_location(): *u8

pub fn getErrno(): i32 {
    unsafe {
        return _loadI32(__errno_location())
    }
}

// ── epoll ──

pub extern fn epoll_create1(flags: i32): i32

pub extern fn epoll_ctl(epfd: i32, op: i32, fd: i32, event: *u8): i32

pub extern fn epoll_wait(epfd: i32, events: *u8, maxevents: i32, timeout: i32): i32

// epoll_event: 12 bytes (packed: u32 events + epoll_data_t as i64)
pub struct EpollEvent {
    events: u32,
    dataFd: i32,
    dataPad: i32,
}

pub fn epollCtlAdd(): i32 {
    return 1
}

pub fn epollCtlDel(): i32 {
    return 2
}

pub fn epollCtlMod(): i32 {
    return 3
}

pub fn epollIn(): u32 {
    return 1
}

pub fn epollOut(): u32 {
    return 4
}

pub fn epollErr(): u32 {
    return 8
}

pub fn epollHup(): u32 {
    return 16
}

pub fn epollOneshot(): u32 {
    return 1073741824
}

// ── signals ──

// 17 here, 20 on darwin (verified against asm-generic/signal.h and sys/signal.h
// respectively). The only signal std/signal needs that isn't same-numbered on both.
pub fn sigchldNum(): i32 {
    return 17
}

// ── fcntl / non-blocking ──

pub extern fn fcntl(fd: i32, cmd: i32,...): i32

pub fn fGetfl(): i32 {
    return 3
}

pub fn fSetfl(): i32 {
    return 4
}

pub fn oNonblock(): i32 {
    return 2048
}

pub fn eagain(): i32 {
    return 11
}

pub fn einprogress(): i32 {
    return 115
}

pub fn soError(): i32 {
    return 4
}

// Winsock has no POSIX counterpart: sockets are ready to use with no init, and their
// errors go through errno like everything else. These fold to that so std/net's socket
// paths read the same on every platform (see platform.windows for the real work).
pub fn ensureNetInit(): void {
}

pub fn netErrno(): i32 {
    return getErrno()
}

pub fn netEagain(): i32 {
    return eagain()
}

pub fn netEinprogress(): i32 {
    return einprogress()
}

// A POSIX socket IS an fd, so closing it is just close(); Windows needs a distinct
// closesocket(), which is why this name exists on all arms.
pub fn closeSocket(fd: i32): i32 {
    return close(fd)
}

// ── ucontext (stackful coroutines) ──

pub extern fn getcontext(ucp: *u8): i32

pub extern fn makecontext(ucp: *u8, func: *u8, argc: i32,...): void

// @parks: the one call the checker cannot see through. Every green-task park in
// std/runtime is a wrapper around this, and inherits the mark from here.
@parks
pub extern fn swapcontext(oucp: *u8, ucp: *u8): i32

// An UPPER BOUND on sizeof(ucontext_t) across Linux architectures, not the exact
// size on any one of them. This buffer is what getcontext() fills in, so too
// small is a heap overflow: 968 is x86_64's size, and on aarch64 the same struct
// is 4560 bytes because its mcontext_t carries a 4096-byte __reserved area for
// FP/SVE state. Every aarch64 Linux binary therefore wrote ~3.6KB past a
// malloc'd block and aborted with glibc's "free(): invalid next size (fast)" at
// teardown — after running correctly, which is what made it look like an
// unrelated crash.
//
// The three offsets below are the same on x86_64 and aarch64, so only the
// allocation needed fixing. Over-allocating is free here: one of these accompanies
// an 8MB task stack.
pub fn uctxSize(): i64 {
    return 8192
}

pub fn uctxStackPtrOffset(): i64 {
    return 16
}

pub fn uctxStackSizeOffset(): i64 {
    return 32
}

pub fn uctxLinkOffset(): i64 {
    return 8
}

// ── mmap constants ──

pub fn protRead(): i32 {
    return 1
}

pub fn protWrite(): i32 {
    return 2
}

pub fn protNone(): i32 {
    return 0
}

pub fn mapPrivate(): i32 {
    return 2
}

pub fn mapAnon(): i32 {
    return 32
}

// ── executable path ──

// Linux keeps the running binary's path in /proc/self/exe. readlink does not
// NUL-terminate, so the caller's buffer must be zeroed or terminated at n.
pub fn exePathInto(buf: *u8, bufsize: i64): i64 {
    unsafe {
        let n = readlink("/proc/self/exe", buf, bufsize)
        if n <= 0 {
            return -1
        }
        return n
    }
}

// ── environment ──
// The three OS arms disagree on all of this: Windows has no setenv/unsetenv (the UCRT
// spells both `_putenv_s`) and macOS has no execvpe. std/env and std/process talk to
// these four names and never to the C ones.

@cSig("stdlib.h", "int setenv(const char *, const char *, int)")
pub extern fn setenv(name: *u8, value: *u8, overwrite: i32): i32

@cSig("stdlib.h", "int unsetenv(const char *)")
pub extern fn unsetenv(name: *u8): i32

// GNU extension: execvp's PATH search plus an explicit environment. unistd.h only
// declares it under _GNU_SOURCE, hence the feature-macro prefix on the guard header.
@cSig("_GNU_SOURCE+unistd.h", "int execvpe(const char *, char *const *, char *const *)")
pub extern fn execvpe(file: *u8, argv: *u8, envp: *u8): i32

// Set `name` to `value`, replacing any existing value. 0 on success.
pub fn envSet(name: *u8, value: *u8): i32 {
    unsafe {
        return setenv(name, value, 1)
    }
}

// Remove `name` from the environment. 0 on success; removing an unset name succeeds.
pub fn envUnset(name: *u8): i32 {
    unsafe {
        return unsetenv(name)
    }
}

// The live NULL-terminated `NAME=VALUE` array, reflecting every setenv/unsetenv so far.
//
// glibc publishes `environ` as a variable and Milo has no extern-variable syntax, so its
// address comes out of the dynamic symbol table (RTLD_DEFAULT is NULL on glibc; the link
// line always carries -ldl -rdynamic). /proc/self/environ is NOT a substitute — it is the
// environment the process was started with, frozen, and never reflects a later setenv.
// A null return means the symbol was not found, which callers must treat as "unknown",
// not "empty".
pub fn environBlock(): **u8 {
    unsafe {
        let slot = dlsym(0 as *u8, "environ" as *u8)
        if slot as i64 == 0 {
            return 0 as **u8
        }
        var block: *u8 = 0 as *u8
        memcpy((block.addrOf()) as *u8, slot, 8)
        return block as **u8
    }
}

// execvp — PATH search included — with an explicit environment.
pub fn execvpWithEnv(file: *u8, argv: *u8, envp: *u8): i32 {
    unsafe {
        return execvpe(file, argv, envp)
    }
}

// ── pthreads ──
// Declared in the platform split, not std/os: Windows has no pthreads at all, so its
// arm implements these same names over SRWLOCK/CONDITION_VARIABLE instead of declaring
// externs that no library provides.

pub extern fn pthread_create(thread: *u8, attr: *u8, start: *u8, arg: *u8): i32

pub extern fn pthread_join(thread: i64, retval: *u8): i32

pub extern fn pthread_detach(thread: i64): i32

// pthread_t is an unsigned long here. Declared u64 to match C exactly — the audit in
// scripts/audit-extern-returns.ts checks return signedness, and a signed claim over an
// unsigned C type is drift even when the bits are identical. Only ever compared for
// equality (std/sync uses it to name the thread that owns a running Once).
pub extern fn pthread_self(): u64

pub extern fn pthread_mutex_init(mutex: *u8, attr: *u8): i32

pub extern fn pthread_mutex_lock(mutex: *u8): i32

pub extern fn pthread_mutex_unlock(mutex: *u8): i32

pub extern fn pthread_mutex_destroy(mutex: *u8): i32

pub extern fn pthread_cond_init(cond: *u8, attr: *u8): i32

pub extern fn pthread_cond_wait(cond: *u8, mutex: *u8): i32

pub extern fn pthread_cond_signal(cond: *u8): i32

pub extern fn pthread_cond_broadcast(cond: *u8): i32

pub extern fn pthread_cond_destroy(cond: *u8): i32

pub extern fn pthread_rwlock_init(rwlock: *u8, attr: *u8): i32

pub extern fn pthread_rwlock_rdlock(rwlock: *u8): i32

pub extern fn pthread_rwlock_wrlock(rwlock: *u8): i32

pub extern fn pthread_rwlock_unlock(rwlock: *u8): i32

pub extern fn pthread_rwlock_destroy(rwlock: *u8): i32

// ── mmap family ──
// In the platform split rather than std/os: Windows has no mmap, and its arm implements
// these names over VirtualAlloc/VirtualFree/VirtualProtect instead.

@cSig("sys/mman.h", "void *mmap(void *, size_t, int, int, int, off_t)")
pub extern fn mmap(addr: *u8, len: i64, prot: i32, flags: i32, fd: i32, offset: i64): *u8

@cSig("sys/mman.h", "int munmap(void *, size_t)")
pub extern fn munmap(addr: *u8, len: i64): i32

@cSig("sys/mman.h", "int mprotect(void *, size_t, int)")
pub extern fn mprotect(addr: *u8, len: i64, prot: i32): i32

// ── time ──
// Split out of std/time because Windows has neither: its arm builds a timeval from
// GetSystemTimeAsFileTime and sleeps with Sleep().

pub extern fn gettimeofday(tv: *u8, tz: *u8): i32

pub extern fn usleep(usec: u32): i32

// pipe(2). Split out because the UCRT spells it _pipe and takes two extra arguments.

@cSig("unistd.h", "int pipe(int *)")
pub extern fn pipe(fds: *i32): i32

// ── fd I/O ──
//
// These live here, not in std/os, because the UCRT's are a different shape, not a
// different spelling: `int _read(int, void *, unsigned int)` against POSIX's
// `ssize_t read(int, void *, size_t)`. Declaring the POSIX widths everywhere linked
// (the oldnames shim resolves the symbol) and then miscompiled — Win64 leaves the
// upper half of RAX undefined for an `int` return, so a -1 could arrive as a large
// positive i64.

@cSig("unistd.h", "ssize_t read(int, void *, size_t)")
pub extern fn read(fd: i32, buf: *u8, nbyte: i64): i64

@cSig("unistd.h", "ssize_t write(int, const void *, size_t)")
pub extern fn write(fd: i32, buf: *u8, nbyte: i64): i64

// Socket data IO seam. On POSIX read()/write() work on socket fds, so these alias them; the
// Windows arm routes to recv()/send() because a SOCKET there is not a CRT fd (calling the
// CRT _read/_write on one fast-fails). Named so std/os's green helpers stay single-source.
pub fn sockRead(fd: i32, buf: *u8, nbyte: i64): i64 {
    return read(fd, buf, nbyte)
}

pub fn sockWrite(fd: i32, buf: *u8, nbyte: i64): i64 {
    return write(fd, buf, nbyte)
}

@cSig("fcntl.h", "int open(const char *, int, ...)")
pub extern fn open(path: *u8, flags: i32,...): i32

@cSig("unistd.h", "int close(int)")
pub extern fn close(fd: i32): i32

@cSig("unistd.h", "off_t lseek(int, off_t, int)")
pub extern fn lseek(fd: i32, offset: i64, whence: i32): i64

@cSig("unistd.h", "int access(const char *, int)")
pub extern fn access(path: *u8, mode: i32): i32

@cSig("unistd.h", "pid_t getpid(void)")
pub extern fn getpid(): i32

// The bit-bucket device path. POSIX spells it /dev/null; Windows spells it NUL.
pub fn devNullPath(): string {
    return "/dev/null"
}

// ── dynamic loading ──

@cSig("dlfcn.h", "void *dlopen(const char *, int)")
pub extern fn dlopen(_path: *u8, _flags: i32): *u8

@cSig("dlfcn.h", "void *dlsym(void *, const char *)")
pub extern fn dlsym(_handle: *u8, _symbol: *u8): *u8

@cSig("dlfcn.h", "int dlclose(void *)")
pub extern fn dlclose(_handle: *u8): i32

@cSig("dlfcn.h", "char *dlerror(void)")
pub extern fn dlerror(): *u8
