// std/set — HashSet<T>, a set of unique values backed by a HashMap<T, bool>.
//
// Iteration order is unspecified and reseeded every process, exactly as it is for
// HashMap. Collect with toVec() and sort when you need a stable order.

// An unordered collection of unique values.
pub struct HashSet<T> {
    // `@iter` hands `for x in s` straight to the map, which yields its keys — the
    // set's elements. Without it a set would need a `next` method, and an iterator
    // over this set would have to hold a reference into it, which Milo forbids.
    @iter inner: HashMap<T, bool>,
}

impl HashSet<T> {
    // Create an empty HashSet.
    //
    // A generic static takes its type argument: `HashSet<string>.new()`.
    fn new(): HashSet<T> {
        return HashSet {
            inner: HashMap.new()
        }
    }

    // Create an empty HashSet sized so `capacity` adds never rehash.
    fn withCapacity(capacity: i64): HashSet<T> {
        return HashSet {
            inner: HashMap.withCapacity(capacity)
        }
    }

    // Collect a Vec into a set, dropping duplicates.
    fn fromVec(items: Vec<T>): HashSet<T> {
        var out: HashSet<T> = HashSet {
            inner: HashMap.withCapacity(items.len())
        }
        for x in items {
            out.inner.insert(x.clone(), true)
        }
        return out
    }

    // Add a value to the set.
    //
    // No-op if the value is already present.
    fn add(self: &mut HashSet<T>, val: T): void {
        self.inner.insert(val, true)
    }

    // Check if the set contains a value.
    fn contains(self: &HashSet<T>, val: T): bool {
        return self.inner.contains(val)
    }

    // Remove a value from the set.
    //
    // No-op if the value is absent.
    fn remove(self: &mut HashSet<T>, val: T): void {
        self.inner.remove(val)
    }

    // Number of elements in the set.
    fn len(self: &HashSet<T>): i64 {
        return self.inner.len
    }

    fn isEmpty(self: &HashSet<T>): bool {
        return self.inner.len == 0
    }

    // Drop every element, keeping the table's capacity.
    fn clear(self: &mut HashSet<T>): void {
        self.inner.clear()
    }

    // Element by element rather than `self.inner.clone()`: the builtin map clone copies
    // each key structurally and never runs T's own Clone impl, so a T carrying Drop
    // was released once per copy (the generic-drop fuzzer's HashSet.clone finding).
    // Same reason every other constructor here spells `x.clone()`.
    fn clone(self: &HashSet<T>): HashSet<T> {
        var out: HashSet<T> = HashSet {
            inner: HashMap.withCapacity(self.inner.len)
        }
        for x in self {
            out.inner.insert(x.clone(), true)
        }
        return out
    }

    // Snapshot the elements into a Vec. Sort it if you need a stable order —
    // `print` on a set would otherwise expose the randomized bucket order.
    // Not `self.inner.keys()`, for the reason `clone` gives.
    fn toVec(self: &HashSet<T>): Vec<T> {
        var out: Vec<T> = Vec.withCapacity(self.inner.len)
        for x in self {
            out.push(x.clone())
        }
        return out
    }

    // Everything in either set.
    fn union(self: &HashSet<T>, other: &HashSet<T>): HashSet<T> {
        var out: HashSet<T> = HashSet {
            inner: HashMap.withCapacity(self.inner.len + other.inner.len)
        }
        for x in self {
            out.inner.insert(x.clone(), true)
        }
        for x in other {
            out.inner.insert(x.clone(), true)
        }
        return out
    }

    // Everything in both sets.
    fn intersect(self: &HashSet<T>, other: &HashSet<T>): HashSet<T> {
        var out: HashSet<T> = HashSet {
            inner: HashMap.new()
        }
        for x in self {
            if other.inner.contains(x) {
                out.inner.insert(x.clone(), true)
            }
        }
        return out
    }

    // Everything in this set that is not in `other`.
    fn difference(self: &HashSet<T>, other: &HashSet<T>): HashSet<T> {
        var out: HashSet<T> = HashSet {
            inner: HashMap.new()
        }
        for x in self {
            if !other.inner.contains(x) {
                out.inner.insert(x.clone(), true)
            }
        }
        return out
    }

    // True when every element of this set is also in `other`.
    fn isSubsetOf(self: &HashSet<T>, other: &HashSet<T>): bool {
        for x in self {
            if !other.inner.contains(x) {
                return false
            }
        }
        return true
    }
}
