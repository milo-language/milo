// std/pty — pseudoterminal support (macOS)

from "std/os" import {
    dup2,
    execvp,
    fork,
    free,
    grantpt,
    ioctl,
    isatty,
    kill,
    malloc,
    memcpy,
    memset,
    posix_openpt,
    ptsname,
    readFd,
    setsid,
    unlockpt,
    waitpid,
    writeFd,
    sysWrite,
    sysClose,
    sysWaitpid,
    sysKill,
    sysIsatty
}
from "std/replay" import {
    replayOff, replayRet, replayBlob, replayInts, replayFdOpened
}
from "std/platform" import {
    close,
    open,
    write
}
from "std/sync" import {
    Channel
}
from "std/io" import {
    fdChannel,
    AsFd,
    Stdin
}

pub fn tiocgwinsz(): i64 {
    return 1074295912
}

pub fn tiocswinsz(): i64 {
    return 2148037735
}

pub fn tiocsctty(): i64 {
    return 536900705
}

pub struct WinSize {
    rows: u16,
    cols: u16,
    xpixel: u16,
    ypixel: u16,
}

pub struct Pty {
    _masterFd: i32,
    slavePath: string,
    childPid: i32,
    _rows: u16,
    _cols: u16,
}

// Returns true if `h` is connected to a terminal: `isTerminal(Stdout {})`.
pub fn isTerminal<T: AsFd>(h: &T): bool {
    unsafe { return sysIsatty(h.rawFd()) }
}

// Returns true if stdin is a terminal (process is interactive).
pub fn isInteractive(): bool {
    return isTerminal(Stdin {})
}

// The master side's descriptor (see AsFd in std/io). `sel.onRead(pty)`, `isTerminal`
// and `OwnedFd.dup(pty)` take the Pty itself.
impl AsFd for Pty {
    @unsafe
    fn rawFd(self: &Self): i32 {
        return self._masterFd
    }
}

impl Pty {
    // The spawned child's pid, or -1 before spawn.
    fn pid(self: &Pty): i32 {
        return self.childPid
    }

    // Opening is one record (pty.open): the master fd and the slave's path. Under
    // replay no pty exists and the master is a synthetic fd answered from the trace.
    fn open(): Result<Pty, string> {
        unsafe {
            if replayOff() {
                return Pty._openLive()
            }
            let p = replayBlob("pty.open", "", (): string => {
                match Pty._openLive() {
                    Result.Ok(pty) => {
                        return pty._masterFd.toString() + " " + pty.slavePath
                    }
                    Result.Err(e) => {
                        return "!" + e
                    }
                }
            })
            if p.len() > 0 && p[0] == '!' {
                return Result.Err(p.substr(1, p.len()))
            }
            var sp: i64 = 0
            while sp < p.len() && p[sp] != ' ' {
                sp += 1
            }
            let master = replayInts(p.substr(0, sp)) [0] as i32
            replayFdOpened(master, 't')
            return Result.Ok(Pty {
                _masterFd: master, slavePath: p.substr(sp + 1, p.len()), childPid: -1, _rows: 24, _cols: 80
            })
        }
    }

    @replayHooked
    fn _openLive(): Result<Pty, string> {
        unsafe {
            // O_RDWR=2 | O_NOCTTY=0x20000
            let master = posix_openpt(131074)
            if master < 0 {
                return Result.Err("posix_openpt failed")
            }

            if grantpt(master) != 0 {
                close(master)
                return Result.Err("grantpt failed")
            }
            if unlockpt(master) != 0 {
                close(master)
                return Result.Err("unlockpt failed")
            }

            let namePtr = ptsname(master)
            if namePtr as i64 == 0 {
                close(master)
                return Result.Err("ptsname failed")
            }

            let name = _cstrToString(namePtr)
            return Result.Ok(Pty {
                _masterFd: master, slavePath: name, childPid: -1, _rows: 24, _cols: 80
            })
        }
    }

    // Spawn child connected to PTY. Recorded as pty.spawn (the pid); under replay
    // nothing is forked.
    fn spawn(self: &mut Self, program: &string, args: &Vec<string>): Result<i32, string>
    requires
    self._masterFd >= 0
    {
        if replayOff() {
            return self._spawnLive(program, args)
        }
        var line = program.clone()
        for a in args {
            line.push(' ')
            line.pushStr(a)
        }
        let pid = replayRet("pty.spawn", line, false, (): i64 => {
            match self._spawnLive(program, args) {
                Result.Ok(pid) => {
                    return pid as i64
                }
                Result.Err(_) => {
                    return -1
                }
            }
        }) as i32
        if pid < 0 {
            return Result.Err("fork failed")
        }
        self.childPid = pid
        return Result.Ok(pid)
    }

    @replayHooked
    fn _spawnLive(self: &mut Self, program: &string, args: &Vec<string>): Result<i32, string> {
        unsafe {
            let argc = args.len + 2
            // allocate argv pointer array + stable C string copies
            let argv = malloc(argc * 8)

            // strdup program into argv[0]
            let plen = program.len
            let pcopy = malloc(plen + 1)
            memcpy(pcopy, program as *u8, plen)
            memset((pcopy as i64 + plen) as *u8, 0, 1)
            memcpy(argv, (pcopy.addrOf()) as *u8, 8)

            // strdup each arg into argv[1..n]
            for i in 0..args.len {
                let arg = args[i]
                let alen = arg.len
                let acopy = malloc(alen + 1)
                memcpy(acopy, arg as *u8, alen)
                memset((acopy as i64 + alen) as *u8, 0, 1)
                memcpy((argv as i64 + (i + 1) * 8) as *u8, (acopy.addrOf()) as *u8, 8)
            }

            // argv[argc-1] = NULL
            var nullPtr: *u8 = 0 as *u8
            memcpy((argv as i64 + (argc - 1) * 8) as *u8, (nullPtr.addrOf()) as *u8, 8)

            let pid = fork()
            if pid < 0 {
                freeArgv(argv, argc)
                return Result.Err("fork failed")
            }

            if pid == 0 {
                setsid()
                let slave = open(self.slavePath, 2)
                if slave < 0 {
                    exit(1)
                }
                ioctl(slave, tiocsctty(), 0)
                // set winsize on slave so child sees correct dimensions
                var childWs = WinSize {
                    rows: self._rows, cols: self._cols, xpixel: 0, ypixel: 0
                }
                ioctl(slave, tiocswinsz(), (childWs.addrOf()) as *u8)
                dup2(slave, 0)
                dup2(slave, 1)
                dup2(slave, 2)
                // Close every inherited fd except the dup'd stdio — same leak as
                // Child.spawn: parent's sockets/kqueue wedge or linger in the child.
                var extraFd: i32 = 3
                while extraFd < 1024 {
                    close(extraFd)
                    extraFd += 1
                }
                execvp(pcopy, argv)
                exit(127)
            }

            freeArgv(argv, argc)
            self.childPid = pid
            return Result.Ok(pid)
        }
    }

    // Low-level single read into a raw buffer. Prefer `output()` for streaming —
    // it owns the read/EAGAIN pump and hands you an iterable channel of chunks.
    @unsafe
    fn read(self: &Self, buf: *u8, len: i64): i64
    requires
    len > 0
    {
        unsafe { return readFd(self._masterFd, buf, len) }
    }

    @unsafe
    fn write(self: &Self, buf: *u8, len: i64): i64
    requires
    len > 0
    {
        unsafe { return writeFd(self._masterFd, buf, len) }
    }

    fn writeStdout(self: &Self, s: &string): i64 {
        unsafe {
            return writeFd(self._masterFd, s as *u8, s.len)
        }
    }

    // One write(2) of `s`, never retried and never parked: returns the bytes the
    // master took (possibly fewer than s.len), or -1. Once the master is
    // non-blocking (output() and any green read make it so), a full input queue
    // returns -1 at once instead of waiting for the child to drain it, which is
    // what a task that must keep serving other requests wants; write() parks.
    fn writeOnce(self: &Self, s: &string): i64 {
        if self._masterFd < 0 {
            return -1
        }
        unsafe { return sysWrite(self._masterFd, s as *u8, s.len) }
    }

    // Pump this pty's output on a background green task and return a channel of
    // raw output chunks. The caller only `recv`s the channel — no read(),
    // EAGAIN handling, or hand-written pump loop. The channel is closed when the
    // child exits (read returns <= 0). This is node-pty's `.onData` ergonomics
    // with green-task semantics underneath.
    fn output(self: &Self): Channel<string> {
        unsafe {
            return fdChannel(self._masterFd)
        }
    }

    @replayHooked
    fn resize(self: &mut Self, rows: u16, cols: u16): i32 {
        self._rows = rows
        self._cols = cols
        var ws = WinSize {
            rows: rows, cols: cols, xpixel: 0, ypixel: 0
        }
        let fd = self._masterFd
        return replayRet("pty.resize", fd.toString() + " " + rows.toString() + " " + cols.toString(), false, (): i64 => {
            unsafe {
                return ioctl(fd, tiocswinsz(), (ws.addrOf()) as *u8) as i64
            }
        }) as i32
    }

    @replayHooked
    fn winSize(self: &Self): WinSize {
        var ws = WinSize {
            rows: 0, cols: 0, xpixel: 0, ypixel: 0
        }
        let fd = self._masterFd
        if replayOff() {
            unsafe {
                ioctl(fd, tiocgwinsz(), (ws.addrOf()) as *u8)
            }
            return ws
        }
        let v = replayInts(replayBlob("pty.winsize", fd.toString(), (): string => {
            unsafe {
                ioctl(fd, tiocgwinsz(), (ws.addrOf()) as *u8)
            }
            return ws.rows.toString() + " " + ws.cols.toString() + " " + ws.xpixel.toString() + " " + ws.ypixel.toString()
        }))
        return WinSize {
            rows: v[0] as u16, cols: v[1] as u16, xpixel: v[2] as u16, ypixel: v[3] as u16
        }
    }

    // Wait for child to exit. Returns exit status.
    fn wait(self: &Self): i32
    requires
    self.childPid > 0
    {
        var status: [u8; 4] = [0; 4]
        unsafe { sysWaitpid(self.childPid, status as *u8, 0) }
        return status[1] as i32
    }

    // SIGKILL the child. Needed to tear down children that never exit on
    // their own (e.g. `while true` shells) before a blocking wait().
    fn kill(self: &Self): void
    requires
    self.childPid > 0
    {
        sysKill(self.childPid, 9)
    }

    // Idempotent: closing the master also unwedges a child blocked writing to a
    // full PTY buffer (its write returns EIO), letting a pending SIGKILL land.
    fn close(self: &mut Self): void {
        unsafe {
            if self._masterFd >= 0 {
                sysClose(self._masterFd)
                self._masterFd = -1
            }
        }
    }
}

// Convenience: open + spawn in one call
pub fn openAndSpawn(program: &string, args: &Vec<string>): Result<Pty, string> {
    var pty = Pty.open()?
    pty.spawn(program, args)?
    return Result.Ok(pty)
}

fn freeArgv(argv: *u8, argc: i64): void {
    unsafe {
        for i in 0..(argc - 1) {
            var p: *u8 = 0 as *u8
            memcpy((p.addrOf()) as *u8, (argv as i64 + i * 8) as *u8, 8)
            if p as i64 != 0 {
                free(p)
            }
        }
        free(argv)
    }
}
