// std/smt — a quantifier-free linear integer arithmetic (QF_LIA) decision
// procedure written in Milo itself. The fragment `milo prove` emits for
// contract discharge, decided without any external solver (no z3).
//
// Method: a boolean formula over linear atoms is decided by enumerating truth
// assignments of the atoms (2^k, k small for contracts); each satisfying
// assignment induces a conjunction of linear constraints whose feasibility
// over the rationals is settled by Fourier–Motzkin elimination. A bounded
// integer search reconstructs a concrete counterexample when one exists.
//
// Deliberately NOT z3: no bitvectors, no nonlinear arithmetic, no exact
// integer hull. When a system is feasible over the rationals but has no small
// integer witness, decide() honestly returns Unknown rather than guessing.

from "std/math" import {
    Math
}

// A row asserts  (sum coeffs[j]*x_j) + konst  <op>  0, strict picking < vs <=.
pub struct Constraint {
    coeffs: Vec<i64>,
    konst: i64,
    strict: bool,
}

// Node kinds in the flat formula tree: 0=atom, 1=not, 2=and, 3=or.
//
// varIsInt marks which variables range over the integers. It is not decoration: the two
// integer tightenings in reduceConstraint are UNSOUND for a real-valued variable, and
// applying them anyway is a false proof, not a lost one. `0 < x && x < 1` is satisfiable
// over the reals, but tightened as if x were an integer it becomes `x >= 1 && x <= 0`,
// the system goes infeasible, and every postcondition guarded by it reports `proven`.
pub struct SmtProblem {
    nvars: i64,
    varIsInt: Vec<bool>,
    atomCoeffs: Vec<Vec<i64>>,
    atomKonst: Vec<i64>,
    atomStrict: Vec<bool>,
    nodeKind: Vec<i64>,
    nodeAtom: Vec<i64>,
    nodeKids: Vec<Vec<i64>>,
}

pub enum Verdict {
    Proven,
    Violated(Vec<i64>),
    Unknown,
}

// Every variable an integer — the QF_LIA case this solver was written for.
pub fn newProblem(nvars: i64): SmtProblem {
    var flags: Vec<bool> = []
    var j: i64 = 0
    while j < nvars {
        flags.push(true)
        j += 1
    }
    return newProblemMixed(nvars, flags)
}

// varIsInt[j] = false marks x_j as ranging over the reals, which disables the integer
// tightenings for every row that mentions it. Feasibility, and therefore a `Proven`
// verdict, is decided over the rationals either way, so this only ever loses precision.
pub fn newProblemMixed(nvars: i64, varIsInt: Vec<bool>): SmtProblem {
    return SmtProblem {
        nvars: nvars,
        varIsInt: varIsInt,
        atomCoeffs: [],
        atomKonst: [],
        atomStrict: [],
        nodeKind: [],
        nodeAtom: [],
        nodeKids: [],
    }
}

// Does every variable this row actually constrains range over the integers? A zero
// coefficient contributes nothing, so a real variable the row does not mention cannot
// block the tightening.
// No integer variable anywhere in the problem, so nothing is a relaxation.
pub fn allReal(varIsInt: &Vec<bool>, nvars: i64): bool {
    if nvars < 1 {
        return false
    }
    var j: i64 = 0
    while j < varIsInt.len {
        if varIsInt[j] {
            return false
        }
        j += 1
    }
    return true
}

pub fn rowAllInt(coeffs: &Vec<i64>, varIsInt: &Vec<bool>): bool {
    var j: i64 = 0
    while j < coeffs.len {
        if coeffs[j] != 0 {
            if !varIsInt[j] {
                return false
            }
        }
        j += 1
    }
    return true
}

// Register an atom  row·x + konst <op> 0 ; returns its atom index.
pub fn addAtom(p: &mut SmtProblem, row: Vec<i64>, konst: i64, strict: bool): i64 {
    p.atomCoeffs.push(row)
    p.atomKonst.push(konst)
    p.atomStrict.push(strict)
    return p.atomKonst.len - 1
}

pub fn nAtom(p: &mut SmtProblem, atomIdx: i64): i64 {
    p.nodeKind.push(0)
    p.nodeAtom.push(atomIdx)
    var empty: Vec<i64> = []
    p.nodeKids.push(empty)
    return p.nodeKind.len - 1
}

pub fn nNot(p: &mut SmtProblem, kid: i64): i64 {
    p.nodeKind.push(1)
    p.nodeAtom.push(-1)
    var kids: Vec<i64> = []
    kids.push(kid)
    p.nodeKids.push(kids)
    return p.nodeKind.len - 1
}

pub fn nAnd(p: &mut SmtProblem, kids: Vec<i64>): i64 {
    p.nodeKind.push(2)
    p.nodeAtom.push(-1)
    p.nodeKids.push(kids)
    return p.nodeKind.len - 1
}

pub fn nOr(p: &mut SmtProblem, kids: Vec<i64>): i64 {
    p.nodeKind.push(3)
    p.nodeAtom.push(-1)
    p.nodeKids.push(kids)
    return p.nodeKind.len - 1
}

pub fn gcd2(a: i64, b: i64): i64 {
    var x = Math.absI64(a)
    var y = Math.absI64(b)
    while y != 0 {
        let t = x % y
        x = y
        y = t
    }
    return x
}

// ceil(a / b) for b > 0, on top of Milo's truncating division. Truncation already
// rounds toward zero, which IS the ceiling for a negative numerator; only a positive
// remainder needs the bump.
pub fn ceilDiv(a: i64, b: i64): i64 {
    let q = a / b
    if a % b > 0 {
        return q + 1
    }
    return q
}

// Put a row in INTEGER normal form. Two steps, both exact over the integers — the
// tightened row has the same integer solutions as the original, so this can only sharpen
// a verdict, never invent one.
//
//   1. Strictness goes away. `L < 0` on an integer L is `L + 1 <= 0`, so nothing
//      downstream has to carry a strict flag.
//   2. The constant is rounded IN. With g = gcd of the coefficients, `row·x` is always a
//      multiple of g, so `g*(b·x) <= -konst` is `b·x <= floor(-konst/g)` — a strictly
//      stronger bound than the rational one whenever g does not divide konst.
//
// Step 2 is the whole reason this exists. Fourier-Motzkin decides feasibility over the
// RATIONALS, so `2x = 3` looks satisfiable (x = 3/2) and the verdict came back `unknown —
// no integer witness`: the solver could neither refute it nor produce a counterexample an
// i64 could take. Rounding the bound in turns that same system into `x <= 1` and `x >= 2`,
// which Fourier-Motzkin then refutes with no notion of integrality at all.
//
// The old form divided coefficients AND konst by their common gcd, which is exact over the
// rationals and therefore threw this away: gcd(2, 3) is 1, so `2x - 3 <= 0` did not move.
//
// It also still does the job it was written for — dividing out the gcd bounds
// Fourier-Motzkin's coefficient growth, which is what keeps i64 from overflowing on the
// small systems contracts produce.
//
// Both steps assume every variable the row mentions is an integer, which is what `allInt`
// asserts. When it is false the row is only normalized in ways that hold over the reals:
// strictness is preserved, and the gcd is divided out only when it divides the constant
// exactly. See the SmtProblem comment for the false proof the guard prevents.
pub fn reduceConstraint(c: &Constraint, allInt: bool): Constraint {
    if !allInt {
        return reduceRational(c)
    }
    var konst = c.konst
    if c.strict {
        konst += 1
    }
    var g: i64 = 0
    var j: i64 = 0
    while j < c.coeffs.len {
        g = gcd2(g, c.coeffs[j])
        j += 1
    }
    // An all-zero row is a bare constant claim: there is no g to divide by, and the
    // feasibility check reads `konst` directly.
    if g < 1 {
        var zc: Vec<i64> = []
        j = 0
        while j < c.coeffs.len {
            zc.push(0)
            j += 1
        }
        return Constraint {
            coeffs: zc, konst: konst, strict: false
        }
    }
    var nc: Vec<i64> = []
    j = 0
    while j < c.coeffs.len {
        nc.push(c.coeffs[j] / g)
        j += 1
    }
    return Constraint {
        coeffs: nc, konst: ceilDiv(konst, g), strict: false
    }
}

// Normalize a row that mentions at least one real-valued variable. Dividing an inequality
// through by a positive constant is exact over the rationals, so the gcd division survives
// — but only when g divides konst too, since a fractional constant has nowhere to live in
// an i64 row. Strictness is carried, not folded away: `L < 0` says nothing about `L + 1`
// when L is real. When the gcd does not divide the constant the row is returned unchanged,
// which costs some of Fourier-Motzkin's coefficient-growth headroom and nothing else.
pub fn reduceRational(c: &Constraint): Constraint {
    var g: i64 = 0
    var j: i64 = 0
    while j < c.coeffs.len {
        g = gcd2(g, c.coeffs[j])
        j += 1
    }
    if g < 2 || c.konst % g != 0 {
        return Constraint {
            coeffs: cloneRow(c.coeffs), konst: c.konst, strict: c.strict
        }
    }
    var nc: Vec<i64> = []
    j = 0
    while j < c.coeffs.len {
        nc.push(c.coeffs[j] / g)
        j += 1
    }
    return Constraint {
        coeffs: nc, konst: c.konst / g, strict: c.strict
    }
}

pub fn cloneRow(row: &Vec<i64>): Vec<i64> {
    var out: Vec<i64> = []
    var j: i64 = 0
    while j < row.len {
        out.push(row[j])
        j += 1
    }
    return out
}

// b*p[j] + a*n[j], or None if any step overflows i64.
//
// This is the soundness seam. Fourier-Motzkin multiplies constants together, so a konst
// anywhere near 2^62 overflows on the first combine. Wrapping (the -O2 behaviour) flips
// the sign, the row becomes nonsense, the system looks infeasible, and `decide` reports
// UNSAT — i.e. **proven**. A false proof is the worst answer a prover can give, so an
// overflow must reach the caller as "cannot decide" and never as a verdict.
pub fn combineTerm(b: i64, pj: i64, a: i64, nj: i64): Option<i64> {
    let Option.Some(t1) = b.checkedMul(pj) else {
        return Option.None
    }
    let Option.Some(t2) = a.checkedMul(nj) else {
        return Option.None
    }
    return t1.checkedAdd(t2)
}

// Combine upper row p (coeff +a on x_k) with lower row n (coeff -b): b*p + a*n.
// None when the arithmetic overflows — see combineTerm.
pub fn combine(p: &Constraint, n: &Constraint, k: i64, varIsInt: &Vec<bool>): Option<Constraint> {
    let a = p.coeffs[k]
    let b = -n.coeffs[k]
    var nc: Vec<i64> = []
    var j: i64 = 0
    while j < p.coeffs.len {
        if j == k {
            nc.push(0)
        } else {
            let Option.Some(v) = combineTerm(b, p.coeffs[j], a, n.coeffs[j]) else {
                return Option.None
            }
            nc.push(v)
        }
        j += 1
    }
    let Option.Some(kon) = combineTerm(b, p.konst, a, n.konst) else {
        return Option.None
    }
    let c = Constraint {
        coeffs: nc, konst: kon, strict: p.strict || n.strict
    }
    return Option.Some(reduceConstraint(c, rowAllInt(c.coeffs, varIsInt)))
}

// None when any combine overflows — the caller must not read that as infeasible.
pub fn eliminateVar(cs: &Vec<Constraint>, k: i64, varIsInt: &Vec<bool>): Option<Vec<Constraint>> {
    var out: Vec<Constraint> = []
    var i: i64 = 0
    while i < cs.len {
        if cs[i].coeffs[k] == 0 {
            out.push(reduceConstraint(cs[i], rowAllInt(cs[i].coeffs, varIsInt)))
        }
        i += 1
    }
    var p: i64 = 0
    while p < cs.len {
        if cs[p].coeffs[k] > 0 {
            var n: i64 = 0
            while n < cs.len {
                if cs[n].coeffs[k] < 0 {
                    let Option.Some(c) = combine(cs[p], cs[n], k, varIsInt) else {
                        return Option.None
                    }
                    out.push(c)
                }
                n += 1
            }
        }
        p += 1
    }
    return Option.Some(out)
}

// Feasible over the rationals? Eliminate every variable; a surviving constant
// row that is violated proves the system UNSAT.
// None = the elimination overflowed, so feasibility is undecided here. Returning `false`
// (infeasible) in that case is what produced false proofs.
pub fn feasibleRational(cs0: &Vec<Constraint>, nvars: i64, varIsInt: &Vec<bool>): Option<bool> {
    var cs: Vec<Constraint> = []
    var i0: i64 = 0
    while i0 < cs0.len {
        cs.push(reduceConstraint(cs0[i0], rowAllInt(cs0[i0].coeffs, varIsInt)))
        i0 += 1
    }
    var k: i64 = 0
    while k < nvars {
        let Option.Some(next) = eliminateVar(cs, k, varIsInt) else {
            return Option.None
        }
        cs = next
        k += 1
    }
    var i: i64 = 0
    while i < cs.len {
        let kon = cs[i].konst
        if cs[i].strict {
            if kon >= 0 {
                return Option.Some(false)
            }
        } else {
            if kon > 0 {
                return Option.Some(false)
            }
        }
        i += 1
    }
    return Option.Some(true)
}

pub fn satisfiesAll(cs: &Vec<Constraint>, x: &Vec<i64>): bool {
    var i: i64 = 0
    while i < cs.len {
        var s: i64 = cs[i].konst
        var j: i64 = 0
        while j < cs[i].coeffs.len {
            s = s + cs[i].coeffs[j] * x[j]
            j += 1
        }
        if cs[i].strict {
            if s >= 0 {
                return false
            }
        } else {
            if s > 0 {
                return false
            }
        }
        i += 1
    }
    return true
}

// Map an odometer step 0,1,2,3,4,... to values 0,-1,1,-2,2,... so the search
// fans out from the origin and returns small-magnitude witnesses (a clean
// counterexample like x=-1, not the box corner x=-700).
pub fn zigzag(step: i64): i64 {
    if step % 2 == 0 {
        return step / 2
    }
    return -((step + 1) / 2)
}

// Odometer search for a concrete integer witness, each coordinate ranging over
// zigzag steps [0, 2*bound] so nearer-zero points are tried first. Capped at
// maxIters so a high-dimensional box can't blow up. Empty result = none found.
pub fn findWitness(cs: &Vec<Constraint>, nvars: i64, bound: i64, maxIters: i64): Vec<i64> {
    let span = 2 * bound + 1
    var step: Vec<i64> = []
    var x: Vec<i64> = []
    var j: i64 = 0
    while j < nvars {
        step.push(0)
        x.push(0)
        j += 1
    }
    var iters: i64 = 0
    var done: bool = false
    while !done && iters < maxIters {
        var c: i64 = 0
        while c < nvars {
            x[c] = zigzag(step[c])
            c += 1
        }
        if satisfiesAll(cs, x) {
            return x
        }
        iters += 1
        var idx: i64 = 0
        while idx < nvars {
            step[idx] += 1
            if step[idx] < span {
                break
            }
            step[idx] = 0
            idx += 1
        }
        if idx == nvars {
            done = true
        }
    }
    var empty: Vec<i64> = []
    return empty
}

// Per-variable box radius so the total search (2b+1)^nvars stays near a few
// million points — wide in low dimensions, tight in high ones.
pub fn witnessBound(nvars: i64): i64 {
    if nvars <= 1 {
        return 1000000
    }
    if nvars == 2 {
        return 700
    }
    if nvars == 3 {
        return 60
    }
    if nvars == 4 {
        return 20
    }
    if nvars == 5 {
        return 9
    }
    return 5
}

pub fn evalNode(p: &SmtProblem, node: i64, mask: i64): bool {
    let kind = p.nodeKind[node]
    if kind == 0 {
        let a = p.nodeAtom[node]
        return ((mask >> a) & 1) == 1
    }
    if kind == 1 {
        return !evalNode(p, p.nodeKids[node][0], mask)
    }
    if kind == 2 {
        var i: i64 = 0
        while i < p.nodeKids[node].len {
            if !evalNode(p, p.nodeKids[node][i], mask) {
                return false
            }
            i += 1
        }
        return true
    }
    // or
    var i: i64 = 0
    while i < p.nodeKids[node].len {
        if evalNode(p, p.nodeKids[node][i], mask) {
            return true
        }
        i += 1
    }
    return false
}

// Build the conjunction induced by a truth assignment: atom i as-is when its
// bit is set, negated otherwise.
pub fn inducedConstraints(p: &SmtProblem, mask: i64): Vec<Constraint> {
    var cs: Vec<Constraint> = []
    var a: i64 = 0
    while a < p.atomKonst.len {
        let bit = (mask >> a) & 1
        let row = cloneRow(p.atomCoeffs[a])
        if bit == 1 {
            cs.push(Constraint {
                coeffs: row, konst: p.atomKonst[a], strict: p.atomStrict[a]
            }
            )
        } else {
            // ¬(L <= 0) is (-L < 0); ¬(L < 0) is (-L <= 0)
            var nr: Vec<i64> = []
            var j: i64 = 0
            while j < row.len {
                nr.push(-row[j])
                j += 1
            }
            cs.push(Constraint {
                coeffs: nr, konst: -p.atomKonst[a], strict:!p.atomStrict[a]
            }
            )
        }
        a += 1
    }
    return cs
}

// Decide SAT of the formula rooted at `root`. In a proof obligation the root is
// (assumptions ∧ body-paths ∧ ¬goal), so:
//   Proven      = UNSAT (no assignment yields a feasible conjunction)
//   Violated(w) = SAT with a concrete integer counterexample w
//   Unknown     = rational-feasible but no integer witness in the search box
//                 (the QF_LIA integer gap this Tier-1 core doesn't close)
//
// The witness search enumerates integer points even for a real-valued variable. That is
// sound in the direction it matters — an integer point is a real point, so a witness it
// finds is a genuine counterexample — but incomplete: `0 < x && x < 1` is satisfiable over
// the reals with no integer point at all, so the verdict is Unknown rather than Violated.
pub fn verdictName(v: &Verdict): string {
    match v {
        Verdict.Proven => {
            return "proven"
        }
        Verdict.Violated(_) => {
            return "violated"
        }
        Verdict.Unknown => {
            return "unknown"
        }
    }
}

pub fn decide(p: &SmtProblem, root: i64): Verdict {
    let natoms = p.atomKonst.len
    if natoms > 20 {
        return Verdict.Unknown
    }
    let total: i64 = 1 << natoms
    var sawRationalOnly: bool = false
    var mask: i64 = 0
    while mask < total {
        if evalNode(p, root, mask) {
            let cs = inducedConstraints(p, mask)
            match feasibleRational(cs, p.nvars, p.varIsInt) {
                Option.None => {
                    // Elimination overflowed: this branch is undecided, so the run can no
                    // longer conclude UNSAT. Fall through to Unknown rather than claim a
                    // proof we did not establish.
                    sawRationalOnly = true
                }
                Option.Some(feasible) => {
                    if feasible {
                        let w = findWitness(cs, p.nvars, witnessBound(p.nvars), 8000000)
                        if w.len > 0 {
                            return Verdict.Violated(w)
                        }
                        // With no integer variable in the system, Fourier-Motzkin is not a
                        // relaxation — it decides the reals exactly, so rational-feasible
                        // IS satisfiable and there is nothing left to be unsure about. The
                        // witness stays empty because elimination yields no vertex to read
                        // one off (the same gap that blocks branch-and-bound), so the
                        // caller reports that a counterexample exists without naming it.
                        if allReal(p.varIsInt, p.nvars) {
                            return Verdict.Violated(w)
                        }
                        sawRationalOnly = true
                    }
                }
            }
        }
        mask += 1
    }
    if sawRationalOnly {
        return Verdict.Unknown
    }
    return Verdict.Proven
}
