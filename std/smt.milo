// std/smt — a quantifier-free linear integer arithmetic (QF_LIA) decision
// procedure written in Milo itself. The fragment `milo prove` emits for
// contract discharge, decided without any external solver (no z3).
//
// Method: a boolean formula over linear atoms is decided by enumerating truth
// assignments of the atoms (2^k, k small for contracts); each satisfying
// assignment induces a conjunction of linear constraints whose feasibility
// over the rationals is settled by Fourier–Motzkin elimination. A bounded
// integer search reconstructs a concrete counterexample when one exists.
//
// Deliberately NOT z3: no bitvectors, no nonlinear arithmetic, no exact
// integer hull. When a system is feasible over the rationals but has no small
// integer witness, decide() honestly returns Unknown rather than guessing.

from "std/math" import {
    Math
}

// A row asserts  (sum coeffs[j]*x_j) + konst  <op>  0, strict picking < vs <=.
pub struct Constraint {
    coeffs: Vec<i64>,
    konst: i64,
    strict: bool,
}

// Node kinds in the flat formula tree: 0=atom, 1=not, 2=and, 3=or.
//
// varIsInt marks which variables range over the integers. It is not decoration: the two
// integer tightenings in reduceConstraint are UNSOUND for a real-valued variable, and
// applying them anyway is a false proof, not a lost one. `0 < x && x < 1` is satisfiable
// over the reals, but tightened as if x were an integer it becomes `x >= 1 && x <= 0`,
// the system goes infeasible, and every postcondition guarded by it reports `proven`.
pub struct SmtProblem {
    nvars: i64,
    varIsInt: Vec<bool>,
    atomCoeffs: Vec<Vec<i64>>,
    atomKonst: Vec<i64>,
    atomStrict: Vec<bool>,
    nodeKind: Vec<i64>,
    nodeAtom: Vec<i64>,
    nodeKids: Vec<Vec<i64>>,
}

pub enum Verdict {
    Proven,
    Violated(Vec<i64>),
    Unknown,
}

// Every variable an integer — the QF_LIA case this solver was written for.
pub fn newProblem(nvars: i64): SmtProblem {
    var flags: Vec<bool> = []
    var j: i64 = 0
    while j < nvars {
        flags.push(true)
        j += 1
    }
    return newProblemMixed(nvars, flags)
}

// varIsInt[j] = false marks x_j as ranging over the reals, which disables the integer
// tightenings for every row that mentions it. Feasibility, and therefore a `Proven`
// verdict, is decided over the rationals either way, so this only ever loses precision.
pub fn newProblemMixed(nvars: i64, varIsInt: Vec<bool>): SmtProblem {
    return SmtProblem {
        nvars: nvars,
        varIsInt: varIsInt,
        atomCoeffs: [],
        atomKonst: [],
        atomStrict: [],
        nodeKind: [],
        nodeAtom: [],
        nodeKids: [],
    }
}

// Does every variable this row actually constrains range over the integers? A zero
// coefficient contributes nothing, so a real variable the row does not mention cannot
// block the tightening.
// No integer variable anywhere in the problem, so nothing is a relaxation.
pub fn allReal(varIsInt: &Vec<bool>, nvars: i64): bool {
    if nvars < 1 {
        return false
    }
    var j: i64 = 0
    while j < varIsInt.len {
        if varIsInt[j] {
            return false
        }
        j += 1
    }
    return true
}

pub fn rowAllInt(coeffs: &Vec<i64>, varIsInt: &Vec<bool>): bool {
    var j: i64 = 0
    while j < coeffs.len {
        if coeffs[j] != 0 {
            if !varIsInt[j] {
                return false
            }
        }
        j += 1
    }
    return true
}

// Register an atom  row·x + konst <op> 0 ; returns its atom index.
pub fn addAtom(p: &mut SmtProblem, row: Vec<i64>, konst: i64, strict: bool): i64 {
    p.atomCoeffs.push(row)
    p.atomKonst.push(konst)
    p.atomStrict.push(strict)
    return p.atomKonst.len - 1
}

pub fn nAtom(p: &mut SmtProblem, atomIdx: i64): i64 {
    p.nodeKind.push(0)
    p.nodeAtom.push(atomIdx)
    let empty: Vec<i64> = []
    p.nodeKids.push(empty)
    return p.nodeKind.len - 1
}

pub fn nNot(p: &mut SmtProblem, kid: i64): i64 {
    p.nodeKind.push(1)
    p.nodeAtom.push(-1)
    var kids: Vec<i64> = []
    kids.push(kid)
    p.nodeKids.push(kids)
    return p.nodeKind.len - 1
}

pub fn nAnd(p: &mut SmtProblem, kids: Vec<i64>): i64 {
    p.nodeKind.push(2)
    p.nodeAtom.push(-1)
    p.nodeKids.push(kids)
    return p.nodeKind.len - 1
}

pub fn nOr(p: &mut SmtProblem, kids: Vec<i64>): i64 {
    p.nodeKind.push(3)
    p.nodeAtom.push(-1)
    p.nodeKids.push(kids)
    return p.nodeKind.len - 1
}

pub fn gcd2(a: i64, b: i64): i64 {
    var x = Math.absI64(a)
    var y = Math.absI64(b)
    while y != 0 {
        let t = x % y
        x = y
        y = t
    }
    return x
}

// ceil(a / b) for b > 0, on top of Milo's truncating division. Truncation already
// rounds toward zero, which IS the ceiling for a negative numerator; only a positive
// remainder needs the bump.
pub fn ceilDiv(a: i64, b: i64): i64 {
    let q = a / b
    if a % b > 0 {
        return q + 1
    }
    return q
}

// Put a row in INTEGER normal form. Two steps, both exact over the integers — the
// tightened row has the same integer solutions as the original, so this can only sharpen
// a verdict, never invent one.
//
//   1. Strictness goes away. `L < 0` on an integer L is `L + 1 <= 0`, so nothing
//      downstream has to carry a strict flag.
//   2. The constant is rounded IN. With g = gcd of the coefficients, `row·x` is always a
//      multiple of g, so `g*(b·x) <= -konst` is `b·x <= floor(-konst/g)` — a strictly
//      stronger bound than the rational one whenever g does not divide konst.
//
// Step 2 is the whole reason this exists. Fourier-Motzkin decides feasibility over the
// RATIONALS, so `2x = 3` looks satisfiable (x = 3/2) and the verdict came back `unknown —
// no integer witness`: the solver could neither refute it nor produce a counterexample an
// i64 could take. Rounding the bound in turns that same system into `x <= 1` and `x >= 2`,
// which Fourier-Motzkin then refutes with no notion of integrality at all.
//
// The old form divided coefficients AND konst by their common gcd, which is exact over the
// rationals and therefore threw this away: gcd(2, 3) is 1, so `2x - 3 <= 0` did not move.
//
// It also still does the job it was written for — dividing out the gcd bounds
// Fourier-Motzkin's coefficient growth, which is what keeps i64 from overflowing on the
// small systems contracts produce.
//
// Both steps assume every variable the row mentions is an integer, which is what `allInt`
// asserts. When it is false the row is only normalized in ways that hold over the reals:
// strictness is preserved, and the gcd is divided out only when it divides the constant
// exactly. See the SmtProblem comment for the false proof the guard prevents.
pub fn reduceConstraint(c: &Constraint, allInt: bool): Constraint {
    if !allInt {
        return reduceRational(c)
    }
    var konst = c.konst
    if c.strict {
        konst += 1
    }
    var g: i64 = 0
    var j: i64 = 0
    while j < c.coeffs.len {
        g = gcd2(g, c.coeffs[j])
        j += 1
    }
    // An all-zero row is a bare constant claim: there is no g to divide by, and the
    // feasibility check reads `konst` directly.
    if g < 1 {
        var zc: Vec<i64> = []
        j = 0
        while j < c.coeffs.len {
            zc.push(0)
            j += 1
        }
        return Constraint { coeffs: zc, konst: konst, strict: false }
    }
    var nc: Vec<i64> = []
    j = 0
    while j < c.coeffs.len {
        nc.push(c.coeffs[j] / g)
        j += 1
    }
    return Constraint { coeffs: nc, konst: ceilDiv(konst, g), strict: false }
}

// Normalize a row that mentions at least one real-valued variable. Dividing an inequality
// through by a positive constant is exact over the rationals, so the gcd division survives
// — but only when g divides konst too, since a fractional constant has nowhere to live in
// an i64 row. Strictness is carried, not folded away: `L < 0` says nothing about `L + 1`
// when L is real. When the gcd does not divide the constant the row is returned unchanged,
// which costs some of Fourier-Motzkin's coefficient-growth headroom and nothing else.
pub fn reduceRational(c: &Constraint): Constraint {
    var g: i64 = 0
    var j: i64 = 0
    while j < c.coeffs.len {
        g = gcd2(g, c.coeffs[j])
        j += 1
    }
    if g < 2 || c.konst % g != 0 {
        return Constraint { coeffs: cloneRow(c.coeffs), konst: c.konst, strict: c.strict }
    }
    var nc: Vec<i64> = []
    j = 0
    while j < c.coeffs.len {
        nc.push(c.coeffs[j] / g)
        j += 1
    }
    return Constraint { coeffs: nc, konst: c.konst / g, strict: c.strict }
}

pub fn cloneRow(row: &Vec<i64>): Vec<i64> {
    var out: Vec<i64> = []
    var j: i64 = 0
    while j < row.len {
        out.push(row[j])
        j += 1
    }
    return out
}

// b*p[j] + a*n[j], or None if any step overflows i64.
//
// This is the soundness seam. Fourier-Motzkin multiplies constants together, so a konst
// anywhere near 2^62 overflows on the first combine. Wrapping (the -O2 behaviour) flips
// the sign, the row becomes nonsense, the system looks infeasible, and `decide` reports
// UNSAT — i.e. **proven**. A false proof is the worst answer a prover can give, so an
// overflow must reach the caller as "cannot decide" and never as a verdict.
pub fn combineTerm(b: i64, pj: i64, a: i64, nj: i64): Option<i64> {
    let Option.Some(t1) = b.checkedMul(pj) else {
        return Option.None
    }
    let Option.Some(t2) = a.checkedMul(nj) else {
        return Option.None
    }
    return t1.checkedAdd(t2)
}

// Combine upper row p (coeff +a on x_k) with lower row n (coeff -b): b*p + a*n.
// None when the arithmetic overflows — see combineTerm.
pub fn combine(p: &Constraint, n: &Constraint, k: i64, varIsInt: &Vec<bool>): Option<Constraint> {
    let a = p.coeffs[k]
    let b = -n.coeffs[k]
    var nc: Vec<i64> = []
    var j: i64 = 0
    while j < p.coeffs.len {
        if j == k {
            nc.push(0)
        } else {
            let Option.Some(v) = combineTerm(b, p.coeffs[j], a, n.coeffs[j]) else {
                return Option.None
            }
            nc.push(v)
        }
        j += 1
    }
    let Option.Some(kon) = combineTerm(b, p.konst, a, n.konst) else {
        return Option.None
    }
    let c = Constraint { coeffs: nc, konst: kon, strict: p.strict || n.strict }
    return Option.Some(reduceConstraint(c, rowAllInt(c.coeffs, varIsInt)))
}

// None when any combine overflows — the caller must not read that as infeasible.
pub fn eliminateVar(cs: &Vec<Constraint>, k: i64, varIsInt: &Vec<bool>): Option<Vec<Constraint>> {
    var out: Vec<Constraint> = []
    var i: i64 = 0
    while i < cs.len {
        if cs[i].coeffs[k] == 0 {
            out.push(reduceConstraint(cs[i], rowAllInt(cs[i].coeffs, varIsInt)))
        }
        i += 1
    }
    var p: i64 = 0
    while p < cs.len {
        if cs[p].coeffs[k] > 0 {
            var n: i64 = 0
            while n < cs.len {
                if cs[n].coeffs[k] < 0 {
                    let Option.Some(c) = combine(cs[p], cs[n], k, varIsInt) else {
                        return Option.None
                    }
                    out.push(c)
                }
                n += 1
            }
        }
        p += 1
    }
    return Option.Some(out)
}

// Of rows with identical coefficients only the strongest matters (c.x + k <= 0 is stronger
// for a larger k; at equal k a strict row is stronger).
pub fn dropDominated(cs: &Vec<Constraint>): Vec<Constraint> {
    var out: Vec<Constraint> = []
    var i: i64 = 0
    while i < cs.len {
        var merged: bool = false
        var j: i64 = 0
        while j < out.len && !merged {
            var same: bool = true
            var c: i64 = 0
            while c < cs[i].coeffs.len && same {
                if cs[i].coeffs[c] != out[j].coeffs[c] {
                    same = false
                }
                c += 1
            }
            if same {
                merged = true
                if cs[i].konst > out[j].konst || (cs[i].konst == out[j].konst && cs[i].strict && !out[j].strict) {
                    out[j] = Constraint { coeffs: cloneRow(cs[i].coeffs), konst: cs[i].konst, strict: cs[i].strict }
                }
            }
            j += 1
        }
        if !merged {
            out.push(Constraint { coeffs: cloneRow(cs[i].coeffs), konst: cs[i].konst, strict: cs[i].strict })
        }
        i += 1
    }
    return out
}

// Feasible over the rationals? Eliminate every variable; a surviving constant
// row that is violated proves the system UNSAT.
// None = the elimination overflowed, so feasibility is undecided here. Returning `false`
// (infeasible) in that case is what produced false proofs.
pub fn feasibleRational(cs0: &Vec<Constraint>, nvars: i64, varIsInt: &Vec<bool>): Option<bool> {
    var cs: Vec<Constraint> = []
    var i0: i64 = 0
    while i0 < cs0.len {
        cs.push(reduceConstraint(cs0[i0], rowAllInt(cs0[i0].coeffs, varIsInt)))
        i0 += 1
    }
    cs = dropDominated(cs)
    var done: Vec<bool> = []
    var d: i64 = 0
    while d < nvars {
        done.push(false)
        d += 1
    }
    var round: i64 = 0
    while round < nvars {
        // Eliminate the variable whose elimination adds the fewest rows (pos * neg): the
        // order is what separates a handful of rows from a blow-up.
        var best: i64 = -1
        var bestCost: i64 = 0
        var k: i64 = 0
        while k < nvars {
            if !done[k] {
                var pos: i64 = 0
                var neg: i64 = 0
                var r: i64 = 0
                while r < cs.len {
                    if cs[r].coeffs[k] > 0 {
                        pos += 1
                    }
                    if cs[r].coeffs[k] < 0 {
                        neg += 1
                    }
                    r += 1
                }
                let cost = pos * neg
                if best < 0 || cost < bestCost {
                    best = k
                    bestCost = cost
                }
            }
            k += 1
        }
        done[best] = true
        let Option.Some(next) = eliminateVar(cs, best, varIsInt) else {
            return Option.None
        }
        cs = dropDominated(next)
        // Too many rows: undecided, never a verdict.
        if cs.len > 400 {
            return Option.None
        }
        round += 1
    }
    var i: i64 = 0
    while i < cs.len {
        let kon = cs[i].konst
        if cs[i].strict {
            if kon >= 0 {
                return Option.Some(false)
            }
        } else {
            if kon > 0 {
                return Option.Some(false)
            }
        }
        i += 1
    }
    return Option.Some(true)
}

pub fn satisfiesAll(cs: &Vec<Constraint>, x: &Vec<i64>): bool {
    var i: i64 = 0
    while i < cs.len {
        var s: i64 = cs[i].konst
        var j: i64 = 0
        while j < cs[i].coeffs.len {
            s = s + cs[i].coeffs[j] * x[j]
            j += 1
        }
        if cs[i].strict {
            if s >= 0 {
                return false
            }
        } else {
            if s > 0 {
                return false
            }
        }
        i += 1
    }
    return true
}

// Map an odometer step 0,1,2,3,4,... to values 0,-1,1,-2,2,... so the search
// fans out from the origin and returns small-magnitude witnesses (a clean
// counterexample like x=-1, not the box corner x=-700).
pub fn zigzag(step: i64): i64 {
    if step % 2 == 0 {
        return step / 2
    }
    return -((step + 1) / 2)
}

// Odometer search for a concrete integer witness, each coordinate ranging over
// zigzag steps [0, 2*bound] so nearer-zero points are tried first. Capped at
// maxIters so a high-dimensional box can't blow up. Empty result = none found.
pub fn findWitness(cs: &Vec<Constraint>, nvars: i64, bound: i64, maxIters: i64): Vec<i64> {
    let span = 2 * bound + 1
    var step: Vec<i64> = []
    var x: Vec<i64> = []
    var j: i64 = 0
    while j < nvars {
        step.push(0)
        x.push(0)
        j += 1
    }
    var iters: i64 = 0
    var done: bool = false
    while !done && iters < maxIters {
        var c: i64 = 0
        while c < nvars {
            x[c] = zigzag(step[c])
            c += 1
        }
        if satisfiesAll(cs, x) {
            return x
        }
        iters += 1
        var idx: i64 = 0
        while idx < nvars {
            step[idx] += 1
            if step[idx] < span {
                break
            }
            step[idx] = 0
            idx += 1
        }
        if idx == nvars {
            done = true
        }
    }
    let empty: Vec<i64> = []
    return empty
}

// Per-variable box radius so the total search (2b+1)^nvars stays near a few
// million points — wide in low dimensions, tight in high ones.
pub fn witnessBound(nvars: i64): i64 {
    if nvars <= 1 {
        return 1000000
    }
    if nvars == 2 {
        return 700
    }
    if nvars == 3 {
        return 60
    }
    if nvars == 4 {
        return 20
    }
    if nvars == 5 {
        return 9
    }
    return 5
}

// Decide SAT of the formula rooted at `root`. In a proof obligation the root is
// (assumptions ∧ body-paths ∧ ¬goal), so:
//   Proven      = UNSAT (no assignment yields a feasible conjunction)
//   Violated(w) = SAT with a concrete integer counterexample w
//   Unknown     = rational-feasible but no integer witness in the search box
//                 (the QF_LIA integer gap this Tier-1 core doesn't close)
//
// The witness search enumerates integer points even for a real-valued variable. That is
// sound in the direction it matters — an integer point is a real point, so a witness it
// finds is a genuine counterexample — but incomplete: `0 < x && x < 1` is satisfiable over
// the reals with no integer point at all, so the verdict is Unknown rather than Violated.
pub fn verdictName(v: &Verdict): string {
    match v {
        Verdict.Proven => {
            return "proven"
        }
        Verdict.Violated(_) => {
            return "violated"
        }
        Verdict.Unknown => {
            return "unknown"
        }
    }
}

pub fn floorP(n: i64, d: i64): i64 {
    let q = n / d
    if n % d < 0 {
        return q - 1
    }
    return q
}

pub fn ceilP(n: i64, d: i64): i64 {
    return -floorP(-n, d)
}

// An integer point of the system by Fourier-Motzkin back-substitution: eliminate the variables
// in the same cheapest-first order as feasibleRational while keeping each stage, then assign
// them in reverse, each within the bounds the rows of its stage leave once the later variables
// are fixed (the value nearest zero). Reaches witnesses far outside findWitness's small box
// (a raw sensor value of 32768). Empty when rounding leaves a variable no integer; the caller
// re-checks the point against the original rows, so a wrong answer here cannot become a verdict.
pub fn fmWitness(cs0: &Vec<Constraint>, nvars: i64, varIsInt: &Vec<bool>): Vec<i64> {
    let empty: Vec<i64> = []
    var cs: Vec<Constraint> = []
    var i0: i64 = 0
    while i0 < cs0.len {
        cs.push(reduceConstraint(cs0[i0], rowAllInt(cs0[i0].coeffs, varIsInt)))
        i0 += 1
    }
    cs = dropDominated(cs)
    var stages: Vec<Vec<Constraint>> = []
    var order: Vec<i64> = []
    var done: Vec<bool> = []
    var d: i64 = 0
    while d < nvars {
        done.push(false)
        d += 1
    }
    var round: i64 = 0
    while round < nvars {
        var best: i64 = -1
        var bestCost: i64 = 0
        var k: i64 = 0
        while k < nvars {
            if !done[k] {
                var pos: i64 = 0
                var neg: i64 = 0
                var r: i64 = 0
                while r < cs.len {
                    if cs[r].coeffs[k] > 0 {
                        pos += 1
                    }
                    if cs[r].coeffs[k] < 0 {
                        neg += 1
                    }
                    r += 1
                }
                if best < 0 || pos * neg < bestCost {
                    best = k
                    bestCost = pos * neg
                }
            }
            k += 1
        }
        done[best] = true
        stages.push(dropDominated(cs))
        order.push(best)
        let Option.Some(next) = eliminateVar(cs, best, varIsInt) else {
            return empty
        }
        cs = dropDominated(next)
        if cs.len > 400 {
            return empty
        }
        round += 1
    }
    var x: Vec<i64> = []
    var z: i64 = 0
    while z < nvars {
        x.push(0)
        z += 1
    }
    var idx: i64 = order.len - 1
    while idx >= 0 {
        let v = order[idx]
        var lo: i64 = -4611686018427387904
        var hi: i64 = 4611686018427387904
        var r: i64 = 0
        while r < stages[idx].len {
            let c = stages[idx][r]
            let a = c.coeffs[v]
            if a != 0 {
                var rest: i64 = c.konst
                var j: i64 = 0
                while j < nvars {
                    if j != v {
                        rest = rest + c.coeffs[j] * x[j]
                    }
                    j += 1
                }
                if a > 0 {
                    // a*v + rest <= 0 (or < 0): v <= -rest/a
                    var ub: i64 = floorP(-rest, a)
                    if c.strict {
                        ub = ceilP(-rest, a) - 1
                    }
                    if ub < hi {
                        hi = ub
                    }
                } else {
                    // a*v + rest <= 0 with a < 0: v >= rest/(-a)
                    var lb: i64 = ceilP(rest, -a)
                    if c.strict {
                        lb = floorP(rest, -a) + 1
                    }
                    if lb > lo {
                        lo = lb
                    }
                }
            }
            r += 1
        }
        if lo > hi {
            return empty
        }
        if lo <= 0 && 0 <= hi {
            x[v] = 0
        } else if lo > 0 {
            x[v] = lo
        } else {
            x[v] = hi
        }
        idx -= 1
    }
    return x
}

// Three-valued evaluation under a partial assignment: asg[a] is 0 (not chosen yet), 1 (atom
// true) or 2 (atom false). Returns 0 (formula false whatever the rest is), 1 (formula true
// whatever the rest is) or 2 (undecided). Pruning on 0 and stopping early on 1 is what keeps
// the search far below 2^atoms: most obligations are decided by a handful of atoms.
pub fn evalNode3(p: &SmtProblem, node: i64, asg: &Vec<i64>): i64 {
    let kind = p.nodeKind[node]
    if kind == 0 {
        let v = asg[p.nodeAtom[node]]
        if v == 0 {
            return 2
        }
        if v == 2 {
            return 0
        }
        return 1
    }
    if kind == 1 {
        let k = evalNode3(p, p.nodeKids[node][0], asg)
        if k == 2 {
            return 2
        }
        return 1 - k
    }
    // and: any false kid is false, all true is true. or: dually.
    var sawUnknown: bool = false
    var i: i64 = 0
    while i < p.nodeKids[node].len {
        let k = evalNode3(p, p.nodeKids[node][i], asg)
        if kind == 2 && k == 0 {
            return 0
        }
        if kind == 3 && k == 1 {
            return 1
        }
        if k == 2 {
            sawUnknown = true
        }
        i += 1
    }
    if sawUnknown {
        return 2
    }
    if kind == 2 {
        return 1
    }
    return 0
}

// The conjunction the chosen atoms induce: atom i as-is when true, negated when false.
pub fn inducedConstraints(p: &SmtProblem, asg: &Vec<i64>): Vec<Constraint> {
    var cs: Vec<Constraint> = []
    var a: i64 = 0
    while a < p.atomKonst.len {
        if asg[a] != 0 {
            let row = cloneRow(p.atomCoeffs[a])
            if asg[a] == 1 {
                cs.push(Constraint { coeffs: row, konst: p.atomKonst[a], strict: p.atomStrict[a] })
            } else {
                // ¬(L <= 0) is (-L < 0); ¬(L < 0) is (-L <= 0)
                var nr: Vec<i64> = []
                var j: i64 = 0
                while j < row.len {
                    nr.push(-row[j])
                    j += 1
                }
                cs.push(Constraint { coeffs: nr, konst: -p.atomKonst[a], strict:!p.atomStrict[a] })
            }
        }
        a += 1
    }
    return cs
}

// Force every atom the current assignment implies (unit propagation). A node that must come out
// `want` is conjunctive (and/true, or/false): every kid must too. Disjunctive (or/true,
// and/false): if no kid is satisfied yet and exactly one could still be, that one is forced.
// Returns true when it assigned something.
pub fn propagate(p: &SmtProblem, node: i64, want: bool, asg: &mut Vec<i64>): bool {
    let kind = p.nodeKind[node]
    if kind == 0 {
        let a = p.nodeAtom[node]
        if asg[a] != 0 {
            return false
        }
        if want {
            asg[a] = 1
        } else {
            asg[a] = 2
        }
        return true
    }
    if kind == 1 {
        return propagate(p, p.nodeKids[node][0], !want, &mut asg)
    }
    let conj = (kind == 2) == want
    var changed: bool = false
    if conj {
        var i: i64 = 0
        while i < p.nodeKids[node].len {
            if propagate(p, p.nodeKids[node][i], want, &mut asg) {
                changed = true
            }
            i += 1
        }
        return changed
    }
    // evalNode3 is 1 for true, 0 for false: the value that satisfies this disjunct.
    var satisfying: i64 = 0
    if !want {
        satisfying = 0
    } else {
        satisfying = 1
    }
    var open: i64 = 0
    var only: i64 = -1
    var i: i64 = 0
    while i < p.nodeKids[node].len {
        let k = evalNode3(p, p.nodeKids[node][i], asg)
        if k == satisfying {
            return false
        }
        if k == 2 {
            open += 1
            only = p.nodeKids[node][i]
        }
        i += 1
    }
    if open == 1 {
        return propagate(p, only, want, &mut asg)
    }
    return false
}

// Search state shared down the recursion (a struct, so the budgets survive returns).
pub struct Search {
    sawRationalOnly: bool,
    failedSearches: i64,
    work: i64,
    witness: Vec<i64>,
    found: bool,
    gaveUp: bool,
}

// Largest number of Fourier-Motzkin runs one problem may spend before it is Unknown.
pub let MAX_WORK: i64 = 3000

// Depth-first over the atoms in index order, each level starting from its parent's assignment
// plus whatever propagation forces. A partial assignment whose induced constraints are
// infeasible over the rationals is pruned: no completion can be feasible. When the formula is
// already true under the partial assignment the remaining atoms are irrelevant and the induced
// constraints of the chosen ones are the whole system to test.
pub fn dfs(p: &SmtProblem, root: i64, asg0: &Vec<i64>, st: &mut Search): void {
    if st.found || st.gaveUp {
        return
    }
    var asg: Vec<i64> = []
    var c: i64 = 0
    while c < asg0.len {
        asg.push(asg0[c])
        c += 1
    }
    var rounds: i64 = 0
    while rounds < 64 && propagate(p, root, true, &mut asg) {
        rounds += 1
    }
    let v = evalNode3(p, root, asg)
    if v == 0 {
        return
    }
    st.work += 1
    if st.work > MAX_WORK {
        st.gaveUp = true
        return
    }
    let cs = inducedConstraints(p, asg)
    match feasibleRational(cs, p.nvars, p.varIsInt) {
        Option.None => {
            // Elimination overflowed: undecided, so no pruning and no proof from this branch.
            st.sawRationalOnly = true
        }
        Option.Some(feasible) => {
            if !feasible {
                return
            }
            if v == 1 {
                var w = findWitness(cs, p.nvars, witnessBound(p.nvars), 200000)
                if w.len == 0 {
                    let w2 = fmWitness(cs, p.nvars, p.varIsInt)
                    if w2.len > 0 && satisfiesAll(cs, w2) {
                        w = w2
                    }
                }
                if w.len > 0 {
                    st.witness = w
                    st.found = true
                    return
                }
                // With no integer variable in the system, Fourier-Motzkin is not a
                // relaxation: it decides the reals exactly, so rational-feasible IS
                // satisfiable. No vertex is read off, so the witness stays empty and the
                // caller reports that a counterexample exists without naming it.
                if allReal(p.varIsInt, p.nvars) {
                    st.found = true
                    return
                }
                st.sawRationalOnly = true
                // Each failed search walks up to 8M points; past a few the answer is
                // Unknown for all practical purposes.
                st.failedSearches += 1
                if st.failedSearches >= 3 {
                    st.gaveUp = true
                }
                return
            }
        }
    }
    var a: i64 = 0
    while a < p.atomKonst.len && asg[a] != 0 {
        a += 1
    }
    if a == p.atomKonst.len {
        return
    }
    asg[a] = 1
    dfs(p, root, asg, &mut st)
    asg[a] = 2
    dfs(p, root, asg, &mut st)
}

pub fn decide(p: &SmtProblem, root: i64): Verdict {
    var asg: Vec<i64> = []
    var a: i64 = 0
    while a < p.atomKonst.len {
        asg.push(0)
        a += 1
    }
    let none: Vec<i64> = []
    var st = Search { sawRationalOnly: false, failedSearches: 0, work: 0, witness: none, found: false, gaveUp: false }
    dfs(p, root, asg, &mut st)
    if st.found {
        return Verdict.Violated(st.witness)
    }
    if st.gaveUp || st.sawRationalOnly {
        return Verdict.Unknown
    }
    return Verdict.Proven
}
