// std/vec: Vec method bodies written in Milo (docs/collections-in-std.md).
//
// Vec stays a builtin type: the checker owns its type rules, and codegen still owns the
// layout ({ptr, len, cap}), literals, indexing, slicing, len, for-in, drop and display.
// Every method here takes `self: &Self` unless it must change the Vec, so a slice
// (`&[T]`, the same layout) may call it too.
//
// The methods that change a Vec reach its header through VecRaw, which mirrors codegen's
// %Vec layout field for field. Elements move with raw-pointer reads and writes: `*p` is a
// bitwise move out, `*p = x` a store that drops nothing, so no element is copied or
// dropped twice. A bounds panic goes through _vecPanic for the builtins' wording, and
// @trackCaller makes every panic name the caller's line.

// Declared here, as std/string does, so the prelude's Vec pulls in no other module.
extern fn memmove(dst: *u8, src: *u8, n: i64): *u8

struct VecRaw<T> {
    _data: *T,
    _len: i64,
    _cap: i64,
}

// Exchanges the values at `a` and `b` (which may be the same slot) without copying or
// dropping either.
fn vecSwapAt<T>(a: *T, b: *T) {
    unsafe {
        var pa = a
        var pb = b
        let t = *pa
        * pa = *pb
        * pb = t
    }
}

// Moves the value at `p` out and drops it, leaving the bytes behind as dead storage.
fn vecDropAt<T>(p: *T) {
    unsafe {
        let _gone = *p
    }
}

impl Vec<T> {
    // Whether the Vec has no elements.
    fn isEmpty(self: &Self): bool {
        return self.len() == 0
    }

    // A copy of the first element, or None when the Vec is empty.
    fn first(self: &Self): Option<T> {
        return self.get(0)
    }

    // A copy of the last element, or None when the Vec is empty.
    fn last(self: &Self): Option<T> {
        // len is never negative, so this cannot wrap; an empty Vec asks get for -1,
        // which get answers with None.
        return self.get(self.len().wrappingSub(1))
    }

    // Whether some element equals `x`. The checker limits this to int, float, string and
    // bool elements; `==` is the language's: a string by content, a float by IEEE
    // equality (NaN equals nothing, -0.0 equals 0.0).
    fn contains(self: &Self, x: &T): bool {
        for e in self {
            if e == x {
                return true
            }
        }
        return false
    }

    // The index of the first element equal to `x`, or None. Same element types and the
    // same `==` as contains. The variants are qualified: a user fn named `Some` shadows
    // the bare alias program-wide (fixture preludeVariantsShadowed).
    fn indexOf(self: &Self, x: &T): Option<i64> {
        var i = 0
        for e in self {
            if e == x {
                return Option.Some(i)
            }
            // i < len, so it cannot overflow; wrapping keeps the check out of the loop.
            i = i.wrappingAdd(1)
        }
        return Option.None
    }

    // A copy of the smallest element, or None when empty. The checker limits this to int,
    // float, string and bool elements; the order is _natLess, the builtin's: false < true,
    // and a float NaN is never less than anything, so a NaN in front stays the answer.
    // The first of equal elements wins.
    fn min(self: &Self): Option<T> {
        if self.len() == 0 {
            return Option.None
        }
        var best = 0
        var i = 0
        for e in self {
            if _natLess(e, self[best]) {
                best = i
            }
            i = i.wrappingAdd(1)
        }
        return self.get(best)
    }

    // A copy of the largest element, or None when empty; the mirror of min.
    fn max(self: &Self): Option<T> {
        if self.len() == 0 {
            return Option.None
        }
        var best = 0
        var i = 0
        for e in self {
            if _natLess(self[best], e) {
                best = i
            }
            i = i.wrappingAdd(1)
        }
        return self.get(best)
    }

    // The sum of the elements (0 for an empty Vec). The checker limits this to int and
    // float elements. Integer addition is checked: an overflow panics, and @trackCaller
    // makes the panic name the caller's line. Inside a @wrapping function the checker
    // calls wrappingSum instead, as the builtin wrapped there.
    @trackCaller
    fn sum(self: &Self): T {
        var acc = 0 as T
        for e in self {
            acc = acc + e
        }
        return acc
    }

    // The sum of an integer Vec with two's-complement wrapping on overflow, never a panic.
    fn wrappingSum(self: &Self): T {
        var acc = 0 as T
        for e in self {
            acc = acc.wrappingAdd(e)
        }
        return acc
    }

    // The callback methods below lend `f` each element in turn. The checker holds the
    // receiver borrowed while the callback is checked, so `f` may read the Vec but not
    // change it, and a Copy element may be taken by value (`(x: i64) => ...`). They are
    // @inline so the closure, known at each call site, can be inlined into the loop as
    // the builtins' was; called, they measured about 3% slower.

    // Calls `f` on every element, first to last.
    @inline
    fn each(self: &Self, f: (&T) => void) {
        for e in self {
            f(e)
        }
    }

    // Calls `f` with each element and its index.
    @inline
    fn enumerate(self: &Self, f: (i64, &T) => void) {
        var i = 0
        for e in self {
            f(i, e)
            i = i.wrappingAdd(1)
        }
    }

    // Whether `f` holds for some element; stops at the first that it does.
    @inline
    fn any(self: &Self, f: (&T) => bool): bool {
        for e in self {
            if f(e) {
                return true
            }
        }
        return false
    }

    // Whether `f` holds for every element (true for an empty Vec); stops at the first
    // that it does not.
    @inline
    fn all(self: &Self, f: (&T) => bool): bool {
        for e in self {
            if !f(e) {
                return false
            }
        }
        return true
    }

    // The index of the first element `f` holds for, or None.
    @inline
    fn position(self: &Self, f: (&T) => bool): Option<i64> {
        var i = 0
        for e in self {
            if f(e) {
                return Option.Some(i)
            }
            i = i.wrappingAdd(1)
        }
        return Option.None
    }

    // A copy of the first element `f` holds for, or None.
    @inline
    fn find(self: &Self, f: (&T) => bool): Option<T> {
        var i = 0
        for e in self {
            if f(e) {
                return self.get(i)
            }
            i = i.wrappingAdd(1)
        }
        return Option.None
    }

    // Threads an accumulator through the elements: `f(f(f(init, v[0]), v[1]), ...)`.
    @inline
    fn fold<A>(self: &Self, init: A, f: (A, &T) => A): A {
        var acc = init
        for e in self {
            acc = f(acc, e)
        }
        return acc
    }

    // The same as fold, under the name most readers type first.
    fn reduce<A>(self: &Self, init: A, f: (A, &T) => A): A {
        return self.fold(init, f)
    }

    // Exchanges the elements at `a` and `b`. Both indexes are bounds-checked, `a` first,
    // with the indexing panic.
    @inline
    @trackCaller
    fn swap(self: &mut Self, a: i64, b: i64) {
        unsafe {
            let pa = self[a].addrOf()
            let pb = self[b].addrOf()
            vecSwapAt(pa, pb)
        }
    }

    // Reverses the order of the elements in place.
    fn reverse(self: &mut Self) {
        unsafe {
            let data = self.ptr()
            var lo = 0
            var hi = self.len().wrappingSub(1)
            while lo < hi {
                vecSwapAt(data[lo].addrOf(), data[hi].addrOf())
                lo = lo.wrappingAdd(1)
                hi = hi.wrappingSub(1)
            }
        }
    }

    // Drops every element at index `n` and above, first to last, then shortens the Vec.
    // A negative `n` empties it; an `n` at or past the length changes nothing (it never
    // grows the Vec).
    fn truncate(self: &mut Self, n: i64) {
        unsafe {
            var raw = (self.addrOf() as *u8) as *VecRaw<T>
            let len = raw[0]._len
            var keep = n
            if keep < 0 {
                keep = 0
            }
            if keep >= len {
                return
            }
            let data = raw[0]._data
            var i = keep
            while i < len {
                vecDropAt(data[i].addrOf())
                i = i.wrappingAdd(1)
            }
            raw[0]._len = keep
        }
    }

    // Drops every element, first to last; the capacity is kept.
    fn clear(self: &mut Self) {
        self.truncate(0)
    }

    // Takes the last element out, or None when the Vec is empty. The value moves out of
    // its slot; nothing is copied.
    fn pop(self: &mut Self): Option<T> {
        unsafe {
            var raw = (self.addrOf() as *u8) as *VecRaw<T>
            let len = raw[0]._len
            if len == 0 {
                return Option.None
            }
            let last = len.wrappingSub(1)
            raw[0]._len = last
            let data = raw[0]._data
            return Option.Some(*data[last].addrOf())
        }
    }

    // Takes the element at `i` out and shifts the rest down by one. An index outside
    // 0..len panics with the builtin's "remove index out of bounds".
    @trackCaller
    fn remove(self: &mut Self, i: i64): T {
        unsafe {
            var raw = (self.addrOf() as *u8) as *VecRaw<T>
            let len = raw[0]._len
            // Unsigned, so a negative index is out of range too, in one compare.
            if (i as u64) >= (len as u64) {
                _vecPanic("remove index out of bounds")
            }
            let data = raw[0]._data
            let out = *data[i].addrOf()
            let next = i.wrappingAdd(1)
            memmove(data[i].addrOf() as *u8, data[next].addrOf() as *u8, len.wrappingSub(next).wrappingMul(sizeOf<T>()))
            raw[0]._len = len.wrappingSub(1)
            return out
        }
    }

    // Keeps the elements `f` holds for, in order, and drops the others where they sit,
    // first to last: one pass, no second buffer. `f` sees each element in place; the
    // length is stored once, after the pass. @inline for the same reason as the
    // read-only callback methods.
    @inline
    fn retain(self: &mut Self, f: (&T) => bool) {
        unsafe {
            var raw = (self.addrOf() as *u8) as *VecRaw<T>
            let len = raw[0]._len
            var data = raw[0]._data
            var kept = 0
            var i = 0
            while i < len {
                if f(data[i]) {
                    data[kept] = *data[i].addrOf()
                    kept = kept.wrappingAdd(1)
                } else {
                    vecDropAt(data[i].addrOf())
                }
                i = i.wrappingAdd(1)
            }
            raw[0]._len = kept
        }
    }
}
