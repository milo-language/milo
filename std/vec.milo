// std/vec: Vec method bodies written in Milo (docs/collections-in-std.md).
//
// Vec stays a builtin type: the checker owns its type rules, and codegen still owns the
// layout ({ptr, len, cap}), literals, indexing, slicing, len, for-in, drop and display.
// Every method here takes `self: &Self` unless it must change the Vec, so a slice
// (`&[T]`, the same layout) may call it too.
//
// The methods that change a Vec's length write its header through VecHead, which mirrors
// codegen's %Vec layout field for field; they reach the elements through `ptr()`, typed.
// Elements move with raw-pointer reads and writes: `*p` is a bitwise move out, `*p = x` a
// store that drops nothing, so no element is copied or dropped twice. A bounds panic goes
// through _vecPanic for the builtins' wording, and @trackCaller makes every panic name the
// caller's line. Every method that changes a Vec is @inline: called, it takes the Vec's
// address, and a header whose address escapes stays in memory, so a loop that pushes and
// also clears or pops could no longer keep len and cap in registers (a push/clear loop
// measured 20% slower with clear called).

// Declared here, as std/string does, so the prelude's Vec pulls in no other module.
extern fn memmove(dst: *u8, src: *u8, n: i64): *u8

extern fn memcpy(dst: *u8, src: *u8, n: i64): *u8

// Not generic: the header's layout does not depend on the element, and an instantiation
// per element type would need a struct name for every T (`[i64; 2]` has none that LLVM
// accepts).
struct VecHead {
    _data: *u8,
    _len: i64,
    _cap: i64,
}

// Exchanges the values at `a` and `b` (which may be the same slot) without copying or
// dropping either.
fn vecSwapAt<T>(a: *T, b: *T) {
    unsafe {
        var pa = a
        var pb = b
        let t = *pa
        * pa = *pb
        * pb = t
    }
}

// Moves the value at `p` out and drops it, leaving the bytes behind as dead storage.
fn vecDropAt<T>(p: *T) {
    unsafe {
        let _gone = *p
    }
}

// Makes room for `need` elements in all: nothing when the capacity already suffices,
// else the doubled capacity, or exactly `need` when doubling falls short (so repeated
// extends stay amortized). The buffer moves through _vecGrowBuf, whose size and null
// checks panic at the caller's line under @trackCaller.
@inline
@trackCaller
fn vecReserveTotal<T>(v: &mut Vec<T>, need: i64) {
    unsafe {
        var raw = (v.addrOf() as *u8) as *VecHead
        let cap = raw[0]._cap
        if (cap as u64) >= (need as u64) {
            return
        }
        var newCap = need
        let doubled = cap.wrappingMul(2)
        if (doubled as u64) > (need as u64) {
            newCap = doubled
        }
        raw[0]._data = _vecGrowBuf(v.ptr(), raw[0]._len, newCap) as *u8
        raw[0]._cap = newCap
    }
}

// Grows a full Vec (len == cap) for one more element, as push always has: the first
// buffer is sized near 64 bytes (8 elements of up to 8 bytes, fewer of larger ones, at
// least one), then the capacity doubles.
@inline
@trackCaller
fn vecGrowOne<T>(v: &mut Vec<T>, len: i64, cap: i64) {
    unsafe {
        var raw = (v.addrOf() as *u8) as *VecHead
        var newCap = cap.wrappingMul(2)
        if cap == 0 {
            let size = sizeOf<T>()
            newCap = 8
            if size > 8 {
                newCap = 64 / size
                if newCap < 1 {
                    newCap = 1
                }
            }
        }
        raw[0]._data = _vecGrowBuf(v.ptr(), len, newCap) as *u8
        raw[0]._cap = newCap
    }
}

// `Vec.withCapacity(n)`: an empty Vec with room for `n`. The checker infers T from the
// context and lowers the call here; the caller has already refused a negative `n`, at its
// own line. The buffer comes from _vecGrowBuf over nothing (a null buffer, no elements
// kept), so it is the same checked allocation, and zeroed gives len 0.
@inline
@trackCaller
fn vecWithCapacity<T>(n: i64): Vec<T> {
    unsafe {
        var v = zeroed<Vec<T>>()
        var raw = (v.addrOf() as *u8) as *VecHead
        raw[0]._data = _vecGrowBuf(0 as *T, 0, n) as *u8
        raw[0]._cap = n
        return v
    }
}

// `Vec.filled(n, x)`: `n` copies of `x`, with exactly `n` slots. The checker allows a Copy
// element only, so the slots share nothing; it has refused a negative `n` at the caller.
@inline
@trackCaller
fn vecFilled<T>(n: i64, x: T): Vec<T> {
    var v: Vec<T> = vecWithCapacity(n)
    unsafe {
        var data = v.ptr()
        var i = 0
        while i < n {
            data[i] = x
            i = i.wrappingAdd(1)
        }
        var raw = (v.addrOf() as *u8) as *VecHead
        raw[0]._len = n
    }
    return v
}

impl Vec<T> {
    // Whether the Vec has no elements.
    fn isEmpty(self: &Self): bool {
        return self.len() == 0
    }

    // A copy of the first element, or None when the Vec is empty.
    fn first(self: &Self): Option<T> {
        return self.get(0)
    }

    // A copy of the last element, or None when the Vec is empty.
    fn last(self: &Self): Option<T> {
        // len is never negative, so this cannot wrap; an empty Vec asks get for -1,
        // which get answers with None.
        return self.get(self.len().wrappingSub(1))
    }

    // Whether some element equals `x`. The checker limits this to int, float, string and
    // bool elements; `==` is the language's: a string by content, a float by IEEE
    // equality (NaN equals nothing, -0.0 equals 0.0).
    fn contains(self: &Self, x: &T): bool {
        for e in self {
            if e == x {
                return true
            }
        }
        return false
    }

    // The index of the first element equal to `x`, or None. Same element types and the
    // same `==` as contains. The variants are qualified: a user fn named `Some` shadows
    // the bare alias program-wide (fixture preludeVariantsShadowed).
    fn indexOf(self: &Self, x: &T): Option<i64> {
        var i = 0
        for e in self {
            if e == x {
                return Option.Some(i)
            }
            // i < len, so it cannot overflow; wrapping keeps the check out of the loop.
            i = i.wrappingAdd(1)
        }
        return Option.None
    }

    // A copy of the smallest element, or None when empty. The checker limits this to int,
    // float, string and bool elements; the order is _natLess, the builtin's: false < true,
    // and a float NaN is never less than anything, so a NaN in front stays the answer.
    // The first of equal elements wins.
    fn min(self: &Self): Option<T> {
        if self.len() == 0 {
            return Option.None
        }
        var best = 0
        var i = 0
        for e in self {
            if _natLess(e, self[best]) {
                best = i
            }
            i = i.wrappingAdd(1)
        }
        return self.get(best)
    }

    // A copy of the largest element, or None when empty; the mirror of min.
    fn max(self: &Self): Option<T> {
        if self.len() == 0 {
            return Option.None
        }
        var best = 0
        var i = 0
        for e in self {
            if _natLess(self[best], e) {
                best = i
            }
            i = i.wrappingAdd(1)
        }
        return self.get(best)
    }

    // The sum of the elements (0 for an empty Vec). The checker limits this to int and
    // float elements. Integer addition is checked: an overflow panics, and @trackCaller
    // makes the panic name the caller's line. Inside a @wrapping function the checker
    // calls wrappingSum instead, as the builtin wrapped there.
    @trackCaller
    fn sum(self: &Self): T {
        var acc = 0 as T
        for e in self {
            acc = acc + e
        }
        return acc
    }

    // The sum of an integer Vec with two's-complement wrapping on overflow, never a panic.
    fn wrappingSum(self: &Self): T {
        var acc = 0 as T
        for e in self {
            acc = acc.wrappingAdd(e)
        }
        return acc
    }

    // The callback methods below lend `f` each element in turn. The checker holds the
    // receiver borrowed while the callback is checked, so `f` may read the Vec but not
    // change it, and a Copy element may be taken by value (`(x: i64) => ...`). They are
    // @inline so the closure, known at each call site, can be inlined into the loop as
    // the builtins' was; called, they measured about 3% slower.

    // Calls `f` on every element, first to last.
    @inline
    fn each(self: &Self, f: (&T) => void) {
        for e in self {
            f(e)
        }
    }

    // Calls `f` with each element and its index.
    @inline
    fn enumerate(self: &Self, f: (i64, &T) => void) {
        var i = 0
        for e in self {
            f(i, e)
            i = i.wrappingAdd(1)
        }
    }

    // Whether `f` holds for some element; stops at the first that it does.
    @inline
    fn any(self: &Self, f: (&T) => bool): bool {
        for e in self {
            if f(e) {
                return true
            }
        }
        return false
    }

    // Whether `f` holds for every element (true for an empty Vec); stops at the first
    // that it does not.
    @inline
    fn all(self: &Self, f: (&T) => bool): bool {
        for e in self {
            if !f(e) {
                return false
            }
        }
        return true
    }

    // The index of the first element `f` holds for, or None.
    @inline
    fn position(self: &Self, f: (&T) => bool): Option<i64> {
        var i = 0
        for e in self {
            if f(e) {
                return Option.Some(i)
            }
            i = i.wrappingAdd(1)
        }
        return Option.None
    }

    // A copy of the first element `f` holds for, or None.
    @inline
    fn find(self: &Self, f: (&T) => bool): Option<T> {
        var i = 0
        for e in self {
            if f(e) {
                return self.get(i)
            }
            i = i.wrappingAdd(1)
        }
        return Option.None
    }

    // Threads an accumulator through the elements: `f(f(f(init, v[0]), v[1]), ...)`.
    @inline
    fn fold<A>(self: &Self, init: A, f: (A, &T) => A): A {
        var acc = init
        for e in self {
            acc = f(acc, e)
        }
        return acc
    }

    // The same as fold, under the name most readers type first.
    fn reduce<A>(self: &Self, init: A, f: (A, &T) => A): A {
        return self.fold(init, f)
    }

    // A deep copy. _vecCopyOut is codegen's structural copy (emitDeepCloneFromPtr), the one
    // that copies a Vec nested in a struct, a map or another Vec, so a user Clone impl on
    // the element is not called, as the builtin did not call it. The checker refuses the
    // elements that have no such copy (interfaces, closures, resources) at the call.
    fn clone(self: &Self): Vec<T> {
        return _vecCopyOut(self)
    }

    // A new Vec of `f` applied to each element, in order, with exactly `len` slots, as the
    // builtin allocated it. The checker infers U from the callback's return type.
    @inline
    fn map<U>(self: &Self, f: (&T) => U): Vec<U> {
        let len = self.len()
        var out: Vec<U> = Vec.withCapacity(len)
        unsafe {
            let src = self.ptr()
            var raw = (out.addrOf() as *u8) as *VecHead
            var dst = out.ptr()
            var i = 0
            while i < len {
                dst[i] = f(src[i])
                i = i.wrappingAdd(1)
            }
            raw[0]._len = len
        }
        return out
    }

    // The elements joined into one string with `sep` between each pair. The checker
    // allows this on a Vec<string> only.
    fn join(self: &Self, sep: &string): string {
        var result: string = ""
        var i = 0
        for part in self {
            if i > 0 {
                result += sep
            }
            result += part
            i = i.wrappingAdd(1)
        }
        return result
    }

    // A new Vec of copies of the elements `f` holds for, in order. The copies are
    // _vecCopyOut's, as clone's are. Its capacity is the source length (every element
    // might match), as the builtin allocated it.
    @inline
    fn filter(self: &Self, f: (&T) => bool): Vec<T> {
        let len = self.len()
        var out: Vec<T> = Vec.withCapacity(len)
        unsafe {
            let src = self.ptr()
            var raw = (out.addrOf() as *u8) as *VecHead
            var dst = out.ptr()
            var n = 0
            var i = 0
            while i < len {
                if f(src[i]) {
                    dst[n] = _vecCopyOut(src[i])
                    n = n.wrappingAdd(1)
                }
                i = i.wrappingAdd(1)
            }
            raw[0]._len = n
        }
        return out
    }

    // The sorts are the builtin's insertion sort, kept as it was so that every program sees
    // the same result and the same sequence of callback calls: element i is moved out,
    // larger elements before it shift up one slot each (bitwise moves), and it is stored in
    // the gap. Stable: an element passes only one strictly greater than itself.

    // Sorts in place by the natural order (_natLess: ints by signedness, floats by IEEE
    // `<`, so a NaN never moves past anything, strings by bytes, false before true). The
    // checker limits this to those element types.
    fn sort(self: &mut Self) {
        unsafe {
            let data = self.ptr()
            let len = self.len()
            var i = 1
            while i < len {
                let tmp = *data[i].addrOf()
                var j = i
                while j > 0 && _natLess(tmp, data[j.wrappingSub(1)]) {
                    data[j] = *data[j.wrappingSub(1)].addrOf()
                    j = j.wrappingSub(1)
                }
                data[j] = tmp
                i = i.wrappingAdd(1)
            }
        }
    }

    // Sorts in place by a comparator: `f(a, b)` positive means b goes first, zero or
    // negative keeps a first. R is whatever signed integer the comparator returns; only
    // its sign is read. @inline so the comparator is inlined into the loop; called, it
    // measured about 20% slower than the builtin.
    @inline
    fn sortBy<R>(self: &mut Self, f: (&T, &T) => R) {
        let zero = 0 as R
        unsafe {
            let data = self.ptr()
            let len = self.len()
            var i = 1
            while i < len {
                let tmp = *data[i].addrOf()
                var j = i
                while j > 0 && f(data[j.wrappingSub(1)], tmp) > zero {
                    data[j] = *data[j.wrappingSub(1)].addrOf()
                    j = j.wrappingSub(1)
                }
                data[j] = tmp
                i = i.wrappingAdd(1)
            }
        }
    }

    // Sorts in place by the natural order of `f`'s key, which the checker limits to int,
    // float, string and bool. The key of the element being placed is taken once; the key
    // of each element it is compared against is taken per comparison, the builtin's call
    // sequence. A key may be a view of its element (`(p: &P) => p.name`, the one place
    // a closure may return a field of its borrowed parameter), so every key is forgotten
    // (_vecForget, which a user fn named forget cannot shadow), never dropped. @inline for
    // the same reason as sortBy.
    @inline
    // sortByKey for an extractor that builds its key (`p.name + "!"`): each key is this
    // sort's own and is dropped after its comparison. sortByKey forgets them instead,
    // because there the key is the element's own field. The checker picks which.
    fn sortByKeyOwned<K>(self: &mut Self, f: (&T) => K) {
        unsafe {
            let data = self.ptr()
            let len = self.len()
            var i = 1
            while i < len {
                let tmp = *data[i].addrOf()
                let kt = f(tmp)
                var j = i
                while j > 0 {
                    let kp = f(data[j.wrappingSub(1)])
                    if !_natLess(kt, kp) {
                        break
                    }
                    data[j] = *data[j.wrappingSub(1)].addrOf()
                    j = j.wrappingSub(1)
                }
                data[j] = tmp
                i = i.wrappingAdd(1)
            }
        }
    }

    fn sortByKey<K>(self: &mut Self, f: (&T) => K) {
        unsafe {
            let data = self.ptr()
            let len = self.len()
            var i = 1
            while i < len {
                let tmp = *data[i].addrOf()
                let kt = f(tmp)
                var j = i
                while j > 0 {
                    let kp = f(data[j.wrappingSub(1)])
                    let after = _natLess(kt, kp)
                    _vecForget(kp)
                    if !after {
                        break
                    }
                    data[j] = *data[j.wrappingSub(1)].addrOf()
                    j = j.wrappingSub(1)
                }
                _vecForget(kt)
                data[j] = tmp
                i = i.wrappingAdd(1)
            }
        }
    }

    // Appends `x`. The hot path is a capacity compare, one store and the length bump;
    // @inline so it compiles to that at each call site, as the builtin's inline IR did.
    @inline
    @trackCaller
    fn push(self: &mut Self, x: T) {
        unsafe {
            var raw = (self.addrOf() as *u8) as *VecHead
            let len = raw[0]._len
            let cap = raw[0]._cap
            if (len as u64) >= (cap as u64) {
                vecGrowOne(&mut self, len, cap)
            }
            var data = self.ptr()
            data[len] = x
            raw[0]._len = len.wrappingAdd(1)
        }
    }

    // Inserts `x` at index `i`, shifting the elements from `i` on up by one. `i` may be
    // the length (an append); past it panics with the builtin's "insert index out of
    // bounds", before any growth. Grows as push does.
    @inline
    @trackCaller
    fn insert(self: &mut Self, i: i64, x: T) {
        unsafe {
            var raw = (self.addrOf() as *u8) as *VecHead
            let len = raw[0]._len
            // Unsigned, so a negative index is out of range too, in one compare.
            if (i as u64) > (len as u64) {
                _vecPanic("insert index out of bounds")
            }
            let cap = raw[0]._cap
            if (len as u64) >= (cap as u64) {
                vecGrowOne(&mut self, len, cap)
            }
            var data = self.ptr()
            memmove(data[i.wrappingAdd(1)].addrOf() as *u8, data[i].addrOf() as *u8, len.wrappingSub(i).wrappingMul(sizeOf<T>()))
            data[i] = x
            raw[0]._len = len.wrappingAdd(1)
        }
    }

    // Moves every element of `other` onto the end, bitwise: nothing is copied or dropped,
    // and `other` (which the call consumes) leaves holding no elements, so its own drop
    // frees only its buffer.
    @inline
    @trackCaller
    fn extend(self: &mut Self, other: Vec<T>) {
        unsafe {
            let n = other.len()
            var raw = (self.addrOf() as *u8) as *VecHead
            let len = raw[0]._len
            let need = len.wrappingAdd(n)
            vecReserveTotal(&mut self, need)
            var data = self.ptr()
            memcpy(data[len].addrOf() as *u8, other.ptr() as *u8, n.wrappingMul(sizeOf<T>()))
            raw[0]._len = need
            var spent = (other.addrOf() as *u8) as *VecHead
            spent[0]._len = 0
        }
    }

    // Makes room for `n` more elements without another allocation. A negative `n` panics
    // ("negative capacity"), at the caller's line.
    @inline
    @trackCaller
    fn reserve(self: &mut Self, n: i64) {
        let extra = _vecNonNegative(n)
        vecReserveTotal(&mut self, self.len().wrappingAdd(extra))
    }

    // Exchanges the elements at `a` and `b`. Both indexes are bounds-checked, `a` first,
    // with the indexing panic.
    @inline
    @trackCaller
    fn swap(self: &mut Self, a: i64, b: i64) {
        unsafe {
            let pa = self[a].addrOf()
            let pb = self[b].addrOf()
            vecSwapAt(pa, pb)
        }
    }

    // Reverses the order of the elements in place.
    @inline
    fn reverse(self: &mut Self) {
        unsafe {
            let data = self.ptr()
            var lo = 0
            var hi = self.len().wrappingSub(1)
            while lo < hi {
                vecSwapAt(data[lo].addrOf(), data[hi].addrOf())
                lo = lo.wrappingAdd(1)
                hi = hi.wrappingSub(1)
            }
        }
    }

    // Drops every element at index `n` and above, first to last, then shortens the Vec.
    // A negative `n` empties it; an `n` at or past the length changes nothing (it never
    // grows the Vec).
    @inline
    fn truncate(self: &mut Self, n: i64) {
        unsafe {
            var raw = (self.addrOf() as *u8) as *VecHead
            let len = raw[0]._len
            var keep = n
            if keep < 0 {
                keep = 0
            }
            if keep >= len {
                return
            }
            let data = self.ptr()
            var i = keep
            while i < len {
                vecDropAt(data[i].addrOf())
                i = i.wrappingAdd(1)
            }
            raw[0]._len = keep
        }
    }

    // Drops every element, first to last; the capacity is kept.
    @inline
    fn clear(self: &mut Self) {
        self.truncate(0)
    }

    // Takes the last element out, or None when the Vec is empty. The value moves out of
    // its slot; nothing is copied.
    @inline
    fn pop(self: &mut Self): Option<T> {
        unsafe {
            var raw = (self.addrOf() as *u8) as *VecHead
            let len = raw[0]._len
            if len == 0 {
                return Option.None
            }
            let last = len.wrappingSub(1)
            raw[0]._len = last
            let data = self.ptr()
            return Option.Some(*data[last].addrOf())
        }
    }

    // Takes the element at `i` out and shifts the rest down by one. An index outside
    // 0..len panics with the builtin's "remove index out of bounds".
    @inline
    @trackCaller
    fn remove(self: &mut Self, i: i64): T {
        unsafe {
            var raw = (self.addrOf() as *u8) as *VecHead
            let len = raw[0]._len
            // Unsigned, so a negative index is out of range too, in one compare.
            if (i as u64) >= (len as u64) {
                _vecPanic("remove index out of bounds")
            }
            let data = self.ptr()
            let out = *data[i].addrOf()
            let next = i.wrappingAdd(1)
            memmove(data[i].addrOf() as *u8, data[next].addrOf() as *u8, len.wrappingSub(next).wrappingMul(sizeOf<T>()))
            raw[0]._len = len.wrappingSub(1)
            return out
        }
    }

    // Keeps the elements `f` holds for, in order, and drops the others where they sit,
    // first to last: one pass, no second buffer. `f` sees each element in place; the
    // length is stored once, after the pass. @inline for the same reason as the
    // read-only callback methods.
    @inline
    fn retain(self: &mut Self, f: (&T) => bool) {
        unsafe {
            var raw = (self.addrOf() as *u8) as *VecHead
            let len = raw[0]._len
            var data = self.ptr()
            var kept = 0
            var i = 0
            while i < len {
                if f(data[i]) {
                    data[kept] = *data[i].addrOf()
                    kept = kept.wrappingAdd(1)
                } else {
                    vecDropAt(data[i].addrOf())
                }
                i = i.wrappingAdd(1)
            }
            raw[0]._len = kept
        }
    }
}
