// std/crypto — cryptographic primitives: SHA-256/SHA-1/MD5 digests and AES-GCM over the
// platform crypto library (CommonCrypto, OpenSSL, CNG).
//
// Everything platform-independent lives here once. The platform binding is
// std/cryptosys.{darwin,linux,windows}.milo, which exposes only raw digest bytes and the
// raw GCM calls; the facade used to be copied into each arm and the copies had drifted.

from "std/cryptosys" import {
    sha256Raw, sha1Raw, md5Raw, gcmEncryptRaw, gcmDecryptRaw
}
from "std/hex" import {
    Hex
}

// Compute SHA-256 hash of a string. Returns 64-char lowercase hex string.
fn sha256(input: &string): string {
    let raw = sha256Raw(input)
    return Hex.encode(raw)
}

// Compute MD5 hash of a string. Returns 32-char lowercase hex string.
fn md5(input: &string): string {
    let raw = md5Raw(input)
    return Hex.encode(raw)
}

// Compute SHA-1 hash. Returns 40-char lowercase hex string.
fn sha1(input: &string): string {
    let raw = sha1Raw(input)
    return Hex.encode(raw)
}

// Raw 20-byte SHA-1 digest as a string (for WebSocket handshake, HMAC, etc.)
fn sha1Bytes(input: &string): string {
    return sha1Raw(input)
}

// ── AES-GCM ──

// The two outputs of an AES-GCM encryption. Keep both: decryption needs the `tag`.
pub struct AesGcmResult {
    ciphertext: string,
    tag: string,
}

// The arm returns ciphertext with the 16-byte tag appended (the usual wire layout);
// the split into fields happens once, here.
fn aesGcmSplit(raw: string): AesGcmResult {
    let n = raw.len - 16
    return AesGcmResult {
        ciphertext: raw.substr(0, n), tag: raw.substr(n, raw.len)
    }
}

// Encrypt with AES-256-GCM. Key must be 32 bytes, IV should be 12 bytes.
fn aesGcmEncrypt(key: &string, iv: &string, plaintext: &string, aad: &string): Result<AesGcmResult, string>
requires key.len == 32
requires iv.len == 12
{
    // Checked at RUNTIME, not only by the `requires` above: contracts are asserted in
    // --debug and dropped at the default -O2, and these lengths are passed to the C
    // API as CONSTANTS (32, 12, 16) regardless of what arrived. A short key therefore
    // read past the end of the caller's buffer in an ordinary build — an out-of-bounds
    // read reachable from safe Milo — and "encrypted" with whatever followed it.
    if key.len != 32 {
        return Result.Err("aesGcmEncrypt: key must be 32 bytes, got " + key.len.toString())
    }
    if iv.len != 12 {
        return Result.Err("aesGcmEncrypt: iv must be 12 bytes, got " + iv.len.toString())
    }
    let raw = gcmEncryptRaw(256, key, iv, plaintext, aad)?
    return Result.Ok(aesGcmSplit(raw))
}

// Decrypt with AES-256-GCM. Key must be 32 bytes, IV 12 bytes, tag 16 bytes.
fn aesGcmDecrypt(key: &string, iv: &string, ciphertext: &string, tag: &string, aad: &string): Result<string, string>
requires key.len == 32
requires iv.len == 12
requires tag.len == 16
{
    // Checked at RUNTIME, not only by the `requires` above: contracts are asserted in
    // --debug and dropped at the default -O2, and these lengths are passed to the C
    // API as CONSTANTS (32, 12, 16) regardless of what arrived. A short key therefore
    // read past the end of the caller's buffer in an ordinary build — an out-of-bounds
    // read reachable from safe Milo — and "encrypted" with whatever followed it.
    if key.len != 32 {
        return Result.Err("aesGcmDecrypt: key must be 32 bytes, got " + key.len.toString())
    }
    if iv.len != 12 {
        return Result.Err("aesGcmDecrypt: iv must be 12 bytes, got " + iv.len.toString())
    }
    if tag.len != 16 {
        return Result.Err("aesGcmDecrypt: tag must be 16 bytes, got " + tag.len.toString())
    }
    return gcmDecryptRaw(256, key, iv, ciphertext, tag, aad)
}

// Encrypt with AES-128-GCM. Key must be 16 bytes, IV 12 bytes. (termpair uses AES-128.)
fn aesGcm128Encrypt(key: &string, iv: &string, plaintext: &string, aad: &string): Result<AesGcmResult, string>
requires key.len == 16
requires iv.len == 12
{
    // Checked at RUNTIME, not only by the `requires` above: contracts are asserted in
    // --debug and dropped at the default -O2, and these lengths are passed to the C
    // API as CONSTANTS (32, 12, 16) regardless of what arrived. A short key therefore
    // read past the end of the caller's buffer in an ordinary build — an out-of-bounds
    // read reachable from safe Milo — and "encrypted" with whatever followed it.
    if key.len != 16 {
        return Result.Err("aesGcm128Encrypt: key must be 16 bytes, got " + key.len.toString())
    }
    if iv.len != 12 {
        return Result.Err("aesGcm128Encrypt: iv must be 12 bytes, got " + iv.len.toString())
    }
    let raw = gcmEncryptRaw(128, key, iv, plaintext, aad)?
    return Result.Ok(aesGcmSplit(raw))
}

// Decrypt with AES-128-GCM. Key 16 bytes, IV 12 bytes, tag 16 bytes.
fn aesGcm128Decrypt(key: &string, iv: &string, ciphertext: &string, tag: &string, aad: &string): Result<string, string>
requires key.len == 16
requires iv.len == 12
requires tag.len == 16
{
    // Checked at RUNTIME, not only by the `requires` above: contracts are asserted in
    // --debug and dropped at the default -O2, and these lengths are passed to the C
    // API as CONSTANTS (32, 12, 16) regardless of what arrived. A short key therefore
    // read past the end of the caller's buffer in an ordinary build — an out-of-bounds
    // read reachable from safe Milo — and "encrypted" with whatever followed it.
    if key.len != 16 {
        return Result.Err("aesGcm128Decrypt: key must be 16 bytes, got " + key.len.toString())
    }
    if iv.len != 12 {
        return Result.Err("aesGcm128Decrypt: iv must be 12 bytes, got " + iv.len.toString())
    }
    if tag.len != 16 {
        return Result.Err("aesGcm128Decrypt: tag must be 16 bytes, got " + tag.len.toString())
    }
    return gcmDecryptRaw(128, key, iv, ciphertext, tag, aad)
}

// Crypto namespace — Crypto.sha256/sha1/sha1Bytes/md5 (platform crypto lib) + AES-GCM.
pub struct Crypto {
}

impl Crypto {
    // SHA-256 as a 64-char lowercase hex string.
    fn sha256(input: &string): string {
        return sha256(input)
    }
    // SHA-1 as a 40-char lowercase hex string.
    fn sha1(input: &string): string {
        return sha1(input)
    }
    // SHA-1 as the raw 20-byte digest (the WebSocket handshake, legacy protocols).
    fn sha1Bytes(input: &string): string {
        return sha1Bytes(input)
    }
    // MD5 as a 32-char lowercase hex string.
    fn md5(input: &string): string {
        return md5(input)
    }
    // Encrypt with AES-256-GCM. The key is 32 bytes and the IV is 12 bytes.
    //
    // `aad` is additional authenticated data; pass "" if unused. The key and IV lengths
    // are preconditions (`requires`), not runtime errors.
    fn aesGcmEncrypt(key: &string, iv: &string, plaintext: &string, aad: &string): Result<AesGcmResult, string>
    requires key.len == 32
    requires iv.len == 12
    {
        return aesGcmEncrypt(key, iv, plaintext, aad)
    }
    // Decrypt and authenticate with AES-256-GCM: 32-byte key, 12-byte IV, and the
    // 16-byte `tag` from encryption. A tag that does not verify is an `Err`, never
    // corrupted plaintext.
    fn aesGcmDecrypt(key: &string, iv: &string, ciphertext: &string, tag: &string, aad: &string): Result<string, string>
    requires key.len == 32
    requires iv.len == 12
    requires tag.len == 16
    {
        return aesGcmDecrypt(key, iv, ciphertext, tag, aad)
    }
    // Encrypt with AES-128-GCM. The key is 16 bytes and the IV is 12 bytes.
    //
    // `aad` is additional authenticated data; pass "" if unused.
    fn aesGcm128Encrypt(key: &string, iv: &string, plaintext: &string, aad: &string): Result<AesGcmResult, string>
    requires key.len == 16
    requires iv.len == 12
    {
        return aesGcm128Encrypt(key, iv, plaintext, aad)
    }
    // Decrypt and authenticate with AES-128-GCM: 16-byte key, 12-byte IV, 16-byte
    // `tag`. A tag that does not verify is an `Err`.
    fn aesGcm128Decrypt(key: &string, iv: &string, ciphertext: &string, tag: &string, aad: &string): Result<string, string>
    requires key.len == 16
    requires iv.len == 12
    requires tag.len == 16
    {
        return aesGcm128Decrypt(key, iv, ciphertext, tag, aad)
    }
}
