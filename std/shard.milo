// std/shard — in-place parallelism by dividing OWNERSHIP, not by sharing references.
//
// The problem: applying a transform to a large Vec across several cores. Milo
// will not let a reference cross a thread boundary, so the safe route has been to
// give every worker its own copy of a chunk and stitch the copies back together.
// For a 20M-element buffer that copy costs more than the parallelism saves.
//
// The way out is not to weaken the reference rules, it is to make ownership
// divisible. `parallelMap` CONSUMES a Vec, divides its storage into disjoint windows,
// hands each window to a worker BY MOVE like any other value, and reassembles the
// same allocation once every worker has returned:
//
//     var data: Vec<f64> = Vec.filled(n, 1.0)
//     let back = parallelMap(data, 4, shade)   // `data` is moved; same allocation returns
//
// The three things that make that safe are all rules Milo already had:
//
//   - the Vec is consumed, so while it is divided there is no binding through which
//     the buffer can be reached except the windows.
//   - the windows are disjoint BY CONSTRUCTION: window i covers exactly
//     [i*chunk, (i+1)*chunk), computed here, never supplied by the caller.
//   - `Shard` holds a raw pointer and is not `@copy`, so it is move-tracked, and
//     handing the same window to two workers is `error: use of moved variable`,
//     not a race.
//
// And the fourth is the shape of the API. A window is a raw pointer into the owner's
// buffer, so a program that dropped the owner while a worker still held a window
// would write into freed memory. The divide/run/reassemble cycle therefore lives
// INSIDE this module: `parallelMap`, `parallelMapWith` and `parallelScanStr` make
// every window, hand out every window, await every worker and reassemble, and no
// caller code exists between those steps to get wrong. The pieces of that cycle
// (`shatter`, `windows`, `weld`) are module-private on purpose. They used to be an
// escape hatch, and the hatch was a use-after-free the move checker could not see
// (H2 in docs/plans/soundness-sweep-2026-09.md); the completeness check `weld` runs
// is now an internal assertion, not a contract a caller can miss.
//
// Element types are Copy only (`@copyOnly` on Shard, Shards, parallelMap and
// parallelMapWith). `Shard.get` reads `self.base[i]` through the raw pointer, a bitwise
// copy, and `set` overwrites the slot without dropping what was there. For an i64 or a
// struct of scalars those are the operations they look like; for a string they are a
// second owner and a leak, and `Shard<string>` freed one block twice before the
// attribute existed. Every other `unsafe` block inside a generic in std/ was audited
// against the same question, "does it duplicate a T through a raw pointer?", 2026-09-19:
//
//   std/sync.milo    Channel<T>.send/trySend memcpy the value in and memset the source
//                    to zero; recv/tryRecv memcpy out and advance head. A move each
//                    way, one owner at every point. Sound as written.
//   std/runtime.milo Promise<T>.await returns zeroed<T>() on an unreachable tail. No T
//                    is read through a pointer.
//   std/arena.milo   arenaNew/arenaClear touch an i64 id counter atomically. T untouched.
//   std/seal.milo    sharedWith<R> dereferences the refcount box and BORROWS the inner
//                    Sealed; R passes through by move. Nothing duplicated.
//   std/foreign.milo withRaw/withRawMut hand out a slice VIEW (a borrow) of the caller's
//                    memory; adopt/adoptSlice transfer the whole buffer into one Heap or
//                    Vec. Callers opt in with `unsafe` (@unsafe fns). Nothing duplicated.
//
// So this module is the only one that needs the attribute today. A new generic that
// reads a `*T` element by value must either carry `@copyOnly` or clone out and drop the
// old value explicitly.

from "std/os" import {
    free, malloc
}
from "std/runtime" import {
    Promise
}
from "std/sync" import {
    Channel
}

// A disjoint, owned window over part of one Vec's storage.
//
// A struct of a pointer and three integers is move-tracked because of the pointer:
// a Copy window could be handed to two workers at once, which is exactly the race
// the design claims to make unrepresentable. (It carried `@noCopy` before a pointer
// field made every struct move-only by default.)
//
// @copyOnly closes the other half: `get` reads `self.base[i]` through
// a raw pointer, which is a bitwise copy of the element. For a Copy `T` that is the
// value; for a `string` it is a second owner of the same heap block, freed once by the
// caller and once more when the buffer is welded back and dropped. A `Shard<string>`
// is therefore rejected at the instantiation, where the element type is written.
@copyOnly
pub struct Shard<T> {
    base: *T,
    len: i64,
    start: i64,
    shatterId: i64,
    index: i64,
}

// Fixed-size window: no push, no pop, no resize. The buffer's identity has to
// survive until weld, and a window that could reallocate would break that.
impl Shard<T> {
    // Elements in this window.
    fn len(self: &Self): i64 {
        return self.len
    }

    // Which window of the division this is, counting from 0.
    fn index(self: &Self): i64 {
        return self.index
    }

    // Where this window begins in the ORIGINAL buffer. Without it a worker can only
    // do position-independent work: a filter that needs to know which pixel, row or
    // sample it is looking at has no way to find out, because a window's own indices
    // all start at 0. Global position of element `i` is `start() + i`.
    fn start(self: &Self): i64 {
        return self.start
    }

    // The element at `i` within THIS window. Bounds-checked against the window's own
    // length, so a stray index cannot reach a sibling window's elements.
    fn get(self: &Self, i: i64): T {
        assert(i >= 0 && i < self.len, "shard: index out of range")
        unsafe {
            return self.base[i]
        }
    }

    // Overwrite the element at `i` within this window. Bounds-checked the same way.
    fn set(self: &mut Self, i: i64, val: T): void {
        assert(i >= 0 && i < self.len, "shard: index out of range")
        unsafe {
            self.base[i] = val
        }
    }

}

// Safety: the windows a shatter hands out are pairwise disjoint by construction,
// the Vec they cover was consumed by that shatter so no other binding reaches it,
// and a window (a pointer-holding struct) has exactly one owner at a time. What crosses the
// thread boundary is therefore a pointer into memory nothing else can touch for
// as long as the window is alive.
unsafe

impl Send for Shard {
}

// The verdict of a reassembly check, shared by both sides so the two cannot drift
// apart. To this logic a window is an id and an index, and both sides have those.
// They did drift once: the string side shipped with the count and coverage checks
// missing, justified by a comment about overlap that applies to neither of them.
//
// `ids` and `indices` are the windows handed back, paired by position. Overlap is
// irrelevant here: `index` stays unique per window whether or not the byte ranges
// overlap, so the same coverage argument holds for reading and writing windows.
//
// Returns "" when every window this shatter handed out is present exactly once, else
// what is wrong. Every caller is a closed form that collected every window it made,
// so a non-empty verdict is a bug in this module and the callers assert on it.
fn weldVerdict(count: i64, shatterId: i64, ids: &Vec<i64>, indices: &Vec<i64>): string {
    if ids.len != count {
        return "expected " + count.toString() + " windows, got " + ids.len.toString()
    }
    var seen: Vec<bool> = Vec.new()
    var i: i64 = 0
    while i < count {
        seen.push(false)
        i += 1
    }
    var k: i64 = 0
    while k < ids.len {
        let idx = indices[k]
        if ids[k] != shatterId || idx < 0 || idx >= count {
            return "window " + idx.toString() + " did not come from this shatter"
        }
        if seen[idx] {
            return "window " + idx.toString() + " came back twice"
        }
        seen[idx] = true
        k += 1
    }
    var j: i64 = 0
    while j < count {
        if !seen[j] {
            return "window " + j.toString() + " never came back"
        }
        j += 1
    }
    return ""
}

// Owns the buffer while it is divided. Module-private: the only code that may hold
// one is a closed form in this file, which is what guarantees it outlives its windows.
@copyOnly
struct Shards<T> {
    buf: Vec<T>,
    count: i64,
    shatterId: i64,
    handedOut: bool,
}

// Per-process shatter identity, so a window cannot be welded into the wrong owner.
// Allocated atomically because shatter can run on a Promise.blocking worker.
var nextShatterId: i64 = 1

// Consume a Vec and return an owner that can hand out `n` disjoint windows over
// its storage. O(1): nothing is copied, and the Vec's buffer is untouched.
//
// `n` is clamped to at least 1 and at most the element count, so a caller asking
// for more windows than elements gets one window per element rather than a pile
// of empty ones aliasing the same address. An EMPTY Vec is the case that has to
// clamp up rather than down: `min(n, v.len)` would be 0 there, and a count of 0
// divides by zero in `windows`, so the lower bound wins and an empty buffer is
// one empty window.
fn shatter<T>(v: Vec<T>, n: i64): Shards<T> {
    var id: i64 = 0
    unsafe {
        id = _atomicAddI64((nextShatterId.addrOf()) as *u8, 1)
    }
    var wanted = n
    if wanted > v.len {
        wanted = v.len
    }
    if wanted < 1 {
        wanted = 1
    }
    var s: Shards<T> = Shards {
        buf: v,
        count: wanted,
        shatterId: id,
        handedOut: false,
    }
    return s
}

impl Shards<T> {
    // The windows, once.
    //
    // A second call aborts: it cannot hand out a second set of pointers to the same
    // storage without creating the aliases the whole design exists to prevent. Every
    // caller in this file calls it exactly once, so the assertion guards this module
    // against itself, not a user against a misuse.
    fn windows(self: &mut Self): Vec<Shard<T>> {
        assert(!self.handedOut, "shard: windows() called twice on one shatter; the first set is still outstanding")
        var out: Vec<Shard<T>> = Vec.new()
        self.handedOut = true
        let total = self.buf.len
        let chunk = total / self.count
        var i: i64 = 0
        unsafe {
            let p = self.buf.ptr()
            while i < self.count {
                let lo = i * chunk
                var hi = lo + chunk
                if i == self.count - 1 {
                    hi = total
                }
                var sh: Shard<T> = Shard {
                    base: ((p as i64) + lo * sizeOf<T>()) as *T,
                    len: hi - lo,
                    start: lo,
                    shatterId: self.shatterId,
                    index: i,
                }
                out.push(sh)
                i += 1
            }
        }
        return out
    }

    // Reassemble: consume the owner and the windows, and hand back the original Vec
    // with its original allocation.
    //
    // The check is what keeps a bug in this module a loud abort instead of silent
    // corruption: every window must carry this shatter's identity, and the set must
    // cover every index exactly once. A missing window would mean some worker still
    // holds a pointer into this buffer, and returning the Vec then would be the
    // use-after-free this module exists to avoid. The closed forms await every worker
    // before welding, so the verdict is always clean; the assertion is there for the
    // day one of them is edited wrong.
    fn weld(self: Self, returned: Vec<Shard<T>>): Vec<T> {
        var ids: Vec<i64> = Vec.new()
        var indices: Vec<i64> = Vec.new()
        for w in returned {
            ids.push(w.shatterId)
            indices.push(w.index)
        }
        let bad = weldVerdict(self.count, self.shatterId, ids, indices)
        assert(bad.len == 0, "shard: internal weld check failed: " + bad)
        return self.buf
    }
}

// Divide, run on `workers` threads, reassemble. The whole cycle in one call.
//
//     let out = parallelMap(pixels, 4, shade)
//
// Infallible: this function creates every window, hands out every window, awaits
// every worker and welds the set itself, so there is no way for a window to be
// missing at the weld. Workers that need to differ from each other, or more windows
// than workers, are `parallelMapWith`.
//
// `f` is a plain function rather than a closure because each worker needs its own
// copy: a capturing closure would be moved into the first task and gone for the rest.
// Everything the work depends on therefore travels in the window itself, which is
// also what keeps the workers from sharing anything.
@copyOnly
pub fn parallelMap<T>(v: Vec<T>, workers: i64, f: (Shard<T>) => Shard<T>): Vec<T> {
    var owner = shatter(v, workers)
    var windows = owner.windows()
    var ps: Vec<Promise<Shard<T>>> = Vec.new()
    while windows.len > 0 {
        let w = windows.pop()!
        ps.push(Promise<Shard<T>>.blocking(move(): Shard<T> => {
            return f(w)
        }
        ))
    }
    let back = Promise.all(ps).await()!
    return owner.weld(back)
}

// The result of a stateful parallel map: the transformed buffer, plus every
// worker's environment handed back in the order the environments were given.
pub struct Mapped<T, S> {
    data: Vec<T>,
    states: Vec<S>,
}

// `parallelMapWith` was given no states, so there would be no worker to run on.
//
// Why a refusal is a struct and not a message: `v` was moved in at the call, so a
// `Result<Mapped, string>` would destroy a 20M-element buffer over an empty Vec of
// states. This module exists so that buffer is never copied, which makes dropping it
// the one failure it cannot afford. The refusal carries it home untouched, and
// nothing else: `states` is empty by definition of this refusal, so there is nothing
// of the caller's in it to return. Same shape, and the same reason, as
// `FreezeRejected` in std/arena and `ThawRejected` in std/seal.
pub struct NoWorkers<T> {
    // The caller's buffer, whole. It was never divided.
    data: Vec<T>,
}

impl NoWorkers<T> {
    // A sentence for a human, for a caller that only wants to log.
    fn message(self: &Self): string {
        return "parallelMapWith: states is empty, so there is no worker to run on"
    }
}

// parallelMap with two things it cannot express: more windows than workers, and
// per-worker state.
//
// More windows than workers is how uneven work balances out. parallelMap spawns
// one thread per window, so over-partitioning a 64-window render costs 64 OS
// threads. Here `states.len` fixes the worker count and the windows go into a
// queue the workers pull from: a worker that drew a cheap window pulls another,
// and one that drew the expensive window keeps grinding without idling the rest.
//
// The states are the answer to "why must `f` be a plain function": a closure
// cannot be copied to N workers, so whatever it would have captured travels as an
// explicit owned value instead. Each worker moves one `S` in, threads it through
// every window it processes, and hands it back through the result. Configuration
// rides in, accumulators ride out, and nothing is shared: an S is on exactly one
// thread at a time, which is the same move-checker argument the windows use.
//
// Which worker processes which window is scheduling, so state a caller reads back
// must not encode the assignment: per-worker tallies merge into totals that are
// deterministic even though each worker's share is not.
@copyOnly(T)
pub fn parallelMapWith<T, S>(v: Vec<T>, windows: i64, states: Vec<S>, f: (Shard<T>, &mut S) => Shard<T>): Result<Mapped<T, S>, NoWorkers<T>> {
    // Refuse BEFORE dividing anything, so the buffer goes home whole. A non-positive
    // `windows` is not checked at all: `shatter` already clamps the count to at
    // least one, so the old guard rejected an input the divider was about to accept.
    if states.len <= 0 {
        var r: NoWorkers<T> = NoWorkers {
            data: v
        }
        return Result.Err(r)
    }
    var owner = shatter(v, windows)
    var ws = owner.windows()
    // `shatter` clamps the count to one window per element, so asking for more
    // windows than the buffer has elements yields FEWER than `windows`. Every
    // count below has to come from the windows that actually exist: driving the
    // collection loop off the parameter instead waits for windows nobody will
    // send, and since this function still holds a sender on `out`, that wait
    // never ends. Over-partitioning a small input is the exact thing this
    // function tells callers to do, so the parameter is the wrong source.
    let made = ws.len
    // Capacity = one slot per window on both queues, so every send below
    // completes without a waiting reader and no interleaving can deadlock.
    let jobs = Channel<Shard<T>>.new(made)!
    let out = Channel<Shard<T>>.new(made)!
    var ps: Vec<Promise<S>> = Vec.new()
    var sts = states
    while sts.len > 0 {
        let st = sts.pop()!
        let jc = jobs.clone()
        let oc = out.clone()
        ps.push(Promise<S>.blocking(move(): S => {
            var s = st
            while true {
                let j = jc.recv()
                if j.isErr() {
                    break
                }
                oc.send(f(j!, &mut s))!
            }
            return s
        }
        ))
    }
    while ws.len > 0 {
        jobs.send(ws.pop()!)!
    }
    jobs.close()
    var back: Vec<Shard<T>> = Vec.new()
    for i in 0..made {
        back.push(out.recv()!)
    }
    var got = Promise.all(ps).await()!
    // Workers were spawned by popping states from the tail, so `got` is the
    // caller's order reversed; popping it again restores the order given.
    var ordered: Vec<S> = Vec.new()
    while got.len > 0 {
        ordered.push(got.pop()!)
    }
    let data = owner.weld(back)
    return Result.Ok(Mapped {
        data: data, states: ordered
    }
    )
}

// ---------------------------------------------------------------------------
// Read-only windows over a string.
// ---------------------------------------------------------------------------
//
// The Vec side above divides ownership so workers can WRITE disjoint ranges. A
// scanner does not write at all, and the buffer it wants to divide is almost always
// a `string`, because that is what `readFile` hands back. Converting one to a
// `Vec<u8>` first costs a full copy (19-33 ms for 51 MiB, against a 34 ms scan), so
// the copy would eat the parallelism it was bought for.
//
// So this is the read-only half: `parallelScanStr` keeps the string, the windows are
// views, and nothing mutates. The two consequences of nobody writing are:
//
//   - windows may OVERLAP. A literal that straddles a boundary is missed by disjoint
//     windows, and the usual fix is to scan the seams afterwards. Overlap is sound
//     here precisely because these are reads, so `parallelScanStr(s, n, overlap, f)`
//     lets a scanner ask for `needle.len - 1` bytes of slack and stop thinking about
//     seams. Mind that a match inside the overlap is found by BOTH neighbours, so a
//     counter must ignore hits that begin at or past its own `ownLen()`. Ask the
//     window; `len` minus the overlap is wrong for the last one, which was never
//     extended.
//   - overlap removes the COVERAGE-OF-BYTES check, not the liveness one. Two windows
//     legally sharing bytes means `weld` cannot ask which window owns which byte, so
//     it does not. It still asks that every window it handed out has come back
//     exactly once, by `index`, which stays unique per window however much the ranges
//     overlap. That check is about lifetime, not about writes: a returned `string`
//     can be mutated or dropped while a live StrShard still points into it, so a
//     window that never came home is the same dangling pointer the Vec side refuses.

pub struct StrShard {
    base: *u8,
    len: i64,
    own: i64,
    start: i64,
    shatterId: i64,
    index: i64,
}

impl StrShard {
    // Bytes in this window, including any overlap it was given.
    fn len(self: &Self): i64 {
        return self.len
    }

    // Bytes in this window BEFORE the overlap was added: the range no other window
    // owns. A scanner must count only matches beginning below this, or the two
    // neighbours that can both see a match in the overlap will both count it.
    //
    // It is a field rather than something the caller derives because the last
    // window is the odd one out: it takes the remainder of an uneven division, so
    // `total / count` is wrong for exactly one window and a caller that re-derives
    // it silently miscounts there instead of failing.
    fn ownLen(self: &Self): i64 {
        return self.own
    }

    // Where this window begins in the original string.
    fn start(self: &Self): i64 {
        return self.start
    }

    // Which window of the division this is, counting from 0.
    fn index(self: &Self): i64 {
        return self.index
    }

    // The byte at `i` within this window, bounds-checked against its length.
    fn byteAt(self: &Self, i: i64): u8 {
        assert(i >= 0 && i < self.len, "str shard: index out of range")
        unsafe {
            return self.base[i]
        }
    }

    // Whether this window's bytes at `i` match `needle`. Bounded by the window, so a
    // needle running past the end is simply not a match here; give the window an
    // overlap if you need to catch one that straddles the boundary.
    fn matchesAt(self: &Self, i: i64, needle: &string): bool {
        if i < 0 || i + needle.len > self.len {
            return false
        }
        var k: i64 = 0
        unsafe {
            while k < needle.len {
                if self.base[i + k] != needle[k] {
                    return false
                }
                k += 1
            }
        }
        return true
    }
}

// Safety: every window is a read-only view of a string the owner holds for as long
// as the windows are alive, and no method on StrShard writes. Overlapping windows
// are therefore fine: concurrent reads of the same bytes race with nothing.
unsafe

impl Send for StrShard {
}

// Owns the string while it is divided. Module-private for the same reason `Shards`
// is: only a closed form in this file may hold one.
struct StrShards {
    buf: string,
    count: i64,
    shatterId: i64,
    handedOut: bool,
}

// Consume a string and return an owner that hands out `n` read-only windows. Same
// clamping as `shatter`: at least one window, at most one per byte.
fn shatterStr(s: string, n: i64): StrShards {
    var id: i64 = 0
    unsafe {
        id = _atomicAddI64((nextShatterId.addrOf()) as *u8, 1)
    }
    var wanted = n
    if wanted > s.len {
        wanted = s.len
    }
    if wanted < 1 {
        wanted = 1
    }
    var out: StrShards = StrShards {
        buf: s,
        count: wanted,
        shatterId: id,
        handedOut: false,
    }
    return out
}

impl StrShards {
    // The windows, once. `overlap` extends each window that far into the next, so a
    // scanner looking for an `m`-byte needle passes `m - 1` and never has to stitch
    // the seams. 0 gives exactly disjoint windows.
    //
    // A second call aborts, for the reason the writing side's `windows` does.
    fn windows(self: &mut Self, overlap: i64): Vec<StrShard> {
        assert(!self.handedOut, "shard: windows() called twice on one shatter; the first set is still outstanding")
        var out: Vec<StrShard> = Vec.new()
        self.handedOut = true
        let total = self.buf.len
        let chunk = total / self.count
        var i: i64 = 0
        unsafe {
            let p = self.buf.cstr()
            while i < self.count {
                let lo = i * chunk
                var hi = lo + chunk
                if i == self.count - 1 {
                    hi = total
                }
                var end = hi + overlap
                if end > total {
                    end = total
                }
                var sh: StrShard = StrShard {
                    base: ((p as i64) + lo) as *u8,
                    len: end - lo,
                    own: hi - lo,
                    start: lo,
                    shatterId: self.shatterId,
                    index: i,
                }
                out.push(sh)
                i += 1
            }
        }
        return out
    }

    // Give the string back, once every window has come home.
    //
    // What is checked and what is not: the windows must all carry this shatter's
    // identity, and every `index` this shatter handed out must appear exactly once.
    // What is NOT checked is that the returned windows cover the bytes disjointly,
    // because `windows(overlap)` hands out ranges that deliberately share bytes and
    // a coverage-of-bytes test would reject the module's own usage.
    //
    // The count and the seen-set are not about writes. This owner is the only thing
    // keeping the string alive: hand it back while a window is still out and the
    // caller can mutate or drop a buffer that a live StrShard still points into.
    // Reads make overlap sound; they do not make a dangling read sound. As on the
    // Vec side the verdict is an internal assertion: `parallelScanStr` awaits every
    // worker before it welds.
    fn weld(self: Self, returned: Vec<StrShard>): string {
        var ids: Vec<i64> = Vec.new()
        var indices: Vec<i64> = Vec.new()
        for w in returned {
            ids.push(w.shatterId)
            indices.push(w.index)
        }
        let bad = weldVerdict(self.count, self.shatterId, ids, indices)
        assert(bad.len == 0, "shard: internal weld check failed: " + bad)
        return self.buf
    }
}

// The result of a parallel scan: the string, whole and untouched, plus what each
// window's scan returned, in window order (results[i] is for the window whose
// `index()` is i, so results[0] covers the start of the string).
pub struct Scanned<R> {
    text: string,
    results: Vec<R>,
}

// One worker's return: the window, so `weld` can confirm it came home, and what the
// scan of it produced.
struct ScanPart<R> {
    window: StrShard,
    result: R,
}

// Divide a string into `windows` read-only windows, each extended `overlap` bytes into
// the next, run `f` over every window on its own OS thread, and hand back the string
// with the per-window results. The whole read-only cycle in one call; `parallelMap`
// is the writing equivalent.
//
//     let scanned = parallelScanStr(text, 4, needle.len - 1, countMilo)
//     for n in scanned.results { total = total + n }
//
// `f` borrows the window and returns whatever the scan produced: a count, a position
// list, a checksum. It is a plain function for the reason `parallelMap`'s is: each
// worker needs its own copy, and a capturing closure would be moved into the first
// task and gone for the rest. Anything the scan depends on beyond the bytes travels
// as a global or a constant inside `f`.
//
// A match that begins inside a window's overlap is also visible to the next window,
// so a counting `f` must stop at `w.ownLen()`, not `w.len()`.
pub fn parallelScanStr<R>(s: string, windows: i64, overlap: i64, f: (&StrShard) => R): Scanned<R> {
    var owner = shatterStr(s, windows)
    var ws = owner.windows(overlap)
    var ps: Vec<Promise<ScanPart<R>>> = Vec.new()
    while ws.len > 0 {
        let w = ws.pop()!
        ps.push(Promise<ScanPart<R>>.blocking(move(): ScanPart<R> => {
            let r = f(w)
            return ScanPart {
                window: w, result: r
            }
        }
        ))
    }
    var parts = Promise.all(ps).await()!
    // Windows were popped from the tail, so `parts` is in reverse index order;
    // popping again restores it, and `weld` checks the set regardless of order.
    var back: Vec<StrShard> = Vec.new()
    var results: Vec<R> = Vec.new()
    while parts.len > 0 {
        let part = parts.pop()!
        back.push(part.window)
        results.push(part.result)
    }
    let text = owner.weld(back)
    return Scanned {
        text: text, results: results
    }
}
