// std/hashmap: HashMap method bodies written in Milo (docs/collections-in-std.md).
//
// HashMap stays a builtin type: the checker owns its type rules and codegen still owns
// new, insert, for-in, drop and display. The methods here read the same table through
// MapRaw, which mirrors codegen's %HashMap layout field for field, so both sides agree
// on every slot. Hashing and key comparison go through _mapHash/_mapKeyEq, the code the
// builtin methods emit, so a key hashes to the same slot whichever side probes it.
// _mapCopyOut is the structural deep copy the builtin lookups made of a stored value.
//
// Table: open addressing, linear probing, capacity a power of two (at least 8). A slot is
// empty (0), occupied (1) or a tombstone (2); a probe stops only at an empty slot.

struct MapSlot<K, V> {
    state: i8,
    key: K,
    value: V,
}

struct MapRaw<K, V> {
    _data: *MapSlot<K, V>,
    _len: i64,
    _cap: i64,
    _seed: i64,
    _tombs: i64,
}

// The slot holding `key`, or -1 when it is absent.
fn mapFind<K, V>(m: &HashMap<K, V>, key: &K): i64 {
    unsafe {
        let raw = (m.addrOf() as *u8) as *MapRaw<K, V>
        let data = raw[0]._data
        let mask = raw[0]._cap.wrappingSub(1)
        var slot = _mapHash(key, raw[0]._seed) & mask
        while true {
            let state = data[slot].state
            if state == 0 {
                return -1
            }
            if state == 1 && _mapKeyEq(key, data[slot].key) {
                return slot
            }
            slot = slot.wrappingAdd(1) & mask
        }
        return -1
    }
}

// Moves the value at `p` out and drops it, leaving the bytes behind as dead storage.
fn mapDropAt<T>(p: *T) {
    unsafe {
        let _gone = *p
    }
}

impl HashMap<K, V> {
    // Remove `key` and its value, if present. The slot becomes a tombstone, so later
    // probes walk past it; the key and value are dropped in place, key first.
    fn remove(self: &mut Self, key: &K): void {
        unsafe {
            var raw = (self.addrOf() as *u8) as *MapRaw<K, V>
            var data = raw[0]._data
            let mask = raw[0]._cap.wrappingSub(1)
            var slot = _mapHash(key, raw[0]._seed) & mask
            while true {
                let state = data[slot].state
                if state == 0 {
                    return
                }
                if state == 1 && _mapKeyEq(key, data[slot].key) {
                    data[slot].state = 2
                    mapDropAt(data[slot].key.addrOf())
                    mapDropAt(data[slot].value.addrOf())
                    raw[0]._len = raw[0]._len.wrappingSub(1)
                    // insert's resize trigger counts tombstones toward the load factor.
                    raw[0]._tombs = raw[0]._tombs.wrappingAdd(1)
                    return
                }
                slot = slot.wrappingAdd(1) & mask
            }
        }
    }

    // Run `f` on the value under `key` in place; false when the key is absent. The
    // checker borrows the map for the callback, so `f` cannot insert into or remove from it.
    fn modify(self: &mut Self, key: &K, f: (&mut V) => void): bool {
        unsafe {
            var raw = (self.addrOf() as *u8) as *MapRaw<K, V>
            var data = raw[0]._data
            let mask = raw[0]._cap.wrappingSub(1)
            var slot = _mapHash(key, raw[0]._seed) & mask
            while true {
                let state = data[slot].state
                if state == 0 {
                    return false
                }
                if state == 1 && _mapKeyEq(key, data[slot].key) {
                    f(&mut data[slot].value)
                    return true
                }
                slot = slot.wrappingAdd(1) & mask
            }
            return false
        }
    }

    // Insert `init()` under `key` when the key is absent; true when it did. The key is
    // taken by value: a miss stores it, a hit drops it. `init` runs only on a miss; the
    // checker borrows the map for it, so it may read the map but not change it.
    //
    // A miss probes twice (here, then again inside insert) because insert is still
    // builtin; an insert-at-slot helper shared with insert removes the second probe
    // once insert moves into std.
    fn getOrInsertWith(self: &mut Self, key: K, init: () => V): bool {
        unsafe {
            let raw = (self.addrOf() as *u8) as *MapRaw<K, V>
            let data = raw[0]._data
            let mask = raw[0]._cap.wrappingSub(1)
            var slot = _mapHash(key, raw[0]._seed) & mask
            while true {
                let state = data[slot].state
                if state == 0 {
                    break
                }
                if state == 1 && _mapKeyEq(key, data[slot].key) {
                    return false
                }
                slot = slot.wrappingAdd(1) & mask
            }
        }
        self.insert(key, init())
        return true
    }

    // A copy of every key, in slot order (unspecified, varies per process with the seed:
    // sort the result for a stable order).
    fn keys(self: &Self): Vec<K> {
        var out: Vec<K> = Vec.withCapacity(self.len)
        unsafe {
            let raw = (self.addrOf() as *u8) as *MapRaw<K, V>
            let data = raw[0]._data
            let cap = raw[0]._cap
            var i: i64 = 0
            while i < cap {
                if data[i].state == 1 {
                    out.push(_mapCopyOut(data[i].key))
                }
                i = i + 1
            }
        }
        return out
    }

    // A copy of every value, in the same slot order as keys().
    fn values(self: &Self): Vec<V> {
        var out: Vec<V> = Vec.withCapacity(self.len)
        unsafe {
            let raw = (self.addrOf() as *u8) as *MapRaw<K, V>
            let data = raw[0]._data
            let cap = raw[0]._cap
            var i: i64 = 0
            while i < cap {
                if data[i].state == 1 {
                    out.push(_mapCopyOut(data[i].value))
                }
                i = i + 1
            }
        }
        return out
    }

    // Remove every entry. Capacity and the hash seed are kept: clear() empties the map,
    // it does not give the table back, so refilling it reuses the slots (Vec.clear too).
    fn clear(self: &mut Self): void {
        unsafe {
            var raw = (self.addrOf() as *u8) as *MapRaw<K, V>
            var data = raw[0]._data
            let cap = raw[0]._cap
            var i: i64 = 0
            while i < cap {
                if data[i].state == 1 {
                    mapDropAt(data[i].key.addrOf())
                    mapDropAt(data[i].value.addrOf())
                }
                // Tombstones go too: every slot is empty again, so probes stop at once.
                data[i].state = 0
                i = i + 1
            }
            raw[0]._len = 0
            raw[0]._tombs = 0
        }
    }

    // True when the map holds no entries.
    fn isEmpty(self: &Self): bool {
        return self.len == 0
    }

    // True when `key` is in the map.
    fn contains(self: &Self, key: &K): bool {
        return mapFind(self, key) >= 0
    }

    // A copy of the value under `key`, or `fallback` when the key is absent. `fallback`
    // is taken by value: a miss returns it, a hit drops it.
    //
    // The copying lookups probe inline rather than through mapFind: returning the slot and
    // testing it again measured about 4% slower than the builtin on a 600M-lookup loop.
    fn getOrDefault(self: &Self, key: &K, fallback: V): V {
        unsafe {
            let raw = (self.addrOf() as *u8) as *MapRaw<K, V>
            let data = raw[0]._data
            let mask = raw[0]._cap.wrappingSub(1)
            var slot = _mapHash(key, raw[0]._seed) & mask
            while true {
                let state = data[slot].state
                if state == 0 {
                    return fallback
                }
                if state == 1 && _mapKeyEq(key, data[slot].key) {
                    return _mapCopyOut(data[slot].value)
                }
                slot = slot.wrappingAdd(1) & mask
            }
            return fallback
        }
    }

    // A copy of the value under `key`, or None when the key is absent. The variants are
    // qualified: a user fn named `Some` shadows the bare alias program-wide.
    fn get(self: &Self, key: &K): Option<V> {
        unsafe {
            let raw = (self.addrOf() as *u8) as *MapRaw<K, V>
            let data = raw[0]._data
            let mask = raw[0]._cap.wrappingSub(1)
            var slot = _mapHash(key, raw[0]._seed) & mask
            while true {
                let state = data[slot].state
                if state == 0 {
                    return Option.None
                }
                if state == 1 && _mapKeyEq(key, data[slot].key) {
                    return Option.Some(_mapCopyOut(data[slot].value))
                }
                slot = slot.wrappingAdd(1) & mask
            }
            return Option.None
        }
    }
}
