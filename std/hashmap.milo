// std/hashmap: HashMap method bodies written in Milo (docs/collections-in-std.md).
//
// HashMap stays a builtin type: the checker owns its type rules and codegen still owns
// new, for-in, drop and display. The methods here read the same table through MapRaw,
// which mirrors codegen's %HashMap layout field for field, so both sides agree on every
// slot. Hashing and key comparison go through _mapHash/_mapKeyEq, the code codegen
// emits for them, so a key hashes to the same slot whichever side probes it.
// _mapCopyOut is the structural deep copy the builtin lookups made of a stored value;
// _mapSeed and _mapAlloc are codegen's seed source and checked allocation.
//
// Table: open addressing, linear probing, capacity a power of two (at least 8). A slot is
// empty (0), occupied (1) or a tombstone (2); a probe stops only at an empty slot.

struct MapSlot<K, V> {
    state: i8,
    key: K,
    value: V,
}

struct MapRaw<K, V> {
    _data: *MapSlot<K, V>,
    _len: i64,
    _cap: i64,
    _seed: i64,
    _tombs: i64,
}

// Declared here, as std/string does, so the prelude's map pulls in no other module.
extern fn free(p: *u8): void

// The table helpers below take the map as a `*MapRaw` and rebind it with `var`: a store
// through `p[0].field` needs `p` itself bound mutably, and parameters are immutable.

// The slot holding `key`, or -1 when it is absent.
fn mapFind<K, V>(m: &HashMap<K, V>, key: &K): i64 {
    unsafe {
        let raw = (m.addrOf() as *u8) as *MapRaw<K, V>
        let data = raw[0]._data
        let mask = raw[0]._cap.wrappingSub(1)
        var slot = _mapHash(key, raw[0]._seed) & mask
        while true {
            let state = data[slot].state
            if state == 0 {
                return -1
            }
            if state == 1 && _mapKeyEq(key, data[slot].key) {
                return slot
            }
            slot = slot.wrappingAdd(1) & mask
        }
        return -1
    }
}

// Moves the value at `p` out and drops it, leaving the bytes behind as dead storage.
fn mapDropAt<T>(p: *T) {
    unsafe {
        let _gone = *p
    }
}

// The table's seed, drawn on the first insert. A fresh map has seed 0 so building one
// that is never filled costs no entropy; a draw of 0 is replaced by FNV's offset basis
// (14695981039346656037 as an i64), since 0 is what "not seeded yet" means.
fn mapSeeded<K, V>(table: *MapRaw<K, V>): void {
    unsafe {
        var raw = table
        if raw[0]._seed == 0 {
            var seed = _mapSeed()
            if seed == 0 {
                seed = -3750763034362895579
            }
            raw[0]._seed = seed
        }
    }
}

// Whether one more entry would pass the 3/4 load factor. Tombstones count: a probe stops
// only at an empty slot, so the table must always keep one, and insert/remove churn would
// otherwise tombstone every slot while `_len` stays near zero.
fn mapNeedsGrow<K, V>(raw: *MapRaw<K, V>): bool {
    unsafe {
        let load = raw[0]._len.wrappingAdd(raw[0]._tombs).wrappingAdd(1)
        return load.wrappingMul(4) >= raw[0]._cap.wrappingMul(3)
    }
}

// Doubles the table, rehashing every live entry. Inlined so the map's address never
// reaches a call LLVM keeps out of line: an escaped map stays in memory, and the insert
// loop then reloads every field (9% slower than the builtin on an overwrite loop).
// The new slots are allocated here rather than in mapRehash: an allocation failure is the
// one panic of a grow, so @trackCaller reports it at the caller's insert while mapRehash,
// which cannot panic, stays a single copy.
@inline
@trackCaller
fn mapGrow<K, V>(table: *MapRaw<K, V>): void {
    unsafe {
        var raw = table
        let cap = raw[0]._cap.wrappingMul(2)
        let fresh = _mapAlloc(cap, sizeOf<MapSlot<K, V>>()) as *MapSlot<K, V>
        raw[0]._data = mapRehash(raw[0]._data, raw[0]._cap, fresh, cap, raw[0]._seed)
        raw[0]._cap = cap
        raw[0]._tombs = 0
    }
}

// Fills `fresh`, a zeroed array of `cap` slots, with every live entry of `old` rehashed
// with the same seed, and frees `old`. Tombstones are not carried over, which is what
// clears them.
fn mapRehash<K, V>(old: *MapSlot<K, V>, oldCap: i64, fresh: *MapSlot<K, V>, cap: i64, seed: i64): *MapSlot<K, V> {
    unsafe {
        var data = fresh
        let mask = cap.wrappingSub(1)
        var i: i64 = 0
        while i < oldCap {
            if old[i].state == 1 {
                var slot = _mapHash(old[i].key, seed) & mask
                while data[slot].state != 0 {
                    slot = slot.wrappingAdd(1) & mask
                }
                // Bitwise moves: the old array is freed without dropping anything in it.
                data[slot].state = 1
                * data[slot].key.addrOf() = *old[i].key.addrOf()
                * data[slot].value.addrOf() = *old[i].value.addrOf()
            }
            i = i.wrappingAdd(1)
        }
        free(old as *u8)
        return data
    }
}

// The slot holding `key` (>= 0), or, when it is absent, -1 - the slot an insert takes:
// the first tombstone the probe passed, else the empty slot that ended it. Stopping at
// the tombstone instead of remembering it would let insert write a second copy of a key
// stored further along the chain.
fn mapProbeInsert<K, V>(raw: *MapRaw<K, V>, key: &K): i64 {
    unsafe {
        let data = raw[0]._data
        let mask = raw[0]._cap.wrappingSub(1)
        var slot = _mapHash(key, raw[0]._seed) & mask
        var tomb: i64 = -1
        while true {
            let state = data[slot].state
            if state == 0 {
                if tomb >= 0 {
                    return (-1).wrappingSub(tomb)
                }
                return (-1).wrappingSub(slot)
            }
            if state == 1 {
                if _mapKeyEq(key, data[slot].key) {
                    return slot
                }
            } else if tomb < 0 {
                tomb = slot
            }
            slot = slot.wrappingAdd(1) & mask
        }
        return -1
    }
}

// Store a new entry in the vacant `slot` mapProbeInsert chose. Reusing a tombstone
// retires it, or the count only grows and the table rehashes on a load it does not carry.
fn mapStoreAt<K, V>(table: *MapRaw<K, V>, slot: i64, key: K, value: V): void {
    unsafe {
        var raw = table
        var data = raw[0]._data
        if data[slot].state == 2 {
            raw[0]._tombs = raw[0]._tombs.wrappingSub(1)
        }
        data[slot].state = 1
        * data[slot].key.addrOf() = key
        * data[slot].value.addrOf() = value
        raw[0]._len = raw[0]._len.wrappingAdd(1)
    }
}

// `HashMap.new()`: the checker infers <K, V> from the context and lowers the call here.
@trackCaller
fn mapNew<K, V>(): HashMap<K, V> {
    return mapWithSlots(8)
}

// `HashMap.withCapacity(n)`: a table that takes n entries without growing. Insert grows
// when (len + 1) * 4 >= cap * 3, so cap must exceed 4(n + 1)/3; it is rounded up to a power
// of two (the probe masks with cap - 1) from 8. The caller has already refused a negative
// n, at its own line. Checked arithmetic: from n = 2^61 - 1 the product overflows and
// panics ("integer overflow", at the caller's line under @trackCaller), the same panic
// the allocation's size check gives for every smaller n too large to allocate. Wrapping
// arithmetic here turned n = 2^62 into an 8-slot table.
@trackCaller
fn mapWithCapacity<K, V>(n: i64): HashMap<K, V> {
    let want = (n + 1) * 4 / 3 + 1
    var cap = 8
    while cap < want {
        cap = cap * 2
    }
    return mapWithSlots(cap)
}

// An empty map of `cap` zeroed slots. Seed 0 means "draw one on the first insert", so a
// map that is never filled costs no entropy. The map is built in place: zeroed gives
// every field 0 (len, seed and tombstones stay that way), then data and cap are written
// through its address, the same MapRaw view every method uses. A HashMap has no Drop of
// its own to run on the zeroed value, and nothing reads it before both fields are set.
@trackCaller
fn mapWithSlots<K, V>(cap: i64): HashMap<K, V> {
    unsafe {
        var m = zeroed<HashMap<K, V>>()
        var raw = (m.addrOf() as *u8) as *MapRaw<K, V>
        raw[0]._data = _mapAlloc(cap, sizeOf<MapSlot<K, V>>()) as *MapSlot<K, V>
        raw[0]._cap = cap
        return m
    }
}

impl HashMap<K, V> {
    // Remove `key` and its value, if present. The slot becomes a tombstone, so later
    // probes walk past it; the key and value are dropped in place, key first.
    fn remove(self: &mut Self, key: &K): void {
        unsafe {
            var raw = (self.addrOf() as *u8) as *MapRaw<K, V>
            var data = raw[0]._data
            let mask = raw[0]._cap.wrappingSub(1)
            var slot = _mapHash(key, raw[0]._seed) & mask
            while true {
                let state = data[slot].state
                if state == 0 {
                    return
                }
                if state == 1 && _mapKeyEq(key, data[slot].key) {
                    data[slot].state = 2
                    mapDropAt(data[slot].key.addrOf())
                    mapDropAt(data[slot].value.addrOf())
                    raw[0]._len = raw[0]._len.wrappingSub(1)
                    // insert's resize trigger counts tombstones toward the load factor.
                    raw[0]._tombs = raw[0]._tombs.wrappingAdd(1)
                    return
                }
                slot = slot.wrappingAdd(1) & mask
            }
        }
    }

    // Run `f` on the value under `key` in place; false when the key is absent. The
    // checker borrows the map for the callback, so `f` cannot insert into or remove from it.
    fn modify(self: &mut Self, key: &K, f: (&mut V) => void): bool {
        unsafe {
            var raw = (self.addrOf() as *u8) as *MapRaw<K, V>
            var data = raw[0]._data
            let mask = raw[0]._cap.wrappingSub(1)
            var slot = _mapHash(key, raw[0]._seed) & mask
            while true {
                let state = data[slot].state
                if state == 0 {
                    return false
                }
                if state == 1 && _mapKeyEq(key, data[slot].key) {
                    f(&mut data[slot].value)
                    return true
                }
                slot = slot.wrappingAdd(1) & mask
            }
            return false
        }
    }

    // Store `value` under `key`. An existing entry keeps its key and gets the new value
    // (the old value is dropped first, then the key passed in); the table doubles when one
    // more entry would pass the 3/4 load factor. The checker moves the key before it
    // checks the value, so `m.insert(k, m.get(k))` is a use after move.
    //
    // @inline: the hash and probe cost LLVM about twice its inlining threshold, and a
    // called insert measured 45% slower than the inline builtin on a 40M-overwrite loop.
    // @trackCaller: a failed allocation while growing names the caller's insert line.
    @inline
    @trackCaller
    fn insert(self: &mut Self, key: K, value: V): void {
        unsafe {
            let raw = (self.addrOf() as *u8) as *MapRaw<K, V>
            mapSeeded(raw)
            if mapNeedsGrow(raw) {
                mapGrow(raw)
            }
            let at = mapProbeInsert(raw, key)
            if at >= 0 {
                let data = raw[0]._data
                mapDropAt(data[at].value.addrOf())
                * data[at].value.addrOf() = value
                return
            }
            mapStoreAt(raw, (-1).wrappingSub(at), key, value)
        }
    }

    // Insert `init()` under `key` when the key is absent; true when it did. The key is
    // taken by value: a miss stores it, a hit drops it. `init` runs only on a miss; the
    // checker borrows the map for it, so it may read the map but not change it, and the
    // vacant slot the probe found is still the one to fill afterwards.
    @trackCaller
    fn getOrInsertWith(self: &mut Self, key: K, init: () => V): bool {
        unsafe {
            let raw = (self.addrOf() as *u8) as *MapRaw<K, V>
            var at = mapProbeInsert(raw, key)
            if at >= 0 {
                return false
            }
            let value = init()
            // Seeding or growing moves every slot, so only then is the key probed again. A
            // hit never grows the table, as with the builtin.
            if raw[0]._seed == 0 || mapNeedsGrow(raw) {
                mapSeeded(raw)
                if mapNeedsGrow(raw) {
                    mapGrow(raw)
                }
                at = mapProbeInsert(raw, key)
            }
            mapStoreAt(raw, (-1).wrappingSub(at), key, value)
            return true
        }
    }

    // A copy of every key, in slot order (unspecified, varies per process with the seed:
    // sort the result for a stable order).
    fn keys(self: &Self): Vec<K> {
        var out: Vec<K> = Vec.withCapacity(self.len)
        unsafe {
            let raw = (self.addrOf() as *u8) as *MapRaw<K, V>
            let data = raw[0]._data
            let cap = raw[0]._cap
            var i: i64 = 0
            while i < cap {
                if data[i].state == 1 {
                    out.push(_mapCopyOut(data[i].key))
                }
                i = i + 1
            }
        }
        return out
    }

    // A copy of every value, in the same slot order as keys().
    fn values(self: &Self): Vec<V> {
        var out: Vec<V> = Vec.withCapacity(self.len)
        unsafe {
            let raw = (self.addrOf() as *u8) as *MapRaw<K, V>
            let data = raw[0]._data
            let cap = raw[0]._cap
            var i: i64 = 0
            while i < cap {
                if data[i].state == 1 {
                    out.push(_mapCopyOut(data[i].value))
                }
                i = i + 1
            }
        }
        return out
    }

    // Remove every entry. Capacity and the hash seed are kept: clear() empties the map,
    // it does not give the table back, so refilling it reuses the slots (Vec.clear too).
    fn clear(self: &mut Self): void {
        unsafe {
            var raw = (self.addrOf() as *u8) as *MapRaw<K, V>
            var data = raw[0]._data
            let cap = raw[0]._cap
            var i: i64 = 0
            while i < cap {
                if data[i].state == 1 {
                    mapDropAt(data[i].key.addrOf())
                    mapDropAt(data[i].value.addrOf())
                }
                // Tombstones go too: every slot is empty again, so probes stop at once.
                data[i].state = 0
                i = i + 1
            }
            raw[0]._len = 0
            raw[0]._tombs = 0
        }
    }

    // A deep copy. _mapCopyOut is codegen's structural HashMap copy (emitDeepCloneFromPtr),
    // the same code that copies a map nested in a struct, Vec or Option: the slot array is
    // memcpy'd with its seed and tombstones and each live key/value is copied, so the clone
    // iterates in the source's order. Written here rather than as malloc + a slot loop so
    // there stays one implementation of "copy a map".
    fn clone(self: &Self): HashMap<K, V> {
        return _mapCopyOut(self)
    }

    // True when the map holds no entries.
    fn isEmpty(self: &Self): bool {
        return self.len == 0
    }

    // True when `key` is in the map.
    fn contains(self: &Self, key: &K): bool {
        return mapFind(self, key) >= 0
    }

    // A copy of the value under `key`, or `fallback` when the key is absent. `fallback`
    // is taken by value: a miss returns it, a hit drops it.
    //
    // The copying lookups probe inline rather than through mapFind: returning the slot and
    // testing it again measured about 4% slower than the builtin on a 600M-lookup loop.
    fn getOrDefault(self: &Self, key: &K, fallback: V): V {
        unsafe {
            let raw = (self.addrOf() as *u8) as *MapRaw<K, V>
            let data = raw[0]._data
            let mask = raw[0]._cap.wrappingSub(1)
            var slot = _mapHash(key, raw[0]._seed) & mask
            while true {
                let state = data[slot].state
                if state == 0 {
                    return fallback
                }
                if state == 1 && _mapKeyEq(key, data[slot].key) {
                    return _mapCopyOut(data[slot].value)
                }
                slot = slot.wrappingAdd(1) & mask
            }
            return fallback
        }
    }

    // A copy of the value under `key`, or None when the key is absent. The variants are
    // qualified: a user fn named `Some` shadows the bare alias program-wide.
    fn get(self: &Self, key: &K): Option<V> {
        unsafe {
            let raw = (self.addrOf() as *u8) as *MapRaw<K, V>
            let data = raw[0]._data
            let mask = raw[0]._cap.wrappingSub(1)
            var slot = _mapHash(key, raw[0]._seed) & mask
            while true {
                let state = data[slot].state
                if state == 0 {
                    return Option.None
                }
                if state == 1 && _mapKeyEq(key, data[slot].key) {
                    return Option.Some(_mapCopyOut(data[slot].value))
                }
                slot = slot.wrappingAdd(1) & mask
            }
            return Option.None
        }
    }
}
