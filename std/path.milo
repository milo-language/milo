// std/path — file path manipulation

// Get the file extension including the dot. Returns "" if none.

// File extension including the leading dot (e.g. ".txt"); empty if none.
fn pathExt(path: &string): string {
    var i: i64 = path.len - 1
    while i >= 0 as i64 {
        if path[i] == 46 {
            return path.substr(i, path.len)
        }
        if path[i] == 47 {
            return ""
        }
        i -= 1
    }
    return ""
}

// Get the last component of a path.

// Final component of the path (the file name), directories stripped.
fn pathBasename(path: &string): string {
    if path.len == 0 {
        return ""
    }
    var end: i64 = path.len
    // strip trailing slashes
    while end > 0 as i64 && path[end - 1] == 47 {
        end -= 1
    }
    if end == 0 as i64 {
        return "/"
    }
    var i: i64 = end - 1
    while i >= 0 as i64 {
        if path[i] == 47 {
            return path.substr(i + 1, end)
        }
        i -= 1
    }
    return path.substr(0 as i64, end)
}

// Get the directory portion of a path.

// Directory portion of the path (everything before the final component).
fn pathDirname(path: &string): string {
    if path.len == 0 {
        return "."
    }
    var end: i64 = path.len
    // strip trailing slashes
    while end > 0 as i64 && path[end - 1] == 47 {
        end -= 1
    }
    if end == 0 as i64 {
        return "/"
    }
    // find last slash
    var i: i64 = end - 1
    while i >= 0 as i64 {
        if path[i] == 47 {
            if i == 0 as i64 {
                return "/"
            }
            return path.substr(0 as i64, i)
        }
        i -= 1
    }
    return "."
}

// Join two path components with a separator.

// Join two segments with a single "/" separator (avoids doubling an existing one).
fn pathJoin(a: &string, b: &string): string {
    if a.len == 0 {
        return b.clone()
    }
    if b.len == 0 {
        return a.clone()
    }
    if a[a.len - 1] == 47 {
        return a + b
    }
    return a + "/" + b
}

// Get the filename without extension.

// File name without its extension (basename minus pathExt).
fn pathStem(path: &string): string {
    let base = pathBasename(path)
    var i: i64 = base.len - 1
    while i > 0 as i64 {
        if base[i] == 46 {
            return base.substr(0 as i64, i)
        }
        i -= 1
    }
    return base
}

// Stateless path operations grouped for discoverability.
pub struct Path {
}

impl Path {
    // File extension including the dot, or "" if there is none:
    // `Path.ext("archive.tar.gz")` is ".gz".
    fn ext(path: &string): string {
        return pathExt(path)
    }
    // Final component of the path: `Path.basename("/home/user/file.txt")` is
    // "file.txt".
    fn basename(path: &string): string {
        return pathBasename(path)
    }
    // Directory portion of the path: `Path.dirname("/home/user/file.txt")` is
    // "/home/user".
    fn dirname(path: &string): string {
        return pathDirname(path)
    }
    // Join two segments with a single "/": `Path.join("/home/user", "docs")` is
    // "/home/user/docs".
    fn join(a: &string, b: &string): string {
        return pathJoin(a, b)
    }
    // File name without its extension: `Path.stem("report.pdf")` is "report".
    fn stem(path: &string): string {
        return pathStem(path)
    }
}
