// std/runtime — green thread scheduler using ucontext for stackful coroutines
//
// Task layout (88 bytes, 8-byte aligned):
//   0: context (*u8)      8: stack (*u8)       16: totalStackSize (i64)
//  24: state (i32)        28: waitFd (i32)      32: waitWrite (u8) + 7 pad
//  40: next (*u8)         48: closureFn (*u8)   56: closureEnv (*u8)
//  64: sched (*u8)  — home scheduler, lets a foreign thread unpark this task
//  72: joiner (*u8) — a green task parked in Task.join, unparked on completion
//  80: joinCell (*u8) — the shared done-signal cell (see taskCellNew), allocated
//       at spawn and set to done=1 on completion. It lives OUTSIDE this struct so
//       a late join can read "done" after the struct is reaped/freed — the Task
//       handle holds the other ref. Joiner is still registered before completion
//       (cooperative), but a late/double join is now memory-safe, not a UAF.
//
// Scheduler layout (80 bytes):
//   0: context (*u8)       8: runHead (*u8)     16: runTail (*u8)
//  24: current (*u8)      32: numTasks (i64)    40: eventLoopFd (i32)  44: wakeupId (i32)
//  48: waitHead (*u8)     56: xferMutex (*u8)   64: xferHead (*u8)    72: selFdHead (*u8)
//
// selFdHead: intrusive list of select fd/timer waiter Nodes (see below). Read
// arms register their fd with the event loop; the poll loop claims the owning
// Select when the fd fires or a timer deadline passes.

from "std/os" import {
    malloc, free, memcpy, memset
}
from "std/platform" import {
    getcontext, makecontext, swapcontext,
    uctxSize, uctxStackPtrOffset, uctxStackSizeOffset, uctxLinkOffset,
    protRead, protWrite, protNone, mapPrivate, mapAnon,
    pthread_mutex_init, pthread_mutex_lock, pthread_mutex_unlock, pthread_mutex_destroy, pthread_cond_init, pthread_cond_signal, pthread_cond_wait, pthread_cond_destroy, pthread_create, pthread_detach,
    mmap, munmap, mprotect
}
from "std/event" import {
    EventLoop, eventLoopNew, eventLoopFromFd, eventLoopFd, eventPoll, eventRegisterRead, eventRegisterWrite, eventDeregister, eventLoopClose, eventLoopInitWakeup, eventLoopNotify, eventLoopDrainWakeup, eventLoopCloseWakeup
}
from "std/sync" import {
    Channel
}
from "std/time" import {
    epochMillis
}

// ── constants ──

pub fn taskReady(): i32 {
    return 0
}

pub fn taskRunning(): i32 {
    return 1
}

pub fn taskWaitingIo(): i32 {
    return 2
}

pub fn taskDone(): i32 {
    return 3
}

// parked: off every scheduler list; whoever holds the task pointer (e.g. a
// channel waiter entry) is responsible for a future schedulerUnpark
pub fn taskWaitingPark(): i32 {
    return 4
}

pub fn defaultStackSize(): i64 {
    return 1048576
}

pub fn guardPageSize(): i64 {
    return 4096
}

// The main task's stack. `main` keeps running the same code once it becomes a
// green task, and the OS main thread it used to run on gets 8 MB on darwin and
// linux — so the 1 MB default green stack would fault a recursive-descent
// parser that was fine as a plain `main`. Match the OS instead of the default.
pub fn mainTaskStackSize(): i64 {
    return 8388608
}

pub fn taskStructSize(): i64 {
    return 88
}

pub fn schedStructSize(): i64 {
    return 88
}

// task field offsets
pub fn tCtx(): i64 {
    return 0
}

pub fn tStack(): i64 {
    return 8
}

pub fn tStackSize(): i64 {
    return 16
}

pub fn tState(): i64 {
    return 24
}

pub fn tWaitFd(): i64 {
    return 28
}

pub fn tWaitWrite(): i64 {
    return 32
}

pub fn tNext(): i64 {
    return 40
}

pub fn tClosureFn(): i64 {
    return 48
}

pub fn tClosureEnv(): i64 {
    return 56
}

pub fn tSched(): i64 {
    return 64
}

pub fn tJoiner(): i64 {
    return 72
}

pub fn tJoinCell(): i64 {
    return 80
}

// scheduler field offsets
pub fn sCtx(): i64 {
    return 0
}

pub fn sRunHead(): i64 {
    return 8
}

pub fn sRunTail(): i64 {
    return 16
}

pub fn sCurrent(): i64 {
    return 24
}

pub fn sNumTasks(): i64 {
    return 32
}

pub fn sElFd(): i64 {
    return 40
}

pub fn sWakeupId(): i64 {
    return 44
}

// waiting list head (tasks blocked on I/O)
pub fn sWaitHead(): i64 {
    return 48
}

// cross-thread unpark transfer list (mutex-guarded; drained after each poll)
pub fn sXferMutex(): i64 {
    return 56
}

pub fn sXferHead(): i64 {
    return 64
}

// select fd/timer waiter list (scheduler thread only)
pub fn sSelFdHead(): i64 {
    return 72
}

// A task parked inside schedulerRunToCompletion, waiting for every OTHER task
// to finish. Woken by the reaper, not by an fd — "the task list is empty" is
// not an event the poll can observe.
pub fn sDrainWaiter(): i64 {
    return 80
}

// ── select waiter node (48 bytes) ──
// One layout serves every waiter: a plain parked task on a channel list, and
// each armed Select arm (channel recv/send, fd read/write, timer). Channel
// lists (recvWaitHead/sendWaitHead) hold kind 0/1/2; the scheduler's selFdHead
// holds kind 3/4/5.
pub fn nodeKind(): i64 {
    return 0
} // 0 plain, 1 sel-recv, 2 sel-send, 3 sel-read, 4 sel-write, 5 sel-timer

pub fn nodeNext(): i64 {
    return 8
}

pub fn nodeA(): i64 {
    return 16
} // plain: task ptr; select: SelectState ptr

pub fn nodeArm(): i64 {
    return 24
} // select arm index

pub fn nodeFd(): i64 {
    return 32
} // sel-read/write fd

pub fn nodeDeadline(): i64 {
    return 40
} // sel-timer deadline (epoch ms)

pub fn nodeSize(): i64 {
    return 48
}

pub fn kindPlain(): i64 {
    return 0
}

pub fn kindSelRecv(): i64 {
    return 1
}

pub fn kindSelSend(): i64 {
    return 2
}

pub fn kindSelRead(): i64 {
    return 3
}

pub fn kindSelWrite(): i64 {
    return 4
}

pub fn kindSelTimer(): i64 {
    return 5
}

// ── SelectState (40 bytes) ──
// Shared by all arms of one Select. `claimed` records the winning arm (-1 until
// a source fires); the mutex serializes the claim so at most one arm wins even
// across a foreign pthread firing a channel. `parked` gates the unpark so a
// claim that lands before the task commits to parking never queues a stale wake.
pub fn ssMtx(): i64 {
    return 0
}

pub fn ssClaimed(): i64 {
    return 8
}

pub fn ssTask(): i64 {
    return 16
}

pub fn ssParked(): i64 {
    return 24
}

// Signalled by _selectTryClaim. Only the no-scheduler main context waits on it: a green
// task parks instead, and a main context WITH a scheduler polls it. That leaves the case
// where the only thing that can fire an arm is a foreign pthread (Promise.blocking with no
// green task anywhere) — there is no scheduler to drive and no task to unpark, so without
// this the wait had nothing to block on and returned -1 immediately.
pub fn ssCond(): i64 {
    return 32
}

pub fn selectStateSize(): i64 {
    return 40
}

// ── helpers to read/write i64, i32, ptr at offset ──

pub fn rtReadI64(base: *u8, off: i64): i64 {
    unsafe {
        let addr = (base as i64 + off) as *i64
        return *addr
    }
}

pub fn rtWriteI64(base: *u8, off: i64, val: i64): void {
    unsafe {
        memcpy((base as i64 + off) as *u8, (val.addrOf()) as *u8, 8)
    }
}

fn rtReadI32(base: *u8, off: i64): i32 {
    unsafe {
        let addr = (base as i64 + off) as *i32
        return *addr
    }
}

fn rtWriteI32(base: *u8, off: i64, val: i32): void {
    unsafe {
        memcpy((base as i64 + off) as *u8, (val.addrOf()) as *u8, 4)
    }
}

fn rtReadPtr(base: *u8, off: i64): *u8 {
    unsafe {
        let addr = (base as i64 + off) as *i64
        let val = *addr
        return val as *u8
    }
}

pub fn rtWritePtr(base: *u8, off: i64, val: *u8): void {
    unsafe {
        memcpy((base as i64 + off) as *u8, (val.addrOf()) as *u8, 8)
    }
}

// ── task handle ──

// A handle to a spawned green task. `join` blocks the caller until it finishes.
pub struct Task {
    _ptr: *u8,
    // Shared done-signal cell (taskCellNew), also stored in the task struct's
    // joinCell slot. Held here so join() reads completion off the handle, never
    // the reaped struct.
    _cell: *u8,
}

// Task.join done-signal cell — 16 bytes: [0] done flag (0/1), [8] refcount.
// It lives outside the 88-byte task struct because the scheduler frees that
// struct the instant the task completes (reapTask), yet a late join must still
// observe "done" without touching freed memory. Two owners share it — the task
// (until reapTask) and the Task handle (until it drops) — so reap-before-join
// and join-before-reap are both safe. Non-atomic: Task is not Send, so both
// owners live on the spawning thread.
fn taskCellNew(): *u8 {
    unsafe {
        let cell = malloc(16)
        rtWriteI64(cell, 0, 0)
        rtWriteI64(cell, 8, 2)
        return cell
    }
}

fn taskCellDecref(cell: *u8): void {
    if cell as i64 == 0 {
        return
    }
    let rc = rtReadI64(cell, 8) - 1
    rtWriteI64(cell, 8, rc)
    if rc == 0 {
        free(cell)
    }
}

impl Drop for Task {
    // Release the handle's ref on the done-cell. The task struct itself is owned
    // and freed by the scheduler (reapTask), so there is nothing else to reclaim.
    fn drop(self: &mut Self): void {
        taskCellDecref(self._cell)
    }
}

// ── scheduler access ──

fn getSched(): *u8 {
    return _schedulerGet()
}

fn setSched(s: *u8): void {
    _schedulerSet(s)
}

pub fn schedulerEnsureInit(): void {
    unsafe {
        if getSched() as i64 != 0 {
            return
        }

        let sched = malloc(schedStructSize())
        memset(sched, 0, schedStructSize())

        let ctx = malloc(uctxSize())
        memset(ctx, 0, uctxSize())
        getcontext(ctx)
        rtWritePtr(sched, sCtx(), ctx)

        let el = eventLoopNew()!
        rtWriteI32(sched, sElFd(), eventLoopFd(el))
        rtWriteI32(sched, sWakeupId(), eventLoopInitWakeup(el))

        let xmtx = malloc(64)
        pthread_mutex_init(xmtx, 0 as *u8)
        rtWritePtr(sched, sXferMutex(), xmtx)

        setSched(sched)
    }
}

// ── task entry trampoline ──

fn taskEntry(): void {
    let sched = getSched()
    let task = rtReadPtr(sched, sCurrent())
    let fnPtr = rtReadPtr(task, tClosureFn())
    let envPtr = rtReadPtr(task, tClosureEnv())
    _callClosureVoid(fnPtr, envPtr)

    rtWriteI32(task, tState(), taskDone())
    swapcontext(rtReadPtr(task, tCtx()), rtReadPtr(sched, sCtx()))
}

// ── public API ──

impl Task {
    // Spawn a Color.green (M:N) task that runs `f` on the cooperative scheduler, and
    // return a handle to it. Returns immediately — the task does not run until
    // the scheduler is driven (by a blocking IO op, `schedulerYield`, or a
    // `join`). Each task gets its own guard-paged stack. Await completion with
    // `task.join()`.
    fn spawn(f: move () => void): Task {
        return Task.spawnWithStack(f, defaultStackSize())
    }

    // Same as spawn, with an explicit stack size. The default 1 MB is generous
    // for ordinary tasks but far too small for a recursive interpreter: milojs
    // budgets its JS call depth against the 8 MB the OS main thread gets, so
    // running it on a green task needs a comparable stack. The mapping is
    // anonymous and lazily committed, so a larger reservation costs address
    // space rather than resident memory.
    //
    // A task's stack does not grow: one that is too small overflows rather than
    // reallocating.
    fn spawnWithStack(f: move () => void, stackBytes: i64): Task {
        unsafe {
            var fnPtr: *u8 = 0 as *u8
            var envPtr: *u8 = 0 as *u8
            memcpy((fnPtr.addrOf()) as *u8, (f.addrOf()) as *u8, 8)
            memcpy((envPtr.addrOf()) as *u8, ((f.addrOf()) as i64 + 8) as *u8, 8)
            // The task owns the environment from here on, and the checker cannot see that
            // — the transfer happened through a raw memcpy. Without this `f` is dropped at
            // the end of this function and the task runs from a freed environment: the
            // capture read back as an empty string, no crash and no diagnostic.
            forget(f)
            return Task.spawnRaw(fnPtr, envPtr, stackBytes)
        }
    }

    // The closure-free spine of spawnWithStack. `schedulerRunMainRaw` has a bare
    // function pointer and no captures, and wrapping one in a closure just to
    // unwrap it here would heap-allocate an environment that nothing frees —
    // a leak on every program whose main runs as a green task.
    //
    // OWNERSHIP: the spawned task takes `envPtr`. It must be a malloc'd block or null —
    // `reapTask` frees it. Pass 0 for a bare function pointer.
    fn spawnRaw(fnPtr: *u8, envPtr: *u8, stackBytes: i64): Task {
        unsafe {
            schedulerEnsureInit()
            let sched = getSched()

            let task = malloc(taskStructSize())
            memset(task, 0, taskStructSize())
            rtWriteI32(task, tWaitFd(), -1)
            rtWritePtr(task, tClosureFn(), fnPtr)
            rtWritePtr(task, tClosureEnv(), envPtr)
            rtWritePtr(task, tSched(), sched)

            // Register the done-cell up front so a join issued after the task
            // has already completed and been reaped still finds it (no UAF).
            let cell = taskCellNew()
            rtWritePtr(task, tJoinCell(), cell)

            let total = guardPageSize() + stackBytes
            let stackMem = mmap(0 as *u8, total, protRead() | protWrite(), mapPrivate() | mapAnon(), -1, 0 as i64)
            rtWritePtr(task, tStack(), stackMem)
            rtWriteI64(task, tStackSize(), total)

            let ctx = malloc(uctxSize())
            memset(ctx, 0, uctxSize())
            getcontext(ctx)

            let usable = (stackMem as i64 + guardPageSize()) as *u8
            rtWritePtr(ctx, uctxStackPtrOffset(), usable)
            rtWriteI64(ctx, uctxStackSizeOffset(), stackBytes)

            let schedCtx = rtReadPtr(sched, sCtx())
            rtWritePtr(ctx, uctxLinkOffset(), schedCtx)

            makecontext(ctx, taskEntry as *u8, 0)

            mprotect(stackMem, guardPageSize(), protNone())

            rtWritePtr(task, tCtx(), ctx)

            enqueueRun(sched, task)

            let n = rtReadI64(sched, sNumTasks()) + 1
            rtWriteI64(sched, sNumTasks(), n)

            return Task {
                _ptr: task,
                _cell: cell
            }
        }
    }

    // The scheduler's pointer to this task, for `schedulerPark`/`schedulerUnpark`. Opaque:
    // pass it back to std, never read through it.
    fn raw(self: &Self): *u8 {
        return self._ptr
    }

    // Block until the spawned task finishes. Cooperative contract: call join
    // before the target can run (i.e. before yielding/driving the scheduler),
    // so the registration below always precedes completion. A green caller
    // parks; the main thread drives the scheduler until the done cell is set.
    fn join(self: &Self): void {
        let cell = self._cell
        if cell as i64 == 0 {
            return
        }
        // Late/repeat join: the reap flipped done=1 before freeing the task
        // struct, so read the cell and return — never the freed struct.
        if rtReadI64(cell, 0) == 1 {
            return
        }
        let cur = schedulerCurrent()
        if cur as i64 != 0 {
            // Green caller: not-done was just observed and the cooperative
            // scheduler cannot advance the target between here and the park,
            // so self._ptr is still live to register the joiner.
            rtWritePtr(self._ptr, tJoiner(), cur)
            schedulerPark()
        } else {
            // Main caller: drive the scheduler until the reap flips the cell.
            // Only the cell is touched, so a reap that already ran can't UAF.
            while rtReadI64(cell, 0) == 0 {
                schedulerBlockMain()
            }
        }
    }
}

// ── OS-thread escape hatch (internal — powers Promise.blocking) ──
// The only place Milo spawns a real OS thread. Kept private so the public
// concurrency surface stays green-only; CPU-bound / blocking-FFI work rides in
// through Promise.blocking, which delivers its result over a Channel exactly
// like Promise.run. The channel's cross-thread wake path (schedulerUnpark's
// foreign-thread branch → xfer list + eventLoopNotify) is what lets a green
// awaiter park and be woken from this foreign thread.

// pthread entry: unpacks { fnPtr, envPtr }, runs the void closure, frees both.
fn osThreadTrampoline(arg: *u8): *u8 {
    unsafe {
        var fnPtr: *u8 = 0 as *u8
        var envPtr: *u8 = 0 as *u8
        memcpy((fnPtr.addrOf()) as *u8, arg, 8)
        memcpy((envPtr.addrOf()) as *u8, (arg as i64 + 8) as *u8, 8)
        _callClosureVoid(fnPtr, envPtr)
        // A closure environment's first word is its drop glue, and that glue is the whole
        // destructor: it drops each capture still live and then frees the block. Calling it
        // — rather than free()ing the block and orphaning the captures — is what keeps a
        // detached thread from leaking the worker's channel handle, whose refcount would
        // otherwise never reach zero (~5 allocations / 336 bytes per `Promise.blocking`).
        //
        // This is safe only because a move closure's captures now live IN the env slots
        // instead of in private copies (see genClosure): a body that consumes a capture
        // zeroes the slot it came from, so the glue's liveness check skips it. Until that
        // landed, the glue dropped what the body had already handed to a callee, and
        // battleConcurrency died on a shared ChannelHandle whose refcount went one low.
        //
        // The glue pointer is null for a by-reference closure (its env is a stack frame)
        // and the env itself is null when nothing was captured; free() covers both.
        var envGlue: *u8 = 0 as *u8
        if envPtr as i64 != 0 {
            memcpy((envGlue.addrOf()) as *u8, envPtr, 8)
        }
        if envGlue as i64 != 0 {
            _callClosureVoid(envGlue, envPtr)
        } else {
            free(envPtr)
        }
        free(arg)
        return 0 as *u8
    }
}

// Run `f` on a detached OS thread. Detached so its resources are reclaimed at
// thread exit with no join — nothing outlives the worker (the plan's no-leak
// requirement). If main returns first, Go exit semantics abandon it, symmetric
// with an abandoned green task.
// @thread: `f` runs on a real OS thread, so the checker holds its captures to Send and
// rejects unsynchronized mutable globals reached from its body.
@thread
pub fn spawnOsThreadDetached(f: move () => void): void {
    unsafe {
        let packed = malloc(16)
        memcpy(packed, (f.addrOf()) as *u8, 16)
        var tid: i64 = 0
        let r = pthread_create((tid.addrOf()) as *u8, 0 as *u8, osThreadTrampoline as *u8, packed)
        if r == 0 {
            pthread_detach(tid)
            // The thread owns the closure environment now, transferred through the memcpy
            // above, which the checker cannot see. Without this `f` is dropped when this
            // function returns and the thread runs against a released environment.
            forget(f)
        } else {
            free(packed)
        }
    }
}

// ── Promise<T> — a task that returns a value ──

pub struct Promise<T> {
    _ch: Channel<T>,
    // true when the result is produced on a foreign OS thread (Promise.blocking)
    // rather than a green task. Changes only the main-thread await strategy.
    _blocking: bool,
}

// Safety: Promise delegates cross-thread synchronization and ownership transfer
// to its Channel, whose mutex/condition-variable invariants are documented there.
unsafe

impl Send for Promise<T> {
}
unsafe

impl Sync for Promise<T> {
}

// Call `f` and let its captures go before returning.
//
// The hop through a by-value parameter is what does it: passing an owning closure moves
// it, and the environment is released once the call cannot still be using it, which is
// BEFORE the caller's next statement. Inline (`let result = f()` in the worker body) the
// environment instead lives until the worker's own frame is torn down, which happens
// AFTER the result has been sent, so a caller that observed something the closure held
// (a Shared holder count, an open fd, a lock) could still see it alive after await()
// returned. tests/fixtures/promiseCaptureDropOrder.milo pins the ordering.
fn runOnce<T>(f: move () => T): T {
    return f()
}

impl Promise<T> {
    fn _fromChannel(ch: Channel<T>): Promise<T> {
        return Promise {
            _ch: ch,
            _blocking: false
        }
    }

    // The result channel, so a Promise can be armed in a Select:
    //
    //   sel.onRecv(p.channel())           // arm 0
    //   sel.onTimeout(1000)               // arm 1
    //   match sel.wait() { 0 => { let v = p.await()! } 1 => { ... } }
    //
    // This is the bridge from a Promise.blocking OS-thread result into an event-driven
    // wait — previously the two tiers couldn't compose, and an event-driven `timeout`
    // wanted exactly this. Await still owns the fetch: when the arm wins, `await()` does
    // the recv, so don't recv off this handle yourself.
    //
    // Returns a reference-counted clone that shares the underlying queue; the Select
    // arms on its raw pointer. The clone frees itself when it drops — the channel is
    // torn down once this clone and the Promise's own handle are both gone.
    fn channel(self: &Self): Channel<T> {
        return self._ch.clone()
    }

    fn run(f: () => T): Promise<T> {
        let ch = Channel<T>.new(1)!
        let chSend = ch.clone() // worker's owning handle
        Task.spawn(move(): void => {
            let result: T = runOnce(f)
            chSend.send(result)!
        })
        return Promise {
            _ch: ch,
            _blocking: false
        }
    }

    // Run `f` on a real OS thread for CPU-bound work or blocking FFI — anything
    // that would otherwise starve the single-threaded cooperative scheduler.
    // The caller never blocks here; the result arrives over the channel and is
    // collected with await(), like any Promise. Fan out across N cores by
    // pushing several Promise.blocking handles into Promise.all.
    // @thread: `f` crosses to a real OS thread — captures must be Send, and the checker
    // rejects unsynchronized mutable globals reached from its body.
    //
    // `f`'s captures are released BEFORE the result is sent, so once `await()` hands back
    // a value every destructor the closure owned has already run. Without that the
    // environment lived until the worker's frame was torn down, which is after the send,
    // and a caller could hold a result while a lock, an fd or a reader handle the closure
    // captured was still alive. See runOnce.
    @thread
    fn blocking(f: move () => T): Promise<T> {
        let ch = Channel<T>.new(1)!
        let chSend = ch.clone() // worker thread's owning handle
        spawnOsThreadDetached(move(): void => {
            let result: T = runOnce(f)
            chSend.send(result)!
        })
        return Promise {
            _ch: ch,
            _blocking: true
        }
    }

    fn await(self: &Self): Result<T> {
        // inside a green task: parked recv — scheduler keeps running. Works for
        // both flavors: a foreign-thread send wakes the parked task through the
        // channel's cross-thread unpark path.
        if schedulerCurrent() as i64 != 0 {
            let val = self._ch.recv()?
            return Result.Ok(val)
        }
        // main thread, foreign-thread result: block on the channel condvar,
        // which the worker's send signals. Driving the scheduler would not help
        // (the worker is not a green task) and a -1 poll could stall.
        if self._blocking {
            let val = self._ch.recv()?
            return Result.Ok(val)
        }
        // main thread, green-task result: drive the scheduler, blocking the poll
        // on the wakeup fd until the result task completes (no 100ms spin).
        while true {
            let maybe = self._ch.tryRecv()
            match maybe {
                Option.Some(val) => {
                    return Result.Ok(val)
                }
                Option.None => {
                    schedulerBlockMain()
                }
            }
        }
        // unreachable
        unsafe {
            return Result.Ok(zeroed<T>())
        }
    }

}

// standalone generic functions to avoid recursive struct monomorphization
pub fn promiseAll<T>(promises: Vec<Promise<T>>): Promise<Vec<T>> {
    let ch = Channel<Vec<T>>.new(1)!
    let chW = ch.clone()
    Task.spawn(move(): void => {
        var results: Vec<T> = Vec.new()
        for i in 0..promises.len {
            let val = promises[i].await()!
            results.push(val)
        }
        chW.send(results)!
    })
    return Promise<Vec<T>>._fromChannel(ch)
}

pub fn promiseRace<T>(promises: Vec<Promise<T>>): Promise<T> {
    let ch = Channel<T>.new(1)!
    let chW = ch.clone()
    Task.spawn(move(): void => {
        while true {
            var i: i64 = 0
            while i < promises.len {
                let maybe = promises[i]._ch.tryRecv()
                match maybe {
                    Option.Some(val) => {
                        // the remaining promises' channels are torn down when `promises`
                        // (moved into this task) drops at return.
                        chW.send(val)!
                        return
                    }
                    Option.None => {
                    }
                }
                i += 1
            }
            if schedulerCurrent() as i64 != 0 {
                schedulerYield()
            } else {
                schedulerTick()
            }
        }
    })
    return Promise<T>._fromChannel(ch)
}

// Give up the CPU to the other ready tasks and resume on the next scheduler turn.
//
// @parks: this and the three wrappers below (wait-read, wait-write, park) are where
// a green task leaves the CPU through swapcontext, an extern the checker cannot see
// through. Everything that reaches one of them (channel send/recv, Select.wait,
// sleepMs, fd reads that park on EAGAIN, join) is derived as parking transitively,
// so a caller never repeats the attribute.
@parks
pub fn schedulerYield(): void {
    let sched = getSched()
    if sched as i64 == 0 {
        return
    }
    let task = rtReadPtr(sched, sCurrent())
    if task as i64 == 0 {
        return
    }
    rtWriteI32(task, tState(), taskReady())
    swapcontext(rtReadPtr(task, tCtx()), rtReadPtr(sched, sCtx()))
}

// Park until `fd` is readable. @parks: see schedulerYield.
//
// Returns at once when the caller is not on the scheduler.
@parks
pub fn schedulerWaitRead(fd: i32): void {
    let sched = getSched()
    if sched as i64 == 0 {
        return
    }
    let task = rtReadPtr(sched, sCurrent())
    if task as i64 == 0 {
        return
    }

    rtWriteI32(task, tState(), taskWaitingIo())
    rtWriteI32(task, tWaitFd(), fd)

    // register with event loop
    var el = eventLoopFromFd(rtReadI32(sched, sElFd()))
    eventRegisterRead(el, fd)

    // move task to waiting list
    enqueueWait(sched, task)

    swapcontext(rtReadPtr(task, tCtx()), rtReadPtr(sched, sCtx()))
}

// Park until `fd` is writable. @parks: see schedulerYield.
//
// Returns at once when the caller is not on the scheduler.
@parks
pub fn schedulerWaitWrite(fd: i32): void {
    let sched = getSched()
    if sched as i64 == 0 {
        return
    }
    let task = rtReadPtr(sched, sCurrent())
    if task as i64 == 0 {
        return
    }

    rtWriteI32(task, tState(), taskWaitingIo())
    rtWriteI32(task, tWaitFd(), fd)
    // mark as write-wait so deregister uses correct filter
    var one: u8 = 1
    unsafe {
        memcpy((task as i64 + tWaitWrite()) as *u8, (one.addrOf()) as *u8, 1)
    }

    var el = eventLoopFromFd(rtReadI32(sched, sElFd()))
    eventRegisterWrite(el, fd)
    enqueueWait(sched, task)

    swapcontext(rtReadPtr(task, tCtx()), rtReadPtr(sched, sCtx()))
}

// Run the program's `main` as a green task, given its raw entry pointer.
//
// Every blocking std call reads `schedulerCurrent()` to choose between parking
// and blocking the OS thread. `main` was never a task, so that read returned 0
// and each such call blocked the one thread the cooperative scheduler runs on —
// starving the very tasks that would have satisfied it. A server that spawns its
// workers and then accepts in `main` is the natural way to write one, and it
// hung with no error and no timeout.
//
// Fixing it per-call-site does not work (see docs/backlog.md): the fix is to
// leave the OS stack to the scheduler loop and give `main` a task of its own,
// which is Go's g0/m0 split. `join` from main context already drives the
// scheduler, so this is the whole change.
//
// Go exit semantics are unchanged: this returns as soon as `main` returns, and
// any task still running dies with the process.
//
// Called only from generated code, and only when the program can actually
// create green tasks — codegen emits the call after finding `Task.spawnWithStack`
// reachable from `main`. A program that never spawns keeps the plain entry, so
// it pays nothing and targets without stackful coroutines (wasm) stay buildable.
pub fn schedulerRunMainRaw(fnPtr: *u8): void {
    schedulerEnsureInit()
    let t = Task.spawnRaw(fnPtr, 0 as *u8, mainTaskStackSize())
    t.join()
    schedulerShutdown()
}

// The running task, or null when the caller is not on the green scheduler. A std API
// callable from either context branches on this; copy that check when you write one.
pub fn schedulerCurrent(): *u8 {
    let sched = getSched()
    if sched as i64 == 0 {
        return 0 as *u8
    }
    return rtReadPtr(sched, sCurrent())
}

// True once a green scheduler has been created on this thread. Lets a main-
// context waiter (schedulerCurrent()==0) tell "drive the scheduler" apart from
// "pure pthread, block on a cond".
pub fn schedulerExists(): bool {
    return getSched() as i64 != 0
}

// ── park / unpark ──

// Suspend the current task and switch to the scheduler. The task lands on no
// scheduler list: the caller must have stashed schedulerCurrent() somewhere a
// future schedulerUnpark can find it, or the task never runs again.
// Unpark must not precede park on the same thread — cross-thread unparks are
// safe at any time because they are applied only in scheduler context.
// @parks: see schedulerYield.
@parks
pub fn schedulerPark(): void {
    let sched = getSched()
    if sched as i64 == 0 {
        return
    }
    let task = rtReadPtr(sched, sCurrent())
    if task as i64 == 0 {
        return
    }
    rtWriteI32(task, tState(), taskWaitingPark())
    swapcontext(rtReadPtr(task, tCtx()), rtReadPtr(sched, sCtx()))
}

// Make a parked task runnable. Safe from any thread: on the task's own
// scheduler thread it goes straight to the run queue; from a foreign thread
// it is pushed onto the mutex-guarded transfer list and the scheduler's
// wakeup event is signaled so a blocked poll returns promptly.
pub fn schedulerUnpark(task: *u8): void {
    if task as i64 == 0 {
        return
    }
    let home = rtReadPtr(task, tSched())
    if home as i64 == 0 {
        return
    }
    if home as i64 == getSched() as i64 {
        rtWriteI32(task, tState(), taskReady())
        enqueueRun(home, task)
    } else {
        let mtx = rtReadPtr(home, sXferMutex())
        pthread_mutex_lock(mtx)
        rtWritePtr(task, tNext(), rtReadPtr(home, sXferHead()))
        rtWritePtr(home, sXferHead(), task)
        pthread_mutex_unlock(mtx)
        var el = eventLoopFromFd(rtReadI32(home, sElFd()))
        eventLoopNotify(el, rtReadI32(home, sWakeupId()))
    }
}

// move cross-thread unparked tasks onto the run queue (scheduler thread only)
fn drainXfer(sched: *u8): void {
    let mtx = rtReadPtr(sched, sXferMutex())
    pthread_mutex_lock(mtx)
    var cur = rtReadPtr(sched, sXferHead())
    rtWritePtr(sched, sXferHead(), 0 as *u8)
    pthread_mutex_unlock(mtx)
    while cur as i64 != 0 {
        let next = rtReadPtr(cur, tNext())
        rtWriteI32(cur, tState(), taskReady())
        enqueueRun(sched, cur)
        cur = next
    }
}

// ── select support ──

// Allocate a SelectState (mutex-guarded claim record). Caller frees via
// _selectStateFree once the select and all its arms are torn down.
// @internal
pub fn selectStateNew(): *u8 {
    unsafe {
        let st = malloc(selectStateSize())
        memset(st, 0, selectStateSize())
        let m = malloc(64)
        pthread_mutex_init(m, 0 as *u8)
        rtWritePtr(st, ssMtx(), m)
        let c = malloc(48)
        pthread_cond_init(c, 0 as *u8)
        rtWritePtr(st, ssCond(), c)
        rtWriteI64(st, ssClaimed(), -1)
        rtWritePtr(st, ssTask(), schedulerCurrent())
        return st
    }
}

pub fn selectStateFree(st: *u8): void {
    let m = rtReadPtr(st, ssMtx())
    let c = rtReadPtr(st, ssCond())
    pthread_cond_destroy(c)
    free(c)
    pthread_mutex_destroy(m)
    free(m)
    free(st)
}

// Claim the select for `arm` if nothing has won yet, and wake the owning task
// only if it has already committed to parking. Safe from any thread (a foreign
// pthread firing a channel takes this path); unpark itself is thread-safe.
pub fn selectTryClaim(st: *u8, arm: i64): void {
    let m = rtReadPtr(st, ssMtx())
    pthread_mutex_lock(m)
    if rtReadI64(st, ssClaimed()) == -1 {
        rtWriteI64(st, ssClaimed(), arm)
        if rtReadI64(st, ssParked()) == 1 {
            schedulerUnpark(rtReadPtr(st, ssTask()))
        }
        // Wakes a no-scheduler main context blocked in _selectWaitState. Signalled under
        // the lock so it cannot be missed between the claim and the wait.
        pthread_cond_signal(rtReadPtr(st, ssCond()))
    }
    pthread_mutex_unlock(m)
}

// Task side, called after every arm is registered. Returns the winning arm
// index, parking until a source fires. See SelectState for the race handling.
//
// Two contexts, and conflating them is what made this return -1 for so long. A green task
// can park: some other task (or the event loop) will claim an arm and unpark it. The MAIN
// context cannot — `schedulerCurrent()` is 0 there, so `schedulerPark()` no-ops, and the
// old code fell straight through to read an unclaimed `-1` and return it. Callers could
// see that select had woken but not which arm fired, so the demos worked around it by
// draining every arm.
//
// Main context takes the same shape channels already use (`_schedulerPollMain` in
// std/sync): nobody else drives the scheduler, so poll it a bounded tick and re-check the
// claim. Parking there, or driving the poll from inside the lock, is what hangs.
pub fn selectWaitState(st: *u8): i64 {
    let m = rtReadPtr(st, ssMtx())
    while true {
        pthread_mutex_lock(m)
        let already = rtReadI64(st, ssClaimed())
        if already >= 0 {
            pthread_mutex_unlock(m)
            return already
        }
        if schedulerCurrent() as i64 != 0 {
            rtWriteI64(st, ssParked(), 1)
            rtWritePtr(st, ssTask(), schedulerCurrent())
            pthread_mutex_unlock(m)
            schedulerPark()
            return rtReadI64(st, ssClaimed())
        }
        // Main context. Leave ssParked at 0: there is no task to unpark, and claiming
        // would try to unpark a null one.
        if !schedulerExists() {
            // No scheduler to drive and no task to unpark, so the only thing that can fire
            // an arm is a foreign pthread claiming a channel (Promise.blocking with no
            // green task anywhere). Block on the condvar it signals — the third tier of the
            // same ladder channels use. Note fd and timer arms cannot fire here at all:
            // they need the event loop, and Select.wait refuses that combination up front
            // rather than blocking on a wake that can never come.
            pthread_cond_wait(rtReadPtr(st, ssCond()), m)
            pthread_mutex_unlock(m)
            continue
        }
        pthread_mutex_unlock(m)
        schedulerPollMainSelect()
    }
    return -1
}

// Link an fd/read-or-write or timer node into the scheduler's select list and,
// for fd arms, register the fd with the event loop. Scheduler thread only
// (arms are always set up from the task that owns the Select).
pub fn selectRegisterFd(node: *u8): void {
    let sched = getSched()
    if sched as i64 == 0 {
        return
    }
    let kind = rtReadI64(node, nodeKind())
    if kind == kindSelRead() || kind == kindSelWrite() {
        var el = eventLoopFromFd(rtReadI32(sched, sElFd()))
        let fd = rtReadI32(node, nodeFd())
        if kind == kindSelWrite() {
            eventRegisterWrite(el, fd)
        } else {
            eventRegisterRead(el, fd)
        }
    }
    rtWritePtr(node, nodeNext(), rtReadPtr(sched, sSelFdHead()))
    rtWritePtr(sched, sSelFdHead(), node)
}

// Unlink a node from the select list and deregister its fd. Idempotent: a node
// that already fell off the list (never happens today, but cheap to guard) is
// skipped.
pub fn selectUnregisterFd(node: *u8): void {
    let sched = getSched()
    if sched as i64 == 0 {
        return
    }
    var prev: *u8 = 0 as *u8
    var cur = rtReadPtr(sched, sSelFdHead())
    while cur as i64 != 0 {
        let next = rtReadPtr(cur, nodeNext())
        if cur as i64 == node as i64 {
            if prev as i64 == 0 {
                rtWritePtr(sched, sSelFdHead(), next)
            } else {
                rtWritePtr(prev, nodeNext(), next)
            }
            let kind = rtReadI64(node, nodeKind())
            if kind == kindSelRead() || kind == kindSelWrite() {
                var el = eventLoopFromFd(rtReadI32(sched, sElFd()))
                eventDeregister(el, rtReadI32(node, nodeFd()), kind == kindSelWrite())
            }
            return
        }
        prev = cur
        cur = next
    }
}

// Smallest timer deadline remaining (ms), clamped to `cap`. Lets the poll block
// only until the next select timeout instead of the default tick interval.
fn selMinTimeout(sched: *u8, cap: i32): i32 {
    // Track whether any bound exists rather than seeding an i64-max sentinel
    // (large i64 literals don't round-trip cleanly through the lexer). cap>=0
    // is itself a bound; a timer arm shrinks it. cap<0 ("block forever") with
    // no timer returns -1 so the poll blocks until an fd/wakeup fires.
    var haveBound = cap >= 0
    var best: i64 = cap as i64
    let nowMs = epochMillis()
    var cur = rtReadPtr(sched, sSelFdHead())
    while cur as i64 != 0 {
        if rtReadI64(cur, nodeKind()) == kindSelTimer() {
            var rem = rtReadI64(cur, nodeDeadline()) - nowMs
            if rem < 0 {
                rem = 0
            }
            if !haveBound || rem < best {
                best = rem
                haveBound = true
            }
        }
        cur = rtReadPtr(cur, nodeNext())
    }
    if !haveBound {
        return -1
    }
    return best as i32
}

// Claim select fd arms whose fd fired this poll.
fn wakeSelectFds(sched: *u8, readyFds: *i32, count: i32): void {
    unsafe {
        var cur = rtReadPtr(sched, sSelFdHead())
        while cur as i64 != 0 {
            let next = rtReadPtr(cur, nodeNext())
            let kind = rtReadI64(cur, nodeKind())
            if kind == kindSelRead() || kind == kindSelWrite() {
                let fd = rtReadI32(cur, nodeFd())
                var i: i32 = 0
                while i < count {
                    if readyFds[i as i64] == fd {
                        selectTryClaim(rtReadPtr(cur, nodeA()), rtReadI64(cur, nodeArm()))
                    }
                    i += 1
                }
            }
            cur = next
        }
    }
}

// Claim select timer arms whose deadline has passed.
fn wakeSelectTimers(sched: *u8): void {
    let nowMs = epochMillis()
    var cur = rtReadPtr(sched, sSelFdHead())
    while cur as i64 != 0 {
        let next = rtReadPtr(cur, nodeNext())
        if rtReadI64(cur, nodeKind()) == kindSelTimer() {
            if nowMs >= rtReadI64(cur, nodeDeadline()) {
                selectTryClaim(rtReadPtr(cur, nodeA()), rtReadI64(cur, nodeArm()))
            }
        }
        cur = next
    }
}

// poll the event loop once and make everything runnable that became ready:
// io-waiting tasks whose fd fired, and cross-thread unparks via the wakeup event
fn pollAndWake(sched: *u8, timeoutMs: i32): void {
    unsafe {
        var el = eventLoopFromFd(rtReadI32(sched, sElFd()))
        var readyBuf: [u8; 256] = [0; 256]
        let effTimeout = selMinTimeout(sched, timeoutMs)
        let n = eventPoll(el, readyBuf as *i32, 64, effTimeout)
        if n > 0 {
            let wakeupId = rtReadI32(sched, sWakeupId())
            let fds = readyBuf as *i32
            var i: i32 = 0
            while i < n {
                if fds[i as i64] == wakeupId {
                    eventLoopDrainWakeup(el, wakeupId)
                }
                i += 1
            }
            wakeReadyTasks(sched, fds, n)
            wakeSelectFds(sched, fds, n)
        }
        wakeSelectTimers(sched)
        drainXfer(sched)
    }
}

// ── internal queue ops ──

fn enqueueRun(sched: *u8, task: *u8): void {
    rtWritePtr(task, tNext(), 0 as *u8)
    let head = rtReadPtr(sched, sRunHead())
    if head as i64 == 0 {
        rtWritePtr(sched, sRunHead(), task)
        rtWritePtr(sched, sRunTail(), task)
    } else {
        let tail = rtReadPtr(sched, sRunTail())
        rtWritePtr(tail, tNext(), task)
        rtWritePtr(sched, sRunTail(), task)
    }
}

fn dequeueRun(sched: *u8): *u8 {
    let head = rtReadPtr(sched, sRunHead())
    if head as i64 == 0 {
        return 0 as *u8
    }
    let next = rtReadPtr(head, tNext())
    rtWritePtr(sched, sRunHead(), next)
    if next as i64 == 0 {
        rtWritePtr(sched, sRunTail(), 0 as *u8)
    }
    rtWritePtr(head, tNext(), 0 as *u8)
    return head
}

fn enqueueWait(sched: *u8, task: *u8): void {
    let head = rtReadPtr(sched, sWaitHead())
    rtWritePtr(task, tNext(), head)
    rtWritePtr(sched, sWaitHead(), task)
}

// wake waiting tasks whose fd is in the ready set
fn wakeReadyTasks(sched: *u8, readyFds: *i32, count: i32): void {
    unsafe {
        var prev: *u8 = 0 as *u8
        var cur = rtReadPtr(sched, sWaitHead())

        while cur as i64 != 0 {
            let next = rtReadPtr(cur, tNext())
            let waitFd = rtReadI32(cur, tWaitFd())

            var woken = false
            var i: i32 = 0
            while i < count {
                if readyFds[i as i64] == waitFd {
                    woken = true
                }
                i += 1
            }

            if woken {
                // deregister from event loop using correct filter
                var el = eventLoopFromFd(rtReadI32(sched, sElFd()))
                var isWrite: u8 = 0
                memcpy((isWrite.addrOf()) as *u8, (cur as i64 + tWaitWrite()) as *u8, 1)
                eventDeregister(el, waitFd, isWrite != 0)
                // reset waitWrite flag
                var zero: u8 = 0
                memcpy((cur as i64 + tWaitWrite()) as *u8, (zero.addrOf()) as *u8, 1)

                // remove from waiting list
                if prev as i64 == 0 {
                    rtWritePtr(sched, sWaitHead(), next)
                } else {
                    rtWritePtr(prev, tNext(), next)
                }

                // move to run queue
                rtWriteI32(cur, tState(), taskReady())
                rtWriteI32(cur, tWaitFd(), -1)
                enqueueRun(sched, cur)
            } else {
                prev = cur
            }

            cur = next
        }
    }
}

// Free a completed task and wake anyone joining it. Reads the join fields
// before freeing the struct (they point outside it). numTasks is decremented
// here so the reap is accounted regardless of drain vs tick vs block caller.
fn reapTask(sched: *u8, task: *u8): void {
    let joiner = rtReadPtr(task, tJoiner())
    let cell = rtReadPtr(task, tJoinCell())
    munmap(rtReadPtr(task, tStack()), rtReadI64(task, tStackSize()))
    free(rtReadPtr(task, tCtx()))
    // Release the task's closure environment: slot 0 holds its drop glue, which drops
    // every capture the body did not consume and frees the block. Null glue means a
    // by-reference closure whose environment is a stack frame in the spawner — freeing
    // that would corrupt the frame — and a null env means nothing was captured.
    //
    // This was left leaking until 2026-08-20 because enabling it silenced milojs's async
    // path (six fixtures, no output, exit 0) for reasons never identified. The cause was
    // the glue, not the reclaim: captures were COPIES of the env slots, so the glue freed
    // whatever a body had already moved out. Captures now live in the slots and the glue
    // skips the ones a move zeroed, which makes releasing here safe.
    let taskEnv = rtReadPtr(task, tClosureEnv())
    if taskEnv as i64 != 0 {
        let taskGlue = rtReadPtr(taskEnv, 0)
        if taskGlue as i64 != 0 {
            _callClosureVoid(taskGlue, taskEnv)
        }
    }
    free(task)
    rtWriteI64(sched, sNumTasks(), rtReadI64(sched, sNumTasks()) - 1)
    if cell as i64 != 0 {
        rtWriteI64(cell, 0, 1)
        // Release the task's ref; the handle holds the other. Whoever drops last
        // frees the cell, so a late join (handle still alive) reads a live cell.
        taskCellDecref(cell)
    }
    if joiner as i64 != 0 {
        schedulerUnpark(joiner)
    }
    // The drain waiter is itself a task, so it is waiting to be the last one
    // left — not for the count to hit zero.
    let drainer = rtReadPtr(sched, sDrainWaiter())
    if drainer as i64 != 0 && rtReadI64(sched, sNumTasks()) <= 1 {
        rtWritePtr(sched, sDrainWaiter(), 0 as *u8)
        schedulerUnpark(drainer)
    }
}

// Run one batch of ready tasks, then poll events once with `timeoutMs`
// (-1 blocks until an fd/wakeup/timer fires — used by the main-context
// blocking driver; 100 is the cooperative tick used by legacy spin loops).
// @parks: the main-context driver. It does not park a task in the swapcontext
// sense, but from the caller's view it is the same event: other tasks run to
// their next yield before this returns, and any of them may push to a global
// the caller holds a view into. `schedulerTick`, `schedulerRunToCompletion`
// and the main-context blocking waits inherit it from here.
@parks
fn schedulerRunOnce(timeoutMs: i32): void {
    let sched = getSched()
    if sched as i64 == 0 {
        return
    }
    if rtReadI64(sched, sNumTasks()) == 0 {
        return
    }

    var batch: i64 = 0
    var task = dequeueRun(sched)
    while task as i64 != 0 {
        if batch >= 32 {
            enqueueRun(sched, task)
            break
        }
        rtWriteI32(task, tState(), taskRunning())
        rtWritePtr(sched, sCurrent(), task)

        swapcontext(rtReadPtr(sched, sCtx()), rtReadPtr(task, tCtx()))

        let state = rtReadI32(task, tState())
        if state == taskDone() {
            reapTask(sched, task)
        } else if state == taskReady() {
            enqueueRun(sched, task)
        }

        batch += 1
        task = dequeueRun(sched)
    }

    rtWritePtr(sched, sCurrent(), 0 as *u8)

    // poll event loop; when the run queue still has work, don't block — a
    // -1 timeout would stall ready tasks behind idle fds.
    if rtReadI64(sched, sNumTasks()) > 0 {
        var t = timeoutMs
        if rtReadPtr(sched, sRunHead()) as i64 != 0 {
            t = 0
        }
        pollAndWake(sched, t)
    }
}

pub fn schedulerTick(): void {
    schedulerRunOnce(100)
}

// Main-context blocking driver: advance the scheduler, blocking the poll until
// a real event arrives instead of the 100ms cooperative spin. Callers loop on
// their own completion condition (Promise result, join cell, WaitGroup count).
pub fn schedulerBlockMain(): void {
    schedulerRunOnce(-1)
}

// Main-context driver for blockers whose wake condition is NOT an fd event the
// poll can observe: a channel buffer filled under the mutex by a green sender
// that then parked, or by a foreign OS-thread sender that signals a condvar the
// main thread is not waiting on. A -1 poll would sleep past both. The bounded
// timeout keeps the scheduler advancing while letting the caller re-check its
// own condition (the channel buffer) between ticks — forward progress with at
// most a few ms of latency and no busy-spin.
pub fn schedulerPollMain(): void {
    schedulerRunOnce(4)
}

// Select's main-context wait needs a different poll from a channel's.
//
// _schedulerRunOnce returns EARLY when numTasks == 0 — and even past that guard it only
// polls the event loop when tasks remain. Select arms don't live on the task list: fd and
// timer arms hang off sSelFdHead and are claimed by _pollAndWake (_wakeSelectFds /
// _wakeSelectTimers). So once the last green task finishes, _schedulerPollMain becomes a
// no-op and a main-context select waiting on a timer would spin on it forever. That is a
// real hang — `Task.spawn` a short task, then select on a timeout, and the task is gone by
// the time the timer matters.
//
// Poll the event loop directly when there is nothing runnable. _pollAndWake is safe with
// zero tasks and _selMinTimeout already bounds the sleep by the nearest arm deadline, so
// this blocks rather than busy-spins.
fn schedulerPollMainSelect(): void {
    let sched = getSched()
    if sched as i64 == 0 {
        return
    }
    if rtReadI64(sched, sNumTasks()) > 0 {
        schedulerRunOnce(4)
        return
    }
    pollAndWake(sched, 4)
}

// Drive the scheduler until every spawned task has finished, then tear it down.
// Go exit semantics mean main no longer calls this implicitly; it stays as an
// explicit "run all outstanding tasks to completion" entry for programs that
// want the old drain-to-quiescence behavior (e.g. spawn a fleet of workers and
// block main until they all return without a WaitGroup).
pub fn schedulerRunToCompletion(): void {
    let sched = getSched()
    if sched as i64 == 0 {
        return
    }

    // `main` is itself a green task whenever the program can spawn one, and
    // this was written for a `main` that was not. Both of its assumptions break
    // there: the caller is on the task count, so "> 0" never clears, and
    // schedulerBlockMain would swapcontext out of a task stack into the
    // scheduler loop that is already running on it. Park until the reaper says
    // we are the last task standing, and leave the scheduler up — we are still
    // running on it, so the teardown below would free the ground we stand on.
    let cur = schedulerCurrent()
    if cur as i64 != 0 {
        while rtReadI64(sched, sNumTasks()) > 1 {
            rtWritePtr(sched, sDrainWaiter(), cur)
            schedulerPark()
        }
        rtWritePtr(sched, sDrainWaiter(), 0 as *u8)
        return
    }

    while rtReadI64(sched, sNumTasks()) > 0 {
        schedulerBlockMain()
    }

    schedulerShutdown()
}

// Release the scheduler itself: its context, its event loop (and the wakeup fd
// registered on it), and the cross-thread transfer mutex.
//
// Exactly one caller runs this per program. For a `main` that is not a green
// task that is schedulerRunToCompletion, as it always was. For one that is, the
// drain returns while still running ON the scheduler — freeing there would pull
// the ground out from under the caller — so the wrapper does it after the main
// task has been reaped.
fn schedulerShutdown(): void {
    let sched = getSched()
    if sched as i64 == 0 {
        return
    }
    free(rtReadPtr(sched, sCtx()))
    var el = eventLoopFromFd(rtReadI32(sched, sElFd()))
    eventLoopCloseWakeup(el, rtReadI32(sched, sWakeupId()))
    eventLoopClose(el)
    let xmtx = rtReadPtr(sched, sXferMutex())
    pthread_mutex_destroy(xmtx)
    free(xmtx)
    free(sched)
    setSched(0 as *u8)
}
