pub extern fn mkdtemp(template: *u8): *u8

// No @cSig: the guard compiles a TU against the target's real headers, and the MSVC
// CRT has no mkstemp — so asserting its signature fails every Windows build, not just
// the one call that needs it. Its POSIX-only neighbours (mkdtemp, opendir) are bare for
// the same reason. On Windows this stays a link error naming the symbol, which is the
// documented behaviour for a name only some platforms can provide.
pub extern fn mkstemp(template: *u8): i32

pub extern fn getcwd(buf: *u8, size: i64): *u8

pub extern fn chdir(path: *u8): i32

// ── Directory ──

pub extern fn opendir(path: *u8): *u8

pub extern fn closedir(dir: *u8): i32

pub extern fn readdir(dir: *u8): *u8

// ── Terminal ──

pub extern fn tcgetattr(fd: i32, termios: *u8): i32

pub extern fn tcsetattr(fd: i32, actions: i32, termios: *u8): i32

pub extern fn ioctl(fd: i32, request: i64,...): i32

pub extern fn isatty(fd: i32): i32

// ── PTY ──

pub extern fn posix_openpt(flags: i32): i32

pub extern fn grantpt(fd: i32): i32

pub extern fn unlockpt(fd: i32): i32

pub extern fn ptsname(fd: i32): *u8

// Drain stdio's buffers. NULL means every open stream. Named explicitly rather than
// via the `flush` builtin because the builtin's bare name collides with any
// module-private `flush` in the flat namespace (std/deflate has one).
pub extern fn fflush(stream: *u8): i32

