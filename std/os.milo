// std/os — typed libc bindings for Milo, plus green-aware fd IO wrappers

// these imports exist for the green-aware wrappers at the bottom of this
// file; the resolver's visited-set makes the std/os ↔ std/runtime cycle safe
from "std/platform" import {
    getErrno, setErrno, eagain, ebadf, einprogress, netErrno, netEagain, netEinprogress, solSocket, soError, SockAddr, SockAddrIn, SockAddrIn6, SockAddrUn,
    SockAddrStorage, makeZeroedSockaddr, makeZeroedSockaddrStorage, sockAddrStorageLen, sockAddrInLen,
    sockAddrIn6Len, sockAddrUnLen,
    pthread_create, pthread_join, pthread_detach,
    pthread_mutex_init, pthread_mutex_lock, pthread_mutex_unlock, pthread_mutex_destroy,
    pthread_cond_init, pthread_cond_wait, pthread_cond_signal, pthread_cond_broadcast, pthread_cond_destroy,
    pthread_rwlock_init, pthread_rwlock_rdlock, pthread_rwlock_wrlock, pthread_rwlock_unlock, pthread_rwlock_destroy,
    mmap, munmap, mprotect,
    pipe,
    read, write, open, close, lseek, access, getpid, waitpidRaw, killRaw,
    sockRead, sockWrite
}
from "std/event" import {
    setNonblocking
}
from "std/runtime" import {
    schedulerCurrent, schedulerWaitRead, schedulerWaitWrite
}
from "std/replay" import {
    replayOff, replayActive, replayRead, replayWrite, replayOpen, replayClose, replayLseek, replayRet, replayFdOpened, replayFdCategory,
    replayHex, replayBlob, replayInts
}

// ── I/O ──

// signal(SIGPIPE, SIG_IGN). Writing to a socket whose peer has gone away raises
// SIGPIPE, whose default action is to kill the process — a server dies silently
// (exit 141) the first time a client disconnects mid-response. Every runtime
// that serves connections ignores it and handles the EPIPE from write instead.
@cSig("signal.h", "void (*signal(int, void (*)(int)))(int)")
pub extern fn signal(sig: i32, handler: *u8): *u8

@cSig("sys/stat.h", "int fstat(int, struct stat *)")
pub extern fn fstat(fd: i32, buf: *u8): i32

@cSig("sys/stat.h", "int stat(const char *, struct stat *)")
pub extern fn stat(path: *u8, buf: *u8): i32

@cSig("stdio.h", "int puts(const char *)")
pub extern fn puts(s: *u8): i32

@cSig("stdio.h", "int printf(const char *, ...)")
pub extern fn printf(fmt: *u8,...): i32

// ── Memory ──

@cSig("stdlib.h", "void *malloc(size_t)")
pub extern fn malloc(size: i64): *u8

@cSig("stdlib.h", "void *realloc(void *, size_t)")
pub extern fn realloc(ptr: *u8, size: i64): *u8

@cSig("stdlib.h", "void free(void *)")
pub extern fn free(ptr: *u8): void

@cSig("string.h", "void *memcpy(void *, const void *, size_t)")
pub extern fn memcpy(dst: *u8, src: *u8, n: i64): *u8

@cSig("string.h", "void *memset(void *, int, size_t)")
pub extern fn memset(dst: *u8, c: i32, n: i64): *u8

@cSig("string.h", "void *memmove(void *, const void *, size_t)")
pub extern fn memmove(dst: *u8, src: *u8, n: i64): *u8

// ── Error ──

@cSig("string.h", "char *strerror(int)")
pub extern fn strerror(errnum: i32): *u8

// ── Strings ──

@cSig("string.h", "size_t strlen(const char *)")
pub extern fn strlen(s: *u8): u64

pub extern fn strcmp(a: *u8, b: *u8): i32

pub extern fn strncmp(a: *u8, b: *u8, n: i64): i32

pub extern fn snprintf(buf: *u8, size: i64, fmt: *u8,...): i32

// ── Network ──

// On Windows this links to the ws2_32 socket(), which returns a SOCKET (UINT_PTR); the i32
// here takes its low 32 bits, valid because MS documents SOCKET values fit in 32 bits. It
// also requires WSAStartup to have run — std/net does that via ensureNetInit(), and a raw
// std/os socket() caller must call ensureNetInit() (a no-op on POSIX) itself first.
pub extern fn socket(domain: i32, sockType: i32, protocol: i32): i32

// The socket syscalls take `struct sockaddr *` and read the family from its first bytes,
// so ONE extern must serve every family — Milo can't declare bind twice (the resolver
// merges every decl of an imported file, so a second one at another type just loses).
// Raw here, typed at the wrappers below: the unsafe seam stays inside std/os and callers
// never hand-write an addrlen, which is where a wrong-length bug would come from.
pub extern fn bind(sockfd: i32, addr: *SockAddr, addrlen: u32): i32

pub extern fn listen(sockfd: i32, backlog: i32): i32

// accept lets the KERNEL choose the peer's family, so the out-param must be sized for any
// of them. This took a 16-byte sockaddr_in with addrlen=16, which silently truncates an
// IPv6 peer (28 bytes) — a live bug independent of AF_UNIX.
pub extern fn accept(sockfd: i32, addr: &mut SockAddrStorage, addrlen: &mut u32): i32

pub extern fn connect(sockfd: i32, addr: *SockAddr, addrlen: u32): i32

pub extern fn setsockopt(fd: i32, level: i32, opt: i32, val: &i32, len: u32): i32

pub extern fn getsockopt(fd: i32, level: i32, opt: i32, val: &mut i32, len: &mut u32): i32

// Byte-order swaps: pure, so callable without `unsafe` (see the extern-call warning).
@pure
pub extern fn htons(hostshort: u16): u16

@pure
pub extern fn ntohs(netshort: u16): u16

// Same shape as accept: the kernel writes back whatever family the socket is, so the
// buffer must be storage-sized, not sockaddr_in-sized.
pub extern fn getsockname(fd: i32, addr: &mut SockAddrStorage, addrlen: &mut u32): i32

pub extern fn inet_pton(af: i32, src: *u8, dst: *u8): i32

// ── typed sockaddr wrappers ──
// One per family. Each owns its own addrlen, so no caller can pass the wrong one.

// The bound port, whatever family the socket is. getsockname writes into storage-sized
// space because the kernel picks the family; sin_port and sin6_port BOTH sit at offset 2
// (same invariant as sun_path), so one read serves v4 and v6. Returns -1 on failure.
@unsafe
pub fn getSockPort(fd: i32): i32 {
    if !replayOff() {
        return replayRet("net.port", fd.toString(), true, (): i64 => {
            return getSockPortLive(fd) as i64
        }) as i32
    }
    return getSockPortLive(fd)
}

@replayHooked
fn getSockPortLive(fd: i32): i32 {
    unsafe {
        var st = makeZeroedSockaddrStorage()
        var len: u32 = sockAddrStorageLen()
        if getsockname(fd, &mut st, &mut len) < 0 {
            return -1
        }
        let portPtr = (st.addrOf() as i64 + 2) as *u16
        return ntohs(*portPtr) as i32
    }
}

@unsafe
pub fn bindIn(fd: i32, addr: &SockAddrIn): i32 {
    unsafe {
        return bindFd(fd, (addr.addrOf()) as *SockAddr, sockAddrInLen())
    }
}

@unsafe
pub fn bindIn6(fd: i32, addr: &SockAddrIn6): i32 {
    unsafe {
        return bindFd(fd, (addr.addrOf()) as *SockAddr, sockAddrIn6Len())
    }
}

@unsafe
pub fn bindUn(fd: i32, addr: &SockAddrUn): i32 {
    unsafe {
        return bindFd(fd, (addr.addrOf()) as *SockAddr, sockAddrUnLen())
    }
}

// ── replay-aware descriptor calls ──
// The single syscalls std's fd IO is built from, each one a record under MILO_RECORD
// and an answer from the trace under MILO_REPLAY (std/replay, docs/record-replay.md).
// When neither is set each is the raw call behind one compare. Std code reaches the OS
// through these rather than the raw externs, so a replayed program's descriptors can be
// synthetic: a TcpStream, File or Child under replay has no OS fd behind it and works.
//
// Every pub fn here that takes or returns a descriptor number is `@unsafe`: the number
// is an integer, so nothing stops it outliving its owner and naming whatever reused it.
// Application code goes through the owning types (File, TcpStream, OwnedFd, Pty, Child);
// std's own handles call these inside `unsafe`, vouching that they still own the fd.

// One read(2): bytes read, 0 at EOF, <0 with errno set.
@replayHooked
@unsafe
pub fn sysRead(fd: i32, buf: *u8, len: i64): i64 {
    unsafe {
        if replayOff() {
            unsafe { return read(fd, buf, len) }
        }
        return replayRead(fd, buf, len, false)
    }
}

// One write(2): bytes written, <0 with errno set.
@replayHooked
@unsafe
pub fn sysWrite(fd: i32, buf: *u8, len: i64): i64 {
    unsafe {
        if replayOff() {
            unsafe { return write(fd, buf, len) }
        }
        return replayWrite(fd, buf, len, false)
    }
}

// One socket read (recv on Windows, where a SOCKET is not a CRT fd).
fn sysRecv(fd: i32, buf: *u8, len: i64): i64 {
    unsafe {
        if replayOff() {
            return sockRead(fd, buf, len)
        }
        return replayRead(fd, buf, len, true)
    }
}

// One socket write (send on Windows).
fn sysSend(fd: i32, buf: *u8, len: i64): i64 {
    unsafe {
        if replayOff() {
            return sockWrite(fd, buf, len)
        }
        return replayWrite(fd, buf, len, true)
    }
}

// open(2) with a creation mode (ignored unless `flags` creates). The fd, or <0.
@replayHooked
@unsafe
pub fn sysOpen(path: &string, flags: i32, mode: i32): i32 {
    unsafe {
        if replayOff() {
            unsafe { return open(path, flags, mode) }
        }
        return replayOpen(path, flags, mode)
    }
}

// dup(2). Under replay the duplicate of a descriptor is synthetic like everything else
// the trace hands out, and keeps the original's record kinds.
@replayHooked
@unsafe
pub fn sysDup(fd: i32): i32 {
    unsafe {
        if replayOff() {
            unsafe { return dup(fd) }
        }
        let n = replayRet("fd.dup", fd.toString(), false, (): i64 => {
            unsafe {
                return dup(fd) as i64
            }
        }) as i32
        replayFdOpened(n, replayFdCategory(fd))
        return n
    }
}

// waitpid(2) through the trace: the return value and the status word the kernel wrote.
// Under replay no child exists; the recorded exit comes back.
@replayHooked
pub fn sysWaitpid(pid: i32, status: *u8, options: i32): i32 {
    if replayOff() {
        return waitpidRaw(pid, status, options)
    }
    let p = replayBlob("proc.wait", pid.toString() + " " + options.toString(), (): string => {
        var r: i32 = 0
        var st: i32 = 0
        unsafe {
            r = waitpidRaw(pid, status, options)
            st = _loadI32(status)
        }
        return r.toString() + " " + st.toString() + " " + getErrno().toString()
    })
    let v = replayInts(p)
    if v.len != 3 {
        return -1
    }
    unsafe {
        let sp = status as *i32
        sp[0] = v[1] as i32
    }
    if v[0] < 0 {
        setErrno(v[2] as i32)
    }
    return v[0] as i32
}

// kill(2) through the trace. Under replay no signal is sent: the pid is the recorded
// run's, and whatever has it now is not ours.
@replayHooked
pub fn sysKill(pid: i32, sig: i32): i32 {
    if replayOff() {
        return killRaw(pid, sig)
    }
    return replayRet("proc.kill", pid.toString() + " " + sig.toString(), false, (): i64 => {
        return killRaw(pid, sig) as i64
    }) as i32
}

// isatty(3) through the trace: whether a descriptor is a terminal is an input too.
@replayHooked
@unsafe
pub fn sysIsatty(fd: i32): bool {
    if replayOff() {
        unsafe { return isatty(fd) == 1 }
    }
    return replayRet("fd.isatty", fd.toString(), false, (): i64 => {
        unsafe {
            return isatty(fd) as i64
        }
    }) == 1
}

// close(2). Under replay a synthetic descriptor is forgotten, never passed to the OS.
@replayHooked
@unsafe
pub fn sysClose(fd: i32): i32 {
    unsafe {
        if replayOff() {
            unsafe { return close(fd) }
        }
        return replayClose(fd)
    }
}

// lseek(2): the new offset, or <0.
@replayHooked
@unsafe
pub fn sysLseek(fd: i32, off: i64, whence: i32): i64 {
    unsafe {
        if replayOff() {
            unsafe { return lseek(fd, off, whence) }
        }
        return replayLseek(fd, off, whence)
    }
}

// socket(2). Under replay the recorded number comes back as a synthetic socket.
@replayHooked
@unsafe
pub fn sysSocket(domain: i32, sockType: i32, protocol: i32): i32 {
    unsafe {
        if replayOff() {
            unsafe { return socket(domain, sockType, protocol) }
        }
        let fd = replayRet("net.socket", domain.toString() + " " + sockType.toString(), true, (): i64 => {
            unsafe {
                return socket(domain, sockType, protocol) as i64
            }
        }) as i32
        replayFdOpened(fd, 'n')
        return fd
    }
}

// listen(2).
@replayHooked
@unsafe
pub fn sysListen(fd: i32, backlog: i32): i32 {
    if replayOff() {
        unsafe { return listen(fd, backlog) }
    }
    return replayRet("net.listen", fd.toString(), true, (): i64 => {
        unsafe {
            return listen(fd, backlog) as i64
        }
    }) as i32
}

// bind(2) on a raw address; the per-family bindIn/bindIn6/bindUn are what callers use.
@replayHooked
fn bindFd(fd: i32, addr: *SockAddr, addrlen: u32): i32 {
    if replayOff() {
        unsafe { return bind(fd, addr, addrlen) }
    }
    var arg = fd.toString() + " "
    unsafe { arg.pushStr(replayHex(addr as *u8, addrlen as i64)) }
    return replayRet("net.bind", arg, true, (): i64 => {
        unsafe {
            return bind(fd, addr, addrlen) as i64
        }
    }) as i32
}

// One connect(2) attempt. The address is part of the record, so a replay connecting
// somewhere else diverges.
@replayHooked
fn connectOnce(fd: i32, addr: *SockAddr, addrlen: u32): i32 {
    if replayOff() {
        unsafe { return connect(fd, addr, addrlen) }
    }
    var arg = fd.toString() + " "
    unsafe { arg.pushStr(replayHex(addr as *u8, addrlen as i64)) }
    return replayRet("net.connect", arg, true, (): i64 => {
        unsafe {
            return connect(fd, addr, addrlen) as i64
        }
    }) as i32
}

// accept(2), discarding the peer address. Under replay the recorded client fd comes
// back as a synthetic socket.
@unsafe
pub fn sysAccept(fd: i32): i32 {
    unsafe {
        if replayOff() {
            return acceptLive(fd)
        }
        let client = replayRet("net.accept", fd.toString(), true, (): i64 => {
            return acceptLive(fd) as i64
        }) as i32
        replayFdOpened(client, 'n')
        return client
    }
}

// Storage-sized, not sockaddr_in-sized: the kernel writes whatever family the peer
// used, and a v6 peer needs 28 bytes.
@replayHooked
fn acceptLive(fd: i32): i32 {
    var clientAddr = makeZeroedSockaddrStorage()
    var addrlen: u32 = sockAddrStorageLen()
    unsafe { return accept(fd, &mut clientAddr, &mut addrlen) }
}

// The pending error of a non-blocking connect (SO_ERROR): 0 when it succeeded, the
// errno it failed with, or -1 when the query itself fails.
fn connectResult(fd: i32): i32 {
    if replayOff() {
        return connectResultLive(fd)
    }
    return replayRet("net.connected", fd.toString(), true, (): i64 => {
        return connectResultLive(fd) as i64
    }) as i32
}

@replayHooked
fn connectResultLive(fd: i32): i32 {
    var err: i32 = 0
    var len: u32 = 4
    unsafe {
        if getsockopt(fd, solSocket(), soError(), &mut err, &mut len) < 0 {
            return -1
        }
    }
    return err
}

